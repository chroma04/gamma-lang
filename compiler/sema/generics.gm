// Constraints on type parameters (§16.3) and what may be a type argument (§16.1).

parse_constraint :: fn(name: string) -> ?Constraint => match name {
    "Eq" => Constraint.Eq
    "Ord" => Constraint.Ord
    "Num" => Constraint.Num
    "Int" => Constraint.Int
    "Neg" => Constraint.Neg
    "Float" => Constraint.Float
    "Plain" => Constraint.Plain
    _ => null
}

pub constraint_name :: fn(c: Constraint) -> string => @variant_name(c)

/// Whether constraint `a` implies `b`.
implies :: fn(a, b: Constraint) -> bool => match a {
    .Eq => b is .Eq
    .Ord => b in (Constraint.Ord, Constraint.Eq)
    .Num => b in (Constraint.Num, Constraint.Ord, Constraint.Eq)
    .Int => b in (Constraint.Int, Constraint.Num, Constraint.Ord, Constraint.Eq, Constraint.Plain)
    .Neg => b in (Constraint.Neg, Constraint.Num, Constraint.Ord, Constraint.Eq, Constraint.Plain)
    .Float => b in (Constraint.Float, Constraint.Neg, Constraint.Num, Constraint.Ord, Constraint.Eq, Constraint.Plain)
    .Plain => b is .Plain
}

declare_constraint :: fn(s: ^Sema, module: usize, c: ^const ast.Constraint) needs Load {
    k := parse_constraint(c.name.name) else {
        msg := str.format("unknown constraint `{}`; the constraints are Eq, Ord, Num, Int, Neg, Float and Plain", c.name.name)!
        if c.name.name is "Signed" { msg = str.format("{}; `Signed` is now `Neg`", msg)! }
        s.error(c.name.span, msg)
        return
    }
    t := s.resolve_type(module, c.ty)
    match s.tys.kind(t) {
        .Param(p) => s.params.items[usize(p)].constraints.push(k)!
        .Error => {}
        _ => s.error(c.ty.span, "a constraint applies to a type parameter of this declaration")
    }
}

/// True if type parameter `p` is granted constraint `c`.
pub param_has :: fn(s: ^const Sema, p: u32, c: Constraint) -> bool {
    for k in s.params.items[usize(p)].constraints.items {
        if implies(k, c) { return true }
    }
    return false
}

/// Ends a signature or generic type declaration: once the outermost one has declared its
/// `where` clause, checks the constraints that waited for it.
end_constraint_defer :: fn(s: ^Sema) needs Alloc {
    s.constraint_defer -= 1
    if s.constraint_defer > 0 { return }
    deferred := s.deferred
    s.deferred = list(Deferred)
    for d in deferred.items {
        if not s.satisfies(d.ty, d.c) { s.error(d.span, s.unsatisfied(d.ty, d.c, d.param, d.template)) }
    }
}

unsatisfied :: fn(s: ^const Sema, t: Ty, c: Constraint, p: u32, template: u32) -> string needs Alloc {
    return str.format("`{}` does not satisfy `{}({})` required by `{}`", s.show(t), constraint_name(c), s.tys.param_name(p), s.adts.items[usize(template)].name)!
}

/// True if the (concrete or parameter) type `t` satisfies `c` (§16.3).
pub satisfies :: fn(s: ^const Sema, t: Ty, c: Constraint) -> bool needs Alloc {
    if .Param(p) := s.tys.kind(t) { return s.param_has(p, c) }
    is_float := s.tys.kind(t) is .Float(_)
    return match c {
        .Eq => s.has_eq(t)
        .Ord => s.has_ord(t)
        .Num => s.tys.is_integer(t) or is_float
        .Int => s.tys.is_integer(t)
        .Neg => s.tys.is_signed_integer(t) or is_float
        .Float => is_float
        .Plain => s.is_plain(t)
    }
}

pub(package) has_ord :: fn(s: ^const Sema, t: Ty) -> bool => match s.tys.kind(t) {
    .Bool, .Int(_), .Usize, .Isize, .Float(_), .ManyPtr(_) => true
    .Tuple(elems, _) => all_ord(s, elems)
    // Vectors and math vectors are not ordered (§5.6.2, §5.6.3).
    .Array(_, elem, kind) => kind not in (types.ArrayKind.Simd, types.ArrayKind.Math) and s.has_ord(elem)
    .ParamArray(_, elem), .Slice(_, elem) => s.has_ord(elem)
    .Param(p) => s.param_has(p, .Ord)
    .Adt(_) => {
        u := s.union_variants(t) else return false
        for v in u.variants {
            if v.payload is not null { return false }
        }
        true
    }
    _ => false
}

all_ord :: fn(s: ^const Sema, elems: []const Ty) -> bool {
    for e in elems {
        if not s.has_ord(e) { return false }
    }
    return true
}

/// The types `is` is defined for (§7.6).
pub has_eq :: fn(s: ^const Sema, t: Ty) -> bool needs Alloc {
    seen := list(Ty)
    return s.has_eq_in(t, &seen)
}

/// `has_eq` with the types being examined: a type that reaches itself again is assumed to
/// have equality (the other parts decide), so self-recursive types terminate.
has_eq_in :: fn(s: ^const Sema, t: Ty, seen: ^List(Ty)) -> bool needs Alloc {
    match s.tys.kind(t) {
        .Fn(_), .Handler(_), .Cont(_), .Type => return false
        .Param(p) => return s.param_has(p, .Eq)
        .Tuple(elems, _) => {
            for e in elems {
                if not s.has_eq_in(e, seen) { return false }
            }
            return true
        }
        .Array(_, elem, _), .ParamArray(_, elem), .Slice(_, elem), .Optional(elem) => return s.has_eq_in(elem, seen)
        .Result(err, ok) => return s.has_eq_in(err, seen) and s.has_eq_in(ok, seen)
        .Adt(id, _) => {
            if t in seen.items { return true }
            seen.push(t)!
            r := true
            match s.adts.items[usize(id)].kind {
                .Struct(def) => for f in def.fields {
                    if not s.has_eq_in(f.ty, seen) {
                        r = false
                        break
                    }
                }
                .Union(_, variants) => for v in variants {
                    if p := v.payload and not s.has_eq_in(p, seen) {
                        r = false
                        break
                    }
                }
                .CUnion(_) => { r = false }
            }
            _ = seen.pop()
            return r
        }
        _ => return true
    }
}

pub(package) is_plain :: fn(s: ^const Sema, t: Ty) -> bool => match s.tys.kind(t) {
    .Int(_), .Usize, .Isize, .Float(_) => true
    .Array(_, elem, _), .ParamArray(_, elem) => s.is_plain(elem)
    .Tuple(elems, _) => all_plain(s, elems)
    .Param(p) => s.param_has(p, .Plain)
    .Adt(id, _) => match s.adts.items[usize(id)].kind {
        .Struct(def) => plain_fields(s, def)
        _ => false
    }
    _ => false
}

all_plain :: fn(s: ^const Sema, elems: []const Ty) -> bool {
    for i, e in enumerate(elems) {
        // An element equal to an earlier one is not checked again, so that types shaped
        // like a DAG (`T2 :: (T1, T1)`) take linear time.
        if elems[..i].index_of(e) is not null { continue }
        if not s.is_plain(e) { return false }
    }
    return true
}

plain_fields :: fn(s: ^const Sema, def: StructDef) -> bool {
    for f in def.fields {
        if def.bits is null {
            if not s.is_plain(f.ty) { return false }
        } else {
            // A `#bits` struct whose fields are `bool`, integers or such structs (§5.19).
            ok := s.tys.is_integer(f.ty) or s.tys.kind(f.ty) is .Bool or (s.bits_struct_ty(f.ty) is not null and s.is_plain(f.ty))
            if not ok { return false }
        }
    }
    return true
}

/// The underlying integer type of a `#bits` struct, if `ty` is one.
pub(package) bits_struct_ty :: fn(s: ^const Sema, ty: Ty) -> ?Ty {
    .Adt(id, _) := s.tys.kind(ty) else return null
    .Struct(def) := s.adts.items[usize(id)].kind else return null
    return def.bits
}

pub not_first_class :: fn(s: ^const Sema, t: Ty, part: Ty) -> string needs Alloc {
    if t is part { return str.format("`{}` is not a first-class type, so it cannot be a type argument (§16.1)", s.show(t))! }
    return str.format("`{}` contains the second-class type `{}`, so it cannot be a type argument (§16.1)", s.show(t), s.show(part))!
}

/// The second-class part of `t` (a `fn(…)` type, a handler, `type`), if it has one: such
/// a type is not a valid type argument (§16.1).
pub second_class_part :: fn(s: ^const Sema, t: Ty) -> ?Ty {
    if s.tys.kind(t) is .Fn(_) { return t }
    return s.inner_second_class_part(t)
}

inner_second_class_part :: fn(s: ^const Sema, t: Ty) -> ?Ty {
    match s.tys.kind(t) {
        .Handler(_), .Type => return t
        .Ptr(_, x), .ManyPtr(_, x), .Slice(_, x), .Optional(x), .Cont(x) => return s.inner_second_class_part(x)
        .Array(_, x, _), .ParamArray(_, x) => return s.inner_second_class_part(x)
        .Result(err, ok) => return s.inner_second_class_part(err) else s.inner_second_class_part(ok)
        .Tuple(elems, _) => {
            for x in elems {
                if p := s.inner_second_class_part(x) { return p }
            }
            return null
        }
        .Adt(_, args) => {
            for a in args {
                if .Type(x) := a {
                    if p := s.inner_second_class_part(x) { return p }
                }
            }
            return null
        }
        _ => return null
    }
}

/// Brings the compile-time parameters among `params` into scope for a generic body, and
/// returns what `unscope_type_params` needs to take them out again.
pub scope_type_params :: fn(s: ^Sema, params: []const ParamInfo) -> (types: usize, values: usize) needs Alloc {
    before := (types: s.type_params.items.len, values: s.value_scope.items.len)
    for p in params {
        pid := p.generic else continue
        if s.params.items[usize(pid)].kind is .Value(_) {
            s.value_scope.push(ValueScoped(name: p.name, param: pid))!
        } else {
            s.type_params.push(Scoped(name: p.name, ty: s.tys.param(pid)))!
        }
    }
    return before
}

pub unscope_type_params :: fn(s: ^Sema, before: (types: usize, values: usize)) {
    s.type_params.truncate(before.types)
    s.value_scope.truncate(before.values)
}

/// What generic parameter `p` stands for.
pub param_kind :: fn(s: ^const Sema, p: u32) -> ParamKind => s.params.items[usize(p)].kind

/// The constraints declared for type parameter `p`.
pub param_constraints :: fn(s: ^const Sema, p: u32) -> []const Constraint => s.params.items[usize(p)].constraints.items

// ---------------------------------------------------------------------------------
// Instances of generic functions
// ---------------------------------------------------------------------------------

/// A generic function and the arguments of one of its instances.
pub FnInstance :: struct {
    pub template: u32
    pub args: []const Ty
}

/// How deeply generic instantiations may nest (§16.7).
MAX_MONO_DEPTH: u32 : 256

/// An instance whose generic body's calls are still to be followed: the instances they
/// call are instantiated in turn.
pub MonoRequest :: struct {
    pub generic: u32
    pub instance: u32
    pub args: []const Ty
    pub span: source.Span
    pub depth: u32
}

/// The instance of generic function `f` for `args`, allocated on the first request (at
/// `span`). Its body is not produced: the `tir` dump shows generic functions by their
/// templates, and only the calls in it are followed (see `MonoRequest`).
pub instantiate :: fn(s: ^Sema, f: u32, args: []const Ty, span: source.Span) -> u32 needs Load {
    if id := s.fn_instances.get((f, args)) { return id }
    sig := s.fns.items[usize(f)]
    map := list(Subst)
    for i, g in enumerate(sig.generics) { map.push(Subst(param: g, ty: args[i]))! }
    params := list(ParamInfo)
    for p in sig.params {
        if p.generic is not null { continue }
        q := p
        q.ty = s.subst(p.ty, map.items)
        params.push(q)!
    }
    kept := list(Ty)
    kept.extend(args)!
    inst := FnSig(
        name: sig.name,
        span: sig.span,
        module: sig.module,
        params: params.items,
        ret: s.subst(sig.ret, map.items),
        effects: s.subst_effects(&sig.effects, map.items),
        generics: empty_slice(u32),
        instance: FnInstance(template: f, args: kept.items),
    )
    id := s.fns.items.len.trunc(u32)
    s.fns.push(inst)!
    kind: tir.FnKind = if s.defs.items[usize(f)].kind is .Clause { .Clause } else { .Named }
    s.defs.push(tir.FnDef(kind: kind, params: empty_slice(u32), locals: empty_slice(tir.LocalDecl), body: null))!
    s.fn_instances.put((f, kept.items), id)!
    for a in args {
        if s.tys.has_param(a) { return id }
    }
    depth := s.mono_depth + 1
    if depth > MAX_MONO_DEPTH {
        s.error(span, str.format("generic instantiations nest more than {} deep; does a generic function call itself with ever-larger type arguments? (§16.7)", MAX_MONO_DEPTH)!)
        return id
    }
    s.mono_queue.push(MonoRequest(generic: f, instance: id, args: kept.items, span: span, depth: depth))!
    return id
}

/// The type bound to parameter `p` in `binds`, if any.
pub bound_to :: fn(binds: []const Subst, p: u32) -> ?Ty {
    for b in binds {
        if b.param is p { return b.ty }
    }
    return null
}

/// Binds type parameters by matching a parameter type `pat` against an argument type
/// `actual`; a parameter bound already keeps its type.
pub match_params :: fn(s: ^Sema, pat: Ty, actual: Ty, binds: ^List(Subst)) needs Alloc {
    tys := &s.tys
    if tys.has_infer(actual) or tys.is_error(actual) { return }
    a := tys.kind(actual)
    match tys.kind(pat) {
        .Param(p) => if bound_to(binds.items, p) is null { binds.push(Subst(param: p, ty: actual))! }
        .ParamArray(len, x) => match a {
            .ParamArray(len2, y) => {
                s.match_params(len, len2, binds)
                s.match_params(x, y, binds)
            }
            // `[N]T` against `[4]u8` gives `N = 4` (as a `u64`, converted by the caller).
            .Array(n, y, .Plain) => {
                if .Param(p) := tys.kind(len) and bound_to(binds.items, p) is null {
                    bytes := list(u8)
                    for i in 0..8 { bytes.push((n >> u64(i * 8)).trunc(u8))! }
                    v := tys.intern(.Value(.Bytes(tys.int(false, 64), bytes.items)))
                    binds.push(Subst(param: p, ty: v))!
                }
                s.match_params(x, y, binds)
            }
            _ => {}
        }
        .Ptr(_, x) => if .Ptr(_, y) := a { s.match_params(x, y, binds) }
        .Slice(_, x) => if .Slice(_, y) := a { s.match_params(x, y, binds) }
        .ManyPtr(_, x) => if .ManyPtr(_, y) := a { s.match_params(x, y, binds) }
        .Array(_, x, _) => if .Array(_, y, _) := a { s.match_params(x, y, binds) }
        .Optional(x) => if .Optional(y) := a { s.match_params(x, y, binds) }
        .Result(e1, o1) => if .Result(e2, o2) := a {
            s.match_params(e1, e2, binds)
            s.match_params(o1, o2, binds)
        }
        .Adt(x, xs) => if .Adt(y, ys) := a {
            same := tys.template(x) is tys.template(y) or soa_const_view(tys, x, y)
            if same and xs.len is ys.len {
                for i, p in enumerate(xs) {
                    if .Type(pt) := p and .Type(qt) := ys[i] { s.match_params(pt, qt, binds) }
                }
            }
        }
        .Tuple(xs, _) => if .Tuple(ys, _) := a and xs.len is ys.len {
            for i, x in enumerate(xs) { s.match_params(x, ys[i], binds) }
        }
        .Fn(f) => match a {
            .Fn(g), .FnPtr(g) => s.match_fn_params(&f, &g, binds)
            _ => {}
        }
        .FnPtr(f) => if .FnPtr(g) := a { s.match_fn_params(&f, &g, binds) }
        .Effects(x) => if .Effects(y) := a { s.match_effects(&x, &y, binds) }
        _ => {}
    }
}

match_fn_params :: fn(s: ^Sema, f: ^const types.FnTy, g: ^const types.FnTy, binds: ^List(Subst)) needs Alloc {
    if f.params.len is not g.params.len { return }
    for i, p in enumerate(f.params) { s.match_params(p, g.params[i], binds) }
    s.match_params(f.ret, g.ret, binds)
    s.match_effects(&f.effects, &g.effects, binds)
}

/// A `#soa []const T` view matches a `#soa []T` argument.
soa_const_view :: fn(tys: ^const types.Types, pat: u32, actual: u32) -> bool {
    return tys.adt_name(tys.template(pat)) is "#soa []const " and tys.adt_name(tys.template(actual)) is "#soa []"
}

/// Binds the parameters of effect set `pat` from `actual` (§16.6): the arguments of an
/// effect that occurs once in each, then a single term `..E` from the effects of
/// `actual` that `pat` does not name.
match_effects :: fn(s: ^Sema, pat: ^const EffectSet, actual: ^const EffectSet, binds: ^List(Subst)) needs Alloc {
    for p in pat.effects {
        if p.eff is types.SPLICE or p.args.len is 0 { continue }
        found: ?EffectRef = null
        count := 0
        for a in actual.effects {
            if a.eff is p.eff {
                found = a
                count += 1
            }
        }
        if count is not 1 { continue }
        a := found else continue
        for i, x in enumerate(p.args) {
            if i < a.args.len and .Type(xt) := x and .Type(yt) := a.args[i] { s.match_params(xt, yt, binds) }
        }
    }
    splice: ?EffectRef = null
    splices := 0
    for p in pat.effects {
        if p.eff is types.SPLICE {
            splice = p
            splices += 1
        }
    }
    if splices is not 1 { return }
    sp := splice else return
    if sp.args.len is 0 { return }
    .Type(t) := sp.args[0] else return
    .Param(e) := s.tys.kind(t) else return
    if bound_to(binds.items, e) is not null { return }
    rest := list(EffectRef)
    for a in actual.effects {
        named := false
        for p in pat.effects {
            if p.eff is not types.SPLICE and p.eff is a.eff { named = true }
        }
        if not named { rest.push(a)! }
    }
    binds.push(Subst(param: e, ty: s.tys.intern(.Effects(types.effect_set(rest.items)))))!
}

/// The value of an integer key, as its type gives it (two's complement for a signed one).
pub key_int :: fn(s: ^const Sema, k: types.ConstKey) -> ?bigint.Int needs Alloc {
    .Bytes(t, b) := k else return null
    if not s.tys.is_integer(t) { return null }
    v := bigint.zero()
    i := b.len
    while i > 0 {
        i -= 1
        v = v.shl(8).add(bigint.from_u64(u64(b[i])))
    }
    if s.tys.is_signed_integer(t) and b.len > 0 and b[b.len - 1] >= 128 { v = v.sub(bigint.one().shl(u64(b.len * 8))) }
    return v
}

/// The key of integer `i` of integer type `ty`: its bytes, little-endian two's
/// complement whatever the target.
pub int_key :: fn(s: ^Sema, ty: Ty, i: bigint.Int) -> types.ConstKey needs Load {
    size := s.layout(ty).size
    bytes := list(u8)
    x := i
    for _ in 0..size {
        low := x.bit_and(bigint.from_u64(255)).to_u64() else 0
        bytes.push(low.trunc(u8))!
        x = x.shr(8)
    }
    return .Bytes(ty, bytes.items)
}

/// The key of the compile-time value `v` of type `ty` used as a generic argument (§16.4),
/// or `null` after reporting that gammac cannot key it.
pub value_key :: fn(s: ^Sema, v: tir.Value, ty: Ty, span: source.Span) -> ?types.ConstKey needs Load {
    tys := &s.tys
    match v {
        .Int(bits) => if tys.is_integer(ty) {
            w: u32 = match tys.kind(ty) {
                .Int(_, b) => u32(b)
                _ => u32(target.ptr_bits)
            }
            i := bigint.from_u128(bits)
            if tys.is_signed_integer(ty) and w > 0 and (bits >> u128(w - 1)) & 1 is 1 { i = i.sub(bigint.one().shl(u64(w))) }
            return s.int_key(ty, i)
        }
        .Bool(b) => {
            bytes := list(u8)
            bytes.push(if b { 1 } else { 0 })!
            return .Bytes(ty, bytes.items)
        }
        .Fn(f) => return .Fn(f, s.fns.items[usize(f)].name)
        .Null => return .Null
        .Slice(sl) => if ty is tys.string_ty() {
            bytes := list(u8)
            for k in 0..sl.len {
                .Int(b) := value_at(sl.start, k) else {
                    s.error(span, "this compile-time string points outside its data (§17.4)")
                    return null
                }
                bytes.push(b.trunc(u8))!
            }
            return .Str(bytes.items)
        }
        .Float(_), .Agg(_) => {
            // Plain data by its bytes, so that values equal with `is` have one key.
            bytes := list(u8)
            for _ in 0..s.layout(ty).size.trunc(usize) { bytes.push(0)! }
            if s.canonical_bytes(v, ty, bytes.items) { return .Bytes(ty, bytes.items) }
        }
        _ => {}
    }
    s.unsupported(span, "compile-time arguments of this type")
    return null
}

/// Writes plain value `v` of type `ty` to `out` (its size) in the target's layout, but
/// with integers and floats little-endian, padding as zeros, `-0.0` as `0.0` and every
/// NaN as one NaN, so that values equal with `is` (§5.18) have equal bytes. False for
/// a value it cannot write.
canonical_bytes :: fn(s: ^Sema, v: tir.Value, ty: Ty, out: []u8) -> bool needs Load {
    tys := &s.tys
    match v {
        .Int(bits) => {
            for i in 0..out.len { out[i] = (bits >> u128(i * 8)).trunc(u8) }
            return tys.is_integer(ty)
        }
        .Bool(b) => {
            if out.len > 0 { out[0] = if b { 1 } else { 0 } }
            return true
        }
        .Float(x) => {
            raw: u64 = 0
            match tys.kind(ty) {
                .Float(64) => {
                    raw = x.bits(u64)
                    if raw & 0xfffffffffffff is not 0 and (raw >> 52) & 0x7ff is 0x7ff { raw = 0x7ff8000000000000 }
                    if raw & 0x7fffffffffffffff is 0 { raw = 0 }
                }
                .Float(32) => {
                    raw = u64(x.to(f32).bits(u32))
                    if raw & 0x7fffff is not 0 and (raw >> 23) & 0xff is 0xff { raw = 0x7fc00000 }
                    if raw & 0x7fffffff is 0 { raw = 0 }
                }
                _ => return false
            }
            for i in 0..out.len { out[i] = (raw >> u64(i * 8)).trunc(u8) }
            return true
        }
        .Agg(a) => match tys.kind(ty) {
            .Array(_, elem, _) => {
                size := s.layout(elem).size.trunc(usize)
                for i, x in enumerate(a.elems) {
                    if (i + 1) * size > out.len or not s.canonical_bytes(x, elem, out[i * size..(i + 1) * size]) { return false }
                }
                return true
            }
            .Tuple(elems, _) => {
                offset: u64 = 0
                for i, e in enumerate(elems) {
                    l := s.layout(e)
                    offset = (offset + l.align - 1) / l.align * l.align
                    if i >= a.elems.len or not s.canonical_field(a.elems[i], e, offset, out) { return false }
                    offset += l.size
                }
                return true
            }
            .Adt(id, _) => {
                .Struct(def) := s.adts.items[usize(id)].kind else return false
                if def.bits is not null { return false }
                for i, f in enumerate(def.fields) {
                    if i >= a.elems.len or not s.canonical_field(a.elems[i], f.ty, s.field_offset(ty, i), out) { return false }
                }
                return true
            }
            _ => return false
        }
        _ => return false
    }
}

/// `canonical_bytes` for a field at byte `offset` of `out`.
canonical_field :: fn(s: ^Sema, v: tir.Value, ty: Ty, offset: u64, out: []u8) -> bool needs Load {
    start := offset.trunc(usize)
    end := start + s.layout(ty).size.trunc(usize)
    if end > out.len { return false }
    return s.canonical_bytes(v, ty, out[start..end])
}

/// The value `k` elements after place `p`.
value_at :: fn(p: tir.Place, k: u64) -> ?tir.Value {
    v := p.cell.v
    for i, x in enumerate(p.path) {
        .Agg(a) := v else return null
        j := if i + 1 is p.path.len { x + k } else { x }
        if j >= u64(a.elems.len) { return null }
        v = a.elems[j.trunc(usize)]
    }
    return v
}
