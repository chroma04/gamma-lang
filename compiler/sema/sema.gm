//! Semantic analysis: name resolution and the checking of declarations.
//!
//! Analysis is demand-driven, as in the reference implementation. Each top-level
//! declaration is resolved the first time something needs it (`resolve_decl`); a
//! declaration requested while it is being resolved is a dependency cycle (§3.4).
//!
//! gammac checks declarations so far: what each top-level binding denotes (a type, an
//! effect, a function signature, a constant, …), as `gamma decls` shows it. Where it meets
//! a construct it cannot check yet it reports so (`unsupported`), and the result is not
//! to be compared with the reference implementation's.

ast :: import "../ast"
bigint :: import "../bigint"
diag :: import "../diag"
hash_map :: import "std/collections/hash_map"
load :: import "../load"
source :: import "../source"
str :: import "std/str"
tir :: import "../tir"
types :: import "../types"

Ty :: types.Ty
TyKind :: types.TyKind
EffectRef :: types.EffectRef
EffectSet :: types.EffectSet
GenericArg :: types.GenericArg

/// What resolving can do: allocate, and load the modules that imports name.
pub Load :: Alloc + Fs

/// What a top-level binding denotes.
pub DeclValue :: union {
    /// A type (an alias, or a nominal `struct`/`union` literal).
    Type: Ty
    /// A generic struct or union, by its id, applied to arguments to give a type (§16.4).
    GenericType: u32
    /// An effect, by its id.
    Effect: u32
    /// A generic effect with its arguments: `Ev :: Events(Msg)` (§3.5).
    EffectInst: EffectRef
    /// A named effect set: `Io :: Fs + Alloc` (§12.3).
    EffectSet: EffectSet
    /// A function, by its index in `Sema.fns`.
    Fn: u32
    /// An effect operation: the effect and the operation's index (§12.1).
    Op: (effect_: u32, index: u32)
    /// A typed constant, of this type.
    Const: Ty
    /// An untyped constant (§6.2).
    Untyped: Untyped
    /// A module binding (§3.2), by the module's index.
    Module: usize
    /// A `#global` variable (§19.3), of this type.
    Global: Ty
    /// The declaration has errors (already reported).
    Error
}

DeclState :: union {
    Unresolved
    InProgress
    Done: DeclValue
}

/// A parameter of a function signature or of an effect operation.
pub ParamInfo :: struct {
    pub name: string
    pub ty: Ty
    pub span: source.Span
    /// A default argument, evaluated at each call.
    pub default: ?^ast.Expr
    /// For a type parameter (`T: type`) or a compile-time value parameter (`N :: usize`):
    /// its identity in the signature's types.
    pub generic: ?u32
    /// A rest parameter `name: ..T` (§11.3).
    pub rest: bool
}

/// The signature of a function.
pub FnSig :: struct {
    pub name: string
    pub span: source.Span
    /// The module the function is declared in.
    pub module: usize
    pub params: []ParamInfo
    pub ret: Ty
    pub effects: EffectSet
    /// The type parameters, in order (empty unless the function is generic, §16.1).
    pub generics: []u32
    /// For an instance of a generic function: the generic function and the arguments.
    pub instance: ?FnInstance = null
    /// Whether the function has the Win64 calling convention (`#callconv(.Win64)`, §19.2).
    pub win64: bool = false
}

/// A top-level function whose body is still to be checked.
pub PendingBody :: struct {
    pub fn_id: u32
    pub module: usize
    pub lit: ^const ast.FnLit
}

/// A typed constant's initializer or a field's default value, checked with the function
/// bodies against its declared type.
pub PendingConst :: struct {
    pub module: usize
    pub init: ^const ast.Expr
    pub ty: Ty
}

/// A handler declaration `handler E for T needs A { … }` for a non-generic type (§12.6).
pub HandlerDeclInfo :: struct {
    pub effect_: EffectRef
    pub for_ty: Ty
    /// The effects its clauses perform, where the `with` installing it is.
    pub effects: EffectSet
    /// By operation; an operation without a clause has none.
    pub clauses: []u32
}

/// A clause of a handler declaration whose body is still to be checked.
pub PendingClause :: struct {
    pub module: usize
    pub clause: ^const ast.Clause
    pub fn_id: u32
    pub kind: ast.OpKind
}

/// A `break` in a clause of a handler declaration, which exits the `with` installing
/// the handler (§12.7).
pub DeclBreak :: struct {
    pub fn_id: u32
    pub ty: Ty
    pub span: source.Span
}

/// A `with` installing handler declarations, whose clauses' `break`s must give values of
/// its type.
pub DeclWithCheck :: struct {
    pub decls: []u32
    pub ty: Ty
    pub span: source.Span
}

pub InlineFn :: struct {
    pub fn_id: u32
    pub span: source.Span
}

pub OpInfo :: struct {
    pub name: string
    pub kind: ast.OpKind
    pub params: []ParamInfo
    pub ret: Ty
}

/// An effect declaration (§12.1).
pub EffectInfo :: struct {
    pub name: string
    pub module: usize
    /// The parameters of a generic effect (`Yield(T)`).
    pub params: []u32
    pub ops: []OpInfo
}

pub FieldDef :: struct {
    pub name: string
    pub ty: Ty
    pub vis: ast.Visibility
    /// `#align(n)` on the field.
    pub align: ?u64
}

pub VariantDef :: struct {
    pub name: string
    pub payload: ?Ty
    /// The tag value (fits the union's tag type).
    pub tag: bigint.Int
}

pub StructDef :: struct {
    pub fields: []FieldDef
    pub packed: bool
    pub align: ?u64
    /// `#bits(U)`: the underlying integer type.
    pub bits: ?Ty
}

pub AdtKind :: union {
    Struct: StructDef
    Union: (tag: Ty, variants: []VariantDef)
    /// `#c_union`: every field at offset 0, no tag.
    CUnion: []FieldDef
}

/// A struct or union type, by its id (the index in `Sema.adts`).
pub AdtInfo :: struct {
    pub name: string
    pub module: usize
    pub kind: AdtKind
    /// For a struct: whether each field has a default value.
    pub defaults: []bool
    /// For a struct: the default value of each field, if any.
    pub default_exprs: []?^ast.Expr
    /// The first field of a struct is declared `using` (§5.10.3).
    pub has_using: bool
    /// The type parameters of a generic struct or union, and their default arguments.
    pub params: []u32
    pub param_defaults: []?^ast.Expr
    /// Declared with an explicit tag type (`union(u8) { … }`).
    pub explicit_tag: bool
    /// The literal, for errors found when instantiating a generic type.
    pub span: source.Span
    /// The top-level declaration that names it.
    pub decl: ?usize
}

/// The constraints of §16.3.
pub Constraint :: union { Eq, Ord, Num, Int, Neg, Float, Plain }

/// What a generic parameter stands for.
pub ParamKind :: union {
    Type
    /// An effect-set parameter (`E: effects`, §16.6).
    Effects
    /// A compile-time value parameter, of this type (§16.5).
    Value: Ty
}

ParamData :: struct {
    kind: ParamKind
    constraints: List(Constraint)
}

/// A generic struct or union instantiated for some arguments.
Instance :: struct {
    template: u32
    args: []Ty
    inst: u32
}

/// A name in scope for type expressions: a type parameter or a value parameter.
Scoped :: struct {
    name: string
    ty: Ty
}

ValueScoped :: struct {
    name: string
    param: u32
}

/// A constraint on a type argument to check when the `where` clause of the signature or
/// type being declared is known.
Deferred :: struct {
    ty: Ty
    c: Constraint
    param: u32
    template: u32
    span: source.Span
}

/// A function or operation that is a method candidate of a struct or union (§7.10).
MethodCandidate :: struct {
    adt: u32
    name: string
    span: source.Span
    is_op: bool
}

pub Sema :: struct {
    pub l: ^load.Loader
    pub tys: types.Types
    /// The state of each declaration of the loader, by index.
    states: List(DeclState)
    pub fns: List(FnSig)
    /// The checked form of each function, by the same index as `fns`; a function whose
    /// body is not checked yet has none.
    pub defs: List(tir.FnDef)
    /// The top-level functions whose bodies are still to be checked, in declaration order.
    pub pending_bodies: List(PendingBody)
    pub pending_consts: List(PendingConst)
    /// The handler literals of the bodies checked so far (§12.5).
    pub handlers: List(tir.HandlerLit)
    pub handler_decls: List(HandlerDeclInfo)
    /// Whether a handler declaration for a generic type was seen.
    pub handler_templates: bool
    /// Set while the body of a test or benchmark is checked.
    pub in_test: bool
    pub pending_clauses: List(PendingClause)
    pub decl_clause_breaks: List(DeclBreak)
    pub decl_with_checks: List(DeclWithCheck)
    /// The functions marked `#inline` (§11.10), and where.
    pub inline_fns: List(InlineFn)
    /// The symbols the program exports (§19.4).
    pub exports: List(string)
    /// The program's `#trap_hook` function (§3.7.1).
    pub trap_hook: ?u32
    /// By effect id; the first is the pseudo-effect of `..E` terms.
    pub effects: List(EffectInfo)
    pub adts: List(AdtInfo)
    /// By parameter id.
    params: List(ParamData)
    instances: List(Instance)
    /// The instances of generic functions, by the function and its arguments.
    fn_instances: hash_map.HashMap((u32, []const Ty), u32)
    /// The instances of generic functions whose calls are still to be followed, and how
    /// deeply instantiations nest at the one being followed (§16.7).
    pub mono_queue: List(MonoRequest)
    pub mono_depth: u32
    /// Set while resolving the signature of a foreign function, which may be variadic.
    allow_variadic: bool
    /// The variadic foreign functions (§19.2).
    pub variadic_fns: List(u32)
    type_params: List(Scoped)
    value_scope: List(ValueScoped)
    /// The declarations being resolved, for cycle reports.
    resolving: List(usize)
    /// Structural type aliases being resolved a second time (see `resolve_decl`).
    alias_reentry: List(usize)
    /// Structs and unions whose fields are being resolved.
    pub adts_in_progress: List(u32)
    constraint_defer: u32
    deferred: List(Deferred)
    adt_inst_depth: u32
    adt_new_instances: List(Instance)
    adt_inst_overflowed: bool
    method_candidates: List(MethodCandidate)
    layout_cache: List(?Layout)
    /// The ambient effects (§12.9), once resolved.
    pub yield_effect: ?u32
    /// The typed constants and evaluated defaults (§17.2), by where they are declared and
    /// their type.
    pub consts: List(tir.ConstDef)
    const_ids: hash_map.HashMap((source.Span, Ty), u32)
    /// The bodies of the instances of generic functions produced so far (§16.7).
    inst_defs: hash_map.HashMap(u32, tir.FnDef)
    /// The functions whose bodies are being checked, for cycles of compile-time
    /// evaluation.
    pub checking: List(u32)
    /// Checks the constant expression `e` against `expected` and evaluates it, as the
    /// constant `name` declared at `span`: its id once evaluated, or `null` after
    /// reporting why not (installed by the body checker).
    pub eval_hook: ?^fn(s: ^Sema, module: usize, e: ^const ast.Expr, expected: ?Ty, name: string, span: source.Span) -> ?u32 needs Alloc + Fs = null
    /// The length of an array given by the typed constant expression `e` (installed by
    /// the body checker).
    pub length_hook: ?^fn(s: ^Sema, module: usize, e: ^const ast.Expr) -> ArrayLen needs Alloc + Fs = null
    /// The type of the constant expression `e`, for `@type_of(e)` (installed by the body
    /// checker).
    pub type_of_hook: ?^fn(s: ^Sema, module: usize, e: ^const ast.Expr) -> Ty needs Alloc + Fs = null
    /// The array lengths computed from compile-time parameters, with where they are
    /// written, checked for each instantiation (§16.5).
    pub len_exprs: List((t: Ty, span: source.Span))
    /// The messages of the static assertions checked for each instance (§17.7).
    pub deferred_asserts: List(?[]u8)
    /// The step budget of compile-time evaluations in the declaration being resolved
    /// (§17.3).
    pub fuel: u64 = 50_000_000
    /// Set while gammac tries an expression as an untyped constant without reporting why
    /// it is not one.
    pub quiet_untyped: bool = false
}

pub sema :: fn(l: ^load.Loader) -> Sema needs Alloc {
    s := Sema(
        l: l,
        tys: types.types(),
        states: list(DeclState),
        fns: list(FnSig),
        defs: list(tir.FnDef),
        pending_bodies: list(PendingBody),
        pending_consts: list(PendingConst),
        handlers: list(tir.HandlerLit),
        handler_decls: list(HandlerDeclInfo),
        handler_templates: false,
        in_test: false,
        pending_clauses: list(PendingClause),
        decl_clause_breaks: list(DeclBreak),
        decl_with_checks: list(DeclWithCheck),
        inline_fns: list(InlineFn),
        exports: list(string),
        trap_hook: null,
        effects: list(EffectInfo),
        adts: list(AdtInfo),
        params: list(ParamData),
        instances: list(Instance),
        fn_instances: hash_map.hash_map((u32, []const Ty), u32),
        mono_queue: list(MonoRequest),
        mono_depth: 0,
        allow_variadic: false,
        variadic_fns: list(u32),
        type_params: list(Scoped),
        value_scope: list(ValueScoped),
        resolving: list(usize),
        alias_reentry: list(usize),
        adts_in_progress: list(u32),
        constraint_defer: 0,
        deferred: list(Deferred),
        adt_inst_depth: 0,
        adt_new_instances: list(Instance),
        adt_inst_overflowed: false,
        method_candidates: list(MethodCandidate),
        layout_cache: list(?Layout),
        yield_effect: null,
        consts: list(tir.ConstDef),
        const_ids: hash_map.hash_map((source.Span, Ty), u32),
        inst_defs: hash_map.hash_map(u32, tir.FnDef),
        checking: list(u32),
        len_exprs: list((t: Ty, span: source.Span)),
        deferred_asserts: list(?[]u8),
    )
    s.effects.push(EffectInfo(name: "..", module: 0, params: empty_slice(u32), ops: empty_slice(OpInfo)))!
    return s
}

/// The default number of steps of one compile-time evaluation (§17.3).
pub STEP_BUDGET: u64 : 50_000_000

/// The checked form of function `f`: an instance of a generic function has the body
/// produced for its arguments, once it is.
pub def_of :: fn(s: ^const Sema, f: u32) -> tir.FnDef {
    if d := s.inst_defs.get(f) { return d }
    return s.defs.items[usize(f)]
}

/// Records the body produced for instance `f`.
pub set_inst_def :: fn(s: ^Sema, f: u32, d: tir.FnDef) needs Alloc {
    s.inst_defs.put(f, d)!
}

/// The constant declared at `span` with type `ty`, if it is registered.
pub const_id :: fn(s: ^const Sema, span: source.Span, ty: Ty) -> ?u32 => s.const_ids.get((span, ty))

/// Registers a constant to evaluate when its value is needed.
pub add_const :: fn(s: ^Sema, c: tir.ConstDef) -> u32 needs Alloc {
    id := s.consts.items.len.trunc(u32)
    s.consts.push(c)!
    s.const_ids.put((c.span, c.ty), id)!
    return id
}

/// The prefix of the message of every construct gammac cannot check yet.
pub UNSUPPORTED :: "gammac cannot check"

/// Whether a type or value parameter of a generic body is in scope.
pub in_generic_scope :: fn(s: ^const Sema) -> bool {
    if s.value_scope.items.len > 0 { return true }
    for p in s.type_params.items {
        if s.tys.has_param(p.ty) { return true }
    }
    return false
}

/// Reports that gammac cannot check `what` yet.
pub unsupported :: fn(s: ^Sema, span: source.Span, what: string) needs Alloc {
    s.error(span, str.format("{} {} yet", UNSUPPORTED, what)!)
}

pub error :: fn(s: ^Sema, span: source.Span, message: string) needs Alloc {
    s.l.diags.report(span, message)
}

pub emit :: fn(s: ^Sema, d: diag.Diagnostic) needs Alloc {
    s.l.diags.push(d)
}

/// The text of `t`.
pub show :: fn(s: ^const Sema, t: Ty) -> string needs Alloc => s.tys.show(t)

// ---------------------------------------------------------------------------------
// The declarations of a program
// ---------------------------------------------------------------------------------

/// Resolves the core library's ambient effects, as loading the prelude does, so that
/// their ids come first.
pub resolve_ambient :: fn(s: ^Sema) needs Load {
    prelude := s.l.prelude else return
    if d := s.l.lookup(prelude, "Yield") {
        if .Effect(e) := s.resolve_decl(d) { s.yield_effect = e }
    }
    names := [12]string("Out", "Err", "Env", "Alloc", "Sys", "In", "Clock", "Rand", "Fs", "Net", "Test", "Proc")
    for name in names {
        if d := s.l.lookup(prelude, name) { _ = s.resolve_decl(d) }
    }
}

/// The generic type `name` of the core prelude, if it declares one.
prelude_template :: fn(s: ^Sema, name: string) -> ?u32 needs Load {
    prelude := s.l.prelude else return null
    d := s.l.lookup(prelude, name) else return null
    .GenericType(template) := s.resolve_decl(d) else return null
    return template
}

/// The type argument of `t` if `t` is an instance of the prelude's generic type `name`.
prelude_instance_arg :: fn(s: ^Sema, t: Ty, name: string) -> ?Ty needs Load {
    .Adt(id, args) := s.tys.kind(t) else return null
    template := s.prelude_template(name) else return null
    if s.tys.template(id) is not template or args.len is 0 { return null }
    .Type(e) := args[0] else return null
    return e
}

/// `T` if `t` is `Complex(T)` (§5.3.1).
pub complex_of :: fn(s: ^Sema, t: Ty) -> ?Ty needs Load => s.prelude_instance_arg(t, "Complex")

/// If `t` is `Range(T)` or `RangeIncl(T)`: whether it is inclusive, and `T`.
pub range_of :: fn(s: ^Sema, t: Ty) -> ?(inclusive: bool, elem: Ty) needs Load {
    if e := s.prelude_instance_arg(t, "Range") { return (inclusive: false, elem: e) }
    if e := s.prelude_instance_arg(t, "RangeIncl") { return (inclusive: true, elem: e) }
    return null
}

/// The default value of field `i` of struct `id`, if it has one.
pub field_default_expr :: fn(s: ^const Sema, id: u32, i: usize) -> ?^ast.Expr {
    exprs := s.adts.items[usize(id)].default_exprs
    if i >= exprs.len { return null }
    return exprs[i]
}

/// Whether effect `eff` is one of the ambient effects the runtime serves (§12.9): those
/// of the core library other than `Yield` and `Test`.
pub is_ambient :: fn(s: ^const Sema, eff: u32) -> bool {
    info := &s.effects.items[usize(eff)]
    if not s.l.modules.items[info.module].is_prelude { return false }
    return info.name in ("Out", "Err", "Env", "Alloc", "Sys", "In", "Clock", "Rand", "Fs", "Net", "Proc")
}

/// Resolves the declarations of every loaded module, as checking does before it checks
/// the function bodies: module by module in load order, each module's declarations in
/// declaration order, then the checks that span declarations.
pub resolve_declarations :: fn(s: ^Sema) needs Load {
    done: usize = 0
    while done < s.l.modules.items.len {
        m := done
        done += 1
        if s.l.modules.items[m].is_prelude { continue }
        // Resolving may load modules and add declarations, but not to this module.
        n := s.l.modules.items[m].scope.items.len
        for i in 0..n {
            _ = s.resolve_decl(s.l.modules.items[m].scope.items[i].decl)
        }
    }
    s.check_method_candidates()
    s.l.check_import_cycles()
    s.check_pub_signatures()
}

state :: fn(s: ^Sema, id: usize) -> DeclState needs Alloc {
    while s.states.items.len <= id { s.states.push(.Unresolved)! }
    // A module binding of the core library is resolved when it is declared.
    if s.states.items[id] is .Unresolved and s.l.decls.items[id].item.kind is .Intrinsic(_) {
        if .Module(m) := s.l.decls.items[id].state { s.states.items[id] = .Done(.Module(m)) }
    }
    return s.states.items[id]
}

set_state :: fn(s: ^Sema, id: usize, v: DeclState) needs Alloc {
    _ = s.state(id)
    s.states.items[id] = v
}

/// The value of declaration `id`, resolving it the first time.
pub resolve_decl :: fn(s: ^Sema, id: usize) -> DeclValue needs Load {
    match s.state(id) {
        .Done(v) => return v
        .InProgress => {
            // `Link :: ?^Node` used by a field of `Node` while `Link` is being resolved:
            // `Node` is usable by now, so resolving the alias again succeeds. A real cycle
            // is found again on the second pass.
            if s.is_structural_alias(id) and id not in s.alias_reentry.items {
                s.alias_reentry.push(id)!
                v := s.compute_decl(id)
                if i := s.alias_reentry.items.index_of(id) { _ = s.alias_reentry.remove(i) }
                return v
            }
            s.report_cycle(id)
            return .Error
        }
        .Unresolved => {}
    }
    s.set_state(id, .InProgress)
    s.resolving.push(id)!
    // Its own errors are reported, whatever needed it.
    quiet := s.quiet_untyped
    s.quiet_untyped = false
    defer s.quiet_untyped = quiet
    // A declaration is resolved in its module's scope: the names of whatever needed it
    // first are not visible.
    type_params := s.type_params
    value_scope := s.value_scope
    s.type_params = list(Scoped)
    s.value_scope = list(ValueScoped)
    v := s.compute_decl(id)
    s.type_params = type_params
    s.value_scope = value_scope
    _ = s.resolving.pop()
    // A cycle report may already have marked this declaration as failed.
    if s.states.items[id] is .InProgress { s.states.items[id] = .Done(v) }
    if .Done(r) := s.states.items[id] { return r }
    return .Error
}

/// Whether declaration `id` is an alias for a structural type built with pointer, slice,
/// optional, array or function type syntax; resolving one has no side effects, so it may
/// be done twice.
is_structural_alias :: fn(s: ^const Sema, id: usize) -> bool {
    d := &s.l.decls.items[id]
    if d.item.attrs.len > 0 { return false }
    .Binding(b) := d.item.kind else return false
    if b.ty is not null { return false }
    return match b.init.kind {
        .OptionalType(_), .PtrType(_), .SliceType(_), .ManyPtrType(_), .ArrayType(_), .ErrorUnionType(_), .FnType(_) => true
        _ => false
    }
}

report_cycle :: fn(s: ^Sema, id: usize) needs Alloc {
    start := s.resolving.items.index_of(id) else 0
    cycle := s.resolving.items[start..]
    names := list(string)
    for d in cycle { names.push(str.format("`{}`", s.l.decls.items[d].name.name)!)! }
    span := s.l.decls.items[id].name.span
    d := diag.error(span, str.format("dependency cycle between declarations: {}", str.join(names.items, " -> ")!)!)
    for c in cycle[1..] { d.add_label(s.l.decls.items[c].name.span, "part of the cycle") }
    s.emit(d)
    for c in cycle { s.set_state(c, .Done(.Error)) }
}

compute_decl :: fn(s: ^Sema, id: usize) -> DeclValue needs Load {
    decl := s.l.decls.items[id]
    item := decl.item
    module := decl.module
    name := decl.name
    .Binding(b) := item.kind else return .Error
    global := false
    thread_local := false
    fuel: ?u64 = null
    hints: ?ast.Attribute = null
    inline := false
    align_attr: ?ast.Attribute = null
    export: ?(sym: string, span: source.Span) = null
    callconv: ?(win64: bool, span: source.Span) = null
    trap_hook: ?source.Span = null
    for attr in item.attrs {
        match attr.name.name {
            "global" => { global = true }
            // `#global #align(n)` (§20.2); on anything else, an error below.
            "align" => {
                if align_attr is null {
                    align_attr = attr
                } else {
                    s.error(attr.span, "`#align` goes directly before a `struct` or `union` literal (§20.2)")
                }
            }
            "thread_local" => { thread_local = true }
            // `#fuel(n)` raises the step budget of this declaration's evaluations (§17.3).
            "fuel" => {
                ok := false
                if args := attr.args and args.len is 1 {
                    if r := s.try_untyped(module, &args[0]) and .Ok(.Int(i)) := r and i.is_positive() {
                        if n := i.to_u64() {
                            fuel = n
                            ok = true
                        }
                    }
                }
                if not ok { s.error(attr.span, "`#fuel(n)` takes a positive integer constant") }
            }
            "export" => {
                ok := false
                if args := attr.args and args.len is 1 and .Str(lit) := args[0].kind {
                    if not lit.bytes.utf8_valid() { s.unsupported(args[0].span, "symbol names with special characters") }
                    export = (sym: lit.bytes, span: attr.span)
                    ok = true
                }
                if not ok { s.error(attr.span, "`#export` takes the symbol name: `#export(\"sym\")`") }
            }
            "trap_hook" => {
                if args := attr.args and args.len > 0 { s.error(attr.span, "`#trap_hook` takes no arguments") }
                trap_hook = attr.span
            }
            "callconv" => {
                if callconv is not null { s.error(attr.span, "a function has one calling convention") }
                callconv = null
                if w := s.callconv_attr(&attr) { callconv = (win64: w, span: attr.span) }
            }
            // Inlining hints (§11.10) do not change the meaning of a program.
            "inline", "noinline", "cold", "fast_math" => {
                if attr.name.name in ("inline", "noinline") { inline = attr.name.name is "inline" }
                hints = attr
            }
            // Read by `gamma lint`.
            "allow" => s.check_allow_attr(&attr)
            // Uses of the declaration warn.
            "deprecated" => {
                ok := true
                if args := attr.args {
                    ok = args.len is 1 and args[0].kind is .Str(_)
                }
                if not ok { s.error(attr.span, "`#deprecated` takes an optional message: `#deprecated(\"use g\")`") }
            }
            "packed", "bits", "c_union" => s.error(attr.span, str.format("`#{}` goes directly before a `struct` or `union` literal (§20.2)", attr.name.name)!)
            "link_name" => s.error(attr.span, "`#link_name` applies to a member of a `foreign` block (§19.2)")
            other => s.error(attr.span, str.format("unknown attribute `#{}` (§20.2)", other)!)
        }
    }
    if thread_local and not global { s.error(name.span, "`#thread_local` applies only to a `#global`") }
    if a := align_attr {
        if global {
            _ = s.attr_power_of_two(module, &a)
        } else {
            s.error(a.span, "`#align` goes directly before a `struct` or `union` literal, or on a `#global` (§20.2)")
        }
    }
    v: DeclValue = .Error
    saved_fuel := s.fuel
    s.fuel = fuel else STEP_BUDGET
    if global {
        v = s.declare_global(module, name, &b)
    } else {
        v = s.compute_binding(id, module, name, &item, &b)
    }
    s.fuel = saved_fuel
    if c := callconv {
        match v {
            .Fn(f) => s.apply_callconv(f, c.win64, c.span)
            .Error => {}
            _ => s.error(c.span, "`#callconv` applies only to a function, a foreign function or a `^fn` type")
        }
    }
    if h := hints {
        if .Fn(f) := v and inline { s.inline_fns.push(InlineFn(fn_id: f, span: h.span))! }
        if v is not .Fn(_) and v is not .Error {
            s.error(h.span, str.format("`#{}` applies only to a function (§20.2)", h.name.name)!)
        }
    }
    if span := trap_hook {
        match v {
            .Fn(f) => s.trap_hook_fn(f, span)
            .Error => {}
            _ => s.error(span, "`#trap_hook` applies only to a function")
        }
    }
    if e := export {
        match v {
            .Fn(f) => s.export_fn(f, e.sym, e.span)
            .Error => {}
            _ => s.error(e.span, "`#export` applies only to a function")
        }
    }
    return v
}

check_allow_attr :: fn(s: ^Sema, attr: ^const ast.Attribute) needs Alloc {
    args := attr.args else empty_slice(ast.Expr)
    if args.len is 0 { s.error(attr.span, "`#allow` takes the names of lint rules: `#allow(\"unused-parameter\")`") }
    for a in args {
        if a.kind is not .Str(_) { s.error(a.span, "`#allow` takes the names of lint rules as string literals") }
    }
}

compute_binding :: fn(s: ^Sema, id: usize, module: usize, name: ast.Ident, item: ^const ast.Item, b: ^const ast.Binding) -> DeclValue needs Load {
    if b.kind is .Var {
        if b.init.kind is .Import(_) {
            // The loader reports it.
            s.l.resolve_import(id)
            return .Error
        }
        e := diag.error(b.span, "top-level bindings are immutable; use `::` (mutable storage needs `#global`)")
        // `x := v` becomes `x :: v`.
        between := source.Span(file: b.span.file, lo: name.span.hi, hi: b.init.span.lo)
        text := s.l.sm.file(between.file).text[usize(between.lo)..usize(between.hi)]
        if b.ty is null and str.trim(text) is ":=" { e.add_fix("write `::`", between, " :: ") }
        s.emit(e)
        return .Error
    }
    init := b.init
    match init.kind {
        .Import(_) => {
            s.l.resolve_import(id)
            return match s.l.decls.items[id].state {
                .Module(m) => DeclValue.Module(m)
                _ => DeclValue.Error
            }
        }
        .Foreign(blk) => if b.ty is null { return s.declare_foreign(module, name, blk) }
        .Fn(lit) => if b.ty is null { return s.declare_fn(module, name, lit) }
        .Effect(lit) => if b.ty is null { return s.declare_effect(module, id, name, lit) }
        // `Io :: Fs + Alloc`: a named effect set (§12.3).
        .Binary(.Add(.Checked), _, _) => {
            if b.ty is null and s.is_effect_sum(module, init) {
                set := s.resolve_effect_set(module, effect_terms(init))
                if has_splice(set) {
                    s.error(init.span, "a named effect set cannot contain an effect-set parameter")
                    return .Error
                }
                return .EffectSet(set)
            }
        }
        .Handler(_) => {
            s.error(init.span, "a handler literal cannot be a top-level declaration; bind it inside a function, or declare a handler for a type with `handler E for T { … }` (§12.6)")
            return .Error
        }
        .Struct(_), .Union(_) => {
            if b.ty is null {
                ty := s.declare_adt(module, id, name.name, init)
                return if s.tys.is_error(ty) { DeclValue.Error } else { DeclValue.Type(ty) }
            }
        }
        .Attributed(_, inner) => {
            if b.ty is null and inner.kind in (.Struct(_), .Union(_)) {
                ty := s.declare_adt(module, id, name.name, init)
                return if s.tys.is_error(ty) { DeclValue.Error } else { DeclValue.Type(ty) }
            }
        }
        _ => {}
    }
    // An untyped constant expression?
    if b.ty is null {
        if r := s.try_untyped(module, init) {
            return match r {
                .Ok(v) => DeclValue.Untyped(v)
                .Failed => DeclValue.Error
            }
        }
    }
    return s.declare_const_or_type(module, name, b.ty, init)
}

/// A binding whose initializer is a type expression (an alias) or a typed constant.
declare_const_or_type :: fn(s: ^Sema, module: usize, name: ast.Ident, annot: ?^ast.Expr, init: ^const ast.Expr) -> DeclValue needs Load {
    if annot is null {
        // A name for another declaration (§3.5): `mk :: shapes.make`, `Map :: HashMap`.
        if found := s.aliased_decl(module, init) {
            d := found.decl else return .Error
            v := s.resolve_decl(d)
            match v {
                .Const(_), .Global(_) => {}
                _ => return v
            }
        }
        // `Ev :: Events(Msg)`: an instantiation of a generic effect.
        if .Call(callee, _, _) := init.kind {
            if found := s.aliased_decl(module, callee) {
                if d := found.decl {
                    if s.resolve_decl(d) is .Effect(_) {
                        r := s.resolve_effect_ref(module, init) else return .Error
                        return .EffectInst(r)
                    }
                }
            }
        }
        if s.looks_like_type(module, init) {
            ty := s.resolve_type(module, init)
            return if s.tys.is_error(ty) { DeclValue.Error } else { DeclValue.Type(ty) }
        }
    }
    expected: ?Ty = null
    if a := annot { expected = s.resolve_type(module, a) }
    if t := expected and s.tys.is_error(t) { return .Error }
    // What gammac can type without checking it as an expression is evaluated when its
    // value is needed; anything else is checked and evaluated now (§17.2).
    if hook := s.eval_hook and s.const_check(module, init, expected) is null {
        id := hook(s, module, init, expected, name.name, name.span) else return .Error
        return .Const(s.consts.items[usize(id)].ty)
    }
    ty := s.const_type(module, init, expected) else return .Error
    if s.eval_hook is not null {
        _ = s.add_const(tir.ConstDef(name: name.name, span: name.span, ty: ty, module: module, ast: init, expected: expected, fuel: s.fuel))
    }
    if s.tys.is_error(ty) { return .Error }
    if bad := s.non_constant_part(ty) {
        s.error(init.span, str.format("a constant cannot hold `{}`, which contains `{}` (§17.4)", s.show(ty), s.show(bad))!)
        return .Error
    }
    return .Const(ty)
}

/// A declaration that `e` names, if it is a plain name or `m.name`: a candidate for an
/// alias declaration. `decl` is `null` if `name` is missing from or private to module `m`
/// (reported).
AliasTarget :: struct {
    decl: ?usize
}

aliased_decl :: fn(s: ^Sema, module: usize, e: ^const ast.Expr) -> ?AliasTarget needs Load {
    match e.kind {
        .Ident(id) => {
            d := s.lookup_module_name(module, id.name) else return null
            return AliasTarget(decl: d)
        }
        .Paren(inner) => return s.aliased_decl(module, inner)
        .Field(base, name) => {
            m := s.module_named(module, base) else return null
            return AliasTarget(decl: s.module_member(m, name, module))
        }
        _ => return null
    }
}

/// The part of a type that a constant may not contain (§17.4): mutable pointers,
/// `rawptr`, continuations, and allocator handles.
pub non_constant_part :: fn(s: ^const Sema, t: Ty) -> ?Ty {
    bad: ?Ty = null
    s.walk(t, fn(x: Ty) {
        is_bad := match s.tys.kind(x) {
            .Ptr(c, _), .ManyPtr(c, _), .Slice(c, _) => not c
            .Rawptr, .Cont(_) => true
            .Adt(id, _) => s.tys.adt_name(id) is "Allocator"
            _ => false
        }
        if is_bad and bad is null { bad = x }
    })
    return bad
}

/// Calls `f` on `t` and every type it is built from (not through definitions).
pub walk :: fn(s: ^const Sema, t: Ty, f: fn(t: Ty)) {
    f(t)
    k := s.tys.kind(t)
    types.for_each_component(&k, fn(c: Ty) { s.walk(c, f) })
}

// ---------------------------------------------------------------------------------
// Checks across declarations
// ---------------------------------------------------------------------------------

/// Records the function or operation `name` of `module`, whose first run-time parameter
/// has type `first`, as a method candidate of that type if the type is declared in
/// `module`. A struct may not have both a field and a method candidate named alike (§7.10).
declare_method_candidate :: fn(s: ^Sema, module: usize, name: ast.Ident, first: Ty, is_op: bool) needs Alloc {
    t := first
    if .Ptr(_, p) := s.tys.kind(first) { t = p }
    .Adt(adt, _) := s.tys.kind(t) else return
    if s.adts.items[usize(adt)].module is not module { return }
    if .Struct(def) := s.adts.items[usize(adt)].kind {
        for f in def.fields {
            if f.name is name.name {
                s.error(name.span, str.format("`{}` has a field `{}`, so a method of that name could never be called (§7.10)", s.show(t), name.name)!)
                break
            }
        }
    }
    s.method_candidates.push(MethodCandidate(adt: s.tys.template(adt), name: name.name, span: name.span, is_op: is_op))!
}

/// Reports a type with two method candidates of one name (§7.10).
check_method_candidates :: fn(s: ^Sema) needs Alloc {
    seen := list(MethodCandidate)
    for c in s.method_candidates.items {
        first: ?source.Span = null
        for x in seen.items {
            if x.adt is c.adt and x.name is c.name {
                first = x.span
                break
            }
        }
        f := first else {
            seen.push(c)!
            continue
        }
        // Report at the later declaration.
        at := c.span
        other := f
        if c.span.file < f.file or (c.span.file is f.file and c.span.lo < f.lo) {
            at = f
            other = c.span
        }
        d := diag.error(at, str.format("`{}` would have two methods named `{}`: a method call must find exactly one (§7.10)", s.adts.items[usize(c.adt)].name, c.name)!)
        d.add_label(other, "the other candidate")
        s.emit(d)
    }
    s.method_candidates.clear()
}

/// A declaration's signature must not mention a type less visible than the declaration
/// (§3.3).
check_pub_signatures :: fn(s: ^Sema) needs Alloc {
    for i in 0..s.l.decls.items.len {
        d := &s.l.decls.items[i]
        vis := d.item.vis
        if vis is .Private or d.item.kind is not .Binding(_) { continue }
        if i >= s.states.items.len { continue }
        .Done(v) := s.states.items[i] else continue
        // Each mentioned type with the visibility it needs.
        tys := list(Mention)
        match v {
            .Fn(f) => {
                sig := &s.fns.items[usize(f)]
                for p in sig.params {
                    if p.generic is null { tys.push(Mention(ty: p.ty, need: vis))! }
                }
                tys.push(Mention(ty: sig.ret, need: vis))!
                effect_arg_tys(sig.effects.effects, vis, &tys)
            }
            .Effect(e) => {
                for op in s.effects.items[usize(e)].ops {
                    for p in op.params {
                        if p.generic is null { tys.push(Mention(ty: p.ty, need: vis))! }
                    }
                    tys.push(Mention(ty: op.ret, need: vis))!
                }
            }
            .EffectInst(r) => effect_arg_tys([1]EffectRef(r)[..], vis, &tys)
            .EffectSet(set) => effect_arg_tys(set.effects, vis, &tys)
            .Type(t) => {
                if .Adt(id, _) := s.tys.kind(t) and s.adts.items[usize(id)].decl is i {
                    s.adt_field_tys(id, vis, &tys)
                } else {
                    tys.push(Mention(ty: t, need: vis))!
                }
            }
            .GenericType(id) => {
                if s.adts.items[usize(id)].decl is i { s.adt_field_tys(id, vis, &tys) }
            }
            .Const(t), .Global(t) => tys.push(Mention(ty: t, need: vis))!
            _ => {}
        }
        for m in tys.items {
            if h := s.hidden_part(m.ty, m.need) {
                what := if vis is .Package { "pub(package)" } else { "pub" }
                kind := if h.vis is .Package { "`pub(package)`" } else { "private" }
                s.error(d.name.span, str.format("the `{}` declaration `{}` mentions the {} type `{}` (§3.3)", what, d.name.name, kind, s.show(h.ty))!)
                break
            }
        }
    }
}

/// A type that a declaration's signature mentions, and the visibility it needs.
Mention :: struct {
    ty: Ty
    need: ast.Visibility
}

effect_arg_tys :: fn(refs: []const EffectRef, need: ast.Visibility, tys: ^List(Mention)) needs Alloc {
    for r in refs {
        for a in r.args {
            if .Type(t) := a { tys.push(Mention(ty: t, need: need))! }
        }
    }
}

/// The types of the fields of struct `id` that are visible outside its module, each
/// needing at most the visibility `vis` of the struct, or of the payloads of a union.
adt_field_tys :: fn(s: ^const Sema, id: u32, vis: ast.Visibility, tys: ^List(Mention)) needs Alloc {
    match s.adts.items[usize(id)].kind {
        .Struct(def) => push_field_tys(def.fields, vis, tys)
        .CUnion(fields) => push_field_tys(fields, vis, tys)
        .Union(_, variants) => for v in variants {
            if p := v.payload { tys.push(Mention(ty: p, need: vis))! }
        }
    }
}

push_field_tys :: fn(fields: []const FieldDef, vis: ast.Visibility, tys: ^List(Mention)) needs Alloc {
    for f in fields {
        if f.vis is .Private { continue }
        need := if f.vis.tag() < vis.tag() { f.vis } else { vis }
        tys.push(Mention(ty: f.ty, need: need))!
    }
}

/// The first type in `t` that a declaration less visible than `need` names, with that
/// declaration's visibility.
hidden_part :: fn(s: ^const Sema, t: Ty, need: ast.Visibility) -> ?(ty: Ty, vis: ast.Visibility) {
    found: ?(ty: Ty, vis: ast.Visibility) = null
    s.walk(t, fn(x: Ty) {
        if found is null {
            if .Adt(id, _) := s.tys.kind(x) {
                if d := s.adts.items[usize(s.tys.template(id))].decl {
                    vis := s.l.decls.items[d].item.vis
                    if vis.tag() < need.tag() { found = (ty: x, vis: vis) }
                }
            }
        }
    })
    return found
}
