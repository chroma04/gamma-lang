    "gm_net_shutdown", "gm_next_entry", "gm_node", "gm_note_failure", "gm_ord", "gm_out_errno",
    "gm_overflow_handler", "gm_overflow_install", "gm_overflowing", "gm_path", "gm_path_call",
    "gm_pdir", "gm_pipe_cloexec", "gm_pipe_err", "gm_pipe_ready", "gm_poison", "gm_posix_spawn",
    "gm_proc", "gm_proc_close_in", "gm_proc_get", "gm_proc_kill", "gm_proc_launch", "gm_proc_put",
    "gm_proc_read", "gm_proc_read_out", "gm_proc_try_wait", "gm_proc_wait", "gm_proc_wait_for",
    "gm_proc_write", "gm_proc_write_in", "gm_procs", "gm_quote_bytes", "gm_rand_fill", "gm_reparse",
