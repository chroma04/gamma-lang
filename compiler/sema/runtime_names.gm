    "gm_fs_symlink", "gm_fs_sync", "gm_fs_truncate", "gm_fs_write", "gm_futex_wait",
    "gm_futex_wake", "gm_hb_cap", "gm_hb_find", "gm_hb_index", "gm_hb_record", "gm_hb_slot",
    "gm_hb_tab", "gm_hb_used", "gm_hblock", "gm_heap_alloc", "gm_heap_free", "gm_heap_release",
    "gm_hval", "gm_ibp", "gm_io_error", "gm_is_batch", "gm_isize", "gm_kind", "gm_ld_v_",
    "gm_lexically_same", "gm_load_ptr", "gm_load_uint", "gm_main_call", "gm_main_thread",
    "gm_make_pipe", "gm_mkdir", "gm_mode_kind", "gm_mulhi", "gm_n_", "gm_net_accept",
