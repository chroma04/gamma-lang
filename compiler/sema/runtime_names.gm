    "gm_scratch_release", "gm_scratch_top", "gm_segv", "gm_set_args", "gm_set_cur_fiber",
    "gm_set_timeout", "gm_shortest", "gm_sink", "gm_sink_float", "gm_sink_put", "gm_sink_unsigned",
    "gm_site_str", "gm_snprintf", "gm_socket", "gm_spec", "gm_spec_exp", "gm_spec_pad",
    "gm_spec_radix", "gm_st_v_", "gm_stack_limit", "gm_stack_overflow", "gm_stat_path", "gm_strcmp",
    "gm_strlen", "gm_susp_link", "gm_susp_unlink", "gm_sys_read", "gm_sys_write", "gm_table",
    "gm_table_add", "gm_table_get", "gm_table_take", "gm_test_index", "gm_thread",
    "gm_thread_detach", "gm_thread_join", "gm_thread_main", "gm_thread_spawn", "gm_thread_stack",
    "gm_thread_stack_limit", "gm_thread_take", "gm_thread_yield", "gm_threads", "gm_trap",
    "gm_trap_bytes", "gm_trap_hook_call", "gm_trap_index", "gm_trap_lanes", "gm_trap_misaligned",
    "gm_trap_pow", "gm_trap_shift", "gm_trap_slice", "gm_trap_unwrap", "gm_type", "gm_u128_dec",
    "gm_unit", "gm_unw", "gm_unwind", "gm_utf8_arg", "gm_utf8_seq_ok", "gm_variant", "gm_veh",
    "gm_veh_install", "gm_veh_once", "gm_wasi_arg", "gm_wasi_ctx", "gm_wasi_drive", "gm_wasi_entry",
    "gm_wasi_fiber_entry", "gm_wasi_get_sp", "gm_wasi_main_ctx", "gm_wasi_next",
    "gm_wasi_rewinding", "gm_wasi_running", "gm_wasi_set_sp", "gm_wdir", "gm_wide",
    "gm_win_cmdline", "gm_win_err", "gm_with", "gm_with_clause", "gm_with_end", "gm_with_extension",
    "gm_with_go", "gm_write_err", "gm_write_out", "gm_wsa_err", "gm_wsocket"
)

/// Whether `sym` is a name of the compiled program's runtime or of the kind generated code
/// uses (`gm_` and a kind and number).
pub is_runtime_symbol :: fn(sym: string) -> bool {
    if not sym.starts_with("gm_") { return false }
    last := sym[sym.len - 1]
    if last >= '0' and last <= '9' { return true }
    return sym in RUNTIME_NAMES[..]
}
