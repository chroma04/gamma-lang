// The C identifiers of the generated programs' runtime that start with `gm_` (§23.5): a
// foreign member or an export of such a name would clash with the runtime. They are the
// identifiers of `runtime/gm_rt.h` and `runtime/gm_rt.c`; a name that ends in a digit
// is reserved for generated code and not listed.

/// The runtime's `gm_` identifiers that do not end in a digit, sorted.
RUNTIME_NAMES :: [299]string(
    "gm_alloc_check", "gm_alloc_tag", "gm_altstack_free", "gm_altstack_init", "gm_altstack_key",
    "gm_altstack_keyed", "gm_args", "gm_asyncify_start_rewind", "gm_asyncify_start_unwind",
    "gm_asyncify_stop_rewind", "gm_asyncify_stop_unwind", "gm_atag", "gm_atag_cap", "gm_atag_find",
    "gm_atag_grow", "gm_atag_slot", "gm_atag_used", "gm_atags", "gm_attr_kind", "gm_backtrace",
    "gm_bt", "gm_bt_top", "gm_buf", "gm_buf_extend", "gm_buf_free", "gm_buf_push", "gm_cancel",
    "gm_cancel_cont", "gm_checks", "gm_child_env", "gm_clause_thunk", "gm_clock_now",
    "gm_clock_sleep", "gm_clock_wall", "gm_closure", "gm_cmd_unsafe", "gm_cont", "gm_cont_take",
    "gm_cover_counts", "gm_cover_dump", "gm_cover_init", "gm_cover_n", "gm_cover_path",
    "gm_cpu_count", "gm_cstr", "gm_cstr_array", "gm_ctl_perform", "gm_ctx_init", "gm_cur_fiber",
    "gm_cv_u_", "gm_debug", "gm_dir", "gm_dir_put", "gm_dirs", "gm_env_cmp", "gm_env_exit",
    "gm_env_var", "gm_err_errno", "gm_errdefer_runs", "gm_exact_digits", "gm_f16_from",
    "gm_fault_sp", "gm_fd_above_std", "gm_fiber", "gm_fiber_cont", "gm_fiber_entry",
    "gm_fiber_finish", "gm_fiber_new", "gm_fiber_pool", "gm_fiber_slab", "gm_fiber_slab_used",
    "gm_field", "gm_filc_ctx", "gm_filc_entry", "gm_filc_running", "gm_filc_starting",
    "gm_file_exists", "gm_find", "gm_find_outer", "gm_find_program", "gm_finish_main", "gm_flush",
    "gm_fmt_ch", "gm_fmt_fields", "gm_fmt_float", "gm_fmt_hex_escape", "gm_fmt_int", "gm_fmt_seq",
    "gm_fmt_str", "gm_format", "gm_format_spec", "gm_frame", "gm_frame_overflow",
    "gm_free_cstr_list", "gm_free_cstrs", "gm_fs_canonical", "gm_fs_close", "gm_fs_close_dir",
    "gm_fs_cwd", "gm_fs_lstat", "gm_fs_make_dir", "gm_fs_next_entry", "gm_fs_open",
