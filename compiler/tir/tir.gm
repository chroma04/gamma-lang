//! The typed intermediate representation (TIR) that checking produces from function
//! bodies (mirrors `src/tir.rs`).
//!
//! Every expression has its final type once a body is checked; names are resolved to
//! locals, functions and constants; implicit coercions (§6.4) are explicit `Coerce`
//! nodes; operators are resolved to typed operations. Children are pointers into the
//! compilation's arena, and the checker rewrites them in place when it finishes a body.

ast :: import "../ast"
bigint :: import "../bigint"
ratio :: import "../ratio"
source :: import "../source"
types :: import "../types"

Ty :: types.Ty

pub Expr :: struct {
    pub ty: Ty
    pub kind: ExprKind
    pub span: source.Span
}

pub ExprKind :: union {
    // Constants.
    /// An integer constant of integer type `ty`.
    Int: bigint.Int
    /// A float constant of float type `ty`, already rounded to that type.
    Float: f64
    /// A float literal whose type is still being inferred (or a type parameter).
    UntypedFloat: ratio.Rat
    Bool: bool
    Str: []const u8
    CStr: []const u8
    Null
    Uninit
    /// A compile-time value parameter of a generic function, by its id (§16.5).
    ValueParam: u32
    /// A constant in static memory: a typed top-level constant, or a default value
    /// (`<default>`), by its name and place.
    Const: (name: string, span: source.Span)

    // Places.
    Local: u32
    Upvar: (levels: u32, local: u32)
    Deref: ^Expr
    /// A struct field or tuple element, by index.
    Field: (base: ^Expr, index: u32)
    Index: (base: ^Expr, index: ^Expr, checked: bool)
    /// `base[lo..hi]`, `base[lo..=hi]` and the open-ended forms.
    Slice: SliceExpr
    SliceLen: ^Expr
    SlicePtr: ^Expr

    // Values.
    AddrOf: ^Expr
    AddrOfTemp: ^Expr
    /// A named function as a value, by its index.
    FnRef: u32
    /// A function literal that uses locals of the enclosing function: a second-class
    /// function value (§11.6).
    Closure: u32
    /// A handler literal, by its index (§12.5).
    HandlerRef: u32
    Unary: (op: UnOp, operand: ^Expr)
    Binary: (op: BinOp, lhs: ^Expr, rhs: ^Expr)
    Logic: (is_and: bool, lhs: ^Expr, rhs: ^Expr)
    Coerce: (kind: Coercion, expr: ^Expr)
    Builtin: (op: Builtin, args: []Expr)
    Call: (callee: Callee, args: []Expr)
    /// A tuple or struct value: its fields in order.
    Aggregate: []Expr
    Array: []Expr
    ArrayFill: ^Expr
    Variant: VariantExpr
    MakeErr: ^Expr
    Unwrap: (expr: ^Expr, is_result: bool)
    /// `x else d` and `x else e => d` (§10.4).
    Else: ElseExpr
    /// `try x` (§10.5).
    Try: TryExpr
    Eq: (lhs: ^Expr, rhs: ^Expr, negated: bool)
    Match: (scrutinee: ^Expr, arms: []Arm)
    /// `elem in container` over an array, slice or tuple, compared with `is` (§7.7).
    In: (elem: ^Expr, container: ^Expr, negated: bool)

    // Control flow.
    Block: ^Block
    If: IfExpr
    Loop: LoopExpr
    Break: BreakExpr
    Continue: Target
    Return: (levels: u32, value: ^Expr)
    Trap: ^Expr
    /// Formatted output (`print`): the template's literal pieces, a spec per placeholder
    /// and the values.
    Write: WriteExpr
    With: WithExpr
}

pub VariantExpr :: struct {
    pub variant: u32
    pub payload: ?^Expr
}

pub ElseExpr :: struct {
    pub lhs: ^Expr
    /// The local that `else e =>` binds the error to.
    pub capture: ?u32
    pub rhs: ^Expr
}

pub TryExpr :: struct {
    pub expr: ^Expr
    /// The variant of the function's error union that carries the error, if it is lifted
    /// (§10.6).
    pub lift: ?u32
    pub levels: u32
}

pub SliceExpr :: struct {
    pub base: ^Expr
    pub lo: ?^Expr
    pub hi: ?^Expr
    pub inclusive: bool
}

pub IfExpr :: struct {
    pub cond: []CondPart
    pub then: ^Expr
    pub else_: ?^Expr
}

pub LoopExpr :: struct {
    pub label: u32
    pub cond: []CondPart
    pub body: ^Block
    pub step: ?^Expr
}

pub BreakExpr :: struct {
    pub target: Target
    pub value: ?^Expr
}

pub WriteExpr :: struct {
    pub sink: WriteSink
    pub pieces: []const []const u8
    pub specs: []const FmtSpec
    pub args: []Expr
}

/// Where a write goes: an operation taking `[]const u8` (`Out.write` for `print`).
pub WriteSink :: union {
    Perform: (effect_: types.EffectRef, op: u32)
}

/// The target of a `break` or `continue`.
pub Target :: union {
    /// A loop or `with` of the function `levels` frames up (0: the current one).
    Label: (levels: u32, label: u32)
    /// The `with` that installed the handler whose clause is running (§12.7.1).
    InstallingWith
}

/// `[label:] with h1, h2, … { body }` (§12.7).
pub WithExpr :: struct {
    pub label: u32
    pub handlers: []HandlerValue
    pub on: ?^Expr
    pub body: ^Expr
}

/// A handler a `with` installs.
pub HandlerValue :: union {
    /// A handler literal (a `HandlerRef`).
    Literal: ^Expr
    /// A value whose type has handler declarations: their indices, and the value.
    Decl: (decls: []u32, value: ^Expr)
}

/// A handler literal: its effect and, per operation, the function of its clause.
pub HandlerLit :: struct {
    pub effect_: types.EffectRef
    pub clauses: []u32
}

pub Block :: struct {
    pub stmts: []Stmt
    /// The value of the block; `null` means `()` (or `never` if the last statement
    /// diverges).
    pub tail: ?^Expr
    pub span: source.Span
}

pub Stmt :: union {
    Let: (local: u32, init: ?^Expr)
    Assign: (place: ^Expr, value: ^Expr)
    Expr: ^Expr
    /// `defer` or (`is_err`) `errdefer` (§8.8).
    Defer: (is_err: bool, body: ^Expr)
}

pub CondPart :: union {
    Bool: ^Expr
    /// `pattern := value` (§8.2).
    Match: (pat: ^Pat, value: ^Expr)
}

/// An arm of a `match`: its pattern, its guard and its body.
pub Arm :: struct {
    pub pat: ^Pat
    pub guard: ?^Expr
    pub body: ^Expr
}

/// A checked pattern (§9) and the type of the value it matches.
pub Pat :: struct {
    pub ty: Ty
    pub kind: PatKind
    pub span: source.Span
}

pub PatKind :: union {
    Wild
    /// Binds the matched value to a local (a copy).
    Bind: u32
    /// Matches a value `is`-equal to the constant (integers, bools, strings).
    Const: ^Expr
    Range: (lo: bigint.Int, hi: bigint.Int, inclusive: bool)
    /// The absent optional.
    Null
    /// A present optional whose value matches.
    Some: ^Pat
    /// A successful result whose value matches.
    Ok: ^Pat
    /// A failed result whose error matches.
    Err: ^Pat
    /// A union value of the given variant, and the pattern of its payload if any.
    Variant: (variant: u32, payload: ?^Pat)
    /// Struct fields or tuple elements by index; unlisted ones are ignored.
    Fields: []FieldPat
    /// Alternatives `p1, p2` of a match arm, tried in order; all bind the same locals.
    Or: []^Pat
}

pub FieldPat :: struct {
    pub index: u32
    pub pat: ^Pat
}

/// A new pattern in the arena.
pub mk_pat :: fn(ty: Ty, kind: PatKind, span: source.Span) -> ^Pat needs Alloc => new(Pat(ty: ty, kind: kind, span: span))!

pub Callee :: union {
    /// A direct call to a known function, by its index.
    Fn: u32
    /// Performing operation `op` of an effect.
    Perform: (effect_: types.EffectRef, op: u32)
    /// A call of a function value: a function pointer or a second-class function.
    Indirect: ^Expr
}

pub UnOp :: union { Neg, BitNot, Not }

pub BinOp :: union {
    Add: ast.Flavor
    Sub: ast.Flavor
    Mul: ast.Flavor
    Shl: ast.Flavor
    Div
    Rem
    Shr
    BitAnd
    BitOr
    BitXor
    Lt
    Le
    Gt
    Ge
}

/// Implicit coercions (§6.4), made explicit.
pub Coercion :: union {
    IntWiden
    FloatWiden
    WrapOptional
    WrapOk
    LiftErr: u32
    FromNever
    PtrToPtr
    ArrayPtrToSlice
    TupleRename
    FnToPtr
    FnPtrWiden
    InOptional
    /// From an unresolved literal type, decided once inference is done.
    Unresolved
}

/// Explicit conversions and builtin operations.
pub Builtin :: union {
    /// `T(x)`: a lossless conversion (§6.5).
    Convert
    /// `x.trunc(T)`, `.round`, `.floor`, `.ceil`, `.checked` and `.sat` (§6.6).
    Trunc
    Round
    Floor
    Ceil
    Checked
    Sat
    /// `x.bits(T)`: reinterpret bytes.
    Bits
    /// `p.cast(P)`.
    Cast
    /// `p.addr()`.
    Addr
    /// `n.to_ptr(P)`.
    ToPtr
    /// `u.tag()` and `U.from_tag(x)`.
    Tag
    FromTag
    Min
    Max
    Clamp
    Abs
    AbsDiff
    Pow: ast.Flavor
    IsNan
    IsInf
    IsFinite
    SignBit
    Sqrt
    /// The intrinsics `@fma`, `@clz`, `@ctz`, `@popcount`, `@bswap`, `@rotl`, `@rotr`,
    /// `@bitreverse` and `@black_box` (§20.3).
    Fma
    Clz
    Ctz
    Popcount
    Bswap
    Rotl
    Rotr
    Bitreverse
    BlackBox
    /// The methods of arrays and slices that return an element or a pointer to one.
    Get
    GetPtr
    First
    Last
    /// `p.cstr_len()`.
    CstrLen
    Assert
}

/// A placeholder of a format template (§21.6.1).
pub FmtSpec :: struct {
    pub fill: u8
    pub align: FmtAlign
    pub plus: bool
    pub alt: bool
    pub zero: bool
    pub width: u32
    pub precision: ?u32
    pub kind: FmtKind
}

pub FmtAlign :: union { Auto, Left, Right, Center }

pub FmtKind :: union { Display, Hex, HexUpper, Oct, Bin, Exp }

pub default_spec :: fn() -> FmtSpec => FmtSpec(fill: ' ', align: .Auto, plus: false, alt: false, zero: false, width: 0, precision: null, kind: .Display)

pub is_default_spec :: fn(s: ^const FmtSpec) -> bool {
    return s.fill is ' ' and s.align is .Auto and not s.plus and not s.alt and not s.zero and s.width is 0 and s.precision is null and s.kind is .Display
}

/// A local variable or parameter of a function.
pub LocalDecl :: struct {
    pub name: string
    pub ty: Ty
    pub mutable: bool
    pub span: source.Span
}

pub FnKind :: union { Named, Literal, Clause, Foreign }

/// The checked form of a function: its parameters (also locals), locals and body.
pub FnDef :: struct {
    pub kind: FnKind
    pub params: []u32
    pub locals: []LocalDecl
    pub body: ?^Expr
    /// For a nested function that uses locals of the enclosing one: that function.
    pub parent: ?u32 = null
}

// ---------------------------------------------------------------------------------
// Construction and traversal
// ---------------------------------------------------------------------------------

/// A new expression in the arena.
pub mk :: fn(ty: Ty, kind: ExprKind, span: source.Span) -> ^Expr needs Alloc => new(Expr(ty: ty, kind: kind, span: span))!

/// Calls `f` on each direct sub-expression, including those inside statements and
/// conditions.
pub for_each_child :: fn(e: ^Expr, f: fn(c: ^Expr)) {
    match e.kind {
        .Deref(a), .AddrOf(a), .AddrOfTemp(a), .MakeErr(a), .ArrayFill(a), .Trap(a), .SliceLen(a), .SlicePtr(a) => f(a)
        .Slice(sl) => {
            f(sl.base)
            if x := sl.lo { f(x) }
            if x := sl.hi { f(x) }
        }
        .Unary(_, a) => f(a)
        .Coerce(_, a) => f(a)
        .Unwrap(a, _) => f(a)
        .Else(x) => {
            f(x.lhs)
            f(x.rhs)
        }
        .Try(x) => f(x.expr)
        .Field(a, _) => f(a)
        .Return(_, a) => f(a)
        .Index(a, b, _) => {
            f(a)
            f(b)
        }
        .Binary(_, a, b), .Logic(_, a, b) => {
            f(a)
            f(b)
        }
        .Eq(a, b, _), .In(a, b, _) => {
            f(a)
            f(b)
        }
        .Match(s, arms) => {
            f(s)
            for a in arms {
                pat_children(a.pat, f)
                if g := a.guard { f(g) }
                f(a.body)
            }
        }
        .With(w) => {
            for h in w.handlers {
                match h {
                    .Literal(x) => f(x)
                    .Decl(_, x) => f(x)
                }
            }
            if x := w.on { f(x) }
            f(w.body)
        }
        .Builtin(_, args) => for i in 0..args.len { f(&args[i]) }
        .Call(callee, args) => {
            if .Indirect(c) := callee { f(c) }
            for i in 0..args.len { f(&args[i]) }
        }
        .Aggregate(xs), .Array(xs) => for i in 0..xs.len { f(&xs[i]) }
        .Variant(v) => if p := v.payload { f(p) }
        .Block(b) => block_children(b, f)
        .If(x) => {
            conds_children(x.cond, f)
            f(x.then)
            if e2 := x.else_ { f(e2) }
        }
        .Loop(x) => {
            conds_children(x.cond, f)
            block_children(x.body, f)
            if st := x.step { f(st) }
        }
        .Break(x) => if v := x.value { f(v) }
        .Write(w) => for i in 0..w.args.len { f(&w.args[i]) }
        _ => {}
    }
}

block_children :: fn(b: ^Block, f: fn(c: ^Expr)) {
    for s in b.stmts {
        match s {
            .Let(_, null) => {}
            .Let(_, x) => f(x)
            .Assign(p, v) => {
                f(p)
                f(v)
            }
            .Expr(x), .Defer(_, x) => f(x)
        }
    }
    if t := b.tail { f(t) }
}

conds_children :: fn(cond: []CondPart, f: fn(c: ^Expr)) {
    for c in cond {
        match c {
            .Bool(x) => f(x)
            .Match(p, v) => {
                pat_children(p, f)
                f(v)
            }
        }
    }
}

/// Calls `f` on the constant expressions inside pattern `p`.
pat_children :: fn(p: ^Pat, f: fn(c: ^Expr)) {
    match p.kind {
        .Const(e) => f(e)
        .Some(q), .Ok(q), .Err(q) => pat_children(q, f)
        .Variant(_, q) => pat_children(q, f)
        .Fields(fs) => for x in fs { pat_children(x.pat, f) }
        .Or(ps) => for q in ps { pat_children(q, f) }
        _ => {}
    }
}
