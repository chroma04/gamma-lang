//! The language server behind `gammac lsp`: the Language Server Protocol over standard
//! input and output.
//!
//! The server is single-threaded apart from a thread that reads messages. Each open
//! document is kept as text, and the directory (module) that contains it is checked with
//! the open documents standing in for the files on disk; see `docs/architecture.md`.

/// The version the server reports to its client.
VERSION :: "0.1.0"

/// Serves LSP on standard input and output until the client says `exit` or closes the
/// input. Returns the process exit code: 0 after `shutdown`, 1 otherwise.
pub command :: fn() -> u8 needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    box := new(inbox())!
    _ = thread.spawn(reader, box) else {
        eprint("gammac: cannot start the reader thread\n")
        return 1
    }
    srv := server()
    return srv.run(box)
}

thread :: import "std/thread"
