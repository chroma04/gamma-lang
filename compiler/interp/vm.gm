// The register machine that runs function bodies.
//
// A body's statement structure (blocks without deferred statements, `if`, loops of unit
// type, `match`, `return`, `break` and `continue`), its expressions on words (integers,
// floats, booleans and pointers of at most 8 bytes: locals, constants, operators) and its
// calls whose arguments are words are compiled into a flat list of instructions on word
// registers, which `vm_run` executes in one loop. Everything else is left to the tree
// evaluator (`run.gm`), which an instruction invokes on a whole subtree: the machine
// covers the common paths and the tree all the language, so they always agree.
//
// The registers, and the byte slots that hold the values of `match` scrutinees and of
// pattern conditions, live in the frame's storage after its locals. Registers are
// allocated as a stack while compiling: each expression leaves its value in the first
// free register, so a function needs as many as its expressions nest.
//
// A `break` or `continue` that a subtree raises (as a `Flow`) to a loop of the machine
// jumps to it; every other flow leaves the body, as the tree's would. The `defer` and
// `errdefer` statements that run push their bodies on the frame's stack of deferred
// statements (`Frame.defers`); leaving a block runs those it pushed, last first: at its
// end, at a `break` or `continue` out of it, and when the function returns or a flow
// leaves the body (errdefers then run as the tree's blocks would run them, §8.8).

/// A compiled body.
Code :: struct {
    ins: []Ins
    /// The frame's storage seen as words is the register file: the locals that are words
    /// (`vc_local_reg`) are registers, and so are the words from `regs_off` on, after the
    /// byte slots, which start at `slots_off`. `size` is the storage's whole size.
    slots_off: u64
    regs_off: u64
    nregs: u64
    size: u64
    /// The loops: their labels and where their `break`s and `continue`s go.
    loops: []VmLoop
}

VmLoop :: struct {
    label: u32
    /// Where a `break` and a `continue` go.
    brk: u32
    cont: u32
    /// The registers holding the mark taken at the start of each iteration.
    mark: u32
    /// How many loops enclose it (the length of `Frame.labels` inside it).
    depth: u32
    /// The register holding the height of the frame's deferred statements at its entry.
    defers: u32
    /// How many blocks with deferred statements enclose it.
    dblocks: u32
}

Ins :: union {
    Const: (r: u32, v: u64)
    /// A word local of this frame.
    Local: (r: u32, local: u32, off: u32, size: u32)
    SetLocal: (local: u32, off: u32, size: u32, r: u32, n: ^Node)
    /// A word at offset `rel` of a local (a field), at `at` in the frame's storage while
    /// the local is kept there.
    LocalAt: (r: u32, local: u32, at: u32, rel: u32, size: u32, align: u32, n: ^Node)
    SetLocalAt: (local: u32, at: u32, rel: u32, size: u32, align: u32, v: u32, n: ^Node)
    /// The same for a local of the frame `levels` capture links up (an upvar).
    UpvarAt: (r: u32, levels: u32, local: u32, rel: u32, size: u32, align: u32, n: ^Node)
    /// `LocalAt` and `SetLocalAt` at a further offset in register `d` (an array element).
    LocalAtD: (r: u32, local: u32, at: u32, rel: u32, d: u32, size: u32, align: u32, n: ^Node)
    SetLocalAtD: (local: u32, at: u32, rel: u32, d: u32, size: u32, align: u32, v: u32, n: ^Node)
    /// Checks the index in a register against an array's length and scales it to a byte
    /// offset; `AddR` adds a register to another.
    ScaleIdx: (i: u32, len: u64, esz: u64, n: ^Node)
    AddR: (r: u32, a: u32)
    /// `&`, `|` and `~` (`op` 0, 1, 2) on words; `>>` on integers whose shift amount is in
    /// range (else the general operator decides).
    Bit: (op: u8, r: u32, a: u32, b: u32)
    Shr: (t: IntW, shift: IntW, r: u32, a: u32, b: u32, n: ^Node)
    SetUpvarAt: (levels: u32, local: u32, rel: u32, size: u32, align: u32, v: u32, n: ^Node)
    /// A word at the address in register `base` plus `off`.
    Load: (r: u32, base: u32, off: u32, size: u32, align: u32, n: ^Node)
    Store: (base: u32, off: u32, size: u32, align: u32, v: u32, n: ^Node)
    /// The address of element `i` (in a register) of the slice whose pointer and length
    /// are in registers `p` and `len`, into `p`; traps if `i` is out of bounds. With
    /// `ArrIdx`, of an array of `len` elements at the address in `p`.
    SliceIdx: (p: u32, len: u32, i: u32, esz: u64, n: ^Node)
    ArrIdx: (p: u32, i: u32, len: u64, esz: u64, n: ^Node)
    /// The address of element `i` of the many-pointer in `p`, into `p`.
    PtrIdx: (p: u32, i: u32, esz: u64)
    /// Adds a constant to a register (an address).
    AddK: (r: u32, k: u64)
    IntOp: (op: tir.BinOp, t: IntW, shift: IntW, r: u32, a: u32, b: u32, n: ^Node)
    /// `+`, `-` or `*` (`op` 0, 1, 2) on integers of 64 bits, or (`Arith32`) of at most 32,
    /// checked or (`wrap`) wrapping: the common operators without `int_word`'s generality.
    Arith64: (op: u8, signed: bool, wrap: bool, r: u32, a: u32, b: u32, n: ^Node)
    Arith32: (op: u8, signed: bool, wrap: bool, bits: u32, r: u32, a: u32, b: u32, n: ^Node)
    /// Jumps to `to` unless the comparison (or `is`) of two registers holds.
    JCmp: (op: tir.BinOp, how: WordCmp, a: u32, b: u32, to: u32)
    JEq: (how: WordCmp, negated: bool, a: u32, b: u32, to: u32)
    Cmp: (op: tir.BinOp, how: WordCmp, r: u32, a: u32, b: u32)
    EqW: (how: WordCmp, negated: bool, r: u32, a: u32, b: u32)
    Not: (r: u32, a: u32)
    /// A boolean of a word: 1 if it is nonzero.
    Bool: u32
    IntUn: (op: tir.UnOp, t: IntW, r: u32, a: u32, n: ^Node)
    IntConv: (op: tir.Builtin, from: IntW, to: IntW, r: u32, a: u32)
    FloatOp: (op: tir.BinOp, wide: bool, r: u32, a: u32, b: u32)
    Jmp: u32
    /// Jumps if the register is zero, or (`Jnz`) not.
    Jz: (r: u32, to: u32)
    Jnz: (r: u32, to: u32)
    /// A call of function `f` with arguments in registers and slots.
    Call: (f: u32, args: []Arg, dst: Dest, node: ^Node)
    /// A call of the function value in the slot at `at` (the value of `callee`).
    CallValue: (at: u32, callee: ^Node, args: []Arg, dst: Dest, node: ^Node)
    /// Performs the operation of `node` (a `Perform`) with arguments in registers and slots.
    Perform: (args: []Arg, dst: Dest, node: ^Node)
    /// Copies a slot's bytes to a local of this frame.
    SetLocalSlot: (local: u32, at: u32, size: u32, span: source.Span)
    /// Copies `size` bytes between slots, reads a word of a slot into a register, or writes
    /// one to a slot.
    CopySlot: (dst: u32, src: u32, size: u32)
    SlotW: (r: u32, at: u32, size: u32)
    WSlot: (at: u32, size: u32, r: u32)
    /// Jumps if the word of `size` bytes in the slot at `at` is zero (or, with `nonzero`,
    /// is not): the test of an optional's or a result's flag.
    JSlot: (at: u32, size: u32, nonzero: bool, to: u32)
    /// Jumps unless the word of `size` bytes in the slot at `at` is `v`: the test of a
    /// variant's tag.
    JTag: (at: u32, size: u32, v: u64, to: u32)
    /// The tree evaluator: a word into a register, a value into a slot, or for effects.
    EvalW: (r: u32, n: ^Node)
    EvalSlot: (off: u32, n: ^Node)
    Discard: ^Node
    /// A statement, run by the tree evaluator.
    Stmt: St
    /// Copies a register.
    Mov: (r: u32, a: u32)
    /// Records the height of the frame's deferred statements in a register.
    DeferHeight: u32
    /// A `defer` (or `errdefer`) statement: pushes its body.
    Defer: (is_err: bool, body: ^Node)
    /// Runs the plain deferred statements pushed since the height in a register was taken,
    /// last first, and drops the others.
    Unwind: u32
    /// A word assignment to a place, by the tree evaluator.
    AssignW: (place: ^Node, value: ^Node)
    /// Matches the value in a slot against a pattern, binding its locals; jumps if it fails.
    Pat: (pat: ^Pat, off: u32, size: u32, fail: u32)
    /// No arm of a `match` matched.
    NoArm: ^Node
    /// The function returns the word in a register, a value the tree evaluates into its
    /// result, or nothing.
    RetW: u32
    RetEval: ^Node
    Ret
    /// Takes the scratch mark into registers `r..r + 3`, or releases scratch memory and
    /// temporaries to it.
    Mark: u32
    Release: u32
    /// Enters a loop (its `break` destination) and leaves loops down to `depth`.
    PushLabel: u32
    PopLabels: u32
    /// Lets other threads run.
    Tick
}

/// An argument of a call: a word in a register, or the bytes in a slot.
Arg :: union {
    Reg: u32
    Slot: (at: u32, size: u32)
}

/// Where the result of a call goes: nowhere, a register, a slot, or the function's result.
Dest :: union {
    None
    Reg: u32
    Slot: u32
    Ret
}

// ---------------------------------------------------------------------------------
// Compiling
// ---------------------------------------------------------------------------------

/// What a compiled expression does with its value.
Want :: union {
    /// Leaves it in the first free register.
    Reg
    Discard
    /// Returns it from the function.
    Ret
}

Vc :: struct {
    m: ^Machine
    info: ^FnInfo
    ins: List(Ins)
    loops: List(VmLoop)
    /// The loops being compiled, innermost last (indices into `loops`).
    open: List(u32)
    /// How many blocks with deferred statements are open.
    dblocks: u32
    /// Jumps to patch to each open loop's exit, by loop.
    exits: List((ins: u32, loop: u32))
    /// Jumps to patch to each open loop's `continue` point, by loop.
    conts: List((ins: u32, loop: u32))
    /// The first free register and the most registers used (register numbers start at
    /// `rbase`, the first word after the slots, which start at offset `sbase`).
    top: u32
    max: u32
    rbase: u32
    sbase: u64
    slot_top: u64
    slot_max: u64
    /// The furthest instruction a jump goes to: an instruction emitted before it may not be
    /// changed to leave its value elsewhere (`vc_retarget`).
    joined: u32
}

/// Compiles the lowered body `body` of the function `info` describes.
vm_compile :: fn(m: ^Machine, info: ^FnInfo, body: ^Node) -> ^Code needs Alloc {
    sbase := (info.store_size + 7) / 8 * 8
    // The registers follow the slots, whose size compiling tells: a body with slots is
    // compiled again once it is known.
    slots: u64 = 0
    while true {
        rbase := ((sbase + slots) / 8).trunc(u32)
        c := Vc(m: m, info: info, ins: list(Ins), loops: list(VmLoop), open: list(u32), dblocks: 0, exits: list((ins: u32, loop: u32)), conts: list((ins: u32, loop: u32)), top: rbase, max: rbase, rbase: rbase, sbase: sbase, slot_top: 0, slot_max: 0, joined: 0)
        c.vc_expr(body, .Ret)
        // A body whose value falls off its end (`()`, or a `never` that the tree raised).
        c.vc_emit(.Ret)
        c.open.deinit()
        c.exits.deinit()
        c.conts.deinit()
        if c.slot_max > slots {
            slots = (c.slot_max + 7) / 8 * 8
            c.ins.deinit()
            c.loops.deinit()
            continue
        }
        regs_off := u64(rbase) * 8
        // At least one register past the locals.
        nregs := u64((c.max - rbase).max(1))
        return new(Code(ins: c.ins.items, slots_off: sbase, regs_off: regs_off, nregs: nregs, size: regs_off + 8 * nregs, loops: c.loops.items))!
    }
}

vc_emit :: fn(c: ^Vc, i: Ins) needs Alloc { c.ins.push(i)! }

/// Emits a jump (or another instruction with a target to patch); returns its index.
vc_jump :: fn(c: ^Vc, i: Ins) -> u32 needs Alloc {
    c.ins.push(i)!
    return (c.ins.items.len - 1).trunc(u32)
}

vc_here :: fn(c: ^const Vc) -> u32 => c.ins.items.len.trunc(u32)

/// Sets the target of the jump at `at` to `to`.
vc_patch :: fn(c: ^Vc, at: u32, to: u32) {
    if to > c.joined { c.joined = to }
    i := &c.ins.items[usize(at)]
    match i^ {
        .Jmp(_) => { i^ = .Jmp(to) }
        .Jz(r, _) => { i^ = .Jz(r, to) }
        .Jnz(r, _) => { i^ = .Jnz(r, to) }
        .Pat(x) => { i^ = .Pat(x.pat, x.off, x.size, to) }
        .JCmp(x) => { i^ = .JCmp(x.op, x.how, x.a, x.b, to) }
        .JEq(x) => { i^ = .JEq(x.how, x.negated, x.a, x.b, to) }
        .JSlot(x) => { i^ = .JSlot(x.at, x.size, x.nonzero, to) }
        .JTag(x) => { i^ = .JTag(x.at, x.size, x.v, to) }
        _ => {}
    }
}

/// Sets the first free register.
vc_set_top :: fn(c: ^Vc, top: u32) {
    c.top = top
    if c.top > c.max { c.max = c.top }
}

vc_alloc :: fn(c: ^Vc) -> u32 {
    r := c.top
    c.top += 1
    if c.top > c.max { c.max = c.top }
    return r
}

vc_alloc_slot :: fn(c: ^Vc, size: u64) -> u64 {
    off := c.slot_top
    c.slot_top += (size + 7) / 8 * 8
    if c.slot_top > c.slot_max { c.slot_max = c.slot_top }
    return off
}

/// A slot's offset in the frame's storage (known once the locals' size is).
vc_slot_at :: fn(c: ^const Vc, off: u64) -> u32 => (c.sbase + off).trunc(u32)

/// The register that is local `l`, if it is a word whose address is never taken and the
/// machine keeps such locals in registers (`make_info` gives each 8 bytes of its own).
vc_local_reg :: fn(c: ^const Vc, l: u32) -> ?u32 {
    i := usize(l)
    if not c.m.word_locals or c.info.addressed[i] { return null }
    n := c.info.sizes[i]
    if n is 0 or n > 8 { return null }
    return (c.info.offsets[i] / 8).trunc(u32)
}

/// The register holding the value of the word expression `n`: the register of a local, or
/// else the first free one, where `n` is computed. A local's register is read when the
/// instruction using it runs, so only an operand that no later operand can change may be
/// one (`late`: the operands computed after it only read).
vc_operand :: fn(c: ^Vc, n: ^Node, late: bool) -> u32 needs Alloc {
    if late and .Local(l, _) := n.op and n.size is c.info.sizes[usize(l)] {
        if r := c.vc_local_reg(l) { return r }
    }
    r := c.top
    c.vc_word(n)
    return r
}

/// Whether computing the word expression `n` writes nothing (no calls, assignments or
/// blocks): an operand before it may be read late (`vc_operand`).
vc_reads_only :: fn(c: ^const Vc, n: ^const Node) -> bool => match n.op {
    .Word(_), .Local(_), .Upvar(_) => true
    .IntOp(x) => c.vc_reads_only(x.l) and c.vc_reads_only(x.r)
    .Cmp(x) => c.vc_reads_only(x.l) and c.vc_reads_only(x.r)
    .EqW(x) => c.vc_reads_only(x.l) and c.vc_reads_only(x.r)
    .FloatOp(x) => c.vc_reads_only(x.l) and c.vc_reads_only(x.r)
    .Not(x) => c.vc_reads_only(x)
    .Logic(_, l, r) => c.vc_reads_only(l) and c.vc_reads_only(r)
    .IntUn(_, _, x) => c.vc_reads_only(x)
    .IntConv(_, _, _, x) => c.vc_reads_only(x)
    .Field(_), .Deref(_), .Index(_), .SliceLen(_), .SlicePtr(_) => c.vc_word_only(n)
    _ => false
}

/// Has the last instruction, which computed a value into register `t`, leave it in `d`
/// instead; false if it cannot (it is not one that computes a value into a register, or
/// a jump goes past it, so that it is not the only way the value was computed).
vc_retarget :: fn(c: ^Vc, t: u32, d: u32) -> bool {
    n := c.ins.items.len
    if n is 0 or usize(c.joined) >= n { return false }
    i := &c.ins.items[n - 1]
    nw: ?Ins = match i^ {
        .Const(r, v) => if r is t { Ins.Const(d, v) } else { null }
        .Mov(r, x) => if r is t { Ins.Mov(d, x) } else { null }
        .Arith64(x) => if x.r is t { Ins.Arith64(x.op, x.signed, x.wrap, d, x.a, x.b, x.n) } else { null }
        .Arith32(x) => if x.r is t { Ins.Arith32(x.op, x.signed, x.wrap, x.bits, d, x.a, x.b, x.n) } else { null }
        .IntOp(x) => if x.r is t { Ins.IntOp(x.op, x.t, x.shift, d, x.a, x.b, x.n) } else { null }
        .Bit(op, r, a, b) => if r is t { Ins.Bit(op, d, a, b) } else { null }
        .Shr(x) => if x.r is t { Ins.Shr(x.t, x.shift, d, x.a, x.b, x.n) } else { null }
        .Cmp(op, how, r, a, b) => if r is t { Ins.Cmp(op, how, d, a, b) } else { null }
        .EqW(x) => if x.r is t { Ins.EqW(x.how, x.negated, d, x.a, x.b) } else { null }
        .Not(r, a) => if r is t { Ins.Not(d, a) } else { null }
        .IntUn(x) => if x.r is t { Ins.IntUn(x.op, x.t, d, x.a, x.n) } else { null }
        .IntConv(x) => if x.r is t { Ins.IntConv(x.op, x.from, x.to, d, x.a) } else { null }
        .FloatOp(x) => if x.r is t { Ins.FloatOp(x.op, x.wide, d, x.a, x.b) } else { null }
        .LocalAt(x) => if x.r is t { Ins.LocalAt(d, x.local, x.at, x.rel, x.size, x.align, x.n) } else { null }
        .Load(x) => if x.r is t { Ins.Load(d, x.base, x.off, x.size, x.align, x.n) } else { null }
        .SlotW(r, at, size) => if r is t { Ins.SlotW(d, at, size) } else { null }
        .EvalW(r, e) => if r is t { Ins.EvalW(d, e) } else { null }
        .Call(x) => if .Reg(r) := x.dst and r is t { Ins.Call(x.f, x.args, .Reg(d), x.node) } else { null }
        .CallValue(x) => if .Reg(r) := x.dst and r is t { Ins.CallValue(x.at, x.callee, x.args, .Reg(d), x.node) } else { null }
        .Perform(x) => if .Reg(r) := x.dst and r is t { Ins.Perform(x.args, .Reg(d), x.node) } else { null }
        _ => null
    }
    ins := nw else return false
    i^ = ins
    return true
}

/// Leaves the value of the word expression `value` in register `d` (a local's).
vc_word_to :: fn(c: ^Vc, value: ^Node, d: u32) needs Alloc {
    save := c.top
    v := c.vc_operand(value, true)
    // Only a value computed here into a fresh register was computed by the last
    // instruction.
    if v is not d and not (v is save and c.vc_retarget(v, d)) { c.vc_emit(.Mov(d, v)) }
    c.top = save
}

/// The operator and flavor of `+`, `-` or `*`, checked or wrapping, for `Arith64` and
/// `Arith32`.
arith_kind :: fn(op: tir.BinOp) -> ?(op: u8, wrap: bool) => match op {
    .Add(fl) => if fl in (ast.Flavor.Checked, .Wrap) { (op: 0, wrap: fl is .Wrap) } else { null }
    .Sub(fl) => if fl in (ast.Flavor.Checked, .Wrap) { (op: 1, wrap: fl is .Wrap) } else { null }
    .Mul(fl) => if fl in (ast.Flavor.Checked, .Wrap) { (op: 2, wrap: fl is .Wrap) } else { null }
    _ => null
}

/// The operator `Arith64` or `Arith32` stands for.
arith_op :: fn(op: u8, wrap: bool) -> tir.BinOp {
    fl: ast.Flavor = if wrap { .Wrap } else { .Checked }
    return match op {
        0 => .Add(fl)
        1 => .Sub(fl)
        _ => .Mul(fl)
    }
}

/// Whether `n` is a value the machine computes in a register.
is_word :: fn(n: ^const Node) -> bool => n.size <= 8

/// Compiles `n`, doing with its value what `want` says. With `Reg`, the value ends in the
/// register that was the first free one, which stays allocated.
vc_expr :: fn(c: ^Vc, n: ^Node, want: Want) needs Alloc {
    match n.op {
        .Block(b) => {
            c.vc_block(b, want)
            return ()
        }
        .If(x) => {
            c.vc_if_(x.cond, x.then, x.else_, want)
            return ()
        }
        .Match(scrutinee, arms) => {
            c.vc_match_(n, scrutinee, arms, want)
            return ()
        }
        .Loop(x) => if n.size is 0 and want is not .Reg {
            c.vc_loop_(x.label, x.cond, x.body, x.step)
            if want is .Ret { c.vc_emit(.Ret) }
            return ()
        }
        .Return(levels, value) => if levels is 0 {
            c.vc_expr(value, .Ret)
            if want is .Reg { _ = c.vc_alloc() }
            return ()
        }
        .Break(target, ?value) => if value is null {
            if .Label(levels, label) := target and levels is 0 {
                if li := c.vc_find_loop(label) {
                    lp := c.loops.items[usize(li)]
                    if c.dblocks > lp.dblocks { c.vc_emit(.Unwind(lp.defers)) }
                    c.vc_emit(.PopLabels(lp.depth))
                    at := c.vc_jump(.Jmp(0))
                    c.exits.push((ins: at, loop: li))!
                    if want is .Reg { _ = c.vc_alloc() }
                    return ()
                }
            }
        }
        .Continue(target) => {
            if .Label(levels, label) := target and levels is 0 {
                if li := c.vc_find_loop(label) {
                    lp := c.loops.items[usize(li)]
                    if c.dblocks > lp.dblocks { c.vc_emit(.Unwind(lp.defers)) }
                    c.vc_emit(.PopLabels(lp.depth + 1))
                    at := c.vc_jump(.Jmp(0))
                    c.conts.push((ins: at, loop: li))!
                    if want is .Reg { _ = c.vc_alloc() }
                    return ()
                }
            }
        }
        .Call(f, args) => if want is not .Reg {
            c.vc_call(f, args, if want is .Ret { Dest.Ret } else { Dest.None }, n)
            if want is .Ret { c.vc_emit(.Ret) }
            return ()
        }
        .CallValue(callee, args) => if want is not .Reg {
            c.vc_call_value(callee, args, if want is .Ret { Dest.Ret } else { Dest.None }, n)
            if want is .Ret { c.vc_emit(.Ret) }
            return ()
        }
        .Perform(x) => if want is not .Reg {
            c.vc_perform(x.args, if want is .Ret { Dest.Ret } else { Dest.None }, n)
            if want is .Ret { c.vc_emit(.Ret) }
            return ()
        }
        _ => {}
    }
    match want {
        .Reg => {
            // A jump the machine does not compile (to another frame or a value-carrying
            // loop) goes to the tree like any construct with no value.
            if is_word(n) and not (n.op is .Return(_) or n.op is .Break(_) or n.op is .Continue(_)) {
                c.vc_word(n)
            } else {
                // Not a word: only a `never` or `()` value of a construct the machine does
                // not run comes here.
                c.vc_emit(.Discard(n))
                r := c.vc_alloc()
                c.vc_emit(.Const(r, 0))
            }
        }
        .Discard => {
            if is_word(n) and c.vc_compiles(n) {
                save := c.top
                c.vc_word(n)
                c.top = save
            } else {
                c.vc_emit(.Discard(n))
            }
        }
        .Ret => {
            if n.size is 0 {
                c.vc_expr(n, .Discard)
                c.vc_emit(.Ret)
            } else if is_word(n) {
                save := c.top
                c.vc_emit(.RetW(c.vc_operand(n, true)))
                c.top = save
            } else {
                c.vc_emit(.RetEval(n))
            }
        }
    }
}

/// Whether the machine runs `n` itself (else `word` hands it to the tree).
vc_compiles :: fn(c: ^const Vc, n: ^const Node) -> bool => match n.op {
    .Word(_), .Local(_), .IntOp(_), .Cmp(_), .EqW(_), .Not(_), .Logic(_), .IntUn(_), .IntConv(_), .FloatOp(_), .Call(_), .Perform(_) => true
    _ => false
}

/// Compiles the word expression `n` into the first free register.
vc_word :: fn(c: ^Vc, n: ^Node) needs Alloc {
    save := c.top
    match n.op {
        .Word(v) => c.vc_emit(.Const(c.vc_alloc(), v))
        .Local(l, off) => {
            if r := c.vc_local_reg(l) and n.size is c.info.sizes[usize(l)] {
                c.vc_emit(.Mov(c.vc_alloc(), r))
            } else {
                c.vc_emit(.Local(c.vc_alloc(), l, off.trunc(u32), n.size.trunc(u32)))
            }
        }
        .IntOp(x) => {
            a := c.vc_operand(x.l, c.vc_reads_only(x.r))
            b := c.vc_operand(x.r, true)
            c.top = save
            r := c.vc_alloc()
            if k := arith_kind(x.op) {
                if x.t.bits is 64 {
                    c.vc_emit(.Arith64(k.op, x.t.signed, k.wrap, r, a, b, n))
                } else {
                    c.vc_emit(.Arith32(k.op, x.t.signed, k.wrap, x.t.bits, r, a, b, n))
                }
            } else {
                match x.op {
                    .BitAnd => c.vc_emit(.Bit(0, r, a, b))
                    .BitOr => c.vc_emit(.Bit(1, r, a, b))
                    .BitXor => c.vc_emit(.Bit(2, r, a, b))
                    .Shr => c.vc_emit(.Shr(x.t, x.shift, r, a, b, n))
                    _ => c.vc_emit(.IntOp(x.op, x.t, x.shift, r, a, b, n))
                }
            }
        }
        .Cmp(x) => {
            a := c.vc_operand(x.l, c.vc_reads_only(x.r))
            b := c.vc_operand(x.r, true)
            c.top = save
            c.vc_emit(.Cmp(x.op, x.how, c.vc_alloc(), a, b))
        }
        .EqW(x) => {
            a := c.vc_operand(x.l, c.vc_reads_only(x.r))
            b := c.vc_operand(x.r, true)
            c.top = save
            c.vc_emit(.EqW(x.how, x.negated, c.vc_alloc(), a, b))
        }
        .Not(x) => {
            a := c.vc_operand(x, true)
            c.top = save
            c.vc_emit(.Not(c.vc_alloc(), a))
        }
        .Logic(is_and, l, r) => {
            c.vc_word(l)
            at := if is_and { c.vc_jump(.Jz(save, 0)) } else { c.vc_jump(.Jnz(save, 0)) }
            c.top = save
            c.vc_word(r)
            c.vc_patch(at, c.vc_here())
            c.vc_emit(.Bool(save))
        }
        .IntUn(op, t, x) => {
            a := c.vc_operand(x, true)
            c.top = save
            c.vc_emit(.IntUn(op, t, c.vc_alloc(), a, n))
        }
        .IntConv(op, from, to, x) => {
            a := c.vc_operand(x, true)
            c.top = save
            c.vc_emit(.IntConv(op, from, to, c.vc_alloc(), a))
        }
        .FloatOp(x) => {
            a := c.vc_operand(x.l, c.vc_reads_only(x.r))
            b := c.vc_operand(x.r, true)
            c.top = save
            c.vc_emit(.FloatOp(x.op, x.wide, c.vc_alloc(), a, b))
        }
        .Call(f, args) => c.vc_call(f, args, .Reg(save), n)
        .CallValue(callee, args) => c.vc_call_value(callee, args, .Reg(save), n)
        .Perform(x) => c.vc_perform(x.args, .Reg(save), n)
        .Else(lhs, ?capture, rhs) => {
            if c.vc_else_shape(n, lhs) is null {
                c.vc_emit(.EvalW(c.vc_alloc(), n))
            } else {
                c.vc_else(n, lhs, capture, rhs, null)
            }
        }
        .Block(b) => c.vc_block(b, .Reg)
        .If(x) => c.vc_if_(x.cond, x.then, x.else_, .Reg)
        .Match(scrutinee, arms) => c.vc_match_(n, scrutinee, arms, .Reg)
        .Return(_), .Break(_), .Continue(_) => c.vc_expr(n, .Reg)
        .Upvar(_), .Field(_), .Index(_), .Deref(_) => {
            if c.vc_placeable(n) is .No {
                c.vc_emit(.EvalW(c.vc_alloc(), n))
            } else {
                pl := c.vc_place(n)
                c.vc_load(save, pl, 0, n.size, c.vc_align(n), n)
            }
        }
        .SliceLen(x), .SlicePtr(x) => {
            if c.vc_placeable(x) is .No {
                c.vc_emit(.EvalW(c.vc_alloc(), n))
            } else {
                pl := c.vc_place(x)
                pb := c.m.ptr_bytes
                c.vc_load(save, pl, if n.op is .SliceLen(_) { pb } else { 0 }, pb, pb.trunc(u32), n)
            }
        }
        _ => c.vc_emit(.EvalW(c.vc_alloc(), n))
    }
    c.vc_set_top(save + 1)
}

/// Whether the machine finds a place itself: in a local (`Local`), in memory (`Mem`).
Placeable :: union { No, Local, Mem }

vc_placeable :: fn(c: ^const Vc, n: ^const Node) -> Placeable => match n.op {
    .Local(_), .Upvar(_) => .Local
    .Field(x) => c.vc_placeable(x.base)
    .Deref(_) => .Mem
    .Index(x) => if not is_word(x.index) { .No } else { match x.seq {
        .Slice => if c.vc_placeable(x.base) is .No { .No } else { .Mem }
        .ManyPtr, .PtrArray => .Mem
        .Array => match c.vc_placeable(x.base) {
            .Mem => .Mem
            .Local => if root_levels(x.base) is 0 { .Local } else { .No }
            .No => .No
        }
    } }
    _ => .No
}

/// How many capture links up the local is that the place `n` (`vc_placeable` gives
/// `Local`) is part of.
root_levels :: fn(n: ^const Node) -> u32 => match n.op {
    .Upvar(levels, _) => levels
    .Field(x) => root_levels(x.base)
    .Index(x) => root_levels(x.base)
    _ => 0
}

/// A place the machine computes: bytes at an offset of a local (of the frame `levels`
/// capture links up), or an address in a register plus an offset (`packed`: possibly
/// unaligned).
PlaceC :: union {
    /// `d`: a register holding a further offset (of array elements).
    Local: (levels: u32, local: u32, rel: u64, packed: bool, d: ?u32)
    Mem: (r: u32, off: u64, packed: bool)
}

/// Compiles the place `n` (`vc_placeable`); registers it needs are allocated.
vc_place :: fn(c: ^Vc, n: ^Node) -> PlaceC needs Alloc {
    match n.op {
        .Local(l, _) => return .Local(0, l, 0, false, null)
        .Upvar(levels, l) => return .Local(levels, l, 0, false, null)
        .Field(x) => match c.vc_place(x.base) {
            .Local(levels, l, rel, packed, ?d) => return .Local(levels, l, rel + x.off, packed or x.packed, d)
            .Mem(r, off, packed) => return .Mem(r, off + x.off, packed or x.packed)
        }
        .Deref(ptr, _) => {
            r := c.top
            c.vc_word(ptr)
            return .Mem(r, 0, false)
        }
        .Index(x) => {
            match x.seq {
                .Slice => {
                    base := c.vc_place(x.base)
                    rp := c.vc_alloc()
                    rl := c.vc_alloc()
                    pb := c.m.ptr_bytes
                    c.vc_load(rp, base, 0, pb, pb.trunc(u32), x.base)
                    c.vc_load(rl, base, pb, pb, pb.trunc(u32), x.base)
                    ri := c.vc_operand(x.index, true)
                    c.vc_emit(.SliceIdx(rp, rl, ri, x.esz, n))
                    return .Mem(rp, 0, false)
                }
                .ManyPtr, .PtrArray => {
                    rp := c.top
                    c.vc_word(x.base)
                    ri := c.vc_operand(x.index, true)
                    if x.seq is .ManyPtr { c.vc_emit(.PtrIdx(rp, ri, x.esz)) } else { c.vc_emit(.ArrIdx(rp, ri, x.len, x.esz, n)) }
                    return .Mem(rp, 0, false)
                }
                .Array => {
                    match c.vc_place(x.base) {
                        .Mem(rp, off, packed) => {
                            if off is not 0 { c.vc_emit(.AddK(rp, off)) }
                            ri := c.vc_operand(x.index, true)
                            c.vc_emit(.ArrIdx(rp, ri, x.len, x.esz, n))
                            return .Mem(rp, 0, packed)
                        }
                        .Local(levels, l, rel, packed, ?d) => {
                            ri := c.top
                            c.vc_word(x.index)
                            c.vc_emit(.ScaleIdx(ri, x.len, x.esz, n))
                            if dr := d {
                                c.vc_emit(.AddR(dr, ri))
                                return .Local(levels, l, rel, packed, dr)
                            }
                            return .Local(levels, l, rel, packed, ri)
                        }
                    }
                }
            }
        }
        _ => @unreachable()
    }
}

/// Loads the word of `size` bytes aligned to `align` at `extra` bytes into place `pl` into
/// register `r` (for node `n`).
vc_load :: fn(c: ^Vc, r: u32, pl: PlaceC, extra: u64, size: u64, align: u32, n: ^Node) needs Alloc {
    match pl {
        .Local(levels, l, rel, packed, ?d) => {
            al := if packed { 1 } else { align }
            if dr := d {
                c.vc_emit(.LocalAtD(r, l, (c.info.offsets[usize(l)] + rel + extra).trunc(u32), (rel + extra).trunc(u32), dr, size.trunc(u32), al, n))
                return ()
            }
            if levels > 0 {
                c.vc_emit(.UpvarAt(r, levels, l, (rel + extra).trunc(u32), size.trunc(u32), al, n))
                return ()
            }
            c.vc_emit(.LocalAt(r, l, (c.info.offsets[usize(l)] + rel + extra).trunc(u32), (rel + extra).trunc(u32), size.trunc(u32), al, n))
        }
        .Mem(base, off, packed) => c.vc_emit(.Load(r, base, (off + extra).trunc(u32), size.trunc(u32), if packed { 1 } else { align }, n))
    }
}

/// The alignment of the value of `n`.
vc_align :: fn(c: ^Vc, n: ^Node) -> u32 needs Alloc => c.m.align(n.ty).trunc(u32)

vc_block :: fn(c: ^Vc, b: ^Blk, want: Want) needs Alloc {
    if b.defers {
        c.vc_defer_block(b, want)
        return ()
    }
    for st in b.stmts { c.vc_stmt(st) }
    if t := b.tail {
        c.vc_expr(t, want)
        return ()
    }
    match want {
        .Reg => c.vc_emit(.Const(c.vc_alloc(), 0))
        .Discard => {}
        .Ret => c.vc_emit(.Ret)
    }
}

/// A block with deferred statements: they run when it ends, after its value is computed
/// (a return runs them all).
vc_defer_block :: fn(c: ^Vc, b: ^Blk, want: Want) needs Alloc {
    save := c.top
    res: u32 = 0
    if want is .Reg { res = c.vc_alloc() }
    h := c.vc_alloc()
    c.vc_emit(.DeferHeight(h))
    c.dblocks += 1
    for st in b.stmts { c.vc_stmt(st) }
    match want {
        .Ret => {
            if t := b.tail { c.vc_expr(t, .Ret) } else { c.vc_emit(.Ret) }
        }
        .Discard => {
            if t := b.tail { c.vc_expr(t, .Discard) }
            c.vc_emit(.Unwind(h))
        }
        .Reg => {
            v := c.top
            if t := b.tail { c.vc_expr(t, .Reg) } else { c.vc_emit(.Const(c.vc_alloc(), 0)) }
            c.vc_emit(.Mov(res, v))
            c.vc_emit(.Unwind(h))
        }
    }
    c.dblocks -= 1
    c.vc_set_top(if want is .Reg { save + 1 } else { save })
}

/// Whether running `st` may leave scratch memory or temporaries behind.
vc_uses_scratch :: fn(c: ^const Vc, st: St) -> bool => match st {
    .Expr(e) => not (is_word(e) and c.vc_word_only(e))
    .SetLocal(_, value) => not (is_word(value) and c.vc_word_only(value))
    .Let(_, _, size, ?init) => if x := init { not (size <= 8 and is_word(x) and c.vc_word_only(x)) } else { false }
    .Defer(_) => false
    _ => true
}

/// A call of `f` with `args`, its result going to `dst` (with `Reg`, the first free
/// register, which stays allocated).
vc_call :: fn(c: ^Vc, f: u32, args: []^Node, dst: Dest, n: ^Node) needs Alloc {
    save := c.top
    out := c.vc_args(args)
    c.vc_emit(.Call(f, out, dst, n))
    c.vc_set_top(if dst is .Reg(_) { save + 1 } else { save })
}

/// A call of the function value `callee`, evaluated first, then the arguments.
vc_call_value :: fn(c: ^Vc, callee: ^Node, args: []^Node, dst: Dest, n: ^Node) needs Alloc {
    save := c.top
    at := c.vc_slot_at(c.vc_alloc_slot(callee.size))
    c.vc_to_slot(callee, at)
    out := c.vc_args(args)
    c.vc_emit(.CallValue(at, callee, out, dst, n))
    c.vc_set_top(if dst is .Reg(_) { save + 1 } else { save })
}

/// Performs the operation `n` with `args`, its result going to `dst` (as `vc_call`).
vc_perform :: fn(c: ^Vc, args: []^Node, dst: Dest, n: ^Node) needs Alloc {
    save := c.top
    out := c.vc_args(args)
    c.vc_emit(.Perform(out, dst, n))
    c.vc_set_top(if dst is .Reg(_) { save + 1 } else { save })
}

/// Evaluates the arguments of a call in order: words into registers, which stay
/// allocated, and other values into slots.
vc_args :: fn(c: ^Vc, args: []^Node) -> []Arg needs Alloc {
    out := list(Arg)
    for i, x in enumerate(args) {
        if is_word(x) {
            // A local's register may be passed if the arguments after it only read.
            late := true
            for y in args[i + 1..args.len] {
                if not c.vc_reads_only(y) { late = false }
            }
            out.push(.Reg(c.vc_operand(x, late)))!
        } else {
            at := c.vc_slot_at(c.vc_alloc_slot(x.size))
            c.vc_to_slot(x, at)
            out.push(.Slot(at, x.size.trunc(u32)))!
        }
    }
    return out.items
}

/// Evaluates `n` into the slot at `at`.
vc_to_slot :: fn(c: ^Vc, n: ^Node, at: u32) needs Alloc {
    save := c.top
    match n.op {
        .Call(f, args) => {
            c.vc_call(f, args, .Slot(at), n)
            return ()
        }
        .CallValue(callee, args) => {
            c.vc_call_value(callee, args, .Slot(at), n)
            return ()
        }
        .Perform(x) => {
            c.vc_perform(x.args, .Slot(at), n)
            return ()
        }
        .Else(lhs, ?capture, rhs) => if c.vc_else_shape(n, lhs) is not null {
            c.vc_else(n, lhs, capture, rhs, at)
            return ()
        }
        .Block(b) => if not b.defers {
            for st in b.stmts { c.vc_stmt(st) }
            if t := b.tail { c.vc_to_slot(t, at) }
            return ()
        }
        _ => {}
    }
    if n.size is 0 {
        c.vc_expr(n, .Discard)
        return ()
    }
    if is_word(n) {
        c.vc_emit(.WSlot(at, n.size.trunc(u32), c.vc_operand(n, true)))
        c.vc_set_top(save)
        return ()
    }
    c.vc_emit(.EvalSlot(at, n))
}

/// Where an `else` the machine runs finds its left side's flag and payload: the flag's
/// offset and size and whether nonzero means absent (an error), and the payload's offset.
/// Only an `else` whose value is the payload (`x else d`).
vc_else_shape :: fn(c: ^Vc, n: ^const Node, lhs: ^const Node) -> ?(flag: u64, size: u64, nonzero: bool, payload: u64) needs Alloc {
    m := c.m
    match m.kind(lhs.ty) {
        .Optional(inner) => {
            if n.ty is not inner { return null }
            if cgen.nullable_pointer(m.s, inner) { return (flag: 0, size: m.ptr_bytes, nonzero: false, payload: 0) }
            offs := m.offsets(lhs.ty)
            return (flag: offs[1], size: 1, nonzero: false, payload: offs[0])
        }
        .Result(_, ok) => {
            if n.ty is not ok { return null }
            offs := m.offsets(lhs.ty)
            return (flag: offs[0], size: 1, nonzero: true, payload: offs[1])
        }
        _ => return null
    }
}

/// `lhs else rhs` (`vc_else_shape`), its value into the slot at `at`, or (`null`) into the
/// first free register.
vc_else :: fn(c: ^Vc, n: ^Node, lhs: ^Node, capture: ?u32, rhs: ^Node, at: ?u32) needs Alloc {
    shape := c.vc_else_shape(n, lhs) else return ()
    save := c.top
    la := c.vc_slot_at(c.vc_alloc_slot(lhs.size))
    c.vc_to_slot(lhs, la)
    fail := c.vc_jump(.JSlot(la + shape.flag.trunc(u32), shape.size.trunc(u32), shape.nonzero, 0))
    pa := la + shape.payload.trunc(u32)
    if d := at {
        c.vc_emit(.CopySlot(d, pa, n.size.trunc(u32)))
    } else {
        c.vc_emit(.SlotW(c.vc_alloc(), pa, n.size.trunc(u32)))
    }
    end := c.vc_jump(.Jmp(0))
    c.vc_patch(fail, c.vc_here())
    c.top = save
    if l := capture {
        if .Result(err, _) := c.m.kind(lhs.ty) { c.vc_emit(.SetLocalSlot(l, pa, c.m.size(err).trunc(u32), n.span)) }
    }
    if d := at { c.vc_to_slot(rhs, d) } else { c.vc_word(rhs) }
    c.vc_patch(end, c.vc_here())
    c.vc_set_top(if at is null { save + 1 } else { save })
}

/// Whether `n` compiles to instructions that use no scratch memory.
vc_word_only :: fn(c: ^const Vc, n: ^const Node) -> bool => match n.op {
    .Word(_), .Local(_), .Upvar(_) => true
    .IntOp(x) => c.vc_word_only(x.l) and c.vc_word_only(x.r)
    .Cmp(x) => c.vc_word_only(x.l) and c.vc_word_only(x.r)
    .EqW(x) => c.vc_word_only(x.l) and c.vc_word_only(x.r)
    .FloatOp(x) => c.vc_word_only(x.l) and c.vc_word_only(x.r)
    .Not(x) => c.vc_word_only(x)
    .Logic(_, l, r) => c.vc_word_only(l) and c.vc_word_only(r)
    .IntUn(_, _, x) => c.vc_word_only(x)
    .IntConv(_, _, _, x) => c.vc_word_only(x)
    .Call(_, args) => c.vc_all_word_only(args)
    .Perform(x) => c.vc_all_word_only(x.args)
    .Field(_), .Deref(_) => c.vc_placeable(n) is not .No and c.vc_place_word_only(n)
    .Index(x) => c.vc_placeable(n) is not .No and c.vc_place_word_only(n) and c.vc_word_only(x.index)
    .SliceLen(x), .SlicePtr(x) => c.vc_placeable(x) is not .No and c.vc_place_word_only(x)
    _ => false
}

vc_all_word_only :: fn(c: ^const Vc, ns: []^Node) -> bool {
    for x in ns {
        if not c.vc_word_only(x) { return false }
    }
    return true
}

/// Whether computing the place `n` (`vc_placeable`) uses no scratch memory.
vc_place_word_only :: fn(c: ^const Vc, n: ^const Node) -> bool => match n.op {
    .Local(_), .Upvar(_) => true
    .Field(x) => c.vc_place_word_only(x.base)
    .Deref(ptr, _) => c.vc_word_only(ptr)
    .Index(x) => match x.seq {
        .Slice, .Array => c.vc_place_word_only(x.base) and c.vc_word_only(x.index)
        _ => c.vc_word_only(x.base) and c.vc_word_only(x.index)
    }
    _ => false
}

vc_stmt :: fn(c: ^Vc, st: St) needs Alloc {
    save := c.top
    slots := c.slot_top
    mark := c.vc_uses_scratch(st)
    m_reg: u32 = 0
    if mark {
        m_reg = c.vc_alloc()
        _ = c.vc_alloc()
        _ = c.vc_alloc()
        c.vc_emit(.Mark(m_reg))
    }
    match st {
        .Expr(e) => c.vc_expr(e, .Discard)
        .SetLocal(l, value) => c.vc_set_local(l, value)
        .Let(l, off, size, ?init) => {
            if x := init and size <= 8 and is_word(x) and size is x.size {
                if r := c.vc_local_reg(l) {
                    c.vc_word_to(x, r)
                } else {
                    c.vc_word(x)
                    c.vc_emit(.SetLocal(l, off.trunc(u32), size.trunc(u32), c.top - 1, x))
                }
            } else if x := init and size is x.size and slot_worthy(x) {
                c.vc_call_to_local(l, x)
            } else {
                c.vc_emit(.Stmt(st))
            }
        }
        .Defer(is_err, body) => c.vc_emit(.Defer(is_err, body))
        .Assign(place, value) => {
            if is_word(value) and value.size is place.size and c.vc_placeable(place) is not .No {
                pl := c.vc_place(place)
                v := c.vc_operand(value, true)
                size := place.size.trunc(u32)
                match pl {
                    .Local(levels, l, rel, packed, ?d) => {
                        al := if packed { 1 } else { c.vc_align(place) }
                        if dr := d {
                            c.vc_emit(.SetLocalAtD(l, (c.info.offsets[usize(l)] + rel).trunc(u32), rel.trunc(u32), dr, size, al, v, place))
                        } else if levels > 0 {
                            c.vc_emit(.SetUpvarAt(levels, l, rel.trunc(u32), size, al, v, place))
                        } else {
                            c.vc_emit(.SetLocalAt(l, (c.info.offsets[usize(l)] + rel).trunc(u32), rel.trunc(u32), size, al, v, place))
                        }
                    }
                    .Mem(base, off, packed) => c.vc_emit(.Store(base, off.trunc(u32), size, if packed { 1 } else { c.vc_align(place) }, v, place))
                }
            } else if is_word(value) {
                c.vc_emit(.AssignW(place, value))
            } else {
                c.vc_emit(.Stmt(st))
            }
        }
        _ => c.vc_emit(.Stmt(st))
    }
    if mark { c.vc_emit(.Release(m_reg)) }
    c.top = save
    c.slot_top = slots
}

vc_set_local :: fn(c: ^Vc, l: u32, value: ^Node) needs Alloc {
    i := usize(l)
    size := c.info.sizes[i]
    if size <= 8 and value.size is size {
        if r := c.vc_local_reg(l) {
            c.vc_word_to(value, r)
            return ()
        }
        c.vc_word(value)
        c.vc_emit(.SetLocal(l, c.info.offsets[i].trunc(u32), size.trunc(u32), c.top - 1, value))
        return ()
    }
    if value.size is size and slot_worthy(value) {
        c.vc_call_to_local(l, value)
        return ()
    }
    c.vc_emit(.Stmt(.SetLocal(l, value)))
}

/// Whether the machine computes `n`, which is not a word, into a slot better than the tree
/// would compute it into a local: a call or an `else`.
slot_worthy :: fn(n: ^const Node) -> bool => match n.op {
    .Call(_), .CallValue(_), .Perform(_), .Else(_) => true
    _ => false
}

/// `l = value` for a local that is not a word (`slot_worthy`): the value goes through a slot.
vc_call_to_local :: fn(c: ^Vc, l: u32, value: ^Node) needs Alloc {
    at := c.vc_slot_at(c.vc_alloc_slot(value.size))
    c.vc_to_slot(value, at)
    c.vc_emit(.SetLocalSlot(l, at, value.size.trunc(u32), value.span))
}

/// Compiles the conditions `parts`; returns the jumps to patch to where they fail.
vc_conds :: fn(c: ^Vc, parts: []Cond) -> List(u32) needs Alloc {
    fails := list(u32)
    for p in parts {
        save := c.top
        match p {
            .Bool(e) => {
                match e.op {
                    .Cmp(x) => {
                        a := c.vc_operand(x.l, c.vc_reads_only(x.r))
                        b := c.vc_operand(x.r, true)
                        fails.push(c.vc_jump(.JCmp(x.op, x.how, a, b, 0)))!
                    }
                    .EqW(x) => {
                        a := c.vc_operand(x.l, c.vc_reads_only(x.r))
                        b := c.vc_operand(x.r, true)
                        fails.push(c.vc_jump(.JEq(x.how, x.negated, a, b, 0)))!
                    }
                    _ => fails.push(c.vc_jump(.Jz(c.vc_operand(e, true), 0)))!
                }
            }
            .Match(pat, value) => {
                at := c.vc_slot_at(c.vc_alloc_slot(value.size))
                c.vc_to_slot(value, at)
                c.vc_pat(pat, at, value.size, &fails)
            }
        }
        c.top = save
    }
    return fails
}

/// Tests the value of `size` bytes in the slot at `at` against `pat`, binding its locals;
/// adds the jumps to patch to where it fails to `fails`. The tree tests the patterns the
/// machine does not (`vc_pat_ok`).
vc_pat :: fn(c: ^Vc, pat: ^Pat, at: u32, size: u64, fails: ^List(u32)) needs Alloc {
    if not c.vc_pat_ok(pat) {
        fails.push(c.vc_jump(.Pat(pat, at, size.trunc(u32), 0)))!
        return ()
    }
    m := c.m
    match pat.kind {
        .Wild => {}
        .Bind(l) => c.vc_emit(.SetLocalSlot(l, at, size.trunc(u32), pat.span))
        .Const(e) => {
            save := c.top
            c.vc_word(e)
            r := c.vc_alloc()
            c.vc_emit(.SlotW(r, at, size.trunc(u32)))
            how: WordCmp = if m.kind(pat.ty) is .Bool { .Bool } else { .Unsigned }
            fails.push(c.vc_jump(.JEq(how, false, save, r, 0)))!
            c.top = save
        }
        .Null, .Some(_) => {
            shape := c.vc_opt_shape(pat.ty) else return ()
            fails.push(c.vc_jump(.JSlot(at + shape.flag.trunc(u32), shape.size.trunc(u32), pat.kind is .Null, 0)))!
            if .Some(p) := pat.kind { c.vc_pat(p, at + shape.payload.trunc(u32), m.size(p.ty), fails) }
        }
        .Ok(p), .Err(p) => {
            offs := m.offsets(pat.ty)
            fails.push(c.vc_jump(.JSlot(at + offs[0].trunc(u32), 1, pat.kind is .Ok(_), 0)))!
            c.vc_pat(p, at + offs[1].trunc(u32), m.size(p.ty), fails)
        }
        .Variant(x) => {
            fails.push(c.vc_jump(.JTag(at, x.tag_size.trunc(u32), x.tag_w, 0)))!
            if p := x.payload { c.vc_pat(p, at + x.off.trunc(u32), x.size, fails) }
        }
        .Fields(fields) => for f in fields {
            fl := m.field_layout(pat.ty, f.index)
            c.vc_pat(f.pat, at + fl.off.trunc(u32), m.size(fl.ty), fails)
        }
        .Range(_), .Or(_) => {}
    }
}

/// Whether the machine tests `pat` itself: bindings, constants that are integers or
/// booleans, optionals, results, variants with a tag of at most 8 bytes, and the fields
/// of structs and tuples that are not `#bits`.
vc_pat_ok :: fn(c: ^Vc, pat: ^const Pat) -> bool needs Alloc {
    m := c.m
    return match pat.kind {
        .Wild, .Bind(_) => true
        .Const(e) => e.ty is pat.ty and is_word(e) and (m.kind(pat.ty) is .Bool or int_w(m, pat.ty) is not null)
        .Null => c.vc_opt_shape(pat.ty) is not null
        .Some(p) => c.vc_opt_shape(pat.ty) is not null and c.vc_pat_ok(p)
        .Ok(p), .Err(p) => m.kind(pat.ty) is .Result(_, _) and c.vc_pat_ok(p)
        .Variant(x) => x.tag_size <= 8 and (if p := x.payload { c.vc_pat_ok(p) } else { true })
        .Fields(fields) => {
            if m.bits_struct_ty(pat.ty) is not null { return false }
            plain := match m.kind(pat.ty) {
                .Tuple(_, _) => true
                .Adt(id, _) => m.s.adts.items[us(id)].kind is .Struct(_)
                _ => false
            }
            if not plain { return false }
            for f in fields {
                if not c.vc_pat_ok(f.pat) { return false }
            }
            true
        }
        .Range(_), .Or(_) => false
    }
}

/// Where an optional of type `t` keeps its flag (nonzero: present) and its payload.
vc_opt_shape :: fn(c: ^Vc, t: Ty) -> ?(flag: u64, size: u64, payload: u64) needs Alloc {
    m := c.m
    inner := match m.kind(t) {
        .Optional(x) => x
        _ => return null
    }
    if cgen.nullable_pointer(m.s, inner) { return (flag: 0, size: m.ptr_bytes, payload: 0) }
    offs := m.offsets(t)
    return (flag: offs[1], size: 1, payload: offs[0])
}

vc_if_ :: fn(c: ^Vc, cond: []Cond, then: ^Node, else_: ?^Node, want: Want) needs Alloc {
    save := c.top
    slots := c.slot_top
    fails := c.vc_conds(cond)
    c.vc_expr(then, want)
    c.top = save
    end: ?u32 = null
    if want is not .Ret { end = c.vc_jump(.Jmp(0)) }
    for f in fails.items { c.vc_patch(f, c.vc_here()) }
    fails.deinit()
    c.slot_top = slots
    if el := else_ {
        c.vc_expr(el, want)
    } else {
        match want {
            .Reg => c.vc_emit(.Const(c.vc_alloc(), 0))
            .Discard => {}
            .Ret => c.vc_emit(.Ret)
        }
    }
    if e := end { c.vc_patch(e, c.vc_here()) }
    c.vc_set_top(if want is .Reg { save + 1 } else { save })
}

vc_match_ :: fn(c: ^Vc, n: ^Node, scrutinee: ^Node, arms: []Arm, want: Want) needs Alloc {
    save := c.top
    slots := c.slot_top
    at := c.vc_slot_at(c.vc_alloc_slot(scrutinee.size))
    c.vc_to_slot(scrutinee, at)
    ends := list(u32)
    fails := list(u32)
    for arm in arms {
        c.vc_pat(arm.pat, at, scrutinee.size, &fails)
        if g := arm.guard {
            c.vc_word(g)
            fails.push(c.vc_jump(.Jz(save, 0)))!
            c.top = save
        }
        c.vc_expr(arm.body, want)
        c.top = save
        if want is not .Ret { ends.push(c.vc_jump(.Jmp(0)))! }
        for f in fails.items { c.vc_patch(f, c.vc_here()) }
        fails.clear()
    }
    fails.deinit()
    c.vc_emit(.NoArm(n))
    for e in ends.items { c.vc_patch(e, c.vc_here()) }
    ends.deinit()
    c.slot_top = slots
    c.vc_set_top(if want is .Reg { save + 1 } else { save })
}

vc_find_loop :: fn(c: ^const Vc, label: u32) -> ?u32 {
    i := c.open.items.len
    while i > 0 {
        i -= 1
        li := c.open.items[i]
        if c.loops.items[usize(li)].label is label { return li }
    }
    return null
}

/// A loop of unit type:
///
///     PushLabel; head: Mark; Tick; conditions (to exit); body; cont: step; Release; Jmp head
///     exit: Release; done: PopLabels
vc_loop_ :: fn(c: ^Vc, label: u32, cond: []Cond, body: ^Blk, step: ?^Node) needs Alloc {
    save := c.top
    slots := c.slot_top
    depth := c.open.items.len.trunc(u32)
    mark := c.vc_alloc()
    _ = c.vc_alloc()
    _ = c.vc_alloc()
    h := c.vc_alloc()
    li := c.loops.items.len.trunc(u32)
    c.loops.push(VmLoop(label: label, brk: 0, cont: 0, mark: mark, depth: depth, defers: h, dblocks: c.dblocks))!
    c.open.push(li)!
    c.vc_emit(.DeferHeight(h))
    c.vc_emit(.PushLabel(label))
    head := c.vc_here()
    c.vc_emit(.Mark(mark))
    c.vc_emit(.Tick)
    fails := c.vc_conds(cond)
    c.vc_block(body, .Discard)
    c.top = mark + 4
    cont_at := c.vc_here()
    if st := step { c.vc_expr(st, .Discard) }
    c.top = mark + 4
    c.vc_emit(.Release(mark))
    c.vc_emit(.Jmp(head))
    brk := c.vc_here()
    c.vc_emit(.Release(mark))
    c.vc_emit(.PopLabels(depth))
    for f in fails.items { c.vc_patch(f, brk) }
    fails.deinit()
    // The `break`s compiled in the body jump past the release, which they already did not
    // need: they leave from within an iteration, whose mark the release restores.
    for i in 0..c.exits.items.len {
        x := c.exits.items[i]
        if x.loop is li { c.vc_patch(x.ins, brk) }
    }
    for i in 0..c.conts.items.len {
        x := c.conts.items[i]
        if x.loop is li { c.vc_patch(x.ins, cont_at) }
    }
    _ = c.open.pop()
    c.loops.items[usize(li)].brk = brk
    c.loops.items[usize(li)].cont = cont_at
    c.top = save
    c.slot_top = slots
}

// ---------------------------------------------------------------------------------
// Running
// ---------------------------------------------------------------------------------

/// Runs the compiled body `code` in the frame of `a`, whose storage has room for its slots
/// and registers.
vm_run :: fn(m: ^Machine, a: Act, code: ^Code, dst: []u8) -> Flow!() needs Run {
    fr := a.fr
    // Register indices and jump targets are valid by construction: the registers and the
    // instructions are reached through many-pointers, without bounds checks.
    regs := fr.store.ptr.cast([^]u64)
    ins := code.ins.ptr
    pc: usize = 0
    while true {
        match ins[pc] {
            .Const(r, v) => { regs[usize(r)] = v }
            .Local(r, local, off, size) => {
                i := usize(local)
                if fr.mem[i] is not 0 {
                    regs[usize(r)] = m.load_word(source.DUMMY, fr.mem[i], fr.info.aligns[i], u64(size)) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                } else {
                    o := usize(off)
                    regs[usize(r)] = m.rd_word(fr.store[o..o + usize(size)])
                }
            }
            .SetLocal(x) => {
                i := usize(x.local)
                v := regs[usize(x.r)]
                if fr.mem[i] is 0 and not fr.info.addressed[i] {
                    o := usize(x.off)
                    m.wr_word(fr.store[o..o + usize(x.size)], v)
                } else {
                    b: [8]u8 = ---
                    d := b[0..usize(x.size)]
                    m.wr_word(d, v)
                    m.set_local(x.n.span, fr, x.local, d) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                }
            }
            .Arith64(op, signed, wrap, r, ra, rb, n) => {
                p := regs[usize(ra)]
                q := regs[usize(rb)]
                if wrap {
                    regs[usize(r)] = if op is 0 { p +% q } else if op is 1 { p -% q } else { p *% q }
                } else {
                    res: ?u64 = null
                    if signed {
                        x := p.bits(i64)
                        y := q.bits(i64)
                        v := if op is 0 { x +? y } else if op is 1 { x -? y } else { x *? y }
                        if w := v { res = w.bits(u64) }
                    } else {
                        res = if op is 0 { p +? q } else if op is 1 { p -? q } else { p *? q }
                    }
                    if v := res {
                        regs[usize(r)] = v
                    } else {
                        regs[usize(r)] = m.int_word(arith_op(op, false), IntW(signed: signed, bits: 64), IntW(signed: signed, bits: 64), p, q, n) else f => {
                            pc = try m.vm_flow(a, code, regs, f)
                            continue
                        }
                    }
                }
            }
            .Arith32(op, signed, wrap, bits, r, ra, rb, n) => {
                p := regs[usize(ra)]
                q := regs[usize(rb)]
                mask := mask64(bits)
                s: u64 = 0
                over := false
                if signed {
                    x := sext(p, bits)
                    y := sext(q, bits)
                    v := if op is 0 { x + y } else if op is 1 { x - y } else { x * y }
                    over = v < lo64(bits) or v > hi64(bits)
                    s = v.bits(u64) & mask
                } else {
                    v := if op is 0 { p + q } else if op is 1 { p -% q } else { p * q }
                    over = if op is 1 { p < q } else { v > mask }
                    s = v & mask
                }
                if over and not wrap {
                    regs[usize(r)] = m.int_word(arith_op(op, false), IntW(signed: signed, bits: bits), IntW(signed: signed, bits: bits), p, q, n) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                } else {
                    regs[usize(r)] = s
                }
            }
            .LocalAtD(r, local, at, rel, d, size, align, n) => {
                i := usize(local)
                k := regs[usize(d)]
                if fr.mem[i] is 0 and not fr.info.addressed[i] {
                    o := usize(at) + us(k)
                    regs[usize(r)] = m.rd_word(fr.store[o..o + usize(size)])
                } else {
                    regs[usize(r)] = m.vm_local_at(fr, local, u64(rel) + k, size, align, n) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                }
            }
            .SetLocalAtD(local, at, rel, d, size, align, v, n) => {
                i := usize(local)
                k := regs[usize(d)]
                if fr.mem[i] is 0 and not fr.info.addressed[i] {
                    o := usize(at) + us(k)
                    m.wr_word(fr.store[o..o + usize(size)], regs[usize(v)])
                } else {
                    m.vm_set_local_at(fr, local, u64(rel) + k, size, align, regs[usize(v)], n) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                }
            }
            .ScaleIdx(ri, len, esz, n) => {
                i := regs[usize(ri)]
                if i >= len {
                    pc = try m.vm_flow(a, code, regs, m.trap(n.span, str.format("index {} out of bounds for length {}", i, len)!))
                    continue
                }
                regs[usize(ri)] = i * esz
            }
            .AddR(r, x) => { regs[usize(r)] +%= regs[usize(x)] }
            .Bit(op, r, ra, rb) => {
                p := regs[usize(ra)]
                q := regs[usize(rb)]
                regs[usize(r)] = if op is 0 { p & q } else if op is 1 { p | q } else { p ~ q }
            }
            .Shr(t, shift, r, ra, rb, n) => {
                p := regs[usize(ra)]
                q := regs[usize(rb)]
                if q < u64(t.bits) and not (shift.signed and sext(q, shift.bits) < 0) {
                    regs[usize(r)] = if t.signed { (sext(p, t.bits) >> q.trunc(u32)).bits(u64) & mask64(t.bits) } else { p >> q.trunc(u32) }
                } else {
                    regs[usize(r)] = m.int_word(.Shr, t, shift, p, q, n) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                }
            }
            .JCmp(op, how, ra, rb, to) => if not word_less(op, how, regs[usize(ra)], regs[usize(rb)]) {
                pc = usize(to)
                continue
            }
            .JEq(how, negated, ra, rb, to) => if word_eq(how, regs[usize(ra)], regs[usize(rb)]) is negated {
                pc = usize(to)
                continue
            }
            .IntOp(x) => {
                regs[usize(x.r)] = m.int_word(x.op, x.t, x.shift, regs[usize(x.a)], regs[usize(x.b)], x.n) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .LocalAt(x) => {
                i := usize(x.local)
                if fr.mem[i] is 0 and not fr.info.addressed[i] {
                    o := usize(x.at)
                    regs[usize(x.r)] = m.rd_word(fr.store[o..o + usize(x.size)])
                } else {
                    regs[usize(x.r)] = m.vm_local_at(fr, x.local, u64(x.rel), x.size, x.align, x.n) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                }
            }
            .SetLocalAt(x) => {
                i := usize(x.local)
                v := regs[usize(x.v)]
                if fr.mem[i] is 0 and not fr.info.addressed[i] {
                    o := usize(x.at)
                    m.wr_word(fr.store[o..o + usize(x.size)], v)
                } else {
                    m.vm_set_local_at(fr, x.local, u64(x.rel), x.size, x.align, v, x.n) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                }
            }
            .Load(r, base, off, size, align, n) => {
                addr := regs[usize(base)] +% u64(off)
                b := m.mem.read(addr, u64(size), u64(align)) else e => {
                    pc = try m.vm_flow(a, code, regs, m.mem_trap(n.span, e))
                    continue
                }
                regs[usize(r)] = m.rd_word(b)
            }
            .Store(x) => {
                addr := regs[usize(x.base)] +% u64(x.off)
                b := m.mem.write_view(addr, u64(x.size), u64(x.align)) else e => {
                    pc = try m.vm_flow(a, code, regs, m.mem_trap(x.n.span, e))
                    continue
                }
                m.wr_word(b, regs[usize(x.v)])
            }
            .SliceIdx(x) => {
                i := regs[usize(x.i)]
                len := regs[usize(x.len)]
                if i >= len {
                    pc = try m.vm_flow(a, code, regs, m.trap(x.n.span, str.format("index {} out of bounds for length {}", i, len)!))
                    continue
                }
                k := usize(x.p)
                regs[k] = regs[k] +% i * x.esz
            }
            .ArrIdx(x) => {
                i := regs[usize(x.i)]
                if i >= x.len {
                    pc = try m.vm_flow(a, code, regs, m.trap(x.n.span, str.format("index {} out of bounds for length {}", i, x.len)!))
                    continue
                }
                k := usize(x.p)
                regs[k] = regs[k] +% i * x.esz
            }
            .PtrIdx(x) => {
                k := usize(x.p)
                regs[k] = regs[k] +% regs[usize(x.i)] *% x.esz
            }
            .AddK(r, k) => { regs[usize(r)] +%= k }
            .Cmp(op, how, r, ra, rb) => { regs[usize(r)] = if word_less(op, how, regs[usize(ra)], regs[usize(rb)]) { 1 } else { 0 } }
            .EqW(x) => { regs[usize(x.r)] = if word_eq(x.how, regs[usize(x.a)], regs[usize(x.b)]) is not x.negated { 1 } else { 0 } }
            .Not(r, x) => { regs[usize(r)] = if regs[usize(x)] is 0 { 1 } else { 0 } }
            .Bool(r) => { regs[usize(r)] = if regs[usize(r)] is 0 { 0 } else { 1 } }
            .IntUn(x) => {
                regs[usize(x.r)] = m.int_un(x.op, x.t, regs[usize(x.a)], x.n) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .IntConv(x) => { regs[usize(x.r)] = int_conv(x.op, x.from, x.to, regs[usize(x.a)]) }
            .FloatOp(x) => { regs[usize(x.r)] = float_op(x.op, x.wide, regs[usize(x.a)], regs[usize(x.b)]) }
            .Jmp(to) => {
                pc = usize(to)
                continue
            }
            .Jz(r, to) => if regs[usize(r)] is 0 {
                pc = usize(to)
                continue
            }
            .Jnz(r, to) => if regs[usize(r)] is not 0 {
                pc = usize(to)
                continue
            }
            .Call(x) => {
                m.vm_call(a, x.f, x.args, x.dst, x.node, regs, dst) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .CallValue(x) => {
                m.vm_call_value(a, x.at, x.callee, x.args, x.dst, x.node, regs, dst) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .Perform(x) => {
                m.vm_perform(a, x.args, x.dst, x.node, regs, dst) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .UpvarAt(x) => {
                regs[usize(x.r)] = m.vm_upvar_at(fr, x.levels, x.local, x.rel, x.size, x.align, x.n) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .SetUpvarAt(x) => {
                m.vm_set_upvar_at(fr, x.levels, x.local, x.rel, x.size, x.align, regs[usize(x.v)], x.n) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .CopySlot(d, src, size) => {
                o := usize(d)
                q := usize(src)
                k := usize(size)
                fr.store[o..o + k].copy_from(fr.store[q..q + k])
            }
            .SlotW(r, at, size) => {
                o := usize(at)
                regs[usize(r)] = m.rd_word(fr.store[o..o + usize(size)])
            }
            .WSlot(at, size, r) => {
                o := usize(at)
                m.wr_word(fr.store[o..o + usize(size)], regs[usize(r)])
            }
            .JSlot(at, size, nonzero, to) => {
                o := usize(at)
                if (m.rd_word(fr.store[o..o + usize(size)]) is not 0) is nonzero {
                    pc = usize(to)
                    continue
                }
            }
            .JTag(at, size, v, to) => {
                o := usize(at)
                if m.rd_word(fr.store[o..o + usize(size)]) is not v {
                    pc = usize(to)
                    continue
                }
            }
            .SetLocalSlot(x) => {
                o := usize(x.at)
                i := usize(x.local)
                if fr.mem[i] is 0 and not fr.info.addressed[i] {
                    d := us(fr.info.offsets[i])
                    k := usize(x.size)
                    fr.store[d..d + k].copy_from(fr.store[o..o + k])
                } else {
                    m.set_local(x.span, fr, x.local, fr.store[o..o + usize(x.size)]) else f => {
                        pc = try m.vm_flow(a, code, regs, f)
                        continue
                    }
                }
            }
            .EvalW(r, n) => {
                regs[usize(r)] = m.ew(a, n) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .EvalSlot(off, n) => {
                o := usize(off)
                m.ev(a, n, fr.store[o..o + us(n.size)]) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .Discard(n) => {
                m.ev_discard(a, n) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .Stmt(st) => {
                m.exec_stmt(a, st) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .Mov(r, x) => { regs[usize(r)] = regs[usize(x)] }
            .DeferHeight(r) => { regs[usize(r)] = u64(fr.defers.items.len) }
            .Defer(is_err, body) => fr.defers.push(Deferred(is_err: is_err, body: body))!
            .Unwind(r) => {
                m.vm_unwind(a, us(regs[usize(r)]), false) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .AssignW(place, value) => {
                m.assign_word(a, place, value) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
            .Pat(x) => {
                o := usize(x.off)
                ok := m.match_pat(a, x.pat, fr.store[o..o + usize(x.size)]) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
                if not ok {
                    pc = usize(x.fail)
                    continue
                }
            }
            .NoArm(n) => return !m.trap(n.span, "no match arm matched the scrutinee")
            .RetW(r) => {
                m.wr_word(dst, regs[usize(r)])
                return m.vm_return(a, dst)
            }
            .RetEval(n) => {
                m.ev(a, n, dst) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
                return m.vm_return(a, dst)
            }
            .Ret => return m.vm_return(a, dst)
            .Mark(r) => {
                k := usize(r)
                regs[k] = u64(m.scratch.cur)
                regs[k + 1] = u64(m.scratch.top)
                regs[k + 2] = u64(m.temps.items.len)
            }
            .Release(r) => m.vm_release(regs, r)
            .PushLabel(label) => fr.labels.push(LabelDst(label: label, dst: empty_slice(u8)))!
            .PopLabels(depth) => fr.labels.truncate(usize(depth))
            .Tick => if m.threads.list.items.len > 1 {
                m.tick(source.DUMMY) else f => {
                    pc = try m.vm_flow(a, code, regs, f)
                    continue
                }
            }
        }
        pc += 1
    }
}

/// Releases scratch memory and temporaries to the mark in registers `r..r + 3`.
#inline
vm_release :: fn(m: ^Machine, regs: [^]u64, r: u32) needs Alloc {
    k := usize(r)
    m.scratch.cur = us(regs[k])
    m.scratch.top = us(regs[k + 1])
    tm := us(regs[k + 2])
    if m.temps.items.len > tm { m.kill_temps(tm) }
}

/// Where a flow raised while running `code` continues: a `break` or `continue` to one of
/// its loops jumps there (the exit releases to the iteration's mark and leaves the loop);
/// any other flow leaves the body, running the deferred statements.
vm_flow :: fn(m: ^Machine, a: Act, code: ^Code, regs: [^]u64, f: Flow) -> Flow!usize needs Run {
    fr := a.fr
    match f {
        .Break(frame, label), .Continue(frame, label) => {
            if frame is fr.id {
                for lp in code.loops {
                    if lp.label is label {
                        try m.vm_unwind(a, us(regs[usize(lp.defers)]), false)
                        fr.labels.truncate(usize(lp.depth + 1))
                        return usize(if f is .Break(_) { lp.brk } else { lp.cont })
                    }
                }
            }
        }
        .Trap(_) => return !f
        _ => {}
    }
    if fr.defers.items.len > 0 { try m.vm_unwind(a, 0, errdefers_run(fr, f)) }
    return !f
}

/// Returns from a body whose result is in `dst`, running the deferred statements (the
/// errdefers too if the result is an error).
vm_return :: fn(m: ^Machine, a: Act, dst: []u8) -> Flow!() needs Run {
    fr := a.fr
    if fr.defers.items.len is 0 { return () }
    is_err := if o := fr.info.err_flag { dst[us(o)] is not 0 } else { false }
    return m.vm_unwind(a, 0, is_err)
}

/// Runs the deferred statements of `a`'s frame above `height`, last first (the errdefers
/// only if `run_err`), and drops them.
vm_unwind :: fn(m: ^Machine, a: Act, height: usize, run_err: bool) -> Flow!() needs Run {
    fr := a.fr
    while fr.defers.items.len > height {
        d := fr.defers.pop() else break
        if d.is_err and not run_err { continue }
        tm := m.temps.items.len
        mk := m.mark()
        r := m.ev_discard(a, d.body)
        m.kill_temps(tm)
        m.release(mk)
        r else f => {
            if f is .Trap(_) { return !f }
            return !m.trap(d.body.span, "internal error: control flow escaped a deferred statement")
        }
    }
}

/// A call of `f` with the arguments `args`; its result goes to `dst` (`ret` is the
/// function's own result).
vm_call :: fn(m: ^Machine, a: Act, f: u32, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run => m.vm_invoke(a, f, null, a.cx, null, false, null, args, dst, n, regs, ret)

/// A call of the function value in the slot at `at`, of type `callee.ty` (a second-class
/// function or a function pointer), as `call_value` makes it.
vm_call_value :: fn(m: ^Machine, a: Act, at: u32, callee: ^Node, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run {
    o := usize(at)
    cv := a.fr.store[o..o + us(callee.size)]
    if .Fn(sig) := m.kind(callee.ty) {
        f := m.fn_from_addr(m.word(cv, 0)) else return !m.trap(n.span, "internal error: a function value without code")
        env := m.frame_of(m.word(cv, 1))
        ctx := m.word(cv, 2).trunc(u32)
        // Effects listed in the function type are handled where it is called (§11.6).
        base := ctx
        for eff in sig.effects.effects {
            k := m.find_ctx(a.cx, &eff)
            if k is 0 { continue }
            node := m.ctxs.items[us(k)]
            ctx = m.push_ctx(ctx, node.effect_, node.installed, node.with_frame, node.with_label, node.with_fr)
        }
        r := m.vm_invoke(a, f, env, ctx, null, false, null, args, dst, n, regs, ret)
        m.pop_ctx(ctx, base)
        return r
    }
    addr := m.ptr_of(cv)
    if addr is 0 { return !m.trap(n.span, "call through a null function pointer") }
    f := m.fn_from_addr(addr) else return !m.trap(n.span, str.format("call through an invalid function pointer {:#x}", addr)!)
    return m.vm_invoke(a, f, null, a.cx, null, false, null, args, dst, n, regs, ret)
}

/// Performs the operation of `n` (a `Perform`) with the arguments `args`, as `perform`
/// does: the clause of a handler literal or declaration is called as a function is, and
/// other handlers get the argument values as bytes.
vm_perform :: fn(m: ^Machine, a: Act, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run {
    x := match n.op {
        .Perform(x) => x
        _ => return !m.trap(n.span, "internal error: not an operation")
    }
    k := m.find_ctx(a.cx, &x.effect_)
    if k is 0 { return !m.trap(n.span, str.format("no handler installed for effect `{}`", m.s.tys.effect_name(x.effect_.eff))!) }
    if not m.p.is_ctl(x.effect_.eff, x.op) {
        node := &m.ctxs.items[us(k)]
        installing: ?(frame: ^Frame, label: u32) = null
        if fr := node.with_fr { installing = (frame: fr, label: node.with_label) }
        match node.installed {
            .Lit(h, ?env, cx) => return m.vm_invoke(a, m.p.handler_lit(h).clauses[us(x.op)], env, cx, installing, true, null, args, dst, n, regs, ret)
            .Decl(decls, value, outer) => for d in decls {
                info := m.p.handler_decl(d)
                if info.effect_.eff is not node.effect_.eff or types.cmp_ref(&info.effect_, &node.effect_) is not 0 { continue }
                return m.vm_invoke(a, info.clauses[us(x.op)], null, outer, installing, false, value, args, dst, n, regs, ret)
            }
            .Native(_) => {}
        }
    }
    fr := a.fr
    mk := m.mark()
    base := m.argv.items.len
    i: usize = 0
    while i < args.len {
        match args[i] {
            .Reg(r) => {
                b := m.tmp(x.args[i].size)
                m.wr_word(b, regs[usize(r)])
                m.argv.push(b)!
            }
            .Slot(at, size) => m.argv.push(fr.store[usize(at)..usize(at) + usize(size)])!
        }
        i += 1
    }
    b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
    d := match dst {
        .Reg(_) => b[0..us(n.size)]
        .None => if n.size <= 8 { b[0..us(n.size)] } else { m.tmp(n.size) }
        .Slot(at) => fr.store[usize(at)..us(u64(at) + n.size)]
        .Ret => ret
    }
    res := m.perform(a.cx, n.span, &x.effect_, x.op, m.argv.items[base..m.argv.items.len], d)
    m.argv.truncate(base)
    m.release(mk)
    try res
    if .Reg(r) := dst { regs[usize(r)] = m.rd_word(d) }
}

/// Calls `f` (capturing `env`, in context `cx`, a clause of the `with` `installing` if any)
/// with the arguments `args`, after the handler value `self_` for a clause of a handler
/// declaration; its result goes to `dst` (`ret` is the function's own result).
vm_invoke :: fn(m: ^Machine, a: Act, f: u32, env: ?^Frame, cx: u32, installing: ?(frame: ^Frame, label: u32), is_clause_lit: bool, self_: ?[]u8, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run {
    info := m.fn_info(f)
    body := info.body else return m.call_missing(n.span, f)
    first: usize = if self_ is null { 0 } else { 1 }
    if args.len + first is not info.params.len { return !m.trap(n.span, str.format("internal error: `{}` called with {} arguments, expected {}", m.func(f).name, args.len + first, info.params.len)!) }
    if info.cost > MAX_FRAME { return !m.trap(n.span, str.format("stack overflow: `{}` needs a frame of {} bytes", m.func(f).name, info.cost)!) }
    fr := a.fr
    mk := m.mark()
    store := m.tmp(info.frame_size)
    if v := self_ {
        off := us(info.offsets[us(info.params[0])])
        store[off..off + v.len].copy_from(v)
    }
    // Not `enumerate`: an iterator costs a call per element.
    i: usize = 0
    while i < args.len {
        p := usize(info.params[first + i])
        off := us(info.offsets[p])
        i += 1
        match args[i - 1] {
            .Reg(r) => m.wr_word(store[off..off + us(info.sizes[p])], regs[usize(r)])
            .Slot(at, size) => {
                o := usize(at)
                k := usize(size)
                store[off..off + k].copy_from(fr.store[o..o + k])
            }
        }
    }
    b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
    d := match dst {
        .Reg(_) => b[0..us(n.size)]
        .None => if n.size <= 8 { b[0..us(n.size)] } else { m.tmp(n.size) }
        .Slot(at) => fr.store[usize(at)..us(u64(at) + n.size)]
        .Ret => ret
    }
    res := m.enter(n.span, f, info, body, store, env, cx, installing, is_clause_lit, d)
    m.release(mk)
    try res
    if .Reg(r) := dst { regs[usize(r)] = m.rd_word(d) }
}

/// The word at offset `rel` of local `l` of the frame `levels` capture links up from `fr`.
vm_upvar_at :: fn(m: ^Machine, fr: ^Frame, levels: u32, l: u32, rel: u32, size: u32, align: u32, n: ^Node) -> Flow!u64 needs Alloc {
    up := (if levels is 1 { fr.env } else { frame_up(fr, levels) }) else return !m.trap(n.span, "internal error: upvar without an enclosing frame")
    i := usize(l)
    if up.mem[i] is 0 and not up.info.addressed[i] {
        o := us(up.info.offsets[i]) + usize(rel)
        return m.rd_word(up.store[o..o + usize(size)])
    }
    return m.vm_local_at(up, l, u64(rel), size, align, n)
}

vm_set_upvar_at :: fn(m: ^Machine, fr: ^Frame, levels: u32, l: u32, rel: u32, size: u32, align: u32, v: u64, n: ^Node) -> Flow!() needs Alloc {
    up := (if levels is 1 { fr.env } else { frame_up(fr, levels) }) else return !m.trap(n.span, "internal error: upvar without an enclosing frame")
    i := usize(l)
    if up.mem[i] is 0 and not up.info.addressed[i] {
        o := us(up.info.offsets[i]) + usize(rel)
        m.wr_word(up.store[o..o + usize(size)], v)
        return ()
    }
    return m.vm_set_local_at(up, l, u64(rel), size, align, v, n)
}

/// The word at offset `rel` of local `l` of `fr`, which is or must be in memory.
vm_local_at :: fn(m: ^Machine, fr: ^Frame, l: u32, rel: u64, size: u32, align: u32, n: ^Node) -> Flow!u64 needs Alloc {
    addr := try m.local_addr(n.span, fr, l)
    return m.load_word(n.span, addr + rel, u64(align), u64(size))
}

vm_set_local_at :: fn(m: ^Machine, fr: ^Frame, l: u32, rel: u64, size: u32, align: u32, v: u64, n: ^Node) -> Flow!() needs Alloc {
    addr := try m.local_addr(n.span, fr, l)
    b := m.mem.write_view(addr + rel, u64(size), u64(align)) else e => return !m.mem_trap(n.span, e)
    m.wr_word(b, v)
}

/// `place = value` for a word value.
assign_word :: fn(m: ^Machine, a: Act, place: ^Node, value: ^Node) -> Flow!() needs Run {
    p := try m.place(a, place, false)
    v := try m.ew(a, value)
    b: [8]u8 = ---
    d := b[0..us(value.size)]
    m.wr_word(d, v)
    return m.write_place(place.span, p, place.ty, d)
}
