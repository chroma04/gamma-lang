// The register machine that runs function bodies.
//
// A body's statement structure (blocks, `if`, loops of unit type, `match` and its
// patterns, `return`, `break` and `continue`), its expressions on words (integers, floats,
// booleans and pointers of at most 8 bytes), its calls and operations, and the building
// of other values (structs, tuples, optionals, results, variants, slices) are compiled
// into a flat list of instructions on word registers, which `vm_run` executes in one
// loop. Everything else is left to the tree evaluator (`run.gm`), which an instruction
// invokes on a whole subtree: the machine covers the common paths and the tree all the
// language, so they always agree.
//
// The frame's storage, seen as words, is the register file. A local that is a word and
// whose address is never taken has 8 bytes of its own there and is a register, as is
// every 8-byte word of a local at an offset that is a multiple of 8, when the host and
// the target store words alike (little-endian). After the locals come the byte slots
// (values that are not words: scrutinees, arguments and results of calls), then the
// registers of the constants the body uses, then the temporaries, allocated as a stack
// while compiling: each expression leaves its value in the first free one.
//
// A `break` or `continue` that a subtree raises (as a `Flow`) to a loop of the machine
// jumps to it; every other flow leaves the body, as the tree's would. The `defer` and
// `errdefer` statements that run push their bodies on the frame's stack of deferred
// statements (`Frame.defers`); leaving a block runs those it pushed, last first: at its
// end, at a `break` or `continue` out of it, and when the function returns or a flow
// leaves the body (errdefers then run as the tree's blocks would run them, §8.8).

/// A compiled body.
Code :: struct {
    ins: []Ins
    /// The instructions as the machine's loop runs them (`bc.gm`), and whether the body
    /// runs without a frame.
    bc: []Bc
    frameless: bool
    /// The size of the locals in the frame's storage: the words after them are temporaries.
    locals_size: u64
    /// For a body that runs without a frame: the register holding the address of each
    /// local that has memory of its own (0 until it has), `NO_REG` for the others; empty
    /// if no local has. The memory dies when the body returns (`vm_drop_locals`).
    hidden: []u32
    info: ^FnInfo
    /// The sites of its direct calls (`CallSite`).
    sites: []CallSite
    /// The register holding the address of the frame the body captures, if it reads or
    /// writes that frame's locals (`NO_REG` if not).
    env_reg: u32
    /// The frame's storage seen as words is the register file: the locals that are words
    /// (`vc_local_reg`) are registers, and so are the words from `regs_off` on, after the
    /// byte slots. `size` is the storage's whole size.
    regs_off: u64
    size: u64
    /// The constants the registers from `regs_off` on hold, set when the body starts.
    consts: []u64
    /// The loops: their labels and where their `break`s and `continue`s go.
    loops: []VmLoop
}

VmLoop :: struct {
    label: u32
    /// Where a `break` and a `continue` go.
    brk: u32
    cont: u32
    /// The register holding the height of the frame's deferred statements at its entry
    /// (`NO_DEFERS` if it has no deferred statements).
    defers: u32
    /// How many blocks with deferred statements enclose it.
    dblocks: u32
    /// The register holding the handler context at its entry (`NO_CX` if no `with` is in
    /// it), and how many `with`s enclose it.
    cx: u32
    withs: u32
    /// True for a `with` (`vc_with`), whose `break`s go to where it restores the context,
    /// and where a `break` with a value leaves it: the slot at `at`, of `size` bytes.
    is_with: bool
    at: u32 = 0
    size: u32 = 0
}

/// The `VmLoop.defers` of a loop without deferred statements.
NO_DEFERS: u32 : 0xFFFF_FFFF

/// The `VmLoop.cx` of a loop without `with`s.
NO_CX: u32 : 0xFFFF_FFFF

Ins :: union {
    Const: (r: u32, v: u64)
    /// A word local of this frame.
    Local: (r: u32, local: u32, off: u32, size: u32)
    SetLocal: (local: u32, off: u32, size: u32, r: u32, n: ^Node)
    /// The word at `at` in the frame's storage: (part of) a local kept there, which is one
    /// whose address is never taken (the others have memory of their own once it is, and
    /// are reached through `LocalAddr`).
    LocalAt: (r: u32, at: u32, size: u32)
    SetLocalAt: (at: u32, size: u32, v: u32)
    /// The same for a local of the frame `levels` capture links up (an upvar).
    UpvarAt: (r: u32, levels: u32, local: u32, rel: u32, size: u32, align: u32, n: ^Node)
    /// `LocalAt` and `SetLocalAt` at a further offset in register `d` (an array element).
    LocalAtD: (r: u32, at: u32, d: u32, size: u32)
    SetLocalAtD: (at: u32, d: u32, size: u32, v: u32)
    /// Checks the index in a register against an array's length and scales it to a byte
    /// offset; `AddR` adds a register to another.
    ScaleIdx: (i: u32, len: u64, esz: u64, n: ^Node)
    AddR: (r: u32, a: u32)
    /// `&`, `|` and `~` (`op` 0, 1, 2) on words; `>>` on integers whose shift amount is in
    /// range (else the general operator decides).
    Bit: (op: u8, r: u32, a: u32, b: u32)
    Shr: (t: IntW, shift: IntW, r: u32, a: u32, b: u32, n: ^Node)
    /// `<<`, checked or (`wrap`) wrapping, on integers whose shift amount is in range and
    /// whose bits shifted out are all copies of the sign (else the general operator
    /// decides).
    Shl: (t: IntW, shift: IntW, wrap: bool, r: u32, a: u32, b: u32, n: ^Node)
    SetUpvarAt: (levels: u32, local: u32, rel: u32, size: u32, align: u32, v: u32, n: ^Node)
    /// A word at the address in register `base` plus `off`.
    Load: (r: u32, base: u32, off: u32, size: u32, align: u32, n: ^Node)
    Store: (base: u32, off: u32, size: u32, align: u32, v: u32, n: ^Node)
    /// The address of element `i` (in a register) of the slice whose pointer and length
    /// are in registers `p` and `len`, into `p`; traps if `i` is out of bounds. With
    /// `ArrIdx`, of an array of `len` elements at the address in `p`.
    SliceIdx: (p: u32, len: u32, i: u32, esz: u64, n: ^Node)
    ArrIdx: (p: u32, i: u32, len: u64, esz: u64, n: ^Node)
    /// Element `i` (a register) of the slice whose pointer and length are in registers `p`
    /// and `len`, of `size` bytes aligned to `align`: read into `r`, or (`SliceSt`) written
    /// from `v`; traps if `i` is out of bounds.
    SliceLd: (r: u32, p: u32, len: u32, i: u32, esz: u64, size: u32, align: u32, n: ^Node)
    SliceSt: (p: u32, len: u32, i: u32, esz: u64, size: u32, align: u32, v: u32, n: ^Node)
    /// The address of element `i` of the many-pointer in `p`, into `p`.
    PtrIdx: (p: u32, i: u32, esz: u64)
    /// Adds a constant to a register (an address).
    AddK: (r: u32, k: u64)
    IntOp: (op: tir.BinOp, t: IntW, shift: IntW, r: u32, a: u32, b: u32, n: ^Node)
    /// `+`, `-` or `*` (`op` 0, 1, 2) on integers of 64 bits, or (`Arith32`) of at most 32,
    /// checked or (`wrap`) wrapping: the common operators without `int_word`'s generality.
    Arith64: (op: u8, signed: bool, wrap: bool, r: u32, a: u32, b: u32, n: ^Node)
    Arith32: (op: u8, signed: bool, wrap: bool, bits: u32, r: u32, a: u32, b: u32, n: ^Node)
    /// Jumps to `to` unless the comparison (or `is`) of two registers holds.
    JCmp: (op: tir.BinOp, how: WordCmp, a: u32, b: u32, to: u32)
    JEq: (how: WordCmp, negated: bool, a: u32, b: u32, to: u32)
    Cmp: (op: tir.BinOp, how: WordCmp, r: u32, a: u32, b: u32)
    EqW: (how: WordCmp, negated: bool, r: u32, a: u32, b: u32)
    Not: (r: u32, a: u32)
    /// A boolean of a word: 1 if it is nonzero.
    Bool: u32
    IntUn: (op: tir.UnOp, t: IntW, r: u32, a: u32, n: ^Node)
    IntConv: (op: tir.Builtin, from: IntW, to: IntW, r: u32, a: u32)
    /// `bit_word` of registers `a` and `b` (`b` unused but by a rotation).
    IntBit: (op: tir.Builtin, t: IntW, r: u32, a: u32, b: u32)
    FloatOp: (op: tir.BinOp, wide: bool, r: u32, a: u32, b: u32)
    Jmp: u32
    /// Jumps if the register is zero, or (`Jnz`) not.
    Jz: (r: u32, to: u32)
    Jnz: (r: u32, to: u32)
    /// Copies the `size` bytes aligned to `align` at the address in register `base` plus
    /// `off` to the slot at `at`, or (`MemPut`) the slot's bytes there.
    MemGet: (at: u32, base: u32, off: u32, size: u32, align: u32, n: ^Node)
    MemPut: (base: u32, off: u32, at: u32, size: u32, align: u32, n: ^Node)
    /// Traps if the address in a register is not aligned to `align` (a pointer cast).
    AlignCheck: (r: u32, align: u64, n: ^Node)
    /// The trap of `n`, an unwrap of the absent optional or the error (`is_result`) of type
    /// `ty` in the slot at `at`.
    UnwrapTrap: (at: u32, ty: Ty, is_result: bool, n: ^Node)
    /// The builtin operation of `node` (a `Builtin` that takes the values of its
    /// arguments) with arguments in registers and slots.
    Builtin: (args: []Arg, dst: Dest, node: ^Node)
    /// Writes the string literal `n` (its address and length) to the slot at `at`.
    StrSlot: (at: u32, n: ^Node)
    /// A call of function `f` with arguments in registers and slots.
    Call: (f: u32, args: []Arg, dst: Dest, node: ^Node)
    /// A call of the function value in the slot at `at` (the value of `callee`).
    CallValue: (at: u32, callee: ^Node, args: []Arg, dst: Dest, node: ^Node)
    /// The trap of the assertion `n` that failed, with the message (a string) in the slot
    /// at `at` if `has_msg`.
    AssertFail: (at: u32, has_msg: bool, n: ^Node)
    /// Performs the operation of `node` (a `Perform`) with arguments in registers and slots.
    Perform: (args: []Arg, dst: Dest, node: ^Node)
    /// Copies a slot's bytes to a local of this frame that has memory of its own (to one
    /// kept in the frame's storage, `CopySlot` copies them).
    SetLocalSlot: (local: u32, at: u32, size: u32, span: source.Span)
    /// Copies `size` bytes between slots, reads a word of a slot into a register, or writes
    /// one to a slot.
    CopySlot: (dst: u32, src: u32, size: u32)
    SlotW: (r: u32, at: u32, size: u32)
    WSlot: (at: u32, size: u32, r: u32)
    /// Jumps if the word of `size` bytes in the slot at `at` is zero (or, with `nonzero`,
    /// is not): the test of an optional's or a result's flag.
    JSlot: (at: u32, size: u32, nonzero: bool, to: u32)
    /// Copies constant bytes to the slot at `at`, or zeroes `size` bytes there.
    ConstSlot: (at: u32, b: []const u8)
    ZeroSlot: (at: u32, size: u32)
    /// Writes the slice from `lo` to `hi` (registers) of the elements of `esz` bytes at the
    /// address in `p` to the slot at `at`; traps if the bounds are out of order or (if
    /// `has_len`) past the length in `len`.
    SliceMake: (at: u32, p: u32, len: u32, lo: u32, hi: u32, has_len: bool, inclusive: bool, esz: u64, n: ^Node)
    /// The address of a local of this frame, which is given memory of its own.
    LocalAddr: (r: u32, local: u32, n: ^Node)
    /// Jumps unless the word of `size` bytes in the slot at `at` is `v`: the test of a
    /// variant's tag.
    JTag: (at: u32, size: u32, v: u64, to: u32)
    /// The tree evaluator: a word into a register, a value into a slot, or for effects.
    EvalW: (r: u32, n: ^Node)
    EvalSlot: (off: u32, n: ^Node)
    Discard: ^Node
    /// A statement, run by the tree evaluator.
    Stmt: St
    /// Copies a register.
    Mov: (r: u32, a: u32)
    /// Records the height of the frame's deferred statements in a register.
    DeferHeight: u32
    /// A `defer` (or `errdefer`) statement: pushes its body.
    Defer: (is_err: bool, body: ^Node)
    /// Runs the plain deferred statements pushed since the height in a register was taken,
    /// last first, and drops the others.
    Unwind: u32
    /// A word assignment to a place, by the tree evaluator.
    AssignW: (place: ^Node, value: ^Node)
    /// Matches the value in a slot against a pattern, binding its locals; jumps if it fails.
    Pat: (pat: ^Pat, off: u32, size: u32, fail: u32)
    /// No arm of a `match` matched.
    NoArm: ^Node
    /// The function returns the word in a register, a value the tree evaluates into its
    /// result, or nothing.
    RetW: u32
    RetEval: ^Node
    /// The function returns the `size` bytes in the slot at `at`.
    RetSlot: (at: u32, size: u32)
    Ret
    /// Takes the scratch mark into registers `r..r + 3`, or releases scratch memory and
    /// temporaries to it.
    Mark: u32
    Release: u32
    /// Jumps back to the start of a loop, letting other threads run first.
    Loop: u32
    /// Nothing: what compiling leaves of a mark that is not needed, removed at its end
    /// (`vc_compact`).
    Nop
    /// Records the handler context in a register, or (`CxRestore`) goes back to it,
    /// uninstalling the handlers installed since.
    CxSave: u32
    CxRestore: u32
    /// Installs the handler literal `id` whose value is in the slot at `at` (written in
    /// the `with` if `at` is `NO_REG`: it captures this frame and context), or the
    /// handler declarations `decls` for the value of `size` bytes there, for the `with` of
    /// `label` (`vc_with`).
    WithLit: (id: u32, at: u32, label: u32)
    WithDecl: (decls: []const u32, at: u32, size: u32, label: u32)
}

/// An argument of a call: a word in a register, or the bytes in a slot.
Arg :: union {
    Reg: u32
    Slot: (at: u32, size: u32)
}

/// Where the result of a call goes: nowhere, a register, a slot, or the function's result.
Dest :: union {
    None
    Reg: u32
    Slot: u32
    Ret
}

// Running (the compiler of bodies to instructions is in `vm_compile.gm`, the form they
// run in is in `bc.gm`).

/// What `vm_framed` returns as the next instruction when the body returned.
VM_RETURN: usize : ~usize(0)

/// Runs the compiled body `body` in the frame of `a`, whose storage has room for its slots
/// and registers; its result goes to `ret`.
///
/// The loop dispatches on the `Bc` of each instruction, which does its common case. An
/// instruction without one, or whose common case does not apply (the arm then leaves the
/// loop with `break`), is run from its `Ins` by `vm_free` or `vm_framed`, which also raise
/// the traps. A call of a body that needs no frame (`Code.frameless`) stays in the loop:
/// `vm_push` gives the callee its storage and records what the caller resumes with, and a
/// return pops the record. Only the body the loop was entered for can have a frame, so
/// the frame, the handler context and the deferred statements are always those of `a`.
///
/// Its generated C must stay below the size at which the C back end has Clang compile a
/// function without optimization (`GM_LONG_FN`): the arms are a few operations each.
vm_run :: fn(m: ^Machine, a: Act, body: ^Code, ret: []u8) -> Flow!() needs Run {
    // Register indices and jump targets are valid by construction: the registers and the
    // instructions are reached through many-pointers, without bounds checks. The loop
    // keeps only them and the index of the instruction in variables of its own; the rest
    // of what is running is in its record `cur`: this one for the body, and one in
    // scratch memory for each call made in the loop.
    base := CallRec(prev: null, code: body, regs: a.fr.store.ptr.cast([^]u64), dst: ret, fr: a.fr, cx: a.cx, base_cx: a.cx, pc: 0, f: 0, ret_reg: NO_REG, buf: [8]u8(fill: 0), mark: Mark(cur: 0, top: 0), tm: 0)
    cur := &base
    regs := cur.regs
    bc := body.bc.ptr
    pc: usize = 0
    ip := bc
    vm_consts(body, regs)
    if body.env_reg is not NO_REG {
        if e := a.fr.env { regs[usize(body.env_reg)] = u64(e.addr()) }
    }
    while true {
        done := false
        while true {
            i := &ip[0]
            match i.op {
                .Mov => { regs[usize(i.a)] = regs[usize(i.b)] }
                .K => { regs[usize(i.a)] = u64(i.b) | (u64(i.c) <<% 32) }
                .AddI => {
                    v := (regs[usize(i.b)].bits(i64) +? regs[usize(i.c)].bits(i64)) else break
                    regs[usize(i.a)] = v.bits(u64)
                }
                .SubI => {
                    v := (regs[usize(i.b)].bits(i64) -? regs[usize(i.c)].bits(i64)) else break
                    regs[usize(i.a)] = v.bits(u64)
                }
                .MulI => {
                    v := (regs[usize(i.b)].bits(i64) *? regs[usize(i.c)].bits(i64)) else break
                    regs[usize(i.a)] = v.bits(u64)
                }
                .AddU => { regs[usize(i.a)] = (regs[usize(i.b)] +? regs[usize(i.c)]) else break }
                .SubU => { regs[usize(i.a)] = (regs[usize(i.b)] -? regs[usize(i.c)]) else break }
                .MulU => { regs[usize(i.a)] = (regs[usize(i.b)] *? regs[usize(i.c)]) else break }
                .AddW => { regs[usize(i.a)] = regs[usize(i.b)] +% regs[usize(i.c)] }
                .SubW => { regs[usize(i.a)] = regs[usize(i.b)] -% regs[usize(i.c)] }
                .MulW => { regs[usize(i.a)] = regs[usize(i.b)] *% regs[usize(i.c)] }
                .AddS => { regs[usize(i.a)] = arith32(0, true, false, u32(i.w), regs[usize(i.b)], regs[usize(i.c)]) else break }
                .SubS => { regs[usize(i.a)] = arith32(1, true, false, u32(i.w), regs[usize(i.b)], regs[usize(i.c)]) else break }
                .MulS => { regs[usize(i.a)] = arith32(2, true, false, u32(i.w), regs[usize(i.b)], regs[usize(i.c)]) else break }
                .AddN => { regs[usize(i.a)] = arith32(0, false, false, u32(i.w), regs[usize(i.b)], regs[usize(i.c)]) else break }
                .SubN => { regs[usize(i.a)] = arith32(1, false, false, u32(i.w), regs[usize(i.b)], regs[usize(i.c)]) else break }
                .MulN => { regs[usize(i.a)] = arith32(2, false, false, u32(i.w), regs[usize(i.b)], regs[usize(i.c)]) else break }
                .AddM => { regs[usize(i.a)] = (regs[usize(i.b)] +% regs[usize(i.c)]) & mask64(u32(i.w)) }
                .SubM => { regs[usize(i.a)] = (regs[usize(i.b)] -% regs[usize(i.c)]) & mask64(u32(i.w)) }
                .MulM => { regs[usize(i.a)] = (regs[usize(i.b)] *% regs[usize(i.c)]) & mask64(u32(i.w)) }
                .AddF => { regs[usize(i.a)] = (regs[usize(i.b)].bits(f64) + regs[usize(i.c)].bits(f64)).bits(u64) }
                .SubF => { regs[usize(i.a)] = (regs[usize(i.b)].bits(f64) - regs[usize(i.c)].bits(f64)).bits(u64) }
                .MulF => { regs[usize(i.a)] = (regs[usize(i.b)].bits(f64) * regs[usize(i.c)].bits(f64)).bits(u64) }
                .DivF => { regs[usize(i.a)] = (regs[usize(i.b)].bits(f64) / regs[usize(i.c)].bits(f64)).bits(u64) }
                .And => { regs[usize(i.a)] = regs[usize(i.b)] & regs[usize(i.c)] }
                .Or => { regs[usize(i.a)] = regs[usize(i.b)] | regs[usize(i.c)] }
                .Xor => { regs[usize(i.a)] = regs[usize(i.b)] ~ regs[usize(i.c)] }
                .AddR => { regs[usize(i.a)] +%= regs[usize(i.b)] }
                .AddK => { regs[usize(i.a)] +%= u64(i.b) | (u64(i.c) <<% 32) }
                .Not => { regs[usize(i.a)] = if regs[usize(i.b)] is 0 { 1 } else { 0 } }
                .Bool => { regs[usize(i.a)] = if regs[usize(i.a)] is 0 { 0 } else { 1 } }
                .Mask => { regs[usize(i.a)] = regs[usize(i.b)] & mask64(u32(i.w)) }
                .Sext => { regs[usize(i.a)] = sext(regs[usize(i.b)], u32(i.f)).bits(u64) & mask64(u32(i.w)) }
                .LtU => { regs[usize(i.a)] = if regs[usize(i.b)] < regs[usize(i.c)] { 1 } else { 0 } }
                .LeU => { regs[usize(i.a)] = if regs[usize(i.b)] <= regs[usize(i.c)] { 1 } else { 0 } }
                .LtI => { regs[usize(i.a)] = if regs[usize(i.b)].bits(i64) < regs[usize(i.c)].bits(i64) { 1 } else { 0 } }
                .LeI => { regs[usize(i.a)] = if regs[usize(i.b)].bits(i64) <= regs[usize(i.c)].bits(i64) { 1 } else { 0 } }
                .LtS => { regs[usize(i.a)] = if sext(regs[usize(i.b)], u32(i.w)) < sext(regs[usize(i.c)], u32(i.w)) { 1 } else { 0 } }
                .LeS => { regs[usize(i.a)] = if sext(regs[usize(i.b)], u32(i.w)) <= sext(regs[usize(i.c)], u32(i.w)) { 1 } else { 0 } }
                .LtF => { regs[usize(i.a)] = if regs[usize(i.b)].bits(f64) < regs[usize(i.c)].bits(f64) { 1 } else { 0 } }
                .LeF => { regs[usize(i.a)] = if regs[usize(i.b)].bits(f64) <= regs[usize(i.c)].bits(f64) { 1 } else { 0 } }
                .Eq => { regs[usize(i.a)] = if regs[usize(i.b)] is regs[usize(i.c)] { 1 } else { 0 } }
                .Ne => { regs[usize(i.a)] = if regs[usize(i.b)] is regs[usize(i.c)] { 0 } else { 1 } }
                .JLtU => if not (regs[usize(i.a)] < regs[usize(i.b)]) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JLeU => if not (regs[usize(i.a)] <= regs[usize(i.b)]) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JLtI => if not (regs[usize(i.a)].bits(i64) < regs[usize(i.b)].bits(i64)) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JLeI => if not (regs[usize(i.a)].bits(i64) <= regs[usize(i.b)].bits(i64)) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JLtS => if not (sext(regs[usize(i.a)], u32(i.w)) < sext(regs[usize(i.b)], u32(i.w))) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JLeS => if not (sext(regs[usize(i.a)], u32(i.w)) <= sext(regs[usize(i.b)], u32(i.w))) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JLtF => if not (regs[usize(i.a)].bits(f64) < regs[usize(i.b)].bits(f64)) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JLeF => if not (regs[usize(i.a)].bits(f64) <= regs[usize(i.b)].bits(f64)) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JEq => if regs[usize(i.a)] is regs[usize(i.b)] {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JNe => if regs[usize(i.a)] is not regs[usize(i.b)] {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .Jmp => {
                    ip = bc_at(bc, usize(i.a))
                    continue
                }
                .Jz => if regs[usize(i.a)] is 0 {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .Jnz => if regs[usize(i.a)] is not 0 {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .Loop => {
                    // Other threads run first (`vm_free`).
                    if m.threads.list.items.len > 1 { break }
                    ip = bc_at(bc, usize(i.a))
                    continue
                }
                .Fr1 => { regs[usize(i.a)] = ld1(fat(regs, usize(i.b))) }
                .Fr2 => { regs[usize(i.a)] = ld2(fat(regs, usize(i.b))) }
                .Fr4 => { regs[usize(i.a)] = ld4(fat(regs, usize(i.b))) }
                .Fr8 => { regs[usize(i.a)] = ld8(fat(regs, usize(i.b))) }
                .FrSet1 => st1(fat(regs, usize(i.a)), regs[usize(i.b)])
                .FrSet2 => st2(fat(regs, usize(i.a)), regs[usize(i.b)])
                .FrSet4 => st4(fat(regs, usize(i.a)), regs[usize(i.b)])
                .FrSet8 => st8(fat(regs, usize(i.a)), regs[usize(i.b)])
                .FrD => { regs[usize(i.a)] = ldn(fat(regs, usize(i.b) + us(regs[usize(i.c)])), i.f) }
                .FrSetD => stn(fat(regs, usize(i.a) + us(regs[usize(i.b)])), i.f, regs[usize(i.c)])
                .JFrZ => if ldn(fat(regs, usize(i.a)), i.f) is 0 {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JFrNz => if ldn(fat(regs, usize(i.a)), i.f) is not 0 {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .JTag => if ldn(fat(regs, usize(i.a)), i.f) is not u64(i.b) {
                    ip = bc_at(bc, usize(i.c))
                    continue
                }
                .Ld1 => {
                    p := m.mem.view(regs[usize(i.b)] +% u64(i.c), 1, false) else break
                    regs[usize(i.a)] = ld1(p)
                }
                .Ld2 => {
                    p := m.vm_view(regs[usize(i.b)] +% u64(i.c), 2, u64(i.w), false) else break
                    regs[usize(i.a)] = ld2(p)
                }
                .Ld4 => {
                    p := m.vm_view(regs[usize(i.b)] +% u64(i.c), 4, u64(i.w), false) else break
                    regs[usize(i.a)] = ld4(p)
                }
                .Ld8 => {
                    p := m.vm_view(regs[usize(i.b)] +% u64(i.c), 8, u64(i.w), false) else break
                    regs[usize(i.a)] = ld8(p)
                }
                .St1 => {
                    p := m.mem.view(regs[usize(i.a)] +% u64(i.c), 1, true) else break
                    st1(p, regs[usize(i.b)])
                }
                .St2 => {
                    p := m.vm_view(regs[usize(i.a)] +% u64(i.c), 2, u64(i.w), true) else break
                    st2(p, regs[usize(i.b)])
                }
                .St4 => {
                    p := m.vm_view(regs[usize(i.a)] +% u64(i.c), 4, u64(i.w), true) else break
                    st4(p, regs[usize(i.b)])
                }
                .St8 => {
                    p := m.vm_view(regs[usize(i.a)] +% u64(i.c), 8, u64(i.w), true) else break
                    st8(p, regs[usize(i.b)])
                }
                .SliceLd => {
                    k := regs[usize(i.c)]
                    if k >= regs[usize(i.b) + 1] { break }
                    p := m.vm_view(regs[usize(i.b)] +% k *% u64(i.w), u64(i.f), u64(i.f), false) else break
                    regs[usize(i.a)] = ldn(p, i.f)
                }
                .SliceSt => {
                    k := regs[usize(i.c)]
                    if k >= regs[usize(i.a) + 1] { break }
                    p := m.vm_view(regs[usize(i.a)] +% k *% u64(i.w), u64(i.f), u64(i.f), true) else break
                    stn(p, i.f, regs[usize(i.b)])
                }
                .ScaleIdx => {
                    k := regs[usize(i.a)]
                    if k >= u64(i.b) { break }
                    regs[usize(i.a)] = k *% u64(i.c)
                }
                .SliceIdx => {
                    k := regs[usize(i.c)]
                    if k >= regs[usize(i.b)] { break }
                    regs[usize(i.a)] = regs[usize(i.a)] +% k *% u64(i.w)
                }
                .ArrIdx => {
                    k := regs[usize(i.b)]
                    if k >= u64(i.c) { break }
                    regs[usize(i.a)] = regs[usize(i.a)] +% k *% u64(i.w)
                }
                .PtrIdx => { regs[usize(i.a)] = regs[usize(i.a)] +% regs[usize(i.b)] *% u64(i.c) }
                .ShrU => {
                    q := regs[usize(i.c)]
                    if q >= u64(i.w) { break }
                    regs[usize(i.a)] = regs[usize(i.b)] >> q
                }
                .ShrS => {
                    q := regs[usize(i.c)]
                    if q >= u64(i.w) { break }
                    regs[usize(i.a)] = (sext(regs[usize(i.b)], u32(i.w)) >> q.trunc(u32)).bits(u64) & mask64(u32(i.w))
                }
                .ShlM => {
                    q := regs[usize(i.c)]
                    if q >= u64(i.w) { break }
                    regs[usize(i.a)] = (regs[usize(i.b)] <<% q) & mask64(u32(i.w))
                }
                .ShlN => {
                    q := regs[usize(i.c)]
                    if q >= u64(i.w) { break }
                    p := regs[usize(i.b)]
                    low := (p <<% q) & mask64(u32(i.w))
                    if (low >> q) is not p { break }
                    regs[usize(i.a)] = low
                }
                .DivU => {
                    q := regs[usize(i.c)]
                    if q is 0 { break }
                    regs[usize(i.a)] = regs[usize(i.b)] / q
                }
                .RemU => {
                    q := regs[usize(i.c)]
                    if q is 0 { break }
                    regs[usize(i.a)] = regs[usize(i.b)] % q
                }
                .DivS => {
                    x := sext(regs[usize(i.b)], u32(i.w))
                    y := sext(regs[usize(i.c)], u32(i.w))
                    if y is 0 or (y is -1 and x is lo64(u32(i.w))) { break }
                    regs[usize(i.a)] = (x / y).bits(u64) & mask64(u32(i.w))
                }
                .RemS => {
                    x := sext(regs[usize(i.b)], u32(i.w))
                    y := sext(regs[usize(i.c)], u32(i.w))
                    if y is 0 or (y is -1 and x is lo64(u32(i.w))) { break }
                    regs[usize(i.a)] = (x % y).bits(u64) & mask64(u32(i.w))
                }
                .Up => {
                    up := us(regs[usize(cur.code.env_reg)]).to_ptr(^Frame) else break
                    l := usize(i.b)
                    if up.mem.ptr[l] is not 0 or up.info.addressed.ptr[l] { break }
                    regs[usize(i.a)] = ldn((&up.store.ptr[us(up.info.offsets.ptr[l]) + usize(i.c)]).cast([^]u8), i.f)
                }
                .UpSet => {
                    up := us(regs[usize(cur.code.env_reg)]).to_ptr(^Frame) else break
                    l := usize(i.a)
                    if up.mem.ptr[l] is not 0 or up.info.addressed.ptr[l] { break }
                    stn((&up.store.ptr[us(up.info.offsets.ptr[l]) + usize(i.c)]).cast([^]u8), i.f, regs[usize(i.b)])
                }
                .LocalAddrH => {
                    v := regs[usize(i.c)]
                    if v is 0 { break }
                    regs[usize(i.a)] = v
                }
                .SliceMake => {
                    lo := regs[usize(i.c & 0xFFFF)]
                    hi := regs[usize(i.c >> 16)]
                    if i.f & 2 is not 0 { hi = hi +| 1 }
                    if lo > hi or (i.f & 1 is not 0 and hi > regs[usize(i.b) + 1]) { break }
                    pb := m.ptr_bytes.trunc(u8)
                    stn(fat(regs, usize(i.a)), pb, regs[usize(i.b)] +% lo *% u64(i.w))
                    stn(fat(regs, usize(i.a) + usize(pb)), pb, hi - lo)
                }
                .AlignChk => if regs[usize(i.a)] & u64(i.b) is not 0 { break }
                .MemGet => {
                    p := m.vm_view(regs[usize(i.b)] +% u64(i.c), u64(i.w), u64(1) << u64(i.f), false) else break
                    fat(regs, usize(i.a))[0..usize(i.w)].copy_from(p[0..usize(i.w)])
                }
                .MemPut => {
                    p := m.vm_view(regs[usize(i.a)] +% u64(i.c), u64(i.w), u64(1) << u64(i.f), true) else break
                    p[0..usize(i.w)].copy_from(fat(regs, usize(i.b))[0..usize(i.w)])
                }
                .CopySlot => {
                    k := usize(i.c)
                    fat(regs, usize(i.a))[0..k].copy_from(fat(regs, usize(i.b))[0..k])
                }
                .ZeroSlot => fat(regs, usize(i.a))[0..usize(i.b)].fill(0)
                .Mark => {
                    k := usize(i.a)
                    regs[k] = u64(m.scratch.cur)
                    regs[k + 1] = u64(m.scratch.top)
                    regs[k + 2] = u64(m.temps.items.len)
                }
                .Release => m.vm_release(regs, i.a)
                .Call => {
                    cur = m.vm_push(cur, bc_pc(bc, ip), i.a) else break
                    regs = cur.regs
                    bc = cur.code.bc.ptr
                    ip = bc
                    continue
                }
                .RetW => {
                    v := regs[usize(i.a)]
                    p := cur.prev else {
                        if cur.code.hidden.len is not 0 { m.vm_drop_locals(cur.code, regs) }
                        m.wr_word(cur.dst, v)
                        done = true
                        break
                    }
                    if cur.fr is null and cur.ret_reg is not NO_REG and cur.code.hidden.len is 0 {
                        // The common return: a word to the caller's register.
                        p.regs[usize(cur.ret_reg)] = v
                        m.vm_pop(cur)
                        p.pc +%= 1
                        cur = p
                    } else {
                        cur = try m.vm_ret(cur, true, v)
                    }
                    regs = cur.regs
                    bc = cur.code.bc.ptr
                    ip = bc_at(bc, cur.pc)
                    continue
                }
                .Ret, .RetSlot => {
                    if i.op is .RetSlot { cur.dst.copy_from(fat(regs, usize(i.a))[0..usize(i.b)]) }
                    if cur.prev is null {
                        if cur.code.hidden.len is not 0 { m.vm_drop_locals(cur.code, regs) }
                        done = true
                        break
                    }
                    cur = try m.vm_ret(cur, false, 0)
                    regs = cur.regs
                    bc = cur.code.bc.ptr
                    ip = bc_at(bc, cur.pc)
                    continue
                }
                .Free, .Framed => break
            }
            ip = bc_at(ip, 1)
        }
        if done { break }
        pc = bc_pc(bc, ip)
        // The instruction as compiled: every case of it, traps included. A flow it raises
        // goes to the loop it targets or leaves bodies (`vm_raise`).
        next: usize = 0
        if bc[pc].op is .Framed {
            fr := cur.fr else return !m.trap(source.DUMMY, "internal error: an instruction needs a frame")
            act := Act(fr: fr, cx: cur.cx)
            res := m.vm_framed(&act, cur.code, regs, pc, cur.dst)
            cur.cx = act.cx
            next = res else f => {
                cur = try m.vm_raise(cur, f)
                cur.pc
            }
        } else {
            next = m.vm_free(cur.cx, cur.code, regs, pc, cur.dst) else f => {
                cur = try m.vm_raise(cur, f)
                cur.pc
            }
        }
        if next is VM_RETURN {
            if cur.prev is null { break }
            cur = try m.vm_ret(cur, false, 0)
            next = cur.pc
        }
        regs = cur.regs
        bc = cur.code.bc.ptr
        ip = bc_at(bc, next)
    }
    // The body returns, its result in `ret`.
    if a.fr.defers.items.len is 0 and base.cx is a.cx { return () }
    return m.vm_return(Act(fr: a.fr, cx: base.cx), a.cx, ret)
}

/// Returns from the call of `r`, made in the loop, to its caller: the result is the word
/// `v` if `word`, else it is where the callee left it. A body with a frame runs its
/// deferred statements and ends its frame, as `enter` does. Returns the record of the body
/// that runs next, with the index of its next instruction in `pc` (a flow that the
/// deferred statements raise continues in the caller, `vm_raise`).
#noinline
vm_ret :: fn(m: ^Machine, r: ^CallRec, word: bool, v: u64) -> Flow!^CallRec needs Run {
    p := r.prev else return r
    if fr := r.fr {
        if word { m.wr_word(r.dst, v) }
        res: Flow!() = ()
        if fr.defers.items.len is not 0 or r.cx is not r.base_cx { res = m.vm_return(Act(fr: fr, cx: r.cx), r.base_cx, r.dst) }
        if m.temps.items.len > r.tm { m.kill_temps(r.tm) }
        m.end_frame(fr)
        m.vm_pop(r)
        res else g => {
            if .Trap(t) := g and m.mode is .Debug { t.trace.push(TraceCall(fn_id: r.f, span: p.code.ins[p.pc].call_span()))! }
            return m.vm_raise(p, g)
        }
        if r.ret_reg is not NO_REG { p.regs[usize(r.ret_reg)] = m.rd_word(r.dst) }
        p.pc += 1
        return p
    }
    if r.code.hidden.len is not 0 { m.vm_drop_locals(r.code, r.regs) }
    if word {
        if r.ret_reg is NO_REG { m.wr_word(r.dst, v) } else { p.regs[usize(r.ret_reg)] = v }
    } else if r.ret_reg is not NO_REG {
        p.regs[usize(r.ret_reg)] = m.rd_word(r.dst)
    }
    m.vm_pop(r)
    p.pc += 1
    return p
}

/// Where the flow `flow`, raised in the body of `start`, continues: at a loop of that
/// body or, leaving it as `enter` leaves a body (its deferred statements run, its frame
/// ends), in a caller whose call was made in the loop; a `return` ends the call of its
/// body. Returns the record of the body that runs next, with the index of its next
/// instruction in `pc`, or the flow if it leaves the body the loop was entered for. A
/// trap records the calls it leaves (Debug builds).
#noinline
vm_raise :: fn(m: ^Machine, start: ^CallRec, flow: Flow) -> Flow!^CallRec needs Run {
    r := start
    f := flow
    while true {
        if fr := r.fr {
            act := Act(fr: fr, cx: r.cx)
            res := m.vm_flow(&act, r.base_cx, r.code, r.regs, f)
            r.cx = act.cx
            pc := res else g => {
                f = g
                VM_RETURN
            }
            if pc is not VM_RETURN {
                r.pc = pc
                return r
            }
        }
        if r.code.hidden.len is not 0 { m.vm_drop_locals(r.code, r.regs) }
        p := r.prev else return !f
        returned := false
        if fr := r.fr {
            if .Return(frame, _) := f and frame is fr.id { returned = true }
            if m.temps.items.len > r.tm { m.kill_temps(r.tm) }
            m.end_frame(fr)
        }
        if not returned {
            if .Trap(t) := f and m.mode is .Debug { t.trace.push(TraceCall(fn_id: r.f, span: p.code.ins[p.pc].call_span()))! }
        }
        m.vm_pop(r)
        if returned {
            if r.ret_reg is not NO_REG { p.regs[usize(r.ret_reg)] = m.rd_word(r.dst) }
            p.pc += 1
            return p
        }
        r = p
    }
}

/// The registers of the constants of `code` (usually a few: copied a word at a time).
#inline
vm_consts :: fn(code: ^const Code, regs: [^]u64) {
    if code.consts.len > 0 {
        cr := us(code.regs_off / 8)
        cs := code.consts.ptr
        k: usize = 0
        while k < code.consts.len {
            regs[cr + k] = cs[k]
            k += 1
        }
    }
}

/// The bytes of a frame's storage from offset `o`.
#inline
fat :: fn(regs: [^]u64, o: usize) -> [^]u8 => (&regs.cast([^]u8)[o]).cast([^]u8)

/// The location of the call that instruction `i` makes.
call_span :: fn(i: ^const Ins) -> source.Span => match i^ {
    .Call(x) => x.node.span
    .Perform(x) => x.node.span
    .CallValue(x) => x.node.span
    _ => source.DUMMY
}

/// Starts the call at `pc` of `code` inside the machine's loop, if its callee is a body
/// the machine runs without a frame and the call is an ordinary one (outside fibers and
/// other threads, not too deep): the callee's storage and the record of the call are taken
/// from scratch memory and the arguments are written, and the callee becomes what is
/// running. Returns false if the call has to be made the general way (`vm_call`).
#noinline
vm_push :: fn(m: ^Machine, cur: ^CallRec, pc: usize, site: u32) -> ?^CallRec needs Alloc {
    if site is not NO_REG {
        s := &cur.code.sites.ptr[usize(site)]
        if s.state is 0 { m.vm_site(cur.code, pc, s) }
        if s.state is 1 {
            if n := m.vm_push_site(cur, pc, s, cur.cx) { return n }
        } else if s.state is 3 {
            cx := cur.cx
            if s.cx is not cx or s.gen is not m.ctxs.items.ptr[us(cx)].gen { m.vm_perform_site(cur.code, pc, s, cx) }
            if s.callee is not null {
                if n := m.vm_push_site(cur, pc, s, s.callee_cx) { return n }
            }
        }
    }
    return m.vm_push_rec(cur, pc)
}

/// Works out the site `s` of the direct call or perform at `pc` of `code`.
vm_site :: fn(m: ^Machine, code: ^const Code, pc: usize, s: ^CallSite) needs Alloc {
    s.state = 2
    match code.ins.ptr[pc] {
        .Call(x) => {
            info := m.fn_info(x.f)
            callee := info.vm else return ()
            if callee.env_reg is not NO_REG or not m.site_fill(s, x.f, info, callee, 0, x.args, x.dst, x.node) { return () }
            s.state = 1
        }
        .Perform(_) => {
            // Worked out for each context it runs in.
            s.state = 3
            s.callee = null
            s.gen = 0
        }
        _ => {}
    }
}

/// Works out the site `s` of the perform at `pc` of `code` for context `cx`: the common
/// call (`s.callee` not `null`) if the clause of the handler runs without a frame. The
/// clause is most often the same as before, in a new context. A perform whose handler is
/// of another kind is made the general way from then on (`vm_push_rec`).
vm_perform_site :: fn(m: ^Machine, code: ^const Code, pc: usize, s: ^CallSite, cx: u32) needs Alloc {
    s.cx = cx
    s.gen = m.ctxs.items[us(cx)].gen
    .Perform(x) := code.ins.ptr[pc] else return ()
    .Perform(p) := x.node.op else return ()
    k := m.find_ctx(cx, &p.effect_)
    f := NO_REG
    if k is not 0 and not m.p.is_ctl(p.effect_.eff, p.op) {
        node := &m.ctxs.items[us(k)]
        match node.installed {
            .Lit(h, ?env, lcx) => {
                f = m.p.handler_lit(h).clauses[us(p.op)]
                s.env = env
                s.callee_cx = lcx
                s.self_ = null
            }
            .Decl(decls, value, outer) => for d in decls {
                info := m.p.handler_decl(d)
                if info.effect_.eff is not node.effect_.eff or types.cmp_ref(&info.effect_, &node.effect_) is not 0 { continue }
                f = info.clauses[us(p.op)]
                s.env = null
                s.callee_cx = outer
                s.self_ = value
                break
            }
            .Native(_) => {}
        }
    }
    if f is not NO_REG {
        if s.callee is not null and s.f is f { return () }
        info := m.fn_info(f)
        if callee := info.vm and m.site_fill(s, f, info, callee, if s.self_ is null { 0 } else { 1 }, x.args, x.dst, x.node) { return () }
    }
    s.callee = null
    s.state = 2
}

/// Fills in the site `s` for a call of `f` (`info`, compiled to `callee`) with arguments
/// `args` after `first` (0 or 1) for the handler value, whose result goes to `dst`: false if the call is not the common one (its body
/// needs a frame or one too big, or the result is too big for the record).
site_fill :: fn(m: ^Machine, s: ^CallSite, f: u32, info: ^FnInfo, callee: ^Code, first: usize, args: []Arg, dst: Dest, n: ^Node) -> bool needs Alloc {
    if not callee.frameless or args.len + first is not info.params.len or info.cost > sema.MAX_FRAME { return false }
    match dst {
        .Reg(rr) => {
            s.out_kind = 0
            s.ret_reg = rr
        }
        .None => {
            if n.size > 8 { return false }
            s.out_kind = 0
            s.ret_reg = NO_REG
        }
        .Slot(at) => {
            s.out_kind = 1
            s.out_at = at
            s.ret_reg = NO_REG
        }
        .Ret => {
            s.out_kind = 2
            s.ret_reg = NO_REG
        }
    }
    if first is 1 { s.self_off = info.offsets[us(info.params[0])].trunc(u32) }
    moves := list(Move)
    for i in 0..args.len {
        p := usize(info.params[i + first])
        off := info.offsets[p].trunc(u32)
        match args[i] {
            .Reg(r) => {
                // A word parameter kept in the frame's storage is a register there.
                if m.word_locals and not info.addressed[p] and info.sizes[p] > 0 {
                    moves.push(Move(kind: 0, src: r, dst: off / 8, size: 8))!
                } else {
                    moves.push(Move(kind: 2, src: r, dst: off, size: info.sizes[p].trunc(u32)))!
                }
            }
            .Slot(at, size) => moves.push(Move(kind: 1, src: at, dst: off, size: size))!
        }
    }
    if s.moves.len > 0 { free(s.moves) }
    s.moves = moves.items
    s.f = f
    s.out_size = n.size.trunc(u32)
    s.callee = callee
    s.frame_size = us(info.frame_size)
    return true
}

/// `vm_push` for the common call that `s` describes, its body running in context `cx`:
/// `null` if it cannot be made now (on a fiber, with other threads, too deep, or without
/// room in the scratch chunk).
#inline
vm_push_site :: fn(m: ^Machine, cur: ^CallRec, pc: usize, s: ^const CallSite, cx: u32) -> ?^CallRec {
    if m.depth >= MAX_DEPTH or m.fiber_stack is not ~u64(0) or m.threads.list.items.len > 1 { return null }
    callee := s.callee else return null
    sc := &m.scratch
    chunk := sc.chunks.items.ptr[sc.cur]
    base := chunk.ptr.addr()
    top := ((base +% sc.top +% 7) & ~us(7)) -% base
    head := (@size_of(CallRec) + 7) / 8 * 8
    if top +% head +% s.frame_size > chunk.len { return null }
    b := (&chunk.ptr[top]).cast([^]u8)
    n := b.cast(^CallRec)
    frame := (&b[head]).cast([^]u64)
    fat(frame, 0)[0..s.frame_size].fill(0)
    if v := s.self_ { fat(frame, usize(s.self_off))[0..v.len].copy_from(v) }
    regs := cur.regs
    k: usize = 0
    while k < s.moves.len {
        mv := &s.moves.ptr[k]
        if mv.kind is 0 {
            frame[usize(mv.dst)] = regs[usize(mv.src)]
        } else if mv.kind is 1 {
            fat(frame, usize(mv.dst))[0..usize(mv.size)].copy_from(fat(regs, usize(mv.src))[0..usize(mv.size)])
        } else {
            m.wr_word(fat(frame, usize(mv.dst))[0..usize(mv.size)], regs[usize(mv.src)])
        }
        k +%= 1
    }
    n.prev = cur
    n.code = callee
    n.regs = frame
    n.fr = null
    n.cx = cx
    n.base_cx = cx
    n.pc = 0
    n.f = s.f
    n.ret_reg = s.ret_reg
    n.buf = [8]u8(fill: 0)
    n.mark = Mark(cur: sc.cur, top: sc.top)
    n.tm = m.temps.items.len
    n.dst = if s.out_kind is 0 { n.buf[0..usize(s.out_size)] } else if s.out_kind is 1 { fat(regs, usize(s.out_at))[0..usize(s.out_size)] } else { cur.dst }
    sc.top = top +% head +% s.frame_size
    vm_consts(callee, frame)
    if e := s.env and callee.env_reg is not NO_REG { frame[usize(callee.env_reg)] = u64(e.addr()) }
    m.depth +%= 1
    cur.pc = pc
    return n
}

/// `vm_push` for the call at `pc` of the body of `cur`, whatever it calls (`null` if it
/// is not made in the loop).
vm_push_rec :: fn(m: ^Machine, cur: ^CallRec, pc: usize) -> ?^CallRec needs Alloc {
    cx := cur.cx
    match cur.code.ins.ptr[pc] {
        .Call(x) => return m.vm_push_fn(cur, pc, x.f, null, cx, null, false, null, x.args, x.dst, x.node)
        // An operation that is not `ctl`: the clause of a handler literal runs in the
        // frame and context where the literal was written, that of a handler declaration
        // gets the handler's value first, in the context outside its `with`.
        .Perform(x) => {
            .Perform(p) := x.node.op else return null
            k := m.find_ctx(cx, &p.effect_)
            if k is 0 or m.p.is_ctl(p.effect_.eff, p.op) { return null }
            node := &m.ctxs.items[us(k)]
            installing: ?(frame: ^Frame, label: u32) = null
            if fr := node.with_fr { installing = (frame: fr, label: node.with_label) }
            match node.installed {
                .Lit(h, ?env, lcx) => return m.vm_push_fn(cur, pc, m.p.handler_lit(h).clauses[us(p.op)], env, lcx, installing, true, null, x.args, x.dst, x.node)
                .Decl(decls, value, outer) => for d in decls {
                    info := m.p.handler_decl(d)
                    if info.effect_.eff is not node.effect_.eff or types.cmp_ref(&info.effect_, &node.effect_) is not 0 { continue }
                    return m.vm_push_fn(cur, pc, info.clauses[us(p.op)], null, outer, installing, false, value, x.args, x.dst, x.node)
                }
                .Native(_) => {}
            }
            return null
        }
        // A function pointer, or a function value whose type lists no effect to handle at
        // the call.
        .CallValue(x) => {
            cv := fat(cur.regs, usize(x.at))[0..us(x.callee.size)]
            if .Fn(sig) := m.kind(x.callee.ty) {
                if sig.effects.effects.len is not 0 { return null }
                f := m.fn_from_addr(m.word(cv, 0)) else return null
                return m.vm_push_fn(cur, pc, f, m.frame_of(m.word(cv, 1)), m.word(cv, 2).trunc(u32), null, false, null, x.args, x.dst, x.node)
            }
            f := m.fn_from_addr(m.ptr_of(cv)) else return null
            return m.vm_push_fn(cur, pc, f, null, cx, null, false, null, x.args, x.dst, x.node)
        }
        _ => return null
    }
}

/// `vm_push` for a call of `f`, capturing `env`, in context `callee_cx` (a clause of the
/// `with` `installing` if any), with the arguments `args` after the handler value `self_`
/// for a clause of a handler declaration; its result (the value of `n`) goes to `to`. A
/// body that needs a frame gets it here, as `enter` gives it.
vm_push_fn :: fn(m: ^Machine, cur: ^CallRec, pc: usize, f: u32, env: ?^Frame, callee_cx: u32, installing: ?(frame: ^Frame, label: u32), is_clause_lit: bool, self_: ?[]u8, args: []Arg, to: Dest, n: ^Node) -> ?^CallRec needs Alloc {
    info := m.fn_info(f)
    callee := info.vm else return null
    first: usize = if self_ is null { 0 } else { 1 }
    if args.len + first is not info.params.len or info.cost > sema.MAX_FRAME or m.depth >= MAX_DEPTH or m.fiber_stack is not ~u64(0) or m.threads.list.items.len > 1 { return null }
    regs := cur.regs
    mk := m.mark()
    // The storage stays aligned to 8 bytes after the record.
    head := (@size_of(CallRec) + 7) / 8 * 8
    b := m.tmp(u64(head) + info.frame_size)
    r := b.ptr.cast(^CallRec)
    store := b[head..b.len]
    if v := self_ {
        off := us(info.offsets[us(info.params[0])])
        store[off..off + v.len].copy_from(v)
    }
    m.vm_put_args(info, first, args, regs, store)
    r.prev = cur
    r.code = callee
    r.regs = (&b[head]).cast([^]u64)
    r.fr = null
    r.cx = callee_cx
    r.base_cx = callee_cx
    r.pc = 0
    r.f = f
    r.mark = mk
    r.tm = m.temps.items.len
    if e := env and callee.env_reg is not NO_REG { r.regs[usize(callee.env_reg)] = u64(e.addr()) }
    r.ret_reg = NO_REG
    size := us(n.size)
    match to {
        .Reg(rr) => {
            r.ret_reg = rr
            r.dst = r.buf[0..size]
        }
        .None => { r.dst = if size <= 8 { r.buf[0..size] } else { m.tmp(n.size) } }
        .Slot(at) => { r.dst = fat(regs, usize(at))[0..size] }
        .Ret => { r.dst = cur.dst }
    }
    if not callee.frameless {
        fr := m.new_frame(f, info, r.dst, env, store)
        fr.installing = installing
        fr.is_clause_lit = is_clause_lit
        // Parameters whose address is taken move to memory of their own.
        if info.addressed_params {
            for p in info.params {
                if info.addressed[us(p)] {
                    _ = m.local_addr(n.span, fr, p) else _ => {
                        // The call made the general way reports it.
                        m.end_frame(fr)
                        m.release(mk)
                        return null
                    }
                }
            }
        }
        r.fr = fr
    }
    vm_consts(callee, r.regs)
    m.depth += 1
    cur.pc = pc
    return r
}

/// Ends the memory of the locals of a body without a frame (`Code.hidden`), whose
/// registers are `regs`.
#noinline
vm_drop_locals :: fn(m: ^Machine, code: ^const Code, regs: [^]u64) needs Alloc {
    for h in code.hidden {
        if h is not NO_REG and regs[usize(h)] is not 0 {
            _ = m.mem.kill(regs[usize(h)])
            regs[usize(h)] = 0
        }
    }
}

/// The address of local `l` of a body without a frame, whose address is taken: its
/// memory is made on first use, with what the local holds in the storage.
vm_hidden_addr :: fn(m: ^Machine, code: ^const Code, regs: [^]u64, l: u32, span: source.Span) -> Flow!u64 needs Alloc {
    h := usize(code.hidden[usize(l)])
    if regs[h] is not 0 { return regs[h] }
    i := usize(l)
    info := code.info
    addr := try m.alloc_mem(span, info.sizes[i], info.aligns[i], .Stack, true)
    _ = m.mem.init(addr, fat(regs, us(info.offsets[i]))[0..us(info.sizes[i])])
    regs[h] = addr
    return addr
}

/// Ends the call of `r`: releases its record and storage.
#inline
vm_pop :: fn(m: ^Machine, r: ^const CallRec) {
    m.scratch.cur = r.mark.cur
    m.scratch.top = r.mark.top
    m.depth -%= 1
}

/// Runs the instruction at `pc` of `code` from its `Ins`, for one that needs no frame:
/// returns the index of the instruction to run next. `cx` is the handler context and `dst`
/// the body's result.
#noinline
vm_free :: fn(m: ^Machine, cx: u32, code: ^Code, regs: [^]u64, pc: usize, dst: []u8) -> Flow!usize needs Run {
    match code.ins.ptr[pc] {
        .Const(r, v) => { regs[usize(r)] = v }
        .Arith64(op, signed, wrap, r, ra, rb, n) => {
            p := regs[usize(ra)]
            q := regs[usize(rb)]
            regs[usize(r)] = arith64(op, signed, wrap, p, q) else try m.int_word(arith_op(op, false), IntW(signed: signed, bits: 64), IntW(signed: signed, bits: 64), p, q, n)
        }
        .Arith32(op, signed, wrap, bits, r, ra, rb, n) => {
            p := regs[usize(ra)]
            q := regs[usize(rb)]
            regs[usize(r)] = arith32(op, signed, wrap, bits, p, q) else try m.int_word(arith_op(op, false), IntW(signed: signed, bits: bits), IntW(signed: signed, bits: bits), p, q, n)
        }
        .LocalAtD(r, at, d, size) => { regs[usize(r)] = st_rd(m, regs, usize(at) + us(regs[usize(d)]), size) }
        .SetLocalAtD(at, d, size, v) => st_wr(m, regs, usize(at) + us(regs[usize(d)]), size, regs[usize(v)])
        .ScaleIdx(ri, len, esz, n) => {
            i := regs[usize(ri)]
            if i >= len { return !m.bounds_trap(n, i, len) }
            regs[usize(ri)] = i * esz
        }
        .AddR(r, x) => { regs[usize(r)] +%= regs[usize(x)] }
        .Bit(op, r, ra, rb) => {
            p := regs[usize(ra)]
            q := regs[usize(rb)]
            regs[usize(r)] = if op is 0 { p & q } else if op is 1 { p | q } else { p ~ q }
        }
        .Shr(t, shift, r, ra, rb, n) => {
            p := regs[usize(ra)]
            q := regs[usize(rb)]
            regs[usize(r)] = shr_fast(t, shift, p, q) else try m.int_word(.Shr, t, shift, p, q, n)
        }
        .Shl(t, shift, wrap, r, ra, rb, n) => {
            p := regs[usize(ra)]
            q := regs[usize(rb)]
            regs[usize(r)] = shl_fast(t, shift, wrap, p, q) else try m.int_word(.Shl(if wrap { ast.Flavor.Wrap } else { .Checked }), t, shift, p, q, n)
        }
        .JCmp(op, how, ra, rb, to) => if not word_less(op, how, regs[usize(ra)], regs[usize(rb)]) { return usize(to) }
        .JEq(how, negated, ra, rb, to) => if word_eq(how, regs[usize(ra)], regs[usize(rb)]) is negated { return usize(to) }
        .IntOp(x) => { regs[usize(x.r)] = try m.int_word(x.op, x.t, x.shift, regs[usize(x.a)], regs[usize(x.b)], x.n) }
        .LocalAt(r, at, size) => { regs[usize(r)] = st_rd(m, regs, usize(at), size) }
        .SetLocalAt(at, size, v) => st_wr(m, regs, usize(at), size, regs[usize(v)])
        .Load(r, base, off, size, align, n) => {
            addr := regs[usize(base)] +% u64(off)
            b := m.mem.read(addr, u64(size), u64(align)) else e => return !m.mem_trap(n.span, e)
            regs[usize(r)] = m.rd_word(b)
        }
        .Store(x) => {
            addr := regs[usize(x.base)] +% u64(x.off)
            b := m.mem.write_view(addr, u64(x.size), u64(x.align)) else e => return !m.mem_trap(x.n.span, e)
            m.wr_word(b, regs[usize(x.v)])
        }
        .SliceIdx(x) => {
            i := regs[usize(x.i)]
            len := regs[usize(x.len)]
            if i >= len { return !m.bounds_trap(x.n, i, len) }
            k := usize(x.p)
            regs[k] = regs[k] +% i * x.esz
        }
        .SliceLd(x) => {
            i := regs[usize(x.i)]
            len := regs[usize(x.len)]
            if i >= len { return !m.bounds_trap(x.n, i, len) }
            b := m.mem.read(regs[usize(x.p)] +% i * x.esz, u64(x.size), u64(x.align)) else e => return !m.mem_trap(x.n.span, e)
            regs[usize(x.r)] = m.rd_word(b)
        }
        .SliceSt(x) => {
            i := regs[usize(x.i)]
            len := regs[usize(x.len)]
            if i >= len { return !m.bounds_trap(x.n, i, len) }
            b := m.mem.write_view(regs[usize(x.p)] +% i * x.esz, u64(x.size), u64(x.align)) else e => return !m.mem_trap(x.n.span, e)
            m.wr_word(b, regs[usize(x.v)])
        }
        .ArrIdx(x) => {
            i := regs[usize(x.i)]
            if i >= x.len { return !m.bounds_trap(x.n, i, x.len) }
            k := usize(x.p)
            regs[k] = regs[k] +% i * x.esz
        }
        .PtrIdx(x) => {
            k := usize(x.p)
            regs[k] = regs[k] +% regs[usize(x.i)] *% x.esz
        }
        .AddK(r, k) => { regs[usize(r)] +%= k }
        .Cmp(op, how, r, ra, rb) => { regs[usize(r)] = if word_less(op, how, regs[usize(ra)], regs[usize(rb)]) { 1 } else { 0 } }
        .EqW(x) => { regs[usize(x.r)] = if word_eq(x.how, regs[usize(x.a)], regs[usize(x.b)]) is not x.negated { 1 } else { 0 } }
        .Not(r, x) => { regs[usize(r)] = if regs[usize(x)] is 0 { 1 } else { 0 } }
        .Bool(r) => { regs[usize(r)] = if regs[usize(r)] is 0 { 0 } else { 1 } }
        .IntConv(x) => { regs[usize(x.r)] = conv_word(x.op, x.from, x.to, regs[usize(x.a)]) }
        .IntBit(x) => { regs[usize(x.r)] = bit_word(x.op, x.t, regs[usize(x.a)], regs[usize(x.b)]) }
        .FloatOp(x) => { regs[usize(x.r)] = float_op(x.op, x.wide, regs[usize(x.a)], regs[usize(x.b)]) }
        .IntUn(x) => { regs[usize(x.r)] = try m.int_un(x.op, x.t, regs[usize(x.a)], x.n) }
        .Jmp(to) => return usize(to)
        .Jz(r, to) => if regs[usize(r)] is 0 { return usize(to) }
        .Jnz(r, to) => if regs[usize(r)] is not 0 { return usize(to) }
        .Mov(r, x) => { regs[usize(r)] = regs[usize(x)] }
        .Loop(to) => {
            if m.threads.list.items.len > 1 { try m.tick(source.DUMMY) }
            return usize(to)
        }
        .SliceMake(x) => {
            lo := regs[usize(x.lo)]
            hi := regs[usize(x.hi)]
            if x.inclusive { hi = hi +| 1 }
            if lo > hi or (x.has_len and hi > regs[usize(x.len)]) { return !m.slice_trap(x.n, lo, hi, if x.has_len { regs[usize(x.len)] } else { null }) }
            o := usize(x.at)
            pb := us(m.ptr_bytes)
            st_wr(m, regs, o, pb.trunc(u32), regs[usize(x.p)] +% lo * x.esz)
            st_wr(m, regs, o + pb, pb.trunc(u32), hi - lo)
        }
        .ConstSlot(at, b) => fat(regs, usize(at))[0..b.len].copy_from(b)
        _ => return m.vm_free_other(cx, code, regs, pc, dst)
    }
    return pc + 1
}

/// `vm_free` for the calls and the instructions on slots.
#noinline
vm_free_other :: fn(m: ^Machine, cx: u32, code: ^Code, regs: [^]u64, pc: usize, dst: []u8) -> Flow!usize needs Run {
    match code.ins.ptr[pc] {
        .Call(x) => try m.vm_call(cx, code, x.f, x.args, x.dst, x.node, regs, dst)
        .CallValue(x) => try m.vm_call_value(cx, code, x.at, x.callee, x.args, x.dst, x.node, regs, dst)
        .Perform(x) => try m.vm_perform(cx, code, x.args, x.dst, x.node, regs, dst)
        .CopySlot(d, src, size) => {
            k := usize(size)
            fat(regs, usize(d))[0..k].copy_from(fat(regs, usize(src))[0..k])
        }
        .SlotW(r, at, size) => { regs[usize(r)] = st_rd(m, regs, usize(at), size) }
        .WSlot(at, size, r) => st_wr(m, regs, usize(at), size, regs[usize(r)])
        .JSlot(at, size, nonzero, to) => if (st_rd(m, regs, usize(at), size) is not 0) is nonzero { return usize(to) }
        .JTag(at, size, v, to) => if st_rd(m, regs, usize(at), size) is not v { return usize(to) }
        .Builtin(x) => try m.vm_builtin(x.args, x.dst, x.node, regs, dst)
        .StrSlot(at, n) => {
            pb := us(m.ptr_bytes)
            match n.op {
                .Str(bytes) => m.put_slice(fat(regs, usize(at))[0..2 * pb], try m.string_literal(n.span, bytes, false), u64(bytes.len))
                .CStr(bytes) => m.put_ptr(fat(regs, usize(at))[0..pb], try m.string_literal(n.span, bytes, true))
                _ => {}
            }
        }
        .UpvarAt(x) => { regs[usize(x.r)] = try m.vm_upvar_at(us(regs[usize(code.env_reg)]).to_ptr(^Frame), x.levels, x.local, x.rel, x.size, x.align, x.n) }
        .SetUpvarAt(x) => try m.vm_set_upvar_at(us(regs[usize(code.env_reg)]).to_ptr(^Frame), x.levels, x.local, x.rel, x.size, x.align, regs[usize(x.v)], x.n)
        // The locals in memory of a body without a frame (`Code.hidden`).
        .LocalAddr(r, local, n) => { regs[usize(r)] = try m.vm_hidden_addr(code, regs, local, n.span) }
        .Local(r, local, _, size) => {
            addr := try m.vm_hidden_addr(code, regs, local, source.DUMMY)
            regs[usize(r)] = try m.load_word(source.DUMMY, addr, code.info.aligns[usize(local)], u64(size))
        }
        .SetLocal(x) => {
            addr := try m.vm_hidden_addr(code, regs, x.local, x.n.span)
            b: [8]u8 = ---
            d := b[0..usize(x.size)]
            m.wr_word(d, regs[usize(x.r)])
            try m.store_at(x.n.span, addr, code.info.aligns[usize(x.local)], d)
        }
        .SetLocalSlot(x) => {
            addr := try m.vm_hidden_addr(code, regs, x.local, x.span)
            try m.store_at(x.span, addr, code.info.aligns[usize(x.local)], fat(regs, usize(x.at))[0..usize(x.size)])
        }
        .MemGet(x) => {
            b := m.mem.read(regs[usize(x.base)] +% u64(x.off), u64(x.size), u64(x.align)) else e => return !m.mem_trap(x.n.span, e)
            fat(regs, usize(x.at))[0..usize(x.size)].copy_from(b)
        }
        .MemPut(x) => {
            b := m.mem.write_view(regs[usize(x.base)] +% u64(x.off), u64(x.size), u64(x.align)) else e => return !m.mem_trap(x.n.span, e)
            b.copy_from(fat(regs, usize(x.at))[0..usize(x.size)])
        }
        .AlignCheck(r, align, n) => {
            addr := regs[usize(r)]
            if addr is not 0 and addr % align is not 0 { return !m.trap(n.span, str.format("misaligned pointer cast: address {:#x} is not aligned to {} bytes", addr, align)!) }
        }
        .UnwrapTrap(at, ty, is_result, n) => {
            if not is_result { return !m.trap(n.span, "unwrap of null") }
            out := list(u8)
            m.format_value(&out, m.res_types(ty).err, m.res_payload(ty, fat(regs, usize(at))[0..us(m.size(ty))]), false) else {}
            return !m.trap(n.span, str.format("unwrap of error value {}", out.items)!)
        }
        .AssertFail(at, has_msg, n) => {
            if not has_msg { return !m.trap(n.span, "assertion failed") }
            msg := try m.read_string(n.span, fat(regs, usize(at))[0..2 * us(m.ptr_bytes)])
            if msg is "assertion failed" { return !m.trap(n.span, msg) }
            return !m.trap(n.span, str.format("assertion failed: {}", msg)!)
        }
        .NoArm(n) => return !m.trap(n.span, "no match arm matched the scrutinee")
        .Mark(r) => {
            k := usize(r)
            regs[k] = u64(m.scratch.cur)
            regs[k + 1] = u64(m.scratch.top)
            regs[k + 2] = u64(m.temps.items.len)
        }
        .Release(r) => m.vm_release(regs, r)
        .ZeroSlot(at, size) => fat(regs, usize(at))[0..usize(size)].fill(0)
        _ => {}
    }
    return pc + 1
}

/// Runs the instruction at `pc` of `code` from its `Ins`, for one that needs the frame of
/// `act` (its locals in memory, the frames it captures, its deferred statements, its
/// handler context, or the tree evaluator): returns the index of the instruction to run
/// next, or `VM_RETURN` when the body returned (`dst` is its result).
#noinline
vm_framed :: fn(m: ^Machine, act: ^Act, code: ^Code, regs: [^]u64, pc: usize, dst: []u8) -> Flow!usize needs Run {
    fr := act.fr
    a := act^
    match code.ins.ptr[pc] {
        .Local(r, local, off, size) => {
            i := usize(local)
            if fr.mem[i] is not 0 {
                regs[usize(r)] = try m.load_word(source.DUMMY, fr.mem[i], fr.info.aligns[i], u64(size))
            } else {
                regs[usize(r)] = st_rd(m, regs, usize(off), size)
            }
        }
        .SetLocal(x) => {
            i := usize(x.local)
            v := regs[usize(x.r)]
            if in_store(fr, i) {
                st_wr(m, regs, usize(x.off), x.size, v)
            } else {
                b: [8]u8 = ---
                d := b[0..usize(x.size)]
                m.wr_word(d, v)
                try m.set_local(x.n.span, fr, x.local, d)
            }
        }
        .LocalAddr(r, local, n) => { regs[usize(r)] = try m.local_addr(n.span, fr, local) }
        .EvalW(r, n) => { regs[usize(r)] = try m.ew(a, n) }
        .EvalSlot(off, n) => {
            o := usize(off)
            try m.ev(a, n, fr.store[o..o + us(n.size)])
        }
        .Discard(n) => try m.ev_discard(a, n)
        .Stmt(st) => try m.exec_stmt(a, st)
        .RetEval(n) => {
            try m.ev(a, n, dst)
            return VM_RETURN
        }
        .DeferHeight(r) => { regs[usize(r)] = u64(fr.defers.items.len) }
        .Defer(is_err, body) => fr.defers.push(Deferred(is_err: is_err, body: body, cx: a.cx))!
        .Unwind(r) => try m.vm_unwind(a, us(regs[usize(r)]), false)
        .AssignW(place, value) => try m.assign_word(a, place, value)
        .Pat(x) => {
            o := usize(x.off)
            ok := try m.match_pat(a, x.pat, fr.store[o..o + usize(x.size)])
            if not ok { return usize(x.fail) }
        }
        .SetLocalSlot(x) => {
            o := usize(x.at)
            try m.set_local(x.span, fr, x.local, fr.store[o..o + usize(x.size)])
        }
        .CxSave(r) => { regs[usize(r)] = u64(act.cx) }
        .CxRestore(r) => m.vm_cx_restore(act, regs, r)
        .WithDecl(x) => { act.cx = m.vm_with_decl(fr, act.cx, x.decls, x.at, x.size, x.label) }
        .WithLit(id, at, label) => {
            inst := Installed.Lit(id, fr, a.cx)
            if at is not NO_REG {
                o := usize(at)
                hb := fr.store[o..o + us(2 * m.ptr_bytes)]
                inst = .Lit(id, m.frame_of(m.word(hb, 0)), m.word(hb, 1).trunc(u32))
            }
            act.cx = m.push_ctx(a.cx, m.p.handler_lit(id).effect_, inst, fr.id, label, fr)
        }
        _ => {}
    }
    return pc + 1
}

/// The word of `size` bytes at offset `o` of the storage whose registers are `regs`.
#inline
st_rd :: fn(m: ^const Machine, regs: [^]u64, o: usize, size: u32) -> u64 => m.rd_word(fat(regs, o)[0..usize(size)])

/// Writes the word `v` to the `size` bytes at offset `o` of the storage.
#inline
st_wr :: fn(m: ^const Machine, regs: [^]u64, o: usize, size: u32, v: u64) { m.wr_word(fat(regs, o)[0..usize(size)], v) }

/// Whether local `i` of `fr` is in the frame's storage (not in memory of its own).
#inline
in_store :: fn(fr: ^const Frame, i: usize) -> bool => fr.mem[i] is 0 and not fr.info.addressed[i]

/// `+`, `-` or `*` (`op` 0, 1, 2) of 64-bit integer words, wrapping or checked: `null` if
/// it overflows.
#inline
arith64 :: fn(op: u8, signed: bool, wrap: bool, p, q: u64) -> ?u64 {
    if wrap { return if op is 0 { p +% q } else if op is 1 { p -% q } else { p *% q } }
    if signed {
        x := p.bits(i64)
        y := q.bits(i64)
        v := if op is 0 { x +? y } else if op is 1 { x -? y } else { x *? y }
        w := v else return null
        return w.bits(u64)
    }
    return if op is 0 { p +? q } else if op is 1 { p -? q } else { p *? q }
}

/// The same for integers of `bits` (at most 32) bits, whose sum or product fits in 64.
#inline
arith32 :: fn(op: u8, signed: bool, wrap: bool, bits: u32, p, q: u64) -> ?u64 {
    mask := mask64(bits)
    if signed {
        x := sext(p, bits)
        y := sext(q, bits)
        v := if op is 0 { x +% y } else if op is 1 { x -% y } else { x *% y }
        // In range if it is its own low bits, sign-extended.
        if not wrap and sext(v.bits(u64), bits) is not v { return null }
        return v.bits(u64) & mask
    }
    v := if op is 0 { p +% q } else if op is 1 { p -% q } else { p *% q }
    if not wrap and (if op is 1 { p < q } else { v > mask }) { return null }
    return v & mask
}

/// `>>` of integer words whose shift amount is in range (`null` if not).
#inline
shr_fast :: fn(t: IntW, shift: IntW, p, q: u64) -> ?u64 {
    if q >= u64(t.bits) or (shift.signed and sext(q, shift.bits) < 0) { return null }
    return if t.signed { (sext(p, t.bits) >> q.trunc(u32)).bits(u64) & mask64(t.bits) } else { p >> q.trunc(u32) }
}

/// `<<` of integer words, checked (`null` if it overflows) or wrapping; `null` if the shift
/// amount is out of range.
#inline
shl_fast :: fn(t: IntW, shift: IntW, wrap: bool, p, q: u64) -> ?u64 {
    if q >= u64(t.bits) or (shift.signed and sext(q, shift.bits) < 0) { return null }
    mask := mask64(t.bits)
    low := (p <<% q) & mask
    if not t.signed {
        if not wrap and (low >> q) is not p { return null }
        return low
    }
    w := sext(low, t.bits)
    if not wrap and (w >> q.trunc(u32)) is not sext(p, t.bits) { return null }
    return low
}

/// An integer word converted to another integer type (`int_conv`), its common cases inline.
#inline
conv_word :: fn(op: tir.Builtin, from: IntW, to: IntW, v: u64) -> u64 {
    if op is .Sat { return int_conv(op, from, to, v) }
    x := if from.signed { sext(v, from.bits).bits(u64) } else { v }
    return x & mask64(to.bits)
}

/// The trap of a slice from `lo` to `hi` of something of length `len`, out of bounds.
#noinline
slice_trap :: fn(m: ^Machine, n: ^Node, lo: u64, hi: u64, len: ?u64) -> Flow needs Alloc {
    text := if l := len { str.format("{}", l)! } else { "?" }
    return m.trap(n.span, str.format("slice bounds {}..{} invalid for length {}", lo, hi, text)!)
}

/// The trap of an index `i` out of bounds for `len`.
#noinline
bounds_trap :: fn(m: ^Machine, n: ^Node, i: u64, len: u64) -> Flow needs Alloc => m.trap(n.span, str.format("index {} out of bounds for length {}", i, len)!)

/// Releases scratch memory and temporaries to the mark in registers `r..r + 3`.
#inline
vm_release :: fn(m: ^Machine, regs: [^]u64, r: u32) needs Alloc {
    k := usize(r)
    m.scratch.cur = us(regs[k])
    m.scratch.top = us(regs[k + 1])
    tm := us(regs[k + 2])
    if m.temps.items.len > tm { m.kill_temps(tm) }
}

/// Where a flow raised while running `code` continues: a `break` or `continue` to one of
/// its loops jumps there (the exit releases to the iteration's mark and leaves the loop);
/// any other flow leaves the body, running the deferred statements.
vm_flow :: fn(m: ^Machine, act: ^Act, base: u32, code: ^Code, regs: [^]u64, f: Flow) -> Flow!usize needs Run {
    fr := act.fr
    match f {
        .Break(frame, label), .Continue(frame, label) => {
            if frame is fr.id {
                for lp in code.loops {
                    if lp.label is label {
                        if lp.defers is not NO_DEFERS { try m.vm_unwind(act^, us(regs[usize(lp.defers)]), false) }
                        if lp.cx is not NO_CX { m.vm_cx_restore(act, regs, lp.cx) }
                        return usize(if f is .Break(_) { lp.brk } else { lp.cont })
                    }
                }
            }
        }
        .Trap(_) => {
            m.vm_cx_leave(act, base)
            return !f
        }
        _ => {}
    }
    if fr.defers.items.len > 0 { try m.vm_unwind(act^, 0, errdefers_run(fr, f)) }
    m.vm_cx_leave(act, base)
    return !f
}

/// Installs the handler declarations `decls` in context `cx` for the value of `size` bytes
/// in the slot at `at` of `fr`, for the `with` of `label`; returns the new context.
vm_with_decl :: fn(m: ^Machine, fr: ^Frame, cx: u32, decls: []const u32, at: u32, size: u32, label: u32) -> u32 needs Alloc {
    o := usize(at)
    value := fr.store[o..o + usize(size)]
    c := cx
    for d in decls { c = m.push_ctx(c, m.p.handler_decl(d).effect_, .Decl(decls, value, cx), fr.id, label, fr) }
    return c
}

/// Goes back to the handler context in register `r` (`CxSave`), uninstalling the handlers
/// installed since.
vm_cx_restore :: fn(m: ^Machine, act: ^Act, regs: [^]u64, r: u32) needs Alloc => m.vm_cx_leave(act, regs[usize(r)].trunc(u32))

/// Uninstalls the handlers installed since context `cx`, which becomes the current one.
vm_cx_leave :: fn(m: ^Machine, act: ^Act, cx: u32) needs Alloc {
    if act.cx is cx { return () }
    m.pop_ctx(act.cx, cx)
    act.cx = cx
}

/// Returns from a body whose result is in `dst`, running the deferred statements (the
/// errdefers too if the result is an error), then uninstalling the handlers installed
/// since the body's context `base`.
vm_return :: fn(m: ^Machine, a: Act, base: u32, dst: []u8) -> Flow!() needs Run {
    fr := a.fr
    if fr.defers.items.len > 0 {
        is_err := if o := fr.info.err_flag { dst[us(o)] is not 0 } else { false }
        r := m.vm_unwind(a, 0, is_err)
        if a.cx is not base { m.pop_ctx(a.cx, base) }
        return r
    }
    if a.cx is not base { m.pop_ctx(a.cx, base) }
}

/// Runs the deferred statements of `a`'s frame above `height`, last first (the errdefers
/// only if `run_err`), each in the context it was pushed in, and drops them.
vm_unwind :: fn(m: ^Machine, a: Act, height: usize, run_err: bool) -> Flow!() needs Run {
    fr := a.fr
    while fr.defers.items.len > height {
        d := fr.defers.pop() else break
        if d.is_err and not run_err { continue }
        tm := m.temps.items.len
        mk := m.mark()
        r := m.ev_discard(Act(fr: fr, cx: d.cx), d.body)
        m.kill_temps(tm)
        m.release(mk)
        r else f => {
            if f is .Trap(_) { return !f }
            return !m.trap(d.body.span, "internal error: control flow escaped a deferred statement")
        }
    }
}

/// A call of `f` with the arguments `args`; its result goes to `dst` (`ret` is the
/// function's own result). The common call, of a body the machine runs whose parameters
/// all stay in its frame's storage, outside fibers and other threads, is made here, doing
/// what `vm_invoke` and `enter` do for it; any other goes through them.
vm_call :: fn(m: ^Machine, cx: u32, caller: ^const Code, f: u32, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run {
    info := m.fn_info(f)
    marker: u8 = 0
    code := info.vm else return m.vm_invoke(caller, f, null, cx, null, false, null, args, dst, n, regs, ret)
    if info.addressed_params or args.len is not info.params.len or info.cost > sema.MAX_FRAME or m.depth >= MAX_DEPTH or (&marker).addr() < m.stack_floor or m.fiber_stack is not ~u64(0) or m.threads.list.items.len > 1 {
        return m.vm_invoke(caller, f, null, cx, null, false, null, args, dst, n, regs, ret)
    }
    mk := m.mark()
    store := m.tmp(info.frame_size)
    // The arguments are read before the result's register is cleared: it may hold one.
    m.vm_put_args(info, 0, args, regs, store)
    b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
    direct := m.vm_direct(caller, dst, regs)
    d := m.vm_dest(dst, direct, n, regs, ret, b[..])
    tm := m.temps.items.len
    callee := m.new_frame(f, info, d, null, store)
    m.depth += 1
    r := m.vm_run(Act(fr: callee, cx: cx), code, d)
    m.depth -= 1
    if m.temps.items.len > tm { m.kill_temps(tm) }
    id := callee.id
    m.end_frame(callee)
    m.release(mk)
    r else fl => {
        if .Return(frame, _) := fl and frame is id {} else {
            if .Trap(t) := fl and m.mode is .Debug { t.trace.push(TraceCall(fn_id: f, span: n.span))! }
            return !fl
        }
    }
    if .Reg(rr) := dst and not direct { regs[usize(rr)] = m.rd_word(d) }
}

/// Writes the arguments `args` of a call (in registers and slots of the frame whose
/// registers are `regs`) to the storage `store` of the callee `info` describes, as its
/// parameters from the `first` on.
#inline
vm_put_args :: fn(m: ^Machine, info: ^FnInfo, first: usize, args: []Arg, regs: [^]u64, store: []u8) {
    // Not `enumerate`: an iterator costs a call per element.
    i: usize = 0
    while i < args.len {
        p := usize(info.params[first + i])
        off := us(info.offsets[p])
        match args[i] {
            .Reg(r) => {
                // A word parameter kept in the frame's storage is a register there.
                if m.word_locals and not info.addressed[p] and info.sizes[p] > 0 {
                    store.ptr.cast([^]u64)[off / 8] = regs[usize(r)]
                } else {
                    m.wr_word(store[off..off + us(info.sizes[p])], regs[usize(r)])
                }
            }
            .Slot(at, size) => {
                k := usize(size)
                store[off..off + k].copy_from(fat(regs, usize(at))[0..k])
            }
        }
        i += 1
    }
}

/// Whether a call's result going to `dst` is written straight to its register: a
/// temporary register, which is a word of the frame's storage after its locals (it is
/// zeroed first, so the call's arguments must have been read: the first may be in it).
#inline
vm_direct :: fn(m: ^const Machine, caller: ^const Code, dst: Dest, regs: [^]u64) -> bool {
    if .Reg(r) := dst and m.word_locals and u64(r) * 8 >= caller.locals_size {
        regs[usize(r)] = 0
        return true
    }
    return false
}

/// Where the callee of a call (of node `n`) writes a result going to `dst`: its register
/// if `direct`, else `b` for a word, a slot, the function's result `ret`, or scratch memory.
#inline
vm_dest :: fn(m: ^Machine, dst: Dest, direct: bool, n: ^Node, regs: [^]u64, ret: []u8, b: []u8) -> []u8 needs Alloc => match dst {
    .Reg(r) => if direct { fat(regs, usize(r) * 8)[0..us(n.size)] } else { b[0..us(n.size)] }
    .None => if n.size <= 8 { b[0..us(n.size)] } else { m.tmp(n.size) }
    .Slot(at) => fat(regs, usize(at))[0..us(n.size)]
    .Ret => ret
}

/// A call of the function value in the slot at `at`, of type `callee.ty` (a second-class
/// function or a function pointer), as `call_value` makes it.
vm_call_value :: fn(m: ^Machine, cx: u32, caller: ^const Code, at: u32, callee: ^Node, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run {
    cv := fat(regs, usize(at))[0..us(callee.size)]
    if .Fn(sig) := m.kind(callee.ty) {
        f := m.fn_from_addr(m.word(cv, 0)) else return !m.trap(n.span, "internal error: a function value without code")
        env := m.frame_of(m.word(cv, 1))
        ctx := m.word(cv, 2).trunc(u32)
        // Effects listed in the function type are handled where it is called (§11.6).
        base := ctx
        for eff in sig.effects.effects {
            k := m.find_ctx(cx, &eff)
            if k is 0 { continue }
            node := m.ctxs.items[us(k)]
            ctx = m.push_ctx(ctx, node.effect_, node.installed, node.with_frame, node.with_label, node.with_fr)
        }
        r := m.vm_invoke(caller, f, env, ctx, null, false, null, args, dst, n, regs, ret)
        m.pop_ctx(ctx, base)
        return r
    }
    addr := m.ptr_of(cv)
    if addr is 0 { return !m.trap(n.span, "call through a null function pointer") }
    f := m.fn_from_addr(addr) else return !m.trap(n.span, str.format("call through an invalid function pointer {:#x}", addr)!)
    return m.vm_invoke(caller, f, null, cx, null, false, null, args, dst, n, regs, ret)
}

/// Performs the operation of `n` (a `Perform`) with the arguments `args`, as `perform`
/// does: the clause of a handler literal or declaration is called as a function is, and
/// other handlers get the argument values as bytes.
vm_perform :: fn(m: ^Machine, cx: u32, caller: ^const Code, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run {
    x := match n.op {
        .Perform(x) => x
        _ => return !m.trap(n.span, "internal error: not an operation")
    }
    k := m.find_ctx(cx, &x.effect_)
    if k is 0 { return !m.trap(n.span, str.format("no handler installed for effect `{}`", m.s.tys.effect_name(x.effect_.eff))!) }
    if not m.p.is_ctl(x.effect_.eff, x.op) {
        node := &m.ctxs.items[us(k)]
        installing: ?(frame: ^Frame, label: u32) = null
        if fr := node.with_fr { installing = (frame: fr, label: node.with_label) }
        match node.installed {
            .Lit(h, ?env, lcx) => return m.vm_invoke(caller, m.p.handler_lit(h).clauses[us(x.op)], env, lcx, installing, true, null, args, dst, n, regs, ret)
            .Decl(decls, value, outer) => for d in decls {
                info := m.p.handler_decl(d)
                if info.effect_.eff is not node.effect_.eff or types.cmp_ref(&info.effect_, &node.effect_) is not 0 { continue }
                return m.vm_invoke(caller, info.clauses[us(x.op)], null, outer, installing, false, value, args, dst, n, regs, ret)
            }
            .Native(_) => {}
        }
    }
    mk := m.mark()
    base := m.argv.items.len
    i: usize = 0
    while i < args.len {
        match args[i] {
            .Reg(r) => {
                b := m.tmp(x.args[i].size)
                m.wr_word(b, regs[usize(r)])
                m.argv.push(b)!
            }
            .Slot(at, size) => m.argv.push(fat(regs, usize(at))[0..usize(size)])!
        }
        i += 1
    }
    b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
    d := match dst {
        .Reg(_) => b[0..us(n.size)]
        .None => if n.size <= 8 { b[0..us(n.size)] } else { m.tmp(n.size) }
        .Slot(at) => fat(regs, usize(at))[0..us(n.size)]
        .Ret => ret
    }
    res := m.perform(cx, n.span, &x.effect_, x.op, m.argv.items[base..m.argv.items.len], d)
    m.argv.truncate(base)
    m.release(mk)
    try res
    if .Reg(r) := dst { regs[usize(r)] = m.rd_word(d) }
}

/// The builtin operation of `n` (`vc_builtin_ok`) with the arguments `args` in registers
/// and slots, as `ev_builtin` does it with their values; its result goes to `dst` (`ret` is
/// the body's own result).
vm_builtin :: fn(m: ^Machine, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run {
    .Builtin(op, xs) := n.op else return !m.trap(n.span, "internal error: not a builtin")
    mk := m.mark()
    vs := [MAX_BUILTIN_ARGS][]u8(fill: empty_slice(u8))
    i: usize = 0
    while i < args.len {
        match args[i] {
            .Reg(r) => {
                b := m.tmp(xs[i].size)
                m.wr_word(b, regs[usize(r)])
                vs[i] = b
            }
            .Slot(at, size) => { vs[i] = fat(regs, usize(at))[0..usize(size)] }
        }
        i += 1
    }
    b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
    d := match dst {
        .Reg(_) => b[0..us(n.size)]
        .None => if n.size <= 8 { b[0..us(n.size)] } else { m.tmp(n.size) }
        .Slot(at) => fat(regs, usize(at))[0..us(n.size)]
        .Ret => ret
    }
    vals := vs[0..args.len]
    match op {
        .HeapAlloc, .HeapFree, .AllocTag, .AllocCheck, .CopyElems, .AtomicLoad, .AtomicStore, .AtomicSwap, .AtomicCas, .AtomicRmw(_), .VolatileLoad, .VolatileStore, .Fence, .CstrLen, .VecLoad, .VecStore => try m.memory_builtin(n.span, op, xs, vals, n.ty, d)
        _ => {
            t0 := if xs.len > 0 { xs[0].ty } else { n.ty }
            t1 := if xs.len > 1 { xs[1].ty } else { t0 }
            try m.apply_builtin(n.span, op, n.ty, t0, t1, vals, d)
        }
    }
    m.release(mk)
    if .Reg(r) := dst { regs[usize(r)] = m.rd_word(d) }
}

/// The most arguments of a builtin operation that the machine runs (`vm_builtin`).
MAX_BUILTIN_ARGS: usize : 6

/// Calls `f` (capturing `env`, in context `cx`, a clause of the `with` `installing` if any)
/// with the arguments `args` of the body `caller`, after the handler
/// value `self_` for a clause of a handler declaration; its result goes to `dst` (`ret` is
/// the caller's own result).
vm_invoke :: fn(m: ^Machine, caller: ^const Code, f: u32, env: ?^Frame, cx: u32, installing: ?(frame: ^Frame, label: u32), is_clause_lit: bool, self_: ?[]u8, args: []Arg, dst: Dest, n: ^Node, regs: [^]u64, ret: []u8) -> Flow!() needs Run {
    info := m.fn_info(f)
    body := info.body else return m.call_missing(n.span, f)
    first: usize = if self_ is null { 0 } else { 1 }
    if args.len + first is not info.params.len { return !m.trap(n.span, str.format("internal error: `{}` called with {} arguments, expected {}", m.func(f).name, args.len + first, info.params.len)!) }
    if info.cost > sema.MAX_FRAME { return !m.trap(n.span, str.format("stack overflow: `{}` needs a frame of {} bytes", m.func(f).name, info.cost)!) }
    mk := m.mark()
    store := m.tmp(info.frame_size)
    if v := self_ {
        off := us(info.offsets[us(info.params[0])])
        store[off..off + v.len].copy_from(v)
    }
    // The arguments are read before the result's register is cleared: it may hold one.
    m.vm_put_args(info, first, args, regs, store)
    b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
    direct := m.vm_direct(caller, dst, regs)
    d := m.vm_dest(dst, direct, n, regs, ret, b[..])
    res := m.enter(n.span, f, info, body, store, env, cx, installing, is_clause_lit, d)
    m.release(mk)
    try res
    if .Reg(r) := dst and not direct { regs[usize(r)] = m.rd_word(d) }
}

/// The word at offset `rel` of local `l` of the frame `levels` capture links up from `fr`.
vm_upvar_at :: fn(m: ^Machine, env: ?^Frame, levels: u32, l: u32, rel: u32, size: u32, align: u32, n: ^Node) -> Flow!u64 needs Alloc {
    e := env else return !m.trap(n.span, "internal error: upvar without an enclosing frame")
    up := frame_up(e, levels - 1) else return !m.trap(n.span, "internal error: upvar without an enclosing frame")
    i := usize(l)
    if up.mem[i] is 0 and not up.info.addressed[i] {
        o := us(up.info.offsets[i]) + usize(rel)
        return m.rd_word(up.store[o..o + usize(size)])
    }
    return m.vm_local_at(up, l, u64(rel), size, align, n)
}

vm_set_upvar_at :: fn(m: ^Machine, env: ?^Frame, levels: u32, l: u32, rel: u32, size: u32, align: u32, v: u64, n: ^Node) -> Flow!() needs Alloc {
    e := env else return !m.trap(n.span, "internal error: upvar without an enclosing frame")
    up := frame_up(e, levels - 1) else return !m.trap(n.span, "internal error: upvar without an enclosing frame")
    i := usize(l)
    if up.mem[i] is 0 and not up.info.addressed[i] {
        o := us(up.info.offsets[i]) + usize(rel)
        m.wr_word(up.store[o..o + usize(size)], v)
        return ()
    }
    return m.vm_set_local_at(up, l, u64(rel), size, align, v, n)
}

/// The word at offset `rel` of local `l` of `fr`, which is or must be in memory.
vm_local_at :: fn(m: ^Machine, fr: ^Frame, l: u32, rel: u64, size: u32, align: u32, n: ^Node) -> Flow!u64 needs Alloc {
    addr := try m.local_addr(n.span, fr, l)
    return m.load_word(n.span, addr + rel, u64(align), u64(size))
}

vm_set_local_at :: fn(m: ^Machine, fr: ^Frame, l: u32, rel: u64, size: u32, align: u32, v: u64, n: ^Node) -> Flow!() needs Alloc {
    addr := try m.local_addr(n.span, fr, l)
    b := m.mem.write_view(addr + rel, u64(size), u64(align)) else e => return !m.mem_trap(n.span, e)
    m.wr_word(b, v)
}

/// `place = value` for a word value.
assign_word :: fn(m: ^Machine, a: Act, place: ^Node, value: ^Node) -> Flow!() needs Run {
    p := try m.place(a, place, false)
    v := try m.ew(a, value)
    b: [8]u8 = ---
    d := b[0..us(value.size)]
    m.wr_word(d, v)
    return m.write_place(place.span, p, place.ty, d)
}
