// Conversions, coercions of plain data and the builtin methods and intrinsics that work on
// values (mirrors `src/interp/builtins.rs`).

ast :: import "../ast"

/// Applies a coercion of plain data to the bytes `b` of a value of type `from`, giving a
/// value of type `to` in `dst`.
coerce_bytes :: fn(m: ^Machine, span: source.Span, kind: tir.Coercion, from, to: Ty, b: []u8, dst: []u8) -> Flow!() needs Alloc {
    match kind {
        .IntWiden => {
            if info := m.int_info(to) {
                m.put_uint(dst, num_ext(info.signed, info.bits, m.get_int(from, b)))
            } else {
                m.put_uint(dst, m.get_int(from, b))
            }
        }
        .FloatWiden => {
            if not (m.kind(from) is .Float(_)) or not (m.kind(to) is .Float(_)) { return !m.trap(span, "internal error: float widening of non-floats") }
            m.put_float(to, m.get_float(from, b), dst)
        }
        .WrapOptional => m.make_some(to, dst, b)
        .WrapOk => m.make_res(to, dst, false, b)
        .LiftErr(variant) => {
            if m.res_is_err(from, b) {
                derr := m.res_types(to).err
                lifted := m.tmp(m.size(derr))
                m.make_variant(derr, lifted, variant, m.res_payload(from, b))
                m.make_res(to, dst, true, lifted)
            } else {
                m.make_res(to, dst, false, m.res_payload(from, b))
            }
        }
        .ArrayPtrToSlice => m.array_ptr_to_slice(from, b, dst)
        .InOptional => {
            if not m.opt_present(from, b) {
                dst.fill(0)
                return ()
            }
            src_in := m.opt_inner(from)
            dst_in := m.opt_inner(to)
            payload := m.opt_payload(from, b)
            if .Ptr(_, pointee) := m.kind(src_in) and m.kind(dst_in) is .Slice(_, _) and m.kind(pointee) is .Array(_, _, _) {
                sl := m.tmp(m.size(dst_in))
                m.array_ptr_to_slice(src_in, payload, sl)
                m.make_some(to, dst, sl)
            } else {
                m.make_some(to, dst, payload)
            }
        }
        .PtrToPtr, .TupleRename, .FnPtrWiden => dst.copy_from(b)
        .FromNever, .FnToPtr, .Unresolved => return !m.trap(span, "internal error: unresolved coercion reached the interpreter")
    }
}

/// The slice of the whole array that the pointer `b` of type `ptr_ty` points to.
array_ptr_to_slice :: fn(m: ^Machine, ptr_ty: Ty, b: []const u8, dst: []u8) needs Alloc {
    len: u64 = 0
    if .Ptr(_, pointee) := m.kind(ptr_ty) and .Array(n, _, _) := m.kind(pointee) { len = n }
    m.put_slice(dst, m.ptr_of(b), len)
}

// ---------------------------------------------------------------------------------
// Conversions
// ---------------------------------------------------------------------------------

/// `Convert`, `Trunc`, `Round`, `Floor`, `Ceil`, `Checked` and `Sat`: the value `b` of type
/// `src_ty` converted to `dst_ty` (the optional of the target for `Checked`).
convert :: fn(m: ^Machine, span: source.Span, op: tir.Builtin, src_ty, dst_ty: Ty, b: []const u8, dst: []u8) -> Flow!() needs Alloc {
    target := if op is .Checked { m.opt_inner(dst_ty) } else { dst_ty }
    is_float := false
    sv := NumVal(neg: false, mag: 0)
    fv: f64 = 0.0
    match m.kind(src_ty) {
        .Int(_, _), .Usize, .Isize => {
            info := m.int_info(src_ty)?
            sv = num_val(info.signed, m.get_int(src_ty, b))
        }
        .Float(_) => {
            is_float = true
            fv = m.get_float(src_ty, b)
        }
        .Bool => { sv.mag = if b[0] is 0 { 0 } else { 1 } }
        .Adt(_, _) => {
            if u := m.union_def(src_ty) {
                info := m.int_info(u.tag)?
                sv = num_val(info.signed, m.get_int(u.tag, b[0..us(m.size(u.tag))]))
            } else if u := m.bits_struct_ty(src_ty) {
                info := m.int_info(u)?
                sv = NumVal(neg: false, mag: m.get_uint(b[0..us(m.size(u))]) & num_mask(info.bits))
            } else {
                return !m.trap(span, str.format("cannot convert from {}", m.s.show(src_ty))!)
            }
        }
        _ => return !m.trap(span, str.format("cannot convert from {}", m.s.show(src_ty))!)
    }
    if tinfo := m.int_info(target) {
        signed := tinfo.signed
        bits := tinfo.bits
        if not is_float {
            if op is .Checked {
                if num_fits(sv, signed, bits) {
                    pb: [16]u8 = ---
                    n := us(m.size(target))
                    m.put_uint(pb[0..n], num_ext(signed, bits, num_bits(sv)))
                    m.make_some(dst_ty, dst, pb[0..n])
                } else {
                    dst.fill(0)
                }
            } else if op is .Sat {
                m.put_uint(dst, num_ext(signed, bits, num_bits(num_sat(sv, signed, bits))))
            } else {
                m.put_uint(dst, num_ext(signed, bits, num_bits(sv)))
            }
            return ()
        }
        finite := fv - fv is 0.0
        if op is .Checked {
            dst.fill(0)
            if not finite or not num_integral(fv) { return () }
            n := num_float_int(fv, .Trunc) else return ()
            if not num_fits(n, signed, bits) { return () }
            pb: [16]u8 = ---
            sz := us(m.size(target))
            m.put_uint(pb[0..sz], num_ext(signed, bits, num_bits(n)))
            m.make_some(dst_ty, dst, pb[0..sz])
            return ()
        }
        if op is .Sat {
            if num_is_nan(fv) {
                dst.fill(0)
                return ()
            }
            neg := (fv.bits(u64) >> 63) is 1
            n := NumVal(neg: neg, mag: ~u128(0))
            if finite { n = num_float_int(fv, .Trunc) else n }
            m.put_uint(dst, num_ext(signed, bits, num_bits(num_sat(n, signed, bits))))
            return ()
        }
        if finite {
            if n := num_float_int(fv, op) {
                if num_fits(n, signed, bits) {
                    m.put_uint(dst, num_ext(signed, bits, num_bits(n)))
                    return ()
                }
            }
        }
        if m.fast() {
            dst.fill(0)
            return ()
        }
        return !m.trap(span, "float to integer conversion out of range")
    }
    if .Float(w) := m.kind(target) {
        x := if is_float { num_round(fv, w) } else { num_int_to_float(sv, w) }
        m.put_float(target, x, dst)
        return ()
    }
    if u := m.bits_struct_ty(target) {
        if not is_float {
            info := m.int_info(u)?
            m.put_uint(dst, num_ext(false, info.bits, num_bits(sv)))
            return ()
        }
    }
    return !m.trap(span, str.format("unsupported conversion to {}", m.s.show(target))!)
}

// ---------------------------------------------------------------------------------
// Builtins
// ---------------------------------------------------------------------------------

/// The alignment a pointer of type `t` promises its pointee.
ptr_align :: fn(m: ^Machine, t: Ty) -> u64 needs Alloc {
    match m.kind(t) {
        .Ptr(_, p), .ManyPtr(_, p) => return if m.size(p) is 0 { 1 } else { m.align(p) }
        .Optional(inner) => return m.ptr_align(inner)
        _ => return 1
    }
}

/// Evaluates the arguments of the builtin `op` and applies it (not the ones `eval_builtin`
/// handles itself).
builtin :: fn(m: ^Machine, a: Act, op: tir.Builtin, args: []Expr, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    mk := m.mark()
    vals := list([]u8)
    defer vals.deinit()
    for i in 0..args.len {
        b := m.tmp(m.size(args[i].ty))
        try m.eval(a, &args[i], b)
        vals.push(b)!
    }
    t0 := if args.len > 0 { args[0].ty } else { e.ty }
    t1 := if args.len > 1 { args[1].ty } else { t0 }
    try m.apply_builtin(e.span, op, e.ty, t0, t1, vals.items, dst)
    m.release(mk)
}

/// The decimal text of the integer of type `t` in `b`.
int_text :: fn(m: ^Machine, t: Ty, b: []const u8) -> string needs Alloc {
    v := m.get_int(t, b)
    info := m.int_info(t) else return ""
    return if info.signed { str.format("{}", v.bits(i128))! } else { str.format("{}", v)! }
}

/// Applies the builtin `op` to the argument values `v`, the types of the first two being
/// `t0` and `t1`, giving a value of type `res_ty` in `dst`.
apply_builtin :: fn(m: ^Machine, span: source.Span, op: tir.Builtin, res_ty, t0, t1: Ty, v: [][]u8, dst: []u8) -> Flow!() needs Run {
    match op {
        .Convert, .Trunc, .Round, .Floor, .Ceil, .Checked, .Sat => return m.convert(span, op, t0, res_ty, v[0], dst)
        .Bits => {
            dst.fill(0)
            n := dst.len.min(v[0].len)
            dst[0..n].copy_from(v[0][0..n])
        }
        .Cast => {
            addr := m.ptr_of(v[0])
            al := m.ptr_align(res_ty)
            if addr is not 0 and al > 1 and addr % al is not 0 and not m.fast() {
                return !m.trap(span, str.format("misaligned pointer cast: address {:#x} is not aligned to {} bytes", addr, al)!)
            }
            dst.copy_from(v[0])
        }
        .Addr, .ToPtr, .BlackBox => dst.copy_from(v[0])
        .PtrAdd, .PtrSub, .PtrDiff => {
            .ManyPtr(_, elem) := m.kind(t0) else return !m.trap(span, "internal error: pointer arithmetic on a value that is not a many-pointer")
            stride := i128(m.size(elem))
            p := i128(m.ptr_of(v[0]))
            pbits := m.ptr_bytes * 8
            mask: u64 = if pbits >= 64 { ~u64(0) } else { (u64(1) << pbits) - 1 }
            if op is .PtrDiff {
                d := (p - i128(m.ptr_of(v[1]))).trunc(i64)
                q: i64 = if stride is 0 { 0 } else { d / stride.trunc(i64) }
                m.put_uint(dst, q.trunc(u128))
                return ()
            }
            info := m.int_info(t1) else return !m.trap(span, "internal error: pointer arithmetic by a value that is not an integer")
            raw := m.get_int(t1, v[1])
            n: i128 = 0
            if info.signed {
                n = raw.bits(i128)
            } else if raw <= (~u128(0) >> 1) {
                n = raw.bits(i128)
            }
            off := n *% stride
            r := if op is .PtrAdd { p +% off } else { p -% off }
            m.put_uint(dst, u128(r.trunc(u64) & mask))
        }
        .Tag => {
            u := m.union_def(t0) else return !m.trap(span, "tag() of a non-union")
            n := us(m.size(u.tag))
            dst.fill(0)
            dst[0..n].copy_from(v[0][0..n])
        }
        .FromTag => {
            u := m.opt_inner(res_ty)
            def := m.union_def(u) else return !m.trap(span, "from_tag on a non-union")
            info := m.int_info(t0) else return !m.trap(span, "from_tag of a value that is not an integer")
            x := num_val(info.signed, m.get_int(t0, v[0]))
            for i, d in enumerate(def.variants) {
                if d.payload is null and d.tag.negative is x.neg {
                    tb := tag_bits(d.tag)
                    mag := if d.tag.negative { 0 -% tb } else { tb }
                    if mag is x.mag {
                        mk := m.mark()
                        vb := m.tmp(m.size(u))
                        m.make_variant(u, vb, i.trunc(u32), empty_slice(u8))
                        m.make_some(res_ty, dst, vb)
                        m.release(mk)
                        return ()
                    }
                }
            }
            dst.fill(0)
        }
        .Min, .Max, .Clamp => {
            if .Float(_) := m.kind(t0) {
                x := m.get_float(t0, v[0])
                y := m.get_float(t0, v[1])
                r := match op {
                    .Min => num_fmin(x, y)
                    .Max => num_fmax(x, y)
                    _ => num_fmin(num_fmax(x, y), m.get_float(t0, v[2]))
                }
                m.put_float(t0, r, dst)
                return ()
            }
            info := m.int_info(t0) else return !m.trap(span, str.format("min/max/clamp on {}", m.s.show(t0))!)
            x := m.get_int(t0, v[0])
            y := m.get_int(t0, v[1])
            pick: usize = 0
            match op {
                .Min => { pick = if int_cmp(info.signed, x, y) <= 0 { 0 } else { 1 } }
                .Max => { pick = if int_cmp(info.signed, x, y) >= 0 { 0 } else { 1 } }
                _ => {
                    hi := m.get_int(t0, v[2])
                    if int_cmp(info.signed, x, y) < 0 {
                        pick = 1
                    } else if int_cmp(info.signed, x, hi) > 0 {
                        pick = 2
                    }
                }
            }
            dst.copy_from(v[pick])
        }
        .Abs => {
            if .Float(_) := m.kind(t0) {
                m.put_float(t0, (m.get_float(t0, v[0]).bits(u64) & 0x7FFF_FFFF_FFFF_FFFF).bits(f64), dst)
                return ()
            }
            info := m.int_info(t0) else return !m.trap(span, "internal error: `abs` of a value that is not a number")
            x := m.get_int(t0, v[0])
            if not info.signed or (x >> 127) is 0 {
                m.put_uint(dst, x)
                return ()
            }
            r := 0 -% x
            if r is (u128(1) << (info.bits - 1)) {
                if not m.fast() { return !m.trap(span, "integer overflow in `abs`") }
                m.put_uint(dst, x)
                return ()
            }
            m.put_uint(dst, r)
        }
        .AbsDiff => {
            info := m.int_info(t0) else return !m.trap(span, "internal error: `abs_diff` of a value that is not an integer")
            x := m.get_int(t0, v[0])
            y := m.get_int(t1, v[1])
            d: u128 = 0
            if int_cmp(info.signed, x, y) >= 0 {
                d = x -% y
            } else {
                d = y -% x
            }
            if r := m.int_info(res_ty) { d = num_ext(r.signed, r.bits, d) }
            m.put_uint(dst, d)
        }
        .Pow(fl) => return m.pow(span, fl, t0, res_ty, t1, v[0], v[1], dst)
        .IsNan, .IsInf, .IsFinite, .SignBit, .Sqrt => {
            if not (m.kind(t0) is .Float(_)) { return !m.trap(span, "float builtin on a non-float") }
            x := m.get_float(t0, v[0])
            raw := x.bits(u64)
            exp := (raw >> 52) & 0x7ff
            match op {
                .IsNan => { dst[0] = if exp is 0x7ff and (raw & 0xF_FFFF_FFFF_FFFF) is not 0 { 1 } else { 0 } }
                .IsInf => { dst[0] = if exp is 0x7ff and (raw & 0xF_FFFF_FFFF_FFFF) is 0 { 1 } else { 0 } }
                .IsFinite => { dst[0] = if exp is 0x7ff { 0 } else { 1 } }
                .SignBit => { dst[0] = if (raw >> 63) is 1 { 1 } else { 0 } }
                _ => m.put_float(t0, x.sqrt(), dst)
            }
        }
        .Fma => {
            .Float(w) := m.kind(t0) else return !m.trap(span, "fma on a non-float")
            x := m.get_float(t0, v[0])
            y := m.get_float(t0, v[1])
            z := m.get_float(t0, v[2])
            if w is 32 {
                m.put_float(t0, f64(@fma(x.to(f32), y.to(f32), z.to(f32))), dst)
            } else {
                m.put_float(t0, @fma(x, y, z), dst)
            }
        }
        .Rotl, .Rotr => {
            info := m.int_info(t0) else return !m.trap(span, "rotation of a non-integer")
            ainfo := m.int_info(t1) else return !m.trap(span, "rotation by a non-integer")
            n := info.bits
            x := m.get_uint(v[0][0..us(m.size(t0))]) & num_mask(n)
            araw := m.get_int(t1, v[1])
            k: u32 = 0
            if not (ainfo.signed and (araw >> 127) is 1) { k = (araw % u128(n)).trunc(u32) }
            if op is .Rotr { k = (n - k) % n }
            r := if k is 0 { x } else { ((x <<% u128(k)) | (x >> u128(n - k))) & num_mask(n) }
            m.put_uint(dst, num_ext(info.signed, n, r))
        }
        .Clz, .Ctz, .Popcount, .Bswap, .Bitreverse => {
            info := m.int_info(t0) else return !m.trap(span, "bit builtin on a non-integer")
            n := info.bits
            x := m.get_uint(v[0][0..us(m.size(t0))]) & num_mask(n)
            r: u128 = 0
            match op {
                .Clz => {
                    m.put_uint(dst, u128(@clz(x) - (128 - n)))
                    return ()
                }
                .Ctz => {
                    m.put_uint(dst, if x is 0 { u128(n) } else { u128(@ctz(x)) })
                    return ()
                }
                .Popcount => {
                    m.put_uint(dst, u128(@popcount(x)))
                    return ()
                }
                .Bswap => {
                    if n % 8 is not 0 { return !m.trap(span, str.format("bswap requires a whole number of bytes, not {} bits", n)!) }
                    for i in 0..n / 8 { r |= ((x >> u128(i * 8)) & 0xff) << u128((n / 8 - 1 - i) * 8) }
                }
                _ => {
                    for i in 0..n {
                        if (x >> u128(i)) & 1 is 1 { r |= u128(1) << u128(n - 1 - i) }
                    }
                }
            }
            m.put_uint(dst, num_ext(info.signed, n, r))
        }
        .Hash => {
            info := m.int_info(t1) else return !m.trap(span, "internal error: `@hash` seed that is not an integer")
            seed := num_val(info.signed, m.get_int(t1, v[1]))
            h := 0xcbf29ce484222325 ~ seed.mag.trunc(u64)
            try m.hash_val(span, t0, v[0], &h)
            m.put_uint(dst, u128(h))
        }
        .LaneEq, .LaneNe, .LaneLt, .LaneLe, .LaneGt, .LaneGe, .ReduceSum, .ReduceMin, .ReduceMax, .MaskAll, .MaskAny, .MaskCount, .Select, .LaneMin, .LaneMax, .LaneAbs, .LaneConvert, .Shuffle => return m.vector_builtin(span, op, res_ty, t0, t1, v, dst)
        _ => return !m.unsupported(span, str.format("the builtin `{}`", op)!)
    }
}

/// `-1`, `0` or `1` as the integer `x` is below, equal to or above `y` (sign-extended to 128
/// bits if `signed`).
int_cmp :: fn(signed: bool, x, y: u128) -> i32 {
    if signed {
        p := x.bits(i128)
        q := y.bits(i128)
        return if p < q { -1 } else if p > q { 1 } else { 0 }
    }
    return if x < y { -1 } else if x > y { 1 } else { 0 }
}

/// `base` raised to `n`, for `pow` and its flavors.
pow :: fn(m: ^Machine, span: source.Span, fl: ast.Flavor, t: Ty, res_ty, ety: Ty, bb, nb: []const u8, dst: []u8) -> Flow!() needs Alloc {
    info := m.int_info(t) else return !m.trap(span, "pow on a non-integer")
    signed := info.signed
    bits := info.bits
    base := m.get_int(t, bb)
    einfo := m.int_info(ety) else return !m.trap(span, "pow by a non-integer")
    nraw := m.get_int(ety, nb)
    n: u32 = 0
    if not (einfo.signed and (nraw >> 127) is 1) { n = nraw.min(u128(~u32(0))).trunc(u32) }
    bval := num_val(signed, base)
    mulop: tir.BinOp = .Mul(.Checked)
    // The exact power, or the side it overflows on.
    acc: u128 = 1
    over := false
    if n is 0 {
        acc = 1
    } else if bval.mag is 0 {
        acc = 0
    } else if bval.mag is 1 {
        acc = if bval.neg and n % 2 is 1 { 0 -% 1 } else { 1 }
    } else {
        for _ in 0..n {
            r := int_arith(mulop, signed, bits, acc, base)
            acc = r.low
            if r.over {
                over = true
                break
            }
        }
    }
    if not over {
        v := num_ext(signed, bits, acc)
        if fl is .Opt {
            pb: [16]u8 = ---
            sz := us(m.size(t))
            m.put_uint(pb[0..sz], v)
            m.make_some(res_ty, dst, pb[0..sz])
        } else {
            m.put_uint(dst, v)
        }
        return ()
    }
    match fl {
        .Opt => dst.fill(0)
        .Sat => m.put_uint(dst, sat_bits(signed, bits, bval.neg and n % 2 is 1))
        .Wrap => m.put_uint(dst, int_pow_wrapped(signed, bits, base, n))
        .Checked => {
            if not m.fast() { return !m.trap(span, str.format("integer overflow in `pow` ({}^{})", m.int_text(t, bb), n)!) }
            m.put_uint(dst, int_pow_wrapped(signed, bits, base, n))
        }
    }
}

/// `base` raised to `n`, modulo 2^bits.
int_pow_wrapped :: fn(signed: bool, bits: u32, base: u128, n: u32) -> u128 {
    mulop: tir.BinOp = .Mul(.Wrap)
    result: u128 = 1
    b := base
    k := n
    while k > 0 {
        if k & 1 is 1 { result = int_arith(mulop, signed, bits, result, b).low }
        b = int_arith(mulop, signed, bits, b, b).low
        k >>= 1
    }
    return num_ext(signed, bits, result)
}

// ---------------------------------------------------------------------------------
// Hashing
// ---------------------------------------------------------------------------------

/// Mixes `bytes` into the hash `h` (FNV-1a).
hash_mix :: fn(h: ^u64, bytes: []const u8) {
    for x in bytes { h^ = (h^ ~ u64(x)) *% 0x100000001b3 }
}

/// Mixes the little-endian bytes of `x` into `h`.
hash_u64 :: fn(h: ^u64, x: u64) {
    for i in 0..8 { h^ = (h^ ~ ((x >> u64(i * 8)) & 0xff)) *% 0x100000001b3 }
}

/// Mixes the shortest two's-complement little-endian bytes of the integer `x` into `h`.
hash_int :: fn(h: ^u64, x: NumVal) {
    buf: [17]u8 = ---
    low := num_bits(x)
    for i in 0..16 { buf[i] = (low >> u128(i * 8)).trunc(u8) }
    buf[16] = if x.neg { 0xff } else { 0 }
    n: usize = 17
    while n > 1 and buf[n - 1] is buf[16] and ((buf[n - 2] >> 7) is 1) is x.neg { n -= 1 }
    hash_mix(h, buf[0..n])
}

/// Mixes the value `b` of type `t` into `h`, consistently with `equal`.
hash_val :: fn(m: ^Machine, span: source.Span, t: Ty, b: []u8, h: ^u64) -> Flow!() needs Alloc {
    match m.kind(t) {
        .Int(_, _), .Usize, .Isize => {
            info := m.int_info(t)?
            hash_int(h, num_val(info.signed, m.get_int(t, b)))
        }
        .Float(_) => {
            x := m.get_float(t, b)
            if x is 0.0 { x = 0.0 }
            hash_u64(h, x.bits(u64))
        }
        .Bool => hash_u64_byte(h, if b[0] is 0 { 0 } else { 1 })
        .Ptr(_, _), .ManyPtr(_, _), .Rawptr, .FnPtr(_) => hash_u64(h, m.ptr_of(b))
        .Never => {}
        .Tuple(elems, _) => {
            for i in 0..elems.len { try m.hash_val(span, elems[i], m.field_bytes(t, b, i.trunc(u32)), h) }
        }
        .Array(n, elem, _) => {
            esz := us(m.size(elem))
            for i in 0..us(n) { try m.hash_val(span, elem, b[i * esz..(i + 1) * esz], h) }
        }
        .Slice(_, _) => {
            s := try m.seq_of(span, t, b)
            hash_u64(h, s.n)
            for i in 0..us(s.n) { try m.hash_val(span, s.elem, s.data[i * s.esz..(i + 1) * s.esz], h) }
        }
        .Optional(inner) => {
            if cgen.nullable_pointer(m.s, inner) {
                hash_u64(h, m.ptr_of(b))
            } else if m.opt_present(t, b) {
                hash_u64_byte(h, 1)
                try m.hash_val(span, inner, m.opt_payload(t, b), h)
            } else {
                hash_u64_byte(h, 0)
            }
        }
        .Result(err, ok) => {
            is_err := m.res_is_err(t, b)
            hash_u64_byte(h, if is_err { 1 } else { 0 })
            try m.hash_val(span, if is_err { err } else { ok }, m.res_payload(t, b), h)
        }
        .Adt(_, _) => {
            if u := m.bits_struct_ty(t) {
                try m.hash_val(span, u, b, h)
                return ()
            }
            if u := m.union_def(t) {
                vi := m.variant_index(t, b) else return !m.invalid_tag(span, t, b)
                hash_u64(h, u64(vi))
                if pt := u.variants[us(vi)].payload {
                    off := us(m.payload_offset(t))
                    try m.hash_val(span, pt, b[off..off + us(m.size(pt))], h)
                }
                return ()
            }
            a := m.adt_of(t) else return !m.trap(span, str.format("unknown type {}", m.s.show(t))!)
            .Struct(def) := a.kind else return !m.trap(span, str.format("{} cannot be hashed", m.s.show(t))!)
            for i in 0..def.fields.len {
                fl := m.field_layout(t, i.trunc(u32))
                off := us(fl.off)
                try m.hash_val(span, fl.ty, b[off..off + us(m.size(fl.ty))], h)
            }
        }
        _ => return !m.trap(span, str.format("{} cannot be hashed", m.s.show(t))!)
    }
}

/// Mixes the single byte `x` into `h`.
hash_u64_byte :: fn(h: ^u64, x: u8) {
    h^ = (h^ ~ u64(x)) *% 0x100000001b3
}
