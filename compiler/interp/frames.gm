// Functions and frames: per-function information, frame allocation and handles.

func :: fn(m: ^Machine, f: u32) -> ^const cgen.Func needs Alloc => m.p.func(f)

fn_addr :: fn(m: ^const Machine, f: u32) -> u64 => CODE_BASE + 16 * u64(f)

fn_from_addr :: fn(m: ^const Machine, addr: u64) -> ?u32 {
    if addr < CODE_BASE or (addr - CODE_BASE) % 16 is not 0 { return null }
    id := (addr - CODE_BASE) / 16
    if id >= u64(m.s.fns.items.len) { return null }
    return id.trunc(u32)
}

/// What the interpreter needs to know about function `f`.
#inline
fn_info :: fn(m: ^Machine, f: u32) -> ^FnInfo needs Alloc {
    i := us(f)
    if i < m.infos.items.len {
        if x := m.infos.items[i] { return x }
    }
    return m.make_fn_info(f)
}

/// The `FnInfo` of `f`, made on its first call: its body is lowered and compiled then.
#noinline
make_fn_info :: fn(m: ^Machine, f: u32) -> ^FnInfo needs Alloc {
    i := us(f)
    while m.infos.items.len <= i { m.infos.push(null)! }
    if x := m.infos.items[i] { return x }
    def := m.func(f)
    made := m.make_info(f, def.locals, def.body)
    made.cost = m.s.frame_cost(def.locals, def.body)
    made.params = def.params
    for p in def.params {
        if made.addressed[us(p)] { made.addressed_params = true }
    }
    if m.kind(def.ret) is .Result(_, _) { made.err_flag = m.offsets(def.ret)[0] }
    // Registered before its body is lowered.
    m.infos.items[i] = made
    made.frame_size = made.store_size
    if b := def.body {
        body := lower_body(m, made, b)
        made.body = body
        c := vm_compile(m, made, body)
        made.vm = c
        made.frame_size = c.size
    }
    return made
}

/// The layout of a frame with `locals`: each at an offset aligned for it, except that a
/// word (at most 8 bytes) whose address is never taken gets 8 aligned bytes of its own,
/// which the register machine uses as a register (`word_locals`).
make_info :: fn(m: ^Machine, f: u32, locals: []const tir.LocalDecl, body: ?^Expr) -> ^FnInfo needs Alloc {
    offs := list(u64)
    sizes := list(u64)
    aligns := list(u64)
    addressed := list(bool)
    for _ in locals { addressed.push(false)! }
    if b := body { mark_addressed(m, b, addressed.items) }
    mark_captured_addressed(m, f, 0, addressed.items)
    top: u64 = 0
    for i, l in enumerate(locals) {
        n := m.size(l.ty)
        a := m.align(l.ty).max(1).min(8)
        word := n > 0 and n <= 8 and not addressed.items[i]
        if word { a = 8 }
        top = (top + a - 1) / a * a
        offs.push(top)!
        sizes.push(n)!
        aligns.push(m.align(l.ty).max(1))!
        top += if word { 8 } else { n }
    }
    return new(FnInfo(offsets: offs.items, sizes: sizes.items, aligns: aligns.items, addressed: addressed.items, store_size: top, cost: 0))!
}

/// The frame with handle `h`.
frame_of :: fn(m: ^const Machine, h: u64) -> ?^Frame {
    if h is 0 or h > u64(m.frames.items.len) { return null }
    return m.frames.items[us(h - 1)]
}

/// A new frame for a call of `fn_id` (with `info`) whose result goes to `ret`, with its
/// locals in `store`.
#inline
new_frame :: fn(m: ^Machine, fn_id: u32, info: ^FnInfo, ret: []u8, env: ?^Frame, store: []u8) -> ^Frame needs Alloc {
    n := info.addressed.len
    // Finished frames are reused, with their buffers: a call allocates nothing then.
    fr := m.frame_pool else m.alloc_frame(info, ret)
    m.frame_pool = fr.next_free
    m.pooled -= 1
    if fr.mem_buf.len < n { m.grow_mem_buf(fr, n) }
    // A frame's addresses of locals are all 0 when it ends (`end_frame`).
    fr.mem = fr.mem_buf[0..n]
    fr.id = m.next_frame
    fr.fn_id = fn_id
    fr.info = info
    fr.ret = ret
    fr.env = env
    fr.store = store
    fr.installing = null
    fr.is_clause_lit = false
    m.next_frame += 1
    // A handle is given when a function value or handler value first captures the frame.
    fr.handle = 0
    return fr
}

/// A frame for `new_frame` when none is kept for reuse: it goes to the pool, which
/// `new_frame` takes it from.
#noinline
alloc_frame :: fn(m: ^Machine, info: ^FnInfo, ret: []u8) -> ^Frame needs Alloc {
    fr := new(Frame(id: 0, handle: 0, fn_id: 0, info: info, ret: ret, env: null, store: empty_slice(u8), mem: empty_slice(u64), mem_buf: empty_slice(u64), allocs: list(u64), labels: list(LabelDst), defers: list(Deferred), installing: null, is_clause_lit: false, next_free: null))!
    fr.next_free = m.frame_pool
    m.frame_pool = fr
    m.pooled += 1
    return fr
}

/// Gives `fr` room for the addresses of `n` locals.
#noinline
grow_mem_buf :: fn(m: ^Machine, fr: ^Frame, n: usize) needs Alloc {
    if fr.mem_buf.len > 0 { free(fr.mem_buf) }
    fr.mem_buf = make_fill(n.max(8), u64(0))!
}

/// The handle of frame `fr` (by which function and handler values refer to it), given now if
/// it has none yet.
frame_handle :: fn(m: ^Machine, fr: ^Frame) -> u32 needs Alloc {
    if fr.handle is not 0 { return fr.handle }
    if h := m.free_frames.pop() {
        m.frames.items[us(h)] = fr
        fr.handle = h + 1
    } else {
        m.frames.push(fr)!
        fr.handle = m.frames.items.len.trunc(u32)
    }
    return fr.handle
}

/// Ends frame `fr`: its allocations die and its handle is free again.
#inline
end_frame :: fn(m: ^Machine, fr: ^Frame) needs Alloc {
    if fr.allocs.items.len > 0 or fr.labels.items.len > 0 or fr.defers.items.len > 0 or fr.handle is not 0 or m.pooled >= 256 {
        m.end_frame_slow(fr)
        return ()
    }
    fr.next_free = m.frame_pool
    m.frame_pool = fr
    m.pooled += 1
}

/// `end_frame` for a frame with something to undo, or when the pool is full.
#noinline
end_frame_slow :: fn(m: ^Machine, fr: ^Frame) needs Alloc {
    if fr.allocs.items.len > 0 {
        for a in fr.allocs.items { _ = m.mem.kill(a) }
        fr.allocs.clear()
        fr.mem.fill(0)
    }
    if fr.labels.items.len > 0 { fr.labels.clear() }
    if fr.defers.items.len > 0 { fr.defers.clear() }
    if fr.handle is not 0 {
        m.frames.items[us(fr.handle - 1)] = null
        m.free_frames.push(fr.handle - 1)!
    }
    if m.pooled < 256 {
        fr.next_free = m.frame_pool
        m.frame_pool = fr
        m.pooled += 1
        return ()
    }
    fr.allocs.deinit()
    fr.labels.deinit()
    fr.defers.deinit()
    if fr.mem_buf.len > 0 { free(fr.mem_buf) }
    destroy(fr)
}

/// The frame `levels` capture links up from `fr`.
frame_up :: fn(fr: ^Frame, levels: u32) -> ?^Frame {
    cur := fr
    for _ in 0..levels { cur = cur.env else return null }
    return cur
}

/// The address of local `l` of frame `fr`, which needs one: made on first use.
#inline
local_addr :: fn(m: ^Machine, span: source.Span, fr: ^Frame, l: u32) -> Flow!u64 needs Alloc {
    i := us(l)
    if fr.mem[i] is not 0 { return fr.mem[i] }
    return m.local_alloc(span, fr, l)
}

/// Gives local `l` of frame `fr` memory of its own; returns its address.
#noinline
local_alloc :: fn(m: ^Machine, span: source.Span, fr: ^Frame, l: u32) -> Flow!u64 needs Alloc {
    i := us(l)
    addr := try m.alloc_mem(span, fr.info.sizes[i], fr.info.aligns[i], .Stack, true)
    // What the local held so far moves along.
    off := us(fr.info.offsets[i])
    _ = m.mem.init(addr, fr.store[off..off + us(fr.info.sizes[i])])
    fr.mem[i] = addr
    fr.allocs.push(addr)!
    return addr
}
