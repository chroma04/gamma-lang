//! The interpreter: runs a checked program.
//!
//! - **Code**: a function's body is lowered on its first call (`code.gm`) into nodes with
//!   sizes, offsets and word operations resolved, and compiled for a register machine
//!   (`vm.gm`) that runs its statement structure, word arithmetic, simple places and calls
//!   in one loop; the rest is evaluated by walking the nodes (`run.gm`, `stmt.gm`,
//!   `calls.gm`). Words are computed by `word.gm`, whose overflow and shift rules come from
//!   the byte arithmetic of `intarith.gm`.
//! - **Memory** (`memory.gm`): a flat virtual address space where every allocation gets
//!   a fresh, never reused address, so out-of-bounds, use-after-free, null, misaligned
//!   and read-only accesses are found exactly (§18.4). Values are bytes in the target's
//!   layout; pointers are addresses.
//! - **Values**: every expression is evaluated into a destination, a byte buffer of the
//!   size of its type. Temporary buffers come from a stack of scratch memory that each
//!   statement and call releases (`Scratch`). A local whose address is never taken lives
//!   in its frame's storage, in that scratch memory; the others get an allocation of
//!   their own. Second-class values are bytes too: a function value is its code address,
//!   the handle of the frame it captures and the handle of its handler context; a
//!   handler value is a frame handle and a context handle.
//! - **Control flow**: what leaves an expression other than with its value is a `Flow`
//!   error. A `break` writes its value into the destination of the loop or `with` it
//!   leaves, and a `return` into its function's, before the flow unwinds to them; blocks
//!   run their `defer` and `errdefer` statements on the way.
//! - **Effects**: the handler context is a persistent list of installed handlers, by
//!   handle, captured by closures and handler literals (§11.6, §12.7).
//!
//! It traps where the compiled program would, with the same messages, and reports
//! what it cannot run yet as an internal error.

bigint :: import "../bigint"
cgen :: import "../cgen"
hash_map :: import "std/collections/hash_map"
load :: import "../load"
sema :: import "../sema"
source :: import "../source"
str :: import "std/str"
tir :: import "../tir"
types :: import "../types"

Ty :: types.Ty
TyKind :: types.TyKind
Expr :: tir.Expr
Sema :: sema.Sema
Prog :: cgen.Prog

/// The effects of the system a program runs on.
pub Host :: Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys

/// The effects of evaluation: the host's, and switching between fibers (`fiber.gm`).
Run :: Host + Coro

/// The build mode (§1.4): checked operations trap except in `Fast` mode. The interpreter
/// checks every memory access in every mode, so `Safe` runs exactly as `Checked`.
pub Mode :: union { Debug, Checked, Safe, Fast }

/// A trap: its message, where it happened and, in Debug builds, the calls it left,
/// innermost first (each called function and the location of its call).
pub Trap :: struct {
    pub message: string
    pub span: source.Span
    pub trace: List(TraceCall)
}

pub TraceCall :: struct {
    pub fn_id: u32
    pub span: source.Span
}

/// How evaluation leaves an expression other than with its value. Frames are named by
/// their ids.
Flow :: union {
    /// A `break` to a loop or `with`; its value is already in the target's destination.
    Break: (frame: u64, label: u32)
    Continue: (frame: u64, label: u32)
    /// A `return`; its value is already in the function's destination.
    Return: (frame: u64, is_err: bool)
    /// `Env.exit`: unwinds every frame.
    Exit: u8
    Trap: ^Trap
    /// `resume k(v)` ends a `ctl` clause; the driver switches to the fiber.
    Resume: u32
    /// Unwinds a discarded fiber to its base (§14.5).
    Cancel
}

/// The activation code runs in: its frame and its handler context.
Act :: struct {
    fr: ^Frame
    cx: u32
}

/// Where a `break` to a label leaves its value.
LabelDst :: struct {
    label: u32
    dst: []u8
}

/// One activation of a function body, or the root of the evaluation of a constant.
Frame :: struct {
    id: u64
    /// Its index in `Machine.frames`, which function values refer to it by.
    handle: u32
    fn_id: u32
    info: ^FnInfo
    /// Where its result goes.
    ret: []u8
    /// The frame of the enclosing function, for upvars.
    env: ?^Frame
    /// The locals kept in scratch memory, at `FnInfo.offsets`.
    store: []u8
    /// The address of the allocation of each local that has one (0: none yet).
    mem: []u64
    /// The storage of `mem`, kept when the frame is reused.
    mem_buf: []u64
    /// Allocations that die with the frame.
    allocs: List(u64)
    /// The loops and `with`s that the tree evaluator runs in it, innermost last.
    labels: List(LabelDst)
    /// The deferred statements of the blocks the register machine runs, innermost last.
    defers: List(Deferred)
    /// For a handler clause: the frame and label of the `with` that installed it.
    installing: ?(frame: ^Frame, label: u32)
    /// True for the clauses of handler literals, which lexically belong to `env`'s
    /// function.
    is_clause_lit: bool
    /// The next finished frame kept for reuse (`Machine.frame_pool`).
    next_free: ?^Frame
}

/// What the interpreter needs to know about a function: its lowered body, parameters and
/// locals.
FnInfo :: struct {
    /// The body (`null` for a function without one, such as a foreign function).
    body: ?^Node = null
    /// The locals that are its parameters.
    params: []const u32 = empty_slice(u32)
    /// Whether some parameter needs an address.
    addressed_params: bool = false
    /// For a function returning a result: the offset of the byte telling an error.
    err_flag: ?u64 = null
    /// The function's result type (`null` for what is not a function's body).
    ret_ty: ?Ty = null
    /// The body compiled for the register machine (`vm.gm`).
    vm: ?^Code = null
    /// The size of the frame's storage: the locals, then the machine's slots and registers.
    frame_size: u64 = 0
    offsets: []u64
    sizes: []u64
    aligns: []u64
    /// Whether each local needs an address (an allocation of its own).
    addressed: []bool
    store_size: u64
    /// The stack bytes a call is charged on a fiber stack (`sema.frame_cost`).
    cost: u64
}

/// A handler in a context.
CtxNode :: struct {
    parent: u32
    effect_: types.EffectRef
    installed: Installed
    /// The `with` that installed it: its frame's id and label (0 for the defaults).
    with_frame: u64
    with_label: u32
    /// The frame of that `with`, for `break`s from its clauses.
    with_fr: ?^Frame
}

Installed :: union {
    /// A handler literal: its clauses run in the frame and context where it was written.
    Lit: (id: u32, env: ?^Frame, cx: u32)
    /// Handler declarations with the value they were installed for and the context
    /// outside the `with`.
    Decl: (decls: []const u32, value: []u8, outer: u32)
    Native: NativeKind
}

NativeKind :: union { Out, Err, Env }

/// Scratch memory, used as a stack: chunks that are never moved, so that buffers stay
/// valid while they are in use.
Scratch :: struct {
    chunks: List([]u8)
    cur: usize
    top: usize
}

Mark :: struct {
    cur: usize
    top: usize
}

CHUNK: usize : 1 << 20

/// Where code addresses (function pointers) start; each function has 16 bytes.
CODE_BASE: u64 : 0x1000

/// How deeply calls may nest.
MAX_DEPTH: u32 : 200_000

pub Machine :: struct {
    p: ^Prog
    s: ^Sema
    lay: cgen.Layouts
    mode: Mode
    little: bool
    /// Whether the register machine keeps word locals in its registers: when the host
    /// reads a `u64` in the target's byte order, little-endian (`make_info`).
    word_locals: bool
    /// The functions nested in each function, as lists: the first (plus one; 0 for none)
    /// by function, and the next by function (`nested_head`).
    first_nested: List(u32)
    next_nested: List(u32)
    ptr_bytes: u64
    mem: Memory
    scratch: Scratch
    /// Temporaries whose address was taken; each statement kills the ones it made.
    temps: List(u64)
    frames: List(?^Frame)
    /// The sizes of types by id (`~0`: not known yet).
    sizes: List(u64)
    /// Finished frames, kept to be reused (a list through `Frame.next_free`), and how many.
    frame_pool: ?^Frame
    pooled: u32
    /// The argument values of the calls being made.
    argv: List([]u8)
    free_frames: List(u32)
    /// The handler contexts, by handle (0: the empty context).
    ctxs: List(CtxNode)
    free_ctxs: List(u32)
    infos: List(?^FnInfo)
    next_frame: u64
    depth: u32
    /// The lowest address of the host stack the evaluation may use.
    stack_floor: usize
    /// The allocations of string literals, by the address of their bytes.
    strings: hash_map.HashMap(usize, u64)
    cstrings: hash_map.HashMap(usize, u64)
    /// The allocations of constants, by the address of their cell.
    cells: hash_map.HashMap(usize, (addr: u64, ty: Ty))
    /// The allocations of `#global`s, by index (0: not yet made).
    globals: List(u64)
    /// The instances of `#thread_local` variables, by index and thread.
    thread_globals: hash_map.HashMap((usize, u32), u64)
    args: []const string
    /// The slice `Env.args` returns, made on the first call.
    env_args: ?[]u8
    /// The fiber state (`fiber.gm`).
    fib: Fibers
    /// The bytes left on the running fiber's stack (`~0` off fibers).
    fiber_stack: u64
    /// Debug builds: the allocator `(owner, vt)` and site of each block from `new`/`make`.
    alloc_tags: hash_map.HashMap(u64, AllocTag)
    /// The state of the system services (`sys.gm`).
    sys: SysState
    /// The program's threads (`threads.gm`).
    threads: Threads
    /// What the program writes to its standard output and error goes through it, if set.
    filter: ?^Filter
}

/// Hides what a program writes to its standard output and error up to the first
/// occurrence of a marker in each (the REPL replays statements this way).
pub Filter :: struct {
    marker: string
    hiding: [2]bool
    pending: [2]List(u8)
}

/// A filter hiding output up to `marker` on both streams if `hide`.
pub filter :: fn(marker: string, hide: bool) -> Filter needs Alloc => Filter(marker: marker, hiding: [2]bool(hide, hide), pending: [2]List(u8)(list(u8), list(u8)))

/// Writes `data` to the host's standard output (`fd` 1) or error (2), through the filter.
host_write :: fn(m: ^Machine, fd: u32, data: []const u8) needs Alloc + Err + Out {
    shown := data
    if f := m.filter {
        i := if fd is 2 { 1 } else { 0 }
        if f.hiding[i] {
            p := &f.pending[i]
            p.extend(data)!
            at := str.find(p.items, f.marker) else {
                // Only the end can still be part of the marker.
                if p.items.len > f.marker.len {
                    keep := p.items.len - f.marker.len
                    tail := p.items[keep..p.items.len]
                    for k in 0..tail.len { p.items[k] = tail[k] }
                    p.truncate(f.marker.len)
                }
                return ()
            }
            f.hiding[i] = false
            shown = p.items[at + f.marker.len..p.items.len]
        }
    }
    if shown.len is 0 { return () }
    if fd is 2 { Err.write(shown) } else { Out.write(shown) }
}

AllocTag :: struct {
    owner: u64
    vt: u64
    site: string
}

machine :: fn(p: ^Prog, mode: Mode, args: []const string) -> Machine needs Alloc {
    s := p.s
    code_end := CODE_BASE + 16 * (u64(s.fns.items.len) + 1)
    data_base := (code_end + 0x10000 + 0xFFFF) / 0x10000 * 0x10000
    m := Machine(
        p: p,
        s: s,
        lay: cgen.layouts(s, p.target),
        mode: mode,
        little: p.target.little_endian,
        word_locals: p.target.little_endian and host_little(),
        first_nested: list(u32),
        next_nested: list(u32),
        ptr_bytes: p.target.ptr_bytes,
        mem: memory(data_base, p.target.ptr_bytes),
        scratch: Scratch(chunks: list([]u8), cur: 0, top: 0),
        temps: list(u64),
        frames: list(?^Frame),
        frame_pool: null,
        pooled: 0,
        sizes: list(u64),
        argv: list([]u8),
        free_frames: list(u32),
        ctxs: list(CtxNode),
        free_ctxs: list(u32),
        infos: list(?^FnInfo),
        next_frame: 1,
        depth: 0,
        stack_floor: 0,
        strings: hash_map.hash_map(usize, u64),
        cstrings: hash_map.hash_map(usize, u64),
        cells: hash_map.hash_map(usize, (addr: u64, ty: Ty)),
        globals: list(u64),
        thread_globals: hash_map.hash_map((usize, u32), u64),
        args: args,
        env_args: null,
        fib: fibers(),
        fiber_stack: ~u64(0),
        alloc_tags: hash_map.hash_map(u64, AllocTag),
        sys: sys_state(),
        filter: null,
        threads: threads(),
    )
    m.scratch.chunks.push(make_fill(CHUNK, u8(0))!)!
    // Handle 0 is the empty context.
    m.ctxs.push(CtxNode(parent: 0, effect_: types.EffectRef(eff: 0, args: empty_slice(types.GenericArg)), installed: .Native(.Out), with_frame: 0, with_label: 0, with_fr: null))!
    for _ in s.globals.items { m.globals.push(0)! }
    return m
}

fast :: fn(m: ^const Machine) -> bool => m.mode is .Fast

/// Whether the host stores the low byte of a word first.
host_little :: fn() -> bool {
    x: u64 = 1
    return (&x).cast([^]u8)[0] is 1
}

// ---------------------------------------------------------------------------------
// Scratch memory
// ---------------------------------------------------------------------------------

#inline
mark :: fn(m: ^const Machine) -> Mark => Mark(cur: m.scratch.cur, top: m.scratch.top)

#inline
release :: fn(m: ^Machine, mk: Mark) {
    m.scratch.cur = mk.cur
    m.scratch.top = mk.top
}

/// A zero-filled buffer of `n` bytes, valid until the scratch memory is released to a
/// mark taken before.
#inline
tmp :: fn(m: ^Machine, n: u64) -> []u8 needs Alloc {
    sc := &m.scratch
    chunk := sc.chunks.items[sc.cur]
    // Buffers are 8-byte aligned in memory (a chunk itself may be aligned to 4 only, on
    // 32-bit hosts): the register machine reads its registers as `u64`s.
    base := chunk.ptr.addr()
    top := ((base + sc.top + 7) & ~us(7)) - base
    size := us(n)
    if n is 0 or top + size > chunk.len { return m.tmp_next(n) }
    b := chunk[top..top + size]
    sc.top = top + size
    b.fill(0)
    return b
}

/// `tmp` for an empty buffer, or one that does not fit in the current chunk.
#noinline
tmp_next :: fn(m: ^Machine, n: u64) -> []u8 needs Alloc {
    if n is 0 { return empty_slice(u8) }
    sc := &m.scratch
    size := us(n)
    top := sc.top
    while true {
        chunk := sc.chunks.items[sc.cur]
        // Buffers are 8-byte aligned in memory (a chunk itself may be aligned to 4 only,
        // on 32-bit hosts): the register machine reads its registers as `u64`s.
        base := chunk.ptr.addr()
        top = ((base + top + 7) & ~us(7)) - base
        if top + size <= chunk.len {
            b := chunk[top..top + size]
            sc.top = top + size
            b.fill(0)
            return b
        }
        sc.cur += 1
        top = 0
        if sc.cur is sc.chunks.items.len {
            sc.chunks.push(make_fill(size.max(CHUNK) + 8, u8(0))!)!
        } else if sc.chunks.items[sc.cur].len < size {
            // A chunk too small for this buffer is replaced.
            free(sc.chunks.items[sc.cur])
            sc.chunks.items[sc.cur] = make_fill(size.max(CHUNK) + 8, u8(0))!
        }
    }
}

// ---------------------------------------------------------------------------------
// Traps
// ---------------------------------------------------------------------------------

trap :: fn(m: ^const Machine, span: source.Span, message: string) -> Flow needs Alloc => .Trap(new(Trap(message: message, span: span, trace: list(TraceCall)))!)

/// A construct the interpreter cannot run yet.
unsupported :: fn(m: ^const Machine, span: source.Span, what: string) -> Flow needs Alloc => m.trap(span, str.format("internal error: not supported by the interpreter yet: {}", what)!)

mem_trap :: fn(m: ^const Machine, span: source.Span, e: MemError) -> Flow needs Alloc => m.trap(span, mem_message(e))

// ---------------------------------------------------------------------------------
// Running a program
// ---------------------------------------------------------------------------------

/// How a run ended.
pub Outcome :: union {
    Exit: u8
    Trap: ^Trap
}

/// Runs `entry` (the program's `main` or the function wrapping it), with its output
/// through `filter` if given: installs the
/// default handlers of the ambient effects (`Out` to standard output, `Err` to standard
/// error, `Env` with `args`) and returns the exit status (0, `main`'s `u8` result, or 1
/// if it returns an error, which is first written to standard error as `error: …`).
pub run_entry :: fn(p: ^Prog, entry: u32, mode: Mode, args: []const string, filter: ?^Filter) -> Outcome needs Host {
    return with heap_allocator() {
        m := machine(p, mode, args)
        m.filter = filter
        mp := &m
        run :: fn() -> Outcome needs Run {
            cx: u32 = 0
            a := p.ambient
            if e := a.out { cx = mp.push_ctx(cx, types.EffectRef(eff: e, args: empty_slice(types.GenericArg)), .Native(.Out), 0, 0, null) }
            if e := a.err { cx = mp.push_ctx(cx, types.EffectRef(eff: e, args: empty_slice(types.GenericArg)), .Native(.Err), 0, 0, null) }
            if e := a.env { cx = mp.push_ctx(cx, types.EffectRef(eff: e, args: empty_slice(types.GenericArg)), .Native(.Env), 0, 0, null) }
            ret_ty := mp.func(entry).ret
            ret := mp.tmp(mp.size(ret_ty))
            return match mp.call_function(source.DUMMY, entry, empty_slice([]u8), null, cx, null, false, ret) {
                !.Exit(code) => .Exit(code)
                !.Trap(t) => .Trap(t)
                !_ => .Trap(new(Trap(message: "internal error: control flow escaped `main`", span: source.DUMMY, trace: list(TraceCall)))!)
                _ => .Exit(mp.exit_status(ret_ty, ret))
            }
        }
        outcome := mp.run_coroutines(run)
        mp.deinit()
        outcome
    }
}

/// Frees what the machine holds (the trap of an outcome is kept).
deinit :: fn(m: ^Machine) needs Alloc {
    m.mem.mem_deinit()
    for c in m.scratch.chunks.items { free(c) }
    m.scratch.chunks.deinit()
    m.infos.deinit()
    m.temps.deinit()
    while fr := m.frame_pool {
        m.frame_pool = fr.next_free
        fr.allocs.deinit()
        fr.labels.deinit()
        fr.defers.deinit()
        if fr.mem_buf.len > 0 { free(fr.mem_buf) }
        destroy(fr)
    }
    m.argv.deinit()
    if t := m.env_args { free(t) }
    m.sizes.deinit()
    m.frames.deinit()
    m.free_frames.deinit()
    m.ctxs.deinit()
    m.free_ctxs.deinit()
    m.globals.deinit()
    m.thread_globals.deinit()
    m.strings.deinit()
    m.cstrings.deinit()
    m.cells.deinit()
    m.alloc_tags.deinit()
    for s in m.fib.free_stacks.items { libc.free(s.ptr) }
    m.fib.free_stacks.deinit()
    m.fib.coros.deinit()
    m.fib.withs.deinit()
}

/// The exit status of a program whose entry returned `b` of type `t`.
exit_status :: fn(m: ^Machine, t: Ty, b: []u8) -> u8 needs Alloc + Err {
    int_status :: fn(ty: Ty, v: []const u8) -> u8 {
        if m.int_info(ty) is null { return 0 }
        return m.get_uint(v).trunc(u8)
    }
    .Result(err, ok) := m.kind(t) else return int_status(t, b)
    payload := m.res_payload(t, b)
    if not m.res_is_err(t, b) { return int_status(ok, payload) }
    out := list(u8)
    out.extend("error: ")!
    // A union's value is named with its type: `E.NotFound` (§3.7).
    if m.union_def(err) is not null { out.extend(m.s.tys.show(err))! }
    m.format_value(&out, err, payload, true) else { out.extend("<unprintable error>")! }
    out.push('\n')!
    Err.write(out.items)
    return 1
}

/// A trap's message and where it happened: its location and, in Debug builds, the
/// calls leading to it (the report the C runtime prints), after `trap: `.
pub trap_report :: fn(p: ^Prog, t: ^const Trap) -> string needs Alloc {
    out := list(u8)
    out.write("{}\n", t.message)!
    name :: fn(i: usize) -> ?string {
        c := t.trace.items.get(i) else return null
        return p.backtrace_name(c.fn_id)
    }
    if at := location(p, t.span) {
        out.write("  at {}", at)!
        if n := name(0) { out.write(" in {}", n)! }
        out.push('\n')!
    }
    // Each call site lies in the function that the next (outer) entry called.
    callers := list(string)
    for i in 0..t.trace.items.len {
        at := location(p, t.trace.items[i].span) else continue
        n := name(i + 1) else continue
        callers.push(str.format("  called from {} in {}\n", at, n)!)!
    }
    // Past 20 callers, only the first and last 10, with a line that does not count the
    // calls in between (a stack overflow reaches different depths on different back ends).
    max: usize = 20
    n := callers.items.len
    for i, line in enumerate(callers.items) {
        if n <= max or i < max / 2 or i >= n - max / 2 {
            out.extend(line)!
        } else if i is max / 2 {
            out.extend("  ... more calls\n")!
        }
    }
    return out.items
}

/// `file:line:col` of `span`, if it has a location.
location :: fn(p: ^Prog, span: source.Span) -> ?string needs Alloc {
    if span is source.DUMMY { return null }
    f := p.s.l.sm.file(span.file)
    lc := f.line_col(span.lo)
    return str.format("{}:{}:{}", f.path, lc.line, lc.col)!
}

/// `x` as a `usize` (sizes and offsets of the interpreter's own buffers fit).
#inline
us :: fn(x: u64) -> usize => x.trunc(usize)
