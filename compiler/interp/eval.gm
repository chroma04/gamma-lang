// Evaluating expressions into destinations, and places.

/// A location: bytes of a frame's storage or of a temporary, memory, memory that may be
/// unaligned (a field of a packed struct), or a field of a `#bits` struct, which lives in
/// one of the first two.
Place :: union {
    Host: []u8
    Mem: u64
    Packed: u64
    Bits: (host: []u8, addr: u64, whole: Ty, off: u32, fty: Ty)
}

/// Evaluates `e` into `dst`, which has the size of its type. The kinds every call and
/// most expressions go through are dispatched here and the others in `eval_slow`, so that
/// this function's frame, which each level of nesting of expressions and calls pays for,
/// stays small.
eval :: fn(m: ^Machine, a: Act, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    match e.kind {
        .Local(l) => return m.read_local(e.span, a.fr, l, dst)
        .Binary(op, l, r) => return m.binary(a, op, l, r, e, dst)
        .Unary(op, x) => return m.unary(a, op, x, e, dst)
        .Call(callee, args) => return m.eval_call(a, callee, args, e, dst)
        .Coerce(kind, x) => return m.coerce(a, kind, x, e, dst)
        .Block(b) => return m.block(a, b, dst)
        .If(x) => return m.eval_if(a, x, dst)
        .Return(levels, value) => return m.eval_return(a, levels, value, e)
        _ => return m.eval_slow(a, e, dst)
    }
}

eval_if :: fn(m: ^Machine, a: Act, x: tir.IfExpr, dst: []u8) -> Flow!() needs Run {
    if try m.conds(a, x.cond) { return m.eval(a, x.then, dst) }
    if el := x.else_ { return m.eval(a, el, dst) }
}

eval_return :: fn(m: ^Machine, a: Act, levels: u32, value: ^Expr, e: ^Expr) -> Flow!() needs Run {
    target := frame_up(a.fr, levels) else return !m.trap(e.span, "internal error: return from a missing frame")
    try m.eval(a, value, target.ret)
    is_err := m.kind(target.ret_ty) is .Result(_, _) and m.res_is_err(target.ret_ty, target.ret)
    return !.Return(target.id, is_err)
}

/// `eval` of the other kinds of expressions.
#noinline
eval_slow :: fn(m: ^Machine, a: Act, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    match e.kind {
        .Int(i) => {
            if m.kind(e.ty) is .Float(_) {
                m.put_float(e.ty, m.big_float(i), dst)
                return ()
            }
            m.put_uint(dst, tag_bits(i))
        }
        .Float(x) => m.put_float(e.ty, x, dst)
        .Bool(b) => { dst[0] = if b { 1 } else { 0 } }
        .Str(bytes) => {
            addr := try m.string_literal(e.span, bytes, false)
            m.put_slice(dst, addr, u64(bytes.len))
        }
        .CStr(bytes) => {
            addr := try m.string_literal(e.span, bytes, true)
            m.put_ptr(dst, addr)
        }
        .Null => dst.fill(0)
        .Uninit => dst.fill(if m.mode is .Debug { 0xAA } else { 0 })
        .Local(l) => try m.read_local(e.span, a.fr, l, dst)
        .Upvar(levels, l) => {
            fr := frame_up(a.fr, levels) else return !m.trap(e.span, "internal error: upvar without an enclosing frame")
            try m.read_local(e.span, fr, l, dst)
        }
        .Const(_, _), .Global(_), .Deref(_) => {
            p := try m.place(a, e, false)
            try m.read_place(e.span, p, e.ty, dst)
        }
        .Field(base, index) => {
            if is_place_expr(m, base) {
                p := try m.place(a, e, false)
                try m.read_place(e.span, p, e.ty, dst)
                return ()
            }
            mk := m.mark()
            b := m.tmp(m.size(base.ty))
            try m.eval(a, base, b)
            m.read_field(base.ty, b, index, dst)
            m.release(mk)
        }
        .Index(base, index, _) => {
            if .Array(len, _, _) := m.kind(base.ty) and not is_place_expr(m, base) {
                mk := m.mark()
                b := m.tmp(m.size(base.ty))
                try m.eval(a, base, b)
                i := try m.eval_index(a, index)
                if i >= len { return !m.trap(e.span, str.format("index {} out of bounds for length {}", i, len)!) }
                n := us(m.size(e.ty))
                off := us(i) * n
                dst.copy_from(b[off..off + n])
                m.release(mk)
                return ()
            }
            p := try m.place(a, e, false)
            try m.read_place(e.span, p, e.ty, dst)
        }
        .Slice(sl) => try m.eval_slice(a, e, sl, dst)
        .SliceLen(x) => {
            mk := m.mark()
            b := m.tmp(m.size(x.ty))
            try m.eval(a, x, b)
            m.put_u64(dst, m.slice_parts(b).len)
            m.release(mk)
        }
        .SlicePtr(x) => {
            mk := m.mark()
            b := m.tmp(m.size(x.ty))
            try m.eval(a, x, b)
            m.put_ptr(dst, m.slice_parts(b).ptr)
            m.release(mk)
        }
        .AddrOf(x) => {
            match try m.place(a, x, true) {
                .Mem(addr), .Packed(addr) => m.put_ptr(dst, addr)
                .Host(_) => return !m.trap(e.span, "internal error: the address of a value without one")
                .Bits(_) => return !m.trap(e.span, "cannot take the address of a #bits field")
            }
        }
        .AddrOfTemp(x) => {
            mk := m.mark()
            b := m.tmp(m.size(x.ty))
            try m.eval(a, x, b)
            addr := try m.alloc_temp(e.span, b, m.align(x.ty))
            m.release(mk)
            m.put_ptr(dst, addr)
        }
        .FnRef(f) => {
            m.put_word(dst, 0, m.fn_addr(f))
            if m.kind(e.ty) is .Fn(_) {
                m.put_word(dst, 1, 0)
                m.put_word(dst, 2, u64(a.cx))
            }
        }
        .Closure(f) => {
            m.put_word(dst, 0, m.fn_addr(f))
            m.put_word(dst, 1, u64(a.fr.handle))
            m.put_word(dst, 2, u64(a.cx))
        }
        .HandlerRef(_) => {
            m.put_word(dst, 0, u64(a.fr.handle))
            m.put_word(dst, 1, u64(a.cx))
        }
        .Unary(op, x) => try m.unary(a, op, x, e, dst)
        .Binary(op, l, r) => try m.binary(a, op, l, r, e, dst)
        .Logic(is_and, l, r) => {
            v := try m.cond(a, l)
            if v is not is_and {
                dst[0] = if v { 1 } else { 0 }
                return ()
            }
            w := try m.cond(a, r)
            dst[0] = if w { 1 } else { 0 }
        }
        .Coerce(kind, x) => try m.coerce(a, kind, x, e, dst)
        .Builtin(op, args) => try m.eval_builtin(a, op, args, e, dst)
        .Call(callee, args) => try m.eval_call(a, callee, args, e, dst)
        .Aggregate(items) => try m.aggregate(a, e, items, dst)
        .Array(items) => {
            n := if items.len > 0 { us(m.size(items[0].ty)) } else { 0 }
            for i in 0..items.len { try m.eval(a, &items[i], dst[i * n..(i + 1) * n]) }
        }
        .ArrayFill(x) => {
            n := us(m.size(x.ty))
            if n is 0 {
                try m.eval(a, x, dst)
                return ()
            }
            try m.eval(a, x, dst[0..n])
            k := n
            while k < dst.len {
                dst[k..k + n].copy_from(dst[0..n])
                k += n
            }
        }
        .Variant(v) => {
            if p := v.payload {
                mk := m.mark()
                b := m.tmp(m.size(p.ty))
                try m.eval(a, p, b)
                m.make_variant(e.ty, dst, v.variant, b)
                m.release(mk)
            } else {
                m.make_variant(e.ty, dst, v.variant, empty_slice(u8))
            }
        }
        .MakeErr(x) => {
            mk := m.mark()
            b := m.tmp(m.size(x.ty))
            try m.eval(a, x, b)
            m.make_res(e.ty, dst, true, b)
            m.release(mk)
        }
        .Unwrap(x, is_result) => try m.unwrap(a, x, is_result, e, dst)
        .Else(x) => try m.else_(a, x, e, dst)
        .Try(x) => try m.try_(a, x, e, dst)
        .Eq(l, r, negated) => {
            mk := m.mark()
            x := m.tmp(m.size(l.ty))
            try m.eval(a, l, x)
            y := m.tmp(m.size(r.ty))
            try m.eval(a, r, y)
            v := try m.equal(e.span, l.ty, x, y)
            dst[0] = if v is not negated { 1 } else { 0 }
            m.release(mk)
        }
        .In(elem, container, negated) => {
            mk := m.mark()
            x := m.tmp(m.size(elem.ty))
            try m.eval(a, elem, x)
            c := m.tmp(m.size(container.ty))
            try m.eval(a, container, c)
            v := try m.contains(e.span, elem.ty, x, container.ty, c)
            dst[0] = if v is not negated { 1 } else { 0 }
            m.release(mk)
        }
        .Match(scrutinee, arms) => try m.match_(a, scrutinee, arms, e, dst)
        .Block(b) => try m.block(a, b, dst)
        .If(x) => {
            if try m.conds(a, x.cond) {
                try m.eval(a, x.then, dst)
            } else if el := x.else_ {
                try m.eval(a, el, dst)
            }
        }
        .Loop(x) => try m.loop_(a, x, dst)
        .Break(x) => {
            t := try m.resolve_target(a, x.target, e.span)
            if v := x.value {
                d := t.frame.label_dst(t.label) else return !m.trap(e.span, "internal error: break to a label that is not running")
                try m.eval(a, v, d)
            }
            return !.Break(t.frame.id, t.label)
        }
        .Continue(target) => {
            if target is .InstallingWith {
                // A clause's `continue` resumes the code that performed the operation: the
                // clause returns `()`.
                return !.Return(a.fr.id, false)
            }
            t := try m.resolve_target(a, target, e.span)
            return !.Continue(t.frame.id, t.label)
        }
        .Return(levels, value) => {
            target := frame_up(a.fr, levels) else return !m.trap(e.span, "internal error: return from a missing frame")
            try m.eval(a, value, target.ret)
            is_err := m.kind(target.ret_ty) is .Result(_, _) and m.res_is_err(target.ret_ty, target.ret)
            return !.Return(target.id, is_err)
        }
        .Trap(msg) => {
            mk := m.mark()
            b := m.tmp(m.size(msg.ty))
            try m.eval(a, msg, b)
            s := try m.read_string(e.span, b)
            m.release(mk)
            return !m.trap(e.span, s)
        }
        .Resume(k, v) => try m.resume_(a, k, v, e)
        .Cancel(k) => try m.cancel_(a, k, e)
        .Write(w) => try m.write_(a, w, e)
        .With(w) => try m.with_(a, w, e, dst)
        .SizeOf(_), .IntLimit(_), .TypeName(_), .TypeIs(_), .UntypedFloat(_), .UntypedComplex(_), .ValueParam(_), .WriteDeferred(_), .SoaDeferred(_) => return !m.trap(e.span, "internal error: an expression left over from generic checking")
    }
}

/// Evaluates the condition `e`.
cond :: fn(m: ^Machine, a: Act, e: ^Expr) -> Flow!bool needs Run {
    b: [1]u8 = [1]u8(0)
    try m.eval(a, e, b[..])
    return b[0] is not 0
}

/// Evaluates the index `e` (an unsigned integer).
eval_index :: fn(m: ^Machine, a: Act, e: ^Expr) -> Flow!u64 needs Run {
    b: [16]u8 = ---
    n := us(m.size(e.ty))
    b[0..n].fill(0)
    try m.eval(a, e, b[0..n])
    v := m.get_uint(b[0..n])
    return if v > u128(~u64(0)) { ~u64(0) } else { v.trunc(u64) }
}

/// Evaluates `e` for its effects, discarding its value.
eval_discard :: fn(m: ^Machine, a: Act, e: ^Expr) -> Flow!() needs Run {
    mk := m.mark()
    b := m.tmp(m.size(e.ty))
    try m.eval(a, e, b)
    m.release(mk)
}

/// Whether `e` denotes a place that reading needs no copy of.
is_place_expr :: fn(m: ^const Machine, e: ^const Expr) -> bool => match e.kind {
    .Local(_), .Upvar(_), .Global(_), .Deref(_), .Const(_) => true
    .Field(base, _) => is_place_expr(m, base)
    .Index(base, _, _) => if m.kind(base.ty) is .Array(_, _, _) { is_place_expr(m, base) } else { true }
    _ => false
}

// ---------------------------------------------------------------------------------
// Locals and places
// ---------------------------------------------------------------------------------

read_local :: fn(m: ^Machine, span: source.Span, fr: ^Frame, l: u32, dst: []u8) -> Flow!() needs Alloc {
    i := us(l)
    if fr.mem[i] is not 0 { return m.load_at(span, fr.mem[i], fr.info.aligns[i], dst) }
    off := us(fr.info.offsets[i])
    dst.copy_from(fr.store[off..off + dst.len])
}

set_local :: fn(m: ^Machine, span: source.Span, fr: ^Frame, l: u32, data: []const u8) -> Flow!() needs Alloc {
    i := us(l)
    if fr.mem[i] is 0 and fr.info.addressed[i] { _ = try m.local_addr(span, fr, l) }
    if fr.mem[i] is not 0 { return m.store_at(span, fr.mem[i], fr.info.aligns[i], data) }
    off := us(fr.info.offsets[i])
    fr.store[off..off + data.len].copy_from(data)
}

/// The place of local `l` of `fr`; in memory if `need_addr` or its address is taken.
local_place :: fn(m: ^Machine, span: source.Span, fr: ^Frame, l: u32, need_addr: bool) -> Flow!Place needs Alloc {
    i := us(l)
    if fr.mem[i] is not 0 { return .Mem(fr.mem[i]) }
    if need_addr or fr.info.addressed[i] { return .Mem(try m.local_addr(span, fr, l)) }
    off := us(fr.info.offsets[i])
    return .Host(fr.store[off..off + us(fr.info.sizes[i])])
}

/// Evaluates a place expression to its location; anything else is evaluated into a
/// temporary (in memory if `need_addr`).
place :: fn(m: ^Machine, a: Act, e: ^Expr, need_addr: bool) -> Flow!Place needs Run {
    match e.kind {
        .Local(l) => return m.local_place(e.span, a.fr, l, need_addr)
        .Upvar(levels, l) => {
            fr := frame_up(a.fr, levels) else return !m.trap(e.span, "internal error: upvar without an enclosing frame")
            return m.local_place(e.span, fr, l, need_addr)
        }
        .Global(_, decl) => return .Mem(try m.global_addr(e.span, decl))
        .Const(_, span) => return .Mem(try m.const_addr(span, e.ty, e.span))
        .Deref(x) => {
            b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
            p := b[0..us(m.ptr_bytes)]
            try m.eval(a, x, p)
            return .Mem(m.ptr_of(p))
        }
        .Field(base, index) => {
            if m.bits_struct_ty(base.ty) is not null {
                bf := m.bits_field(base.ty, index)
                match try m.place(a, base, false) {
                    .Host(h) => return .Bits(h, 0, base.ty, bf.off, bf.ty)
                    .Mem(addr), .Packed(addr) => return .Bits(empty_slice(u8), addr, base.ty, bf.off, bf.ty)
                    .Bits(x) => return .Bits(x.host, x.addr, x.whole, x.off + bf.off, bf.ty)
                }
            }
            fl := m.field_layout(base.ty, index)
            packed := m.is_packed(base.ty)
            match try m.place(a, base, need_addr) {
                .Host(h) => {
                    off := us(fl.off)
                    return .Host(h[off..off + us(m.size(fl.ty))])
                }
                .Mem(addr) => return if packed { .Packed(addr + fl.off) } else { .Mem(addr + fl.off) }
                .Packed(addr) => return .Packed(addr + fl.off)
                .Bits(_) => return !m.trap(e.span, "internal error: a field of a #bits field")
            }
        }
        .Index(base, index, _) => {
            esz := m.size(e.ty)
            match m.kind(base.ty) {
                .Array(len, _, _) => {
                    p := try m.place(a, base, need_addr)
                    i := try m.eval_index(a, index)
                    if i >= len { return !m.trap(e.span, str.format("index {} out of bounds for length {}", i, len)!) }
                    match p {
                        .Host(h) => {
                            off := us(i * esz)
                            return .Host(h[off..off + us(esz)])
                        }
                        .Mem(addr) => return .Mem(addr + i * esz)
                        .Packed(addr) => return .Packed(addr + i * esz)
                        .Bits(_) => return !m.trap(e.span, "internal error: an index of a #bits field")
                    }
                }
                .Slice(_) => {
                    b: [16]u8 = ---
                    sb := b[0..us(2 * m.ptr_bytes)]
                    try m.eval(a, base, sb)
                    sp := m.slice_parts(sb)
                    i := try m.eval_index(a, index)
                    if i >= sp.len { return !m.trap(e.span, str.format("index {} out of bounds for length {}", i, sp.len)!) }
                    return .Mem(sp.ptr +% i * esz)
                }
                .ManyPtr(_) => {
                    b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
                    pb := b[0..us(m.ptr_bytes)]
                    try m.eval(a, base, pb)
                    i := try m.eval_index(a, index)
                    return .Mem(m.ptr_of(pb) +% i *% esz)
                }
                .Ptr(_, pointee) => {
                    .Array(len, _, _) := m.kind(pointee) else return !m.trap(e.span, "internal error: an index of a pointer")
                    b: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
                    pb := b[0..us(m.ptr_bytes)]
                    try m.eval(a, base, pb)
                    i := try m.eval_index(a, index)
                    if i >= len { return !m.trap(e.span, str.format("index {} out of bounds for length {}", i, len)!) }
                    return .Mem(m.ptr_of(pb) +% i * esz)
                }
                _ => return !m.trap(e.span, "internal error: an index of a value that has none")
            }
        }
        _ => {
            b := m.tmp(m.size(e.ty))
            try m.eval(a, e, b)
            if not need_addr { return .Host(b) }
            return .Mem(try m.alloc_temp(e.span, b, m.align(e.ty)))
        }
    }
}

read_place :: fn(m: ^Machine, span: source.Span, p: Place, t: Ty, dst: []u8) -> Flow!() needs Alloc {
    match p {
        .Host(h) => dst.copy_from(h[0..dst.len])
        .Mem(addr) => try m.load_at(span, addr, m.align(t), dst)
        .Packed(addr) => try m.load_at(span, addr, 1, dst)
        .Bits(x) => {
            whole := try m.bits_whole(span, x.host, x.addr, x.whole)
            raw := whole >> u128(x.off)
            w := m.bit_width(x.fty)
            if w < 128 { raw &= (u128(1) << u128(w)) - 1 }
            m.bits_from_raw(x.fty, raw, dst)
        }
    }
}

write_place :: fn(m: ^Machine, span: source.Span, p: Place, t: Ty, data: []const u8) -> Flow!() needs Alloc {
    match p {
        .Host(h) => h[0..data.len].copy_from(data)
        .Mem(addr) => try m.store_at(span, addr, m.align(t), data)
        .Packed(addr) => try m.store_at(span, addr, 1, data)
        .Bits(x) => {
            whole := try m.bits_whole(span, x.host, x.addr, x.whole)
            w := m.bit_width(x.fty)
            mask := (if w >= 128 { ~u128(0) } else { (u128(1) << u128(w)) - 1 }) << u128(x.off)
            raw := m.bits_raw(x.fty, data)
            v := (whole & ~mask) | ((raw << u128(x.off)) & mask)
            u := m.bits_struct_ty(x.whole) else x.whole
            n := us(m.size(u))
            if x.host.len > 0 {
                m.put_uint(x.host[0..n], v)
            } else {
                b: [16]u8 = ---
                m.put_uint(b[0..n], v)
                try m.store_at(span, x.addr, m.align(u), b[0..n])
            }
        }
    }
}

/// The bits of the `#bits` struct of type `whole` at `host` or `addr`.
bits_whole :: fn(m: ^Machine, span: source.Span, host: []u8, addr: u64, whole: Ty) -> Flow!u128 needs Alloc {
    u := m.bits_struct_ty(whole) else whole
    n := us(m.size(u))
    if host.len > 0 { return m.get_uint(host[0..n]) }
    b: [16]u8 = ---
    try m.load_at(span, addr, m.align(u), b[0..n])
    return m.get_uint(b[0..n])
}

label_dst :: fn(fr: ^Frame, label: u32) -> ?[]u8 {
    i := fr.labels.items.len
    while i > 0 {
        i -= 1
        if fr.labels.items[i].label is label { return fr.labels.items[i].dst }
    }
    return null
}

/// The frame and label a `break` or `continue` to `t` goes to.
resolve_target :: fn(m: ^Machine, a: Act, t: tir.Target, span: source.Span) -> Flow!(frame: ^Frame, label: u32) needs Alloc {
    match t {
        .Label(levels, label) => {
            fr := frame_up(a.fr, levels) else return !m.trap(span, "internal error: a jump target in a missing frame")
            return (frame: fr, label: label)
        }
        .InstallingWith => {
            x := a.fr.installing else return !m.trap(span, "internal error: no installing `with` for this break")
            return (frame: x.frame, label: x.label)
        }
    }
}

// ---------------------------------------------------------------------------------
// Slices and aggregates
// ---------------------------------------------------------------------------------

eval_slice :: fn(m: ^Machine, a: Act, e: ^Expr, sl: tir.SliceExpr, dst: []u8) -> Flow!() needs Run {
    .Slice(_, elem) := m.kind(e.ty) else return !m.trap(e.span, "internal error: a slice expression of a non-slice type")
    esz := m.size(elem)
    base := sl.base
    ptr: u64 = 0
    len: ?u64 = null
    mk := m.mark()
    match m.kind(base.ty) {
        .Array(n, _, _) => {
            match try m.place(a, base, true) {
                .Mem(addr), .Packed(addr) => { ptr = addr }
                _ => return !m.trap(e.span, "internal error: a slice of a #bits field")
            }
            len = n
        }
        .Slice(_) => {
            b := m.tmp(m.size(base.ty))
            try m.eval(a, base, b)
            sp := m.slice_parts(b)
            ptr = sp.ptr
            len = sp.len
        }
        .ManyPtr(_) => {
            b := m.tmp(m.ptr_bytes)
            try m.eval(a, base, b)
            ptr = m.ptr_of(b)
        }
        .Ptr(_, pointee) => {
            .Array(n, _, _) := m.kind(pointee) else return !m.trap(e.span, "cannot slice this pointer")
            b := m.tmp(m.ptr_bytes)
            try m.eval(a, base, b)
            ptr = m.ptr_of(b)
            len = n
        }
        _ => return !m.trap(e.span, "internal error: a slice of a value that has none")
    }
    lo: u64 = 0
    if x := sl.lo { lo = try m.eval_index(a, x) }
    hi := len else 0
    if x := sl.hi { hi = try m.eval_index(a, x) }
    if sl.inclusive { hi = hi +| 1 }
    m.release(mk)
    if lo > hi or (len is not null and hi > (len else 0)) {
        n := if l := len { str.format("{}", l)! } else { "?" }
        return !m.trap(e.span, str.format("slice bounds {}..{} invalid for length {}", lo, hi, n)!)
    }
    m.put_slice(dst, ptr +% lo * esz, hi - lo)
}

aggregate :: fn(m: ^Machine, a: Act, e: ^Expr, items: []Expr, dst: []u8) -> Flow!() needs Run {
    if u := m.bits_struct_ty(e.ty) {
        mk := m.mark()
        acc: u128 = 0
        for i in 0..items.len {
            b := m.tmp(m.size(items[i].ty))
            try m.eval(a, &items[i], b)
            bf := m.bits_field(e.ty, i.trunc(u32))
            acc |= m.bits_raw(bf.ty, b) << u128(bf.off)
        }
        m.put_uint(dst[0..us(m.size(u))], acc)
        m.release(mk)
        return ()
    }
    if ad := m.adt_of(e.ty) and ad.kind is .CUnion(_) {
        if items.len > 0 {
            n := us(m.size(items[0].ty))
            try m.eval(a, &items[0], dst[0..n])
        }
        return ()
    }
    for i in 0..items.len {
        fl := m.field_layout(e.ty, i.trunc(u32))
        off := us(fl.off)
        try m.eval(a, &items[i], dst[off..off + us(m.size(items[i].ty))])
    }
}

// ---------------------------------------------------------------------------------
// Optionals and results
// ---------------------------------------------------------------------------------

unwrap :: fn(m: ^Machine, a: Act, x: ^Expr, is_result: bool, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    mk := m.mark()
    b := m.tmp(m.size(x.ty))
    try m.eval(a, x, b)
    if is_result {
        if m.res_is_err(x.ty, b) {
            if m.fast() {
                dst.fill(0)
                return ()
            }
            out := list(u8)
            m.format_value(&out, m.res_types(x.ty).err, m.res_payload(x.ty, b), false) else {}
            return !m.trap(e.span, str.format("unwrap of error value {}", out.items)!)
        }
        dst.copy_from(m.res_payload(x.ty, b))
    } else {
        if not m.opt_present(x.ty, b) {
            if m.fast() {
                dst.fill(0)
                return ()
            }
            return !m.trap(e.span, "unwrap of null")
        }
        dst.copy_from(m.opt_payload(x.ty, b))
    }
    m.release(mk)
}

else_ :: fn(m: ^Machine, a: Act, x: tir.ElseExpr, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    lhs := x.lhs
    mk := m.mark()
    b := m.tmp(m.size(lhs.ty))
    try m.eval(a, lhs, b)
    present := false
    payload_ty := lhs.ty
    payload := empty_slice(u8)
    match m.kind(lhs.ty) {
        .Optional(inner) => {
            present = m.opt_present(lhs.ty, b)
            payload_ty = inner
            if present { payload = m.opt_payload(lhs.ty, b) }
        }
        .Result(err, ok) => {
            is_err := m.res_is_err(lhs.ty, b)
            payload = m.res_payload(lhs.ty, b)
            if is_err and x.capture is not null { try m.set_local(e.span, a.fr, x.capture else 0, payload) }
            present = not is_err
            payload_ty = ok
        }
        _ => return !m.trap(e.span, "internal error: `else` on a value that is neither an optional nor a result")
    }
    if not present {
        m.release(mk)
        return m.eval(a, x.rhs, dst)
    }
    if e.ty is payload_ty {
        dst.copy_from(payload)
    } else if e.ty is lhs.ty {
        dst.copy_from(b)
    } else if m.kind(e.ty) is .Optional(_) {
        // A success value as a present optional: `r else null`.
        m.make_some(e.ty, dst, payload)
    } else {
        // A success value lifted into a result with another error type.
        m.make_res(e.ty, dst, false, payload)
    }
    m.release(mk)
}

try_ :: fn(m: ^Machine, a: Act, x: tir.TryExpr, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    inner := x.expr
    mk := m.mark()
    b := m.tmp(m.size(inner.ty))
    try m.eval(a, inner, b)
    target := frame_up(a.fr, x.levels) else return !m.trap(e.span, "internal error: `try` without an enclosing function")
    match m.kind(inner.ty) {
        .Optional(_) => {
            if m.opt_present(inner.ty, b) {
                dst.copy_from(m.opt_payload(inner.ty, b))
                m.release(mk)
                return ()
            }
            target.ret.fill(0)
            return !.Return(target.id, false)
        }
        .Result(_, _) => {
            if not m.res_is_err(inner.ty, b) {
                dst.copy_from(m.res_payload(inner.ty, b))
                m.release(mk)
                return ()
            }
            ev := m.res_payload(inner.ty, b)
            rerr := m.res_types(target.ret_ty).err
            if v := x.lift {
                lifted := m.tmp(m.size(rerr))
                m.make_variant(rerr, lifted, v, ev)
                m.make_res(target.ret_ty, target.ret, true, lifted)
            } else {
                m.make_res(target.ret_ty, target.ret, true, ev)
            }
            return !.Return(target.id, true)
        }
        _ => return !m.trap(e.span, "internal error: `try` on a value that is neither an optional nor a result")
    }
}

// ---------------------------------------------------------------------------------
// Coercions
// ---------------------------------------------------------------------------------

coerce :: fn(m: ^Machine, a: Act, kind: tir.Coercion, x: ^Expr, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    match kind {
        .FromNever => {
            try m.eval_discard(a, x)
            return !m.trap(e.span, "internal error: a `never` expression produced a value")
        }
        .FnToPtr => {
            mk := m.mark()
            b := m.tmp(m.size(x.ty))
            try m.eval(a, x, b)
            to_fn := m.kind(e.ty) is .Fn(_)
            from_fn := m.kind(x.ty) is .Fn(_)
            if to_fn and not from_fn {
                addr := m.ptr_of(b)
                if m.fn_from_addr(addr) is null { return !m.trap(e.span, "call through an invalid function pointer") }
                m.put_word(dst, 0, addr)
                m.put_word(dst, 1, 0)
                m.put_word(dst, 2, u64(a.cx))
            } else if not to_fn and from_fn {
                m.put_ptr(dst, m.word(b, 0))
            } else {
                dst.copy_from(b)
            }
            m.release(mk)
        }
        .PtrToPtr, .TupleRename, .FnPtrWiden => try m.eval(a, x, dst)
        _ => {
            mk := m.mark()
            b := m.tmp(m.size(x.ty))
            try m.eval(a, x, b)
            try m.coerce_bytes(e.span, kind, x.ty, e.ty, b, dst)
            m.release(mk)
        }
    }
}

// ---------------------------------------------------------------------------------
// Builtins that reach memory
// ---------------------------------------------------------------------------------

eval_builtin :: fn(m: ^Machine, a: Act, op: tir.Builtin, args: []Expr, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    match op {
        .Assert => {
            if m.fast() { return () }
            if try m.cond(a, &args[0]) { return () }
            msg := "assertion failed"
            if args.len > 1 {
                mk := m.mark()
                b := m.tmp(m.size(args[1].ty))
                try m.eval(a, &args[1], b)
                msg = try m.read_string(e.span, b)
                m.release(mk)
            }
            if msg is not "assertion failed" { msg = str.format("assertion failed: {}", msg)! }
            return !m.trap(e.span, msg)
        }
        .Cover(_) => return ()
        .Unreachable => return !m.trap(e.span, "reached `@unreachable()`")
        .Fiber => return m.fiber_builtin(a, args, e, dst)
        .Sys(sop) => return m.sys_call(a, sop, args, e, dst)
        .Get, .GetPtr, .First, .Last => return m.get_builtin(a, op, args, e, dst)
        .HeapAlloc, .HeapFree, .AllocTag, .AllocCheck, .CopyElems, .AtomicLoad, .AtomicStore, .AtomicSwap, .AtomicCas, .AtomicRmw(_), .VolatileLoad, .VolatileStore, .Fence, .CstrLen, .VecLoad, .VecStore => {
            mk := m.mark()
            vals := list([]u8)
            for i in 0..args.len {
                b := m.tmp(m.size(args[i].ty))
                try m.eval(a, &args[i], b)
                vals.push(b)!
            }
            r := m.memory_builtin(e.span, op, args, vals.items, e.ty, dst)
            vals.deinit()
            m.release(mk)
            return r
        }
        .Asm(_) => return !m.unsupported(e.span, "`@asm`")
        .StaticAssert(_) => return ()
        _ => return m.builtin(a, op, args, e, dst)
    }
}

/// `get`, `get_ptr`, `first` and `last` of arrays and slices.
get_builtin :: fn(m: ^Machine, a: Act, op: tir.Builtin, args: []Expr, e: ^Expr, dst: []u8) -> Flow!() needs Run {
    .Optional(inner) := m.kind(e.ty) else return !m.trap(e.span, "internal error: get with a result that is not optional")
    elem := inner
    if op is .GetPtr and .Ptr(_, pointee) := m.kind(inner) { elem = pointee }
    esz := m.size(elem)
    base := &args[0]
    mk := m.mark()
    ptr: u64 = 0
    len: u64 = 0
    owned := empty_slice(u8)
    host := false
    match m.kind(base.ty) {
        .Slice(_) => {
            b := m.tmp(m.size(base.ty))
            try m.eval(a, base, b)
            sp := m.slice_parts(b)
            ptr = sp.ptr
            len = sp.len
        }
        .Array(n, _, _) => {
            len = n
            if op is .GetPtr or is_place_expr(m, base) {
                match try m.place(a, base, op is .GetPtr) {
                    .Mem(addr), .Packed(addr) => { ptr = addr }
                    .Host(h) => {
                        owned = h
                        host = true
                    }
                    .Bits(_) => return !m.trap(e.span, "internal error: get on a #bits field")
                }
            } else {
                owned = m.tmp(m.size(base.ty))
                try m.eval(a, base, owned)
                host = true
            }
        }
        .Ptr(_, pointee) => {
            .Array(n, _, _) := m.kind(pointee) else return !m.trap(e.span, "internal error: get on a pointer")
            b := m.tmp(m.ptr_bytes)
            try m.eval(a, base, b)
            ptr = m.ptr_of(b)
            len = n
        }
        _ => return !m.trap(e.span, "internal error: get on a value without elements")
    }
    i: u64 = 0
    match op {
        .First => {}
        .Last => { i = len -% 1 }
        _ => { i = try m.eval_index(a, &args[1]) }
    }
    if i >= len {
        dst.fill(0)
        m.release(mk)
        return ()
    }
    if op is .GetPtr {
        pb: [8]u8 = [8]u8(0, 0, 0, 0, 0, 0, 0, 0)
        m.put_ptr(pb[..], ptr +% i * esz)
        m.make_some(e.ty, dst, pb[0..us(m.ptr_bytes)])
    } else if host {
        off := us(i * esz)
        m.make_some(e.ty, dst, owned[off..off + us(esz)])
    } else {
        v := m.tmp(esz)
        try m.load_at(e.span, ptr +% i * esz, m.align(elem), v)
        m.make_some(e.ty, dst, v)
    }
    m.release(mk)
}

/// The bytes of the string (a `[]const u8` slice) `b`.
read_string :: fn(m: ^Machine, span: source.Span, b: []const u8) -> Flow!string needs Alloc {
    sp := m.slice_parts(b)
    if sp.len is 0 { return "" }
    data := m.mem.read(sp.ptr, sp.len, 1) else e => return !m.mem_trap(span, e)
    out := make(u8, data.len)!
    out.copy_from(data)
    return out
}
