// Stand-ins for fiber.gm (fibers and continuations).

Fibers :: struct {}

fibers :: fn() -> Fibers => Fibers()

with_on :: fn(m: ^Machine, a: Act, w: tir.WithExpr, stack: []u8, e: ^Expr, dst: []u8) -> Flow!() needs Run => !m.unsupported(e.span, "`with … on`")

ctl_perform :: fn(m: ^Machine, span: source.Span, n: u32, op: u32, args: []const []u8, dst: []u8) -> Flow!() needs Run => !m.unsupported(span, "`ctl` operations")

resume_ :: fn(m: ^Machine, a: Act, k, v: ^Expr, e: ^Expr) -> Flow!() needs Run => !m.unsupported(e.span, "`resume`")

cancel_ :: fn(m: ^Machine, a: Act, k: ^Expr, e: ^Expr) -> Flow!() needs Run => !m.unsupported(e.span, "`cancel`")

fiber_builtin :: fn(m: ^Machine, a: Act, args: []Expr, e: ^Expr, dst: []u8) -> Flow!() needs Run => !m.unsupported(e.span, "`@fiber`")
