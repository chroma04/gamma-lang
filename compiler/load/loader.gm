//! Loading the modules of a program (§3.1, §3.2): the root module (a file or a
//! directory), the modules its imports name, transitively, and the packages they belong
//! to; collecting each module's top-level names (§3.4), including those in the taken
//! branches of top-level `when`s (§3.6); and rejecting import cycles.
//!
//! The order is fixed: module by module in the order they are
//! loaded, and each module's imports in the order of their declarations (which is the
//! order of the files, then of the declarations, with the branches of `when`s after the
//! rest). It decides the order of the source files, and with it the order of the
//! diagnostics.

ast :: import "../ast"
diag :: import "../diag"
fs :: import "std/fs"
hash_map :: import "std/collections/hash_map"
parse :: import "../parse"
source :: import "../source"
str :: import "std/str"
syntax :: import "../syntax"

pub Module :: struct {
    pub name: string
    /// The top-level declarations by name, in the order they were declared.
    pub scope: List(Named)
    /// The first declaration of each name of `scope` (see `add_named`).
    index: hash_map.HashMap(string, usize)
    /// True for the core library's modules, whose public names are in the universe scope.
    pub is_prelude: bool
    /// True for the standard library's modules (under the std root).
    pub is_std: bool
    /// The module's directory as written, for relative imports and messages.
    pub dir: string
    /// The package the module belongs to (an index into `Loader.packages`).
    pub package: usize
    /// The top-level `when`s not decided yet.
    pending_whens: List(ast.Item)
}

/// A name of a module's scope and its declaration.
pub Named :: struct {
    pub name: string
    pub decl: usize
}

/// How far an import declaration has been resolved.
pub DeclState :: union {
    Unresolved
    /// It names the module with this index.
    Module: usize
    Error
}

/// A top-level item that declares no name.
pub OtherItem :: struct {
    pub module: usize
    pub item: ast.Item
}

/// A top-level binding of some module.
pub Decl :: struct {
    pub name: ast.Ident
    pub module: usize
    pub item: ast.Item
    /// For an import: how far it has been resolved.
    pub state: DeclState
}

/// A package: its root directory and its dependencies by name.
Package :: struct {
    root: string
    deps: List(Dep)
}

pub Dep :: struct {
    pub name: string
    pub dir: string
}

/// Where every package of a dependency graph finds its dependencies (the package
/// manager's answer): the package directory (canonical) and its dependencies by name.
pub Resolution :: struct {
    pub packages: List(ResolvedPackage)
}

pub ResolvedPackage :: struct {
    pub dir: string
    pub deps: List(Dep)
}

/// The dependencies of the package whose root is `root`, if the resolution has them.
pub deps_of :: fn(res: ^const Resolution, root: string) -> ?List(Dep) {
    for p in res.packages.items {
        if p.dir is root { return p.deps }
    }
    return null
}

/// An import of module `to` by module `from`, written at `span`.
Edge :: struct {
    from: usize
    to: usize
    span: source.Span
}

/// A loaded module directory by its canonical path.
DirModule :: struct {
    key: string
    module: usize
}

/// An unsaved buffer that stands in for the file at `path` (canonical).
pub Overlay :: struct {
    pub path: string
    pub text: string
}

pub Loader :: struct {
    pub sm: ^source.SourceMap
    pub diags: ^diag.Diagnostics
    ids: ^ast.NodeId
    /// Lex with the layout recovery that tools use after errors.
    recover: bool
    /// Keep the root module even if loading it reported errors, so that editors can go on
    /// with what parsed.
    pub keep_going: bool = false
    /// Buffers that are read instead of the files on disk (`gammac lsp`).
    pub overlays: List(Overlay)
    /// The build mode, `target.mode` (§3.6): `Debug`, `Checked` or `Fast`.
    pub mode: string = "Debug"
    /// The machine the program is compiled for (`target`, §3.6).
    pub target: Target
    /// The standard library's directory, as given and in canonical form.
    pub std_root: string
    pub std_canon: string
    /// The working directory, for canonical paths.
    cwd: string
    pub modules: List(Module)
    pub decls: List(Decl)
    /// The top-level items other than bindings (tests, handler declarations and
    /// intrinsic calls), with their modules.
    pub other_items: List(OtherItem)
    /// The core prelude and the other core modules, once loaded.
    pub prelude: ?usize
    pub core_modules: List(usize)
    /// The git and archive dependencies the package manager resolved, if any.
    pub resolution: ?Resolution = null
    packages: List(Package)
    by_dir: List(DirModule)
    edges: List(Edge)
}

pub loader :: fn(sm: ^source.SourceMap, diags: ^diag.Diagnostics, ids: ^ast.NodeId, std_root: string, recover: bool) -> Loader needs Alloc + Fs {
    l := Loader(
        sm: sm,
        diags: diags,
        ids: ids,
        recover: recover,
        target: host_target(),
        overlays: list(Overlay),
        std_root: std_root,
        std_canon: std_root,
        cwd: working_dir(),
        modules: list(Module),
        decls: list(Decl),
        other_items: list(OtherItem),
        prelude: null,
        core_modules: list(usize),
        packages: list(Package),
        by_dir: list(DirModule),
        edges: list(Edge),
    )
    l.std_canon = l.canonicalize(std_root) else std_root
    return l
}

/// Loads the program rooted at `root` and returns its module graph in the format of
/// `gamma modules` (see `dump`), or `null` if the root module could not be loaded.
pub load_modules :: fn(l: ^Loader, root: string) -> ?string needs Alloc + Fs {
    _ = l.load_root(root) else return null
    done: usize = 0
    while done < l.modules.items.len {
        m := done
        done += 1
        if l.modules.items[m].is_prelude { continue }
        for d in l.imports_of(m) { l.resolve_import(d) }
    }
    l.check_import_cycles()
    return l.dump()
}

/// The import declarations of module `m`, in declaration order.
imports_of :: fn(l: ^const Loader, m: usize) -> []usize needs Alloc {
    out := list(usize)
    for n in l.modules.items[m].scope.items {
        if is_import(&l.decls.items[n.decl].item) { out.push(n.decl)! }
    }
    out.items.sort()
    return out.items
}

/// Whether `item` is a binding initialized by `import`.
is_import :: fn(item: ^const ast.Item) -> bool {
    .Binding(b) := item.kind else return false
    return b.init.kind is .Import(_)
}

// ---------------------------------------------------------------------------------
// The file system
// ---------------------------------------------------------------------------------

/// The working directory.
pub(package) working_dir :: fn() -> string needs Alloc + Fs {
    buf: [4096]u8 = ---
    n := Fs.cwd(buf[..]) else return "."
    return dupe(buf[0..n])!
}

pub(package) is_dir :: fn(p: string) -> bool needs Fs {
    info := Fs.stat(p) else return false
    return info.kind is .Dir
}

pub(package) is_file :: fn(p: string) -> bool needs Fs {
    info := Fs.stat(p) else return false
    return info.kind is .File
}

/// The canonical form of `p`: absolute and without `.` and `..`, or `null` if it does not
/// exist. (Symbolic links are not resolved.)
pub(package) canonicalize :: fn(l: ^const Loader, p: string) -> ?string needs Alloc + Fs {
    if Fs.stat(p) is !_ { return null }
    return normalize(join(l.cwd, p))
}

/// The `.gm` files directly in directory `dir`, or `null` if it cannot be read.
pub(package) module_files :: fn(dir: string) -> ?List(string) needs Alloc + Fs {
    if not is_dir(dir) { return null }
    paths := list(string)
    for r in fs.entries(dir) {
        e := r else return null
        if e.name.len > 3 and e.name.ends_with(".gm") {
            p := join(dir, e.name)
            if is_file(p) { paths.push(p)! }
        }
    }
    return paths
}

/// The text of the buffer that stands in for the file at `path`, if there is one.
pub overlay_text :: fn(l: ^const Loader, path: string) -> ?string needs Alloc + Fs {
    if l.overlays.items.len is 0 { return null }
    key := canonical_path(l, path)
    for o in l.overlays.items {
        if o.path is key { return o.text }
    }
    return null
}

/// The canonical form of `p`; for a file that does not exist (yet), its directory's
/// canonical form joined with its name.
pub canonical_path :: fn(l: ^const Loader, p: string) -> string needs Alloc + Fs {
    if c := l.canonicalize(p) { return c }
    name := file_name(p) else return p
    dir := parent(p) else return p
    if dir.len is 0 { return p }
    if c := l.canonicalize(dir) { return join(c, name) }
    return p
}

/// The `.gm` files of directory `dir`, counting the buffers (`overlays`) that stand in a
/// file of that directory, or `null` if it cannot be read and holds no buffer.
pub module_files_of :: fn(l: ^const Loader, dir: string) -> ?List(string) needs Alloc + Fs {
    paths := module_files(dir)
    if l.overlays.items.len is 0 { return paths }
    key := canonical_path(l, dir)
    out := paths else list(string)
    n := out.items.len
    for o in l.overlays.items {
        name := file_name(o.path) else continue
        if (parent(o.path) else "") is not key or not name.ends_with(".gm") or name.len <= 3 { continue }
        present := false
        for p in out.items[0..n] {
            if canonical_path(l, p) is o.path { present = true }
        }
        if not present { out.push(join(dir, name))! }
    }
    if paths is null and out.items.len is 0 { return null }
    return out
}

/// Reads and parses one source file; reports a file that cannot be read.
load_file :: fn(l: ^Loader, path: string) -> ?ast.File needs Alloc + Fs {
    if text := l.overlay_text(path) { return l.parse_text(path, text) }
    text := fs.read_all(path) else e => {
        l.diags.report(source.DUMMY, str.format("cannot read {}: {}", path, describe_read_error(e))!)
        return null
    }
    return l.parse_text(path, text)
}

/// Adds a source file named `name` to the source map and parses it.
parse_text :: fn(l: ^Loader, name, text: string) -> ast.File needs Alloc {
    id := l.sm.add(name, text)
    lexed := if l.recover { syntax.lex_recovering(id, text, l.diags) } else { syntax.lex(id, text, l.diags) }
    return parse.parse_file(id, &lexed, l.ids, l.diags)
}

pub describe_read_error :: fn(e: fs.ReadError) -> string => match e {
    .Io(io) => match io {
        .NotFound => "No such file or directory (os error 2)"
        .PermissionDenied => "Permission denied (os error 13)"
        _ => "the file cannot be read"
    }
    .Alloc(_) => "out of memory"
}

// ---------------------------------------------------------------------------------
// Modules
// ---------------------------------------------------------------------------------

/// Loads the root module: a single `.gm` file, or every `.gm` file directly inside a
/// directory (§3.1).
pub load_root :: fn(l: ^Loader, root: string) -> ?usize needs Alloc + Fs {
    if is_dir(root) or (not is_file(root) and l.module_files_of(root) is not null) {
        m := l.load_dir_module(root, source.DUMMY, null, null) else return null
        if l.diags.has_errors() and not l.keep_going { return null }
        return m
    }
    file := l.load_file(root) else return null
    if l.diags.has_errors() and not l.keep_going { return null }
    // `main.gm` has the empty path as its parent; the current directory is meant.
    dir := parent(root) else "."
    if dir.len is 0 { dir = "." }
    canon := l.canonicalize(dir) else dir
    package := l.package_of(canon, null)
    files := list(ast.File)
    files.push(file)!
    m := l.add_module(file_stem(root) else "main", files.items)
    l.modules.items[m].dir = dir
    l.modules.items[m].package = package
    l.collect_whens(m)
    return m
}

/// The module of directory `dir`, loading it the first time. `parent` is the package of
/// the module that imports it by a relative path. The module is named `name`, or else
/// after its directory.
load_dir_module :: fn(l: ^Loader, dir: string, at: source.Span, parent_package: ?usize, name: ?string) -> ?usize needs Alloc + Fs {
    key := l.canonicalize(dir) else dir
    for d in l.by_dir.items {
        if d.key is key { return d.module }
    }
    paths := l.module_files_of(dir) else {
        l.diags.report(at, str.format("cannot find the module directory {}", dir)!)
        return null
    }
    paths.items.sort()
    if paths.items.len is 0 {
        l.diags.report(at, str.format("the module directory {} has no `.gm` files", dir)!)
        return null
    }
    files := list(ast.File)
    for p in paths.items { files.push(l.load_file(p) else return null)! }
    module_name := name else (file_name(key) else "module")
    package := l.package_of(key, parent_package)
    m := l.add_module(module_name, files.items)
    l.modules.items[m].dir = dir
    // Standard library modules may use the system intrinsics, like the core library.
    l.modules.items[m].is_std = starts_with(key, l.std_canon)
    l.modules.items[m].package = package
    l.by_dir.push(DirModule(key: key, module: m))!
    // Its top-level `when`s are decided now that its directory is known.
    l.collect_whens(m)
    return m
}

/// Loads every module of the package of module `root` that is not loaded yet, so that
/// their tests are found. The directories of the package are searched in path order;
/// hidden ones, `target` and nested packages are skipped.
pub load_package_modules :: fn(l: ^Loader, root: usize) needs Alloc + Fs {
    package := l.modules.items[root].package
    package_root := l.packages.items[package].root
    // Relative to the working directory when inside it, so that the files are named as
    // the ones that imports load.
    start := package_root
    if rel := strip_prefix(package_root, l.cwd) { start = if rel.len is 0 { "." } else { rel } }
    root_dir := l.modules.items[root].dir
    root_key := l.canonicalize(root_dir) else root_dir
    dirs := list(string)
    dirs.push(start)!
    while dir := dirs.pop() {
        subdirs := list(string)
        readable := true
        for r in fs.entries(dir) {
            e := r else {
                readable = false
                break
            }
            p := join(dir, e.name)
            if is_dir(p) and not e.name.starts_with(".") and e.name is not "target" and not is_file(join(p, "gamma.toml")) {
                subdirs.push(p)!
            }
        }
        if not readable { continue }
        // The first directory searched comes last on the stack.
        subdirs.items.sort()
        subdirs.items.reverse()
        dirs.extend(subdirs.items)!
        key := l.canonicalize(dir) else dir
        if key is root_key { continue }
        loaded := false
        for d in l.by_dir.items {
            if d.key is key { loaded = true }
        }
        if loaded { continue }
        if files := module_files(dir) {
            if files.items.len > 0 { _ = l.load_dir_module(dir, source.DUMMY, package, null) }
        }
    }
}

/// Creates a module from parsed files and collects its top-level names. Its top-level
/// `when`s wait for `collect_whens`.
pub(package) add_module :: fn(l: ^Loader, name: string, files: []const ast.File) -> usize needs Alloc {
    id := l.modules.items.len
    l.modules.push(Module(
        name: name,
        scope: list(Named),
        index: hash_map.hash_map(string, usize),
        is_prelude: false,
        is_std: false,
        dir: "",
        package: 0,
        pending_whens: list(ast.Item),
    ))!
    for file in files {
        for item in file.items {
            if item.kind is .When(_) {
                l.modules.items[id].pending_whens.push(item)!
            } else {
                l.collect_item(id, item)
            }
        }
    }
    return id
}

/// Declares the items of the taken branch of each top-level `when` of module `id`, as if
/// written at top level (§3.6).
collect_whens :: fn(l: ^Loader, id: usize) needs Alloc {
    queue := l.modules.items[id].pending_whens
    l.modules.items[id].pending_whens = list(ast.Item)
    i: usize = 0
    while i < queue.items.len {
        item := queue.items[i]
        i += 1
        .When(w) := item.kind else continue
        branch: []const ast.Item = empty_slice(ast.Item)
        match l.when_cond(id, w.cond) {
            true => { branch = w.then }
            false => { branch = w.else_ else empty_slice(ast.Item) }
            null => {}
        }
        for it in branch {
            if it.kind is .When(_) {
                queue.push(it)!
            } else {
                l.collect_item(id, it)
            }
        }
    }
}

collect_item :: fn(l: ^Loader, module: usize, item: ast.Item) needs Alloc {
    .Binding(b) := item.kind else {
        l.other_items.push(OtherItem(module: module, item: item))!
        return
    }
    if b.names.len is not 1 {
        l.diags.report(b.span, "destructuring is not allowed at top level; bind each name separately")
        return
    }
    name := b.names[0]
    if name.name is "_" {
        l.diags.report(name.span, "`_` cannot be declared at top level")
        return
    }
    if is_reserved_type_name(name.name) {
        l.diags.report(name.span, str.format("`{}` is a reserved type name and cannot be redeclared", name.name)!)
        return
    }
    if prev := l.lookup(module, name.name) {
        // Files of one module may each import the same module under the same name
        // (§3.2): the repeated import is the same declaration.
        if l.same_import(prev, &item) { return }
        d := diag.error(name.span, str.format("`{}` is declared twice", name.name)!)
        d.add_label(l.decls.items[prev].name.span, "first declared here")
        l.diags.push(d)
        return
    }
    l.decls.push(Decl(name: name, module: module, item: item, state: .Unresolved))!
    l.add_named(module, name.name, l.decls.items.len - 1)
}

/// Adds declaration `decl` to module `module`'s scope under `name`.
add_named :: fn(l: ^Loader, module: usize, name: string, decl: usize) needs Alloc {
    m := &l.modules.items[module]
    m.scope.push(Named(name: name, decl: decl))!
    if not m.index.contains(name) { m.index.put(name, decl)! }
}

/// The declaration of `name` in module `module`'s scope: the first one, if several have
/// the name.
pub lookup :: fn(l: ^const Loader, module: usize, name: string) -> ?usize => l.modules.items[module].index.get(name)

/// Whether `item` is an import identical to declaration `prev`: the same path, the same
/// visibility, and no attributes or type annotation.
same_import :: fn(l: ^const Loader, prev: usize, item: ^const ast.Item) -> bool {
    d := &l.decls.items[prev]
    a := import_path(&d.item) else return false
    b := import_path(item) else return false
    return d.item.vis is item.vis and a is b
}

/// The path of an import binding without attributes or a type.
import_path :: fn(item: ^const ast.Item) -> ?string {
    if item.attrs.len > 0 { return null }
    .Binding(b) := item.kind else return null
    if b.ty is not null { return null }
    .Import(path) := b.init.kind else return null
    return path.bytes
}

/// Integer type names (`u1` to `u128`, `i1` to `i128`) and the other builtin type names
/// that cannot be declared (§B.3).
pub is_reserved_type_name :: fn(name: string) -> bool {
    if name in ("usize", "isize", "f16", "f32", "f64", "bool", "never", "type", "rawptr", "cont") { return true }
    if name.len < 2 or name[0] not in ('u', 'i') or name[1] is '0' or name.len > 4 { return false }
    bits: u32 = 0
    for c in name[1..] {
        if c not in '0'..='9' { return false }
        bits = bits * 10 + u32(c - '0')
    }
    return bits in 1..=128
}

// ---------------------------------------------------------------------------------
// Imports and packages
// ---------------------------------------------------------------------------------

/// Resolves the import declaration `id`, loading the module it names.
pub resolve_import :: fn(l: ^Loader, id: usize) needs Alloc + Fs {
    if l.decls.items[id].state is not .Unresolved { return }
    d := l.decls.items[id]
    .Binding(b) := d.item.kind else return
    // Loading the module adds declarations, which may move `l.decls`: the state is
    // computed before the place it goes to is (§4.7).
    state := l.import_decl(d.module, &d, &b)
    l.decls.items[id].state = state
}

import_decl :: fn(l: ^Loader, module: usize, d: ^const Decl, b: ^const ast.Binding) -> DeclState needs Alloc + Fs {
    if b.kind is .Var {
        e := diag.error(b.span, "top-level bindings are immutable; use `::` (mutable storage needs `#global`)")
        // `x := v` becomes `x :: v`.
        between := source.Span(file: b.span.file, lo: d.name.span.hi, hi: b.init.span.lo)
        text := l.sm.file(between.file).text[usize(between.lo)..usize(between.hi)]
        if b.ty is null and str.trim(text) is ":=" { e.add_fix("write `::`", between, " :: ") }
        l.diags.push(e)
        return .Error
    }
    if b.ty is not null {
        l.diags.report(b.init.span, "an import binding cannot have a type")
        return .Error
    }
    .Import(path) := b.init.kind else return .Error
    m := l.import_module(module, path.bytes, b.init.span) else return .Error
    return .Module(m)
}

/// `import "path"` written in `module`: the imported module (§3.2).
import_module :: fn(l: ^Loader, module: usize, path: string, at: source.Span) -> ?usize needs Alloc + Fs {
    from_dir := l.modules.items[module].dir
    package := l.modules.items[module].package
    relative := path.starts_with("./") or path.starts_with("../")
    name: ?string = null
    dir := ""
    if relative {
        dir = normalize(join(from_dir, path))
        canon := l.canonicalize(dir) else normalize(join(l.cwd, dir))
        if not starts_with(canon, l.packages.items[package].root) {
            l.diags.report(at, str.format("the import path `{}` leaves the package (§3.2)", path)!)
            return null
        }
    } else {
        first := path
        rest := ""
        if split := str.split_once(path, "/") {
            first = split.before
            rest = split.after
        }
        if rest.len > 0 and bad_rest(rest) {
            l.diags.report(at, str.format(
                "the import path `{}` leaves the directory of `{}`: after the first segment it may not contain empty, `..` or absolute components (§3.2)",
                path,
                first,
            )!)
            return null
        }
        base := l.std_root
        if first is not "std" {
            base = l.dep_dir(package, first) else {
                l.diags.report(at, str.format(
                    "unknown package `{}`: a path starts with `./`, `../`, `std/`, or a dependency listed in gamma.toml (§3.2)",
                    first,
                )!)
                return null
            }
            // A package's root module is named after the dependency, not after its
            // directory (a fetched git package lives in a directory named by revision).
            if rest.len is 0 { name = first }
        }
        dir = normalize(if rest.len is 0 { base } else { join(base, rest) })
    }
    m := l.load_dir_module(dir, at, if relative { package } else { null }, name) else return null
    l.edges.push(Edge(from: module, to: m, span: at))!
    return m
}

/// Whether the part of a package import path after its first segment has an empty or
/// `..` segment, or a backslash.
bad_rest :: fn(rest: string) -> bool {
    for c in str.split(rest, "/") {
        if c.len is 0 or c is ".." or '\\' in c { return true }
    }
    return false
}

/// The directory of dependency `name` of package `p`.
dep_dir :: fn(l: ^const Loader, p: usize, name: string) -> ?string {
    for d in l.packages.items[p].deps.items {
        if d.name is name { return d.dir }
    }
    return null
}

/// The package containing directory `dir`: the nearest enclosing directory with a
/// `gamma.toml`, or else the package `parent` of the importing module if `dir` lies inside
/// it, or else `dir` itself (a package without a manifest).
package_of :: fn(l: ^Loader, dir: string, parent_package: ?usize) -> usize needs Alloc + Fs {
    root := dir
    found: ?string = null
    cur: ?string = dir
    while d := cur {
        if is_file(join(d, "gamma.toml")) {
            found = d
            break
        }
        cur = parent(d)
    }
    if r := found {
        root = r
    } else if p := parent_package {
        if starts_with(dir, l.packages.items[p].root) { return p }
    }
    for i, p in enumerate(l.packages.items) {
        if p.root is root { return i }
    }
    deps := if is_file(join(root, "gamma.toml")) { l.read_manifest(root) } else { list(Dep) }
    l.packages.push(Package(root: root, deps: deps))!
    return l.packages.items.len - 1
}

/// The dependencies of the package in `root`: those the package manager resolved, or else
/// the path dependencies of its manifest.
read_manifest :: fn(l: ^Loader, root: string) -> List(Dep) needs Alloc + Fs {
    if res := l.resolution {
        if deps := deps_of(&res, root) { return deps }
    }
    deps := list(Dep)
    path := join(root, "gamma.toml")
    text := fs.read_all(path) else e => {
        l.diags.report(source.DUMMY, str.format("cannot read {}: {}", path, describe_read_error(e))!)
        return deps
    }
    manifest := parse_manifest(text) else e => {
        l.diags.report(source.DUMMY, str.format("{}:{}: {}", path, e.line, e.msg)!)
        return deps
    }
    for dep in manifest.deps.items {
        match dep.source {
            .Path(p) => { deps.push(Dep(name: dep.name, dir: join(root, p)))! }
            .Git(_) => { l.diags.report(source.DUMMY, str.format("{}:{}: dependency `{}` is a git dependency; run `gamma fetch`", path, dep.line, dep.name)!) }
            .Url(_) => { l.diags.report(source.DUMMY, str.format("{}:{}: dependency `{}` is a url dependency; run `gamma fetch`", path, dep.line, dep.name)!) }
        }
    }
    return deps
}

/// Reports each cycle in the import graph (§3.2).
pub check_import_cycles :: fn(l: ^Loader) needs Alloc {
    n := l.modules.items.len
    // 0 new, 1 on the stack, 2 done
    state := make(u8, n)!
    state.fill(0)
    stack := list(usize)
    for start in 0..n {
        if state[start] is 0 { l.visit(start, state, &stack) }
    }
}

visit :: fn(l: ^Loader, m: usize, state: []u8, stack: ^List(usize)) needs Alloc {
    state[m] = 1
    stack.push(m)!
    for e in l.edges.items {
        if e.from is not m { continue }
        if state[e.to] is 0 {
            l.visit(e.to, state, stack)
        } else if state[e.to] is 1 {
            i := stack.items.index_of(e.to) else 0
            names := list(string)
            for x in stack.items[i..] { names.push(l.modules.items[x].name)! }
            names.push(l.modules.items[e.to].name)!
            l.diags.report(e.span, str.format("import cycle: {}", str.join(names.items, " -> ")!)!)
        }
    }
    _ = stack.pop()
    state[m] = 2
}

// ---------------------------------------------------------------------------------
// The module graph
// ---------------------------------------------------------------------------------

/// The modules in load order: for each, its name, directory, package root, whether it
/// belongs to the standard library, and its imports in declaration order with the
/// directory of the module each names (or `error`). Paths use `/`; those in the standard
/// library start with `<std>`, and package roots are relative to the working directory
/// when they are inside it.
dump :: fn(l: ^const Loader) -> string needs Alloc {
    out := list(u8)
    for mi, m in enumerate(l.modules.items) {
        if m.is_prelude { continue }
        out.write("module {}\n  dir {}\n  package {}\n", m.name, l.show(m.dir), l.show(l.packages.items[m.package].root))!
        if m.is_std { out.extend("  std\n")! }
        for i in l.imports_of(mi) {
            d := &l.decls.items[i]
            target := match d.state {
                .Module(t) => l.show(l.modules.items[t].dir)
                _ => "error"
            }
            out.write("  import {} ", d.name.name)!
            syntax.escape_bytes(import_path_any(&d.item), &out)
            out.write(" {}\n", target)!
        }
    }
    return out.items
}

/// The path of an import binding (with or without attributes or a type).
import_path_any :: fn(item: ^const ast.Item) -> string {
    .Binding(b) := item.kind else return ""
    .Import(path) := b.init.kind else return ""
    return path.bytes
}

/// `p` for the module graph: with `<std>` for the standard library's directory, relative
/// to the working directory when inside it, and with `/` separators.
show :: fn(l: ^const Loader, p: string) -> string needs Alloc {
    if rest := strip_prefix(p, l.std_root) else strip_prefix(p, l.std_canon) {
        return slashes(if rest.len is 0 { "<std>/" } else { join("<std>", rest) })
    }
    if rest := strip_prefix(p, l.cwd) { return slashes(if rest.len is 0 { "." } else { rest }) }
    return slashes(p)
}

/// Adds a declaration that no top-level item of the module makes (a member of a
/// `foreign` block), named `name` in `module`'s scope.
pub(package) add_member :: fn(l: ^Loader, module: usize, name: ast.Ident, item: ast.Item) -> usize needs Alloc {
    l.decls.push(Decl(name: name, module: module, item: item, state: .Unresolved))!
    id := l.decls.items.len - 1
    l.add_named(module, name.name, id)
    return id
}
