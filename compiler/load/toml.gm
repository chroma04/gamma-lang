// A reader for the part of TOML (https://toml.io) that `gamma.toml` uses: tables and
// arrays of tables, dotted table names, bare and quoted keys, and values that are
// strings (basic and literal), integers, booleans, arrays and inline tables. Every entry
// remembers its line, for messages.

/// A TOML value.
pub(package) Value :: union {
    Str: string
    Int: i64
    Bool: bool
    Array: List(Value)
    Table: ^Table
    /// A float, date or time, kept as its text.
    Other: string
}

/// The entries of a table, in the order they were written.
pub(package) Table :: struct {
    pub(package) entries: List(Entry)
    /// Whether a header or an inline table has defined it.
    defined: bool = false
}

pub(package) Entry :: struct {
    pub(package) key: string
    pub(package) value: Value
    /// The line of the key, from 1.
    pub(package) line: usize
}

/// What went wrong, and on which line.
pub(package) TomlError :: struct {
    pub(package) line: usize
    pub(package) message: string
    /// The column of the error on its line, from 1.
    pub(package) col: usize = 1
}

pub(package) new_table :: fn() -> ^Table needs Alloc => new(Table(entries: list(Entry)))!

/// The entry `key` of `t`, if it has one.
pub(package) get :: fn(t: ^const Table, key: string) -> ?^Entry {
    for i in 0..t.entries.items.len {
        if t.entries.items[i].key is key { return &t.entries.items[i] }
    }
    return null
}

/// `v` as a string, if it is one.
pub(package) as_str :: fn(v: Value) -> ?string => match v {
    .Str(s) => s
    _ => null
}

/// `v` as a table, if it is one.
pub(package) as_table :: fn(v: Value) -> ?^Table => match v {
    .Table(t) => t
    _ => null
}

Reader :: struct {
    text: string
    pos: usize = 0
    line: usize = 1
    /// Whether the value just read was a number or a boolean.
    bare: bool = false
}

/// Parses a whole document into its root table. The messages are those of the TOML library
/// the reference implementation uses, as far as they matter to a `gamma.toml`.
pub(package) parse_toml :: fn(text: string) -> TomlError!^Table needs Alloc {
    r := Reader(text: text)
    root := new_table()
    current := root
    while true {
        r.skip_space_and_newlines()
        c := r.peek() else break
        if c is '[' {
            current = try r.table_header(root)
        } else {
            line := r.line
            path := try r.key_path()
            r.skip_space()
            if r.peek() is not '=' { return !r.error("key with no value, expected `=`") }
            r.pos += 1
            r.skip_space()
            v := try r.value()
            try insert_path(current, path.items, v, line)
        }
        try r.end_of_line()
    }
    return root
}

error :: fn(r: ^const Reader, message: string) -> TomlError {
    start: usize = 0
    i := r.pos
    while i > 0 {
        if r.text[i - 1] is '\n' {
            start = i
            break
        }
        i -= 1
    }
    return TomlError(line: r.line, message: message, col: r.pos - start + 1)
}

peek :: fn(r: ^const Reader) -> ?u8 => r.text.get(r.pos)

skip_space :: fn(r: ^Reader) {
    while r.peek() in (' ', '\t') { r.pos += 1 }
}

/// Skips blanks, comments and line ends.
skip_space_and_newlines :: fn(r: ^Reader) {
    while c := r.peek() {
        if c in (' ', '\t', '\r') {
            r.pos += 1
        } else if c is '\n' {
            r.pos += 1
            r.line += 1
        } else if c is '#' {
            while r.peek() is not null and r.peek() is not '\n' { r.pos += 1 }
        } else {
            return
        }
    }
}

/// After an entry or a header: blanks, an optional comment, and the end of the line.
end_of_line :: fn(r: ^Reader) -> TomlError!() {
    before := r.pos
    r.skip_space()
    if r.peek() is '#' {
        while r.peek() is not null and r.peek() is not '\n' { r.pos += 1 }
    }
    if r.peek() is '\r' { r.pos += 1 }
    if r.peek() is null { return () }
    if r.peek() is not '\n' {
        if r.bare and r.pos > before { return !r.error(QUOTED) }
        return !r.error("unexpected key or value, expected newline, `#`")
    }
    return ()
}

QUOTED :: "string values must be quoted, expected literal string"

/// `[a.b]` or `[[a.b]]`: the table that the following entries belong to.
table_header :: fn(r: ^Reader, root: ^Table) -> TomlError!^Table needs Alloc {
    r.pos += 1
    array := r.peek() is '['
    if array { r.pos += 1 }
    r.skip_space()
    line := r.line
    path := try r.key_path()
    r.skip_space()
    if r.peek() is not ']' { return !r.error(if array { "unclosed array table, expected `]`" } else { "unclosed table, expected `]`" }) }
    r.pos += 1
    if array {
        if r.peek() is not ']' { return !r.error("unclosed array table, expected `]`") }
        r.pos += 1
    }
    names := path.items
    t := root
    for i, name in enumerate(names) {
        last := i is names.len - 1
        if e := t.get(name) {
            if last and array {
                .Array(items) := e.value else return !r.error("duplicate key")
                fresh := new_table()
                grown := items
                grown.push(.Table(fresh))!
                e.value = .Array(grown)
                return fresh
            }
            match e.value {
                .Table(sub) => {
                    if last and not array and sub.defined { return !r.error("duplicate key") }
                    t = sub
                }
                .Array(items) if items.items.len > 0 => {
                    if last and not array { return !r.error("duplicate key") }
                    .Table(sub) := items.items[items.items.len - 1] else return !r.error("duplicate key")
                    t = sub
                }
                _ => return !r.error("duplicate key")
            }
        } else {
            fresh := new_table()
            if last and array {
                items := list(Value)
                items.push(.Table(fresh))!
                t.entries.push(Entry(key: name, value: .Array(items), line: line))!
            } else {
                t.entries.push(Entry(key: name, value: .Table(fresh), line: line))!
            }
            t = fresh
        }
    }
    t.defined = true
    return t
}

/// A key or dotted key: `name`, `"quoted"`, `a.b.c`.
key_path :: fn(r: ^Reader) -> TomlError!List(string) needs Alloc {
    path := list(string)
    while true {
        r.skip_space()
        path.push(try r.key())!
        r.skip_space()
        if r.peek() is not '.' { break }
        r.pos += 1
    }
    return path
}

key :: fn(r: ^Reader) -> TomlError!string needs Alloc {
    c := r.peek() else return !r.error("key with no value, expected `=`")
    if c in ('"', '\'') {
        return r.parse_string() else e => { return !TomlError(line: e.line, message: "key with no value, expected `=`") }
    }
    start := r.pos
    while k := r.peek() {
        if not (k in 'a'..='z' or k in 'A'..='Z' or k in '0'..='9' or k in ('_', '-')) { break }
        r.pos += 1
    }
    if r.pos is start { return !r.error("unquoted keys cannot be empty, expected letters, numbers, `-`, `_`") }
    return r.text[start..r.pos]
}

/// Adds `v` under the dotted key `path` of `t`.
insert_path :: fn(t: ^Table, path: []const string, v: Value, line: usize) -> TomlError!() needs Alloc {
    target := t
    for name in path[0..path.len - 1] {
        if e := target.get(name) {
            sub := as_table(e.value) else return !TomlError(line: line, message: "duplicate key")
            target = sub
        } else {
            fresh := new_table()
            target.entries.push(Entry(key: name, value: .Table(fresh), line: line))!
            target = fresh
        }
    }
    name := path[path.len - 1]
    if target.get(name) is not null { return !TomlError(line: line, message: "duplicate key") }
    target.entries.push(Entry(key: name, value: v, line: line))!
    return ()
}

value :: fn(r: ^Reader) -> TomlError!Value needs Alloc {
    r.bare = false
    c := r.peek() else return !r.error(QUOTED)
    match c {
        '"', '\'' => return Value.Str(try r.parse_string())
        '[' => return r.array()
        '{' => return r.inline_table()
        't' => {
            if not r.text[r.pos..].starts_with("true") { return !r.error("invalid boolean, expected `true`") }
            r.pos += 4
            r.bare = true
            return Value.Bool(true)
        }
        'f' => {
            if not r.text[r.pos..].starts_with("false") { return !r.error("invalid boolean, expected `false`") }
            r.pos += 5
            r.bare = true
            return Value.Bool(false)
        }
        '+', '-', '0'..='9' => return r.number()
        'i', 'n' => {
            rest := r.text[r.pos..]
            if rest.starts_with("inf") or rest.starts_with("nan") {
                r.pos += 3
                r.bare = true
                return Value.Other(rest[0..3])
            }
            return !r.error(QUOTED)
        }
        '=' => return !r.error("extra `=`, expected nothing")
        _ => return !r.error(QUOTED)
    }
}

/// An integer, or (kept as text) a float or a date.
number :: fn(r: ^Reader) -> TomlError!Value {
    start := r.pos
    r.bare = true
    negative := r.peek() is '-'
    if r.peek() in ('+', '-') { r.pos += 1 }
    if r.text[r.pos..].starts_with("inf") or r.text[r.pos..].starts_with("nan") {
        r.pos += 3
        return Value.Other(r.text[start..r.pos])
    }
    c := r.peek() else return !r.error(QUOTED)
    if c not in '0'..='9' { return !r.error(QUOTED) }
    radix: i64 = 10
    if c is '0' {
        if n := r.text.get(r.pos + 1) {
            if n is 'x' { radix = 16 } else if n is 'o' { radix = 8 } else if n is 'b' { radix = 2 }
        }
    }
    if radix is not 10 { r.pos += 2 }
    n: i64 = 0
    digits := 0
    last_underscore := false
    first := r.pos
    while d := r.peek() {
        if d is '_' {
            if digits is 0 or last_underscore { return !r.error("`_` may only go between digits, expected nothing") }
            last_underscore = true
            r.pos += 1
            continue
        }
        v: i64 = if d in '0'..='9' {
            i64(d - '0')
        } else if radix is 16 and d in 'a'..='f' {
            i64(d - 'a') + 10
        } else if radix is 16 and d in 'A'..='F' {
            i64(d - 'A') + 10
        } else {
            99
        }
        if v >= radix { break }
        if digits is 1 and r.text[first] is '0' and radix is 10 { return !r.error("unexpected leading zero, expected nothing") }
        n = n *? radix +? v else return !r.error("integer number overflowed")
        digits += 1
        last_underscore = false
        r.pos += 1
    }
    if last_underscore { return !r.error("`_` may only go between digits, expected nothing") }
    if digits is 0 { return !r.error("integer number overflowed") }
    // A float or a date: kept as text.
    if radix is 10 and r.peek() in ('.', 'e', 'E', '-', ':') {
        while k := r.peek() {
            if not (k in 'a'..='z' or k in 'A'..='Z' or k in '0'..='9' or k in ('.', ':', '-', '+', '_')) { break }
            r.pos += 1
        }
        return Value.Other(r.text[start..r.pos])
    }
    return Value.Int(if negative { -n } else { n })
}

/// A string: `"basic"` with escapes, `'literal'`, or the multi-line forms of both.
parse_string :: fn(r: ^Reader) -> TomlError!string needs Alloc {
    quote := r.text[r.pos]
    triple := r.text[r.pos..].starts_with(if quote is '"' { "\"\"\"" } else { "'''" })
    r.pos += if triple { 3 } else { 1 }
    kind := if quote is '"' { "basic" } else { "literal" }
    unclosed := if triple {
        str.format("invalid multi-line {} string, expected `{}`", kind, r.text[r.pos - 1..r.pos])!
    } else {
        str.format("invalid {} string, expected `{}`", kind, r.text[r.pos - 1..r.pos])!
    }
    out := list(u8)
    if triple {
        // A newline right after the opening quotes is not part of the string.
        if r.peek() is '\r' and r.text.get(r.pos + 1) is '\n' { r.pos += 1 }
        if r.peek() is '\n' {
            r.pos += 1
            r.line += 1
        }
    }
    while true {
        c := r.peek() else return !r.error(unclosed)
        if c is quote {
            if not triple {
                r.pos += 1
                break
            }
            if r.text[r.pos..].starts_with(if quote is '"' { "\"\"\"" } else { "'''" }) {
                r.pos += 3
                // Up to two more quotes belong to the string.
                extra := 0
                while extra < 2 and r.peek() is quote {
                    out.push(quote)!
                    r.pos += 1
                    extra += 1
                }
                break
            }
            out.push(c)!
            r.pos += 1
            continue
        }
        if c is '\n' {
            if not triple { return !r.error(unclosed) }
            r.line += 1
        }
        r.pos += 1
        if c is '\\' and quote is '"' {
            e := r.peek() else return !r.error(unclosed)
            r.pos += 1
            match e {
                'b' => out.push(8)!
                'e' => out.push(27)!
                'f' => out.push(12)!
                'n' => out.push('\n')!
                'r' => out.push('\r')!
                't' => out.push('\t')!
                '"', '\\' => out.push(e)!
                'x' => try r.hex_escape(&out, 2)
                'u' => try r.hex_escape(&out, 4)
                'U' => try r.hex_escape(&out, 8)
                ' ', '\t', '\r', '\n' => {
                    if not triple { return !r.error(MISSING_ESCAPE) }
                    // A backslash at the end of a line removes the white space after it.
                    r.pos -= 1
                    broke := false
                    while k := r.peek() {
                        if k is '\n' {
                            r.line += 1
                            broke = true
                        } else if k not in (' ', '\t', '\r') {
                            break
                        }
                        r.pos += 1
                    }
                    if not broke { return !r.error(MISSING_ESCAPE) }
                }
                _ => return !r.error(MISSING_ESCAPE)
            }
        } else {
            out.push(c)!
        }
    }
    return out.items
}

MISSING_ESCAPE :: "missing escaped value, expected `b`, `e`, `f`, `n`, `r`, `\\`, `\"`, `x`, `u`, `U`"

/// The `digits` hexadecimal digits of a `\u` escape, as UTF-8.
hex_escape :: fn(r: ^Reader, out: ^List(u8), digits: usize) -> TomlError!() needs Alloc {
    code: u32 = 0
    for _ in 0..digits {
        d := r.peek() else return !r.error("too few unicode value digits, expected unicode hexadecimal value")
        v: u32 = if d in '0'..='9' {
            u32(d - '0')
        } else if d in 'a'..='f' {
            u32(d - 'a') + 10
        } else if d in 'A'..='F' {
            u32(d - 'A') + 10
        } else {
            return !r.error("too few unicode value digits, expected unicode hexadecimal value")
        }
        code = code * 16 + v
        r.pos += 1
    }
    if code > 0x10ffff or (code >= 0xd800 and code < 0xe000) { return !r.error("invalid unicode value, expected a unicode scalar value") }
    if code < 0x80 {
        out.push(code.trunc(u8))!
    } else if code < 0x800 {
        out.push((0xc0 | (code >> 6)).trunc(u8))!
        out.push((0x80 | (code & 0x3f)).trunc(u8))!
    } else if code < 0x10000 {
        out.push((0xe0 | (code >> 12)).trunc(u8))!
        out.push((0x80 | ((code >> 6) & 0x3f)).trunc(u8))!
        out.push((0x80 | (code & 0x3f)).trunc(u8))!
    } else {
        out.push((0xf0 | (code >> 18)).trunc(u8))!
        out.push((0x80 | ((code >> 12) & 0x3f)).trunc(u8))!
        out.push((0x80 | ((code >> 6) & 0x3f)).trunc(u8))!
        out.push((0x80 | (code & 0x3f)).trunc(u8))!
    }
    return ()
}

/// `e` as if it were on `line`.
at_line :: fn(e: TomlError, line: usize) -> TomlError => TomlError(line: line, message: e.message, col: e.col)

/// `[a, b, …]`, which may span lines and end with a comma.
array :: fn(r: ^Reader) -> TomlError!Value needs Alloc {
    first_line := r.line
    r.pos += 1
    items := list(Value)
    while true {
        r.skip_space_and_newlines()
        if r.peek() is ']' { break }
        if r.peek() is null { return !at_line(r.error("unclosed array, expected `]`"), first_line) }
        if r.peek() is ',' { return !r.error("extra comma in array, expected value") }
        items.push(try r.value())!
        before := r.pos
        r.skip_space_and_newlines()
        if r.peek() is ',' {
            r.pos += 1
        } else if r.peek() is not ']' {
            if r.peek() is null { return !at_line(r.error("unclosed array, expected `]`"), first_line) }
            if r.bare and r.pos > before { return !r.error(QUOTED) }
            return !r.error("unclosed array, expected `]`")
        }
    }
    r.pos += 1
    r.bare = false
    return Value.Array(items)
}

/// `{ key = value, … }` on one line.
inline_table :: fn(r: ^Reader) -> TomlError!Value needs Alloc {
    r.pos += 1
    t := new_table()
    t.defined = true
    while true {
        r.skip_space_and_newlines()
        if r.peek() is '}' { break }
        if r.peek() is null { return !r.error("unclosed inline table, expected `}`") }
        line := r.line
        path := try r.key_path()
        r.skip_space_and_newlines()
        if r.peek() is not '=' { return !r.error("key with no value, expected `=`") }
        r.pos += 1
        r.skip_space_and_newlines()
        v := try r.value()
        try insert_path(t, path.items, v, line)
        r.skip_space_and_newlines()
        if r.peek() is '}' { break }
        if r.peek() is null { return !r.error("unclosed inline table, expected `}`") }
        if r.peek() is not ',' { return !r.error("extra assignment between key-value pairs, expected `,`") }
        r.pos += 1
    }
    r.pos += 1
    r.bare = false
    return Value.Table(t)
}

test "toml documents" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        doc := ok(parse_toml(``[package]
name = "app"   # the name
version = "0.1.0"

[dependencies]
json = { path = "../json" }
"util" = { git = "https://example.com/u.git", tag = "v1" }

[build]
cflags = [
    "-O2",
    "-DX=1",
]

[[package.authors]]
name = 'a'
[[package.authors]]
name = 'b'
``))
        pkg := as_table(doc.get("package")?.value)?
        expect_eq(as_str(pkg.get("name")?.value), "app")
        deps := as_table(doc.get("dependencies")?.value)?
        expect_eq(deps.entries.items.len, 2)
        expect_eq(deps.entries.items[1].key, "util")
        expect_eq(deps.entries.items[1].line, 7)
        json := as_table(deps.get("json")?.value)?
        expect_eq(as_str(json.get("path")?.value), "../json")
        build := as_table(doc.get("build")?.value)?
        .Array(flags) := build.get("cflags")?.value else return
        expect_eq(flags.items.len, 2)
        .Array(authors) := pkg.get("authors")?.value else return
        expect_eq(authors.items.len, 2)
        bad := parse_toml("x = \n")
        expect(bad is !_)
    }
}

arena :: import "std/arena"
str :: import "std/str"
