//! gammac: the Gamma compiler written in Gamma.
//!
//!     gammac lex [--diag-format=short|json] [--recover] FILE...
//!
//! `lex` prints the tokens of each file in the format of `gamma lex`, and its diagnostics
//! to standard error in the chosen format (default `short`). With several files, the
//! output of each is preceded by a line `==> FILE <==` on both streams. `--recover`
//! lexes with the layout heuristic that tools use after errors. The exit status is 1
//! if a file has errors, 2 for a usage error or a file that cannot be read.

diag :: import "./diag"
fs :: import "std/fs"
source :: import "./source"
syntax :: import "./syntax"
arena :: import "std/arena"

USAGE :: "usage: gammac lex [--diag-format=short|json] [--recover] FILE...\n"

main :: fn() needs Alloc + Env + Err + Fs + Out {
    args := Env.args()
    if args.len < 2 or args[1] is not "lex" {
        Err.write(USAGE)
        Env.exit(2)
    }
    format := diag.Format.Short
    recover := false
    files := list(string)
    defer files.deinit()
    for a in args[2..] {
        if a is "--diag-format=short" {
            format = .Short
        } else if a is "--diag-format=json" {
            format = .Json
        } else if a is "--recover" {
            recover = true
        } else if a.starts_with("-") {
            Err.write(USAGE)
            Env.exit(2)
        } else {
            files.push(a)!
        }
    }
    if files.items.len is 0 {
        Err.write(USAGE)
        Env.exit(2)
    }
    status: u8 = 0
    for path in files.items {
        if files.items.len > 1 {
            print("==> {} <==\n", path)
            eprint("==> {} <==\n", path)
        }
        match lex_file(path, format, recover) {
            !_ => {
                eprint("gammac: cannot read `{}`\n", path)
                status = 2
            }
            false => {
                if status is 0 { status = 1 }
            }
            true => {}
        }
    }
    if status is not 0 { Env.exit(status) }
}

/// Lexes one file and prints its tokens and diagnostics. Returns whether it had no
/// errors.
lex_file :: fn(path: string, format: diag.Format, recover: bool) -> fs.ReadError!bool needs Alloc + Err + Fs + Out {
    text := try fs.read_all(path)
    defer free(text)
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        sm := source.source_map()
        id := sm.add(path, text)
        diags := diag.diagnostics()
        lexed := if recover { syntax.lex_recovering(id, text, &diags) } else { syntax.lex(id, text, &diags) }
        out := list(u8)
        syntax.dump_tokens(sm.file(id), lexed.tokens.items, &out)
        Out.write(out.items)
        out.clear()
        diags.sort()
        for d in diags.list.items { diag.render(&sm, &d, format, &out) }
        Err.write(out.items)
        return not diags.has_errors()
    }
}
