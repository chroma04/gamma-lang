//! gamma: the Gamma compiler, written in Gamma.
//!
//!     gamma lex [--recover] FILE...
//!     gamma parse [--recover] [--dump] FILE...
//!     gamma modules ROOT...
//!     gamma decls ROOT...
//!     gamma tir ROOT...
//!     gamma check [--target=TRIPLE] ROOT...
//!     gamma lint [--fix] [--rules] [--allow=RULES] [--warn=RULES] [--deny=RULES] [-D] ROOT
//!     gamma fix ROOT
//!     gamma build [--mode=debug|checked|safe|fast] [--target=TRIPLE] [-g] [-o EXE] [--emit-c] ROOT
//!     gamma run [--mode=debug|checked|safe|fast] [--target=TRIPLE] [-g] [--backend=c|interp] ROOT [ARG...]
//!     gamma test [--filter=TEXT] [--all] [--show-output] [--jobs=N] [--timeout=SECONDS] [--time] [--mode=...] [--target=TRIPLE] ROOT
//!     gamma bench [--filter=TEXT] [--all] [--show-output] [--timeout=SECONDS] [--mode=...] [--target=TRIPLE] ROOT
//!     gamma new|init|fetch|update|add|remove|cache ...      (the package manager)
//!     gamma fmt [--check] FILE|DIR...
//!     gamma doc [--format=markdown|html] [-o PATH] [--all] [--missing] MODULE
//!     gamma repl [--quiet] [--mode=debug|checked|safe|fast] [FILE]
//!     gamma lsp
//!     gamma help | version
//!
//! `check`, `build` and `run` also take `--offline`, `--locked` and `--profile=NAME`, and
//! read the package's `gamma.toml` (`pkg/`).
//!
//! Every command takes `--diag-format=human|short|json` (default `human`), the formats of
//! `gamma`; `doc` has its own options and diagnostics (`doc/doc.gm`). See `USAGE` for what
//! each command does and `docs/self-hosting.md` for how the compiler is built. With several files, the output of each is
//! preceded by a line `==> FILE <==` on both streams. The exit status is 1 if a file has
//! errors, 2 for a usage error or a file that cannot be read; `run` ends with the
//! program's status, and `test` and `bench` with 1 if a test fails.

arena :: import "std/arena"
ast :: import "./ast"
check :: import "./check"
diag :: import "./diag"
doc :: import "./doc"
driver :: import "./driver"
fmt :: import "./fmt"
fix :: import "./fix"
fs :: import "std/fs"
lint :: import "./lint"
linting :: import "./linting"
load :: import "./load"
lsp :: import "./lsp"
parse :: import "./parse"
pkg :: import "./pkg"
repl :: import "./repl"
sema :: import "./sema"
source :: import "./source"
str :: import "std/str"
syntax :: import "./syntax"
testing :: import "./testing"
thread :: import "std/thread"
fiber :: import "std/fiber"

VERSION :: "0.1.0"

USAGE :: `
usage: gamma <command> [options] <file>

commands:
  lex     print the tokens of source files
  parse   check the syntax of source files (--dump prints the syntax tree)
  modules load a program's modules without checking them and print the module graph
  decls   resolve a program's declarations without checking bodies and print them
  tir     check a program and print the typed program the checker produces
  check   type-check a program (a .gm file or a module directory)
  doc     write the API documentation of a module as Markdown or HTML (gamma doc --help)
  lint    check a package with its tests and report the findings of the lint rules
  fix     check a program and apply the fixes its diagnostics suggest
  build   compile a program to a native executable via the system C compiler
  run     compile a program via C and run it, or run it in the interpreter (--backend=interp);
          arguments after the file go to the program
  test    run the test declarations of a module and of the modules of its package
          that it imports, compiled into one executable via C
  bench   run the bench declarations the same way and report the time per run
          (compiled in fast mode unless --mode is given)
  new, init, fetch, update, add, remove, cache
          the package manager (gamma help)
  fmt     format source files in place: gamma fmt [--check] <file or directory>... ("-" filters stdin to stdout)
  repl    interactive read-eval-print loop on the interpreter: gamma repl [--quiet] [file]
          (loads the file's declarations)
  lsp     run the language server on standard input and output
  help    print this message
  version print the compiler version

options:
  --diag-format=human|short|json
                              how to print diagnostics (default: human)
  --quiet                     (repl) no banner and prompts, even on a terminal
  --recover                   (lex, parse) lex with the layout recovery tools use after errors
  --dump                      (parse) print the syntax tree
  --mode=debug|checked|safe|fast
                              (build, run, test, bench, repl) the build mode (default: debug); safe builds
                              with Fil-C
  --target=<triple>           (check, build, run, test, bench) the target (default: the C compiler's)
  -g                          (build, run) add debug information that maps the executable back to the
                              Gamma source (build also writes the lldb formatters, gamma_lldb.py,
                              next to the executable)
  -o <file>                   (build) the executable to write (default: the input's name)
  --emit-c                    (build) stop after writing the C file (<exe>.c)
  --filter=<text>             (test, bench) run only the tests whose name or module path
                              contains <text>
  --all                       (test, bench) also run those of the modules of the package
                              that nothing imports (every directory with .gm files)
  --package=<name>            (test, bench) run those of the dependency <name> of the input's
                              package (or of one of its dependencies) instead, with the
                              dependency versions this package locks
  --show-output               (test, bench) also print the output of the tests that pass
  --jobs=<n>, -j <n>          (test) run <n> tests at a time (default 1; 0: one per processor;
                              the output is still in order)
  --timeout=<seconds>         (test, bench) fail a test that runs longer than <seconds> (no
                              limit by default)
  --time                      (test, bench) print how long each test took and the total
  --coverage[=<file>]         (test) count the lines of the package that the tests run; print
                              a table, and with <file> write LCOV
  --backend=c|interp          (run) compile via C (the default) or run in the interpreter;
                              (test, bench) only c is accepted
  --offline                   (check, run, build) never use the network for dependencies
  --locked                    (check, run, build) fail if gamma.lock is missing or out of date
  --profile=<name>            (check, run, build) use the [profile.<name>] table of gamma.toml
  --fix                       (lint) apply the fixes of the warnings that have one
  --rules                     (lint) list the rules and their default levels
  --allow=<rules>, --warn=<rules>, --deny=<rules>
                              (lint) set the level of rules (comma-separated; all is every rule)
  -D, --deny-warnings         (lint) report every rule that would warn as an error

environment:
  GAMMA_STD      the standard library (default: lib/gamma/std next to bin/)
  GAMMA_CORE     the core library (default: core next to the standard library)
  GAMMA_RUNTIME  the runtime's C sources (default: runtime two levels above the standard library)
  CC             the C compiler (default: cc), with its arguments
  CFLAGS         flags for every C compile, LDFLAGS flags for the link (after those of gamma.toml)
  GAMMA_CACHE_DIR
                 the package store (default: the user's cache directory; empty turns it off)
  GAMMA_C_UNITS  the number of C units of a Debug build (default: by size and processors)
  GAMMA_RUNNER   the program that runs the executables of another target (e.g. qemu-s390x)
  WASI_SDK_PATH  the WASI SDK (for wasm32-wasi; its clang is the default C compiler there)
  WASM_OPT       the wasm-opt program (default: wasm-opt) for programs that use fibers

`

/// The compiler's stack. Its passes recurse over the syntax tree, so a long operator chain
/// or deeply nested code needs more than a thread's default; the memory is only reserved.
COMPILER_STACK: usize : 1 << 30

libc :: foreign "c" {
    calloc :: fn(n, size: usize) -> ?[^]u8 needs not
    free :: fn(p: [^]u8) needs not
}

main :: fn() needs Alloc + Clock + Env + Err + Fs + In + Out + Proc + Rand + Sys {
    // Zeroed blocks of this size come from fresh pages: they cost memory only as they are used.
    p := libc.calloc(1, COMPILER_STACK) else {
        compiler_main()
        return
    }
    defer libc.free(p)
    sched := fiber.scheduler()
    defer sched.deinit()
    with &sched on p[0..COMPILER_STACK] {
        compiler_main()
        fiber.Sched.join()
    }
}

compiler_main :: fn() needs Alloc + Clock + Env + Err + Fs + In + Out + Proc + Rand + Sys {
    args := Env.args()
    check_arguments_are_text(args)
    command := args.get(1) else ""
    if command is "fmt" { Env.exit(fmt.command(args[2..])) }
    if topic := help_topic(args) {
        if pkg.is_package_command(topic) or topic is "packages" {
            print("{}\n{}", USAGE, pkg.USAGE)
            return
        }
        help := [1]string("--help")
        if topic is "doc" { Env.exit(doc.command(help[..])) }
        if topic is "fmt" { Env.exit(fmt.command(help[..])) }
    }
    if pkg.is_package_command(command) { Env.exit(pkg.run_command("gamma", command, args[2..])) }
    if command in ("help", "--help", "-h") {
        Out.write(USAGE)
        return
    }
    if command in ("version", "--version") {
        print("gamma {}\n", VERSION)
        return
    }
    if command is "doc" { Env.exit(doc.command(args[2..])) }
    if command is "lsp" {
        if args.len > 2 and args[2] in ("--help", "-h") {
            Out.write(USAGE)
            return
        }
        if args.len > 2 { usage_error(str.format("unknown option `{}`", args[2])!) }
        Env.exit(lsp.command())
    }
    if command is "repl" {
        match repl.parse_options(args[2..]) {
            .Help => {
                Out.write(USAGE)
                return
            }
            .Bad(message) => usage_error(message)
            .Run(o) => {
                ro := o
                ro.version = VERSION
                Env.exit(repl.command_run(ro))
            }
        }
    }
    opts := driver.Options(command: match command {
        "lex" => .Lex
        "parse" => .Parse
        "modules" => .Modules
        "decls" => .Decls
        "tir" => .Tir
        "check" => .Check
        "lint" => .Lint
        "fix" => .Fix
        "build" => .Build
        "run" => .Run
        "test" => .Test
        "bench" => .Bench
        "" => usage_error("missing command")
        _ => usage_error(str.format("unknown command `{}`", command)!)
    }, target: load.host_target(), lint: lint.options())
    // Benchmarks are about speed: compiled without checks, unless asked otherwise.
    if opts.command is .Bench { opts.mode = .Fast }
    files := list(string)
    defer files.deinit()
    i: usize = 2
    while i < args.len {
        a := args[i]
        i += 1
        // What follows the file of `gammac run` is the program's.
        if opts.command is .Run and files.items.len > 0 {
            opts.program_args = args[i - 1..]
            break
        }
        match a {
            "--help", "-h" => {
                Out.write(USAGE)
                return
            }
            "--mode=debug" => {
                opts.mode = .Debug
                opts.mode_given = true
            }
            "--mode=checked" => {
                opts.mode = .Checked
                opts.mode_given = true
            }
            "--mode=safe" => {
                opts.mode = .Safe
                opts.mode_given = true
            }
            "--mode=fast" => {
                opts.mode = .Fast
                opts.mode_given = true
            }
            "--offline" => { opts.offline = true }
            "--locked" => { opts.locked = true }
            "-o" => {
                if i >= args.len { usage_error("`-o` needs a file name") }
                opts.out = args[i]
                i += 1
            }
            "--emit-c" => { opts.emit_c = true }
            "--all" => { opts.all = true }
            "--show-output" => { opts.show_output = true }
            "--time" => { opts.time = true }
            "-j", "--jobs" => {
                if i >= args.len { usage_error(str.format("`{}` needs a number", a)!) }
                opts.jobs = parse_jobs(args[i])
                i += 1
            }
            "--backend=c" => { opts.interp = false }
            "--backend=interp" => {
                if opts.command is not .Run { usage_error("`--backend=interp` is supported by `run` only: the other commands use the C back end") }
                opts.interp = true
            }
            "-g" => {
                opts.debug_info = true
                opts.debug_info_given = true
            }
            "--diag-format=human" => { opts.format = .Human }
            "--diag-format=short" => { opts.format = .Short }
            "--diag-format=json" => { opts.format = .Json }
            "--recover" => { opts.recover = true }
            "--dump" => { opts.dump = true }
            _ => {
                if opts.command is .Lint {
                    match lint.parse_arg(&opts.lint, a) {
                        .Yes => continue
                        .Bad(message) => usage_error(message)
                        .No => {}
                    }
                }
                if a.starts_with("--timeout=") {
                    opts.timeout = parse_timeout(a[10..])
                    continue
                }
                if a.starts_with("--jobs=") {
                    opts.jobs = parse_jobs(a[7..])
                    continue
                }
                if a.starts_with("--filter=") {
                    opts.filter = a[9..]
                    continue
                }
                if a.starts_with("--backend=") {
                    value := a[10..]
                    if value is "cranelift" { usage_error("`--backend=cranelift` is not supported: gamma has the C back end and, for `run`, the interpreter") }
                    usage_error(str.format("invalid value `{}` for --backend (expected c, cranelift or interp)", value)!)
                }
                if a is "--coverage" {
                    opts.coverage = true
                    continue
                }
                if a.starts_with("--coverage=") {
                    opts.coverage = true
                    opts.coverage_file = a[11..]
                    continue
                }
                if a.starts_with("--package=") {
                    opts.package = a[10..]
                    continue
                }
                if a.starts_with("--target=") {
                    if a.len is 9 { usage_error("`--target=` needs a target triple") }
                    if opts.command in (driver.Command.Lint, driver.Command.Fix) { usage_error("`--target` is not supported by `lint` and `fix`") }
                    opts.target_triple = a[9..]
                    continue
                }
                if a.starts_with("--profile=") {
                    if a.len is 10 { usage_error("`--profile=` needs a profile name") }
                    opts.profile = a[10..]
                    continue
                }
                if a.starts_with("--mode=") { usage_error(str.format("invalid value `{}` for --mode (expected debug, checked, safe or fast)", a[7..])!) }
                if a.starts_with("--diag-format=") { usage_error(str.format("invalid value `{}` for --diag-format (expected human, short or json)", a[14..])!) }
                if a.starts_with("-") { usage_error(str.format("unknown option `{}`", a)!) }
                files.push(a)!
            }
        }
    }
    if opts.command is .Lint and opts.lint.rules {
        linting.list_rules()
        return
    }
    if files.items.len is 0 { usage_error("no input file") }
    if opts.command in (driver.Command.Build, driver.Command.Run, driver.Command.Lint, driver.Command.Fix, driver.Command.Test, driver.Command.Bench) and files.items.len > 1 { usage_error("more than one input file given") }
    status: u8 = 0
    for path in files.items {
        if files.items.len > 1 {
            print("==> {} <==\n", path)
            eprint("==> {} <==\n", path)
        }
        match process_file(path, opts) {
            !_ => {
                eprint("gamma: cannot read `{}`\n", path)
                status = 2
            }
            code => {
                if status is 0 { status = code }
            }
        }
    }
    if status is not 0 { Env.exit(status) }
}

/// The number of tests to run at once: `--jobs=n`, where 0 means one per processor.
parse_jobs :: fn(text: string) -> usize needs Alloc + Env + Err + Sys {
    if str.contains(text, "_") { usage_error(str.format("`--jobs` needs a number, not `{}`", text)!) }
    n := str.parse_int(usize, text) else usage_error(str.format("`--jobs` needs a number, not `{}`", text)!)
    return if n is 0 { usize(thread.cpu_count()) } else { n }
}

/// The time limit of a test: `--timeout=seconds`, a positive number.
parse_timeout :: fn(text: string) -> f64 needs Alloc + Env + Err {
    seconds := if str.contains(text, "_") { 0.0 } else { str.parse_float(f64, text) else 0.0 }
    if seconds > 0.0 and seconds < 1e9 { return seconds }
    usage_error(str.format("`--timeout` needs a positive number of seconds, not `{}`", text)!)
}

/// Reports a usage error for an argument of gamma itself that is not valid UTF-8. What
/// follows the file of `gamma run` belongs to the program, which receives it as it is.
check_arguments_are_text :: fn(args: []const string) needs Alloc + Env + Err {
    command := args.get(1) else return
    i: usize = 1
    while i < args.len {
        a := args[i]
        if not a.utf8_valid() {
            usage_error(str.format("argument {} is not valid UTF-8", i)!)
        }
        i += 1
        if command is "run" and i > 2 and not a.starts_with("-") { break }
    }
}

/// The command whose help `gammac help COMMAND` or `gammac COMMAND --help` asks for.
help_topic :: fn(args: []const string) -> ?string {
    command := args.get(1) else return null
    if command is "help" { return args.get(2) }
    for a in args[2..] {
        if a in ("--help", "-h") { return command }
    }
    return null
}

usage_error :: fn(message: string) -> never needs Env + Err {
    eprint("gamma: {}\n\n", message)
    Err.write(USAGE)
    Env.exit(2)
}

/// Runs the command on one file and prints its output and diagnostics. Returns the exit
/// status for the file: 0 if it had no errors.
process_file :: fn(path: string, in_opts: driver.Options) -> fs.ReadError!u8 needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    opts := in_opts
    if opts.command in (driver.Command.Check, driver.Command.Build, driver.Command.Run, driver.Command.Test, driver.Command.Bench, driver.Command.Lint, driver.Command.Fix) {
        apply_build_settings(path, &opts) else e => {
            eprint("gamma: {}\n", e)
            return 1
        }
    }
    if opts.command in (driver.Command.Lint, driver.Command.Fix) { return lint_or_fix(path, opts) }
    if opts.command not in (driver.Command.Lex, driver.Command.Parse) { return load_program(path, opts) }
    text := try fs.read_all(path)
    defer free(text)
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        sm := source.source_map()
        id := sm.add(path, text)
        diags := diag.diagnostics()
        lexed := if opts.recover { syntax.lex_recovering(id, text, &diags) } else { syntax.lex(id, text, &diags) }
        out := list(u8)
        if opts.command is .Lex {
            syntax.dump_tokens(sm.file(id), lexed.tokens.items, &out)
        } else {
            next_id: ast.NodeId = 0
            tree := parse.parse_file(id, &lexed, &next_id, &diags)
            if opts.dump { ast.dump_file(&tree, &out) }
        }
        Out.write(out.items)
        render(&sm, &diags, opts.format)
        return if diags.has_errors() { 1 } else { 0 }
    }
}

/// Applies the build settings of the package that holds `input` (the `[build]` table of
/// its `gamma.toml` and the selected profile) under the command line: an option given
/// there wins.
apply_build_settings :: fn(input: string, opts: ^driver.Options) -> string!() needs Alloc + Fs {
    settings := (try pkg.root_settings(input, opts.profile)) else return ()
    if not opts.mode_given {
        if m := settings.mode {
            opts.mode = match m {
                .Debug => driver.Mode.Debug
                .Checked => driver.Mode.Checked
                .Safe => driver.Mode.Safe
                .Fast => driver.Mode.Fast
            }
        }
    }
    if not opts.debug_info_given {
        if d := settings.debug_info { opts.debug_info = d }
    }
    opts.manifest_cflags = settings.cflags else empty_slice(string)
    opts.manifest_ldflags = settings.ldflags else empty_slice(string)
    return ()
}

/// Fetches the dependencies of the package that holds `input` and tells the loader where
/// they are. Returns what the packages add to a native build, or `null` after an error.
prepare_packages :: fn(input: string, opts: driver.Options, l: ^load.Loader) -> ?pkg.Extras needs Alloc + Clock + Env + Err + Fs + Proc + Rand {
    p := pkg.prepare_build(input, pkg.Options(offline: opts.offline, locked: opts.locked), opts.profile) else return null
    l.resolution = p.resolution
    return p.extras
}

/// Prints the diagnostics to standard error, in order, and empties the list.
render :: fn(sm: ^const source.SourceMap, diags: ^diag.Diagnostics, format: diag.Format) needs Alloc + Err {
    out := list(u8)
    diags.sort()
    for d in diags.list.items { diag.render(sm, &d, format, &out) }
    Err.write(out.items)
    diags.list.clear()
}

/// `lint` and `fix`: they load the program themselves, once for each round of fixes.
lint_or_fix :: fn(path: string, opts: driver.Options) -> u8 needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    std := driver.std_root()
    packages := pkg.Options(offline: opts.offline, locked: opts.locked)
    setup := fix.Setup(std: std, core: driver.core_root(std), mode: driver.mode_name(opts.mode), recover: opts.recover, format: opts.format, packages: packages, profile: opts.profile)
    if opts.command is .Fix { return fix.command(path, setup) }
    return linting.command(path, &opts.lint, setup)
}

/// The commands that load a program: loads the program rooted at `root`, runs the
/// command on it and prints its output and diagnostics. Returns the exit status.
load_program :: fn(input: string, in_opts: driver.Options) -> u8 needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        sm := source.source_map()
        diags := diag.diagnostics()
        next_id: ast.NodeId = 0
        std := driver.std_root()
        opts := in_opts
        // The C toolchain and the target it compiles for, before anything is loaded.
        if opts.command in (driver.Command.Check, driver.Command.Build, driver.Command.Run, driver.Command.Test, driver.Command.Bench) {
            driver.new_session(&opts)
            if opts.command is .Run and driver.refuse_freestanding(&opts, "run") { return 1 }
            if opts.command is .Test and driver.refuse_freestanding(&opts, "test") { return 1 }
            if opts.command is .Bench and driver.refuse_freestanding(&opts, "bench") { return 1 }
            if opts.command is .Build {
                if e := opts.toolchain_error {
                    eprint("gamma: {}\n", e)
                    return 1
                }
            }
        }
        l := load.loader(&sm, &diags, &next_id, std, opts.recover)
        l.target = opts.target
        root := input
        if opts.command in (driver.Command.Check, driver.Command.Build, driver.Command.Run, driver.Command.Test, driver.Command.Bench) {
            opts.extras = prepare_packages(input, opts, &l) else return 1
            if opts.command is .Build and opts.target.os is "Freestanding" and not pkg.is_empty(&(opts.extras else pkg.extras())) {
                eprint("gamma: a program for a freestanding target builds to an object file only, so the C sources and libraries of its packages are not linked in; link them with the object yourself\n")
                return 1
            }
        }
        // `--package=name`: the dependency's root module stands in for the input, and its
        // own dependencies resolve through this package's graph.
        if name := opts.package {
            package_root := pkg.find_root(input) else {
                eprint("gamma: `--package` needs the input to be in a package (a directory with a `gamma.toml`)\n")
                return 2
            }
            root = pkg.dependency_dir(package_root, l.resolution, name) else e => {
                eprint("gamma: {}\n", e)
                return 2
            }
        }
        if opts.command is .Modules {
            if graph := l.load_modules(root) { Out.write(graph) }
            render(&sm, &diags, opts.format)
            return if diags.has_errors() { 1 } else { 0 }
        }
        status: u8 = 0
        if l.load_core(driver.core_root(std), driver.mode_name(opts.mode)) {
            s := sema.sema(&l)
            check.install(&s)
            s.resolve_ambient()
            if m := l.load_root(root) {
                // Their tests are found even if nothing imports them.
                if opts.all { load.load_package_modules(&l, m) }
                s.resolve_declarations()
                if opts.command is .Decls {
                    check.check_consts(&s)
                    Out.write(s.decl_dump())
                } else {
                    // `tir` checks a root without `main` as a library, with its tests, as
                    // `gamma tir` does; `test` and `bench` check the tests.
                    tests := opts.command in (driver.Command.Test, driver.Command.Bench) or (opts.command is .Tir and l.lookup(m, "main") is null)
                    check.check_program(&s, m, tests)
                    errors := diags.has_errors()
                    // The diagnostics of checking come first, then what the back end says.
                    render(&sm, &diags, opts.format)
                    if errors { return 1 }
                    match opts.command {
                        .Test, .Bench => { status = testing.run(&s, root, opts) }
                        .Tir => Out.write(check.tir_dump(&s))
                        .Build => {
                            if not driver.build(&s, m, root, opts) { status = 1 }
                        }
                        .Run => { status = if opts.interp { driver.run_interp(&s, m, root, opts) } else { driver.run(&s, m, opts) } }
                        _ => {}
                    }
                }
            }
        }
        if diags.has_errors() and status is 0 { status = 1 }
        render(&sm, &diags, opts.format)
        return status
    }
}
