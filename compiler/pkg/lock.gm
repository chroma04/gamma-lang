// The lockfile, `gamma.lock`: the exact revision and content hash of every git package and
// the content hash of every archive package in a dependency graph (mirrors `src/pkg/lock.rs`).

arena :: import "std/arena"
fs :: import "std/fs"
load :: import "../load"
str :: import "std/str"

pub LOCK_HEADER :: "# This file is generated by `gamma`. Do not edit it by hand."

pub LockedPackage :: struct {
    pub name: string
    /// The normalized repository URL (the lockfile writes it as `git+URL`); for an
    /// archive, `url+` and its URL (the lockfile writes that as it is).
    pub url: string
    /// The directory of the package in the repository, if not the root.
    pub subdir: ?string = null
    /// The version of the tag it was resolved from, when it came from a version requirement.
    pub version: ?string = null
    /// What the manifest asked for, resolved: `tag=…`, `branch=…`, `rev=…` or `default`.
    pub reference: string
    /// The full commit id (empty for an archive).
    pub rev: string
    /// For an archive, `sha256:` and the hash of the downloaded file.
    pub archive: ?string = null
    /// `sha256:` and the hash of the checked-out tree.
    pub checksum: string
    /// The names of the locked packages it depends on.
    pub dependencies: []const string
}

/// Whether `s` is `sha256:` and 64 lowercase hexadecimal digits.
is_sha256 :: fn(s: string) -> bool {
    h := str.strip_prefix(s, "sha256:") else return false
    if h.len is not 64 { return false }
    for c in h {
        if not (c in '0'..='9' or c in 'a'..='f') { return false }
    }
    return true
}

/// Checks the fields that name files in the package store or are passed to `git`: a damaged
/// or hostile lockfile must not reach outside the store.
check_package :: fn(p: ^const LockedPackage) -> string!() needs Alloc {
    if problem := load.name_problem(p.name, "package") { return !problem }
    url := str.strip_prefix(p.url, "url+") else p.url
    if problem := load.url_problem(url) { return !str.format("package `{}`: {}", p.name, problem)! }
    if s := p.subdir {
        if not load.is_subdir(s) {
            return !str.format("package `{}`: `subdir` must be a relative path inside the repository", p.name)!
        }
    }
    if a := p.archive {
        if not is_sha256(a) {
            return !str.format("package `{}`: `archive` must be `sha256:` and 64 hexadecimal digits", p.name)!
        }
    } else {
        hex := true
        for c in p.rev {
            if not (c in '0'..='9' or c in 'a'..='f') { hex = false }
        }
        if not (hex and (p.rev.len is 40 or p.rev.len is 64)) {
            return !str.format("package `{}`: `rev` must be a full commit id", p.name)!
        }
    }
    if not is_sha256(p.checksum) {
        return !str.format("package `{}`: `checksum` must be `sha256:` and 64 hexadecimal digits", p.name)!
    }
    return ()
}

/// Whether this is an archive (`url = …`) rather than a git package.
pub is_archive :: fn(p: ^const LockedPackage) -> bool => p.archive is not null

/// How the package is shown in progress messages: `v1.2.3` or a short revision.
pub display_version :: fn(p: ^const LockedPackage) -> string needs Alloc {
    if a := p.archive {
        hash := str.strip_prefix(a, "sha256:") else a
        return str.format("archive {}", hash[0..if hash.len < 12 { hash.len } else { 12 }])!
    }
    if v := p.version { return str.format("v{}", v)! }
    return str.format("{} @ {}", p.reference, p.rev[0..if p.rev.len < 12 { p.rev.len } else { 12 }])!
}

pub Lock :: struct {
    pub packages: List(LockedPackage)
}

/// The entry for the source `url` (and `subdir`), if the lock has it.
pub find_locked :: fn(l: ^const Lock, url: string, subdir: ?string) -> ?LockedPackage {
    for p in l.packages.items {
        if p.url is url and p.subdir is subdir { return p }
    }
    return null
}

// ---------------------------------------------------------------------------------
// TOML strings, as `toml_edit` writes them
// ---------------------------------------------------------------------------------

StringMetrics :: struct {
    max_single: u32 = 0
    max_double: u32 = 0
    escape_codes: bool = false
    escape: bool = false
    newline: bool = false
}

string_metrics :: fn(s: string) -> StringMetrics {
    m := StringMetrics()
    singles: u32 = 0
    doubles: u32 = 0
    for b in s {
        if b is '\'' {
            singles += 1
            if singles > m.max_single { m.max_single = singles }
        } else {
            singles = 0
        }
        if b is '"' {
            doubles += 1
            if doubles > m.max_double { m.max_double = doubles }
        } else {
            doubles = 0
        }
        if b is '\\' {
            m.escape = true
        } else if b is '\n' {
            m.newline = true
        } else if b is not '\t' and (b <= 0x1f or b is 0x7f) {
            m.escape_codes = true
        }
    }
    return m
}

/// `s` written as a TOML basic string (`"…"`, or `"""…"""` when `multiline`), with escapes.
basic_string :: fn(s: string, multiline: bool) -> string needs Alloc {
    out := list(u8)
    out.extend(if multiline { "\"\"\"" } else { "\"" })!
    if multiline and s.len > 0 and false { out.push('\n')! }
    max_dq: u32 = if multiline { 2 } else { 0 }
    doubles: u32 = 0
    for b in s {
        if b is '"' {
            doubles += 1
        } else {
            doubles = 0
        }
        if b is '"' and doubles > max_dq {
            out.extend("\\\"")!
            doubles = 0
        } else {
            match b {
                8 => out.extend("\\b")!
                '\t' => out.extend("\\t")!
                '\n' => if multiline { out.push(b)! } else { out.extend("\\n")! }
                12 => out.extend("\\f")!
                '\r' => out.extend("\\r")!
                '\\' => out.extend("\\\\")!
                _ => if b <= 0x1f or b is 0x7f { out.write("\\u{:04X}", b)! } else { out.push(b)! }
            }
        }
    }
    out.extend(if multiline { "\"\"\"" } else { "\"" })!
    return out.items
}

/// `s` as `toml_edit` shows a string value: a plain `"…"` when that needs no escape, else
/// a literal `'…'`, else multi-line forms.
pub toml_string :: fn(s: string) -> string needs Alloc {
    m := string_metrics(s)
    if not (m.escape_codes or m.escape or m.max_double > 0 or m.newline) { return basic_string(s, false) }
    if not (m.escape_codes or m.max_single > 0 or m.newline) { return str.format("'{}'", s)! }
    if not (m.escape_codes or m.escape or m.max_double > 2) { return basic_string_ml(s) }
    if not (m.escape_codes or m.max_single > 2) {
        return str.format("'''{}{}'''", if m.newline { "\n" } else { "" }, s)!
    }
    return if m.newline { basic_string_ml(s) } else { basic_string(s, false) }
}

basic_string_ml :: fn(s: string) -> string needs Alloc {
    body := basic_string(s, true)
    if string_metrics(s).newline {
        // A multi-line string starts with a line break that is not part of its value.
        return str.format("\"\"\"\n{}", body[3..])!
    }
    return body
}

// ---------------------------------------------------------------------------------
// Writing and reading
// ---------------------------------------------------------------------------------

package_less :: fn(a, b: ^const LockedPackage) -> bool {
    if a.name is not b.name { return a.name < b.name }
    if a.url is not b.url { return a.url < b.url }
    return option_less(a.subdir, b.subdir)
}

/// Orders optional strings the way Rust orders `Option<String>`: `None` before every `Some`.
pub option_less :: fn(a, b: ?string) -> bool {
    x := a else return b is not null
    y := b else return false
    return x < y
}

/// The text of the file: entries sorted by name, then source, deterministic.
pub render_lock :: fn(l: ^const Lock) -> string needs Alloc {
    pkgs := list(LockedPackage)
    for p in l.packages.items { pkgs.push(p)! }
    pkgs.items.sort_by(package_less)
    out := list(u8)
    out.write("{}\nversion = 1\n", LOCK_HEADER)!
    for p in pkgs.items {
        out.write("\n[[package]]\nname = {}\n", toml_string(p.name))!
        source := if is_archive(&p) { p.url } else { str.format("git+{}", p.url)! }
        out.write("source = {}\n", toml_string(source))!
        if s := p.subdir { out.write("subdir = {}\n", toml_string(s))! }
        if a := p.archive {
            out.write("archive = {}\n", toml_string(a))!
        } else {
            if v := p.version { out.write("version = {}\n", toml_string(v))! }
            out.write("reference = {}\n", toml_string(p.reference))!
            out.write("rev = {}\n", toml_string(p.rev))!
        }
        out.write("checksum = {}\n", toml_string(p.checksum))!
        deps := list(string)
        for d in p.dependencies { deps.push(d)! }
        deps.items.sort()
        quoted := list(string)
        for i, d in enumerate(deps.items) {
            if i > 0 and deps.items[i - 1] is d { continue }
            quoted.push(toml_string(d))!
        }
        out.write("dependencies = [{}]\n", str.join(quoted.items, ", ")!)!
    }
    return out.items
}

package_string :: fn(t: ^const load.Table, key: string) -> string!string needs Alloc {
    e := t.get(key) else return !str.format("a package entry needs a string `{}`", key)!
    return load.as_str(e.value) else !str.format("a package entry needs a string `{}`", key)!
}

/// A syntax error as the TOML library shows it: the position, the line and a caret.
parse_error :: fn(text: string, e: load.TomlError) -> string needs Alloc {
    // The text of line `e.line`.
    start: usize = 0
    n: usize = 1
    while n < e.line {
        nl := str.find(text[start..], "\n") else break
        start += nl + 1
        n += 1
    }
    end := start
    while end < text.len and text[end] is not '\n' { end += 1 }
    shown := text[start..end]
    num := str.format("{}", e.line)!
    out := list(u8)
    out.write("TOML parse error at line {}, column {}\n", e.line, e.col)!
    for _ in 0..num.len { out.push(' ')! }
    out.write(" |\n{} | {}\n", num, shown)!
    for _ in 0..num.len { out.push(' ')! }
    out.extend(" | ")!
    for _ in 1..e.col { out.push(' ')! }
    out.write("^\n{}", e.message)!
    return out.items
}

/// Parses the text of a lockfile.
pub parse_lock :: fn(text: string) -> string!Lock needs Alloc {
    doc := load.parse_toml(text) else e => {
        return !parse_error(text, e)
    }
    lock := Lock(packages: list(LockedPackage))
    ver := doc.get("version")
    if ver is null { return !"missing `version`" }
    .Int(v) := ver?.value else return !"missing `version`"
    if v is not 1 { return !str.format("unsupported lockfile version {}", v)! }
    pkgs := doc.get("package") else return lock
    .Array(items) := pkgs.value else return !"`package` must be an array of tables"
    for it in items.items {
        t := load.as_table(it) else return !"`package` must be an array of tables"
        source := try package_string(t, "source")
        archive: ?string = null
        if a := t.get("archive") { archive = load.as_str(a.value) }
        url := ""
        if u := str.strip_prefix(source, "git+") {
            url = u
        } else if source.starts_with("url+") and archive is not null {
            url = source
        } else {
            return !str.format("unsupported source `{}`", source)!
        }
        reference := ""
        rev := ""
        if archive is null {
            reference = try package_string(t, "reference")
            rev = try package_string(t, "rev")
        }
        deps := list(string)
        if d := t.get("dependencies") {
            .Array(ds) := d.value else return !"`dependencies` must be an array"
            for x in ds.items {
                s := load.as_str(x) else return !"`dependencies` holds strings"
                deps.push(s)!
            }
        }
        subdir: ?string = null
        if s := t.get("subdir") { subdir = load.as_str(s.value) }
        version: ?string = null
        if s := t.get("version") { version = load.as_str(s.value) }
        name := try package_string(t, "name")
        checksum := try package_string(t, "checksum")
        package := LockedPackage(
            name: name,
            url: url,
            subdir: subdir,
            version: version,
            reference: reference,
            rev: rev,
            archive: archive,
            checksum: checksum,
            dependencies: deps.items,
        )
        try check_package(&package)
        lock.packages.push(package)!
    }
    return lock
}

/// Reads `path`; a missing or empty file is `null`.
pub read_lock :: fn(path: string) -> string!?Lock needs Alloc + Fs {
    data := fs.read_all(path) else e => {
        if e is .Io(.NotFound) { return null }
        return !str.format("cannot read {}: {}", path, read_message(e))!
    }
    // An empty file is no lock: it is made again.
    if str.trim(data).len is 0 { return null }
    lock := parse_lock(data) else e => { return !str.format("{}: {}", path, e)! }
    return lock
}

sample :: fn(name, url: string) -> LockedPackage needs Alloc {
    deps := list(string)
    deps.push("util")!
    deps.push("app")!
    return LockedPackage(
        name: name,
        url: url,
        version: "1.2.3",
        reference: "tag=v1.2.3",
        rev: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        checksum: "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        dependencies: deps.items,
    )
}

lock_of :: fn(a, b, c: LockedPackage) -> Lock needs Alloc {
    l := Lock(packages: list(LockedPackage))
    l.packages.push(a)!
    l.packages.push(b)!
    l.packages.push(c)!
    return l
}

test "a lock round trips and is ordered" {
    ar := arena.new()
    defer ar.deinit()
    with ar.allocator() {
        sub := sample("http", "https://h/z")
        sub.subdir = "pkg/http"
        sub.version = null
        sub.reference = "default"
        first := lock_of(sample("util", "https://h/u"), sub, sample("http", "https://h/a"))
        second := lock_of(sample("http", "https://h/a"), sample("util", "https://h/u"), sub)
        text := render_lock(&first)
        expect_eq(text, render_lock(&second))
        expect(text.starts_with(LOCK_HEADER))
        expect((str.find(text, "https://h/a") else 0) < (str.find(text, "https://h/z") else 0))
        expect(str.contains(text, "dependencies = [\"app\", \"util\"]"))
        back := parse_lock(text) else e => {
            expect(false, e)
            return
        }
        expect_eq(render_lock(&back), text)
        expect_eq(back.packages.items.len, 3)
        expect(find_locked(&back, "https://h/z", "pkg/http") is not null)
        expect(find_locked(&back, "https://h/z", null) is null)
    }
}

test "archive entries" {
    ar := arena.new()
    defer ar.deinit()
    with ar.allocator() {
        blob := sample("blob", "url+https://h/blob-1.0.tar.gz")
        blob.version = null
        blob.reference = ""
        blob.rev = ""
        blob.archive = "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        l := lock_of(blob, sample("util", "https://h/u"), sample("http", "https://h/a"))
        text := render_lock(&l)
        expect(str.contains(text, "source = \"url+https://h/blob-1.0.tar.gz\""))
        expect(str.contains(text, "archive = \"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\""))
        back := parse_lock(text) else return
        expect_eq(render_lock(&back), text)
        found := find_locked(&back, "url+https://h/blob-1.0.tar.gz", null) else return
        expect(is_archive(&found) and found.rev.len is 0)
        expect(display_version(&found).starts_with("archive cccccccccccc"))
        bad := parse_lock("version = 1\n[[package]]\nname = \"a\"\nsource = \"url+x\"\nchecksum = \"c\"\n")
        expect(bad is !_)
    }
}

test "bad files are rejected" {
    ar := arena.new()
    defer ar.deinit()
    with ar.allocator() {
        expect(str.contains(lock_error("version = 2\n"), "unsupported"))
        expect(parse_lock("[[package]]\nname = \"a\"\n") is !_)
        expect(parse_lock("version = 1\n[[package]]\nname = \"a\"\n") is !_)
        empty := Lock(packages: list(LockedPackage))
        back := parse_lock(render_lock(&empty)) else return
        expect_eq(back.packages.items.len, 0)
        expect_eq(
            lock_error("garbage = ["),
            "TOML parse error at line 1, column 12\n  |\n1 | garbage = [\n  |            ^\nunclosed array, expected `]`",
        )
    }
}

lock_error :: fn(text: string) -> string needs Alloc {
    match parse_lock(text) {
        !e => return e
        _ => return ""
    }
}

damaged :: fn(p: LockedPackage) -> string needs Alloc {
    l := Lock(packages: list(LockedPackage))
    l.packages.push(p)!
    return lock_error(render_lock(&l))
}

test "damaged entries are rejected" {
    ar := arena.new()
    defer ar.deinit()
    with ar.allocator() {
        p := sample("util", "https://h/u")
        p.rev = "aéééééééééééééééééé"
        expect(str.contains(damaged(p), "full commit id"))
        p.rev = "../../../../../../../.."
        expect(str.contains(damaged(p), "full commit id"))
        blob := sample("blob", "url+https://h/b.tgz")
        blob.rev = ""
        blob.archive = "sha256:../../../../../.."
        expect(str.contains(damaged(blob), "`archive`"))
        p = sample("util", "https://h/u")
        p.checksum = "sha256:x"
        expect(str.contains(damaged(p), "`checksum`"))
        expect(str.contains(damaged(sample("util", "--upload-pack=x")), "starts with `-`"))
        p = sample("util", "https://h/u")
        p.subdir = "../x"
        expect(str.contains(damaged(p), "subdir"))
        expect(str.contains(damaged(sample("../x", "https://h/u")), "invalid package name"))
    }
}

test "strings are written as toml_edit writes them" {
    ar := arena.new()
    defer ar.deinit()
    with ar.allocator() {
        expect_eq(toml_string("plain"), "\"plain\"")
        expect_eq(toml_string("a\"b"), "'a\"b'")
        expect_eq(toml_string("a\\b"), "'a\\b'")
        expect_eq(toml_string("tab\there"), "\"tab\\there\"")
    }
}
