// Bringing a package's git and archive dependencies up to date (the entry points of
// `src/pkg/mod.rs`).

fs :: import "std/fs"
load :: import "../load"
str :: import "std/str"

/// The root package for work at `start` (a file or a directory): the nearest directory at
/// or above it that holds a `gamma.toml`.
pub find_root :: fn(start: string) -> ?string needs Alloc + Fs {
    abs := canonicalize(start) else return null
    cur: ?string = if is_dir(abs) { abs } else { parent(abs) }
    while d := cur {
        if is_file(join(d, "gamma.toml")) { return d }
        cur = parent(d)
    }
    return null
}

/// Brings the git and archive dependencies of the package at `root` up to date: resolves
/// what the lockfile does not cover, fetches what the store lacks, and rewrites `gamma.lock`
/// if it changed. Returns `null` if the graph has none. `explicit` is set for the package
/// commands, which also delete a lockfile that is no longer needed.
pub sync :: fn(root: string, opts: Options, refresh: Refresh, explicit: bool) -> string!?load.Resolution needs Alloc + Clock + Env + Err + Fs + Proc + Rand {
    lock_path := join(root, "gamma.lock")
    old := try read_lock(lock_path)
    r := resolver(root, opts, refresh, old)
    found := try run_resolver(&r)
    answer := found else {
        if explicit and not opts.locked and fs.exists(lock_path) {
            fs.remove_all(lock_path) else e => { return !str.format("cannot remove {}: {}", lock_path, io_message(e))! }
        }
        return null
    }
    text := render_lock(&answer.lock)
    same := false
    if o := old {
        same = render_lock(&o) is text
    }
    if not same {
        if opts.locked {
            return !if old is null {
                "gamma.lock is missing, but --locked was given; run `gamma fetch` and commit gamma.lock"
            } else {
                "gamma.lock needs to be updated, but --locked was given; run `gamma fetch` and commit gamma.lock"
            }
        }
        report_changes(old, &answer.lock, refresh)
        try write_atomic(lock_path, text)
    }
    return answer.res
}

/// What the compiler does before analyzing the program at `input`: sync the git and archive
/// dependencies of its package. `null` if it has no package or none.
pub prepare :: fn(input: string, opts: Options) -> string!?load.Resolution needs Alloc + Clock + Env + Err + Fs + Proc + Rand {
    root := find_root(input) else return null
    return sync(root, opts, Refresh.None, false)
}

report_changes :: fn(old: ?Lock, new: ^const Lock, refresh: Refresh) needs Alloc + Err {
    pkgs := list(LockedPackage)
    for p in new.packages.items { pkgs.push(p)! }
    pkgs.items.sort_by(fn(a, b: ^const LockedPackage) -> bool {
        if a.name is not b.name { return a.name < b.name }
        return a.url < b.url
    })
    for p in pkgs.items {
        prev: ?LockedPackage = null
        if o := old { prev = find_locked(&o, p.url, p.subdir) }
        if o := prev {
            if o.rev is not p.rev or o.archive is not p.archive {
                if refresh is .None {
                    eprint("     Locking {} {}\n", p.name, display_version(&p))
                } else {
                    eprint("    Updating {} {} -> {}\n", p.name, display_version(&o), display_version(&p))
                }
            }
        } else {
            eprint("     Locking {} {}\n", p.name, display_version(&p))
        }
    }
    if o := old {
        for p in o.packages.items {
            if find_locked(new, p.url, p.subdir) is null {
                eprint("    Removing {} {}\n", p.name, display_version(&p))
            }
        }
    }
}

/// The directory of the package that the graph rooted at `root` knows as `name`: a
/// dependency of `root`, or of one of its dependencies, nearest first. `res` holds the
/// resolved git and archive dependencies; path dependencies are read from the manifests.
pub dependency_dir :: fn(root_dir: string, res: ?load.Resolution, name: string) -> string!string needs Alloc + Fs {
    root := canonicalize(root_dir) else root_dir
    seen := list(string)
    seen.push(root)!
    queue := list(string)
    queue.push(root)!
    direct := list(string)
    next: usize = 0
    while next < queue.items.len {
        dir := queue.items[next]
        next += 1
        deps := try direct_dependencies(dir, res)
        for d in deps.items {
            if dir is root { direct.push(d.name)! }
            if d.name is name { return d.dir }
            if d.dir not in seen.items {
                seen.push(d.dir)!
                queue.push(d.dir)!
            }
        }
    }
    if direct.items.len is 0 { return !str.format("the package in {} has no dependency `{}`; it has no dependencies", root, name)! }
    names := list(u8)
    for i, n in enumerate(direct.items) {
        if i > 0 { names.extend(", ")! }
        names.write("`{}`", n)!
    }
    return !str.format("the package in {} has no dependency `{}`; its dependencies are {}", root, name, names.items)!
}

/// The dependencies of the package in `dir`, by name: those of the resolution, or else the
/// path dependencies of its manifest (none without one).
direct_dependencies :: fn(dir: string, res: ?load.Resolution) -> string!List(load.Dep) needs Alloc + Fs {
    if r := res {
        if deps := load.deps_of(&r, dir) {
            out := list(load.Dep)
            for d in deps.items { out.push(d)! }
            out.items.sort_by(fn(a, b: ^const load.Dep) -> bool => a.name < b.name or (a.name is b.name and a.dir < b.dir))
            return out
        }
    }
    out := list(load.Dep)
    if not is_file(join(dir, "gamma.toml")) { return out }
    manifest := try read_manifest(dir)
    for dep in manifest.deps.items {
        if .Path(p) := dep.source {
            full := join(dir, p)
            out.push(load.Dep(name: dep.name, dir: canonicalize(full) else full))!
        }
    }
    return out
}

/// What preparing a build gives: where the packages' dependencies are, and what the
/// packages add to a native build.
pub Prepared :: struct {
    pub resolution: ?load.Resolution
    pub extras: Extras
}

/// Fetches the dependencies of the package that holds `input` (see `prepare`) and collects
/// what the packages add to a native build, or reports the error and returns `null`.
pub prepare_build :: fn(input: string, opts: Options, profile: ?string) -> ?Prepared needs Alloc + Clock + Env + Err + Fs + Proc + Rand {
    res := prepare(input, opts) else e => {
        eprint("gamma: {}\n", e)
        return null
    }
    extras := collect(input, res, profile) else e => {
        eprint("gamma: {}\n", e)
        return null
    }
    return Prepared(resolution: res, extras: extras)
}
