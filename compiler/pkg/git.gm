// Git access through the `git` command-line tool, the package store on disk and the content
// hash of a checkout (mirrors `src/pkg/git.rs`).
//
// Layout under the store directory (`<cache>/git`):
//
//     db/<name>-<16 hex of sha256(url)>/                 bare mirror of a repository
//     checkouts/<name>-<16 hex>/<12-char rev>/           a checked-out revision
//     checkouts/<name>-<16 hex>/<12-char rev>.used       its last use (the file's mtime)
//     url/<name>-<16 hex of sha256(url)>/<16 hex>/       an unpacked archive (with a `.used` stamp too)
//
// Checkouts are read-only once verified. A directory and its `.used` stamp are the unit the
// cache cleaner deletes.

/// The directories where fetched packages live.
pub Store :: struct {
    base: string
}

/// A directory name for a repository: the last segment of its URL and a hash of the URL.
repo_dir_name :: fn(url: string) -> string needs Alloc {
    last := "repo"
    end := url.len
    // The last segment that is not empty, between `/` and `:` separators.
    i := url.len
    found := false
    while i > 0 and not found {
        j := i
        while j > 0 and url[j - 1] not in ('/', ':') { j -= 1 }
        if j < i {
            last = url[j..i]
            found = true
        }
        i = if j > 0 { j - 1 } else { 0 }
    }
    _ = end
    clean := make(u8, last.len)!
    for k, c in enumerate(last) {
        clean[k] = if c in 'a'..='z' or c in 'A'..='Z' or c in '0'..='9' or c in ('-', '_', '.') { c } else { '_' }
    }
    start: usize = 0
    while start < clean.len and clean[start] is '.' { start += 1 }
    return str.format("{}-{}", string(clean[start..]), sha256_hex(url)[0..16])!
}

/// The store for the package at `root`: under the cache directory, or, when the cache is
/// disabled, in `<root>/.gamma/deps`.
pub store_for_package :: fn(root: string) -> Store needs Alloc + Env {
    if d := cache_dir() { return Store(base: join(d, "git")) }
    return Store(base: join(join(root, ".gamma"), "deps"))
}

/// The bare mirror of the repository with the normalized URL `url`.
pub db :: fn(s: ^const Store, url: string) -> string needs Alloc => join(join(s.base, "db"), repo_dir_name(url))

/// The directory archives are downloaded into before they are unpacked.
pub downloads :: fn(s: ^const Store) -> string needs Alloc => join(s.base, "url")

/// Where the archive at `url` whose file has the SHA-256 `sha` (hexadecimal) is unpacked.
pub archive_dir :: fn(s: ^const Store, url, sha: string) -> string needs Alloc {
    return join(join(join(s.base, "url"), repo_dir_name(url)), sha[0..if sha.len < 16 { sha.len } else { 16 }])
}

/// Where revision `rev` of the repository is checked out.
pub checkout_dir :: fn(s: ^const Store, url, rev: string) -> string needs Alloc {
    return join(join(join(s.base, "checkouts"), repo_dir_name(url)), rev[0..if rev.len < 12 { rev.len } else { 12 }])
}

/// Variables of the caller's environment that would point git at another repository,
/// index or object store than the one given (set, for example, inside a git hook).
GIT_LOCATION_VARS :: [6]string(
    "GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_COMMON_DIR",
)

/// Runs `git` with `args` (in the repository `git_dir` if given) and returns its standard
/// output. `env` are `NAME=value` entries added to the environment.
git :: fn(git_dir: ?string, args: []const string, env: []const string) -> string!string needs Alloc + Proc {
    argv := list(string)
    argv.push("env")!
    for v in GIT_LOCATION_VARS {
        argv.push("-u")!
        argv.push(v)!
    }
    argv.push("GIT_TERMINAL_PROMPT=0")!
    argv.extend(env)!
    argv.push("git")!
    // The `ext::` transport runs a command named in the URL: never allow it, whatever the
    // user's git configuration says.
    argv.push("-c")!
    argv.push("protocol.ext.allow=never")!
    if d := git_dir {
        argv.push("--git-dir")!
        argv.push(d)!
    }
    argv.extend(args)!
    r := run(argv.items)
    if r.code is 127 and (str.contains(r.err, "No such file") or r.err.len is 0 or str.contains(r.err, "not found")) {
        return !"cannot run `git` (is it installed?): No such file or directory (os error 2)"
    }
    if r.ok { return r.out }
    sub := "git"
    for a in args {
        if not a.starts_with("-") {
            sub = a
            break
        }
    }
    return !str.format("`git {}` failed: {}", sub, str.trim(r.err))!
}

/// A name and the commit it names.
pub RefName :: struct {
    pub name: string
    pub rev: string
}

/// Branches, tags (peeled to commits) and the default branch's head of a mirror.
pub Refs :: struct {
    pub tags: List(RefName)
    pub branches: List(RefName)
    pub head: ?string = null
}

/// Brings the mirror `db` of `url` up to date, creating it if needed.
pub fetch_mirror :: fn(db: string, url: string) -> string!() needs Alloc + Fs + Proc {
    if not is_file(join(db, "HEAD")) {
        if p := parent(db) { try make_dirs(p) }
        _ = try git(null, [5]string("init", "-q", "--bare", db, "")[0..4], [0]string()[..])
    }
    args := [9]string("fetch", "-q", "--force", "--prune", "--", url, "+refs/heads/*:refs/heads/*", "+refs/tags/*:refs/tags/*", "+HEAD:refs/gamma/head")
    _ = git(db, args[..], [0]string()[..]) else e => { return !str.format("cannot fetch {}: {}", url, e)! }
    return ()
}

pub list_refs :: fn(db: string) -> string!Refs needs Alloc + Proc {
    args := [6]string("for-each-ref", "--format=%(refname)%09%(objectname)%09%(*objectname)", "refs/heads", "refs/tags", "refs/gamma", "")
    out := try git(db, args[0..5], [0]string()[..])
    refs := Refs(tags: list(RefName), branches: list(RefName))
    for line in str.lines(out) {
        parts := list(string)
        for p in str.split(line, "\t") { parts.push(p)! }
        if parts.items.len < 2 { continue }
        name := parts.items[0]
        obj := parts.items[1]
        target := obj
        if parts.items.len > 2 and parts.items[2].len > 0 { target = parts.items[2] }
        if t := str.strip_prefix(name, "refs/tags/") {
            refs.tags.push(RefName(name: t, rev: target))!
        } else if b := str.strip_prefix(name, "refs/heads/") {
            refs.branches.push(RefName(name: b, rev: target))!
        } else if name is "refs/gamma/head" {
            refs.head = target
        }
    }
    return refs
}

/// The full commit id for `rev` (an id prefix), if the mirror has exactly one.
pub rev_parse :: fn(db: string, rev: string) -> ?string needs Alloc + Proc {
    spec := str.format("{}^{{commit}}", rev)!
    args := [4]string("rev-parse", "--verify", "--quiet", spec)
    out := git(db, args[..], [0]string()[..]) else return null
    t := str.trim(out)
    if t.len is 40 or t.len is 64 { return t }
    return null
}

/// The names of the tags of the repository at `url`, without cloning it.
pub remote_tags :: fn(url: string) -> string!List(string) needs Alloc + Proc {
    args := [5]string("ls-remote", "--tags", "--refs", "--", url)
    out := git(null, args[..], [0]string()[..]) else e => { return !str.format("cannot list {}: {}", url, e)! }
    tags := list(string)
    for line in str.lines(out) {
        parts := list(string)
        for p in str.split(line, "\t") { parts.push(p)! }
        if parts.items.len > 1 {
            if t := str.strip_prefix(parts.items[1], "refs/tags/") { tags.push(t)! }
        }
    }
    return tags
}

/// Checks out `rev` into `dest`, through a temporary directory so that a failure never
/// leaves a partial checkout. Does nothing if `dest` exists.
pub checkout :: fn(db: string, rev: string, dest: string) -> string!() needs Alloc + Fs + Proc + Rand {
    if is_dir(dest) { return () }
    parent_dir := parent(dest) else return !"bad checkout path"
    try make_dirs(parent_dir)
    tmp := private_name(parent_dir, "checkout")
    index := str.format("{}.index", tmp)!
    Fs.make_dir(tmp) else e => { return !str.format("cannot create {}: {}", tmp, io_message(e))! }
    args := [10]string("-c", "core.bare=false", "--work-tree", tmp, "checkout", "-q", "-f", rev, "--", ".")
    env := [1]string(str.format("GIT_INDEX_FILE={}", index)!)
    res := git(db, args[..], env[..])
    _ = fs.remove_all(index)
    if res is !_ {
        _ = fs.remove_all(tmp)
        _ = res else e => { return !e }
    }
    Fs.rename(tmp, dest) else e => {
        _ = fs.remove_all(tmp)
        // Another process may have finished the same checkout first.
        if not is_dir(dest) { return !str.format("cannot create {}: {}", dest, io_message(e))! }
    }
    return ()
}

// ---------------------------------------------------------------------------------
// The content hash of a tree
// ---------------------------------------------------------------------------------

/// What the checksum records for a path of a tree: a file, or a symbolic link and where
/// it points.
TreeEntry :: struct {
    rel: string
    path: string
    link: ?string
}

link_target :: fn(path: string) -> string!string needs Alloc + Proc {
    args := [2]string("readlink", path)
    r := run(args[..])
    if not r.ok { return !str.format("cannot read {}: {}", path, if r.err.len > 0 { str.trim(r.err) } else { "not a symbolic link" })! }
    out := r.out
    if out.ends_with("\n") { out = out[0..out.len - 1] }
    return out
}

collect_entries :: fn(root, rel: string, out: ^List(TreeEntry)) -> string!() needs Alloc + Fs + Proc {
    names := list(string)
    kinds := list(fs.FileKind)
    for r in fs.entries(root) {
        e := r else err => { return !str.format("cannot read {}: {}", root, io_message(err))! }
        names.push(dupe(e.name)!)!
        kinds.push(e.kind)!
    }
    for i, name in enumerate(names.items) {
        if name is ".git" { continue }
        path := join(root, name)
        entry_rel := if rel.len is 0 { name } else { str.format("{}/{}", rel, name)! }
        match kinds.items[i] {
            .Dir => { try collect_entries(path, entry_rel, out) }
            .File => { out.push(TreeEntry(rel: entry_rel, path: path, link: null))! }
            .Symlink => {
                target := try link_target(path)
                try check_link(entry_rel, target)
                out.push(TreeEntry(rel: entry_rel, path: path, link: target))!
            }
            .Other => {}
        }
    }
    return ()
}

/// The names of a path, without empty ones and `.`.
path_names :: fn(p: string) -> List(string) needs Alloc {
    names := list(string)
    for c in str.split(p, "/") {
        if c.len > 0 and c is not "." { names.push(c)! }
    }
    return names
}

/// Checks that the symbolic link at `rel` (a path inside the tree) points to a relative
/// path that stays inside the tree. Absolute links and links that climb out of the tree
/// would make a package's contents depend on the machine, and a checkout is shared by
/// everything that uses it.
check_link :: fn(rel, target: string) -> string!() needs Alloc {
    outside := str.format(
        "the package contains the symbolic link `{}` -> `{}`, which points outside the package; links must stay inside the package directory",
        rel,
        target,
    )!
    if target.starts_with("/") { return !outside }
    depth: usize = 0
    for _ in str.split(rel, "/") { depth += 1 }
    depth -= 1
    for c in path_names(target).items {
        if c is ".." {
            if depth is 0 { return !outside }
            depth -= 1
        } else {
            depth += 1
        }
    }
    return ()
}

/// Checks that every symbolic link stays inside the tree when it is resolved the way the
/// system resolves it: a link whose target goes through another link (`d/up -> ..`,
/// `esc -> d/up/..`) is followed, so a chain of links that each look harmless cannot climb
/// out of the tree.
check_link_chains :: fn(entries: []const TreeEntry) -> string!() needs Alloc {
    for e in entries {
        target := e.link else continue
        dir := list(string)
        for c in str.split(e.rel, "/") { dir.push(c)! }
        _ = dir.pop()
        hops: u32 = 0
        if not resolve_within(&dir, target, entries, &hops) {
            return !str.format(
                "the package contains the symbolic link `{}` -> `{}`, which points outside the package through other links; links must stay inside the package directory",
                e.rel,
                target,
            )!
        }
    }
    return ()
}

/// The target of the link at the path `at`, if there is one.
link_at :: fn(entries: []const TreeEntry, at: []const string) -> ?string needs Alloc {
    joined := str.join(at, "/")!
    for e in entries {
        if e.rel is joined { return e.link }
    }
    return null
}

/// Resolves `target` relative to the directory `at` (path components inside the tree),
/// following the links among `entries`, and leaves the result in `at`. False if the path
/// leaves the tree, is absolute, or takes more than 40 link hops.
resolve_within :: fn(at: ^List(string), target: string, entries: []const TreeEntry, hops: ^u32) -> bool needs Alloc {
    if target.starts_with("/") { return false }
    for c in path_names(target).items {
        if c is ".." {
            if at.pop() is null { return false }
        } else {
            at.push(c)!
            if next := link_at(entries, at.items) {
                hops^ += 1
                if hops^ > 40 { return false }
                _ = at.pop()
                if not resolve_within(at, next, entries, hops) { return false }
            }
        }
    }
    return true
}

/// The content hash of the tree at `root`: SHA-256 over its entries in sorted path order
/// (`/` separators, `.git` excluded). A regular file is the path, a NUL byte, the length as
/// 8 little-endian bytes, and the contents. A symbolic link is the path, a NUL byte, eight
/// `0xFF` bytes (a length no file has), the length of the link's target as 8 little-endian
/// bytes, and the target; so a link never has the same record as a file. Written
/// `sha256:<hex>`. A link that points outside the tree is an error.
pub tree_checksum :: fn(root: string) -> string!string needs Alloc + Fs + Proc {
    entries := list(TreeEntry)
    try collect_entries(root, "", &entries)
    try check_link_chains(entries.items)
    entries.items.sort_by(fn(a, b: ^const TreeEntry) -> bool => a.rel < b.rel)
    h := sha256.init()
    zero := [1]u8(0)
    ff := [8]u8(fill: 0xFF)
    for e in entries.items {
        h.update(e.rel)
        h.update(zero[..])
        if target := e.link {
            h.update(ff[..])
            h.update(le_bytes(target.len)[..])
            h.update(target)
        } else {
            data := fs.read_all(e.path) else err => { return !str.format("cannot read {}: {}", e.path, read_message(err))! }
            h.update(le_bytes(data.len)[..])
            h.update(data)
        }
    }
    d := h.final()
    return str.format("sha256:{}", hex(d[..]))!
}

/// `n` as 8 little-endian bytes.
le_bytes :: fn(n: usize) -> [8]u8 {
    b: [8]u8 = ---
    v := u64(n)
    for i in 0..8 { b[i] = (v >> u64(8 * i)).trunc(u8) }
    return b
}

// ---------------------------------------------------------------------------------
// Permissions and use stamps
// ---------------------------------------------------------------------------------

/// Runs `chmod` with `mode` on the tree at `root`, ignoring failure.
chmod_tree :: fn(mode, root: string) needs Alloc + Proc {
    args := [4]string("chmod", "-R", mode, root)
    _ = run(args[..])
}

/// Removes the write permission from the tree at `root`, files and directories alike, so
/// that editing a package in place fails instead of silently changing what every build
/// that uses the checkout sees.
pub make_read_only :: fn(root: string) needs Alloc + Proc { chmod_tree("a-w", root) }

/// Restores the owner's write permission in the tree at `root` (and read and search
/// permission of directories), as needed to delete it.
pub make_writable :: fn(root: string) needs Alloc + Proc { chmod_tree("u+rwX", root) }

/// Normalizes the permissions of an unpacked tree: the owner can read and write
/// everything, and special bits (setuid, sticky) are dropped.
pub sanitize_modes :: fn(root: string) needs Alloc + Proc { chmod_tree("u+rwX,u-s,g-s,a-t", root) }

/// Deletes the tree at `path`, which may be read-only.
pub remove_tree :: fn(path: string) -> IoError!() needs Alloc + Fs + Proc {
    make_writable(path)
    return fs.remove_all(path)
}

/// The file whose modification time is the last use of the checkout `dir`: next to it,
/// since the checkout itself is read-only.
pub stamp_of :: fn(dir: string) -> string needs Alloc => str.format("{}.used", dir)!

/// Records that the checkout `dir` is in use now.
pub mark_used :: fn(dir: string) needs Alloc + Proc {
    args := [2]string("touch", stamp_of(dir))
    _ = run(args[..])
}

/// The time (Unix nanoseconds) the checkout `dir` was last used: its stamp's, else its own
/// modification time.
pub last_used :: fn(dir: string) -> ?i64 needs Alloc + Fs {
    if info := Fs.stat(stamp_of(dir)) { return info.modified }
    if info := Fs.stat(dir) { return info.modified }
    return null
}

fs :: import "std/fs"
sha256 :: import "std/hash/sha256"
str :: import "std/str"
