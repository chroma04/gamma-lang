//! Diagnostics: errors and warnings with their locations, secondary labels, notes and
//! machine-applicable fixes, and their rendering in the `human`, `short` and `json`
//! formats of `gamma --diag-format` (the same text, byte for byte).

source :: import "../source"
str :: import "std/str"

pub Severity :: union { Note, Warning, Error }

severity_name :: fn(s: Severity) -> string => match s {
    .Note => "note"
    .Warning => "warning"
    .Error => "error"
}

/// A secondary location attached to a diagnostic.
pub Label :: struct {
    pub span: source.Span
    pub message: string
}

/// A replacement of the text at `span` (empty for an insertion) by `text`.
pub Edit :: struct {
    pub span: source.Span
    pub text: string
}

/// A change to the source that resolves a diagnostic, for tools to apply.
pub Fix :: struct {
    pub message: string
    pub edits: List(Edit)
}

pub Diagnostic :: struct {
    pub severity: Severity
    pub message: string
    /// The primary location.
    pub span: source.Span
    pub labels: List(Label)
    pub notes: List(string)
    pub fixes: List(Fix)
}

/// The diagnostics of a compilation, in the order they were reported.
pub Diagnostics :: struct {
    pub list: List(Diagnostic)
    /// The errors in `list`.
    errors: usize
    /// The errors raised, including those dropped.
    raised: usize
    /// While above zero, diagnostics are dropped (a parser trying an alternative).
    suppressed: u32
}

pub diagnostics :: fn() -> Diagnostics needs Alloc => Diagnostics(list: list(Diagnostic), errors: 0, raised: 0, suppressed: 0)

/// A new error at `span`.
pub error :: fn(span: source.Span, message: string) -> Diagnostic needs Alloc {
    return Diagnostic(
        severity: .Error,
        message: message,
        span: span,
        labels: list(Label),
        notes: list(string),
        fixes: list(Fix),
    )
}

/// A new warning at `span`.
pub warning :: fn(span: source.Span, message: string) -> Diagnostic needs Alloc {
    d := error(span, message)
    d.severity = .Warning
    return d
}

pub add_label :: fn(d: ^Diagnostic, span: source.Span, message: string) {
    d.labels.push(Label(span: span, message: message))!
}

pub add_note :: fn(d: ^Diagnostic, note: string) {
    d.notes.push(note)!
}

/// Adds a fix that replaces the text at `span` with `text`.
pub add_fix :: fn(d: ^Diagnostic, message: string, span: source.Span, text: string) needs Alloc {
    edits := list(Edit)
    edits.push(Edit(span: span, text: text))!
    d.fixes.push(Fix(message: message, edits: edits))!
}

/// Adds a fix made of several edits of non-overlapping spans.
pub add_fix_edits :: fn(d: ^Diagnostic, message: string, edits: []const Edit) needs Alloc {
    l := list(Edit)
    l.extend(edits)!
    d.fixes.push(Fix(message: message, edits: l))!
}

/// Records `d`, unless diagnostics are suppressed, it repeats one with the same
/// severity, location and message, or it is an error about the error type `{error}`.
pub push :: fn(ds: ^Diagnostics, d: Diagnostic) {
    if d.severity is .Error { ds.raised += 1 }
    if ds.suppressed > 0 { return }
    // An error about the error type only restates an earlier error.
    if d.severity is .Error and str.contains(d.message, "{error}") { return }
    if d.span is not source.DUMMY {
        for old in ds.list.items {
            if old.span is d.span and old.severity is d.severity and old.message is d.message { return }
        }
    }
    if d.severity is .Error { ds.errors += 1 }
    ds.list.push(d)!
}

/// How many diagnostics were recorded and raised, to drop the later ones with `reset`.
pub Mark :: struct {
    pub len: usize
    pub raised: usize
}

pub mark :: fn(ds: ^const Diagnostics) -> Mark => Mark(len: ds.list.items.len, raised: ds.raised)

/// Drops the diagnostics reported since `m` was taken.
pub reset :: fn(ds: ^Diagnostics, m: Mark) {
    for d in ds.list.items[m.len..] {
        if d.severity is .Error { ds.errors -= 1 }
    }
    ds.list.truncate(m.len)
    ds.raised = m.raised
}

/// Whether a diagnostic recorded since `m` was taken has a message starting with `prefix`.
pub any_since :: fn(ds: ^const Diagnostics, m: Mark, prefix: string) -> bool {
    for d in ds.list.items[m.len..] {
        if d.message.starts_with(prefix) { return true }
    }
    return false
}

/// Drops the diagnostics reported until the matching `unsuppress`.
pub suppress :: fn(ds: ^Diagnostics) {
    ds.suppressed += 1
}

pub unsuppress :: fn(ds: ^Diagnostics) {
    if ds.suppressed > 0 { ds.suppressed -= 1 }
}

/// Reports an error at `span` with nothing attached.
pub report :: fn(ds: ^Diagnostics, span: source.Span, message: string) needs Alloc {
    ds.push(error(span, message))
}

pub has_errors :: fn(ds: ^const Diagnostics) -> bool => ds.errors > 0

/// The number of errors raised so far, including those dropped.
pub error_count :: fn(ds: ^const Diagnostics) -> usize => ds.raised

/// Sorts the diagnostics by file and position, keeping the order of those at one place.
pub sort :: fn(ds: ^Diagnostics) {
    xs := ds.list.items
    // Insertion sort: stable, and the list is nearly sorted already.
    for i in 1..xs.len {
        d := xs[i]
        j := i
        while j > 0 and before(d.span, xs[j - 1].span) {
            xs[j] = xs[j - 1]
            j -= 1
        }
        xs[j] = d
    }
}

before :: fn(a, b: source.Span) -> bool => (a.file, a.lo) < (b.file, b.lo)

/// How diagnostics are printed.
pub Format :: union {
    /// The message, then the source line with the location marked, then the labels and
    /// notes.
    Human
    /// One line per diagnostic, `path:line:col: severity: message`, then one line per
    /// label and note.
    Short
    /// One JSON object per line, with locations, notes and fixes.
    Json
}

/// Appends `d` to `out` in `format`.
pub render :: fn(sm: ^const source.SourceMap, d: ^const Diagnostic, format: Format, out: ^List(u8)) needs Alloc {
    match format {
        .Human => render_human(sm, d, out)
        .Short => render_short(sm, d, out)
        .Json => render_json(sm, d, out)
    }
}

/// Source lines longer than this (in characters) are shown as a window of `WINDOW`
/// characters around the location of a diagnostic.
LONG_LINE :: 200
WINDOW :: 120

render_human :: fn(sm: ^const source.SourceMap, d: ^const Diagnostic, out: ^List(u8)) needs Alloc {
    out.write("{}: {}\n", severity_name(d.severity), d.message)!
    if d.span is not source.DUMMY {
        f := sm.file(d.span.file)
        lc := f.line_col(d.span.lo)
        line := lc.line
        col := lc.col
        number := str.format("{}", line)!
        gutter := number.len.max(2)
        pad := spaces(gutter)
        out.write("{}--> {}:{}:{}\n", pad, f.path, line, col)!
        text := f.line_text(line)
        len := if f.is_ascii() { text.len.trunc(u32) } else { source.char_count(text).trunc(u32) }
        end := f.line_col(d.span.hi)
        width := if end.line is line { (end.col - col).max(1) } else { (len + 1 - col).max(1) }
        shown := list(u8)
        caret := col - 1
        if len > LONG_LINE {
            // A very long line is shown as a window around the location, so that many
            // errors on one line do not repeat all of it.
            start := (col - 1) -| WINDOW / 3
            stop := (start + WINDOW).min(len)
            if start > 0 { shown.extend("…")! }
            body := if f.is_ascii() { text[usize(start)..usize(stop)] } else { text[char_offset(text, start)..char_offset(text, stop)] }
            push_untabbed(&shown, body)
            if stop < len { shown.extend("…")! }
            width = width.min(stop + 1 - col)
            caret = col - 1 - start + (if start > 0 { u32(1) } else { 0 })
        } else {
            push_untabbed(&shown, text)
        }
        out.write("{} |\n", pad)!
        out.write("{}{} | {}\n", spaces(gutter - number.len), number, string(shown.items))!
        out.write("{} | {}", pad, spaces(usize(caret)))!
        for _ in 0..width.max(1) { out.push('^')! }
        out.push('\n')!
    }
    for l in d.labels.items {
        if l.span is source.DUMMY { continue }
        f := sm.file(l.span.file)
        lc := f.line_col(l.span.lo)
        out.write("  note: {} ({}:{}:{})\n", l.message, f.path, lc.line, lc.col)!
    }
    for n in d.notes.items { out.write("  = note: {}\n", n)! }
}

/// `n` spaces.
spaces :: fn(n: usize) -> string needs Alloc {
    s := list(u8)
    for _ in 0..n { s.push(' ')! }
    return s.items
}

/// Appends `text` with each tab replaced by a space.
push_untabbed :: fn(out: ^List(u8), text: string) needs Alloc {
    for c in text { out.push(if c is '\t' { ' ' } else { c })! }
}

/// The byte offset of character `n` of UTF-8 `text` (its length if it has fewer).
char_offset :: fn(text: string, n: u32) -> usize {
    seen: u32 = 0
    for i, c in enumerate(text) {
        if c & 0xC0 is not 0x80 {
            if seen is n { return i }
            seen += 1
        }
    }
    return text.len
}

render_short :: fn(sm: ^const source.SourceMap, d: ^const Diagnostic, out: ^List(u8)) needs Alloc {
    location(sm, d.span, out)
    out.write("{}: {}\n", severity_name(d.severity), d.message)!
    for l in d.labels.items {
        if l.span is source.DUMMY { continue }
        location(sm, l.span, out)
        out.write("note: {}\n", l.message)!
    }
    for n in d.notes.items {
        location(sm, d.span, out)
        out.write("note: {}\n", n)!
    }
}

// `path:line:col: `, or nothing for a diagnostic without a location.
location :: fn(sm: ^const source.SourceMap, span: source.Span, out: ^List(u8)) needs Alloc {
    if span is source.DUMMY { return }
    f := sm.file(span.file)
    lc := f.line_col(span.lo)
    out.write("{}:{}:{}: ", f.path, lc.line, lc.col)!
}

// The fields of an object are in the order of their names, as the reference
// implementation writes them.
render_json :: fn(sm: ^const source.SourceMap, d: ^const Diagnostic, out: ^List(u8)) needs Alloc {
    located := d.span is not source.DUMMY
    out.push('{')!
    if located {
        json_before_line(sm, d.span, out)
        out.push(',')!
    }
    out.extend("\"fixes\":[")!
    for i, fx in enumerate(d.fixes.items) {
        if i > 0 { out.push(',')! }
        out.extend("{\"edits\":[")!
        for j, e in enumerate(fx.edits.items) {
            if j > 0 { out.push(',')! }
            out.push('{')!
            json_location(sm, e.span, out)
            out.extend(",\"text\":")!
            json_string(e.text, out)
            out.push('}')!
        }
        out.extend("],\"message\":")!
        json_string(fx.message, out)
        out.push('}')!
    }
    out.extend("],\"labels\":[")!
    for i, l in enumerate(d.labels.items) {
        if i > 0 { out.push(',')! }
        out.push('{')!
        json_location_split(sm, l.span, out, l.message)
        out.push('}')!
    }
    out.extend("]")!
    if located {
        json_after_line(sm, d.span, out, d.message)
    } else {
        out.extend(",\"message\":")!
        json_string(d.message, out)
    }
    out.extend(",\"notes\":[")!
    for i, n in enumerate(d.notes.items) {
        if i > 0 { out.push(',')! }
        json_string(n, out)
    }
    out.extend("]")!
    if located { out.write(",\"offset\":{}", d.span.lo)! }
    out.extend(",\"severity\":")!
    json_string(severity_name(d.severity), out)
    out.extend("}\n")!
}

// The location fields of `span`, `column` to `file` and then `line` and `offset`.
json_location :: fn(sm: ^const source.SourceMap, span: source.Span, out: ^List(u8)) needs Alloc {
    json_before_line(sm, span, out)
    lc := sm.file(span.file).line_col(span.lo)
    out.write(",\"line\":{},\"offset\":{}", lc.line, span.lo)!
}

// A location with a `message` field, which sorts between `line` and `offset`.
json_location_split :: fn(sm: ^const source.SourceMap, span: source.Span, out: ^List(u8), message: string) needs Alloc {
    json_before_line(sm, span, out)
    json_after_line(sm, span, out, message)
    out.write(",\"offset\":{}", span.lo)!
}

// `"column"` to `"file"`: the fields that sort before `"fixes"`.
json_before_line :: fn(sm: ^const source.SourceMap, span: source.Span, out: ^List(u8)) needs Alloc {
    f := sm.file(span.file)
    lc := f.line_col(span.lo)
    end := f.line_col(span.hi)
    out.write("\"column\":{},\"end_column\":{},\"end_line\":{},\"end_offset\":{},\"file\":", lc.col, end.col, end.line, span.hi)!
    json_string(f.path, out)
}

// `"line"` and `"message"`.
json_after_line :: fn(sm: ^const source.SourceMap, span: source.Span, out: ^List(u8), message: string) needs Alloc {
    lc := sm.file(span.file).line_col(span.lo)
    out.write(",\"line\":{},\"message\":", lc.line)!
    json_string(message, out)
}

HEX :: "0123456789abcdef"

/// Appends `s` as a JSON string. Control characters are escaped; everything else,
/// including non-ASCII text, is copied.
json_string :: fn(s: string, out: ^List(u8)) needs Alloc {
    out.push('"')!
    for c in s {
        match c {
            '"' => out.extend("\\\"")!
            '\\' => out.extend("\\\\")!
            '\n' => out.extend("\\n")!
            '\r' => out.extend("\\r")!
            '\t' => out.extend("\\t")!
            0x08 => out.extend("\\b")!
            0x0C => out.extend("\\f")!
            0..=0x1F => {
                out.extend("\\u00")!
                out.push(HEX[usize(c >> 4)])!
                out.push(HEX[usize(c & 0xF)])!
            }
            _ => out.push(c)!
        }
    }
    out.push('"')!
}

test "short and json rendering" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        sm := source.source_map()
        id := sm.add("t.gm", "a ( b\n  ]\n")
        d := error(source.span(id, 2, 3), "unclosed `(`")
        d.add_label(source.span(id, 8, 9), "this `]` does not match")
        d.add_note("a \"note\"\tthere")
        d.add_fix("write `)`", source.span(id, 8, 9), ")")
        out := list(u8)
        render(&sm, &d, .Short, &out)
        expect_eq(string(out.items), "t.gm:1:3: error: unclosed `(`\nt.gm:2:3: note: this `]` does not match\nt.gm:1:3: note: a \"note\"\tthere\n")
        out.clear()
        render(&sm, &d, .Json, &out)
        expected :: ``{"column":3,"end_column":4,"end_line":1,"end_offset":3,"file":"t.gm","fixes":[{"edits":[{"column":3,"end_column":4,"end_line":2,"end_offset":9,"file":"t.gm","line":2,"offset":8,"text":")"}],"message":"write `)`"}],"labels":[{"column":3,"end_column":4,"end_line":2,"end_offset":9,"file":"t.gm","line":2,"message":"this `]` does not match","offset":8}],"line":1,"message":"unclosed `(`","notes":["a \"note\"\tthere"],"offset":2,"severity":"error"}
``
        expect_eq(string(out.items), expected)
    }
}

arena :: import "std/arena"
