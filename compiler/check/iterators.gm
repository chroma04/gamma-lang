// Iterators (§13): `for` over a call of an iterator, whose body becomes the clause of a
// handler for the iterator's `Yield(T)`.

/// `for p in f(args) { B }` where `f` is an iterator (§13.2).
for_iterator :: fn(cx: ^FnCx, f: ^const ast.ForExpr) -> ^Expr needs Load {
    span := f.span
    tys := &cx.s.tys
    yield_eff := cx.s.yield_effect else {
        cx.error(span, "the `Yield` effect is not available")
        return error_expr(cx.s, span)
    }
    // The source call is evaluated as written, outside the loop's handler.
    start := cx.performed.items.len
    call := cx.expr(f.iter, null)
    // A call with spread or reordered arguments binds some of them first.
    bound := empty_slice(tir.Stmt)
    if .Block(b) := call.kind and t := b.tail and t.kind is .Call(_) {
        bound = b.stmts
        call = t
    }
    effects := types.empty_effects()
    match call.kind {
        .Call(callee, _) => match callee {
            .Fn(id) => { effects = cx.s.fns.items[usize(id)].effects }
            .Indirect(c) => match tys.kind(cx.infer.resolve(cx.s, c.ty)) {
                .Fn(sig), .FnPtr(sig) => { effects = sig.effects }
                _ => {}
            }
            _ => return cx.not_an_iterator(f, call)
        }
        _ => return cx.not_an_iterator(f, call)
    }
    yields := list(EffectRef)
    for e in effects.effects {
        if e.eff is yield_eff { yields.push(e)! }
    }
    if yields.items.len is 0 {
        // A call returning an array or slice is iterated like any such value.
        if e := cx.for_each_value(f, call) { return e }
        cx.error(f.iter.span, "this call is not an iterator: its effects include no `Yield(T)`")
        return error_expr(cx.s, span)
    }
    if yields.items.len > 1 {
        cx.error(f.iter.span, "this call yields more than one type; `for` needs exactly one `Yield(T)`")
        return error_expr(cx.s, span)
    }
    eref := yields.items[0]
    elem := tys.error()
    if eref.args.len > 0 and .Type(t) := eref.args[0] { elem = t }
    // The loop handles the iterator's `Yield(T)`.
    i := start
    while i < cx.performed.items.len {
        if types.cmp_ref(&cx.performed.items[i].effect_, &eref) is 0 {
            _ = cx.performed.remove(i)
        } else {
            i += 1
        }
    }
    if e := cx.enumerate_loop(f, call, bound, elem) { return e }
    result_ty := call.ty
    // The arguments are bound first, so that they are evaluated outside the loop's handler.
    pre := list(tir.Stmt)
    pre.extend(bound)!
    cx.hoist_args(call, &pre)
    cx.push_scope()
    label_name: ?string = null
    if l := f.label {
        cx.declare(l.name, .Label, l.span)
        label_name = l.name
    }
    label := cx.new_label(label_name, true, .Loop(result_ty))
    hid := cx.s.handlers.items.len.trunc(u32)
    cx.s.handlers.push(tir.HandlerLit(effect_: eref, clauses: empty_slice(u32)))!
    // The clause `yield(x) => { p :: x; B }`.
    params := list(sema.ParamInfo)
    params.push(sema.ParamInfo(name: "<item>", ty: elem, span: span, default: null, generic: null, rest: false))!
    fn_id := cx.s.new_nested_fn(.Clause, "<for body>", span, cx.module, params.items, tys.unit(), types.empty_effects())
    cx.enter_fn(fn_id, tys.unit(), types.empty_effects())
    cx.clause = ClauseInfo(op_kind: .Esc, handler_: hid, decl_clause: null, with_expect: null, for_label: ForLabel(name: label_name, label: label), break_ty: result_ty, effect_: eref)
    xid := cx.new_local("<item>", elem, false, span)
    // `for a, b in …` is the tuple pattern `(a, b)` (§8.4).
    pat_ast := f.pats[0]
    if f.pats.len is not 1 {
        args := list(ast.PatArg)
        for p in f.pats { args.push(ast.PatArg(name: null, pat: p, span: p.span))! }
        pat_ast = ast.Pattern(id: f.pats[0].id, kind: .Tuple(args.items), span: f.pats[0].span)
    }
    binds := list(PatBind)
    pat := cx.pattern(&pat_ast, elem, .Irrefutable, &binds)
    if not tys.is_error(elem) and not irrefutable(cx.s, pat) {
        cx.error(pat_ast.span, "a `for` pattern must match every value (it must be irrefutable)")
    }
    cx.declare_binds(&binds)
    body := cx.block(&f.body, false)
    arms := list(tir.Arm)
    arms.push(tir.Arm(pat: pat, guard: null, body: body))!
    m := tir.mk(tys.unit(), .Match(tir.mk(elem, .Local(xid), span), arms.items), span)
    frame := cx.exit_fn()
    cx.performed.extend(frame.performed)!
    cx.s.defs.items[usize(fn_id)].parent = cx.fn_id
    ids := list(u32)
    ids.push(xid)!
    cx.nested.push(NestedFn(fn_id: fn_id, params: ids.items, locals: frame.locals, body: m))!
    _ = cx.labels.pop()
    _ = cx.forget_label_breaks(label)
    cx.pop_scope()
    clauses := list(u32)
    clauses.push(fn_id)!
    cx.s.handlers.items[usize(hid)].clauses = clauses.items
    handlers := list(tir.HandlerValue)
    handlers.push(.Literal(tir.mk(tys.intern(.Handler(hid)), .HandlerRef(hid), span)))!
    w := tir.mk(result_ty, .With(tir.WithExpr(label: label, handlers: handlers.items, on: null, body: call)), span)
    if pre.items.len is 0 { return w }
    return tir.mk(result_ty, .Block(new(tir.Block(stmts: pre.items, tail: w, span: span))!), span)
}

/// `for p in enumerate(xs)` as the loop over the slice that the iterator runs, without a
/// handler: `{ s := xs; i := 0; loop i < s.len { p :: (i: i, x: s[i]); body } step i += 1 }`.
/// `null` unless `call` is a call of the core library's `enumerate`.
enumerate_loop :: fn(cx: ^FnCx, f: ^const ast.ForExpr, call: ^Expr, bound: []tir.Stmt, elem: Ty) -> ?^Expr needs Load {
    .Call(callee, args) := call.kind else return null
    .Fn(fid) := callee else return null
    sig := &cx.s.fns.items[usize(fid)]
    if sig.name is not "enumerate" or not cx.s.l.modules.items[sig.module].is_prelude or args.len is not 1 { return null }
    tys := &cx.s.tys
    sty := cx.infer.resolve(cx.s, args[0].ty)
    .Slice(_, x_ty) := tys.kind(sty) else return null
    span := f.span
    usize_t := tys.usize_ty()
    s := cx.temp(sty, span)
    i := cx.temp(usize_t, span)
    local :: fn(id: u32, ty: Ty) -> ^Expr needs Alloc => tir.mk(ty, .Local(id), span)
    cond := list(tir.CondPart)
    cond.push(.Bool(tir.mk(tys.bool_ty(), .Binary(.Lt, local(i, usize_t), tir.mk(usize_t, .SliceLen(local(s, sty)), span)), span)))!
    fields := list(Expr)
    fields.push(local(i, usize_t)^)!
    fields.push(tir.mk(x_ty, .Index(local(s, sty), local(i, usize_t), false), span)^)!
    item := tir.mk(elem, .Aggregate(fields.items), span)
    more := list(tir.Stmt)
    more.push(.Assign(local(i, usize_t), tir.mk(usize_t, .Binary(.Add(.Wrap), local(i, usize_t), tir.mk(usize_t, .Int(bigint.one()), span)), span)))!
    lp := cx.loop_with_pattern(f, elem, item, cond.items, block_of(cx.s, more.items, span))
    stmts := list(tir.Stmt)
    stmts.extend(bound)!
    stmts.push(.Let(s, &args[0]))!
    stmts.push(.Let(i, tir.mk(usize_t, .Int(bigint.zero()), span)))!
    stmts.push(.Expr(lp))!
    return block_of(cx.s, stmts.items, span)
}

/// The source of a `for` that is a call of no function: iterated if it is an array or
/// slice.
not_an_iterator :: fn(cx: ^FnCx, f: ^const ast.ForExpr, call: ^Expr) -> ^Expr needs Load {
    if e := cx.for_each_value(f, call) { return e }
    if not cx.s.tys.is_error(call.ty) { cx.error(f.iter.span, "`for` iterates over a range, an array or slice, or a call to an iterator") }
    return error_expr(cx.s, f.span)
}

/// Moves the call's non-constant arguments into temporaries bound by statements added
/// to `pre`.
hoist_args :: fn(cx: ^FnCx, call: ^Expr, pre: ^List(tir.Stmt)) needs Load {
    .Call(_, args) := call.kind else return
    for i in 0..args.len {
        a := &args[i]
        if a.kind in (.Int(_), .Str(_), .Bool(_)) { continue }
        // A temporary the argument points to (`&mk()`, or a temporary array passed as a
        // slice) lives for the call, which includes the loop (§7.2): it becomes a local
        // too, rather than dying with the statement that binds the argument.
        cx.lift_temps(a, pre)
        t := cx.temp(a.ty, a.span)
        v := new(a^)!
        a^ = tir.mk(a.ty, .Local(t), a.span)^
        pre.push(.Let(t, v))!
    }
}

/// Replaces each `AddrOfTemp(v)` in `e` (outside nested calls) by the address of a local
/// initialized with `v` by a statement added to `pre`.
lift_temps :: fn(cx: ^FnCx, e: ^Expr, pre: ^List(tir.Stmt)) needs Load {
    if e.kind in (.Call(_), .Closure(_)) { return }
    if .AddrOfTemp(inner) := e.kind {
        cx.lift_temps(inner, pre)
        t := cx.temp(inner.ty, inner.span)
        v := new(inner^)!
        inner^ = tir.mk(inner.ty, .Local(t), inner.span)^
        pre.push(.Let(t, v))!
        e.kind = .AddrOf(inner)
        return
    }
    tir.for_each_child(e, fn(c: ^Expr) { cx.lift_temps(c, pre) })
}

/// An iterator call passed for a parameter that is not an iterator parameter
/// (`enumerate(bytes(s))`, §13.5): reports it once, in place of the type and effect
/// errors it would cause, and returns true. `v` is the checked argument.
iterator_call_as_value :: fn(cx: ^FnCx, e0: ^const ast.Expr, v: ^Expr, param: Ty) -> bool needs Load {
    e := e0
    while .Paren(x) := e.kind { e = x }
    tys := &cx.s.tys
    if e.kind is not .Call(_) or not tys.is_unit(cx.infer.resolve(cx.s, v.ty)) or tys.is_unit(cx.infer.resolve(cx.s, param)) { return false }
    if e.span not in cx.iterator_calls.items { return false }
    text := cx.s.l.sm.file(e.span.file).text[usize(e.span.lo)..usize(e.span.hi)]
    if i := str.find(text, "(") { text = text[..i] }
    if i := str.rfind(text, ".") { text = text[i + 1..] }
    c := str.trim(text)
    p := cx.show(cx.infer.resolve(cx.s, param))
    cx.error(e.span, str.format("`{}(…)` is an iterator, not a value: it cannot be passed for a parameter of type `{}`; run it with `for x in {}(…)`, or gather its values with `collect({}(…))` (§13.5)", c, p, c, c)!)
    i: usize = 0
    while i < cx.performed.items.len {
        if cx.performed.items[i].span is e.span {
            _ = cx.performed.remove(i)
        } else {
            i += 1
        }
    }
    return true
}

/// For an argument written as a call where the parameter is an iterator parameter
/// (§13.5), the function literal `fn() => call` that is passed instead.
iterator_arg :: fn(cx: ^FnCx, e: ^const ast.Expr, ty: Ty) -> ?ast.Expr needs Load {
    .Fn(sig) := cx.s.tys.kind(ty) else return null
    y := cx.s.yield_effect else return null
    if sig.params.len > 0 { return null }
    yields := false
    for x in sig.effects.effects {
        if x.eff is y { yields = true }
    }
    if not yields { return null }
    inner := e
    while .Paren(x) := inner.kind { inner = x }
    if inner.kind is not .Call(_) { return null }
    // The callee's arguments and receiver are evaluated here, once; the literal only makes
    // the call (§13.5).
    call := cx.hoist_iterator_call(inner)
    fsig := ast.FnSig(params: empty_slice(ast.Param), variadic: false, ret: null, effects: null, span: e.span)
    lit := new(ast.FnLit(sig: fsig, where_: empty_slice(ast.Constraint), body: .Expr(new(call)!), span: e.span))!
    cx.iterator_args.push(e.span)!
    return ast.Expr(id: e.id, kind: .Fn(lit), span: e.span)
}

/// After the argument for parameter `i` was checked: if it is an iterator whose call
/// arguments are evaluated first (§13.5), the arguments written before it are evaluated
/// into temporaries, then those statements are added to `stmts`; this keeps the
/// left-to-right order.
place_iter_pre :: fn(cx: ^FnCx, bound: ^List(?^Expr), written: ^List(usize), i: usize, stmts: ^List(tir.Stmt)) needs Load {
    if cx.iter_pre.items.len > 0 {
        for j in written.items {
            if v := bound.items[j] { bound.items[j] = cx.bind_temp(v, stmts) }
        }
        stmts.extend(cx.iter_pre.items)!
        cx.iter_pre = list(tir.Stmt)
    }
    written.push(i)!
}

/// `f(a1, …, an)` rewritten so that `a1 … an` and a method call's receiver are evaluated
/// now, into hidden locals (statements in `iter_pre`), leaving a call of those locals for
/// the iterator literal to make each time it runs.
hoist_iterator_call :: fn(cx: ^FnCx, call: ^const ast.Expr) -> ast.Expr needs Load {
    .Call(callee, args, trailing_comma) := call.kind else return call^
    new_callee := callee^
    if .Field(base, name) := callee.kind {
        if not cx.denotes_type(base) {
            b := cx.hoist_iter_value(base, true)
            new_callee = ast.Expr(id: callee.id, kind: .Field(base: new(b)!, name: name), span: callee.span)
        }
    }
    out := list(ast.Arg)
    for a in args {
        kind: ast.ArgKind = match a.kind {
            .Positional(e) => .Positional(cx.hoist_iter_value(&e, false))
            .Named(n, e) => .Named(name: n, value: cx.hoist_iter_value(&e, false))
            .Spread(e) => .Spread(e)
        }
        out.push(ast.Arg(kind: kind, span: a.span))!
    }
    return ast.Expr(id: call.id, kind: .Call(callee: new(new_callee)!, args: out.items, trailing_comma: trailing_comma), span: call.span)
}

/// Whether `e` is a constant expression or names a global: evaluating it again is
/// unobservable, and it may depend on the type expected where it is written.
iter_stable :: fn(cx: ^FnCx, e: ^const ast.Expr) -> bool needs Load {
    match e.kind {
        .Int(_), .Float(_), .Str(_), .Bool(_), .Null, .Uninit, .Underscore, .DotIdent(_) => return true
        .Ident(id) => return cx.lookup_local(id.name) is null
        .Paren(x) => return cx.iter_stable(x)
        .Field(base, _) => return cx.iter_stable(base)
        .Unary(op, operand) => return op in (ast.UnOp.Neg, ast.UnOp.BitNot, ast.UnOp.Not) and cx.iter_stable(operand)
        .Binary(_, lhs, rhs) => return cx.iter_stable(lhs) and cx.iter_stable(rhs)
        // `.V(args)`: a union value built from its context.
        .Call(callee, args, _) => {
            if callee.kind is not .DotIdent(_) { return false }
            for a in args {
                match a.kind {
                    .Positional(x) => if not cx.iter_stable(&x) { return false }
                    .Named(_, x) => if not cx.iter_stable(&x) { return false }
                    .Spread(_) => return false
                }
            }
            return true
        }
        _ => return cx.denotes_type(e)
    }
}

/// The expression that stands for `e` in the literal made for an iterator argument: `e`
/// is evaluated now. A place (`receiver`, or an array, which would otherwise be copied)
/// stays a place, with the pointers and indexes in it evaluated now; any other value goes
/// into a hidden local.
hoist_iter_value :: fn(cx: ^FnCx, e: ^const ast.Expr, receiver: bool) -> ast.Expr needs Load {
    if cx.iter_stable(e) { return e^ }
    place: ?ast.Expr = null
    match e.kind {
        .Paren(x) => return cx.hoist_iter_value(x, receiver)
        .Ident(_) => { place = e^ }
        .Field(base, name) => {
            b := cx.hoist_iter_value(base, true)
            place = ast.Expr(id: ast.NodeId(0xFFFF_FFFF), kind: .Field(base: new(b)!, name: name), span: e.span)
        }
        .TupleField(base, index, index_span) => {
            b := cx.hoist_iter_value(base, true)
            place = ast.Expr(id: ast.NodeId(0xFFFF_FFFF), kind: .TupleField(base: new(b)!, index: index, index_span: index_span), span: e.span)
        }
        .Index(base, index) => {
            b := cx.hoist_iter_value(base, true)
            i := cx.hoist_iter_value(index, false)
            place = ast.Expr(id: ast.NodeId(0xFFFF_FFFF), kind: .Index(base: new(b)!, index: new(i)!), span: e.span)
        }
        .Deref(x) => {
            v := cx.hoist_iter_value(x, false)
            place = ast.Expr(id: ast.NodeId(0xFFFF_FFFF), kind: .Deref(new(v)!), span: e.span)
        }
        .Unary(.AddrOf, operand) => {
            o := cx.hoist_iter_value(operand, true)
            return ast.Expr(id: ast.NodeId(0xFFFF_FFFF), kind: .Unary(op: .AddrOf, operand: new(o)!), span: e.span)
        }
        _ => {}
    }
    expr: ast.Expr = if p := place { p } else { e^ }
    mark := cx.performed.items.len
    v := cx.expr(&expr, null)
    // An iterator passed on (`filtered(fib(), f)`): not a value; its own arguments are
    // evaluated now too, and the call stays where it is.
    if expr.kind is .Call(_) and expr.span in cx.iterator_calls.items {
        cx.performed.truncate(mark)
        return cx.hoist_iterator_call(&expr)
    }
    ty := cx.infer.resolve(cx.s, v.ty)
    keep_place := place is not null and (receiver or cx.s.tys.kind(ty) is .Array(_))
    // A second-class function cannot be stored, and an untyped constant takes its type
    // from the parameter it is passed for: both are evaluated where they are used.
    if cx.s.tys.is_error(ty) or cx.s.tys.has_infer(ty) or cx.s.tys.kind(ty) is .Fn(_) or keep_place { return expr }
    pre := cx.iter_pre
    cx.iter_pre = list(tir.Stmt)
    cx.lift_temps(v, &pre)
    name: string = str.format("<iter{}>", cx.locals.items.len)!
    local := cx.new_local(name, ty, true, e.span)
    pre.push(.Let(local, v))!
    cx.iter_pre = pre
    cx.declare(name, .Var(local), e.span)
    return ast.Expr(id: ast.NodeId(0xFFFF_FFFF), kind: .Ident(ast.Ident(name: name, span: e.span)), span: e.span)
}
