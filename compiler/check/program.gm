// Checking a whole program: its entry point and every function body (mirrors the end
// of `check_all` in `src/sema/mod.rs`).

/// Checks the bodies of the functions of the program whose root module is `root`, after
/// its declarations are resolved. A root without `main` is a library, checked as for
/// running its tests.
pub check_program :: fn(s: ^Sema, root: usize) needs Load {
    for o in s.l.other_items.items {
        if s.l.modules.items[o.module].is_prelude { continue }
        match o.item.kind {
            .Test(_), .Handler(_) => {}
            _ => s.unsupported(o.item.span, "top-level intrinsic calls")
        }
    }
    declare_handlers(s)
    if d := s.l.lookup(root, "main") {
        find_main(s, d)
    } else {
        check_tests(s, root)
    }
    for f in s.fns.items {
        if s.l.modules.items[f.module].is_prelude { continue }
        for p in f.params {
            d := p.default else continue
            if not sema.is_site(&p) and not is_literal_default(d) {
                s.unsupported(d.span, "parameter defaults evaluated at compile time")
            }
        }
    }
    check_consts(s)
    check_bodies(s)
    check_handler_clauses(s)
    check_decl_breaks(s)
    monomorphize(s)
    check_inline(s)
    check_escapes(s)
    check_continuations(s)
}

/// Follows the bodies of the instances of generic functions requested so far, as
/// producing them would (§16.7): what they call is instantiated for the instance's type
/// arguments, which may request more, and what depends on the type arguments is checked
/// for them. Generic functions of the core library, whose bodies gammac does not check,
/// are not followed.
monomorphize :: fn(s: ^Sema) needs Load {
    while req := s.mono_queue.pop() {
        def := s.defs.items[usize(req.generic)]
        body := def.body else continue
        map := list(sema.Subst)
        for i, g in enumerate(s.fns.items[usize(req.generic)].generics) { map.push(sema.Subst(param: g, ty: req.args[i]))! }
        outer := s.mono_depth
        s.mono_depth = req.depth
        mono_check(s, body, map.items, req.span)
        s.mono_depth = outer
        // An instance may need a type larger than any object (a computed array length).
        for l in def.locals {
            if not s.type_size_ok(s.subst(l.ty, map.items), req.span) { break }
        }
    }
}

/// Checks expression `e` of a generic body for the instance with type arguments `map`,
/// reporting at `span`, where the instance is used.
mono_check :: fn(s: ^Sema, e: ^Expr, map: []const sema.Subst, span: source.Span) needs Load {
    had_param := s.tys.has_param(e.ty)
    t := s.subst(e.ty, map)
    // Literals typed by a parameter are checked against each instantiation (§16.1).
    match e.kind {
        .Int(v) => if had_param and s.tys.kind(t) is not .Float(_) and not s.int_fits(v, t) {
            s.error(span, str.format("the literal {} does not fit in `{}` (in an instantiation used here)", sema.show_int(v), s.show(t))!)
        }
        .UntypedFloat(_) => if s.tys.kind(t) is not .Float(_) {
            s.error(span, str.format("a float literal cannot have the type `{}` (in an instantiation used here)", s.show(t))!)
        }
        _ => {}
    }
    callee: ?u32 = null
    match e.kind {
        .Call(.Fn(c), _) => { callee = c }
        .FnRef(c) => { callee = c }
        _ => {}
    }
    if c := callee {
        if inst := s.fns.items[usize(c)].instance {
            has_param := false
            for a in inst.args {
                if s.tys.has_param(a) { has_param = true }
            }
            if has_param {
                args := list(Ty)
                for a in inst.args { args.push(s.subst(a, map))! }
                _ = s.instantiate(inst.template, args.items, span)
            }
        }
    }
    tir.for_each_child(e, fn(x: ^Expr) { mono_check(s, x, map, span) })
    // `.bits` between types that mention parameters is size-checked per instance (§6.6).
    if .Builtin(.Bits, args) := e.kind and map.len > 0 and not s.tys.has_param(t) {
        src := s.subst(args[0].ty, map)
        if not s.tys.has_param(src) {
            a := s.layout(src).size
            b := s.layout(t).size
            if a is not b {
                s.error(span, str.format("`.bits` needs equal sizes, but `{}` has {} bytes and `{}` has {} (in an instantiation used here)", s.show(src), a, s.show(t), b)!)
            }
        }
    }
}

/// Whether a parameter default is a literal, which needs no compile-time evaluation.
is_literal_default :: fn(d: ^const ast.Expr) -> bool => match d.kind {
    .Int(_), .Float(_), .Bool(_), .Null, .Str(_) => true
    .Unary(.Neg, x) => x.kind in (.Int(_), .Float(_))
    _ => false
}

/// Reports the `#inline` functions that can call themselves (§11.10).
check_inline :: fn(s: ^Sema) needs Alloc {
    for inl in s.inline_fns.items {
        seen := list(u32)
        work := list(u32)
        work.push(inl.fn_id)!
        recursive := false
        while g := work.pop() {
            body := s.defs.items[usize(g)].body else continue
            calls := list(u32)
            collect_calls(body, &calls)
            for c in calls.items {
                if c is inl.fn_id {
                    recursive = true
                } else if seen.items.index_of(c) is null {
                    seen.push(c)!
                    work.push(c)!
                }
            }
        }
        if recursive {
            s.error(inl.span, str.format("`{}` cannot be inlined at every call site: it can call itself (§11.10)", s.fns.items[usize(inl.fn_id)].name)!)
        }
    }
}

collect_calls :: fn(e: ^Expr, out: ^List(u32)) needs Alloc {
    if .Call(.Fn(c), _) := e.kind { out.push(c)! }
    tir.for_each_child(e, fn(x: ^Expr) { collect_calls(x, out) })
}

/// Checks that `main` is a function that can be a program's entry point (§3.7).
find_main :: fn(s: ^Sema, id: usize) needs Load {
    span := s.l.decls.items[id].name.span
    match s.resolve_decl(id) {
        .Fn(f) => {
            sig := s.fns.items[usize(f)]
            if sig.params.len > 0 { s.error(span, "`main` must take no parameters") }
            ret_ok := s.tys.is_unit(sig.ret) or sig.ret is s.tys.u8_ty()
            if .Result(_, ok) := s.tys.kind(sig.ret) and s.tys.is_unit(ok) { ret_ok = true }
            if not ret_ok { s.error(span, str.format("`main` must return `()`, `u8` or `E!()`, not `{}`", s.show(sig.ret))!) }
            for e in sig.effects.effects {
                if not s.is_ambient(e.eff) {
                    s.error(span, str.format("`main` may only perform ambient effects, but performs `{}`", s.tys.effect_name(e.eff))!)
                }
            }
        }
        .Error => {}
        _ => s.error(span, "`main` must be a function")
    }
}
