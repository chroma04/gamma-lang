// Tests and benchmarks (§3.8, §3.9): a library is checked as for running its tests, and
// each test or benchmark body is checked as a function performing the ambient effects
// and `Test`.

/// Checks the tests and benchmarks of the root module `root` and of the other modules of
/// its package, and records them in the program: the root module's first, then each other
/// module's in the order of their paths.
check_tests :: fn(s: ^Sema, root: usize) needs Load {
    package := s.l.modules.items[root].package
    others := list((label: string, module: usize))
    seen := list(usize)
    for o in s.l.other_items.items {
        m := &s.l.modules.items[o.module]
        if o.module is root or m.package is not package or m.is_prelude or o.module in seen.items { continue }
        seen.push(o.module)!
        others.push((label: load.module_label(s.l, o.module), module: o.module))!
    }
    others.items.sort_by(fn(a, b: ^const (label: string, module: usize)) -> bool => a.label < b.label)
    order := list((label: ?string, module: usize))
    order.push((label: null, module: root))!
    for x in others.items { order.push((label: x.label, module: x.module))! }
    for place in order.items {
        module := place.module
        names := list((bench: bool, name: string, span: source.Span))
        // Checking a test may load modules, which adds items: index the list each time.
        for i in 0..s.l.other_items.items.len {
            o := s.l.other_items.items[i]
            if o.module is not module { continue }
            .Test(t) := o.item.kind else continue
            text := string(t.name.bytes)
            prev: ?source.Span = null
            for n in names.items {
                if n.bench is t.bench and n.name is text { prev = n.span }
            }
            if p := prev {
                d := diag.error(t.name_span, str.format("the {} \"{}\" is declared twice", if t.bench { "benchmark" } else { "test" }, text)!)
                d.add_label(p, "first declared here")
                s.emit(d)
                continue
            }
            names.push((bench: t.bench, name: text, span: t.name_span))!
            entry := check_test(s, module, text, t.name_span, &t.body, t.bench) else continue
            case := sema.TestCase(name: text, module: place.label, entry: entry)
            if t.bench { s.benches.push(case)! } else { s.tests.push(case)! }
        }
    }
}

/// The ambient effects of the core library (§12.9), with `Test` if `test`.
ambient_effects :: fn(s: ^Sema, test: bool) -> EffectSet needs Load {
    out := list(EffectRef)
    prelude := s.l.prelude else return types.empty_effects()
    names := [12]string("Out", "Err", "Env", "Sys", "Alloc", "In", "Clock", "Rand", "Fs", "Net", "Proc", "Test")
    for i, name in enumerate(names) {
        if i is 11 and not test { break }
        d := s.l.lookup(prelude, name) else continue
        .Effect(e) := s.resolve_decl(d) else continue
        out.push(types.EffectRef(eff: e, args: empty_slice(types.GenericArg)))!
    }
    return types.effect_set(out.items)
}

/// Checks the body of a test or benchmark and returns the function that runs it: for a
/// benchmark, the one to give `entry_point`.
check_test :: fn(s: ^Sema, module: usize, name: string, span: source.Span, body: ^const ast.Block, bench: bool) -> ?u32 needs Load {
    effects := ambient_effects(s, true)
    label := str.format("{} \"{}\"", if bench { "bench" } else { "test" }, name)!
    f := s.new_nested_fn(.Named, label, span, module, empty_slice(sema.ParamInfo), s.tys.unit(), effects)
    s.in_test = true
    cx := fn_cx(s, module, s.tys.unit(), effects)
    cx.fn_id = f
    fb: ast.FnBody = .Block(body^)
    b := cx.fn_body(&fb)
    cx.finish(b)
    s.in_test = false
    def := &s.defs.items[usize(f)]
    def.locals = cx.locals.items
    def.body = b
    return if bench { bench_entry(s, f, span) } else { test_entry(s, f, span) }
}

/// `run_test(&test)` from the core prelude: installs the test handlers and reports a
/// failure. The entry function of test `f`, which is not part of the program's text.
test_entry :: fn(s: ^Sema, f: u32, span: source.Span) -> ?u32 needs Load {
    call := runner_call(s, f, span, "run_test") else return null
    // `Out`, `Err`, `Env` and `Sys`: what `run_test` needs.
    effects := list(types.EffectRef)
    for e in ambient_effects(s, false).effects {
        if s.tys.effect_name(e.eff) in ("Out", "Err", "Env", "Sys") { effects.push(e)! }
    }
    module := s.fns.items[usize(f)].module
    entry := s.new_nested_fn(.Named, "<entry>", span, module, empty_slice(sema.ParamInfo), s.tys.u8_ty(), types.effect_set(effects.items))
    s.defs.items[usize(entry)].body = call
    return entry
}

/// The function that runs benchmark `f` with `run_bench`. Unlike a test, a benchmark runs
/// under the system's handlers, as `main` does: its caller gives it to `entry_point`.
bench_entry :: fn(s: ^Sema, f: u32, span: source.Span) -> ?u32 needs Load {
    call := runner_call(s, f, span, "run_bench") else return null
    module := s.fns.items[usize(f)].module
    inner := s.new_nested_fn(.Named, "<bench>", span, module, empty_slice(sema.ParamInfo), s.tys.u8_ty(), ambient_effects(s, false))
    s.defs.items[usize(inner)].body = call
    return inner
}

/// The call of the core prelude function `runner` on the test or benchmark body `f`.
runner_call :: fn(s: ^Sema, f: u32, span: source.Span, runner: string) -> ?^Expr needs Load {
    prelude := s.l.prelude else return null
    d := s.l.lookup(prelude, runner) else return null
    .Fn(g) := s.resolve_decl(d) else return null
    fn_ty := s.tys.intern(.FnPtr(types.FnTy(params: empty_slice(Ty), ret: s.tys.unit(), effects: ambient_effects(s, true), variadic: false, win64: false)))
    args := list(Expr)
    args.push(tir.mk(fn_ty, .FnRef(f), span)^)!
    return tir.mk(s.tys.u8_ty(), .Call(.Fn(g), args.items), span)
}
