//! Checking function bodies: the per-function context, local scopes, statements, blocks
//! and control flow (§4, §8), producing the typed representation (`tir`).
//! Expressions are in `expr.gm`, coercions in `coerce.gm` and the final pass over a body in
//! `finalize.gm`.
//!
//! gamma checks a growing subset of the language: a construct it cannot check yet is
//! reported with `Sema.unsupported`, and the result is not used by later stages.

ast :: import "../ast"
load :: import "../load"
bigint :: import "../bigint"
diag :: import "../diag"
ratio :: import "../ratio"
sema :: import "../sema"
source :: import "../source"
str :: import "std/str"
syntax :: import "../syntax"
tir :: import "../tir"
types :: import "../types"

Sema :: sema.Sema
Load :: sema.Load
Ty :: types.Ty
Expr :: tir.Expr
EffectRef :: types.EffectRef
EffectSet :: types.EffectSet

/// What a name in a local scope denotes.
LocalBinding :: union {
    Var: u32
    /// An untyped constant local (`x :: 5`), inlined at each use.
    Untyped: sema.Untyped
    /// A label of an enclosing loop.
    Label
    /// A function declared in the body with `name :: fn …`.
    NestedFn: u32
    /// An immutable local evaluated at compile time (§17.2): its type and the place of its
    /// name, which identify the constant.
    Const: (ty: Ty, name: string, span: source.Span)
    /// A local alias of a type (`T :: [4]i32`), also visible to type expressions.
    Type: Ty
}

/// The state of an enclosing function while a nested one (a literal or a clause) is
/// checked.
Frame :: struct {
    locals: List(tir.LocalDecl)
    ret: Ty
    declared: EffectSet
    performed: List(Performed)
    labels: List(LabelInfo)
    next_label: u32
    in_defer: bool
    defer_label_base: usize
    fn_id: ?u32
    captures: bool
    open_ret: bool
    open_ty: ?Ty
    clause: ?ClauseInfo
    handled: List(EffectRef)
    block_temps: List(u32)
}

/// The handler clause a frame checks.
ClauseInfo :: struct {
    op_kind: ast.OpKind
    /// The handler literal it belongs to, or the function of the clause of a handler
    /// declaration.
    handler_: ?u32
    decl_clause: ?u32
    /// The type of the value of the `with` that installs the handler, which its
    /// `break`s give.
    with_expect: ?Ty
    /// For the body of a `for` over an iterator, which is the clause of its `yield`: the
    /// loop's label, and the type of the iterator's result, which a `break` gives.
    for_label: ?ForLabel = null
    break_ty: ?Ty = null
    /// The instantiated effect the clause handles.
    effect_: ?EffectRef = null
}

ForLabel :: struct {
    name: ?string
    label: u32
}

/// A `break` to the `with` installing handler literal `handler`, from one of its clauses.
HandlerBreak :: struct {
    handler_: u32
    ty: Ty
    span: source.Span
}

/// A nested function of the body, finished with it: it shares the body's literal
/// inference.
NestedFn :: struct {
    fn_id: u32
    params: []u32
    locals: []tir.LocalDecl
    body: ^Expr
}

Binding :: struct {
    name: string
    value: LocalBinding
}

/// What a `break` to a label supplies (§8.5).
LabelValue :: union {
    /// A `while` loop: nothing.
    Nothing
    /// A `for` loop: the type of its value.
    Loop: Ty
    /// A `with`: the type expected of its value, if it is used.
    With: ?Ty
}

LabelInfo :: struct {
    name: ?string
    id: u32
    is_loop: bool
    value: LabelValue
}

/// A coercion whose source was an unresolved literal type when it was checked; decided
/// after inference (§6.1).
PendingCoercion :: struct {
    source: Ty
    target: Ty
    span: source.Span
}

/// A check that needs the final types of literals.
Obligation :: union {
    /// An expression statement must have type `()` or `never`.
    UnitStatement: (ty: Ty, span: source.Span)
    /// A lossless conversion `T(x)` (§6.5).
    Conversion: (from: Ty, to: Ty, span: source.Span)
    /// Comparison operands must be ordered (§7.5).
    Ord: (ty: Ty, span: source.Span)
    /// An operator operand must be numeric.
    Numeric: NumericObligation
}

NumericObligation :: struct {
    ty: Ty
    span: source.Span
    op: string
    int_only: bool
    signed_only: bool
}

Performed :: struct {
    effect_: EffectRef
    span: source.Span
}

/// A `break` to a label: the depth of the function the label belongs to, the label, and
/// the value's type and place.
LabelBreak :: struct {
    depth: u32
    label: u32
    ty: Ty
    span: source.Span
}

/// Where a fix adds an effect to a function's signature.
NeedsAt :: struct {
    span: source.Span
    has_needs: bool
}

pub FnCx :: struct {
    s: ^Sema
    module: usize
    locals: List(tir.LocalDecl)
    /// Block scopes, innermost last.
    scopes: List(List(Binding))
    infer: InferTable
    ret: Ty
    declared: EffectSet
    performed: List(Performed)
    labels: List(LabelInfo)
    next_label: u32
    pending: List(PendingCoercion)
    obligations: List(Obligation)
    failed_coercions: List(source.Span)
    fn_id: ?u32
    needs_at: ?NeedsAt
    label_breaks: List(LabelBreak)
    /// Set just before checking an argument `&e` for a `^const T` parameter: `e` may be a
    /// temporary, which lives until the call returns (§7.10).
    temp_ref_arg: bool
    /// The `match`es whose exhaustiveness waits for the final types of literals.
    deferred_matches: List(DeferredMatch)
    /// Inside a deferred statement (§8.8), whose labels start at `defer_label_base`.
    in_defer: bool
    defer_label_base: usize
    /// Where operations of kind `fn` are performed, which a deferred statement may do.
    fn_performs: List(source.Span)
    /// The enclosing functions of the one being checked, outermost first.
    outer: List(Frame)
    /// For each scope, the depth of the function it belongs to.
    scope_depths: List(u32)
    /// For each scope, the names in scope for type and compile-time expressions when it
    /// began: the local aliases, constants and functions it declares go out of scope with
    /// it.
    scope_marks: List(sema.ScopeMark)
    /// Whether the function being checked uses a local of an enclosing one.
    captures: bool
    nested: List(NestedFn)
    /// Set while checking a literal whose return type is that of its `return`s:
    /// `open_ty`, once the first `return` with a value fixes it.
    open_ret: bool
    open_ty: ?Ty
    /// Named nested functions whose return type comes from their body, while it is
    /// checked: they cannot call themselves.
    open_fns: List(u32)
    /// The handler clause being checked, if any.
    clause: ?ClauseInfo
    handler_breaks: List(HandlerBreak)
    /// Where iterators are called (§13.2).
    iterator_calls: List(source.Span)
    /// The effects handled by the `with`s enclosing the point being checked, in the
    /// current function.
    handled: List(EffectRef)
    /// Handler literals bound with `::` whose clauses are not checked yet: they are
    /// checked at the first `with` that installs them, which gives their `break`s an
    /// expected type, or else at the end of their scope.
    pending_handlers: List(PendingHandler)
    /// Effects performed by the clauses of a handler literal checked at a later `with`,
    /// by where they are performed, with the number of handlers in scope where the
    /// literal was written: `with`s that began after that point must not handle them
    /// (§12.5).
    shielded_performs: List(Shielded)
    /// Effects performed inside a `with` that handles another instantiation of the same
    /// effect, by where they are performed.
    near_misses: List(Performed)
    /// Statements that evaluate the call arguments of an iterator argument, to be placed
    /// before the call (§13.5).
    iter_pre: List(tir.Stmt)
    /// The hidden locals holding temporary arrays used as slices (§15.1), waiting to be
    /// declared before the statement that contains them (see `block_expected`).
    block_temps: List(u32)
    /// Set while checking a constant's initializer, which is not in a block: there a
    /// temporary array lives as long as the evaluation.
    const_init: bool
    /// The function literals made for iterator arguments, by place.
    iterator_args: List(source.Span)
    /// Set while checking the operands of an operator that mentions no complex constant
    /// (see `expr`).
    complex_free: bool
    /// The last path found not to start with a module name (see `module_of`).
    value_path: ?^const ast.Expr
}

/// A handler literal bound with `::` whose clauses are checked later, in the scope where
/// it was written.
PendingHandler :: struct {
    hid: u32
    lit: ^const ast.HandlerLit
    span: source.Span
    /// The frame depth where it was written.
    depth: usize
    /// The length of each scope there.
    scope_lens: []usize
    /// The number of constants of the body in scope.
    local_consts: usize
    labels: usize
    handled: usize
}

Shielded :: struct {
    at: source.Span
    handled: usize
}

fn_cx :: fn(s: ^Sema, module: usize, ret: Ty, declared: EffectSet) -> FnCx needs Alloc {
    scopes := list(List(Binding))
    scopes.push(list(Binding))!
    depths := list(u32)
    depths.push(0)!
    return FnCx(
        s: s,
        module: module,
        locals: list(tir.LocalDecl),
        scopes: scopes,
        infer: infer_table(),
        ret: ret,
        declared: declared,
        performed: list(Performed),
        labels: list(LabelInfo),
        next_label: 0,
        pending: list(PendingCoercion),
        obligations: list(Obligation),
        failed_coercions: list(source.Span),
        fn_id: null,
        needs_at: null,
        label_breaks: list(LabelBreak),
        temp_ref_arg: false,
        deferred_matches: list(DeferredMatch),
        in_defer: false,
        defer_label_base: 0,
        fn_performs: list(source.Span),
        outer: list(Frame),
        scope_depths: depths,
        scope_marks: list(sema.ScopeMark),
        captures: false,
        nested: list(NestedFn),
        open_ret: false,
        open_ty: null,
        open_fns: list(u32),
        clause: null,
        handler_breaks: list(HandlerBreak),
        iterator_calls: list(source.Span),
        handled: list(EffectRef),
        pending_handlers: list(PendingHandler),
        shielded_performs: list(Shielded),
        near_misses: list(Performed),
        iter_pre: list(tir.Stmt),
        block_temps: list(u32),
        const_init: false,
        iterator_args: list(source.Span),
        complex_free: false,
        value_path: null,
    )
}

error :: fn(cx: ^FnCx, span: source.Span, msg: string) needs Alloc {
    cx.s.error(span, msg)
}

/// Reports that gamma cannot check `what` yet, and returns an error expression.
unsupported :: fn(cx: ^FnCx, span: source.Span, what: string) -> ^Expr needs Alloc {
    cx.s.unsupported(span, what)
    return error_expr(cx.s, span)
}

show :: fn(cx: ^const FnCx, t: Ty) -> string needs Alloc => cx.s.show(t)

// ---------------------------------------------------------------------------------
// Function bodies
// ---------------------------------------------------------------------------------

/// Checks the bodies of the functions declared so far, newest first, except those of
/// the core library.
check_bodies :: fn(s: ^Sema) needs Load {
    // The core library's stay pending, checked when something needs them (compile-time
    // evaluation, code generation).
    core := list(sema.PendingBody)
    while body := s.pending_bodies.pop() {
        if s.l.modules.items[body.module].is_prelude {
            core.push(body)!
            continue
        }
        check_fn_body(s, body.fn_id, body.module, body.lit)
    }
    while body := core.pop() { s.pending_bodies.push(body)! }
}

/// Checks the body of a top-level function and stores it.
check_fn_body :: fn(s: ^Sema, fn_id: u32, module: usize, lit: ^const ast.FnLit) needs Load {
    sig := s.fns.items[usize(fn_id)]
    // A generic body is checked once, with its type parameters opaque (§16.1).
    scope_len := s.scope_type_params(sig.params)
    numeric := list(u32)
    for g in sig.generics {
        if s.param_has(g, .Num) { numeric.push(g)! }
    }
    s.checking.push(fn_id)!
    defer _ = s.checking.pop()
    outer := s.enter_module_scope()
    defer s.leave_module_scope(outer)
    cx := fn_cx(s, module, sig.ret, sig.effects)
    cx.fn_id = fn_id
    cx.infer.numeric_params = numeric.items
    // `needs not` (foreign functions only) takes no fix.
    no_needs := false
    if e := lit.sig.effects { no_needs = e.len is 0 }
    if not no_needs {
        hi := lit.sig.span.hi
        cx.needs_at = NeedsAt(span: source.Span(file: lit.sig.span.file, lo: hi, hi: hi), has_needs: lit.sig.effects is not null)
    }
    // A generic nested function can call itself by name (§11.8).
    for g in s.nested_generic.items {
        if g.fn_id is fn_id { cx.declare(g.name.name, .NestedFn(fn_id), g.name.span) }
    }
    params := list(u32)
    for p in sig.params {
        if p.generic is not null { continue }
        id := cx.new_local(p.name, p.ty, false, p.span)
        if p.name is not "_" { cx.declare(p.name, .Var(id), p.span) }
        params.push(id)!
    }
    body := cx.fn_body(&lit.body)
    cx.finish(body)
    s.unscope_type_params(scope_len)
    s.defs.items[usize(fn_id)] = tir.FnDef(kind: .Named, params: params.items, locals: cx.locals.items, body: body)
}

/// Runs the final inference pass and the effect check, and finishes the nested
/// functions.
finish :: fn(cx: ^FnCx, body: ^Expr) needs Load {
    cx.finalize(body)
    cx.check_effects()
    for i in 0..cx.locals.items.len {
        cx.locals.items[i].ty = cx.infer.resolve(cx.s, cx.locals.items[i].ty)
    }
    for n in cx.nested.items {
        if root := cx.fn_id { cx.s.nested_owner.put(n.fn_id, root)! }
        cx.fin_expr(n.body)
        for i in 0..n.locals.len { n.locals[i].ty = cx.infer.resolve(cx.s, n.locals[i].ty) }
        // An inferred return type may still have been a literal's variable.
        sig := &cx.s.fns.items[usize(n.fn_id)]
        sig.ret = cx.infer.resolve(cx.s, sig.ret)
        def := &cx.s.defs.items[usize(n.fn_id)]
        def.params = n.params
        def.locals = n.locals
        def.body = n.body
        def.nested = true
    }
    cx.nested.clear()
}

// ---------------------------------------------------------------------------------
// Locals and scopes
// ---------------------------------------------------------------------------------

new_local :: fn(cx: ^FnCx, name: string, ty: Ty, mutable: bool, span: source.Span) -> u32 needs Alloc {
    cx.locals.push(tir.LocalDecl(name: name, ty: ty, mutable: mutable, span: span))!
    return (cx.locals.items.len - 1).trunc(u32)
}

/// A compiler-generated local that is never named by the program.
temp :: fn(cx: ^FnCx, ty: Ty, span: source.Span) -> u32 needs Alloc => cx.new_local("<tmp>", ty, true, span)

/// The value of `e` if it is an untyped constant expression (§6.2), which may name
/// untyped constant locals.
try_untyped :: fn(cx: ^FnCx, e: ^const ast.Expr) -> ?sema.UntypedResult needs Load {
    match e.kind {
        .Ident(id) => {
            b := cx.lookup_local(id.name) else return cx.s.try_untyped(cx.module, e)
            .Untyped(v) := b else return null
            return .Ok(v)
        }
        .Paren(inner) => return cx.try_untyped(inner)
        .Unary(.Neg, operand) => {
            r := cx.try_untyped(operand) else return null
            .Ok(v) := r else return .Failed
            match sema.negate(&v) {
                .Ok(x) => return .Ok(x)
                .Err(m) => {
                    cx.error(e.span, m)
                    return .Failed
                }
            }
        }
        .Binary(op, lhs, rhs) => {
            if not untyped_op(op) { return null }
            a := cx.try_untyped(lhs) else return null
            b := cx.try_untyped(rhs) else return null
            .Ok(x) := a else return .Failed
            .Ok(y) := b else return .Failed
            match sema.binary(op, &x, &y) {
                .Ok(v) => return .Ok(v)
                .Err(m) => {
                    cx.error(e.span, m)
                    return .Failed
                }
            }
        }
        _ => return cx.s.try_untyped(cx.module, e)
    }
}

/// The operators of untyped constant expressions (§6.2).
untyped_op :: fn(op: ast.BinOp) -> bool => match op {
    .Add(f), .Sub(f), .Mul(f), .Shl(f) => f is .Checked
    .Div, .Rem, .Shr, .BitAnd, .BitOr, .BitXor, .Lt, .Le, .Gt, .Ge, .Is, .IsNot => true
    _ => false
}

lookup_local :: fn(cx: ^const FnCx, name: string) -> ?LocalBinding {
    i := cx.scopes.items.len
    while i > 0 {
        i -= 1
        scope := cx.scopes.items[i].items
        j := scope.len
        while j > 0 {
            j -= 1
            if scope[j].name is name { return scope[j].value }
        }
    }
    return null
}

/// Declares a local name, enforcing the no-shadowing rule and the rule that a local may
/// not be named like a type visible here (§4.6).
declare :: fn(cx: ^FnCx, name: string, b: LocalBinding, span: source.Span) needs Load {
    if name is "_" { return }
    if cx.lookup_local(name) is not null {
        cx.error(span, str.format("`{}` is already declared in this function; locals may not be shadowed", name)!)
    } else if b is not .Label and b is not .Type(_) and cx.s.names_type(cx.module, name) {
        cx.error(span, str.format("`{}` names a type; a local may not have the name of a type (§4.6)", name)!)
    } else if load.is_reserved_type_name(name) {
        cx.error(span, str.format("`{}` is a reserved type name and cannot be redeclared", name)!)
    }
    // Compile-time expressions of the body see its constants, and its variables hide the
    // top-level names they shadow (`n := 3; a: [n]u8` is an error, §4.6).
    match b {
        .Untyped(v) => cx.s.local_consts.push(sema.LocalConst(name: name, kind: .Untyped(v)))!
        .Const(c) => cx.s.local_consts.push(sema.LocalConst(name: name, kind: .Const(..c)))!
        .Var(_) => cx.s.local_consts.push(sema.LocalConst(name: name, kind: .Var))!
        _ => {}
    }
    cx.scopes.items[cx.scopes.items.len - 1].push(Binding(name: name, value: b))!
}

push_scope :: fn(cx: ^FnCx) needs Alloc {
    cx.scopes.push(list(Binding))!
    cx.scope_depths.push(cx.depth())!
    cx.scope_marks.push(cx.s.scope_mark())!
}

pop_scope :: fn(cx: ^FnCx) {
    _ = cx.scopes.pop()
    _ = cx.scope_depths.pop()
    if m := cx.scope_marks.pop() { cx.s.restore_scope(m) }
}

/// A local name's binding and the depth of the function it belongs to.
lookup_local_at :: fn(cx: ^const FnCx, name: string) -> ?(binding: LocalBinding, depth: u32) {
    i := cx.scopes.items.len
    while i > 0 {
        i -= 1
        scope := cx.scopes.items[i].items
        j := scope.len
        while j > 0 {
            j -= 1
            if scope[j].name is name { return (binding: scope[j].value, depth: cx.scope_depths.items[i]) }
        }
    }
    return null
}

// ---------------------------------------------------------------------------------
// Nested function frames
// ---------------------------------------------------------------------------------

/// The depth of the function being checked: 0 for the outermost.
depth :: fn(cx: ^const FnCx) -> u32 => cx.outer.items.len.trunc(u32)

/// The declaration of local `id` of the function at `depth`.
local_at :: fn(cx: ^const FnCx, depth: u32, id: u32) -> tir.LocalDecl {
    if depth is cx.depth() { return cx.locals.items[usize(id)] }
    return cx.outer.items[usize(depth)].locals.items[usize(id)]
}

/// Marks the functions above `depth` as capturing: they use a local of that function.
note_capture :: fn(cx: ^FnCx, depth: u32) {
    if depth >= cx.depth() { return }
    cx.captures = true
    for i in usize(depth) + 1..cx.outer.items.len { cx.outer.items[i].captures = true }
}

/// Saves the current function's state and starts checking the body of nested function
/// `fn_id`.
enter_fn :: fn(cx: ^FnCx, fn_id: u32, ret: Ty, declared: EffectSet) needs Alloc {
    cx.outer.push(Frame(
        locals: cx.locals,
        ret: cx.ret,
        declared: cx.declared,
        performed: cx.performed,
        labels: cx.labels,
        next_label: cx.next_label,
        in_defer: cx.in_defer,
        defer_label_base: cx.defer_label_base,
        fn_id: cx.fn_id,
        captures: cx.captures,
        open_ret: cx.open_ret,
        open_ty: cx.open_ty,
        clause: cx.clause,
        handled: cx.handled,
        block_temps: cx.block_temps,
    ))!
    cx.block_temps = list(u32)
    cx.handled = list(EffectRef)
    cx.clause = null
    cx.open_ret = false
    cx.open_ty = null
    cx.locals = list(tir.LocalDecl)
    cx.ret = ret
    cx.declared = declared
    cx.performed = list(Performed)
    cx.labels = list(LabelInfo)
    cx.next_label = 0
    cx.in_defer = false
    cx.defer_label_base = 0
    cx.fn_id = fn_id
    cx.captures = false
    cx.push_scope()
}

/// Leaves a nested function, restoring the enclosing one's state: its locals, what it
/// performed, and whether it captures.
exit_fn :: fn(cx: ^FnCx) -> (locals: []tir.LocalDecl, performed: []Performed, captures: bool) {
    cx.pop_scope()
    f := cx.outer.pop() else return (locals: cx.locals.items, performed: cx.performed.items, captures: cx.captures)
    out := (locals: cx.locals.items, performed: cx.performed.items, captures: cx.captures)
    cx.locals = f.locals
    cx.ret = f.ret
    cx.declared = f.declared
    cx.performed = f.performed
    cx.labels = f.labels
    cx.next_label = f.next_label
    cx.in_defer = f.in_defer
    cx.defer_label_base = f.defer_label_base
    cx.fn_id = f.fn_id
    cx.captures = f.captures
    cx.open_ret = f.open_ret
    cx.open_ty = f.open_ty
    cx.clause = f.clause
    cx.handled = f.handled
    cx.block_temps = f.block_temps
    return out
}

/// Puts frame `f`'s state in place of the current function's, which it returns.
swap_frame :: fn(cx: ^FnCx, f: Frame) -> Frame {
    out := Frame(
        locals: cx.locals,
        ret: cx.ret,
        declared: cx.declared,
        performed: cx.performed,
        labels: cx.labels,
        next_label: cx.next_label,
        in_defer: cx.in_defer,
        defer_label_base: cx.defer_label_base,
        fn_id: cx.fn_id,
        captures: cx.captures,
        open_ret: cx.open_ret,
        open_ty: cx.open_ty,
        clause: cx.clause,
        handled: cx.handled,
        block_temps: cx.block_temps,
    )
    cx.locals = f.locals
    cx.ret = f.ret
    cx.declared = f.declared
    cx.performed = f.performed
    cx.labels = f.labels
    cx.next_label = f.next_label
    cx.in_defer = f.in_defer
    cx.defer_label_base = f.defer_label_base
    cx.fn_id = f.fn_id
    cx.captures = f.captures
    cx.open_ret = f.open_ret
    cx.open_ty = f.open_ty
    cx.clause = f.clause
    cx.handled = f.handled
    cx.block_temps = f.block_temps
    return out
}

new_label :: fn(cx: ^FnCx, name: ?string, is_loop: bool, value: LabelValue) -> u32 needs Alloc {
    id := cx.next_label
    cx.next_label += 1
    cx.labels.push(LabelInfo(name: name, id: id, is_loop: is_loop, value: value))!
    return id
}

// ---------------------------------------------------------------------------------
// Bodies, blocks and statements
// ---------------------------------------------------------------------------------

fn_body :: fn(cx: ^FnCx, body: ^const ast.FnBody) -> ^Expr needs Load {
    ret := cx.ret
    checked := match body^ {
        .Expr(e) => cx.coerce(cx.expr(e, ret), ret)
        .Block(b) => cx.finish_block_body(cx.block(&b, false), &b)
    }
    return cx.declare_temps(0, checked)
}

/// `e` preceded by the declarations of the hidden locals made since `mark`: those of the
/// temporary arrays in `e`, which live until the end of the enclosing block (§15.1).
declare_temps :: fn(cx: ^FnCx, mark: usize, e: ^Expr) -> ^Expr needs Alloc {
    if cx.block_temps.items.len <= mark { return e }
    stmts := list(tir.Stmt)
    cx.push_temps(mark, &stmts)
    blk := new(tir.Block(stmts: stmts.items, tail: e, span: e.span))!
    return tir.mk(e.ty, .Block(blk), e.span)
}

/// Adds to `stmts` the declarations of the hidden locals made since `mark`.
push_temps :: fn(cx: ^FnCx, mark: usize, stmts: ^List(tir.Stmt)) needs Alloc {
    for t in cx.block_temps.items[mark..] { stmts.push(.Let(t, null))! }
    cx.block_temps.truncate(mark)
}

/// A block body that has been checked: falling off the end of an `E!()` function returns
/// success (§11.1); other non-unit functions must return a value.
finish_block_body :: fn(cx: ^FnCx, block: ^Expr, b: ^const ast.Block) -> ^Expr needs Load {
    ret := cx.ret
    tys := &cx.s.tys
    if .Result(_, ok) := tys.kind(ret) and tys.is_unit(ok) and tys.kind(block.ty) is not .Never {
        span := source.Span(file: b.span.file, lo: b.span.hi, hi: b.span.hi)
        success := cx.coerce(unit(cx.s, span), ret)
        stmts := list(tir.Stmt)
        stmts.push(.Expr(block))!
        blk := new(tir.Block(stmts: stmts.items, tail: success, span: b.span))!
        return tir.mk(ret, .Block(blk), b.span)
    }
    if not tys.is_unit(ret) and tys.kind(block.ty) is not .Never { cx.missing_return(b, ret) }
    return block
}

/// Reports that a block body returning `ret` can end without a value.
missing_return :: fn(cx: ^FnCx, b: ^const ast.Block, ret: Ty) needs Load {
    if b.stmts.len > 0 {
        if .Expr(e) := b.stmts[b.stmts.len - 1].kind and e.kind not in (.If(_), .Match(_), .For(_), .With(_), .Block(_)) {
            k := cx.obligations.items.len
            while k > 0 {
                k -= 1
                .UnitStatement(ty, span) := cx.obligations.items[k] else continue
                if span is not e.span { continue }
                t := cx.infer.resolve(cx.s, ty)
                if cx.s.tys.is_unit(t) or cx.s.tys.kind(t) is .Never { continue }
                _ = cx.obligations.remove(k)
                cx.error(e.span, str.format("a block body's last expression is not its value: write `return …`, or `=> …` for a body that is one expression (this function returns `{}`)", cx.show(ret))!)
                return
            }
        }
    }
    cx.error(source.Span(file: b.span.file, lo: b.span.hi, hi: b.span.hi), str.format("function returning `{}` can reach the end of its body without returning a value", cx.show(ret))!)
}

/// Checks a block. If `value` is true, the block's value is used: its final statement,
/// if an expression, supplies the value (§7.12).
block :: fn(cx: ^FnCx, b: ^const ast.Block, value: bool) -> ^Expr needs Load => cx.block_expected(b, value, null)

block_expected :: fn(cx: ^FnCx, b: ^const ast.Block, value: bool, expected: ?Ty) -> ^Expr needs Load {
    cx.push_scope()
    stmts := list(tir.Stmt)
    tail: ?^Expr = null
    diverges := false
    cause: ?(span: source.Span, why: string) = null
    n := b.stmts.len
    for i in 0..n {
        s := &b.stmts[i]
        if diverges {
            d := diag.error(s.span, "unreachable code")
            if c := cause { d.add_label(c.span, c.why) }
            cx.s.emit(d)
            break
        }
        // `P := v else d`: `if P := v { rest of the block } else { d }` (§4.5).
        if .LetElse(pat, v, fallback) := s.kind {
            rest_span := if i + 1 < n { b.stmts[i + 1].span.to(source.Span(file: b.span.file, lo: b.span.hi, hi: b.span.hi)) } else { source.Span(file: s.span.file, lo: s.span.hi, hi: s.span.hi) }
            rest := ast.Block(id: b.id, stmts: b.stmts[i + 1..], span: rest_span)
            fb_stmts := list(ast.Stmt)
            fb_stmts.push(ast.Stmt(id: s.id, kind: .Expr(fallback), span: fallback.span))!
            fb := ast.Block(id: b.id, stmts: fb_stmts.items, span: fallback.span)
            parts := list(ast.CondPart)
            parts.push(.Bind(pat, v))!
            branches := list(ast.IfBranch)
            branches.push(ast.IfBranch(cond: ast.Cond(parts: parts.items, span: pat.span.to(v.span)), block: rest))!
            lowered := new(ast.IfExpr(branches: branches.items, else_: .Block(fb), span: s.span))!
            mark := cx.block_temps.items.len
            ex := cx.if_expr(lowered, value, expected)
            if not value { cx.push_temps(mark, &stmts) }
            diverges = cx.s.tys.kind(ex.ty) is .Never
            if .If(x) := ex.kind {
                if e := x.else_ {
                    // In value position the fallback may be coerced to the expected type.
                    fallback_ty := if .Coerce(kind, inner) := e.kind and kind is .FromNever { inner.ty } else { e.ty }
                    if cx.s.tys.kind(fallback_ty) is not .Never and not cx.s.tys.is_error(e.ty) {
                        // One error, not also an unused value or a missing return after it.
                        k := 0
                        while k < cx.obligations.items.len {
                            if .UnitStatement(_, ospan) := cx.obligations.items[k] and ospan is fallback.span {
                                _ = cx.obligations.remove(k)
                            } else {
                                k += 1
                            }
                        }
                        cx.error(fallback.span, "the `else` of a pattern binding must leave the block: `return`, `break`, `continue` or `trap(…)` (§4.5)")
                        diverges = true
                    }
                }
            }
            if value { tail = ex } else { stmts.push(.Expr(ex))! }
            break
        }
        if i + 1 is n and value {
            if .Expr(e) := s.kind {
                ex := cx.expr(e, expected)
                diverges = cx.s.tys.kind(ex.ty) is .Never
                tail = ex
                break
            }
        }
        mark := cx.block_temps.items.len
        st := cx.stmt(s)
        cx.push_temps(mark, &stmts)
        diverges = stmt_diverges(cx.s, st)
        if diverges { cause = stmt_never_cause(cx.s, st) }
        stmts.push(st)!
    }
    if cx.pending_handlers.items.len > 0 { cx.check_pending_handlers_of_scope() }
    cx.pop_scope()
    ty := if t := tail { t.ty } else if diverges { cx.s.tys.never_ty() } else { cx.s.tys.unit() }
    blk := new(tir.Block(stmts: stmts.items, tail: tail, span: b.span))!
    return tir.mk(ty, .Block(blk), b.span)
}

stmt :: fn(cx: ^FnCx, s: ^const ast.Stmt) -> tir.Stmt needs Load {
    match s.kind {
        .Binding(attrs, binding) => {
            for a in attrs {
                cx.error(a.span, str.format("attribute `#{}` does not apply to a local binding (§20.2)", a.name.name)!)
            }
            return cx.binding(&binding)
        }
        .Assign(places, op, value) => return cx.assign(places, op, value, s.span)
        .Expr(e) => return .Expr(cx.stmt_expr(e))
        .While(w) => return .Expr(cx.while_loop(w.label, &w.cond, &w.body, s.span))
        .Block(b) => return .Expr(cx.block(&b, false))
        .Defer(is_err, body) => return cx.defer_stmt(is_err, body)
        .When(w) => return .Expr(cx.when_stmt(w))
        .Cancel(k) => return .Expr(cx.cancel_stmt(k, s.span))
        .LetElse(_, value, _) => {
            cx.error(s.span, "a binding with a pattern that can fail must be a statement of a block")
            return .Expr(cx.expr(value, null))
        }
    }
}

/// A `when` in a body (§3.6): only the branch its compile-time condition selects is
/// checked.
when_stmt :: fn(cx: ^FnCx, w: ^const ast.WhenStmt) -> ^Expr needs Load {
    taken := body_when_cond(cx.s, cx.module, w.cond) else return unit(cx.s, w.span)
    if taken { return cx.block(&w.then, false) }
    match w.else_ {
        .Block(b) => return cx.block(&b, false)
        .When(inner) => return cx.when_stmt(inner)
        null => return unit(cx.s, w.span)
    }
}

/// `defer body` or `errdefer body` (§8.8): `body` may not leave itself, and may perform
/// only operations of kind `fn`, unless it handles the others itself.
defer_stmt :: fn(cx: ^FnCx, is_err: bool, body: ^const ast.Stmt) -> tir.Stmt needs Load {
    was := cx.in_defer
    base := cx.defer_label_base
    cx.in_defer = true
    cx.defer_label_base = cx.labels.items.len
    performed_base := cx.performed.items.len
    cx.push_scope()
    inner := cx.stmt(body)
    cx.pop_scope()
    for i in performed_base..cx.performed.items.len {
        p := cx.performed.items[i]
        if p.span in cx.fn_performs.items { continue }
        exits := false
        for o in cx.s.effects.items[usize(p.effect_.eff)].ops {
            if o.kind is not .Fn { exits = true }
        }
        if exits {
            cx.error(p.span, str.format("a deferred statement may not perform `{}`, whose operations can exit or suspend, unless it handles it (§8.8)", cx.s.tys.show_ref(&p.effect_))!)
        }
    }
    cx.in_defer = was
    cx.defer_label_base = base
    x := match inner {
        .Expr(e) => e
        _ => {
            stmts := list(tir.Stmt)
            stmts.push(inner)!
            tir.mk(cx.s.tys.unit(), .Block(new(tir.Block(stmts: stmts.items, tail: null, span: body.span))!), body.span)
        }
    }
    return .Defer(is_err, x)
}

/// An expression in statement position: its value must be `()` or `never` (§7.14).
stmt_expr :: fn(cx: ^FnCx, e: ^const ast.Expr) -> ^Expr needs Load {
    ex := match e.kind {
        .If(i) => cx.if_expr(i, false, null)
        .Block(b) => cx.block(&b, false)
        .For(f) => cx.for_loop(f)
        .Match(m) => cx.match_expr(m, false, null)
        .With(w) => cx.with_expr(w, false, null)
        _ => {
            errors := cx.s.l.diags.error_count()
            x := cx.expr(e, null)
            // A call that was already reported (wrong arguments, say) has a value of
            // doubtful type: no second error about it being unused.
            if cx.s.l.diags.error_count() is not errors { return x }
            x
        }
    }
    cx.obligations.push(.UnitStatement(ex.ty, e.span))!
    return ex
}

// ---------------------------------------------------------------------------------
// Loops and conditions
// ---------------------------------------------------------------------------------

while_loop :: fn(cx: ^FnCx, label: ?ast.Ident, cond: ^const ast.Cond, body: ^const ast.Block, span: source.Span) -> ^Expr needs Load {
    cx.push_scope()
    name: ?string = null
    if l := label {
        cx.declare(l.name, .Label, l.span)
        name = l.name
    }
    c := cx.cond(cond)
    id := cx.new_label(name, true, .Nothing)
    b := cx.block(body, false)
    _ = cx.labels.pop()
    cx.pop_scope()
    infinite := true
    for part in c {
        match part {
            .Bool(x) => if x.kind is not .Bool(true) { infinite = false }
            .Match(_) => { infinite = false }
        }
    }
    breaks := cx.forget_label_breaks(id)
    ty := if infinite and not breaks { cx.s.tys.never_ty() } else { cx.s.tys.unit() }
    .Block(blk) := b.kind else return b
    return tir.mk(ty, .Loop(tir.LoopExpr(label: id, cond: c, body: blk, step: null)), span)
}

/// Checks an `if`/`while` condition (§8.2).
cond :: fn(cx: ^FnCx, c: ^const ast.Cond) -> []tir.CondPart needs Load {
    parts := list(tir.CondPart)
    for p in c.parts {
        match p {
            .Expr(e) => {
                ex := cx.expr(e, cx.s.tys.bool_ty())
                parts.push(.Bool(cx.expect_bool(ex)))!
            }
            .Bind(pat, value) => parts.push(cx.binding_cond(&pat, value))!
        }
    }
    return parts.items
}

expect_bool :: fn(cx: ^FnCx, e: ^Expr) -> ^Expr needs Load {
    k := cx.s.tys.kind(e.ty)
    if k is not .Bool and k is not .Never and k is not .Error {
        t := cx.infer.resolve(cx.s, e.ty)
        mask := false
        if p := cx.s.tys.vector_parts(t) { mask = cx.s.tys.is_bool(p.elem) }
        hint := if mask { "; a mask is tested with `.all()` or `.any()`" } else { " (there are no truthy values)" }
        cx.error(e.span, str.format("expected `bool`, found `{}`{}", cx.show(t), hint)!)
    }
    return e
}

// ---------------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------------

unit :: fn(s: ^Sema, span: source.Span) -> ^Expr needs Alloc => tir.mk(s.tys.unit(), .Aggregate(empty_slice(Expr)), span)

error_expr :: fn(s: ^Sema, span: source.Span) -> ^Expr needs Alloc => tir.mk(s.tys.error(), .Aggregate(empty_slice(Expr)), span)

/// The error for `---` at a type that is not plain data (§4.4).
uninit_message :: fn(s: ^Sema, ty: Ty) -> string needs Alloc {
    hint := if s.tys.kind(ty) is .Array(_) { "; an array can start filled: `[N]T(fill: v)`" } else { "" }
    return str.format("`---` requires a plain-data type, but `{}` is not (§4.4){}", s.show(ty), hint)!
}

/// Forgets the `break`s to the label `id` of the current function; returns whether
/// there were any.
forget_label_breaks :: fn(cx: ^FnCx, id: u32) -> bool {
    found := false
    i: usize = 0
    depth := cx.depth()
    while i < cx.label_breaks.items.len {
        if cx.label_breaks.items[i].label is id and cx.label_breaks.items[i].depth is depth {
            found = true
            _ = cx.label_breaks.remove(i)
        } else {
            i += 1
        }
    }
    return found
}

/// A block of statements as a `()` expression.
block_of :: fn(s: ^Sema, stmts: []tir.Stmt, span: source.Span) -> ^Expr needs Alloc {
    return tir.mk(s.tys.unit(), .Block(new(tir.Block(stmts: stmts, tail: null, span: span))!), span)
}

/// The error for a literal whose type an earlier use already fixed (§6.1).
early_fallback_error :: fn(s: ^Sema, span: source.Span, ty: Ty, settled_at: source.Span) -> diag.Diagnostic needs Alloc {
    t := s.show(ty)
    d := diag.error(span, str.format("the type of this value was already fixed as `{}` at an earlier use (§6.1); annotate it, e.g. `n: usize = 0`", t)!)
    d.add_label(settled_at, str.format("this use fixed the type as `{}`", t)!)
    return d
}

stmt_diverges :: fn(s: ^Sema, st: tir.Stmt) -> bool => match st {
    .Expr(e) => s.tys.kind(e.ty) is .Never
    .Let(_, null) => false
    .Let(_, x) => s.tys.kind(x.ty) is .Never
    .Assign(_, v) => s.tys.kind(v.ty) is .Never
    .LetTuple(_), .AssignTuple(_), .Defer(_, _) => false
}

/// The expression that makes statement `st` diverge, with the reason it never completes.
stmt_never_cause :: fn(s: ^Sema, st: tir.Stmt) -> ?(span: source.Span, why: string) {
    match st {
        .Expr(e) => return never_cause(s, e)
        .Let(_, null) => return null
        .Let(_, x) => return never_cause(s, x)
        .Assign(_, v) => return never_cause(s, v)
        .LetTuple(_), .AssignTuple(_), .Defer(_, _) => return null
    }
}

/// Why `e`, an expression of type `never`, never completes.
never_cause :: fn(s: ^Sema, e: ^Expr) -> ?(span: source.Span, why: string) {
    why: string = match e.kind {
        .Loop(_) => "this loop never ends: it has no `break`"
        .Return(_) => "this `return` leaves the function"
        .Break(_) => "this `break` leaves the loop"
        .Continue(_) => "this `continue` starts the next iteration of the loop"
        .Trap(_) => "this stops the program"
        .Call(callee, _) => if callee is .Perform(_) { "this operation never returns to its caller: its result type is `never`" } else { "this call never returns: its result type is `never`" }
        .If(_) => "this `if` never completes: each of its branches leaves"
        .Try(_) => "this `try` always returns"
        .Resume(_) => "this `resume` ends the handler clause"
        .Cancel(_) => "this `cancel` ends the handler clause"
        .Match(_) => "this `match` never completes: each of its arms leaves"
        .With(_) => "the body of this `with` never completes"
        .Block(b) => {
            if t := b.tail and s.tys.kind(t.ty) is .Never { return never_cause(s, t) }
            if b.stmts.len > 0 { return stmt_never_cause(s, b.stmts[b.stmts.len - 1]) }
            return null
        }
        _ => return null
    }
    return (span: e.span, why: why)
}

/// Whether `set` contains the effect `e`.
