// Checking expressions (§7): literals, names, operators, calls, construction and
// control-flow expressions (mirrors `src/sema/expr.rs`, `call.rs` and `construct.rs`).

/// Checks an expression whose value is used. `expect` is a hint from the context (the
/// caller still coerces to it where the context is a coercion site).
expr :: fn(cx: ^FnCx, e: ^const ast.Expr, expect: ?Ty) -> ^Expr needs Load {
    span := e.span
    tys := &cx.s.tys
    match e.kind {
        .Int(lit) => {
            ty := if suffix := lit.suffix { cx.s.suffix_type(suffix) } else { cx.infer.new_var(tys, .Int) }
            return tir.mk(ty, .Int(bigint.from_nat(&lit.value)), span)
        }
        .Float(lit) => {
            if lit.imag { return cx.unsupported(span, "imaginary literals") }
            ty: Ty = cx.infer.new_var(tys, .Float)
            if suffix := lit.suffix {
                ty = tys.intern(.Float(match suffix {
                    .F16 => 16
                    .F32 => 32
                    .F64 => 64
                }))
            }
            return tir.mk(ty, .UntypedFloat(sema.literal_rational(&lit.value)), span)
        }
        .Str(lit) => {
            if lit.kind is .C { return tir.mk(tys.many_ptr(true, tys.u8_ty()), .CStr(lit.bytes), span) }
            return tir.mk(tys.string_ty(), .Str(lit.bytes), span)
        }
        .Bool(b) => return tir.mk(tys.bool_ty(), .Bool(b), span)
        .Null => return cx.null_value(expect, span)
        .Uninit => {
            cx.error(span, "`---` may only initialize a variable, field or argument")
            return error_expr(cx.s, span)
        }
        .Underscore => {
            cx.error(span, "`_` cannot be used as a value")
            return error_expr(cx.s, span)
        }
        .Ident(id) => return cx.name(id.name, expect, span)
        .Paren(inner) => return cx.expr(inner, expect)
        .Tuple(elems) => return cx.tuple(elems, expect, span)
        .Unary(op, operand) => return cx.unary(op, operand, expect, span)
        .Binary(op, lhs, rhs) => {
            if op in (ast.BinOp.Range, ast.BinOp.RangeIncl) { return cx.range_value(op is .RangeIncl, lhs, rhs, expect, span) }
            if op in (ast.BinOp.Is, ast.BinOp.IsNot) and (cx.maybe_type(lhs) or cx.maybe_type(rhs)) {
                return cx.unsupported(span, "`is` on types")
            }
            l := cx.expr(lhs, null)
            return cx.binary_op(op, l, rhs, span)
        }
        .Deref(p) => return cx.deref_expr(p, span)
        .OptUnwrap(inner) => return cx.opt_unwrap(inner, span)
        .ResUnwrap(inner) => return cx.res_unwrap(inner, span)
        .Else(x) => return cx.else_expr(x.lhs, x.capture, x.rhs, expect, span)
        .Index(base, i) => return cx.index(base, i, span)
        .Slice(sl) => return cx.slice_expr(sl.base, sl.lo, sl.hi, sl.inclusive, span)
        .ArrayType(a) => {
            // `[2]P(…)[1].y`: the prefix and the construction come first (§A.7 rule 12).
            if r := sema.hoist_prefix(e) { return cx.expr(r, expect) }
            // A type prefix before a construction applies to the whole type.
            if sema.construction_call(a.elem) is null {
                cx.error(span, "expected a value, found a type")
                return error_expr(cx.s, span)
            }
            return cx.array_type_construction(e, a.len, a.elem, span)
        }
        .Field(base, name) => return cx.field(base, name, span)
        .TupleField(base, index, _) => return cx.tuple_field(base, index, span)
        .Call(callee, args, _) => return cx.call(callee, args, expect, span)
        .If(i) => return cx.if_expr(i, true, expect)
        .Match(m) => return cx.match_expr(m, true, expect)
        .For(f) => return cx.for_loop(f)
        .Block(b) => return cx.block_expected(&b, true, expect)
        .Return(v) => return cx.return_expr(v, span)
        .Return(null) => return cx.return_expr(null, span)
        .Break(b) => return cx.break_expr(b.label, b.value, span)
        .Continue(label) => return cx.continue_expr(label, span)
        .Continue(null) => return cx.continue_expr(null, span)
        .DotIdent(name) => {
            t := expect else {
                cx.error(span, str.format("cannot infer the union type of `.{}` here", name.name)!)
                return error_expr(cx.s, span)
            }
            return cx.construct_variant(cx.strip_wrappers(cx.infer.resolve(cx.s, t)), name, null, span)
        }
        .OptionalType(_) if sema.hoist_prefix(e) is not null => {
            r := sema.hoist_prefix(e) else return error_expr(cx.s, span)
            return cx.expr(r, expect)
        }
        .OptionalType(inner) if prefix_on_call(inner) => {
            call := sema.construction_call(inner) else return cx.unsupported(span, "postfix operators after a construction")
            .Call(_, args, _) := call.kind else return error_expr(cx.s, span)
            t := cx.construction_elem_type(inner) else return error_expr(cx.s, span)
            return cx.construct_optional(cx.s.tys.optional(t), t, args, span)
        }
        .OptionalType(_), .PtrType(_), .SliceType(_), .ManyPtrType(_), .ErrorUnionType(_), .FnType(_), .ContType(_), .Struct(_), .Union(_), .Effect(_) => {
            cx.error(span, "expected a value, found a type")
            return error_expr(cx.s, span)
        }
        .Intrinsic(i) => return cx.intrinsic(i, span)
        .Fn(lit) => return cx.fn_literal(lit, expect, null, span)
        .With(w) => return cx.with_expr(w, true, expect)
        .Resume(r) => return cx.resume_expr(r.cont, r.value, span)
        .Elements(inner) => {
            v := cx.expr(inner, null)
            return cx.elements_tuple(v, inner.span) else error_expr(cx.s, span)
        }
        _ => return cx.unsupported(span, expr_kind_text(&e.kind))
    }
}

/// Whether `e`, under any type prefixes, is a call: `?u8(null)` constructs a `?u8`.
prefix_on_call :: fn(e: ^const ast.Expr) -> bool => match e.kind {
    .Call(_) => true
    .OptionalType(inner), .PtrType(_, inner), .SliceType(_, inner), .ManyPtrType(_, inner) => prefix_on_call(inner)
    _ => false
}

/// What a construct gammac cannot check yet is called in its message.
expr_kind_text :: fn(k: ^const ast.ExprKind) -> string => match k^ {
    .Elements(_) => "element lists"
    .Else(_) => "`else` on optionals and results"
    .OptUnwrap(_) => "`.?`"
    .ResUnwrap(_) => "`.!`"
    .Bang(_) => "`!` on values"
    .Index(_) => "indexing"
    .Slice(_) => "slicing"
    .ArrayType(_) => "array construction"
    .Attributed(_) => "attributes on expressions"
    .Fn(_) => "function literals"
    .Handler(_) => "handler literals"
    .Import(_) => "local imports"
    .Foreign(_) => "local foreign blocks"
    .Match(_) => "`match`"
    .With(_) => "`with`"
    .For(_) => "`for` loops"
    .Resume(_) => "`resume`"
    _ => "this kind of expression"
}

/// Whether `e` may denote a type rather than a value (`T is U`), which gammac does not
/// check yet.
maybe_type :: fn(cx: ^FnCx, e: ^const ast.Expr) -> bool needs Load {
    match e.kind {
        .Paren(inner) => return cx.maybe_type(inner)
        .Ident(id) => {
            if cx.lookup_local(id.name) is not null { return false }
            if d := cx.s.lookup_module_name(cx.module, id.name) { return cx.s.resolve_decl(d) in (.Type(_), .GenericType(_)) }
            return sema.is_builtin_type_name(id.name)
        }
        .Call(_), .Field(_), .Intrinsic(_) => return false
        .Tuple(elems) => return elems.len > 0 and cx.s.looks_like_type(cx.module, e)
        _ => return cx.s.looks_like_type(cx.module, e)
    }
}

/// `null`, typed by the optional it is expected to be.
null_value :: fn(cx: ^FnCx, expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    if x := expect {
        t := cx.infer.shallow(&cx.s.tys, x)
        if cx.s.tys.kind(t) is .Optional(_) { return tir.mk(t, .Null, span) }
        if .Result(_, ok) := cx.s.tys.kind(t) and cx.s.tys.kind(ok) is .Optional(_) { return tir.mk(ok, .Null, span) }
    }
    cx.error(span, "cannot infer the type of `null` here; annotate the optional type")
    return error_expr(cx.s, span)
}

/// `p^`.
deref_expr :: fn(cx: ^FnCx, p: ^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    v := cx.expr(p, null)
    match cx.s.tys.kind(cx.infer.shallow(&cx.s.tys, v.ty)) {
        .Ptr(_, pointee) => return tir.mk(pointee, .Deref(v), span)
        .Error => return error_expr(cx.s, span)
        _ => {
            t := cx.infer.resolve(cx.s, v.ty)
            cx.error(span, str.format("`^` dereferences a pointer `^T`, but this is `{}`", cx.show(t))!)
            return error_expr(cx.s, span)
        }
    }
}

/// `t.0`: an element of a tuple.
tuple_field :: fn(cx: ^FnCx, base: ^const ast.Expr, index: u32, span: source.Span) -> ^Expr needs Load {
    b := cx.expr(base, null)
    bt := cx.infer.resolve(cx.s, b.ty)
    b = cx.auto_deref(b)
    match cx.s.tys.kind(cx.infer.resolve(cx.s, b.ty)) {
        .Tuple(elems, _) => if usize(index) < elems.len { return tir.mk(elems[usize(index)], .Field(b, index), span) }
        .Error => return error_expr(cx.s, span)
        _ => {}
    }
    cx.error(span, str.format("type `{}` has no element {}", cx.show(bt), index)!)
    return error_expr(cx.s, span)
}

/// Field access dereferences one pointer level (§5.5).
auto_deref :: fn(cx: ^FnCx, b: ^Expr) -> ^Expr needs Alloc {
    if .Ptr(_, pointee) := cx.s.tys.kind(cx.infer.shallow(&cx.s.tys, b.ty)) { return tir.mk(pointee, .Deref(b), b.span) }
    return b
}

/// A name used as a value.
name :: fn(cx: ^FnCx, name: string, expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    if found := cx.lookup_local_at(name) {
        match found.binding {
            .Var(id) => {
                ty := cx.local_at(found.depth, id).ty
                if found.depth < cx.depth() {
                    // A local of an enclosing function, captured by reference (§11.6).
                    cx.note_capture(found.depth)
                    return tir.mk(ty, .Upvar(cx.depth() - found.depth, id), span)
                }
                return tir.mk(ty, .Local(id), span)
            }
            .NestedFn(f) => {
                if f in cx.open_fns.items {
                    cx.recursive_without_ret(name, span)
                    return error_expr(cx.s, span)
                }
                return cx.fn_ref(f, span)
            }
            .Untyped(v) => return cx.untyped_literal(&v, span)
            .Const(c) => return tir.mk(c.ty, .Const(c.name, c.span), span)
            .Label => {
                cx.error(span, str.format("`{}` is a label, not a value", name)!)
                return error_expr(cx.s, span)
            }
            .Type(t) => {
                if not cx.s.tys.is_error(t) { cx.error(span, str.format("expected a value, found the type `{}`", cx.show(t))!) }
                return error_expr(cx.s, span)
            }
        }
    }
    if pid := cx.s.value_param(name) { return tir.mk(cx.value_param_ty(pid), .ValueParam(pid), span) }
    // A constant of the body whose compile-time expression this is (§17.2).
    if c := cx.s.local_const(name) {
        match c.kind {
            .Untyped(v) => return cx.untyped_literal(&v, span)
            .Const(k) => return tir.mk(k.ty, .Const(k.name, k.span), span)
            .Var => {
                d := diag.error(span, str.format("`{}` is a variable, so its value is not known at compile time", name)!)
                d.add_note("declare it with `::` to make it a compile-time constant (§17.2)")
                cx.s.emit(d)
                return error_expr(cx.s, span)
            }
        }
    }
    // A nested function of the body whose compile-time argument this is.
    if f := cx.s.local_fn(name) { return cx.fn_ref(f, span) }
    if d := cx.s.lookup_module_name(cx.module, name) { return cx.decl_expr(d, name, expect, span) }
    effect_param := false
    if t := cx.s.type_param(name) {
        if .Param(p) := cx.s.tys.kind(t) { effect_param = cx.s.param_kind(p) is .Effects }
    }
    if effect_param {
        cx.error(span, str.format("expected a value, found the effect set `{}`", name)!)
    } else if sema.is_builtin_type_name(name) {
        cx.error(span, str.format("expected a value, found the type `{}`", name)!)
    } else if name in ("print", "eprint", "trap", "assert", "expect_eq") {
        cx.error(span, str.format("the builtin function `{}` can only be called", name)!)
    } else {
        cx.s.unknown_name(cx.module, name, span)
    }
    return error_expr(cx.s, span)
}

/// The type of compile-time value parameter `pid`.
value_param_ty :: fn(cx: ^FnCx, pid: u32) -> Ty needs Alloc {
    .Value(t) := cx.s.param_kind(pid) else return cx.s.tys.error()
    return t
}

/// The length `len` of an array type `[len]T`, as a `usize` value: a compile-time value
/// parameter, a constant, or an expression computing it from those (§16.5).
len_value :: fn(cx: ^FnCx, len: Ty, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    match tys.kind(len) {
        .Param(p) => {
            v := tir.mk(cx.value_param_ty(p), .ValueParam(p), span)
            if v.ty is tys.usize_ty() { return v }
            return tir.mk(tys.usize_ty(), .Coerce(.IntWiden, v), span)
        }
        .Value(k) => {
            n := cx.s.key_int(k) else return error_expr(cx.s, span)
            return tir.mk(tys.usize_ty(), .Int(n), span)
        }
        .LenExpr(op, lhs, rhs) => {
            bop: tir.BinOp = match op {
                .Add => .Add(.Checked)
                .Sub => .Sub(.Checked)
                .Mul => .Mul(.Checked)
                .Shl => .Shl(.Checked)
                .Div => .Div
                .Rem => .Rem
                .Shr => .Shr
                .And => .BitAnd
                .Or => .BitOr
                .Xor => .BitXor
            }
            l := cx.len_value(lhs, span)
            r := cx.len_value(rhs, span)
            return tir.mk(tys.usize_ty(), .Binary(bop, l, r), span)
        }
        _ => return error_expr(cx.s, span)
    }
}

/// The value of a top-level declaration named `name`.
decl_expr :: fn(cx: ^FnCx, d: usize, name: string, expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    cx.s.check_deprecated(d, span)
    match cx.s.resolve_decl(d) {
        .Fn(f) => {
            if cx.s.fns.items[usize(f)].generics.len > 0 {
                if e := cx.generic_fn_from_expected(f, expect, span) { return e }
                cx.error(span, str.format("`{}` is generic, so it needs its compile-time arguments to be a function value: write `{}(…)` with only the types and `::` values, or give a function pointer type that determines them (§16.7)", name, name)!)
                return error_expr(cx.s, span)
            }
            return cx.fn_ref(f, span)
        }
        .Const(ty) => return tir.mk(ty, .Const(name, cx.s.l.decls.items[d].name.span), span)
        .Untyped(v) => return cx.untyped_literal(&v, span)
        .Type(_), .GenericType(_) => cx.error(span, str.format("expected a value, found the type `{}`", name)!)
        .Effect(_), .EffectInst(_) => cx.error(span, str.format("expected a value, found the effect `{}`", name)!)
        .EffectSet(_) => cx.error(span, str.format("expected a value, found the effect set `{}`", name)!)
        .Op(_) => cx.error(span, str.format("the operation `{}` can only be called", name)!)
        .Module(_) => cx.error(span, str.format("`{}` is a module, which is not a value (§3.2)", name)!)
        // Every access to a `#global` performs `Sys` (§19.3).
        .Global(ty) => {
            sys := cx.s.sys_set()
            cx.record_effects(&sys, span)
            return tir.mk(ty, .Global(cx.s.l.decls.items[d].name.name), span)
        }
        .Error => {}
    }
    return error_expr(cx.s, span)
}

/// A named function used as a value: a function pointer (§5.14).
fn_ref :: fn(cx: ^FnCx, f: u32, span: source.Span) -> ^Expr needs Alloc {
    ty := cx.s.tys.intern(.FnPtr(cx.s.fn_ty(&cx.s.fns.items[usize(f)])))
    return tir.mk(ty, .FnRef(f), span)
}

/// An untyped constant used as a value becomes a literal (§6.2).
untyped_literal :: fn(cx: ^FnCx, v: ^const sema.Untyped, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    match v^ {
        .Int(i) => return tir.mk(cx.infer.new_var(tys, .Int), .Int(i), span)
        .Float(r) => return tir.mk(cx.infer.new_var(tys, .Float), .UntypedFloat(r), span)
        .NegZero => {
            zero := tir.mk(cx.infer.new_var(tys, .Float), .UntypedFloat(ratio.from_int(bigint.zero())), span)
            return tir.mk(zero.ty, .Unary(.Neg, zero), span)
        }
        .Bool(b) => return tir.mk(tys.bool_ty(), .Bool(b), span)
        .Complex(_) => return cx.unsupported(span, "complex constants")
    }
}

tuple :: fn(cx: ^FnCx, elems: []const ast.TupleElem, expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    // The expected tuple type, also through optionals and results that would wrap it.
    want: ?Ty = null
    if x := expect { want = cx.infer.shallow(tys, x) }
    while w := want {
        match tys.kind(w) {
            .Optional(inner), .Result(_, inner) => { want = cx.infer.shallow(tys, inner) }
            _ => break
        }
    }
    expected_elems: ?[]const Ty = null
    if w := want {
        if .Tuple(es, _) := tys.kind(w) and es.len is elems.len { expected_elems = es }
    }
    named := elems.len > 0 and elems[0].name is not null
    for el in elems {
        if (el.name is not null) is not named {
            cx.error(span, "a tuple must be either fully named or fully unnamed")
            break
        }
    }
    vals := list(Expr)
    for i, el in enumerate(elems) {
        exp: ?Ty = null
        if es := expected_elems { exp = es[i] }
        v := cx.expr(&el.value, exp)
        // Each element converts to the expected element type where it can (§6.4).
        if x := exp {
            et := cx.infer.resolve(cx.s, x)
            if not tys.has_infer(et) {
                vt := cx.infer.resolve(cx.s, v.ty)
                if vt is not et and (tys.kind(vt) is .Infer(_) or (not tys.has_infer(vt) and cx.coercion_steps(vt, et) is not null)) {
                    v = cx.coerce(v, et)
                }
            }
        }
        _ = cx.reject_second_class(v, "a tuple element")
        vals.push(v^)!
    }
    names := list(string)
    if named {
        for i, el in enumerate(elems) {
            if n := el.name {
                if n.name in names.items {
                    cx.error(span, str.format("duplicate tuple element name `{}`", n.name)!)
                }
                names.push(n.name)!
            }
        }
    }
    ts := list(Ty)
    for v in vals.items { ts.push(v.ty)! }
    return tir.mk(tys.intern(.Tuple(ts.items, names.items)), .Aggregate(vals.items), span)
}

/// Reports a second-class value used as `what`. True if it was reported.
reject_second_class :: fn(cx: ^FnCx, v: ^Expr, what: string) -> bool needs Load {
    match cx.s.tys.kind(cx.infer.resolve(cx.s, v.ty)) {
        .Fn(_) => cx.error(v.span, str.format("a second-class function cannot be {}; use a function pointer `^fn(…)` (§11.6)", what)!)
        .Handler(_) => cx.error(v.span, str.format("a handler literal is second-class and cannot be {} (§11.6)", what)!)
        _ => return false
    }
    return true
}

// ---------------------------------------------------------------------------------
// Operators
// ---------------------------------------------------------------------------------

unary :: fn(cx: ^FnCx, op: ast.UnOp, operand: ^const ast.Expr, expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    match op {
        .Neg => return cx.neg_expr(operand, expect, span)
        .BitNot => {
            v := cx.expr(operand, expect)
            st := cx.infer.resolve(cx.s, v.ty)
            if cx.s.tys.kind(st) is .Adt(_) or cx.is_vector(st) { return cx.unsupported(span, "`~` on this type") }
            cx.obligations.push(.Numeric(NumericObligation(ty: v.ty, span: span, op: "~", int_only: true, signed_only: false)))!
            return tir.mk(v.ty, .Unary(.BitNot, v), span)
        }
        .Not => {
            v := cx.expr(operand, cx.s.tys.bool_ty())
            if cx.is_vector(cx.infer.resolve(cx.s, v.ty)) { return cx.unsupported(span, "`not` on vectors") }
            v = cx.expect_bool(v)
            return tir.mk(cx.s.tys.bool_ty(), .Unary(.Not, v), span)
        }
        .AddrOf => return cx.addr_of_expr(operand, expect, span)
        .MakeErr => {
            // `!e` where `?(E!T)` is expected: the result, then wrapped (§6.4).
            if t := expect and .Optional(inner) := cx.s.tys.kind(cx.infer.shallow(&cx.s.tys, t)) and cx.s.tys.kind(cx.infer.shallow(&cx.s.tys, inner)) is .Result(_) {
                r := cx.make_err_expr(operand, inner, span)
                return cx.coerce(r, t)
            }
            return cx.make_err_expr(operand, expect, span)
        }
        .Try => return cx.try_expr(operand, span)
    }
}

is_vector :: fn(cx: ^FnCx, t: Ty) -> bool {
    .Array(_, _, kind) := cx.s.tys.kind(t) else return false
    return kind in (types.ArrayKind.Simd, types.ArrayKind.Math)
}

/// `-x`. A minus applied directly to a literal is part of the literal (§7.4.1).
neg_expr :: fn(cx: ^FnCx, operand: ^const ast.Expr, expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    v := cx.expr(operand, expect)
    literal := is_literal(operand) or cx.s.tys.kind(v.ty) is .Infer(_)
    match v.kind {
        .Int(i) => if literal {
            v.kind = .Int(i.neg())
            v.span = span
            return v
        }
        // Not for zero: exact rationals have no negative zero, and `-0.0` keeps its sign.
        .UntypedFloat(r) => if literal and not r.is_zero() {
            v.kind = .UntypedFloat(r.neg())
            v.span = span
            return v
        }
        _ => {}
    }
    t := cx.infer.resolve(cx.s, v.ty)
    if cx.is_vector(t) or cx.s.tys.kind(t) is .Adt(_) { return cx.unsupported(span, "`-` on this type") }
    cx.obligations.push(.Numeric(NumericObligation(ty: v.ty, span: span, op: "-", int_only: false, signed_only: true)))!
    return tir.mk(v.ty, .Unary(.Neg, v), span)
}

is_literal :: fn(e: ^const ast.Expr) -> bool => match e.kind {
    .Int(_), .Float(_) => true
    .Paren(inner) => is_literal(inner)
    _ => false
}

/// `&place`.
addr_of_expr :: fn(cx: ^FnCx, operand: ^const ast.Expr, expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    temp_ok := cx.temp_ref_arg
    cx.temp_ref_arg = false
    // The expected pointee is a hint for the operand: `f(&.Circle(r))` (§7.2).
    hint: ?Ty = null
    if t := expect and .Ptr(_, pointee) := cx.s.tys.kind(cx.infer.shallow(&cx.s.tys, t)) { hint = pointee }
    v := cx.expr(operand, hint)
    if cx.reject_second_class(v, "the target of `&`") { return error_expr(cx.s, span) }
    if .Field(base, _) := v.kind and cx.s.bits_struct_ty(base.ty) is not null {
        cx.error(span, "the fields of a `#bits` struct have no address (§5.10.5)")
        return error_expr(cx.s, span)
    }
    match cx.place_mutability(v) {
        true => return tir.mk(cx.s.tys.ptr(false, v.ty), .AddrOf(v), span)
        false => return tir.mk(cx.s.tys.ptr(true, v.ty), .AddrOf(v), span)
        null => {
            if temp_ok { return tir.mk(cx.s.tys.ptr(true, v.ty), .AddrOfTemp(v), span) }
            cx.error(span, "`&` needs a place (a variable, `p^`, field or element), not a temporary value")
            return error_expr(cx.s, span)
        }
    }
}

/// Unifies the types of two operands that must be equal (§6.1, §7.4.1).
unify_operands :: fn(cx: ^FnCx, a, b: Ty, span: source.Span, what: string) -> Ty needs Load {
    if cx.infer.unify(&cx.s.tys, a, b) is !_ {
        ra := cx.infer.resolve(cx.s, a)
        rb := cx.infer.resolve(cx.s, b)
        d := diag.error(span, str.format("{} have different types: `{}` and `{}`", what, cx.show(ra), cx.show(rb))!)
        // `a..b else c` is `(a..b) else c`: `else` binds more loosely than `..`.
        wrapped_a := cx.s.tys.kind(ra) in (.Optional(_), .Result(_))
        wrapped_b := cx.s.tys.kind(rb) in (.Optional(_), .Result(_))
        if what is "range bounds" and wrapped_a is not wrapped_b {
            d.add_note("`else` binds more loosely than `..`; parenthesize the bound: `lo..(x else d)` (§B.1)")
        }
        cx.s.emit(d)
        return cx.s.tys.error()
    }
    return cx.infer.shallow(&cx.s.tys, a)
}

/// Checks `lhs op rhs` given the already-checked left operand.
binary_op :: fn(cx: ^FnCx, op: ast.BinOp, lhs: ^Expr, rhs: ^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    lt := cx.infer.resolve(cx.s, lhs.ty)
    if cx.is_vector(lt) or cx.s.complex_of(lt) is not null { return cx.unsupported(span, "operators on vectors and complex numbers") }
    match op {
        .And, .Or => {
            l := cx.expect_bool(lhs)
            r := cx.expr(rhs, tys.bool_ty())
            r = cx.expect_bool(r)
            return tir.mk(tys.bool_ty(), .Logic(op is .And, l, r), span)
        }
        .Is, .IsNot => {
            if p := cx.is_pattern_operand(rhs, lhs.ty) { return cx.is_pattern_test(lhs, &p, op is .IsNot, span) }
            r := cx.expr(rhs, lhs.ty)
            eq := cx.equalize(lhs, r, span)
            return tir.mk(tys.bool_ty(), .Eq(eq.l, eq.r, op is .IsNot), span)
        }
        .Lt, .Le, .Gt, .Ge => {
            r := cx.expr(rhs, lhs.ty)
            ty := cx.unify_operands(lhs.ty, r.ty, span, "the operands of a comparison")
            cx.obligations.push(.Ord(ty, span))!
            top: tir.BinOp = match op {
                .Lt => .Lt
                .Le => .Le
                .Gt => .Gt
                _ => .Ge
            }
            return tir.mk(tys.bool_ty(), .Binary(top, lhs, r), span)
        }
        .Shl(_), .Shr => {
            r := cx.expr(rhs, null)
            if not cx.infer.require_unsigned(tys, r.ty, .Usize) and not tys.is_error(r.ty) {
                t := cx.infer.resolve(cx.s, r.ty)
                cx.error(r.span, str.format("a shift amount must have an unsigned integer type, not `{}`", cx.show(t))!)
            }
            if op is .Shl(.Opt) and cx.has_optional_operand(lhs, lhs) { return cx.chained_opt_op(op, lhs, r, span) }
            cx.obligations.push(.Numeric(NumericObligation(ty: lhs.ty, span: span, op: ast.binop_text(op), int_only: true, signed_only: false)))!
            top: tir.BinOp = if .Shl(f) := op { .Shl(f) } else { .Shr }
            ty := if op is .Shl(.Opt) { tys.optional(lhs.ty) } else { lhs.ty }
            return tir.mk(ty, .Binary(top, lhs, r), span)
        }
        .Add(_), .Sub(_), .Mul(_), .Div, .Rem, .BitAnd, .BitOr, .BitXor => {
            if tys.kind(lt) is .ManyPtr(_) and op in (ast.BinOp.Add(.Checked), ast.BinOp.Sub(.Checked)) { return cx.pointer_arith(op, lhs, rhs, span) }
            if tys.kind(lt) in (.Ptr(_), .Rawptr) and (op is .Add(_) or op is .Sub(_)) {
                _ = cx.expr(rhs, null)
                cx.error(span, str.format("`{}` has no arithmetic: only many-pointers `[^]T` do (§5.5)", cx.show(lt))!)
                return error_expr(cx.s, span)
            }
            expect := lhs.ty
            if op in (ast.BinOp.Add(.Opt), ast.BinOp.Sub(.Opt), ast.BinOp.Mul(.Opt)) {
                if .Optional(inner) := tys.kind(lt) { expect = inner }
            }
            r := cx.expr(rhs, expect)
            rt := cx.infer.resolve(cx.s, r.ty)
            if cx.is_vector(rt) or cx.s.complex_of(rt) is not null { return cx.unsupported(span, "operators on vectors and complex numbers") }
            return cx.arith_op(op, lhs, r, span)
        }
        .In, .NotIn => return cx.in_expr(lhs, rhs, op is .NotIn, span)
        .Range, .RangeIncl => {
            cx.error(span, "a range cannot be an operand here; put it in parentheses")
            return error_expr(cx.s, span)
        }
    }
}

/// `lo..hi` or `lo..=hi` as a value: a `Range(T)` or `RangeIncl(T)` (§5.16).
range_value :: fn(cx: ^FnCx, inclusive: bool, lo, hi: ^const ast.Expr, expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    template := cx.s.range_template(inclusive) else {
        cx.error(span, "the core library's range types are not available")
        return error_expr(cx.s, span)
    }
    // The bound type comes from the expected range type, if there is one.
    want: ?Ty = null
    if x := expect {
        if r := cx.s.range_of(cx.infer.resolve(cx.s, x)) {
            if r.inclusive is inclusive { want = r.elem }
        }
    }
    l := cx.expr(lo, want)
    h := cx.expr(hi, if w := want { w } else { l.ty })
    elem := if w := want { w } else { cx.unify_operands(l.ty, h.ty, span, "range bounds") }
    // The struct type needs a concrete `T` now: untyped bounds take the range fallback
    // (§6.1).
    if tys.has_infer(cx.infer.resolve(cx.s, elem)) { _ = cx.infer.unify(tys, elem, tys.usize_ty()) }
    elem = cx.infer.resolve(cx.s, elem)
    // `Range(T)` needs `Ord(T)`; `RangeIncl(T)` an integer type (§5.16).
    if inclusive {
        cx.obligations.push(.Numeric(NumericObligation(ty: elem, span: span, op: "..=", int_only: true, signed_only: false)))!
    } else {
        cx.obligations.push(.Ord(elem, span))!
    }
    l = cx.coerce(l, elem)
    h = cx.coerce(h, elem)
    ty := cx.s.instantiate_adt(template, [1]Ty(elem))
    parts := list(Expr)
    parts.push(l^)!
    parts.push(h^)!
    return tir.mk(ty, .Aggregate(parts.items), span)
}

/// `p + n`, `p - n` and `p - q` on a many-pointer `p` (§5.5).
pointer_arith :: fn(cx: ^FnCx, op: ast.BinOp, lhs: ^Expr, rhs: ^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    lt := cx.infer.resolve(cx.s, lhs.ty)
    r := cx.expr(rhs, null)
    rt := cx.infer.resolve(cx.s, r.ty)
    sub := op is .Sub(_)
    if .ManyPtr(_, elem) := tys.kind(rt) {
        .ManyPtr(_, le) := tys.kind(lt) else return error_expr(cx.s, span)
        if not sub or elem is not le {
            cx.error(span, str.format("cannot {} `{}` and `{}`", if sub { "subtract" } else { "add" }, cx.show(lt), cx.show(rt))!)
            return error_expr(cx.s, span)
        }
        // The distance does not depend on `const`: make both sides read-only.
        ro := tys.many_ptr(true, elem)
        l := cx.coerce(lhs, ro)
        r2 := cx.coerce(r, ro)
        return builtin(.PtrDiff, tys.intern(.Isize), [2]^Expr(l, r2), span)
    }
    if tys.kind(rt) is .Infer(_) {
        _ = cx.unify_operands(rt, tys.usize_ty(), span, "a pointer offset")
    } else if rt is not tys.usize_ty() and rt is not tys.intern(.Isize) and not tys.is_error(rt) {
        cx.error(r.span, str.format("a pointer offset must be a `usize` or an `isize`, not `{}`", cx.show(rt))!)
        return error_expr(cx.s, span)
    }
    return builtin(if sub { tir.Builtin.PtrSub } else { tir.Builtin.PtrAdd }, lt, [2]^Expr(lhs, r), span)
}

/// True if `a` or `b` has an optional type.
has_optional_operand :: fn(cx: ^FnCx, a, b: ^Expr) -> bool needs Load {
    for t in (a.ty, b.ty) {
        if cx.s.tys.kind(cx.infer.resolve(cx.s, t)) is .Optional(_) { return true }
    }
    return false
}

/// `a +? b` with an optional operand, as in `a *? b +? c` (§7.4.2): both operands are
/// evaluated, and the result is `null` if either is `null`, else the operator applied
/// to their values.
chained_opt_op :: fn(cx: ^FnCx, op: ast.BinOp, lhs, r: ^Expr, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    stmts := list(tir.Stmt)
    cond := list(tir.CondPart)
    operands := list(^Expr)
    for e in (lhs, r) {
        t := cx.infer.resolve(cx.s, e.ty)
        tmp := cx.temp(t, e.span)
        stmts.push(.Let(tmp, e))!
        value := tir.mk(t, .Local(tmp), e.span)
        if .Optional(inner) := tys.kind(t) {
            x := cx.temp(inner, e.span)
            bind := tir.mk_pat(inner, .Bind(x), e.span)
            cond.push(.Match(tir.mk_pat(t, .Some(bind), e.span), value))!
            operands.push(tir.mk(inner, .Local(x), e.span))!
        } else {
            operands.push(value)!
        }
    }
    l := operands.items[0]
    rv := operands.items[1]
    then: ^Expr = rv
    if op is .Shl(_) {
        cx.obligations.push(.Numeric(NumericObligation(ty: l.ty, span: span, op: ast.binop_text(op), int_only: true, signed_only: false)))!
        then = tir.mk(tys.optional(l.ty), .Binary(.Shl(.Opt), l, rv), span)
    } else {
        then = cx.arith_op(op, l, rv, span)
    }
    ty := then.ty
    test := tir.mk(ty, .If(tir.IfExpr(cond: cond.items, then: then, else_: tir.mk(ty, .Null, span))), span)
    return tir.mk(ty, .Block(new(tir.Block(stmts: stmts.items, tail: test, span: span))!), span)
}

/// An arithmetic or bitwise operator applied to checked operands.
arith_op :: fn(cx: ^FnCx, op: ast.BinOp, lhs, r: ^Expr, span: source.Span) -> ^Expr needs Load {
    what := str.format("the operands of `{}`", ast.binop_text(op))!
    if op in (ast.BinOp.Add(.Opt), ast.BinOp.Sub(.Opt), ast.BinOp.Mul(.Opt)) and cx.has_optional_operand(lhs, r) { return cx.chained_opt_op(op, lhs, r, span) }
    match op {
        .Add(f), .Sub(f), .Mul(f) => {
            ty := cx.unify_operands(lhs.ty, r.ty, span, what)
            cx.obligations.push(.Numeric(NumericObligation(ty: ty, span: span, op: ast.binop_text(op), int_only: f is not .Checked, signed_only: false)))!
            top: tir.BinOp = match op {
                .Add(_) => .Add(f)
                .Sub(_) => .Sub(f)
                _ => .Mul(f)
            }
            rty := if f is .Opt { cx.s.tys.optional(ty) } else { ty }
            return tir.mk(rty, .Binary(top, lhs, r), span)
        }
        _ => {
            ty := cx.unify_operands(lhs.ty, r.ty, span, what)
            st := cx.infer.resolve(cx.s, ty)
            if op is not .Div and op is not .Rem and cx.s.bits_struct_ty(st) is not null {
                return cx.unsupported(span, "bitwise operators on `#bits` structs")
            }
            cx.obligations.push(.Numeric(NumericObligation(ty: ty, span: span, op: ast.binop_text(op), int_only: op is not .Div, signed_only: false)))!
            top: tir.BinOp = match op {
                .Div => .Div
                .Rem => .Rem
                .BitAnd => .BitAnd
                .BitOr => .BitOr
                _ => .BitXor
            }
            return tir.mk(ty, .Binary(top, lhs, r), span)
        }
    }
}

/// The operands of `is`, converted to one type.
equalize :: fn(cx: ^FnCx, l: ^Expr, r: ^Expr, span: source.Span) -> (l: ^Expr, r: ^Expr) needs Load {
    tys := &cx.s.tys
    lt := cx.infer.resolve(cx.s, l.ty)
    rt := cx.infer.resolve(cx.s, r.ty)
    if not tys.has_infer(lt) and not tys.is_error(lt) and not cx.s.has_eq(lt) {
        cx.error(span, str.format("`is` is not defined for `{}` (§7.6)", cx.show(lt))!)
    }
    // A literal compared with an optional or result is wrapped: `x is 1`.
    wraps :: fn(t: Ty) -> bool => tys.kind(t) in (.Optional(_), .Result(_)) and not tys.has_infer(t)
    if tys.kind(rt) is .Infer(_) and wraps(lt) { return (l: l, r: cx.coerce(r, lt)) }
    if tys.kind(lt) is .Infer(_) and wraps(rt) { return (l: cx.coerce(l, rt), r: r) }
    if cx.s.complex_of(lt) is not null or cx.s.complex_of(rt) is not null {
        return (l: l, r: cx.unsupported(span, "complex numbers"))
    }
    if tys.has_infer(lt) or tys.has_infer(rt) or lt is rt {
        _ = cx.unify_operands(l.ty, r.ty, span, "the operands of `is`")
        return (l: l, r: r)
    }
    if cx.coercion_steps(rt, lt) is not null { return (l: l, r: cx.coerce(r, lt)) }
    if cx.coercion_steps(lt, rt) is not null { return (l: cx.coerce(l, rt), r: r) }
    cx.error(span, str.format("cannot compare `{}` with `{}`", cx.show(lt), cx.show(rt))!)
    return (l: l, r: r)
}

// ---------------------------------------------------------------------------------
// Fields
// ---------------------------------------------------------------------------------

/// The module a module-binding expression (`m` in `m.x`) names, unless a local shadows it.
module_of :: fn(cx: ^FnCx, e: ^const ast.Expr) -> ?usize needs Load {
    if .Field(base, name) := e.kind {
        m := cx.module_of(base) else return null
        return cx.s.public_module_member(m, name.name, cx.module)
    }
    .Ident(id) := e.kind else return null
    if cx.lookup_local(id.name) is not null { return null }
    d := cx.s.lookup_module_name(cx.module, id.name) else return null
    .Module(m) := cx.s.resolve_decl(d) else return null
    return m
}

/// If `e` is a name denoting a type, that type.
type_of_name :: fn(cx: ^FnCx, e: ^const ast.Expr) -> ?Ty needs Load {
    if .Field(base, name) := e.kind {
        if m := cx.module_of(base) {
            d := cx.s.module_member(m, name, cx.module) else return null
            .Type(t) := cx.s.resolve_decl(d) else return null
            return t
        }
    }
    // `G(args)` or `m.G(args)` where `G` is a generic type.
    if .Call(callee, _, _) := e.kind {
        d: usize = 0
        match callee.kind {
            .Ident(id) => {
                if cx.lookup_local(id.name) is not null { return null }
                d = cx.s.lookup_module_name(cx.module, id.name) else return null
            }
            .Field(base, name) => {
                m := cx.module_of(base) else return null
                d = cx.s.l.lookup(m, name.name) else return null
                if not cx.s.decl_visible(d, cx.module) { return null }
            }
            _ => return null
        }
        if cx.s.resolve_decl(d) is not .GenericType(_) { return null }
        t := cx.s.resolve_type(cx.module, e)
        if cx.s.tys.is_error(t) { return null }
        return t
    }
    .Ident(id) := e.kind else return null
    // A local alias: `Cols :: #soa []T` then `Cols.make(n)`.
    if b := cx.lookup_local(id.name) {
        if .Type(t) := b { return t }
        return null
    }
    if d := cx.s.lookup_module_name(cx.module, id.name) {
        .Type(t) := cx.s.resolve_decl(d) else return null
        return t
    }
    return cx.s.builtin_type(id.name)
}

field :: fn(cx: ^FnCx, base: ^const ast.Expr, name: ast.Ident, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    // `m.x`: a declaration of another module (§3.2).
    if m := cx.module_of(base) {
        d := cx.s.module_member(m, name, cx.module) else return error_expr(cx.s, span)
        return cx.decl_expr(d, name.name, null, span)
    }
    // `U.V`: a payload-less variant of a union type.
    if t := cx.type_of_name(base) { return cx.construct_variant(t, name, null, span) }
    b := cx.expr(base, null)
    b = cx.auto_deref(b)
    bt := cx.infer.resolve(cx.s, b.ty)
    match tys.kind(bt) {
        .Tuple(elems, names) => {
            for i, n in enumerate(names) {
                if n is name.name { return tir.mk(elems[i], .Field(b, i.trunc(u32)), span) }
            }
        }
        .Slice(c, e) => {
            if name.name is "len" { return tir.mk(tys.usize_ty(), .SliceLen(b), span) }
            if name.name is "ptr" { return tir.mk(tys.many_ptr(c, e), .SlicePtr(b), span) }
        }
        .Array(len, _, _) => if name.name is "len" { return tir.mk(tys.usize_ty(), .Int(bigint.from_u64(len)), span) }
        .ParamArray(len, _) => if name.name is "len" { return cx.len_value(len, span) }
        .Error => return error_expr(cx.s, span)
        _ => {}
    }
    if .Adt(id, _) := tys.kind(bt) {
        if cx.s.adts.items[usize(id)].has_using { return cx.unsupported(span, "`using` fields") }
        if fields := cx.s.struct_fields(bt) {
            for i, f in enumerate(fields) {
                if f.name is not name.name { continue }
                if not cx.field_visible_here(f.vis, bt) { cx.error(span, hidden_field_message(cx, name.name, bt, f.vis)) }
                return tir.mk(f.ty, .Field(b, i.trunc(u32)), span)
            }
        }
        if .CUnion(_) := cx.s.adts.items[usize(id)].kind { return cx.unsupported(span, "`#c_union` fields") }
    }
    d := diag.error(name.span, str.format("type `{}` has no field `{}`", cx.show(bt), name.name)!)
    cx.emit_with_continuation_note(d, base.span, name.span)
    return error_expr(cx.s, span)
}

/// Whether the private fields of `t` are visible here.
/// Whether a field of visibility `vis` of type `t` can be named here (§3.3).
field_visible_here :: fn(cx: ^const FnCx, vis: ast.Visibility, t: Ty) -> bool {
    if vis is .Public { return true }
    .Adt(id, _) := cx.s.tys.kind(t) else return true
    return cx.s.visible(vis, cx.s.adts.items[usize(id)].module, cx.module)
}

/// The first field of struct type `t` that is not visible here, if any, with what the
/// field is visible to: "module" or "package".
hidden_field :: fn(cx: ^const FnCx, t: Ty) -> ?(name: string, owner: string) {
    fields := cx.s.struct_fields(t) else return null
    for f in fields {
        if not cx.field_visible_here(f.vis, t) { return (name: f.name, owner: if f.vis is .Package { "package" } else { "module" }) }
    }
    return null
}

/// The error for naming field `name` of type `t`, of visibility `vis`, where it is not
/// visible (§3.3).
hidden_field_message :: fn(cx: ^const FnCx, name: string, t: Ty, vis: ast.Visibility) -> string needs Alloc {
    if vis is .Package { return str.format("the field `{}` of `{}` is visible only in the package of its module (§3.3)", name, cx.show(t))! }
    return str.format("the field `{}` of `{}` is private to its module (§3.3)", name, cx.show(t))!
}

// ---------------------------------------------------------------------------------
// Control flow
// ---------------------------------------------------------------------------------

if_expr :: fn(cx: ^FnCx, i: ^const ast.IfExpr, value_: bool, expect: ?Ty) -> ^Expr needs Load {
    value := value_ and i.else_ is not null
    tys := &cx.s.tys
    conds := list([]tir.CondPart)
    thens := list(^Expr)
    // With `else e => d`, the last branch becomes a `match` on its result (§8.2).
    captured: ?Captured = null
    else_: ?^Expr = null
    for k, br in enumerate(i.branches) {
        cx.push_scope()
        if .Capture(name, body) := i.else_ and k + 1 is i.branches.len {
            if br.cond.parts.len is not 1 or br.cond.parts[0] is not .Bind(_) {
                cx.error(br.cond.span, "`else e =>` needs a condition that is a single binding on a result (§8.2)")
                cx.pop_scope()
                return error_expr(cx.s, i.span)
            }
            .Bind(pat, x) := br.cond.parts[0] else return error_expr(cx.s, i.span)
            .Match(p, v) := cx.binding_cond(&pat, x) else return error_expr(cx.s, i.span)
            then := cx.block_expected(&br.block, value, expect)
            cx.pop_scope()
            vt := cx.infer.resolve(cx.s, v.ty)
            .Result(err, _) := tys.kind(vt) else {
                if not tys.is_error(vt) { cx.error(x.span, str.format("`else e =>` captures the error of a result, but this is `{}`", cx.show(vt))!) }
                return error_expr(cx.s, i.span)
            }
            ok := false
            if .Ok(q) := p.kind { ok = irrefutable(cx.s, q) }
            if not ok { cx.error(pat.span, "with `else e =>`, the condition may fail only on an error (§8.2)") }
            cx.push_scope()
            id := cx.new_local(name.name, err, false, name.span)
            cx.declare(name.name, .Var(id), name.span)
            d := cx.expr(body, if value { expect } else { null })
            cx.pop_scope()
            if not value and tys.kind(d.ty) is not .Never {
                // As a statement, the fallback's value is discarded.
                stmts := list(tir.Stmt)
                stmts.push(.Expr(d))!
                d = tir.mk(tys.unit(), .Block(new(tir.Block(stmts: stmts.items, tail: null, span: d.span))!), d.span)
            }
            err_pat := tir.mk_pat(vt, .Err(tir.mk_pat(err, .Bind(id), name.span)), name.span)
            captured = Captured(value: v, pat: p, then: then, err_pat: err_pat)
            // The fallback joins like an `else` block.
            else_ = d
            continue
        }
        c := cx.cond(&br.cond)
        b := cx.block_expected(&br.block, value, expect)
        cx.pop_scope()
        conds.push(c)!
        thens.push(b)!
    }
    if .Block(b) := i.else_ { else_ = cx.block_expected(&b, value, expect) }
    ty: Ty = tys.unit()
    if value {
        if x := expect {
            ty = x
        } else {
            ty = tys.never_ty()
            found := false
            for t in thens.items {
                if not found and tys.kind(t.ty) is not .Never {
                    ty = t.ty
                    found = true
                }
            }
            if not found {
                if c := captured and tys.kind(c.then.ty) is not .Never {
                    ty = c.then.ty
                    found = true
                }
            }
            if not found {
                if e := else_ and tys.kind(e.ty) is not .Never { ty = e.ty }
            }
        }
        for k in 0..thens.items.len { thens.items[k] = cx.join_branch(thens.items[k], ty) }
        if e := else_ { else_ = cx.join_branch(e, ty) }
    } else {
        all_never := false
        if e := else_ { all_never = tys.kind(e.ty) is .Never }
        for t in thens.items {
            if tys.kind(t.ty) is not .Never { all_never = false }
        }
        if c := captured and tys.kind(c.then.ty) is not .Never { all_never = false }
        if all_never { ty = tys.never_ty() }
    }
    if c := captured {
        then := if value { cx.join_branch(c.then, ty) } else { c.then }
        d := else_ else return error_expr(cx.s, i.span)
        arms := list(tir.Arm)
        arms.push(tir.Arm(pat: c.pat, guard: null, body: then))!
        arms.push(tir.Arm(pat: c.err_pat, guard: null, body: d))!
        else_ = tir.mk(ty, .Match(c.value, arms.items), then.span)
    }
    // Build the chain from the end.
    k := thens.items.len
    while k > 0 {
        k -= 1
        then := thens.items[k]
        else_ = tir.mk(ty, .If(tir.IfExpr(cond: conds.items[k], then: then, else_: else_)), then.span)
    }
    r := else_ else unit(cx.s, i.span)
    r.span = i.span
    return r
}

/// The last branch of an `if` with `else e => d`: the result it matches, the pattern of
/// its success and the branch, and the pattern binding the error.
Captured :: struct {
    value: ^Expr
    pat: ^tir.Pat
    then: ^Expr
    err_pat: ^tir.Pat
}

join_branch :: fn(cx: ^FnCx, b: ^Expr, ty: Ty) -> ^Expr needs Load {
    if cx.s.tys.kind(ty) is .Never { return b }
    return cx.coerce(b, ty)
}

return_expr :: fn(cx: ^FnCx, v: ?^ast.Expr, span: source.Span) -> ^Expr needs Load {
    if cx.in_defer { cx.error(span, "`return` is not allowed in a deferred statement") }
    target := cx.return_target()
    levels := target.levels
    cx.check_fn_clause_exit(levels, "return", span)
    if levels is 0 and cx.open_ret { return cx.open_return(v, span) }
    if levels > 0 and cx.outer.items[cx.outer.items.len - usize(levels)].open_ret {
        return cx.unsupported(span, "`return` from a handler clause to a function literal")
    }
    ret := target.ret
    value := if x := v {
        cx.coerce(cx.expr(x, ret), ret)
    } else {
        if not cx.s.tys.is_unit(ret) and not cx.s.tys.is_error(ret) {
            cx.error(span, str.format("`return` needs a value of type `{}`", cx.show(ret))!)
        }
        unit(cx.s, span)
    }
    return tir.mk(cx.s.tys.never_ty(), .Return(levels, value), span)
}

/// The function a `return` leaves, `levels` frames up, and its return type: a `return`
/// in a handler clause leaves the function the clause is written in (§12.7.1).
return_target :: fn(cx: ^const FnCx) -> (levels: u32, ret: Ty) {
    if cx.clause is null { return (levels: 0, ret: cx.ret) }
    levels: u32 = 0
    k := cx.outer.items.len
    while k > 0 {
        k -= 1
        levels += 1
        f := &cx.outer.items[k]
        if f.clause is null { return (levels: levels, ret: f.ret) }
    }
    return (levels: 0, ret: cx.ret)
}

/// An exit `levels` frames out may not leave a clause of a `fn` operation, which can
/// only produce a value (§12.7.1).
check_fn_clause_exit :: fn(cx: ^FnCx, levels: u32, what: string, span: source.Span) needs Alloc {
    if levels is 0 { return }
    crossed := false
    if c := cx.clause and c.op_kind is .Fn { crossed = true }
    n := cx.outer.items.len
    for i in 0..usize(levels) - 1 {
        if i + 1 > n { break }
        if c := cx.outer.items[n - i - 1].clause and c.op_kind is .Fn { crossed = true }
    }
    if crossed { cx.error(span, str.format("a clause of a `fn` operation can only produce a value; it cannot `{}`", what)!) }
}

/// A `return` in a literal whose return type comes from its `return`s: the first one
/// with a value fixes the type, the others convert to it.
open_return :: fn(cx: ^FnCx, v: ?^ast.Expr, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    value := unit(cx.s, span)
    if x := v {
        if t := cx.open_ty {
            value = cx.coerce(cx.expr(x, t), t)
        } else {
            value = cx.expr(x, null)
            if tys.kind(value.ty) is not .Never and not tys.is_error(value.ty) { cx.open_ty = value.ty }
        }
    } else if t := cx.open_ty {
        if not tys.is_unit(cx.infer.resolve(cx.s, t)) and not tys.is_error(t) { cx.error(span, str.format("`return` needs a value of type `{}`", cx.show(t))!) }
    } else {
        cx.open_ty = tys.unit()
    }
    return tir.mk(tys.never_ty(), .Return(0, value), span)
}

/// Where a `break` or `continue` goes.
Jump :: union {
    /// A loop or `with` of the function `levels` frames up.
    Label: (levels: u32, info: LabelInfo)
    /// Out of the `with` that installed the handler whose clause this is.
    InstallingWith
    /// The end of the clause `levels` frames up, with `()`.
    ClauseReturn: u32
}

/// The last label of `labels` named `label`, or the innermost loop without one.
find_label :: fn(labels: []const LabelInfo, label: ?ast.Ident) -> ?usize {
    i := labels.len
    while i > 0 {
        i -= 1
        x := labels[i]
        found := if l := label { x.name is l.name } else { x.is_loop }
        if found { return i }
    }
    return null
}

/// Resolves the target of `break` or `continue` (§8.5, §12.7.1).
find_jump :: fn(cx: ^FnCx, label: ?ast.Ident, span: source.Span, is_continue: bool) -> ?Jump needs Load {
    if idx := find_label(cx.labels.items, label) {
        if cx.in_defer and idx < cx.defer_label_base { cx.error(span, "a deferred statement may not `break` or `continue` out of itself") }
        info := cx.labels.items[idx]
        if is_continue and not info.is_loop { cx.error(span, "`continue` can only target a loop") }
        return .Label(levels: 0, info: info)
    }
    if cx.in_defer {
        cx.error(span, "a deferred statement may not `break` or `continue` out of itself")
        return null
    }
    // At clause level: exit the installing `with`, or (for `continue`) finish the clause.
    clause := cx.clause else {
        if l := label {
            cx.error(l.span, str.format("no enclosing loop or `with` is labeled `{}`", l.name)!)
        } else {
            cx.error(span, "`break` and `continue` must be inside a loop")
        }
        return null
    }
    l := label else {
        if clause.op_kind is .Fn {
            cx.error(span, "a clause of a `fn` operation can only produce a value; it cannot `break` or `continue`")
            return null
        }
        if is_continue and clause.op_kind is .Ctl {
            cx.error(span, "a `ctl` clause cannot `continue`: end it with `resume`, `break` or an exit (§12.7.1)")
            return null
        }
        // `continue` produces `()` as the operation's result (§12.7.1).
        ret := cx.infer.resolve(cx.s, cx.ret)
        if is_continue and not cx.s.tys.is_unit(ret) and not cx.s.tys.is_error(ret) {
            cx.error(span, str.format("`continue` finishes the clause with `()`, but the operation returns `{}` (§12.7.1)", cx.show(ret))!)
            return null
        }
        return if is_continue { .ClauseReturn(0) } else { .InstallingWith }
    }
    // A labeled jump from a handler clause to a construct enclosing the handler.
    frame_clause: ?ClauseInfo = clause
    levels: u32 = 0
    k := cx.outer.items.len
    while k > 0 {
        c := frame_clause else break
        if is_continue and fl := c.for_label and n := fl.name and n is l.name {
            cx.check_fn_clause_exit(levels + 1, "continue", span)
            return .ClauseReturn(levels)
        }
        k -= 1
        f := &cx.outer.items[k]
        if idx := find_label(f.labels.items, label) {
            info := f.labels.items[idx]
            if is_continue and not info.is_loop { cx.error(span, "`continue` can only target a loop") }
            cx.check_fn_clause_exit(levels + 1, if is_continue { "continue" } else { "break" }, span)
            return .Label(levels: levels + 1, info: info)
        }
        frame_clause = f.clause
        levels += 1
    }
    cx.error(l.span, str.format("no enclosing loop or `with` is labeled `{}`", l.name)!)
    return null
}

break_expr :: fn(cx: ^FnCx, label: ?ast.Ident, value: ?^ast.Expr, span: source.Span) -> ^Expr needs Load {
    jump := cx.find_jump(label, span, false) else return error_expr(cx.s, span)
    nv := cx.s.tys.never_ty()
    match jump {
        .Label(levels, info) => {
            depth := cx.depth() - levels
            v: ?^Expr = null
            match info.value {
                .Nothing => {
                    cx.label_breaks.push(LabelBreak(depth: depth, label: info.id, ty: cx.s.tys.unit(), span: span))!
                    if x := value { cx.error(x.span, "a `while` loop has no value, so `break` takes no operand here") }
                }
                // A `break` that exits a `for` loop, whose value is `rt` (§13.2).
                .Loop(rt) => {
                    cx.label_breaks.push(LabelBreak(depth: depth, label: info.id, ty: cx.s.tys.unit(), span: span))!
                    if x := value {
                        v = cx.coerce(cx.expr(x, rt), rt)
                    } else if not cx.s.tys.is_unit(rt) and not cx.s.tys.is_error(rt) {
                        cx.error(span, str.format("this loop's value is `{}`, so `break` needs a value", cx.show(rt))!)
                    }
                }
                .With(_) => {
                    expect: ?Ty = if .With(t) := info.value { t } else { null }
                    // Checked against the `with`'s value once the `with` is finished (§12.7).
                    v = cx.break_value(value, expect)
                    ty := if x := v { if t := expect { t } else { x.ty } } else { cx.s.tys.unit() }
                    cx.label_breaks.push(LabelBreak(depth: depth, label: info.id, ty: ty, span: span))!
                }
            }
            return tir.mk(nv, .Break(tir.BreakExpr(target: .Label(levels: levels, label: info.id), value: v)), span)
        }
        .InstallingWith => {
            c := cx.clause else return error_expr(cx.s, span)
            // A `break` that exits a `for` over an iterator (§13.2).
            if rt := c.break_ty {
                v: ?^Expr = null
                if x := value {
                    v = cx.coerce(cx.expr(x, rt), rt)
                } else if not cx.s.tys.is_unit(rt) and not cx.s.tys.is_error(rt) {
                    cx.error(span, str.format("this loop's value is `{}`, so `break` needs a value", cx.show(rt))!)
                }
                return tir.mk(nv, .Break(tir.BreakExpr(target: .InstallingWith, value: v)), span)
            }
            v := cx.break_value(value, c.with_expect)
            ty := if x := v { if t := c.with_expect { t } else { x.ty } } else { cx.s.tys.unit() }
            if h := c.handler_ { cx.handler_breaks.push(HandlerBreak(handler_: h, ty: ty, span: span))! }
            if f := c.decl_clause { cx.s.decl_clause_breaks.push(sema.DeclBreak(fn_id: f, ty: cx.infer.resolve(cx.s, ty), span: span))! }
            return tir.mk(nv, .Break(tir.BreakExpr(target: .InstallingWith, value: v)), span)
        }
        .ClauseReturn(_) => return error_expr(cx.s, span)
    }
}

/// The value of a `break` out of a `with` whose value is expected to have type `expect`.
break_value :: fn(cx: ^FnCx, value: ?^ast.Expr, expect: ?Ty) -> ?^Expr needs Load {
    x := value else return null
    ex := cx.expr(x, expect)
    if t := expect { return cx.coerce(ex, t) }
    return ex
}

continue_expr :: fn(cx: ^FnCx, label: ?ast.Ident, span: source.Span) -> ^Expr needs Load {
    nv := cx.s.tys.never_ty()
    match cx.find_jump(label, span, true) {
        .Label(levels, info) => return tir.mk(nv, .Continue(.Label(levels: levels, label: info.id)), span)
        // `continue` at clause level finishes the clause with `()` (§12.7.1).
        .ClauseReturn(levels) => return tir.mk(nv, .Return(levels, unit(cx.s, span)), span)
        _ => return error_expr(cx.s, span)
    }
}

// ---------------------------------------------------------------------------------
// Construction
// ---------------------------------------------------------------------------------

/// The type inside optional and result wrappers, where a variant shorthand's union type
/// is found (`x: ?Shape = .Empty`).
strip_wrappers :: fn(cx: ^FnCx, t0: Ty) -> Ty {
    t := t0
    while true {
        match cx.s.tys.kind(t) {
            .Optional(i) => { t = i }
            .Result(_, ok) => { t = ok }
            _ => return t
        }
    }
}

/// `.V`, `.V(args)`, `U.V`, `U.V(args)` for a union type `u`.
construct_variant :: fn(cx: ^FnCx, u: Ty, name: ast.Ident, args: ?[]const ast.Arg, span: source.Span) -> ^Expr needs Load {
    vs := cx.s.union_variants(u) else {
        cx.error(span, str.format("`.{}` needs a union type, but the expected type is `{}`", name.name, cx.show(u))!)
        return error_expr(cx.s, span)
    }
    idx: ?usize = null
    for i, v in enumerate(vs.variants) {
        if v.name is name.name {
            idx = i
            break
        }
    }
    i := idx else {
        cx.error(name.span, str.format("`{}` has no variant `{}`", cx.show(u), name.name)!)
        return error_expr(cx.s, span)
    }
    payload_ty := vs.variants[i].payload
    payload: ?^Expr = null
    if pt := payload_ty {
        a := args else {
            cx.error(span, str.format("variant `{}` needs a payload: `.{}(…)`", name.name, name.name)!)
            return error_expr(cx.s, span)
        }
        // A tuple payload's elements are written directly (§5.11).
        if .Tuple(elems, names) := cx.s.tys.kind(pt) {
            if a.len is not 1 or elems.len is not 1 or a[0].kind is .Named(_) {
                payload = cx.construct_tuple(pt, elems, names, a, span)
                return tir.mk(u, .Variant(tir.VariantExpr(variant: i.trunc(u32), payload: payload)), span)
            }
        }
        if a.len is not 1 or a[0].kind is not .Positional(_) {
            cx.error(span, str.format("expected one payload value of type `{}`", cx.show(pt))!)
            return error_expr(cx.s, span)
        }
        .Positional(x) := a[0].kind else return error_expr(cx.s, span)
        payload = cx.field_value(&x, pt)
    } else if args is not null {
        cx.error(span, str.format("variant `{}` has no payload", name.name)!)
        return error_expr(cx.s, span)
    }
    return tir.mk(u, .Variant(tir.VariantExpr(variant: i.trunc(u32), payload: payload)), span)
}

/// The named fields a spread of a value of type `vt` supplies to a construction.
spread_source_fields :: fn(cx: ^FnCx, vt: Ty, e: ^const ast.Expr) -> ?[]SourceField needs Alloc {
    out := list(SourceField)
    if .Tuple(elems, names) := cx.s.tys.kind(vt) and names.len > 0 {
        for i, n in enumerate(names) { out.push(SourceField(name: n, ty: elems[i]))! }
        return out.items
    }
    fs := cx.s.struct_fields(vt) else {
        if not cx.s.tys.is_error(vt) { cx.error(e.span, str.format("cannot spread a value of type `{}` into named arguments", cx.show(vt))!) }
        return null
    }
    for f in fs { out.push(SourceField(name: f.name, ty: f.ty))! }
    return out.items
}

SourceField :: struct {
    name: string
    ty: Ty
}

/// Builds a tuple of type `ty` from call-style arguments (positional or named).
construct_tuple :: fn(cx: ^FnCx, ty: Ty, elems: []const Ty, names: []const string, args: []const ast.Arg, span: source.Span) -> ^Expr needs Load {
    slots := list(?^Expr)
    for _ in elems { slots.push(null)! }
    next: usize = 0
    // With spreads, every value goes through a temporary, in the order written.
    spreading := false
    for a in args {
        if a.kind is .Spread(_) { spreading = true }
    }
    stmts := list(tir.Stmt)
    // A spread that could not be expanded already explains the missing elements.
    spread_failed := false
    // `T(t)` with a tuple `t` is not a conversion: a tuple type takes one value per
    // element (§6.5), and `T(..t)` builds it from another tuple.
    if args.len is 1 and elems.len is not 1 and .Positional(e) := args[0].kind {
        v := cx.expr(&e, null)
        vt := cx.infer.resolve(cx.s, v.ty)
        what: ?string = match cx.s.tys.kind(vt) {
            .Tuple(_) => "a tuple"
            .Array(_, _, kind) => if kind in (.Plain, .Simd) { "an array" } else { null }
            _ => null
        }
        if w := what {
            cx.error(span, str.format("`{}` takes one value per element, so {} is not converted to it; spread it: `{}(..x)` (§6.5)", cx.show(ty), w, cx.show(ty))!)
            return error_expr(cx.s, span)
        }
        if elems.len > 0 {
            slots.items[0] = cx.coerce(v, elems[0])
            next = 1
        }
    }
    for arg in args[next.min(args.len)..] {
        parts := list(TuplePart)
        match arg.kind {
            .Positional(e) => {
                if next >= elems.len {
                    cx.error(e.span, str.format("too many values for `{}`", cx.show(ty))!)
                    continue
                }
                parts.push(TuplePart(name: null, value: cx.field_value(&e, elems[next]), at: e.span))!
            }
            .Named(n, e) => {
                i := index_of_name(names, n.name) else {
                    cx.error(n.span, str.format("`{}` has no element named `{}`", cx.show(ty), n.name)!)
                    continue
                }
                parts.push(TuplePart(name: n.name, value: cx.field_value(&e, elems[i]), at: n.span))!
            }
            .Spread(e) => {
                ps := cx.spread_parts(&e, &stmts) else {
                    spread_failed = true
                    continue
                }
                for p in ps { parts.push(TuplePart(name: p.name, value: p.value, at: e.span))! }
            }
        }
        for part in parts.items {
            i: usize = 0
            if n := part.name {
                i = index_of_name(names, n) else {
                    cx.error(part.at, str.format("`{}` has no element named `{}`", cx.show(ty), n)!)
                    continue
                }
            } else {
                if next >= elems.len {
                    cx.error(part.at, str.format("too many values for `{}`", cx.show(ty))!)
                    break
                }
                i = next
                next += 1
            }
            if slots.items[i] is not null { cx.error(part.at, str.format("element {} of `{}` is given twice", i, cx.show(ty))!) }
            v := cx.coerce(part.value, elems[i])
            slots.items[i] = if spreading { cx.bind_temp(v, &stmts) } else { v }
        }
    }
    values := list(Expr)
    for i in 0..elems.len {
        if v := slots.items[i] {
            values.push(v^)!
        } else {
            if not spread_failed { cx.error(span, str.format("missing element {} of `{}`", i, cx.show(ty))!) }
            values.push(error_expr(cx.s, span)^)!
        }
    }
    agg := tir.mk(ty, .Aggregate(values.items), span)
    if stmts.items.len is 0 { return agg }
    return tir.mk(ty, .Block(new(tir.Block(stmts: stmts.items, tail: agg, span: span))!), span)
}

/// A value for a tuple element, with its name if it is given by name, and where.
TuplePart :: struct {
    name: ?string
    value: ^Expr
    at: source.Span
}

/// The index of `name` in `names`.
index_of_name :: fn(names: []const string, name: string) -> ?usize {
    for i, n in enumerate(names) {
        if n is name { return i }
    }
    return null
}

/// A constructor field or argument value: `---` for plain data, else coerced.
field_value :: fn(cx: ^FnCx, e: ^const ast.Expr, ty: Ty) -> ^Expr needs Load {
    if e.kind is .Uninit {
        if not cx.is_plain_data(ty) { cx.error(e.span, uninit_message(cx.s, ty)) }
        return tir.mk(ty, .Uninit, e.span)
    }
    v := cx.expr(e, ty)
    return cx.coerce(v, ty)
}

/// `S(field: value, …)`.
construct_struct :: fn(cx: ^FnCx, ty: Ty, args: []const ast.Arg, span: source.Span) -> ^Expr needs Load {
    .Adt(id, _) := cx.s.tys.kind(ty) else return error_expr(cx.s, span)
    if h := cx.hidden_field(ty) {
        cx.error(span, str.format("`{}` cannot be constructed outside its {}: its field `{}` is private (§3.3)", cx.show(ty), h.owner, h.name)!)
        return error_expr(cx.s, span)
    }
    // The defaults of a struct's fields are evaluated while the struct is declared (§17.2),
    // so a default that reaches a construction of the struct needs the struct complete.
    if id in cx.s.adts_in_progress.items {
        cx.error(span, str.format("dependency cycle: `{}` is constructed while the default of one of its fields is evaluated (§3.4)", cx.show(ty))!)
        return error_expr(cx.s, span)
    }
    fields := cx.s.struct_fields(ty) else empty_slice(sema.FieldDef)
    n := fields.len
    stmts := list(tir.Stmt)
    slots := list(?^Expr)
    explicit := list(bool)
    for _ in 0..n {
        slots.push(null)!
        explicit.push(false)!
    }
    written := list(usize)
    bad_args := false
    for arg in args {
        match arg.kind {
            .Positional(e) => {
                if not bad_args {
                    cx.error(e.span, str.format("`{}` is constructed with named arguments only: `{}(field: value)`", cx.show(ty), cx.show(ty))!)
                }
                bad_args = true
            }
            .Named(fname, e) => {
                found: ?usize = null
                for i, f in enumerate(fields) {
                    if f.name is fname.name {
                        found = i
                        break
                    }
                }
                i := found else {
                    cx.error(fname.span, str.format("`{}` has no field `{}`", cx.show(ty), fname.name)!)
                    _ = cx.expr(&e, null)
                    continue
                }
                if explicit.items[i] { cx.error(fname.span, str.format("field `{}` is given twice", fname.name)!) }
                explicit.items[i] = true
                v := cx.field_value(&e, fields[i].ty)
                written.push(i)!
                slots.items[i] = v
            }
            .Spread(e) => {
                v := cx.expr(&e, null)
                vt := cx.infer.resolve(cx.s, v.ty)
                src := cx.spread_source_fields(vt, &e) else continue
                // Values written before the spread are evaluated before it.
                for w in written.items {
                    if x := slots.items[w] { slots.items[w] = cx.bind_temp(x, &stmts) }
                }
                written.clear()
                base := cx.bind_temp(v, &stmts)
                for k, sf in enumerate(src) {
                    found: ?usize = null
                    for i, f in enumerate(fields) {
                        if f.name is sf.name {
                            found = i
                            break
                        }
                    }
                    i := found else {
                        cx.error(e.span, str.format("`{}` has no field `{}` (supplied by this spread)", cx.show(ty), sf.name)!)
                        continue
                    }
                    if explicit.items[i] {
                        // A later explicit named argument overrides; an earlier one is a
                        // conflict.
                        cx.error(e.span, str.format("field `{}` is supplied twice", sf.name)!)
                        continue
                    }
                    if slots.items[i] is not null { cx.error(e.span, str.format("field `{}` is supplied by two spreads", sf.name)!) }
                    proj := tir.mk(sf.ty, .Field(base, k.trunc(u32)), e.span)
                    slots.items[i] = cx.coerce(proj, fields[i].ty)
                }
            }
        }
    }
    // Arguments written out of field order are evaluated into temporaries first, so
    // evaluation follows the written order (§7.1).
    out_of_order := false
    for k in 1..written.items.len.max(1) {
        if written.items[k - 1] > written.items[k] { out_of_order = true }
    }
    if out_of_order {
        for w in written.items {
            if v := slots.items[w] { slots.items[w] = cx.bind_temp(v, &stmts) }
        }
    }
    values := list(Expr)
    for i in 0..n {
        if v := slots.items[i] {
            values.push(v^)!
            continue
        }
        if fields[i].name is "_" and cx.s.bits_struct_ty(ty) is not null { return cx.unsupported(span, "`#bits` structs") }
        if d := cx.field_default(id, i, fields[i].ty, span) {
            values.push(d^)!
        } else {
            if not bad_args { cx.error(span, str.format("missing field `{}` (it has no default)", fields[i].name)!) }
            values.push(error_expr(cx.s, span)^)!
        }
    }
    agg := tir.mk(ty, .Aggregate(values.items), span)
    if stmts.items.len is 0 { return agg }
    return tir.mk(ty, .Block(new(tir.Block(stmts: stmts.items, tail: agg, span: span))!), span)
}

/// The default of field `i` of struct `id` of type `ty`, as the reference implementation
/// gives it: the literal itself for a numeric, `bool` or `null` literal of the field's
/// type, else the default's value in static memory.
field_default :: fn(cx: ^FnCx, id: u32, i: usize, ty: Ty, span: source.Span) -> ?^Expr needs Load {
    defaults := cx.s.adts.items[usize(id)].defaults
    if i >= defaults.len or not defaults[i] { return null }
    d := cx.s.field_default_expr(id, i) else return null
    return cx.default_value(cx.s.adts.items[usize(id)].module, d, ty)
}

/// The value of the default `d` (written in `module`) of type `ty`.
default_value :: fn(cx: ^FnCx, module: usize, d: ^const ast.Expr, ty: Ty) -> ^Expr needs Load {
    tys := &cx.s.tys
    e := d
    while .Paren(inner) := e.kind { e = inner }
    negative := false
    if .Unary(.Neg, x) := e.kind and x.kind in (.Int(_), .Float(_)) {
        negative = true
        e = x
    }
    numeric := tys.is_integer(ty) or tys.kind(ty) is .Float(_)
    match e.kind {
        .Int(lit) => if numeric and lit.suffix is null {
            v := bigint.from_nat(&lit.value)
            if negative { v = v.neg() }
            if tys.is_integer(ty) { return tir.mk(ty, .Int(v), d.span) }
            return cx.float_value(ratio.from_int(v), ty, d.span)
        }
        .Float(lit) => if tys.kind(ty) is .Float(_) and lit.suffix is null and not lit.imag {
            r := sema.literal_rational(&lit.value)
            if negative {
                if r.is_zero() {
                    if not default_const(cx.s, module, d, ty) { return error_expr(cx.s, d.span) }
                    return tir.mk(ty, .Const("<default>", d.span), d.span)
                }
                r = r.neg()
            }
            return cx.float_value(r, ty, d.span)
        }
        .Bool(b) => if tys.kind(ty) is .Bool { return tir.mk(ty, .Bool(b), d.span) }
        .Null => if tys.kind(ty) is .Optional(_) { return tir.mk(ty, .Null, d.span) }
        _ => {}
    }
    if not default_const(cx.s, module, d, ty) { return error_expr(cx.s, d.span) }
    return tir.mk(ty, .Const("<default>", d.span), d.span)
}

/// The float `r` rounded to float type `ty`.
float_value :: fn(cx: ^FnCx, r: ratio.Rat, ty: Ty, span: source.Span) -> ^Expr needs Alloc {
    .Float(bits) := cx.s.tys.kind(ty) else return error_expr(cx.s, span)
    x: f64 = if bits is 32 { f64(r.to_f32()) } else { r.to_f64() }
    return tir.mk(ty, .Float(x), span)
}

/// Binds `v` to a temporary (appending the `let` to `stmts`) unless it is a constant, and
/// returns an expression reading it.
bind_temp :: fn(cx: ^FnCx, v: ^Expr, stmts: ^List(tir.Stmt)) -> ^Expr needs Load {
    if v.kind in (.Int(_), .Float(_), .UntypedFloat(_), .Bool(_), .Str(_), .Null, .Uninit, .Const(_)) { return v }
    // A temporary the value points to (`&mk()` for a `^const T` parameter) must live for
    // the whole call, not just for the statement that binds the value.
    cx.lift_temps(v, stmts)
    t := cx.temp(v.ty, v.span)
    stmts.push(.Let(t, v))!
    return tir.mk(v.ty, .Local(t), v.span)
}
