// `with` and handler literals (§12.5, §12.7): each clause is checked as a nested
// function of the enclosing one (mirrors `src/sema/effects.rs`), and `resume` and
// `cancel` in `ctl` clauses (§14). Handlers of generic effects are reported as
// unsupported.

/// `[label:] with h1, h2, … { body }` (§12.7). With `value`, the `with`'s value is used,
/// and `expect` is the type expected of it.
with_expr :: fn(cx: ^FnCx, w: ^const ast.WithExpr, value: bool, expect: ?Ty) -> ^Expr needs Load {
    span := w.span
    tys := &cx.s.tys
    if cx.in_generic_fn() { return cx.unsupported(span, "`with` in generic functions") }
    with_expect: ?Ty = if value { expect } else { null }
    cx.push_scope()
    if l := w.label { cx.declare(l.name, .Label, l.span) }
    handlers := list(tir.HandlerValue)
    handled := list(EffectRef)
    literal_ids := list(u32)
    // A handler with errors (already reported) may have handled anything the body does.
    bad_handler := false
    decl_ids := list(u32)
    for h in w.handlers {
        // `with a, b` is `with a { with b { … } }`: earlier handlers handle what later
        // ones' clauses perform (§12.7).
        earlier := handled.items.len
        v := if lit := handler_lit(&h) { cx.handler_literal(lit, with_expect, h.span) } else { cx.expr(&h, null) }
        // The handler declaration is chosen by the value's type now, so an untyped
        // literal's type is settled here (`x := 0; with &x`).
        t := cx.settle(v.ty, h.span)
        match tys.kind(t) {
            .Handler(id) => {
                if cx.pending_handlers.items.len > 0 { cx.check_pending_handler(id, with_expect) }
                eref := cx.s.handlers.items[usize(id)].effect_
                for x in handled.items {
                    if types.cmp_ref(&x, &eref) is 0 { cx.error(h.span, str.format("two handlers for `{}` in one `with`", tys.effect_name(eref.eff))!) }
                }
                handled.push(eref)!
                literal_ids.push(id)!
                handlers.push(.Literal(v))!
            }
            .Error => { bad_handler = true }
            _ => {
                decls := cx.handlers_for(t)
                if decls.len is 0 {
                    if cx.s.handler_templates and mentions_generic_adt(tys, t) {
                        pop_with_scope(cx)
                        return cx.unsupported(h.span, "handler declarations for generic types")
                    }
                    bad_handler = true
                    d := diag.error(h.span, str.format("expected a handler, but no handler is declared for `{}`", cx.show(t))!)
                    if tys.kind(t) is not .Ptr(_) and cx.handlers_for(tys.ptr(false, t)).len > 0 {
                        d.add_note(str.format("a handler is declared for `^{}`: install it from a variable with `with &x`", cx.show(t))!)
                    }
                    cx.s.emit(d)
                    continue
                }
                for id in decls {
                    info := cx.s.handler_decls.items[usize(id)]
                    eref := info.effect_
                    for x in handled.items {
                        if types.cmp_ref(&x, &eref) is 0 { cx.error(h.span, str.format("two handlers for `{}` in one `with`", tys.effect_name(eref.eff))!) }
                    }
                    handled.push(eref)!
                    // The clauses' effects are performed at the `with`, outside it (§12.6).
                    effs := list(EffectRef)
                    for e in info.effects.effects {
                        seen := false
                        for x in handled.items[..earlier] {
                            if types.cmp_ref(&x, &e) is 0 { seen = true }
                        }
                        if not seen { effs.push(e)! }
                    }
                    set := types.effect_set(effs.items)
                    cx.record_effects(&set, h.span)
                    decl_ids.push(id)!
                }
                handlers.push(.Decl(decls: decls, value: v))!
            }
        }
    }
    // A `ctl` operation needs a stack to suspend: `on` is required exactly then (§14.1).
    has_ctl := false
    for e in handled.items {
        for o in cx.s.effects.items[usize(e.eff)].ops {
            if o.kind is .Ctl { has_ctl = true }
        }
    }
    on: ?^Expr = null
    if st := w.on {
        if not has_ctl { cx.error(st.span, "`on` gives a stack to fibers, but none of these handlers handles a `ctl` operation") }
        stack_ty := tys.slice(false, tys.int(false, 8))
        v := cx.expr(st, stack_ty)
        on = cx.coerce(v, stack_ty)
    } else if has_ctl {
        cx.error(span, "this `with` handles `ctl` operations, so it needs a stack: `with h on stack { … }` (§14.1)")
    }
    label_name: ?string = null
    if l := w.label { label_name = l.name }
    label := cx.new_label(label_name, false, .With(with_expect))
    start := cx.performed.items.len
    n := cx.handled.items.len
    cx.handled.extend(handled.items)!
    body := cx.block_expected(&w.body, value, expect)
    cx.handled.truncate(n)
    _ = cx.labels.pop()
    cx.pop_scope()
    // Effects handled here are not performed by the `with` (§12.3).
    i := start
    while i < cx.performed.items.len {
        p := cx.performed.items[i]
        handles := bad_handler
        for x in handled.items {
            if types.cmp_ref(&x, &p.effect_) is 0 { handles = true }
        }
        // Not those of a handler literal written before this `with` began (§12.5).
        for sh in cx.shielded_performs.items {
            if sh.at is p.span and n >= sh.handled { handles = false }
        }
        if handles {
            _ = cx.performed.remove(i)
        } else {
            i += 1
        }
    }
    // Values of clause-level `break`s and of `break`s to the `with`'s label must agree
    // with the body's value (§8.5, §12.7).
    breaks := list(HandlerBreak)
    for id in literal_ids.items {
        k: usize = 0
        while k < cx.handler_breaks.items.len {
            b := cx.handler_breaks.items[k]
            if b.handler_ is id {
                breaks.push(b)!
                _ = cx.handler_breaks.remove(k)
            } else {
                k += 1
            }
        }
    }
    depth := cx.depth()
    k: usize = 0
    while k < cx.label_breaks.items.len {
        b := cx.label_breaks.items[k]
        if b.label is label and b.depth is depth {
            breaks.push(HandlerBreak(handler_: 0, ty: b.ty, span: b.span))!
            _ = cx.label_breaks.remove(k)
        } else {
            k += 1
        }
    }
    ty := if value { expect else body.ty } else { tys.unit() }
    // A body that never finishes leaves the value to the `break`s.
    if tys.kind(ty) is .Never {
        for b in breaks.items {
            if tys.kind(b.ty) is not .Never {
                ty = b.ty
                break
            }
        }
    }
    if value and tys.kind(body.ty) is not .Never { body = cx.coerce(body, ty) }
    for b in breaks.items {
        bt := cx.infer.resolve(cx.s, b.ty)
        agrees := bt is ty
        if not agrees and (tys.has_infer(bt) or tys.has_infer(ty)) { agrees = cx.infer.unify(tys, bt, ty) is not !_ }
        if tys.kind(bt) is not .Never and not tys.is_error(bt) and not tys.is_error(ty) and not agrees {
            cx.error(b.span, str.format("this `break` gives the `with` a `{}`, but its value is `{}`", cx.show(bt), cx.show(ty))!)
        }
    }
    // A `break` to the `with` can complete it even when its body never does: one in a
    // clause of a handler literal or aimed at its label, or possibly one in a clause of a
    // handler declaration for an `esc` operation.
    decl_exits := false
    for id in decl_ids.items {
        e := cx.s.handler_decls.items[usize(id)].effect_
        for o in cx.s.effects.items[usize(e.eff)].ops {
            if o.kind is not .Fn { decl_exits = true }
        }
    }
    // Clauses of handler declarations are checked after function bodies, so their
    // `break`s are checked against this `with` later.
    with_ty := cx.infer.resolve(cx.s, ty)
    if decl_ids.items.len > 0 and not tys.has_infer(with_ty) and not tys.is_error(with_ty) {
        cx.s.decl_with_checks.push(sema.DeclWithCheck(decls: decl_ids.items, ty: with_ty, span: span))!
    }
    if not value and tys.kind(body.ty) is .Never and breaks.items.len is 0 and not decl_exits { ty = tys.never_ty() }
    return tir.mk(ty, .With(tir.WithExpr(label: label, handlers: handlers.items, on: on, body: body)), span)
}

/// Leaves the scope of a `with` that was not checked.
pop_with_scope :: fn(cx: ^FnCx) { cx.pop_scope() }

/// Whether `t`, under pointers, is an instance of a generic type.
mentions_generic_adt :: fn(tys: ^const types.Types, t: Ty) -> bool => match tys.kind(t) {
    .Ptr(_, x) => mentions_generic_adt(tys, x)
    .Adt(_, args) => args.len > 0
    _ => false
}

/// The handler literal `e` is, under parentheses.
handler_lit :: fn(e: ^const ast.Expr) -> ?^const ast.HandlerLit => match e.kind {
    .Paren(inner) => handler_lit(inner)
    .Handler(lit) => lit
    _ => null
}

/// A handler literal (§12.5), installed by a `with` whose value is expected to have type
/// `with_expect`: a second-class handler value.
handler_literal :: fn(cx: ^FnCx, lit: ^const ast.HandlerLit, with_expect: ?Ty, span: source.Span) -> ^Expr needs Load {
    hid := cx.new_handler_literal(lit, span) else return error_expr(cx.s, span)
    cx.handler_clauses(hid, lit, with_expect, span)
    return tir.mk(cx.s.tys.intern(.Handler(hid)), .HandlerRef(hid), span)
}

/// Starts a handler literal: resolves its effect and reserves its handler, whose clauses
/// `handler_clauses` checks.
new_handler_literal :: fn(cx: ^FnCx, lit: ^const ast.HandlerLit, span: source.Span) -> ?u32 needs Load {
    eref := cx.s.resolve_effect_ref(cx.module, lit.effect_) else return null
    info := cx.s.effects.items[usize(eref.eff)]
    if eref.args.len is not info.params.len {
        cx.error(lit.effect_.span, str.format("`{}` needs {} type argument(s)", info.name, info.params.len)!)
        return null
    }
    if info.params.len > 0 {
        _ = cx.unsupported(span, "handlers of generic effects")
        return null
    }
    hid := cx.s.handlers.items.len.trunc(u32)
    cx.s.handlers.push(tir.HandlerLit(effect_: eref, clauses: empty_slice(u32)))!
    for c in lit.clauses {
        known := false
        for o in info.ops {
            if o.name is c.name.name { known = true }
        }
        if not known { cx.error(c.name.span, str.format("`{}` has no operation `{}`", info.name, c.name.name)!) }
        n := 0
        for d in lit.clauses {
            if d.name.name is c.name.name { n += 1 }
        }
        if n > 1 { cx.error(c.name.span, str.format("operation `{}` is handled twice", c.name.name)!) }
    }
    return hid
}

/// Checks the clauses of handler literal `hid`; `with_expect` is the type of the value
/// of the `with` that installs it, which its `break`s give.
handler_clauses :: fn(cx: ^FnCx, hid: u32, lit: ^const ast.HandlerLit, with_expect: ?Ty, span: source.Span) needs Load {
    info := cx.s.effects.items[usize(cx.s.handlers.items[usize(hid)].effect_.eff)]
    clauses := list(u32)
    for o in info.ops {
        c := find_clause(lit, o.name) else {
            cx.error(span, str.format("this handler has no clause for the operation `{}`", o.name)!)
            continue
        }
        sig := clause_signature(cx.s, &o)
        info_ := ClauseInfo(op_kind: o.kind, handler_: hid, decl_clause: null, with_expect: with_expect)
        clauses.push(cx.clause_fn(c, sig.params, sig.ret, info_))!
    }
    cx.s.handlers.items[usize(hid)].clauses = clauses.items
}

/// Binds `name :: handler E { … }`: the clauses are checked later (`check_pending_handler`).
pending_handler_literal :: fn(cx: ^FnCx, lit: ^const ast.HandlerLit, span: source.Span) -> ^Expr needs Load {
    hid := cx.new_handler_literal(lit, span) else return error_expr(cx.s, span)
    lens := list(usize)
    for sc in cx.scopes.items { lens.push(sc.items.len)! }
    cx.pending_handlers.push(PendingHandler(hid: hid, lit: lit, span: span, depth: cx.outer.items.len, scope_lens: lens.items, labels: cx.labels.items.len, handled: cx.handled.items.len))!
    return tir.mk(cx.s.tys.intern(.Handler(hid)), .HandlerRef(hid), span)
}

/// Checks the clauses of the pending handler literal `hid`, if it is one, as if at the
/// place where it was written, with `with_expect` as the type its `break`s give.
check_pending_handler :: fn(cx: ^FnCx, hid: u32, with_expect: ?Ty) needs Load {
    found: ?usize = null
    for i, x in enumerate(cx.pending_handlers.items) {
        if x.hid is hid {
            found = i
            break
        }
    }
    i := found else return
    p := cx.pending_handlers.remove(i)
    // Return to the frame, scopes, labels and handlers of the literal's position.
    frames := list(Frame)
    while cx.outer.items.len > p.depth {
        f := cx.outer.pop() else break
        frames.push(cx.swap_frame(f))!
    }
    nscopes := p.scope_lens.len
    hidden_scopes := list(List(Binding))
    hidden_scopes.extend(cx.scopes.items[nscopes..])!
    cx.scopes.truncate(nscopes)
    hidden_depths := list(u32)
    hidden_depths.extend(cx.scope_depths.items[nscopes..])!
    cx.scope_depths.truncate(nscopes)
    hidden_tails := list([]Binding)
    for k in 0..nscopes {
        sc := &cx.scopes.items[k]
        len := p.scope_lens[k].min(sc.items.len)
        tail := list(Binding)
        tail.extend(sc.items[len..])!
        hidden_tails.push(tail.items)!
        sc.truncate(len)
    }
    hidden_labels := list(LabelInfo)
    nl := p.labels.min(cx.labels.items.len)
    hidden_labels.extend(cx.labels.items[nl..])!
    cx.labels.truncate(nl)
    hidden_handled := list(EffectRef)
    nh := p.handled.min(cx.handled.items.len)
    hidden_handled.extend(cx.handled.items[nh..])!
    cx.handled.truncate(nh)
    performed := cx.performed.items.len
    cx.handler_clauses(hid, p.lit, with_expect, p.span)
    for x in cx.performed.items[performed..] { cx.shield(x.span, p.handled) }
    cx.handled.extend(hidden_handled.items)!
    cx.labels.extend(hidden_labels.items)!
    for k in 0..nscopes { cx.scopes.items[k].extend(hidden_tails.items[k])! }
    cx.scopes.extend(hidden_scopes.items)!
    cx.scope_depths.extend(hidden_depths.items)!
    while f := frames.pop() {
        outer := cx.swap_frame(f)
        cx.outer.push(outer)!
    }
}

/// Records that the perform at `at` is shielded from `with`s that began after `handled`
/// handlers were in scope.
shield :: fn(cx: ^FnCx, at: source.Span, handled: usize) needs Alloc {
    for i in 0..cx.shielded_performs.items.len {
        if cx.shielded_performs.items[i].at is at {
            cx.shielded_performs.items[i].handled = handled
            return
        }
    }
    cx.shielded_performs.push(Shielded(at: at, handled: handled))!
}

/// Checks the pending handler literals written in the scope that is ending.
check_pending_handlers_of_scope :: fn(cx: ^FnCx) needs Load {
    depth := cx.outer.items.len
    scopes := cx.scopes.items.len
    while true {
        hid: ?u32 = null
        for p in cx.pending_handlers.items {
            if p.depth is depth and p.scope_lens.len >= scopes {
                hid = p.hid
                break
            }
        }
        h := hid else return
        cx.check_pending_handler(h, null)
    }
}

find_clause :: fn(lit: ^const ast.HandlerLit, name: string) -> ?^const ast.Clause {
    for i in 0..lit.clauses.len {
        if lit.clauses[i].name.name is name { return &lit.clauses[i] }
    }
    return null
}

/// Checks one clause as a nested function of the current one; what it performs counts
/// where the handler is written (§12.5).
clause_fn :: fn(cx: ^FnCx, c: ^const ast.Clause, params: []sema.ParamInfo, ret: Ty, info: ClauseInfo) -> u32 needs Load {
    if c.params.len is not params.len {
        cx.error(c.span, str.format("the clause for `{}` takes {} parameter(s)", c.name.name, params.len)!)
    }
    fn_id := cx.s.new_nested_fn(.Clause, c.name.name, c.span, cx.module, params, ret, types.empty_effects())
    cx.enter_fn(fn_id, ret, types.empty_effects())
    cx.clause = info
    ids := list(u32)
    for i, p in enumerate(params) {
        name := if i < c.params.len { c.params[i].name } else { p.name }
        at := if i < c.params.len { c.params[i].span } else { c.span }
        id := cx.new_local(name, p.ty, false, at)
        if name is not "_" { cx.declare(name, .Var(id), at) }
        ids.push(id)!
    }
    // A `ctl` clause must not finish normally (§14.3): its body is checked without an
    // expected type, so that a branch that finishes gives it a type other than `never`.
    expect: ?Ty = if info.op_kind is .Ctl { null } else { ret }
    body := match c.body.kind {
        .Block(b) => cx.block_expected(&b, true, expect)
        _ => cx.expr(c.body, expect)
    }
    body = cx.clause_body(body, info.op_kind, ret)
    frame := cx.exit_fn()
    cx.performed.extend(frame.performed)!
    cx.s.defs.items[usize(fn_id)].parent = cx.fn_id
    cx.nested.push(NestedFn(fn_id: fn_id, params: ids.items, locals: frame.locals, body: body))!
    return fn_id
}

/// The parameters and result type of a clause for operation `o` of an effect without
/// type parameters: a `ctl` clause also takes the continuation `k` and never finishes
/// normally (§14.3).
pub clause_signature :: fn(s: ^Sema, o: ^const sema.OpInfo) -> (params: []sema.ParamInfo, ret: Ty) needs Alloc {
    params := list(sema.ParamInfo)
    for p in o.params { params.push(sema.ParamInfo(name: p.name, ty: p.ty, span: p.span, default: null, generic: null, rest: false))! }
    if o.kind is not .Ctl { return (params: params.items, ret: o.ret) }
    span := if p := params.items.last() { p.span } else { source.DUMMY }
    params.push(sema.ParamInfo(name: "k", ty: s.tys.intern(.Cont(o.ret)), span: span, default: null, generic: null, rest: false))!
    return (params: params.items, ret: s.tys.never_ty())
}

/// Checks a clause body against the clause's result type. A `ctl` clause never
/// finishes normally (§14.3).
clause_body :: fn(cx: ^FnCx, body: ^Expr, kind: ast.OpKind, ret: Ty) -> ^Expr needs Load {
    if cx.s.tys.kind(body.ty) is .Never { return body }
    if kind is .Ctl {
        if not cx.s.tys.is_error(body.ty) { cx.error(body.span, "a `ctl` clause must not finish normally: end every path with `resume`, an exit or a `never` call (§14.3)") }
        return body
    }
    return cx.coerce(body, ret)
}

/// Whether the current frame is the body of a `ctl` clause.
in_ctl_clause :: fn(cx: ^const FnCx) -> bool {
    c := cx.clause else return false
    return c.op_kind is .Ctl and c.for_label is null
}

/// Checks a continuation operand of `resume` or `cancel`; returns it and its `R`.
cont_operand :: fn(cx: ^FnCx, what: string, k: ^const ast.Expr) -> ?(cont: ^Expr, r: Ty) needs Load {
    if not cx.in_ctl_clause() {
        cx.error(k.span, str.format("`{}` is permitted only in the body of a `ctl` clause (§14)", what)!)
    } else if cx.in_defer {
        cx.error(k.span, str.format("`{}` cannot appear in a deferred statement", what)!)
    }
    v := cx.expr(k, null)
    t := cx.infer.resolve(cx.s, v.ty)
    match cx.s.tys.kind(t) {
        .Cont(r) => return (cont: v, r: r)
        .Error => return null
        _ => {
            cx.error(k.span, str.format("expected a continuation `cont(R)`, found `{}`", cx.show(t))!)
            return null
        }
    }
}

/// `resume k(v)` (§14.3).
resume_expr :: fn(cx: ^FnCx, k: ^const ast.Expr, value: ?^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    c := cx.cont_operand("resume", k) else {
        if v := value { _ = cx.expr(v, null) }
        return error_expr(cx.s, span)
    }
    tys := &cx.s.tys
    v: ^Expr = unit(cx.s, span)
    if x := value {
        e := cx.expr(x, c.r)
        v = cx.coerce(e, c.r)
    } else if not tys.is_unit(c.r) and not tys.is_error(c.r) {
        cx.error(span, str.format("this continuation needs a value of type `{}`: `resume k(value)`", cx.show(c.r))!)
    }
    return tir.mk(tys.never_ty(), .Resume(c.cont, v), span)
}

/// `cancel k` (§14.5).
cancel_stmt :: fn(cx: ^FnCx, k: ^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    c := cx.cont_operand("cancel", k) else return error_expr(cx.s, span)
    return tir.mk(cx.s.tys.unit(), .Cancel(c.cont), span)
}
