// Sequences: membership `in` (§7.7) and `for` loops over ranges (§13.2).

/// `elem in container`, with `elem` already checked.
in_expr :: fn(cx: ^FnCx, checked: ^Expr, container: ^const ast.Expr, negated: bool, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    elem := checked
    // Ranges: `lo <= x and x < hi` with `x` evaluated once.
    if .Binary(op, lhs, rhs) := container.kind and op in (ast.BinOp.Range, ast.BinOp.RangeIncl) {
        lo := cx.expr(lhs, elem.ty)
        hi := cx.expr(rhs, elem.ty)
        ty := cx.unify_operands(elem.ty, lo.ty, span, "the operands of `in`")
        _ = cx.unify_operands(ty, hi.ty, span, "the operands of `in`")
        cx.obligations.push(.Ord(ty, span))!
        return cx.range_test(elem, empty_slice(tir.Stmt), lo, hi, ty, op is .RangeIncl, negated, span)
    }
    // An inline tuple with a pattern member: `k in (.Fn(_), .Type)` (§7.7).
    if .Tuple(elems) := container.kind {
        for i in 0..elems.len {
            if cx.is_pattern_operand(&elems[i].value, elem.ty) is not null { return cx.in_patterns(elem, elems, negated, span) }
        }
    }
    c := if .Tuple(elems) := container.kind {
        // An inline tuple: the element and the members are joined as the branches of an
        // `if` are (§7.12), so `p in ("a", "b")` with `p: []u8` compares `string`s. As with
        // `is`, a member converts to an optional or result element: `c in ('a', 'b')` with
        // `c: ?u8`.
        vals := list(^Expr)
        defer vals.deinit()
        et := cx.infer.resolve(cx.s, elem.ty)
        wraps := tys.kind(et) in (.Optional(_), .Result(_)) and not tys.has_infer(et)
        for i in 0..elems.len {
            v := cx.expr(&elems[i].value, elem.ty)
            vt := cx.infer.resolve(cx.s, v.ty)
            if wraps and vt is not et and (tys.kind(vt) is .Infer(_) or cx.coercion_steps(vt, et) is not null) {
                v = cx.coerce(v, et)
            }
            vals.push(v)!
        }
        joined := cx.join_members(elem, vals.items)
        if joined is not elem.ty { elem = cx.coerce(elem, joined) }
        members := list(Expr)
        etys := list(Ty)
        jr := cx.infer.resolve(cx.s, joined)
        for v in vals.items {
            m := v
            mt := cx.infer.resolve(cx.s, m.ty)
            if mt is not jr and not tys.has_infer(mt) and cx.coercion_steps(mt, jr) is not null { m = cx.coerce(m, jr) }
            _ = cx.unify_operands(elem.ty, m.ty, m.span, "the element and the tuple members of `in`")
            members.push(m^)!
            etys.push(m.ty)!
        }
        tir.mk(tys.tuple(etys.items), .Aggregate(members.items), container.span)
    } else {
        cx.expr(container, null)
    }
    ct := cx.infer.resolve(cx.s, c.ty)
    // A range value: `r.lo <= x and x < r.hi`.
    if r := cx.s.range_of(ct) {
        _ = cx.unify_operands(elem.ty, r.elem, span, "the element and the range of `in`")
        t := cx.temp(ct, span)
        lets := list(tir.Stmt)
        lets.push(.Let(t, c))!
        lo := tir.mk(r.elem, .Field(tir.mk(ct, .Local(t), span), 0), span)
        hi := tir.mk(r.elem, .Field(tir.mk(ct, .Local(t), span), 1), span)
        return cx.range_test(elem, lets.items, lo, hi, r.elem, r.inclusive, negated, span)
    }
    item: Ty = elem.ty
    match tys.kind(ct) {
        .Array(_, e, _) => { item = e }
        .ParamArray(_, e) => { item = e }
        .Slice(_, e) => { item = e }
        .Tuple(es, _) => if es.len > 0 { item = es[0] }
        .Error => return error_expr(cx.s, span)
        _ => {
            cx.error(container.span, str.format("`in` needs a range, array, slice or tuple, not `{}`", cx.show(ct))!)
            return error_expr(cx.s, span)
        }
    }
    // The element converts to the members' type: `p in names` with `p: []u8` and
    // `names: []string` (§7.7).
    rt := cx.infer.resolve(cx.s, elem.ty)
    ri := cx.infer.resolve(cx.s, item)
    if rt is not ri and not tys.has_infer(rt) and not tys.has_infer(ri) and cx.coercion_steps(rt, ri) is not null {
        elem = cx.coerce(elem, ri)
    }
    _ = cx.unify_operands(elem.ty, item, span, "the element and the members of `in`")
    // The members are compared with `is` (§7.7).
    et := cx.infer.resolve(cx.s, item)
    if not tys.has_infer(et) and not tys.is_error(et) and not cx.eq_allowed(et) {
        cx.error(span, str.format("`in` compares with `is`, which is not defined for `{}` (§7.6)", cx.show(et))!)
    }
    return tir.mk(tys.bool_ty(), .In(elem, c, negated), span)
}

/// The type that the element of `in` and the members of an inline tuple are compared at:
/// the first of their types to which all the others coerce (§7.7, §7.12), or the
/// element's type when there is none or a type is not inferred yet.
join_members :: fn(cx: ^FnCx, elem: ^Expr, members: []const ^Expr) -> Ty needs Load {
    tys := &cx.s.tys
    all := list(Ty)
    defer all.deinit()
    all.push(elem.ty)!
    for m in members {
        t := cx.infer.resolve(cx.s, m.ty)
        if tys.has_infer(t) or tys.is_error(t) { return elem.ty }
        all.push(t)!
    }
    if tys.has_infer(cx.infer.resolve(cx.s, elem.ty)) { return elem.ty }
    joined := cx.join_type(all.items)
    // Only a type that every member and the element reach by coercion.
    jr := cx.infer.resolve(cx.s, joined)
    for t in all.items {
        r := cx.infer.resolve(cx.s, t)
        if r is not jr and cx.coercion_steps(r, jr) is null { return elem.ty }
    }
    return joined
}

/// The type at which a tuple whose elements have different types is iterated: their
/// join (§7.12), when every element coerces to it; `null` when the elements have one
/// type, are not inferred yet, or have no join.
tuple_elem_join :: fn(cx: ^FnCx, elems: []const Ty) -> ?Ty needs Load {
    tys := &cx.s.tys
    first := cx.infer.resolve(cx.s, elems[0])
    differ := false
    for e in elems {
        r := cx.infer.resolve(cx.s, e)
        if tys.has_infer(r) or tys.is_error(r) { return null }
        if r is not first { differ = true }
    }
    if not differ { return null }
    joined := cx.infer.resolve(cx.s, cx.join_type(elems))
    for e in elems {
        r := cx.infer.resolve(cx.s, e)
        if r is not joined and cx.coercion_steps(r, joined) is null and not (tys.is_positional_array(r) and tys.kind(joined) is .Slice(_)) { return null }
    }
    return joined
}

/// `{ x := elem; lets…; lo <= x and x <(=) hi }`, negated if `negated`.
range_test :: fn(cx: ^FnCx, elem: ^Expr, lets: []const tir.Stmt, lo, hi: ^Expr, ty: Ty, inclusive: bool, negated: bool, span: source.Span) -> ^Expr needs Load {
    b := cx.s.tys.bool_ty()
    tmp := cx.temp(ty, span)
    x :: fn() -> ^Expr needs Alloc => tir.mk(ty, .Local(tmp), span)
    upper: tir.BinOp = if inclusive { .Le } else { .Lt }
    test := tir.mk(b, .Logic(true, tir.mk(b, .Binary(.Le, lo, x()), span), tir.mk(b, .Binary(upper, x(), hi), span)), span)
    if negated { test = tir.mk(b, .Unary(.Not, test), span) }
    stmts := list(tir.Stmt)
    stmts.push(.Let(tmp, elem))!
    stmts.extend(lets)!
    return tir.mk(b, .Block(new(tir.Block(stmts: stmts.items, tail: test, span: span))!), span)
}

/// A `for` loop (§13.2).
for_loop :: fn(cx: ^FnCx, f: ^const ast.ForExpr) -> ^Expr needs Load {
    span := f.span
    is_range := false
    if .Binary(op, _, _) := f.iter.kind { is_range = op in (ast.BinOp.Range, ast.BinOp.RangeIncl) }
    if not is_range {
        if f.iter.kind is .Call(_) { return cx.for_iterator(f) }
        src := cx.expr(f.iter, null)
        if e := cx.for_each_value(f, src) { return e }
        cx.error(f.iter.span, "`for` iterates over a range, an array, slice or tuple, or a call to an iterator")
        return error_expr(cx.s, span)
    }
    .Binary(op, lhs, rhs) := f.iter.kind else return error_expr(cx.s, span)
    lo := cx.expr(lhs, null)
    hi := cx.expr(rhs, null)
    elem := cx.unify_operands(lo.ty, hi.ty, f.iter.span, "range bounds")
    for t in [3]Ty(elem, lo.ty, hi.ty) {
        if c := cx.infer.set_fallback(&cx.s.tys, t, .Usize) {
            cx.s.emit(early_fallback_error(cx.s, f.iter.span, c.ty, c.at))
            break
        }
    }
    cx.obligations.push(.Numeric(NumericObligation(ty: elem, span: f.iter.span, op: "range", int_only: true, signed_only: false)))!
    return cx.range_loop(f, lo, hi, elem, op is .RangeIncl)
}

/// A `for` loop over the integers from `lo` to `hi` (of type `elem`), excluding `hi`
/// unless `inclusive`:
///
/// ```text
/// { i := lo; hi_t := hi; going := i <= hi_t;
///   loop going { p :: i; body } step { if i is hi_t { going = false } else { i += 1 } } }
/// ```
///
/// The half-open form uses `i < hi_t` as the condition and `i += 1` as the step.
range_loop :: fn(cx: ^FnCx, f: ^const ast.ForExpr, lo, hi: ^Expr, elem: Ty, inclusive: bool) -> ^Expr needs Load {
    span := f.span
    b := cx.s.tys.bool_ty()
    hi_t := cx.temp(elem, span)
    i := cx.temp(elem, span)
    local :: fn(id: u32, ty: Ty) -> ^Expr needs Alloc => tir.mk(ty, .Local(id), span)
    incr :: fn() -> tir.Stmt needs Alloc => .Assign(local(i, elem), tir.mk(elem, .Binary(.Add(.Wrap), local(i, elem), tir.mk(elem, .Int(bigint.one()), span)), span))
    stmts := list(tir.Stmt)
    stmts.push(.Let(i, lo))!
    stmts.push(.Let(hi_t, hi))!
    cond := list(tir.CondPart)
    step: ^Expr = local(i, elem)
    if inclusive {
        going := cx.temp(b, span)
        stmts.push(.Let(going, tir.mk(b, .Binary(.Le, local(i, elem), local(hi_t, elem)), span)))!
        at_end := tir.mk(b, .Eq(local(i, elem), local(hi_t, elem), false), span)
        stop := list(tir.Stmt)
        stop.push(.Assign(local(going, b), tir.mk(b, .Bool(false), span)))!
        more := list(tir.Stmt)
        more.push(incr())!
        parts := list(tir.CondPart)
        parts.push(.Bool(at_end))!
        step = tir.mk(cx.s.tys.unit(), .If(tir.IfExpr(cond: parts.items, then: block_of(cx.s, stop.items, span), else_: block_of(cx.s, more.items, span))), span)
        cond.push(.Bool(local(going, b)))!
    } else {
        cond.push(.Bool(tir.mk(b, .Binary(.Lt, local(i, elem), local(hi_t, elem)), span)))!
        more := list(tir.Stmt)
        more.push(incr())!
        step = block_of(cx.s, more.items, span)
    }
    lp := cx.loop_with_pattern(f, elem, local(i, elem), cond.items, step)
    stmts.push(.Expr(lp))!
    return block_of(cx.s, stmts.items, span)
}

/// The loop of a lowered `for`: binds the head patterns to `item` for each iteration.
loop_with_pattern :: fn(cx: ^FnCx, f: ^const ast.ForExpr, elem: Ty, item: ^Expr, cond: []tir.CondPart, step: ^Expr) -> ^Expr needs Load {
    span := f.span
    cx.push_scope()
    if l := f.label { cx.declare(l.name, .Label, l.span) }
    // `for a, b in …` is the tuple pattern `(a, b)` (§8.4).
    pat_ast := f.pats[0]
    if f.pats.len is not 1 {
        args := list(ast.PatArg)
        for p in f.pats { args.push(ast.PatArg(name: null, pat: p, span: p.span))! }
        sp := source.to(f.pats[0].span, f.pats[f.pats.len - 1].span)
        pat_ast = ast.Pattern(id: f.pats[0].id, kind: .Tuple(args.items), span: sp)
    }
    binds := list(PatBind)
    pat := cx.pattern(&pat_ast, elem, .Irrefutable, &binds)
    if not cx.s.tys.is_error(elem) and not irrefutable(cx.s, pat) {
        cx.error(pat_ast.span, "a `for` pattern must match every value (it must be irrefutable)")
    }
    cx.declare_binds(&binds)
    label_name: ?string = null
    if l := f.label { label_name = l.name }
    id := cx.new_label(label_name, true, .Loop(cx.s.tys.unit()))
    body := cx.block(&f.body, false)
    _ = cx.labels.pop()
    _ = cx.forget_label_breaks(id)
    cx.pop_scope()
    arms := list(tir.Arm)
    arms.push(tir.Arm(pat: pat, guard: null, body: body))!
    m := tir.mk(cx.s.tys.unit(), .Match(item, arms.items), span)
    stmts := list(tir.Stmt)
    stmts.push(.Expr(m))!
    lb := new(tir.Block(stmts: stmts.items, tail: null, span: span))!
    return tir.mk(cx.s.tys.unit(), .Loop(tir.LoopExpr(label: id, cond: cond, body: lb, step: step)), span)
}

// ---------------------------------------------------------------------------------
// Indexing and slicing (§7.9)
// ---------------------------------------------------------------------------------

/// `base[index]`.
index :: fn(cx: ^FnCx, base: ^const ast.Expr, i: ^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    b := cx.expr(base, null)
    return cx.index_value(b, i, span)
}

/// `b[index]` with the base already checked.
index_value :: fn(cx: ^FnCx, b0: ^Expr, index_ast: ^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    b1 := cx.soa_deref(b0)
    if info := cx.soa_of(b1) { return cx.soa_element(b1, info, index_ast, span) }
    b := cx.auto_deref_array(b1)
    if .Array(_, elem, kind) := tys.kind(cx.infer.resolve(cx.s, b.ty)) and .Enum(e) := kind { return cx.enum_array_index(b, e, elem, index_ast, span) }
    i := cx.expr(index_ast, null)
    // `a[r]` with a range value `r` is the slice `a[r.lo..r.hi]` (§5.16).
    it := cx.infer.resolve(cx.s, i.ty)
    if r := cx.s.range_of(it) {
        t := cx.temp(it, span)
        lo := tir.mk(r.elem, .Field(tir.mk(it, .Local(t), span), 0), span)
        hi := tir.mk(r.elem, .Field(tir.mk(it, .Local(t), span), 1), span)
        s := cx.slice_of(b, span, lo, hi, r.inclusive, span)
        stmts := list(tir.Stmt)
        stmts.push(.Let(t, i))!
        return tir.mk(s.ty, .Block(new(tir.Block(stmts: stmts.items, tail: s, span: span))!), span)
    }
    if not cx.infer.require_unsigned(tys, i.ty, .Usize) and not tys.is_error(i.ty) {
        cx.error(i.span, str.format("an index must have an unsigned integer type, not `{}`", cx.show(it))!)
    }
    bt := cx.infer.resolve(cx.s, b.ty)
    elem: Ty = bt
    checked := true
    match tys.kind(bt) {
        .Array(_, e, _), .ParamArray(_, e), .Slice(_, e) => { elem = e }
        .ManyPtr(_, e) => {
            elem = e
            checked = false
        }
        .Error => return error_expr(cx.s, span)
        _ => {
            cx.error(span, str.format("cannot index a value of type `{}`", cx.show(bt))!)
            return error_expr(cx.s, span)
        }
    }
    return tir.mk(elem, .Index(b, i, checked), span)
}

/// Indexing and slicing see through one pointer to an array.
auto_deref_array :: fn(cx: ^FnCx, b: ^Expr) -> ^Expr needs Alloc {
    if .Ptr(_, pointee) := cx.s.tys.kind(cx.infer.shallow(&cx.s.tys, b.ty)) and cx.s.tys.kind(pointee) in (.Array(_), .ParamArray(_)) {
        return tir.mk(pointee, .Deref(b), b.span)
    }
    return b
}

/// `a[lo..hi]` and its open-ended forms.
slice_expr :: fn(cx: ^FnCx, base: ^const ast.Expr, lo_ast: ?^ast.Expr, hi_ast: ?^ast.Expr, inclusive: bool, span: source.Span) -> ^Expr needs Load {
    cx.temp_ref_arg = false
    b := cx.expr(base, null)
    // A temporary array is held in a hidden local, so the slice is of that (§7.9).
    if cx.s.tys.kind(cx.infer.resolve(cx.s, b.ty)) in (.Array(_), .ParamArray(_)) and cx.place_mutability(b) is null and not cx.const_init {
        held_by := cx.hold_temp_array(b)
        lo: ?^Expr = null
        if x := lo_ast { lo = cx.expr(x, null) }
        hi: ?^Expr = null
        if x := hi_ast { hi = cx.expr(x, null) }
        return held(cx.s, held_by.hold, cx.slice_of(held_by.local, base.span, lo, hi, inclusive, base.span.to(span)))
    }
    if cx.const_init { b = cx.const_temp(b) }
    lo: ?^Expr = null
    if x := lo_ast { lo = cx.expr(x, null) }
    hi: ?^Expr = null
    if x := hi_ast { hi = cx.expr(x, null) }
    return cx.slice_of(b, base.span, lo, hi, inclusive, span)
}

/// `v` as a `[]const T` where one is expected: an array is passed as a slice of the whole
/// array, held in a hidden local if it is a temporary (§6.4, §15.1).
pub array_as_slice :: fn(cx: ^FnCx, v: ^Expr, target0: Ty) -> ^Expr needs Load {
    tys := &cx.s.tys
    target := cx.infer.resolve(cx.s, target0)
    vt := cx.infer.resolve(cx.s, v.ty)
    .Slice(c, _) := tys.kind(target) else return v
    if not c or not tys.is_positional_array(vt) { return v }
    span := v.span
    if cx.place_mutability(v) is not null { return cx.slice_of(v, span, null, null, false, span) }
    if cx.const_init { return cx.slice_of(cx.const_temp(v), span, null, null, false, span) }
    held_by := cx.hold_temp_array(v)
    return held(cx.s, held_by.hold, cx.slice_of(held_by.local, span, null, null, false, span))
}

/// A temporary array `v` in a constant's initializer, which lives as long as the
/// evaluation; a constant that keeps a pointer to it is rejected by the evaluator.
const_temp :: fn(cx: ^FnCx, v: ^Expr) -> ^Expr needs Load {
    if cx.place_mutability(v) is not null or cx.s.tys.kind(cx.infer.resolve(cx.s, v.ty)) not in (.Array(_), .ParamArray(_)) { return v }
    p := tir.mk(cx.s.tys.ptr(true, v.ty), .AddrOfTemp(v), v.span)
    return tir.mk(v.ty, .Deref(p), v.span)
}

/// The name of the hidden local that holds a temporary array used as a slice.
pub TEMP_ARRAY :: "<temporary array>"

/// Holds the temporary array `v` in a new hidden local of the enclosing block (§15.1):
/// the assignment that fills it, where `v` was, and the local.
hold_temp_array :: fn(cx: ^FnCx, v: ^Expr) -> (hold: tir.Stmt, local: ^Expr) needs Alloc {
    t := cx.new_local(TEMP_ARRAY, v.ty, false, v.span)
    cx.block_temps.push(t)!
    local := tir.mk(v.ty, .Local(t), v.span)
    return (hold: .Assign(local, v), local: local)
}

/// `{ hold; s }`: the slice `s` of a hidden local, after the assignment that fills it.
held :: fn(s: ^Sema, hold: tir.Stmt, sl: ^Expr) -> ^Expr needs Alloc {
    stmts := list(tir.Stmt)
    stmts.push(hold)!
    blk := new(tir.Block(stmts: stmts.items, tail: sl, span: sl.span))!
    return tir.mk(sl.ty, .Block(blk), sl.span)
}

/// Whether `e` is a slice of a temporary array held by `held`.
pub is_held_temp :: fn(e: ^const Expr) -> bool {
    .Block(b) := e.kind else return false
    if b.stmts.len is not 1 or b.stmts[0] is not .Assign(_) { return false }
    t := b.tail else return false
    return t.kind is .Slice(_)
}

/// Slices the checked `b` (written at `base_span`) with the checked bounds.
slice_of :: fn(cx: ^FnCx, b0: ^Expr, base_span: source.Span, lo: ?^Expr, hi: ?^Expr, inclusive: bool, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    b := b0
    if .Ptr(_, pointee) := tys.kind(cx.infer.resolve(cx.s, b.ty)) and tys.kind(pointee) in (.Array(_), .ParamArray(_)) {
        b = tir.mk(pointee, .Deref(b), span)
    }
    b = cx.soa_deref(b)
    if info := cx.soa_of(b) { return cx.soa_slice(b, info, lo, hi, inclusive, span) }
    bt := cx.infer.resolve(cx.s, b.ty)
    if .Array(_, _, kind) := tys.kind(bt) and kind is .Enum(_) and (lo is not null or hi is not null) {
        cx.error(span, str.format("`{}` is indexed by its enum, so it is sliced only whole: `a[..]`", cx.show(bt))!)
        return error_expr(cx.s, span)
    }
    elem: Ty = bt
    is_const := false
    match tys.kind(bt) {
        .Array(_, e, _), .ParamArray(_, e) => {
            m := cx.place_mutability(b) else {
                cx.error(base_span, "only an array variable (a place) can be sliced, not a temporary array")
                return error_expr(cx.s, span)
            }
            elem = e
            is_const = not m
        }
        .Slice(c, e) => {
            elem = e
            is_const = c
        }
        .ManyPtr(c, e) => {
            if lo is null or hi is null { cx.error(span, "slicing a many-pointer needs both bounds") }
            elem = e
            is_const = c
        }
        .Error => return error_expr(cx.s, span)
        _ => {
            cx.error(span, str.format("cannot slice a value of type `{}`", cx.show(bt))!)
            return error_expr(cx.s, span)
        }
    }
    for x in [2]?^Expr(lo, hi) {
        v := x else continue
        if not cx.infer.require_unsigned(tys, v.ty, .Usize) and not tys.is_error(v.ty) {
            cx.error(v.span, str.format("a slice bound must have an unsigned integer type, not `{}`", cx.show(cx.infer.resolve(cx.s, v.ty)))!)
        }
    }
    return tir.mk(tys.slice(is_const, elem), .Slice(tir.SliceExpr(base: b, lo: lo, hi: hi, inclusive: inclusive)), span)
}

// ---------------------------------------------------------------------------------
// Array construction (§7.11)
// ---------------------------------------------------------------------------------

/// `[N]T(…)`: an array type prefix applied to a construction `e` (§A.7 rule 12).
array_type_construction :: fn(cx: ^FnCx, e: ^const ast.Expr, len_ast: ?^ast.Expr, elem: ^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    call := sema.construction_call(elem) else return cx.unsupported(span, "array construction")
    .Call(_, args, _) := call.kind else return cx.unsupported(span, "array construction")
    // `[E][3]i32(…)`: the element type is everything after the outer prefix.
    if l := len_ast and cx.s.length_is_type(cx.module, l) {
        t := cx.resolve_ty(without_call(e))
        if .Array(_, et, kind) := cx.s.tys.kind(t) and .Enum(index) := kind { return cx.construct_enum_array(t, index, et, args, span) }
        return error_expr(cx.s, span)
    }
    elem_ty := cx.construction_elem_type(elem) else return error_expr(cx.s, span)
    len: ?u64 = null
    if l := len_ast {
        match cx.s.array_len(cx.module, l) {
            .Known(n) => { len = n }
            .Param(pl) => {
                t := cx.s.tys.intern(.ParamArray(pl, elem_ty))
                return cx.construct_param_array(t, elem_ty, args, span)
            }
            .Failed => return error_expr(cx.s, span)
        }
    }
    return cx.construct_array(null, len, elem_ty, args, span)
}

/// The type that a construction (with its prefixes) spells, without the call.
construction_elem_type :: fn(cx: ^FnCx, e: ^const ast.Expr) -> ?Ty needs Load {
    t := cx.resolve_ty(without_call(e))
    return if cx.s.tys.is_error(t) { null } else { t }
}

/// The type a construction `e` builds: `e` with its final call replaced by the callee.
without_call :: fn(e: ^const ast.Expr) -> ^const ast.Expr needs Alloc {
    kind: ast.ExprKind = match e.kind {
        .Call(callee, _, _) => return callee
        .ArrayType(a) => .ArrayType(ast.ArrayTypeExpr(len: a.len, elem: box_mut(without_call(a.elem))))
        .OptionalType(inner) => .OptionalType(box_mut(without_call(inner)))
        .PtrType(c, inner) => .PtrType(c, box_mut(without_call(inner)))
        .SliceType(c, inner) => .SliceType(c, box_mut(without_call(inner)))
        .ManyPtrType(c, inner) => .ManyPtrType(c, box_mut(without_call(inner)))
        _ => return e
    }
    return new(ast.Expr(id: e.id, kind: kind, span: e.span))!
}

/// A copy of `e` that the syntax tree may own.
box_mut :: fn(e: ^const ast.Expr) -> ^ast.Expr needs Alloc => new(e^)!

/// `[N]T(fill: x)` where `N` is a compile-time parameter: the only way to construct such
/// an array (§16.5).
construct_param_array :: fn(cx: ^FnCx, t: Ty, elem: Ty, args: []const ast.Arg, span: source.Span) -> ^Expr needs Load {
    if args.len is 1 and .Named(n, x) := args[0].kind and n.name is "fill" {
        v := cx.field_value(&x, elem)
        return tir.mk(t, .ArrayFill(v), span)
    }
    cx.error(span, str.format("`{}` has a length that is a compile-time parameter; construct it with `fill:`", cx.show(t))!)
    return error_expr(cx.s, span)
}

/// `[E]T(fill: x)` and `[E]T(A: a, B: b, …)`, naming every variant of the enum `E` once
/// (§5.6). Values are evaluated in the order written.
construct_enum_array :: fn(cx: ^FnCx, ty: Ty, index: Ty, elem: Ty, args: []const ast.Arg, span: source.Span) -> ^Expr needs Load {
    names := list(string)
    if uv := cx.s.union_variants(index) {
        for v in uv.variants { names.push(v.name)! }
    }
    if args.len is 1 and .Named(n, x) := args[0].kind and n.name is "fill" and n.name not in names.items {
        v := cx.field_value(&x, elem)
        return tir.mk(ty, .ArrayFill(v), span)
    }
    stmts := list(tir.Stmt)
    slots := list(?^Expr)
    for _ in names.items { slots.push(null)! }
    written := list(usize)
    bad_args := false
    for a in args {
        match a.kind {
            .Named(name, x) => {
                i := position(names.items, name.name) else {
                    fill := if name.name is "fill" { " (`fill:` must be the only argument)" } else { "" }
                    cx.error(name.span, str.format("`{}` has no variant `{}`{}", cx.show(index), name.name, fill)!)
                    _ = cx.expr(&x, null)
                    bad_args = true
                    continue
                }
                if slots.items[i] is not null { cx.error(name.span, str.format("the element for `{}` is given twice", name.name)!) }
                v := cx.field_value(&x, elem)
                written.push(i)!
                slots.items[i] = v
            }
            _ => {
                if not bad_args {
                    first := if names.items.len > 0 { names.items[0] } else { "A" }
                    cx.error(a.span, str.format("`{}` is constructed by naming each variant of `{}`: `{}({}: …)`, or with `fill:`", cx.show(ty), cx.show(index), cx.show(ty), first)!)
                }
                bad_args = true
            }
        }
    }
    out_of_order := false
    for k in 1..written.items.len.max(1) {
        if written.items[k - 1] > written.items[k] { out_of_order = true }
    }
    if out_of_order {
        for w in written.items {
            if v := slots.items[w] { slots.items[w] = cx.bind_temp(v, &stmts) }
        }
    }
    missing := list(u8)
    for i, n in enumerate(names.items) {
        if slots.items[i] is null {
            if missing.items.len > 0 { missing.extend(", ")! }
            missing.extend(str.format("`{}`", n)!)!
        }
    }
    if missing.items.len > 0 and not bad_args {
        cx.error(span, str.format("`{}` needs an element for every variant: missing {}", cx.show(ty), missing.items)!)
    }
    values := list(Expr)
    for s in slots.items { values.push((s else error_expr(cx.s, span))^)! }
    arr := tir.mk(ty, .Array(values.items), span)
    if stmts.items.len is 0 { return arr }
    return tir.mk(ty, .Block(new(tir.Block(stmts: stmts.items, tail: arr, span: span))!), span)
}

/// The position of `name` in `names`.
position :: fn(names: []const string, name: string) -> ?usize {
    for i, n in enumerate(names) {
        if n is name { return i }
    }
    return null
}

/// `a[e]` on an enum-indexed array `[E]T`: `e` is an `E`, and the element is the one at
/// the position of `e`'s variant among `@variants(E)` (§5.6). It needs no check.
enum_array_index :: fn(cx: ^FnCx, b: ^Expr, e: Ty, elem: Ty, index_ast: ^const ast.Expr, span: source.Span) -> ^Expr needs Load {
    i := cx.expr(index_ast, e)
    it := cx.infer.resolve(cx.s, i.ty)
    if cx.s.tys.is_error(it) { return error_expr(cx.s, span) }
    if it is not e {
        bt := cx.infer.resolve(cx.s, b.ty)
        hint := if cx.s.tys.kind(it) is .Infer(_) or cx.s.tys.is_integer(it) or cx.s.range_of(it) is not null { "; its elements in the order of the variants are the slice `a[..]`" } else { "" }
        cx.error(i.span, str.format("`{}` is indexed by `{}` values, not `{}`{}", cx.show(bt), cx.show(e), cx.show(it), hint)!)
        return error_expr(cx.s, span)
    }
    pos := cx.variant_position(i, e, span)
    return tir.mk(elem, .Index(b, pos, false), span)
}

/// The position (`usize`) of the variant of the enum value `v` among `@variants(e)`: its
/// tag when the tags count up from 0 in declaration order, otherwise a `match`.
variant_position :: fn(cx: ^FnCx, v: ^Expr, e: Ty, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    uv := cx.s.union_variants(e) else return error_expr(cx.s, span)
    counts_up := true
    for i, var in enumerate(uv.variants) {
        if not bigint.eq(var.tag, bigint.from_u64(u64(i))) { counts_up = false }
    }
    if counts_up and .Int(signed, bits) := tys.kind(uv.tag) and not signed and bits <= 32 {
        t := builtin(.Tag, uv.tag, [1]^Expr(v)[..], span)
        return cx.coerce(t, tys.usize_ty())
    }
    arms := list(tir.Arm)
    for i in 0..uv.variants.len {
        arms.push(tir.Arm(pat: tir.mk_pat(e, .Variant(i.trunc(u32), null), span), guard: null, body: tir.mk(tys.usize_ty(), .Int(bigint.from_u64(u64(i))), span)))!
    }
    return tir.mk(tys.usize_ty(), .Match(v, arms.items), span)
}

/// The elements of an array of `len` elements (or as many as given) of type `elem`.
construct_array :: fn(cx: ^FnCx, ty: ?Ty, len: ?u64, elem: Ty, args: []const ast.Arg, span: source.Span) -> ^Expr needs Load {
    tys := &cx.s.tys
    if args.len is 1 and .Named(n, e) := args[0].kind and n.name is "fill" {
        l := len else {
            cx.error(span, "`[_]T(fill: x)` cannot infer the length; write it")
            return error_expr(cx.s, span)
        }
        v := cx.field_value(&e, elem)
        return tir.mk(ty else tys.array(l, elem), .ArrayFill(v), span)
    }
    for a in args {
        if .Named(n, _) := a.kind and n.name is "fill" {
            cx.error(a.span, "`fill:` must be the only argument")
            return error_expr(cx.s, span)
        }
    }
    // `[N]T(v)`: one element, unless `v` is a vector conversion.
    if args.len is 1 and .Positional(e) := args[0].kind and e.kind is not .Uninit {
        if n := len {
            v := cx.expr(&e, elem)
            vt := cx.infer.resolve(cx.s, v.ty)
            target := ty else tys.array(n, elem)
            if tys.kind(vt) is .Array(_) and vt is not elem {
                if tys.is_vector(vt) or tys.is_vector(target) {
                    if c := cx.vector_conversion(target, v, span) { return c }
                }
                if tys.is_math_vector(vt) or tys.is_math_vector(target) {
                    if c := cx.math_vector_conversion(target, v, span) { return c }
                }
            }
            v = cx.coerce(v, elem)
            if n is not 1 {
                cx.error(span, str.format("`{}` needs exactly {} elements, but 1 is given", cx.show(target), n)!)
                return error_expr(cx.s, span)
            }
            values := list(Expr)
            values.push(v^)!
            return tir.mk(target, .Array(values.items), span)
        }
    }
    values := list(Expr)
    // `[N]T(..t)` spreads a tuple's elements (§11.4); with spreads, every value goes
    // through a temporary, in the order written.
    spreading := false
    for a in args {
        if a.kind is .Spread(_) { spreading = true }
    }
    stmts := list(tir.Stmt)
    for a in args {
        match a.kind {
            .Positional(e) => {
                v := cx.field_value(&e, elem)
                values.push((if spreading { cx.bind_temp(v, &stmts) } else { v })^)!
            }
            .Spread(e) => {
                parts := cx.spread_parts(&e, &stmts) else return error_expr(cx.s, span)
                for p in parts {
                    if p.name is not null {
                        cx.error(e.span, "array elements are written positionally; this spread has named parts")
                        return error_expr(cx.s, span)
                    }
                    values.push(cx.coerce(p.value, elem)^)!
                }
            }
            _ => cx.error(a.span, "array elements are written positionally")
        }
    }
    if n := len and n is not u64(values.items.len) {
        t := ty else tys.array(n, elem)
        cx.error(span, str.format("`{}` needs exactly {} elements, but {} given", cx.show(t), n, given(values.items.len))!)
        return error_expr(cx.s, span)
    }
    t := ty else tys.array(u64(values.items.len), elem)
    arr := tir.mk(t, .Array(values.items), span)
    if stmts.items.len is 0 { return arr }
    return tir.mk(t, .Block(new(tir.Block(stmts: stmts.items, tail: arr, span: span))!), span)
}

/// "1 is" or "3 are", for a count of given values.
given :: fn(n: usize) -> string needs Alloc => if n is 1 { "1 is" } else { str.format("{} are", n)! }

// ---------------------------------------------------------------------------------
// `for` over arrays, slices and tuples (§13.2)
// ---------------------------------------------------------------------------------

/// `for p in src` where `src` (already checked) is an array, a pointer to one, a slice, a
/// tuple or a range value; `null` if it is none of these.
for_each_value :: fn(cx: ^FnCx, f: ^const ast.ForExpr, src0: ^Expr) -> ?^Expr needs Load {
    tys := &cx.s.tys
    span := f.span
    src := cx.soa_deref(src0)
    if info := cx.soa_of(src) { return cx.soa_for(f, src, info) }
    st := cx.infer.resolve(cx.s, src.ty)
    slice: ^Expr = src
    elem: Ty = st
    match tys.kind(st) {
        .Slice(_, e) => { elem = e }
        .Array(_, e, _), .ParamArray(_, e) => {
            elem = e
            // A temporary array is iterated from a hidden local that lives as long as the
            // loop, and so is an array in a `#packed` struct, whose elements may be
            // misaligned.
            m := cx.place_mutability(src)
            if packed_place(cx.s, src) { m = null }
            if x := m {
                slice = tir.mk(tys.slice(not x, e), .Slice(tir.SliceExpr(base: src, lo: null, hi: null, inclusive: false)), span)
            } else {
                t := cx.temp(st, span)
                sty := tys.slice(true, e)
                s := tir.mk(sty, .Slice(tir.SliceExpr(base: tir.mk(st, .Local(t), span), lo: null, hi: null, inclusive: false)), span)
                stmts := list(tir.Stmt)
                stmts.push(.Let(t, src))!
                slice = tir.mk(sty, .Block(new(tir.Block(stmts: stmts.items, tail: s, span: span))!), span)
            }
        }
        .Ptr(c, pointee) => {
            match tys.kind(pointee) {
                .Array(_, e, _), .ParamArray(_, e) => {
                    elem = e
                    arr := tir.mk(pointee, .Deref(src), span)
                    slice = tir.mk(tys.slice(c, e), .Slice(tir.SliceExpr(base: arr, lo: null, hi: null, inclusive: false)), span)
                }
                _ => return null
            }
        }
        .Error => return error_expr(cx.s, span)
        // A tuple whose elements have one type iterates like the array of them:
        // `{ t := src; for x in [t.0, t.1, …] { body } }`.
        .Tuple(elems, _) => {
            if elems.len is 0 { return null }
            e0 := elems[0]
            // Elements of different types are iterated at their join (§7.12).
            joined := cx.tuple_elem_join(elems)
            if j := joined { e0 = j }
            for k in 1..elems.len {
                if joined is null and cx.infer.unify(tys, e0, elems[k]) is !_ {
                    a := cx.infer.resolve(cx.s, e0)
                    b := cx.infer.resolve(cx.s, elems[k])
                    cx.error(f.iter.span, str.format("the elements of a tuple iterated by `for` must have one type, but found `{}` and `{}`", cx.show(a), cx.show(b))!)
                    return error_expr(cx.s, span)
                }
            }
            t := cx.temp(st, span)
            items := list(Expr)
            for k in 0..elems.len {
                field := tir.mk(elems[k], .Field(tir.mk(st, .Local(t), span), k.trunc(u32)), span)
                items.push(cx.coerce(field, e0)^)!
            }
            arr := tir.mk(tys.array(u64(elems.len), e0), .Array(items.items), span)
            lp := cx.for_each_value(f, arr) else return null
            stmts := list(tir.Stmt)
            stmts.push(.Let(t, src))!
            stmts.push(.Expr(lp))!
            return block_of(cx.s, stmts.items, span)
        }
        .Adt(_) => {
            // A range value: `{ r := src; for i in r.lo..r.hi { body } }`.
            r := cx.s.range_of(st) else return null
            if not tys.is_integer(r.elem) {
                cx.error(f.iter.span, str.format("`for` iterates over ranges of integers, not of `{}`", cx.show(r.elem))!)
                return error_expr(cx.s, span)
            }
            t := cx.temp(st, span)
            lo := tir.mk(r.elem, .Field(tir.mk(st, .Local(t), span), 0), span)
            hi := tir.mk(r.elem, .Field(tir.mk(st, .Local(t), span), 1), span)
            lp := cx.range_loop(f, lo, hi, r.elem, r.inclusive)
            stmts := list(tir.Stmt)
            stmts.push(.Let(t, src))!
            stmts.push(.Expr(lp))!
            return block_of(cx.s, stmts.items, span)
        }
        _ => return null
    }
    // { s := xs[..]; i := 0; loop i < s.len { p :: s[i]; body } step i += 1 }
    sty := slice.ty
    usize_t := tys.usize_ty()
    s := cx.temp(sty, span)
    i := cx.temp(usize_t, span)
    local :: fn(id: u32, ty: Ty) -> ^Expr needs Alloc => tir.mk(ty, .Local(id), span)
    len := tir.mk(usize_t, .SliceLen(local(s, sty)), span)
    cond := list(tir.CondPart)
    cond.push(.Bool(tir.mk(tys.bool_ty(), .Binary(.Lt, local(i, usize_t), len), span)))!
    item := tir.mk(elem, .Index(local(s, sty), local(i, usize_t), false), span)
    more := list(tir.Stmt)
    more.push(.Assign(local(i, usize_t), tir.mk(usize_t, .Binary(.Add(.Wrap), local(i, usize_t), tir.mk(usize_t, .Int(bigint.one()), span)), span)))!
    step := block_of(cx.s, more.items, span)
    lp := cx.loop_with_pattern(f, elem, item, cond.items, step)
    stmts := list(tir.Stmt)
    stmts.push(.Let(s, slice))!
    stmts.push(.Let(i, tir.mk(usize_t, .Int(bigint.zero()), span)))!
    stmts.push(.Expr(lp))!
    return block_of(cx.s, stmts.items, span)
}
