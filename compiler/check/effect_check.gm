// Checking that the effects a function performs are declared (§12).

check_effects :: fn(cx: ^FnCx) needs Load {
    reported := list(EffectRef)
    for p in cx.performed.items {
        if set_contains(&cx.declared, &p.effect_) { continue }
        seen := false
        for r in reported.items {
            if types.cmp_ref(&r, &p.effect_) is 0 { seen = true }
        }
        if seen { continue }
        m := cx.undeclared_message(&p.effect_, p.span, &cx.declared)
        d := diag.error(p.span, m.msg)
        name := cx.s.tys.show_ref(&p.effect_)
        if fix := cx.needs_fix(&p.effect_) and m.plain { d.add_fix(str.format("add `{}` to the function's effects", name)!, fix.span, fix.text) }
        cx.s.emit(d)
        reported.push(p.effect_)!
    }
    cx.performed.clear()
}

/// The message for an effect performed at `span` that the function, which declares
/// `declared`, does not declare, and whether it is the plain message, which only says to
/// add the effect. A call of an iterator from a function with no `Yield` of its own was
/// most likely meant as the source of a `for` loop.
undeclared_message :: fn(cx: ^FnCx, e: ^const EffectRef, span: source.Span, declared: ^const EffectSet) -> (msg: string, plain: bool) needs Alloc {
    name := cx.s.tys.show_ref(e)
    if y := cx.s.yield_effect {
        if e.eff is y and span in cx.iterator_calls.items {
            has_yield := false
            for d in declared.effects {
                if d.eff is y { has_yield = true }
            }
            if not has_yield {
                // The call's callee: the text before its argument list, after any receiver.
                text := cx.s.l.sm.file(span.file).text[usize(span.lo)..usize(span.hi)]
                if i := str.find(text, "(") { text = text[..i] }
                if i := str.rfind(text, ".") { text = text[i + 1..] }
                c := str.trim(text)
                return (msg: str.format("`{}` is an iterator, not a value: call it as the source of a `for` loop (`for x in {}(…)`) or pass it to a function that runs it, such as `collect({}(…))` (§13.5)", c, c, c)!, plain: false)
            }
        }
    }
    // Another instantiation of the same effect is declared or handled around the
    // perform: `Sched` against `Sched(Out)`.
    others := list(string)
    for d in declared.effects {
        if d.eff is e.eff and types.cmp_ref(&d, e) is not 0 { others.push(str.format("`{}`", cx.s.tys.show_ref(&d))!)! }
    }
    what: string = if others.items.len is 0 { "an enclosing `with` handles" } else { "the function declares" }
    for nm in cx.near_misses.items {
        if nm.span is span and nm.effect_.eff is e.eff {
            h: string = str.format("`{}`", cx.s.tys.show_ref(&nm.effect_))!
            if h not in others.items { others.push(h)! }
        }
    }
    if others.items.len > 0 {
        return (msg: str.format("this performs the effect `{}`, but {} {}: instantiations with different arguments are different effects (§12.3)", name, what, str.join(others.items, " and ")!)!, plain: false)
    }
    return (msg: str.format("this performs the effect `{}`, which the function does not declare (add `needs {}`)", name, name)!, plain: true)
}

/// The edit that adds effect `e` to the signature of the function being checked, if it
/// is a top-level function and `e` is written as its bare name there.
needs_fix :: fn(cx: ^FnCx, e: ^const EffectRef) -> ?(span: source.Span, text: string) needs Load {
    at := cx.needs_at else return null
    name := cx.s.tys.effect_name(e.eff)
    d := cx.s.lookup_module_name(cx.module, name) else return null
    .Effect(eff) := cx.s.resolve_decl(d) else return null
    bare := cx.s.bare_effect_ref(eff)
    if types.cmp_ref(&bare, e) is not 0 { return null }
    // `main` performs only ambient effects; the others must be handled inside it.
    if f := cx.fn_id {
        if cx.s.fns.items[usize(f)].name is "main" and not cx.s.is_ambient(e.eff) { return null }
    }
    text := if at.has_needs { str.format(" + {}", name)! } else { str.format(" needs {}", name)! }
    return (span: at.span, text: text)
}

record_effects :: fn(cx: ^FnCx, set: ^const EffectSet, span: source.Span) needs Alloc {
    for e in set.effects {
        if y := cx.s.yield_effect and e.eff is y { cx.iterator_calls.push(span)! }
        cx.performed.push(Performed(effect_: e, span: span))!
    }
}

set_contains :: fn(set: ^const EffectSet, e: ^const EffectRef) -> bool {
    for x in set.effects {
        if types.cmp_ref(&x, e) is 0 { return true }
    }
    return false
}
