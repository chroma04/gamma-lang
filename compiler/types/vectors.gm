// Constructors and predicates for vector types `#simd [N]T` (§5.6.2) and math vectors
// `#vec [N]T` (§5.6.3) (mirrors `src/types.rs`).

/// `#simd [N]T`: a vector of `len` lanes.
pub simd :: fn(t: ^Types, len: u64, elem: Ty) -> Ty needs Alloc => t.intern(.Array(len, elem, .Simd))

/// `#vec [N]T`: a math vector of `len` elements.
pub math_vec :: fn(t: ^Types, len: u64, elem: Ty) -> Ty needs Alloc => t.intern(.Array(len, elem, .Math))

pub is_float :: fn(t: ^const Types, ty: Ty) -> bool => t.kind(ty) is .Float(_)
pub is_bool :: fn(t: ^const Types, ty: Ty) -> bool => t.kind(ty) is .Bool

/// The lane count and lane type of a vector type.
pub vector_parts :: fn(t: ^const Types, ty: Ty) -> ?(len: u64, elem: Ty) {
    .Array(len, elem, .Simd) := t.kind(ty) else return null
    return (len: len, elem: elem)
}

/// The length and element type of a math vector type.
pub math_vector_parts :: fn(t: ^const Types, ty: Ty) -> ?(len: u64, elem: Ty) {
    .Array(len, elem, .Math) := t.kind(ty) else return null
    return (len: len, elem: elem)
}

pub is_vector :: fn(t: ^const Types, ty: Ty) -> bool => t.vector_parts(ty) is not null
pub is_math_vector :: fn(t: ^const Types, ty: Ty) -> bool => t.math_vector_parts(ty) is not null

/// An array whose elements are reached by position: `[N]T`, a vector or a math vector,
/// not `[E]T`.
pub is_positional_array :: fn(t: ^const Types, ty: Ty) -> bool => match t.kind(ty) {
    .Array(_, _, kind) => kind in (.Plain, .Simd, .Math)
    .ParamArray(_) => true
    _ => false
}
