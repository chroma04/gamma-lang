// The `stale-element-pointer` lint: a pointer or slice into the items of a list, kept in a
// local across a call that may grow the list and so move its items:
//
//     e := &l.items[i]
//     l.push(x)!               // may move the items to a larger block
//     e.count += 1             // writes to freed memory
//
// The function body is followed in order (a loop body twice, so that a use early in the
// next iteration counts). A local is bound to the items of a list place by `&l.items[i]`
// (also through fields of the element), `l.items[a..b]` or `l.items`; a call that gets a
// pointer to the same place for a `^List` parameter may grow it, unless it is a core list
// function that does not (`pop`, `clear`, `truncate`, `remove`, ...). So may a call that
// gets a pointer to a struct holding the list, if the function grows that list itself or
// through the functions it calls (`p.alloc_expr()` pushing to `p.exprs`): before the
// scans, `growth_summaries` finds those lists for every function. The first use of the
// local after the call is reported. Places are compared by their path of locals and
// fields, through pointers; indexed places and other aliases are not followed.

/// A list that a function may grow: the one at `path` (fields, written as in `place_key`)
/// in what its parameter `param` points to; an empty `path` is the parameter's own list.
Growth :: struct {
    param: usize
    path: string
}

/// A call in function `caller` that gives argument `arg` of function `callee` a pointer to
/// the place at `path` in what parameter `param` of the caller points to.
CallEdge :: struct {
    caller: usize
    param: usize
    path: string
    callee: usize
    arg: usize
}

/// The most fields a summarized path goes through (recursion through a pointer field
/// would otherwise lengthen it forever).
MAX_GROWTH_DEPTH :: 4

/// For each function (by index; an instance of a generic function under its template),
/// the lists it may grow through its pointer parameters, itself or through the functions
/// it calls.
growth_summaries :: fn(s: ^sema.Sema) -> List(List(Growth)) needs Alloc + Fs {
    sums := list(List(Growth))
    for _ in 0..s.fns.items.len { sums.push(list(Growth))! }
    id := s.prelude_template("List") else return sums
    edges := list(CallEdge)
    for i in 0..s.defs.items.len {
        if s.fns.items[i].instance is not null { continue }
        body := s.defs.items[i].body else continue
        collect_calls(s, id, i, body, &sums, &edges)
    }
    changed := true
    while changed {
        changed = false
        for e in edges.items {
            n := sums.items[e.callee].items.len
            for k in 0..n {
                x := sums.items[e.callee].items[k]
                if x.param is not e.arg { continue }
                p := str.format("{}{}", e.path, x.path)!
                if add_growth(&sums.items[e.caller], e.param, p) { changed = true }
            }
        }
    }
    return sums
}

/// Adds the growth of the list at `path` in parameter `param` to `sum`, unless it is there
/// or too deep; returns whether it was added.
add_growth :: fn(sum: ^List(Growth), param: usize, path: string) -> bool needs Alloc {
    if str.count(path, ".") > MAX_GROWTH_DEPTH { return false }
    for x in sum.items {
        if x.param is param and x.path is path { return false }
    }
    sum.push(Growth(param: param, path: path))!
    return true
}

/// Records the calls in `e`, an expression of function `f`, that are given pointers into
/// what the parameters of `f` point to: a call that grows such a list adds to `f`'s
/// summary, and one to a function of the program becomes an edge.
collect_calls :: fn(s: ^sema.Sema, list_adt: u32, f: usize, e: ^Expr, sums: ^List(List(Growth)), edges: ^List(CallEdge)) needs Alloc {
    if e.kind is .Closure(_) or e.kind is .FnRef(_) or e.kind is .HandlerRef(_) { return }
    tir.for_each_child(e, fn(c: ^Expr) { collect_calls(s, list_adt, f, c, sums, edges) })
    .Call(callee, args) := e.kind else return
    .Fn(g) := callee else return
    sig := &s.fns.items[usize(g)]
    core := s.l.modules.items[sig.module].is_prelude
    target := usize(generic_of(s, g))
    for i in 0..args.len {
        if i >= sig.params.len { break }
        .Ptr(is_const, pointee) := s.tys.kind(sig.params[i].ty) else continue
        if is_const { continue }
        k := arg_key(&args[i]) else continue
        (param, path) := param_path(s, f, k) else continue
        if grows_directly(s, list_adt, sig, core, i, pointee) { _ = add_growth(&sums.items[f], param, path) }
        if not core { edges.push(CallEdge(caller: f, param: param, path: path, callee: target, arg: i))! }
    }
}

/// Whether a call of `sig` may grow the list that argument `i`, a `^pointee`, points to:
/// any function of the program given a `^List` may, and of the core list functions those
/// that `grows` names.
grows_directly :: fn(s: ^sema.Sema, list_adt: u32, sig: ^const sema.FnSig, core: bool, i: usize, pointee: types.Ty) -> bool {
    if not list_type(s, list_adt, pointee) { return false }
    return not core or (i is 0 and grows(sig.name))
}

/// The place that argument `a` (for a pointer parameter) points to, as a key.
arg_key :: fn(a: ^Expr) -> ?string needs Alloc {
    x := strip_coerce(a)
    if .AddrOf(p) := x.kind { return place_key(p) }
    return place_key(x)
}

/// The parameter of function `f` that place key `k` is rooted at, if it is a mutable
/// pointer, and the rest of the key after it.
param_path :: fn(s: ^sema.Sema, f: usize, k: string) -> ?(usize, string) needs Alloc {
    def := &s.defs.items[f]
    sig := &s.fns.items[f]
    for j, l in enumerate(def.params) {
        if j >= sig.params.len { break }
        .Ptr(is_const, _) := s.tys.kind(sig.params[j].ty) else continue
        if is_const { continue }
        root := str.format("{}", l)!
        if k is root { return (j, "") }
        if k.starts_with(root) and k[root.len..].starts_with(".") { return (j, k[root.len..]) }
    }
    return null
}

/// A local holding a pointer into the items of the list at `key`, and the call that may
/// have moved them, if one has been made.
Live :: struct {
    local: u32
    key: string
    /// Where the list is written in the source.
    place: source.Span
    grown: ?source.Span
}

StaleScan :: struct {
    s: ^sema.Sema
    def: ^const tir.FnDef
    /// The core library's `List`.
    list_adt: u32
    /// The lists each function may grow (`growth_summaries`).
    growth: []const List(Growth)
    live: List(Live)
    /// The uses reported.
    reported: List(source.Span)
    out: ^List(Finding)
}

/// Reports the locals of function `f` that point into a list's items and are used after a
/// call that may have moved them.
stale_element_pointers :: fn(s: ^sema.Sema, f: usize, growth: []const List(Growth), out: ^List(Finding)) needs Alloc + Fs {
    id := s.prelude_template("List") else return
    def := &s.defs.items[f]
    body := def.body else return
    sc := StaleScan(s: s, def: def, list_adt: id, growth: growth, live: list(Live), reported: list(source.Span), out: out)
    sc.scan(body)
}

clone_live :: fn(a: List(Live)) -> List(Live) needs Alloc {
    r := list(Live)
    for x in a.items { r.push(x)! }
    return r
}

/// The states `a` and `b` together: what is live in either, grown if grown in either.
union_live :: fn(a: List(Live), b: List(Live)) -> List(Live) needs Alloc {
    r := clone_live(a)
    for x in b.items {
        found := false
        for i in 0..r.items.len {
            if r.items[i].local is x.local and r.items[i].key is x.key {
                found = true
                if r.items[i].grown is null { r.items[i].grown = x.grown }
            }
        }
        if not found { r.push(x)! }
    }
    return r
}

strip_coerce :: fn(e: ^Expr) -> ^Expr {
    cur := e
    while .Coerce(_, inner) := cur.kind { cur = inner }
    return cur
}

/// The path of locals, globals and fields that place `e` names, with pointers followed
/// (`l` and `l^` are the same), or `null` for a place not tracked.
place_key :: fn(e: ^Expr) -> ?string needs Alloc {
    x := strip_coerce(e)
    match x.kind {
        .Local(l) => return str.format("{}", l)!
        .Global(name, _) => return str.format("global {}", name)!
        .Deref(inner) => return place_key(inner)
        .Field(base, i) => {
            k := place_key(base) else return null
            return str.format("{}.{}", k, i)!
        }
        _ => return null
    }
}

is_list :: fn(sc: ^StaleScan, t: types.Ty) -> bool => list_type(sc.s, sc.list_adt, t)

/// Whether `t` is an instance of the core library's `List` (`list_adt`).
list_type :: fn(s: ^sema.Sema, list_adt: u32, t: types.Ty) -> bool {
    if .Adt(id, _) := s.tys.kind(t) { return s.tys.template(id) is list_adt }
    return false
}

/// The list place whose `items` expression `e` is.
items_of :: fn(sc: ^StaleScan, e: ^Expr) -> ?^Expr {
    x := strip_coerce(e)
    if .Field(base, i) := x.kind {
        if i is 0 and is_list(sc, base.ty) { return base }
    }
    return null
}

/// The list place whose items hold the element place `p`.
element_of :: fn(sc: ^StaleScan, p: ^Expr) -> ?^Expr {
    match p.kind {
        .Index(base, _, _) => {
            if l := items_of(sc, base) { return l }
            if sc.s.tys.kind(base.ty) is .Array(_, _, _) { return element_of(sc, base) }
        }
        .Field(base, _) => return element_of(sc, base)
        _ => {}
    }
    return null
}

/// The list place that value `e` points into the items of: `&l.items[i]`, `&l.items[i].f`,
/// `l.items[a..b]` or `l.items`.
source_of :: fn(sc: ^StaleScan, e: ^Expr) -> ?^Expr {
    x := strip_coerce(e)
    match x.kind {
        .AddrOf(p) => return element_of(sc, p)
        .Slice(sl) => return items_of(sc, sl.base)
        .Field(_, _) => return items_of(sc, x)
        _ => return null
    }
}

/// Core list functions that may move the items of their list.
grows :: fn(name: string) -> bool => name in ("push", "extend", "insert", "reserve", "collect", "write", "deinit", "into_slice")

/// Binds local `l` to the list place that value `init` points into the items of, if any.
bind :: fn(sc: ^StaleScan, l: u32, init: ^Expr) needs Alloc {
    sc.forget(l)
    place := source_of(sc, init) else return
    k := place_key(place) else return
    if place.span is source.DUMMY { return }
    sc.live.push(Live(local: l, key: k, place: place.span, grown: null))!
}

forget :: fn(sc: ^StaleScan, l: u32) needs Alloc {
    kept := list(Live)
    for x in sc.live.items {
        if x.local is not l { kept.push(x)! }
    }
    sc.live = kept
}

/// A use of local `l`.
touch :: fn(sc: ^StaleScan, l: u32, at: source.Span) needs Alloc {
    for x in sc.live.items {
        if x.local is l {
            g := x.grown else continue
            if at is source.DUMMY { continue }
            seen := false
            for r in sc.reported.items {
                if r is at { seen = true }
            }
            if not seen {
                sc.reported.push(at)!
                sc.out.push(Finding.StaleElementPointer(at, sc.def.locals[usize(l)].name, x.place, g))!
            }
            sc.forget(l)
            return
        }
    }
}

/// A call to function `g` with `args`: the lists it may grow are marked.
grow_by_call :: fn(sc: ^StaleScan, g: u32, args: []Expr, at: source.Span) needs Alloc {
    sig := &sc.s.fns.items[usize(g)]
    core := sc.s.l.modules.items[sig.module].is_prelude
    target := usize(generic_of(sc.s, g))
    for i in 0..args.len {
        if i >= sig.params.len { break }
        .Ptr(is_const, pointee) := sc.s.tys.kind(sig.params[i].ty) else continue
        if is_const { continue }
        k := arg_key(&args[i]) else continue
        if grows_directly(sc.s, sc.list_adt, sig, core, i, pointee) { sc.mark_grown(k, at) }
        if core or target >= sc.growth.len { continue }
        for x in sc.growth[target].items {
            if x.param is i { sc.mark_grown(str.format("{}{}", k, x.path)!, at) }
        }
    }
}

/// Marks the list at place key `k` as grown by the call at `at`.
mark_grown :: fn(sc: ^StaleScan, k: string, at: source.Span) {
    for j in 0..sc.live.items.len {
        if sc.live.items[j].key is k and sc.live.items[j].grown is null { sc.live.items[j].grown = at }
    }
}

/// Scans `e` from state `from`; returns the state after it, or `null` if it does not
/// complete (it ends in a `return`, `break`, ...), in which case nothing follows it.
branch :: fn(sc: ^StaleScan, from: List(Live), e: ^Expr) -> ?List(Live) needs Alloc {
    sc.live = clone_live(from)
    sc.scan(e)
    if sc.s.tys.kind(e.ty) is .Never { return null }
    return sc.live
}

/// Adds `r`, the state after one branch, to `merged`.
join :: fn(merged: ?List(Live), r: List(Live)) -> ?List(Live) needs Alloc {
    if m := merged { return union_live(m, r) }
    return r
}

scan_conds :: fn(sc: ^StaleScan, cond: []tir.CondPart) needs Alloc {
    for c in cond {
        match c {
            .Bool(x) => sc.scan(x)
            .Match(_, v) => sc.scan(v)
        }
    }
}

scan_block :: fn(sc: ^StaleScan, b: ^const tir.Block) needs Alloc {
    for st in b.stmts {
        match st {
            .Let(local, ?init) => if x := init {
                sc.scan(x)
                sc.bind(local, x)
            }
            .LetTuple(locals, x) => {
                sc.scan(x)
                for l in locals {
                    if id := l { sc.forget(id) }
                }
            }
            .Assign(place, value) => {
                sc.scan(value)
                if .Local(l) := place.kind {
                    sc.bind(l, value)
                } else {
                    sc.scan(place)
                }
            }
            .AssignTuple(places, value) => {
                sc.scan(value)
                for p in places {
                    if x := p {
                        if .Local(l) := x.kind { sc.forget(l) } else { sc.scan(x) }
                    }
                }
            }
            .Expr(x) => sc.scan(x)
            .Defer(_, x) => sc.scan(x)
        }
    }
    if t := b.tail { sc.scan(t) }
}

scan :: fn(sc: ^StaleScan, e: ^Expr) needs Alloc {
    match e.kind {
        .Local(l) => return sc.touch(l, e.span)
        .Block(b) => return sc.scan_block(b)
        .If(x) => {
            sc.scan_conds(x.cond)
            base := clone_live(sc.live)
            merged: ?List(Live) = null
            if r := sc.branch(base, x.then) { merged = join(merged, r) }
            if el := x.else_ {
                if r := sc.branch(base, el) { merged = join(merged, r) }
            } else {
                merged = join(merged, base)
            }
            sc.live = if m := merged { m } else { base }
            return
        }
        .Match(scrutinee, arms) => {
            sc.scan(scrutinee)
            base := clone_live(sc.live)
            merged: ?List(Live) = null
            for a in arms {
                sc.live = clone_live(base)
                if g := a.guard { sc.scan(g) }
                if r := sc.branch(sc.live, a.body) { merged = join(merged, r) }
            }
            sc.live = if m := merged { m } else { base }
            return
        }
        .Else(x) => {
            sc.scan(x.lhs)
            base := clone_live(sc.live)
            if r := sc.branch(base, x.rhs) { sc.live = union_live(base, r) } else { sc.live = base }
            return
        }
        .Logic(_, lhs, rhs) => {
            sc.scan(lhs)
            base := clone_live(sc.live)
            sc.scan(rhs)
            sc.live = union_live(base, sc.live)
            return
        }
        .Loop(x) => {
            entry := clone_live(sc.live)
            for pass in 0..2 {
                sc.scan_conds(x.cond)
                sc.scan_block(x.body)
                if st := x.step { sc.scan(st) }
                if pass is 0 { sc.live = union_live(sc.live, entry) }
            }
            sc.live = union_live(sc.live, entry)
            return
        }
        .Closure(_), .FnRef(_), .HandlerRef(_) => return
        _ => {}
    }
    tir.for_each_child(e, fn(c: ^Expr) { sc.scan(c) })
    if .Call(callee, args) := e.kind {
        if .Fn(g) := callee { sc.grow_by_call(g, args, e.span) }
    }
}

sema :: import "../sema"
source :: import "../source"
str :: import "std/str"
tir :: import "../tir"
types :: import "../types"
