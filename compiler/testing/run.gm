//! `gamma test` and `gamma bench`: running the `test` and `bench` declarations of a
//! program (§3.8, §3.9), compiled into one native executable (or, with
//! `--backend=interp`, each in a `gamma` process of its own that interprets it), in order
//! or in parallel, with timing when asked for.

arena :: import "std/arena"
cgen :: import "../cgen"
check :: import "../check"
driver :: import "../driver"
fs :: import "std/fs"
hash_map :: import "std/collections/hash_map"
load :: import "../load"
math :: import "std/math"
pkg :: import "../pkg"
process :: import "std/process"
sema :: import "../sema"
source :: import "../source"
str :: import "std/str"
thread :: import "std/thread"
tir :: import "../tir"

/// Copies of this process for running interpreted tests (Linux; elsewhere `gm_proc_fork`
/// fails and each test starts `gamma` again): `gm_proc_fork` returns 0 in the copy, which
/// ends with `gm_proc_fork_exit`, and the copy's handle (a `process.Child`) here.
rt :: foreign "c" {
    gm_proc_fork :: fn() -> i64
    gm_proc_fork_exit :: fn(status: i32)
}

/// What an interpreted test needs to run in a copy of this process, where the program is
/// checked already, instead of in a new `gamma` that would check it again: the program,
/// how `gamma` was invoked, and the function of each chosen test.
InProcess :: struct {
    s: ^sema.Sema
    input: string
    opts: driver.Options
    entries: []const u32
}

/// Whether `t` is selected by `--filter`: its name or module path contains the filter text.
selected :: fn(t: sema.TestCase, filter: ?string) -> bool {
    f := filter else return true
    if str.contains(t.name, f) { return true }
    m := t.module else return false
    return str.contains(m, f)
}

/// `gamma test` and `gamma bench`: runs each test (or benchmark) of the checked program
/// (the root module's, and those of the modules of its package that it imports; all of
/// them with `--all`) with captured output (§3.8). A failing test's output and failure
/// reason are printed below its line; with `--coverage`, the lines of the package of
/// `input` that the tests ran follow. Returns the exit status.
pub run :: fn(s: ^sema.Sema, input: string, opts: driver.Options) -> u8 needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    bench := opts.command is .Bench
    if opts.coverage and bench {
        eprint("gamma: `--coverage` is an option of `gamma test`\n")
        return 2
    }
    if opts.coverage and opts.interp {
        eprint("gamma: `--coverage` needs the C back end: the interpreter does not count lines\n")
        return 2
    }
    cases := if bench { s.benches.items } else { s.tests.items }
    chosen := list(usize)
    for i, c in enumerate(cases) {
        if selected(c, opts.filter) { chosen.push(i)! }
    }
    // A process started by `run_interp_tests` runs one of them.
    if j := opts.run_test {
        if j >= chosen.items.len {
            eprint("gamma: `--run-test={}`: there are only {} tests\n", j, chosen.items.len)
            return 2
        }
        return driver.run_interp_entry(s, entry_of(s, cases[chosen.items[j]], bench), input, opts)
    }
    filtered_out: ?usize = null
    if opts.filter is not null { filtered_out = cases.len - chosen.items.len }
    report := Report(bench: bench, filtered_out: filtered_out, show_output: opts.show_output, time: opts.time, started: Clock.now().ns)
    if opts.interp {
        run_interp_tests(s, input, opts, cases, chosen.items, bench, &report) else return 1
        return finish(&report)
    }
    if not opts.coverage {
        run_native(s, opts, cases, chosen.items, bench, &report, null) else return 1
        return finish(&report)
    }
    cover := Cover(scope: scope(input), map: CoverMap(points: list((file: source.FileId, line: u32))), counts: list(u32))
    status: u8 = 1
    if run_native(s, opts, cases, chosen.items, bench, &report, &cover) is not null { status = finish(&report) }
    if not coverage_report(s, &cover.scope, &cover.map, cover.counts.items, opts.coverage_file) { return 1 }
    return status
}

/// What coverage needs from running the tests: what it counts, the lines that carry a
/// counter, and the counts added up over the tests.
Cover :: struct {
    scope: Scope
    map: CoverMap
    counts: List(u32)
}

/// Compiles the chosen tests into one executable, which runs the test whose position among
/// them it is given, and runs it once per test, recording each result in `report`. With
/// `cover`, the program is instrumented for coverage and the counts of the tests are added
/// up. Fails if the executable cannot be built, reporting why.
run_native :: fn(s: ^sema.Sema, opts: driver.Options, cases: []const sema.TestCase, chosen: []const usize, bench: bool, report: ^Report, cover: ?^Cover) -> ?() needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    entries := list(u32)
    for i in chosen { entries.push(entry_of(s, cases[i], bench))! }
    buf: [4096]u8 = ---
    dir := fs.make_temp_dir(fs.temp_dir(), if bench { "gamma-bench-" } else { "gamma-test-" }, buf[..]) else {
        eprint("gamma: cannot create a temporary directory in `{}`\n", fs.temp_dir())
        return null
    }
    defer _ = fs.remove_all(dir)
    if c := cover {
        // Every body the executable needs is produced first, so that all are instrumented.
        roots := list(u32)
        roots.extend(entries.items)!
        for f in s.export_fns.items { if f not in roots.items { roots.push(f)! } }
        if not check.prepare_codegen(s, roots.items) { return null }
        c.map = instrument(s, &c.scope)
    }
    cmd := build_tests(s, opts, entries.items, dir) else return null
    // Benchmarks time themselves, so they take turns.
    jobs := if bench { 1 } else { opts.jobs }
    // Each test writes its counters to a file of its own.
    cover_dir: ?string = if cover is not null { dir } else { null }
    run_all(cmd, .Native, null, null, cases, chosen, jobs, opts.timeout, cover_dir, report)
    if c := cover {
        for j in 0..chosen.len {
            text := fs.read_all(cover_file(dir, j)) else continue
            add_counts(&c.counts, string(text))
        }
    }
    return ()
}

/// Compiles the tests and benchmarks `entries` into one executable in `dir`, which runs the
/// one whose position among them it is given; returns the command that runs it (behind
/// `GAMMA_RUNNER` or a WebAssembly runtime when it is for another machine). Fails if it
/// cannot be built, reporting why.
build_tests :: fn(s: ^sema.Sema, opts: driver.Options, entries: []const u32, dir: string) -> ?[]const string needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    exe := load.join(dir, driver.native_exe_name(&opts, "tests"))
    if not driver.compile_entries(s, entries, true, exe, opts) { return null }
    runner := driver.runner_for(exe) else e => {
        eprint("gamma: {}\n", e)
        Env.exit(2)
    }
    cmd := list(string)
    cmd.extend(runner.items)!
    cmd.push(exe)!
    return cmd.items
}

/// The function that runs test (or benchmark) `c`. A benchmark runs under the system's
/// handlers, as `main` does.
entry_of :: fn(s: ^sema.Sema, c: sema.TestCase, bench: bool) -> u32 needs sema.Load {
    return if bench { check.entry_point(s, c.entry) } else { c.entry }
}

/// Runs each of the tests `chosen` of `cases` in the interpreter, in a process of its own,
/// so that a test that traps, exits or runs out of time ends only its process, and the
/// tests can run in parallel. Where the system can, the process is a copy of this one
/// (`gm_proc_fork`), in which the program is checked already; elsewhere it is a `gamma`
/// started with this command line and `--run-test=j`.
/// The tests that reach foreign code or assembly, which the interpreter cannot run, are
/// compiled into one native executable instead (unless `native_fallback` is off), as
/// `gamma run --backend=interp` does with such a program. Fails if that executable cannot
/// be built, reporting why.
run_interp_tests :: fn(s: ^sema.Sema, input: string, opts: driver.Options, cases: []const sema.TestCase, chosen: []const usize, bench: bool, report: ^Report) -> ?() needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    args := Env.args()
    cmd := list(string)
    cmd.push(load.executable())!
    cmd.push(args[1])!
    cmd.push("--run-test=")!
    cmd.extend(args[2..])!
    jobs := if bench { 1 } else { opts.jobs }
    roots := list(u32)
    for i in chosen { roots.push(entry_of(s, cases[i], bench))! }
    // Every test's code is prepared here once, rather than in each copy of this process.
    if not check.prepare_codegen(s, roots.items) { return null }
    ip := InProcess(s: s, input: input, opts: opts, entries: roots.items)
    native := list(u32)
    at := list(?usize)
    if opts.native_fallback {
        p := cgen.prog(s)
        for e in roots.items {
            if driver.needs_native(&p, e) {
                at.push(native.items.len)!
                native.push(e)!
            } else {
                at.push(null)!
            }
        }
    }
    if native.items.len is 0 {
        run_all(cmd.items, .Interp, null, &ip, cases, chosen, jobs, opts.timeout, null, report)
        return ()
    }
    buf: [4096]u8 = ---
    dir := fs.make_temp_dir(fs.temp_dir(), if bench { "gamma-bench-" } else { "gamma-test-" }, buf[..]) else {
        eprint("gamma: cannot create a temporary directory in `{}`\n", fs.temp_dir())
        return null
    }
    defer _ = fs.remove_all(dir)
    native_cmd := build_tests(s, opts, native.items, dir) else return null
    fallback := Fallback(cmd: native_cmd, at: at.items)
    run_all(cmd.items, .Interp, &fallback, &ip, cases, chosen, jobs, opts.timeout, null, report)
    return ()
}

/// The tests that run natively among tests that are otherwise interpreted: the command
/// that runs them, and for each test its position in that executable, or null if it is
/// interpreted.
Fallback :: struct {
    cmd: []const string
    at: []const ?usize
}

/// Runs the `j`th test: natively if `fallback` says so, else in the copy of this process
/// `forked` if one was started for it, else with `cmd`, which `selector` tells which test to
/// run.
launch :: fn(cmd: []const string, selector: Selector, fallback: ?^const Fallback, forked: ?Forked, j: usize, timeout: ?f64, cover_dir: ?string) -> Finished needs Alloc + Clock + Proc + Sys {
    if fb := fallback {
        if k := fb.at[j] { return run_exe(fb.cmd, .Native, k, timeout, cover_dir) }
    }
    if f := forked {
        if f.handle > 0 { return collect(process.Child(handle: f.handle), "a copy of gamma", f.started, timeout) }
    }
    return run_exe(cmd, selector, j, timeout, cover_dir)
}

/// Whether the `j`th test runs natively (`Fallback`).
natively :: fn(fallback: ?^const Fallback, j: usize) -> bool {
    fb := fallback else return false
    return fb.at[j] is not null
}

/// A copy of this process started to run a test (`fork_test`): its handle, or a negative
/// number if none could be started, and when, in nanoseconds of the clock.
Forked :: struct {
    handle: i64
    started: u64
}

/// Starts the `j`th test of `ip` in a copy of this process, returning the copy's handle
/// here. The copy runs the test and ends with its status. Called on the main thread, whose
/// stack (larger than other threads') the copy runs the test on.
fork_test :: fn(ip: ^const InProcess, j: usize) -> Forked needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    started := Clock.now().ns
    h := rt.gm_proc_fork()
    if h is not 0 { return Forked(handle: h, started: started) }
    status := driver.run_interp_entry(ip.s, ip.entries[j], ip.input, ip.opts)
    rt.gm_proc_fork_exit(i32(status))
    @unreachable()
}

/// How the command that runs the tests is told which test to run.
Selector :: union {
    /// The position is the argument after the command (the test executable).
    Native
    /// The position is the value of the command's argument `--run-test=` (the third).
    Interp
}

/// The file the `j`th test writes its coverage counters to.
cover_file :: fn(dir: string, j: usize) -> string needs Alloc => load.join(dir, str.format("coverage-{}", j)!)

/// What the threads that run tests share: the next test to take and the results so far.
Pool :: struct {
    cmd: []const string
    selector: Selector
    fallback: ?^const Fallback
    timeout: ?f64
    cover_dir: ?string
    /// Whether tests are run in copies of this process, which the main thread starts:
    /// a thread takes `fork_busy`, puts the test it wants a copy for in `fork_ask` and waits
    /// for the main thread to put the copy in `fork_answer`.
    forking: bool
    fork_busy: bool
    fork_ask: ?usize
    fork_answer: ?Forked
    /// The number of tests, and the next one to run.
    n: usize
    next: usize
    results: List(?Finished)
    lock: thread.Mutex
    ready: thread.Condvar
}

/// Runs the tests `chosen` of `cases` with the command `cmd`, `jobs` at a time, and hands
/// each result to `report` in the order of the tests, as soon as it and all before it are
/// done. The tests that `fallback` names run natively instead; with `ip`, the others run in
/// copies of this process where the system has them.
run_all :: fn(cmd: []const string, selector: Selector, fallback: ?^const Fallback, ip: ?^const InProcess, cases: []const sema.TestCase, chosen: []const usize, jobs: usize, timeout: ?f64, cover_dir: ?string, report: ^Report) needs Alloc + Clock + Env + Err + Fs + Out + Proc + Rand + Sys {
    n := chosen.len
    threads := list(thread.Thread)
    pool := Pool(cmd: cmd, selector: selector, fallback: fallback, timeout: timeout, cover_dir: cover_dir, forking: ip is not null, fork_busy: false, fork_ask: null, fork_answer: null, n: n, next: 0, results: list(?Finished), lock: thread.mutex(), ready: thread.condvar())
    if jobs > 1 and n > 1 {
        for _ in 0..n { pool.results.push(null)! }
        for _ in 0..(if jobs < n { jobs } else { n }) {
            t := thread.spawn(worker, &pool) else break
            threads.push(t)!
        }
    }
    if threads.items.len is 0 {
        for j in 0..n {
            forked: ?Forked = null
            if x := ip {
                if not natively(fallback, j) { forked = fork_test(x, j) }
            }
            report.record(cases[chosen[j]], launch(cmd, selector, fallback, forked, j, timeout, cover_dir))
        }
        return
    }
    for j in 0..n {
        thread.lock(&pool.lock)
        while pool.results.items[j] is null {
            if k := pool.fork_ask {
                if x := ip {
                    // The copy is made without the lock, which it would otherwise inherit.
                    pool.fork_ask = null
                    thread.unlock(&pool.lock)
                    f := fork_test(x, k)
                    thread.lock(&pool.lock)
                    pool.fork_answer = f
                    thread.broadcast(&pool.ready)
                    continue
                }
            }
            thread.wait(&pool.ready, &pool.lock)
        }
        f := pool.results.items[j] else @unreachable()
        thread.unlock(&pool.lock)
        report.record(cases[chosen[j]], f)
    }
    for t in threads.items { thread.join(t) }
}

/// A thread that takes tests in turn until none are left.
worker :: fn(p: ^Pool) needs Sys {
    with heap_allocator(), system_io(), system_output() {
        while true {
            thread.lock(&p.lock)
            j := p.next
            p.next += 1
            thread.unlock(&p.lock)
            if j >= p.n { break }
            forked: ?Forked = null
            if p.forking and not natively(p.fallback, j) { forked = ask_fork(p, j) }
            f := launch(p.cmd, p.selector, p.fallback, forked, j, p.timeout, p.cover_dir)
            thread.lock(&p.lock)
            p.results.items[j] = f
            thread.broadcast(&p.ready)
            thread.unlock(&p.lock)
        }
    }
}

/// Has the main thread start a copy of this process for the `j`th test, and waits for it.
ask_fork :: fn(p: ^Pool, j: usize) -> Forked needs Sys {
    thread.lock(&p.lock)
    while p.fork_busy { thread.wait(&p.ready, &p.lock) }
    p.fork_busy = true
    p.fork_ask = j
    thread.broadcast(&p.ready)
    while p.fork_answer is null { thread.wait(&p.ready, &p.lock) }
    f := p.fork_answer else @unreachable()
    p.fork_answer = null
    p.fork_busy = false
    thread.broadcast(&p.ready)
    thread.unlock(&p.lock)
    return f
}

test "selection by filter" {
    a := sema.TestCase(name: "parse digits", module: null, entry: 0)
    b := sema.TestCase(name: "other", module: "lib/json", entry: 1)
    expect(selected(a, null))
    expect(selected(a, "digits"))
    expect(not selected(a, "json"))
    expect(selected(b, "json"))
    expect(selected(b, "oth"))
    expect(not selected(b, "digits"))
}
