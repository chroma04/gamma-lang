//! The driver: what gammac's commands share beyond the stages of the compiler.
//!

//! The command line of gammac: the commands and their options.

diag :: import "../diag"
lint :: import "../lint"
pkg :: import "../pkg"

/// What gammac was asked to do.
pub Command :: union { Lex, Parse, Modules, Decls, Tir, Check, Lint, Fix, Build, Run, Test, Bench }

/// The build modes of §1.4 that gammac has (Safe needs Fil-C).
pub Mode :: union { Debug, Checked, Fast }

pub Options :: struct {
    pub command: Command
    pub format: diag.Format = .Human
    pub recover: bool = false
    pub dump: bool = false
    /// `build`, `run`: the build mode.
    pub mode: Mode = .Debug
    /// `build`: the executable, and whether to stop after writing C.
    pub out: ?string = null
    pub emit_c: bool = false
    /// `build`, `run`: add debug information that maps the executable back to the Gamma
    /// source (`-g`).
    pub debug_info: bool = false
    /// Whether `-g` was given, which wins over the manifest's `debug-info`.
    pub debug_info_given: bool = false
    /// `run`: the arguments after the file, for the program.
    pub program_args: []const string = empty_slice(string)
    /// `test`, `bench`: only the tests whose name or module path contains this text.
    pub filter: ?string = null
    /// `test`, `bench`: also the tests of the modules of the package that nothing imports.
    pub all: bool = false
    /// `test`, `bench`: also print the output of the tests that pass.
    pub show_output: bool = false
    /// `test`: how many tests run at once (never 0).
    pub jobs: usize = 1
    /// `test`, `bench`: the longest a test may run, in seconds.
    pub timeout: ?f64 = null
    /// `test`, `bench`: print how long each test took and the total.
    pub time: bool = false
    /// `test`, `bench`: test the dependency of this name instead of the input's package.
    pub package: ?string = null
    /// `check`, `build`, `run`: never use the network for dependencies (`--offline`), fail
    /// if `gamma.lock` is not up to date (`--locked`), and the `[profile.NAME]` to use.
    pub offline: bool = false
    pub locked: bool = false
    pub profile: ?string = null
    /// Whether `--mode` was given, which wins over the manifest's `mode`.
    pub mode_given: bool = false
    /// `build`, `run`: the `cflags` and `ldflags` of the root package's `gamma.toml`.
    pub manifest_cflags: []const string = empty_slice(string)
    pub manifest_ldflags: []const string = empty_slice(string)
    /// `build`, `run`: the C sources and libraries the packages add to the build.
    pub extras: ?pkg.Extras = null
    /// `lint`: the options of the command.
    pub lint: lint.Options
}

/// The name of a mode as `target.mode` spells it.
pub mode_name :: fn(m: Mode) -> string => match m {
    .Debug => "Debug"
    .Checked => "Checked"
    .Fast => "Fast"
}
