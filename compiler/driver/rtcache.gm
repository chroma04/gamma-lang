//! The cache of compiled runtimes and of built programs.
//!
//! Compiling the runtime is most of the work of compiling a small program, so Debug builds
//! (and Safe ones) link with a runtime object compiled once. Objects are kept in the cache
//! directory (`pkg.cache_dir`) under a name derived from everything that affects them: the
//! runtime's source, the C compiler (its command with its arguments, `CFLAGS` and its
//! `--version` output) and the flags.
//!
//! `cached_program` keeps whole executables in `run/` under a key that covers everything
//! that affects them, for `gamma run`; the most recent few are kept.
//!
//! Concurrent builds may compile the same object at once: each writes a file of its own and
//! renames it into place, so a reader never sees a partial object.

arena :: import "std/arena"
cgen :: import "../cgen"
fs :: import "std/fs"
load :: import "../load"
pkg :: import "../pkg"
process :: import "std/process"
str :: import "std/str"

/// How many executables `gamma run` keeps; older ones are removed.
KEPT_PROGRAMS :: 32

NS_PER_SECOND :: 1_000_000_000

/// A 16-digit key for `parts`: the start of their SHA-256, each part preceded by its length.
cache_key :: fn(parts: []const string) -> string needs Alloc {
    buf := list(u8)
    defer buf.deinit()
    for p in parts { buf.write("{}:{}", p.len, p)! }
    return pkg.sha256_hex(buf.items)[0..16]
}

/// The first line of the output of `<compiler> --version` (all of its standard output), or
/// `null` if the compiler cannot be run.
compiler_version :: fn(tc: ^const pkg.Toolchain) -> ?string needs Alloc + Proc {
    argv := list(string)
    argv.extend(tc.cc)!
    argv.push("--version")!
    r := pkg.run(argv.items)
    if not r.ok { return null }
    return r.out
}

/// The object of the C file `source` compiled with `tc` and `flags`, kept in the cache under
/// a name starting with `prefix`; compiled now if it is not there. `compiler` is the
/// compiler's `compiler_version`. `null` if there is no cache, no version, or the object
/// cannot be made.
runtime_object :: fn(tc: ^const pkg.Toolchain, flags: []const string, source: string, prefix: string, compiler: ?string) -> ?string needs Alloc + Env + Fs + Proc + Rand {
    dir := pkg.cache_dir() else return null
    version := compiler else return null
    key := cache_key([6]string("gammac", source, str.join(tc.cc, "\0")!, str.join(tc.cflags, "\0")!, str.join(flags, "\0")!, version)[..])
    stem := str.format("{}-{}", prefix, key)!
    obj := load.join(dir, str.format("{}.o", stem)!)
    if load.is_file(obj) {
        // Mark it as recently used, so the cache cleaner keeps it.
        touch(obj)
        return obj
    }
    pkg.make_dirs(dir) else return null
    // The source stays next to the object (a debugger reads it); writing it is idempotent
    // but goes through a private file too, so a concurrent build never compiles a partial one.
    c_file := load.join(dir, str.format("{}.c", stem)!)
    if not load.is_file(c_file) {
        tmp := private_name(dir, stem, "c")
        fs.write_all(tmp, source) else return null
        rename_or_remove(tmp, c_file) else return null
    }
    tmp := private_name(dir, stem, "o")
    tail := [4]string("-c", "-o", tmp, c_file)
    argv := pkg.command(tc, flags, tail[..])
    if not pkg.run(argv.items).ok {
        _ = Fs.remove(tmp)
        return null
    }
    rename_or_remove(tmp, obj) else return null
    return obj
}

/// A file name in `dir` no other process or thread uses.
private_name :: fn(dir, stem, ext: string) -> string needs Alloc + Rand {
    r: [8]u8 = ---
    Rand.fill(r[..])
    return load.join(dir, str.format("{}.tmp-{}.{}", stem, pkg.hex(r[..]), ext)!)
}

/// Renames `from` to `to` (replacing it), removing `from` if that fails. `null` if it fails.
rename_or_remove :: fn(from, to: string) -> ?() needs Fs {
    Fs.rename(from, to) else {
        _ = Fs.remove(from)
        return null
    }
    return ()
}

/// Sets the modification time of the cached file `p` to now, so the cache cleaner keeps it.
/// (The standard library has no call for it, so the `touch` program does it.)
touch :: fn(p: string) needs Alloc + Proc {
    argv := [3]string("touch", "-c", p)
    _ = pkg.run(argv[..])
}

/// An executable in the cache of programs, with the time it was last used.
CachedProgram :: struct {
    modified: i64
    path: string
}

/// Removes all but the most recently used `KEPT_PROGRAMS` executables in `dir`, sparing any
/// used in the last ten minutes (another process may be about to run it), and the leftovers
/// of builds that died, which are over an hour old.
prune :: fn(dir: string) needs Alloc + Clock + Fs {
    now := Clock.wall()
    stale := now - 3600 * NS_PER_SECOND
    progs := list(CachedProgram)
    for r in fs.entries(dir) {
        e := r else break
        if not e.name.starts_with("prog-") { continue }
        p := load.join(dir, e.name)
        info := Fs.lstat(p) else continue
        if str.contains(e.name, ".tmp-") {
            if info.modified < stale { _ = Fs.remove(p) }
            continue
        }
        progs.push(CachedProgram(modified: info.modified, path: p))!
    }
    if progs.items.len <= KEPT_PROGRAMS { return }
    // Oldest first, by time and then name.
    n := progs.items.len
    for i in 1..n {
        j := i
        while j > 0 and (progs.items[j - 1].modified > progs.items[j].modified or (progs.items[j - 1].modified is progs.items[j].modified and progs.items[j - 1].path > progs.items[j].path)) {
            tmp := progs.items[j - 1]
            progs.items[j - 1] = progs.items[j]
            progs.items[j] = tmp
            j -= 1
        }
    }
    recent := now - 600 * NS_PER_SECOND
    for i in 0..(n - KEPT_PROGRAMS) {
        if progs.items[i].modified < recent { _ = Fs.remove(progs.items[i].path) }
    }
}

/// How many unit objects (and their sources) the cache keeps; the least recently used
/// beyond that are removed.
KEPT_UNITS :: 4000

/// The objects of the translation units `sources` of a split build, compiled with `tc` and
/// `flags` (`compiler` is the compiler's `compiler_version`), from the cache: each unit is
/// kept under a name derived from its text, the compiler and the flags, so a unit whose
/// text an edit left unchanged is not compiled again. The others are compiled into the
/// cache, `jobs` at a time. With `line_paths`, each source is first given the name of its
/// cached file for its `#line` directives (see `cgen.resolve_lines`). `.NoCache` if there
/// is no cache or no compiler version; `.Failed` (reported) if a unit does not compile.
unit_objects :: fn(tc: ^const pkg.Toolchain, flags: []const string, sources: []const string, compiler: ?string, jobs: usize, line_paths: bool) -> UnitObjects needs Alloc + Clock + Env + Err + Fs + Proc + Rand + Sys {
    dir := pkg.cache_dir() else return .NoCache
    version := compiler else return .NoCache
    pkg.make_dirs(dir) else return .NoCache
    cc := str.join(tc.cc, "\0")!
    cflags := str.join(tc.cflags, "\0")!
    fl := str.join(flags, "\0")!
    objects := list(string)
    todo_c := list(string)
    todo_tmp := list(string)
    todo_obj := list(string)
    day := Clock.wall() - 86400 * NS_PER_SECOND
    for src in sources {
        key := cache_key([6]string("unit", src, cc, cflags, fl, version)[..])
        stem := load.join(dir, str.format("unit-{}", key)!)
        obj := str.format("{}.o", stem)!
        objects.push(obj)!
        if info := Fs.stat(obj) {
            // Mark it as used now and then, so the pruning keeps it.
            if info.modified < day { touch(obj) }
            continue
        }
        c_file := str.format("{}.c", stem)!
        text: string = if line_paths { cgen.resolve_lines(src, c_file) } else { src }
        tmp_c := private_name(dir, str.format("unit-{}", key)!, "c")
        fs.write_all(tmp_c, text) else return .NoCache
        rename_or_remove(tmp_c, c_file) else return .NoCache
        todo_c.push(c_file)!
        todo_tmp.push(private_name(dir, str.format("unit-{}", key)!, "o"))!
        todo_obj.push(obj)!
    }
    if todo_c.items.len > 0 {
        if not compile_objects(tc, flags, todo_c.items, todo_tmp.items, jobs) {
            for o in todo_tmp.items { _ = Fs.remove(o) }
            return .Failed
        }
        for i, tmp in enumerate(todo_tmp.items) { rename_or_remove(tmp, todo_obj.items[i]) else return .Failed }
        prune_units(dir)
    }
    return .Objects(objects.items)
}

/// What `unit_objects` found.
UnitObjects :: union {
    Objects: []const string
    NoCache
    Failed
}

/// Removes all but the most recently used `KEPT_UNITS` unit objects of `dir`, with their
/// sources, and the leftovers of builds that died, which are over an hour old.
prune_units :: fn(dir: string) needs Alloc + Clock + Fs {
    now := Clock.wall()
    stale := now - 3600 * NS_PER_SECOND
    objs := list(CachedProgram)
    for r in fs.entries(dir) {
        e := r else break
        if not e.name.starts_with("unit-") { continue }
        p := load.join(dir, e.name)
        info := Fs.lstat(p) else continue
        if str.contains(e.name, ".tmp-") {
            if info.modified < stale { _ = Fs.remove(p) }
            continue
        }
        if e.name.ends_with(".o") { objs.push(CachedProgram(modified: info.modified, path: p))! }
    }
    for o in units_to_prune(objs.items, now) {
        _ = Fs.remove(o)
        _ = Fs.remove(str.format("{}.c", o[0..o.len - 2])!)
    }
}

/// The unit objects of `objs` beyond the `KEPT_UNITS` most recently used, at time `now`.
/// An object used in the last day is never among them, however many there are: builds
/// running at the same time share the cache, and one may be about to link an object it
/// found there (a build marks an object it uses when the object is older than a day, see
/// `unit_objects`).
units_to_prune :: fn(objs: []CachedProgram, now: i64) -> []const string needs Alloc {
    out := list(string)
    if objs.len <= KEPT_UNITS { return out.items }
    objs.sort_by(fn(a, b: ^const CachedProgram) -> bool => a.modified < b.modified or (a.modified is b.modified and a.path < b.path))
    recent := now - 86400 * NS_PER_SECOND
    for i in 0..(objs.len - KEPT_UNITS) {
        if objs[i].modified >= recent { break }
        out.push(objs[i].path)!
    }
    return out.items
}

test "unit objects used in the last day are kept" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        now: i64 = 10 * 86400 * NS_PER_SECOND
        objs := list(CachedProgram)
        // Two objects more than are kept: an old one, and the rest used just now.
        objs.push(CachedProgram(modified: 0, path: "old.o"))!
        for i in 0..(KEPT_UNITS + 1) { objs.push(CachedProgram(modified: now - i64(i), path: "new.o"))! }
        pruned := units_to_prune(objs.items, now)
        expect_eq(pruned.len, 1)
        expect_eq(pruned[0], "old.o")
        expect_eq(units_to_prune(objs.items[0..KEPT_UNITS], now).len, 0)
    }
}

/// Whether `version`, a compiler's `compiler_version`, is that of gcc (which clang's is
/// not, though clang accepts most of gcc's options).
is_gcc :: fn(version: ?string) -> bool {
    v := version else return false
    return str.contains(v, "Free Software Foundation") and not str.contains(v, "clang")
}

test "gcc is told apart by its version" {
    expect(is_gcc("cc (Ubuntu 13.3.0-6ubuntu2~24.04) 13.3.0\nCopyright (C) 2023 Free Software Foundation, Inc.\n"))
    expect(is_gcc("x86_64-w64-mingw32-gcc (GCC) 12-win32\nCopyright (C) 2022 Free Software Foundation, Inc.\n"))
    expect(not is_gcc("Ubuntu clang version 18.1.3 (1ubuntu1)\nTarget: x86_64-pc-linux-gnu\n"))
    expect(not is_gcc("Apple clang version 15.0.0 (clang-1500.3.9.4)\n"))
    expect(not is_gcc(null))
}
