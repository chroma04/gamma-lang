// Expressions, places and coercions.
//
// `expr` emits the statements an expression needs and returns a C expression for its
// value (usually a temporary). Operands are evaluated into temporaries in order, so
// evaluation order is the program's.

ratio :: import "../ratio"

/// A value computed into a C expression, with its type.
ValTy :: struct {
    v: string
    ty: Ty
}

/// A piece of a value (offset and size) that is about to be stored.
BlobPart :: struct {
    off: u64
    len: u64
}

ptr_bytes :: fn(fg: ^FnGen) -> u64 => fg.g.ty.lay.target.ptr_bytes

/// Whether `v` names a temporary (`t` and a number). A temporary holds the value of one
/// expression and is not assigned once that value is computed, so it can stand for the
/// value wherever the value is read: its address needs no copy.
is_temp :: fn(v: string) -> bool {
    if v.len < 2 or v[0] is not 't' { return false }
    for b in v[1..] {
        if b < '0' or b > '9' { return false }
    }
    return true
}

/// The `uint8_t *` address of value `v` (of type `t`): of `v` itself if it is a
/// temporary or a view of one (see `load`), else of a copy.
addr_of :: fn(fg: ^FnGen, t: Ty, v: string) -> string needs sema.Load {
    if is_temp(v) { return str.format("((uint8_t *)&{})", v)! }
    if a := view_addr(v) { return a }
    n := fg.tmp(t, v)
    return str.format("((uint8_t *)&{})", n)!
}

/// A piece of a temporary: its name and the offset of the piece.
TempPiece :: struct {
    name: string
    off: u64
}

/// The temporary and offset that address `a` points at, if it is the address of a
/// temporary (`((uint8_t *)&t5)`) plus constant offsets, as `addr_of` and the offsets
/// of fields and payloads write it: `((((uint8_t *)&t5) + 8) + 16)` is `t5` at 24.
temp_piece :: fn(a: string) -> ?TempPiece {
    base := "((uint8_t *)&"
    if a.starts_with(base) and a.len > base.len and a[a.len - 1] is ')' {
        n := a[base.len..a.len - 1]
        if is_temp(n) { return TempPiece(name: n, off: 0) }
        return null
    }
    // `(X + K)`: the offset is the digits after the last ` + `.
    if a.len < 2 or a[0] is not '(' or a[a.len - 1] is not ')' { return null }
    inner := a[1..a.len - 1]
    i := inner.len
    while i > 0 and inner[i - 1] >= '0' and inner[i - 1] <= '9' { i -= 1 }
    if i is inner.len or i < 3 or not (inner[i - 3..i] is " + ") { return null }
    k: u64 = 0
    for c in inner[i..] { k = k * 10 + u64(c - '0') }
    p := temp_piece(inner[0..i - 3]) else return null
    return TempPiece(name: p.name, off: p.off + k)
}

/// The address of the piece of a temporary that `v` is a view of (see `load`).
view_addr :: fn(v: string) -> ?string {
    // `(*(C *)(((uint8_t *)&tN) + K))`
    if not v.starts_with("(*(") { return null }
    mark := " *)(((uint8_t *)&t"
    i: usize = 3
    while i + mark.len <= v.len and not (v[i..i + mark.len] is mark) { i += 1 }
    if i + mark.len > v.len { return null }
    a := v[i + 3..v.len - 1]
    if temp_piece(a) is null { return null }
    return a
}

/// Loads a value of type `t` from address `a`.
///
/// A large value inside a temporary is not copied: the result is a view of it, an lvalue
/// `(*(C *)(((uint8_t *)&t5) + 8))` (a temporary is not assigned once computed, so the
/// view reads what a copy would hold). The offsets of a temporary's pieces follow its
/// layout, so the view is aligned for `C`.
pub load :: fn(fg: ^FnGen, t: Ty, a: string) -> string needs sema.Load {
    c := fg.g.ty.cty(t)
    if fg.g.ty.by_ref(t) {
        if p := temp_piece(a) {
            if p.off % fg.g.ty.align(t) is 0 { return str.format("(*({} *)(((uint8_t *)&{}) + {}))", c, p.name, p.off)! }
        }
    }
    ld := str.format("GM_LD({}, {})", c, a)!
    // Padding bits of a narrow integer in memory are unspecified; ignore them.
    if ii := fg.int_info(t) {
        v := normalize(ii, ld)
        return fg.tmp(t, v)
    }
    return fg.tmp(t, ld)
}

/// A zero-filled blob temporary of type `t`.
blob :: fn(fg: ^FnGen, t: Ty) -> string needs sema.Load {
    n := fg.tmp_uninit(t)
    fg.linef("memset(&{}, 0, sizeof {});", n, n)
    return n
}

/// A blob temporary of type `t` whose bytes outside `parts` (offset and size of each
/// piece the caller is about to store) are zero. In a Debug build, a small value with
/// several gaps is cleared whole with `memset`: one statement instead of a store per gap,
/// for the C compiler to get through faster. Otherwise only the gaps are cleared, which
/// writes less (an optimized build runs a few percent faster that way) and, under Fil-C,
/// avoids `memset`, a call into its runtime.
blob_over :: fn(fg: ^FnGen, t: Ty, parts: []const BlobPart) -> string needs sema.Load {
    n := fg.tmp_uninit(t)
    fg.clear_outside(t, n, parts)
    return n
}

/// Clears the bytes of `dest`, a C lvalue of type `t`, outside `parts`, as `blob_over`
/// does for its temporary; `dest` is cleared whole where that is cheaper, so the parts
/// are stored after this.
clear_outside :: fn(fg: ^FnGen, t: Ty, dest: string, parts: []const BlobPart) needs sema.Load {
    size := fg.g.ty.size(t).trunc(usize)
    covered := list(bool)
    for _ in 0..size { covered.push(false)! }
    for p in parts {
        i := p.off.trunc(usize)
        end := (p.off + p.len).trunc(usize)
        while i < end and i < size {
            covered.items[i] = true
            i += 1
        }
    }
    gaps: usize = 0
    for c in covered.items {
        if not c { gaps += 1 }
    }
    if gaps > 32 {
        fg.linef("memset(&{}, 0, sizeof {});", dest, dest)
        return
    }
    stores := list((at: usize, len: usize))
    i: usize = 0
    while i < size {
        if covered.items[i] {
            i += 1
            continue
        }
        // The largest aligned piece of the gap at `i`.
        sizes := [4]usize(8, 4, 2, 1)
        k: usize = 1
        for s in sizes {
            if i % s is 0 and i + s <= size {
                all_free := true
                for j in i..i + s {
                    if covered.items[j] { all_free = false }
                }
                if all_free {
                    k = s
                    break
                }
            }
        }
        stores.push((at: i, len: k))!
        i += k
    }
    if fg.g.opts.debug and stores.items.len > 1 and size <= MAX_MEMSET_CLEAR and not fg.g.ty.lay.target.filc {
        fg.linef("memset(&{}, 0, sizeof {});", dest, dest)
        return
    }
    for st in stores.items { fg.linef("GM_ST(uint{}_t, (uint8_t *)&{} + {}, 0);", st.len * 8, dest, st.at) }
}

/// The size up to which `blob_over` clears a value with several gaps whole.
MAX_MEMSET_CLEAR :: 64

store :: fn(fg: ^FnGen, t: Ty, addr: string, v: string) needs sema.Load {
    c := fg.g.ty.cty(t)
    fg.linef("GM_ST({}, {}, {});", c, addr, v)
}

loc :: fn(fg: ^FnGen, e: ^Expr) -> string needs Alloc => fg.g.src_loc(e.span)

// --- optionals, results, unions ---------------------------------------------------------------

/// A C condition: the optional at `addr` (of type `t`) is present.
opt_present :: fn(fg: ^FnGen, t: Ty, addr: string) -> string needs sema.Load {
    if fg.g.ty.repr(t) is .Ptr { return str.format("(GM_LD(void *, {}) != 0)", addr)! }
    off := fg.g.ty.offsets(t)[1]
    return str.format("(({})[{}] != 0)", addr, off)!
}

make_some :: fn(fg: ^FnGen, t: Ty, payload: string) -> string needs sema.Load {
    if fg.g.ty.repr(t) is .Ptr { return payload }
    .Optional(inner) := fg.g.ty.kind(t) else @unreachable()
    off := fg.g.ty.offsets(t)[1]
    parts := [2]BlobPart(BlobPart(off: 0, len: fg.g.ty.size(inner)), BlobPart(off: off, len: 1))
    b := fg.blob_over(t, parts[..])
    fg.store(inner, str.format("((uint8_t *)&{})", b)!, payload)
    fg.linef("((uint8_t *)&{})[{}] = 1;", b, off)
    return b
}

make_none :: fn(fg: ^FnGen, t: Ty) -> string needs sema.Load {
    if fg.g.ty.repr(t) is .Ptr { return "((void *)0)" }
    return fg.blob(t)
}

/// The tag byte of the result at `addr` is set: it holds an error.
res_is_err :: fn(fg: ^FnGen, t: Ty, addr: string) -> string needs sema.Load {
    off := fg.g.ty.offsets(t)[0]
    return str.format("(({})[{}] != 0)", addr, off)!
}

make_res :: fn(fg: ^FnGen, t: Ty, is_err: bool, payload_ty: Ty, payload: string) -> string needs sema.Load {
    offs := fg.g.ty.offsets(t)
    parts := [2]BlobPart(BlobPart(off: offs[0], len: 1), BlobPart(off: offs[1], len: fg.g.ty.size(payload_ty)))
    b := fg.blob_over(t, parts[..])
    fg.linef("((uint8_t *)&{})[{}] = {};", b, offs[0], if is_err { 1 } else { 0 })
    fg.store(payload_ty, str.format("((uint8_t *)&{} + {})", b, offs[1])!, payload)
    return b
}

/// A union value of variant `v` with an optional payload.
make_variant :: fn(fg: ^FnGen, t: Ty, v: usize, payload: ?string) -> string needs sema.Load {
    def := fg.adt_def(t)
    .Union(tag, variants) := def.kind else @unreachable()
    variant := variants[v]
    offs := fg.g.ty.offsets(t)
    parts := list(BlobPart)
    parts.push(BlobPart(off: offs[0], len: fg.g.ty.size(tag)))!
    if payload is not null {
        if pt := variant.payload { parts.push(BlobPart(off: offs[1], len: fg.g.ty.size(pt)))! }
    }
    b := fg.blob_over(t, parts.items)
    tag_val := fg.int_lit(tag, variant.tag)
    fg.store(tag, str.format("((uint8_t *)&{} + {})", b, offs[0])!, tag_val)
    if p := payload {
        if pt := variant.payload { fg.store(pt, str.format("((uint8_t *)&{} + {})", b, offs[1])!, p) }
    }
    return b
}

adt_def :: fn(fg: ^FnGen, t: Ty) -> ^const sema.AdtInfo => fg.g.ty.adt_of(t)

// --- literals ---------------------------------------------------------------------------------

/// A C literal of integer type `t` with value `v` (floats accept integer literals too).
int_lit :: fn(fg: ^FnGen, t: Ty, v: bigint.Int) -> string needs sema.Load {
    match fg.g.ty.repr(t) {
        .Float(f) => return float_lit(f, ratio.to_f64(ratio.from_int(v)))
        .Int(signed, _, storage) => {
            c := int_cty(signed, storage)
            lo, hi := split_u128(v)
            if storage is 16 {
                return str.format("(({})(((unsigned __int128){}u << 64) | {}u))", c, hi.trunc(u64), lo.trunc(u64))!
            } else if signed {
                x := v.to_i128() else i128(0)
                if x is -9223372036854775808 { return str.format("(({})(-9223372036854775807LL - 1))", c)! }
                return str.format("(({}){}LL)", c, x)!
            } else {
                return str.format("(({}){}ULL)", c, lo.trunc(u64))!
            }
        }
        .Bool => return if v.is_zero() { "0" } else { "1" }
        .Ptr => {
            lo, _ := split_u128(v)
            return str.format("((void *)(uintptr_t){}ULL)", lo.trunc(u64))!
        }
        _ => return "0"
    }
}

/// A slice value `{ptr, len}` of type `t`.
make_slice :: fn(fg: ^FnGen, t: Ty, ptr: string, len: string) -> string needs sema.Load {
    b := fg.tmp_uninit(t)
    p := fg.ptr_bytes()
    fg.linef("GM_ST(void *, (uint8_t *)&{}, (void *)({}));", b, ptr)
    fg.linef("GM_ST(uintptr_t, (uint8_t *)&{} + {}, (uintptr_t)({}));", b, p, len)
    return b
}

slice_ptr :: fn(addr: string) -> string needs sema.Load => str.format("GM_LD(void *, {})", addr)!

slice_len :: fn(fg: ^FnGen, addr: string) -> string needs sema.Load => str.format("GM_LD(uintptr_t, {} + {})", addr, fg.ptr_bytes())!

// --- expressions ------------------------------------------------------------------------------

/// Field `index` of the value `v` of `#bits` struct type `t`.
bits_get :: fn(fg: ^FnGen, t: Ty, v: string, index: u32) -> string needs sema.Load {
    bl := fg.g.ty.bits_layout(t)?
    f := bl.fields[usize(index)]
    a := fg.addr_of(t, v)
    uc := fg.g.ty.cty(bl.int_ty)
    raw := str.format("((((unsigned __int128)GM_LD({}, {})) >> {}) & {})", uc, a, f.off, mask(f.width))!
    raw2 := fg.tmp(fg.g.ty.int_ty(false, 128), raw)
    return fg.bits_value(f.ty, raw2)
}

/// The value `whole` of `#bits` struct type `t` with field `index` set to `v` (of type
/// `vt`).
bits_set :: fn(fg: ^FnGen, t: Ty, whole: string, index: u32, vt: Ty, v: string) -> string needs sema.Load {
    bl := fg.g.ty.bits_layout(t)?
    f := bl.fields[usize(index)]
    a := fg.addr_of(t, whole)
    uc := fg.g.ty.cty(bl.int_ty)
    raw := fg.bits_raw(vt, v)
    m := mask(f.width)
    b := fg.blob(t)
    fg.linef("GM_ST({}, (uint8_t *)&{}, ({})(((unsigned __int128)GM_LD({}, {}) & ~({} << {})) | ((({}) & {}) << {})));", uc, b, uc, uc, a, m, f.off, raw, m, f.off)
    return b
}

/// The value of `#bits` struct type `t` of the fields `vals` (of types `tys`).
bits_pack :: fn(fg: ^FnGen, t: Ty, tys: []const Ty, vals: []const string) -> string needs sema.Load {
    bl := fg.g.ty.bits_layout(t)?
    acc := fg.tmp(fg.g.ty.int_ty(false, 128), "0")
    for i in 0..vals.len {
        f := bl.fields[i]
        raw := fg.bits_raw(tys[i], vals[i])
        fg.linef("{} |= (({}) & {}) << {};", acc, raw, mask(f.width), f.off)
    }
    b := fg.blob(t)
    uc := fg.g.ty.cty(bl.int_ty)
    fg.linef("GM_ST({}, (uint8_t *)&{}, ({}){});", uc, b, uc, acc)
    return b
}

/// Where formatted output goes.
WriteTo :: union {
    /// An operation taking `[]const u8` (`Out.write`).
    Perform: (effect_: EffectRef, op: u32)
    /// A second-class function value; `direct` names the function literal it is, which is
    /// called directly.
    Fn: (v: ValTy, direct: ?string)
}

/// Formatted output of the template `pieces`/`specs` with the values at the addresses
/// `vals` (of types `tys`) to `sink`; traps report `span`.
write_values :: fn(fg: ^FnGen, span: source.Span, sink: WriteTo, pieces: []const []const u8, specs: []const tir.FmtSpec, tys: []const Ty, vals: []const string) -> Unsup!string needs sema.Load {
    str_ty := fg.g.ty.string_ty()
    unit_ty := fg.g.ty.unit_ty()
    // A write to the ambient output or error is one call per piece.
    stub: ?string = null
    match sink {
        .Perform(effect_, op) => {
            id := fg.g.effect_id(&effect_)
            stub_tys := [1]Ty(str_ty)
            stub = fg.out_stub(&effect_, id, op, stub_tys[..], unit_ty)
        }
        .Fn(_) => {}
    }
    if .Fn(cv, ?direct) := sink and not fg.g.ty.by_ref(str_ty) {
        // A write to a function: the closure and its handler context once, then a call of
        // a shared helper per piece.
        .Fn(sig) := fg.g.ty.kind(cv.ty) else @unreachable()
        c := fg.tmp(cv.ty, cv.v)
        ccx := str.format("ccx{}", fg.fresh())!
        fg.linef("gm_node *{} = {}.cx;", ccx, c)
        for eff in sig.effects.effects {
            id := fg.g.effect_id(&eff)
            n := str.format("cn{}", fg.fresh())!
            fg.linef("gm_node {}; {{ gm_node *f = gm_find({}, {}); if (f) {{ {} = *f; {}.next = {}; {} = &{}; }} }}", n, fg.cx, id, n, n, ccx, ccx, n)
        }
        fs := fg.fn_sink_stub(str_ty)
        ff := fg.fn_format_stub(fs)
        for i in 0..pieces.len {
            if pieces[i].len > 0 {
                if d := direct {
                    sl := fg.make_slice(str_ty, fg.g.static_bytes(pieces[i]), str.format("{}", pieces[i].len)!)
                    fg.linef("{}({}.env, {}, NULL, {});", d, c, ccx, sl)
                    fg.check_unwind()
                } else {
                    fg.unwind_call(str.format("{}({}.code, {}.env, {}, {}, {})", fs, c, c, ccx, fg.g.static_bytes(pieces[i]), pieces[i].len)!)
                }
            }
            if i < tys.len {
                spec := "NULL"
                if sp := specs.get(i) {
                    if not tir.is_default_spec(&sp) { spec = str.format("&{}", spec_literal(sp))! }
                }
                a := vals[i]
                if spec is "NULL" and tys[i] is str_ty and direct is not null {
                    // A string is written as it is, unless it is empty.
                    p := fg.ptr_bytes()
                    fg.linef("if (GM_LD(uintptr_t, {} + {}) != 0) {{", a, p)
                    fg.indent += 1
                    fg.linef("{}({}.env, {}, NULL, GM_LD({}, {}));", direct?, c, ccx, fg.g.ty.cty(str_ty), a)
                    fg.check_unwind()
                    fg.indent -= 1
                    fg.line("}")
                } else if spec is "NULL" and tys[i] is str_ty {
                    // A string is written as it is, unless it is empty.
                    p := fg.ptr_bytes()
                    fg.unwind_call(str.format("(GM_LD(uintptr_t, {} + {}) != 0 && {}({}.code, {}.env, {}, GM_LD(void *, {}), GM_LD(uintptr_t, {} + {})))", a, p, fs, c, c, ccx, a, a, p)!)
                } else {
                    fg.unwind_call(str.format("{}({}.code, {}.env, {}, {}, {}, {})", ff, c, c, ccx, fg.g.ty.desc(tys[i]), a, spec)!)
                }
            }
        }
        return fg.unit()
    }
    if core := stub {
        ps := fg.piece_stub(core, 's', str_ty)
        pf := fg.piece_stub(core, 'f', str_ty)
        at := fg.g.src_loc(span)
        for i in 0..pieces.len {
            if pieces[i].len > 0 {
                s := fg.g.static_bytes(pieces[i])
                fg.unwind_call(str.format("{}({}, {}, {}, {})", ps, fg.cx, s, pieces[i].len, at)!)
            }
            if i < tys.len {
                d := fg.g.ty.desc(tys[i])
                custom: ?tir.FmtSpec = null
                if sp := specs.get(i) {
                    if not tir.is_default_spec(&sp) { custom = sp }
                }
                if sp := custom {
                    b := str.format("b{}", fg.fresh())!
                    c := spec_literal(sp)
                    fg.linef("gm_buf {} = {{0}};", b)
                    fg.linef("gm_format_spec(&{}, {}, {}, &{});", b, d, vals[i], c)
                    try fg.emit_buf(sink, b, span)
                } else if tys[i] is str_ty {
                    // A string is written as it is, unless it is empty.
                    a := vals[i]
                    p := fg.ptr_bytes()
                    fg.unwind_call(str.format("(GM_LD(uintptr_t, {} + {}) != 0 && {}({}, GM_LD(void *, {}), GM_LD(uintptr_t, {} + {}), {}))", a, p, ps, fg.cx, a, a, p, at)!)
                } else {
                    fg.unwind_call(str.format("{}({}, {}, {}, {})", pf, fg.cx, d, vals[i], at)!)
                }
            }
        }
        return fg.unit()
    }
    for i in 0..pieces.len {
        if pieces[i].len > 0 {
            s := fg.g.static_bytes(pieces[i])
            sl := fg.make_slice(str_ty, s, str.format("{}", pieces[i].len)!)
            try fg.emit_to(sink, sl, span)
        }
        if i < tys.len {
            d := fg.g.ty.desc(tys[i])
            b := str.format("b{}", fg.fresh())!
            fg.linef("gm_buf {} = {{0}};", b)
            custom: ?tir.FmtSpec = null
            if sp := specs.get(i) {
                if not tir.is_default_spec(&sp) { custom = sp }
            }
            if sp := custom {
                c := spec_literal(sp)
                fg.linef("gm_format_spec(&{}, {}, {}, &{});", b, d, vals[i], c)
            } else {
                fg.linef("gm_format(&{}, {}, {}, true);", b, d, vals[i])
            }
            try fg.emit_buf(sink, b, span)
        }
    }
    return fg.unit()
}

/// `write_values` with the template `tv`, a `gm_tmpl` known only when the write runs.
write_table_values :: fn(fg: ^FnGen, span: source.Span, sink: WriteTo, tv: string, tys: []const Ty, vals: []const string) -> Unsup!string needs sema.Load {
    str_ty := fg.g.ty.string_ty()
    ptrs := list(string)
    descs := list(string)
    strs := list(string)
    for i in 0..tys.len {
        ptrs.push(str.format("(const void *)({})", vals[i])!)!
        descs.push(fg.g.ty.desc(tys[i]))!
        strs.push(if tys[i] is str_ty { "1" } else { "0" })!
    }
    k := fg.fresh()
    t := str.format("tp{}", k)!
    fg.linef("const gm_tmpl *{} = (const gm_tmpl *)({});", t, tv)
    if tys.len > 0 {
        fg.linef("const void *vp{}[] = {{{}}};", k, str.join(ptrs.items, ", ")!)
        fg.linef("const gm_type *vd{}[] = {{{}}};", k, str.join(descs.items, ", ")!)
        fg.linef("static const uint8_t vs{}[] = {{{}}};", k, str.join(strs.items, ", ")!)
    }
    piece := str.format("{}->text[k{}]", t, k)!
    // The value of placeholder `k`, its spec, and whether it is a string written as it is.
    v := str.format("vp{}[j{}]", k, k)!
    d := str.format("vd{}[j{}]", k, k)!
    sp := str.format("{}->fmt[k{}]", t, k)!
    plain := str.format("(!{} && vs{}[j{}])", sp, k, k)!
    p := fg.ptr_bytes()
    stub: ?string = null
    if .Perform(effect_, op) := sink {
        id := fg.g.effect_id(&effect_)
        stub_tys := [1]Ty(str_ty)
        stub = fg.out_stub(&effect_, id, op, stub_tys[..], fg.g.ty.unit_ty())
    }
    if .Fn(cv, ?direct) := sink and not fg.g.ty.by_ref(str_ty) {
        .Fn(sig) := fg.g.ty.kind(cv.ty) else @unreachable()
        c := fg.tmp(cv.ty, cv.v)
        ccx := str.format("ccx{}", fg.fresh())!
        fg.linef("gm_node *{} = {}.cx;", ccx, c)
        for eff in sig.effects.effects {
            id := fg.g.effect_id(&eff)
            n := str.format("cn{}", fg.fresh())!
            fg.linef("gm_node {}; {{ gm_node *f = gm_find({}, {}); if (f) {{ {} = *f; {}.next = {}; {} = &{}; }} }}", n, fg.cx, id, n, n, ccx, ccx, n)
        }
        fs := fg.fn_sink_stub(str_ty)
        ff := fg.fn_format_stub(fs)
        fg.linef("for (uint32_t k{} = 0;; k{}++) {{", k, k)
        fg.indent += 1
        if dn := direct {
            fg.linef("if ({}.len != 0) {{", piece)
            fg.indent += 1
            sl := fg.make_slice(str_ty, str.format("{}.ptr", piece)!, str.format("{}.len", piece)!)
            fg.linef("{}({}.env, {}, NULL, {});", dn, c, ccx, sl)
            fg.check_unwind()
            fg.indent -= 1
            fg.line("}")
        } else {
            fg.unwind_call(str.format("({}.len != 0 && {}({}.code, {}.env, {}, {}.ptr, {}.len))", piece, fs, c, c, ccx, piece, piece)!)
        }
        fg.linef("if (k{} == {}->n) break;", k, t)
        if tys.len > 0 {
            fg.linef("uint32_t j{} = {}->arg[k{}];", k, t, k)
            if dn := direct {
                fg.linef("if ({}) {{", plain)
                fg.indent += 1
                fg.linef("if (GM_LD(uintptr_t, (const uint8_t *){} + {}) != 0) {{", v, p)
                fg.indent += 1
                fg.linef("{}({}.env, {}, NULL, GM_LD({}, {}));", dn, c, ccx, fg.g.ty.cty(str_ty), v)
                fg.check_unwind()
                fg.indent -= 1
                fg.line("}")
                fg.indent -= 1
                fg.line("} else {")
                fg.indent += 1
                fg.unwind_call(str.format("{}({}.code, {}.env, {}, {}, {}, {})", ff, c, c, ccx, d, v, sp)!)
                fg.indent -= 1
                fg.line("}")
            } else {
                fg.unwind_call(str.format("({} ? (GM_LD(uintptr_t, (const uint8_t *){} + {}) != 0 && {}({}.code, {}.env, {}, GM_LD(void *, {}), GM_LD(uintptr_t, (const uint8_t *){} + {}))) : {}({}.code, {}.env, {}, {}, {}, {}))", plain, v, p, fs, c, c, ccx, v, v, p, ff, c, c, ccx, d, v, sp)!)
            }
        }
        fg.indent -= 1
        fg.line("}")
        return fg.unit()
    }
    fg.linef("for (uint32_t k{} = 0;; k{}++) {{", k, k)
    fg.indent += 1
    if core := stub {
        ps := fg.piece_stub(core, 's', str_ty)
        pf := fg.piece_stub(core, 'f', str_ty)
        at := fg.g.src_loc(span)
        fg.unwind_call(str.format("({}.len != 0 && {}({}, {}.ptr, {}.len, {}))", piece, ps, fg.cx, piece, piece, at)!)
        fg.linef("if (k{} == {}->n) break;", k, t)
        if tys.len > 0 {
            fg.linef("uint32_t j{} = {}->arg[k{}];", k, t, k)
            fg.linef("if ({}) {{", sp)
            fg.indent += 1
            b := str.format("b{}", fg.fresh())!
            fg.linef("gm_buf {} = {{0}};", b)
            fg.linef("gm_format_spec(&{}, {}, {}, {});", b, d, v, sp)
            try fg.emit_buf(sink, b, span)
            fg.indent -= 1
            fg.line("} else {")
            fg.indent += 1
            fg.unwind_call(str.format("({} ? (GM_LD(uintptr_t, (const uint8_t *){} + {}) != 0 && {}({}, GM_LD(void *, {}), GM_LD(uintptr_t, (const uint8_t *){} + {}), {})) : {}({}, {}, {}, {}))", plain, v, p, ps, fg.cx, v, v, p, at, pf, fg.cx, d, v, at)!)
            fg.indent -= 1
            fg.line("}")
        }
        fg.indent -= 1
        fg.line("}")
        return fg.unit()
    }
    fg.linef("if ({}.len != 0) {{", piece)
    fg.indent += 1
    sl := fg.make_slice(str_ty, str.format("{}.ptr", piece)!, str.format("{}.len", piece)!)
    try fg.emit_to(sink, sl, span)
    fg.indent -= 1
    fg.line("}")
    fg.linef("if (k{} == {}->n) break;", k, t)
    if tys.len > 0 {
        b := str.format("b{}", fg.fresh())!
        fg.linef("gm_buf {} = {{0}};", b)
        fg.linef("uint32_t j{} = {}->arg[k{}];", k, t, k)
        fg.linef("if ({}) gm_format_spec(&{}, {}, {}, {}); else gm_format(&{}, {}, {}, true);", sp, b, d, v, sp, b, d, v)
        try fg.emit_buf(sink, b, span)
    }
    fg.indent -= 1
    fg.line("}")
    return fg.unit()
}

/// Sends the formatted argument in `gm_buf` variable `b` to an `@write` sink unless it
/// is empty (the interpreter writes no empty chunks either), then frees it.
emit_buf :: fn(fg: ^FnGen, sink: WriteTo, b: string, span: source.Span) -> Unsup!() needs sema.Load {
    fg.linef("if ({}.len != 0) {{", b)
    fg.indent += 1
    sl := fg.make_slice(fg.g.ty.string_ty(), str.format("{}.data", b)!, str.format("{}.len", b)!)
    try fg.emit_to(sink, sl, span)
    fg.indent -= 1
    fg.line("}")
    fg.linef("gm_buf_free(&{});", b)
}

/// Sends a `[]const u8` value to an `@write` sink.
emit_to :: fn(fg: ^FnGen, sink: WriteTo, slice: string, span: source.Span) -> Unsup!() needs sema.Load {
    unit_ty := fg.g.ty.unit_ty()
    vals := [1]string(slice)
    tys := [1]Ty(fg.g.ty.string_ty())
    match sink {
        .Fn(cv, _) => {
            _ = try fg.call_closure(cv.v, cv.ty, vals[..], tys[..], unit_ty)
        }
        .Perform(effect_, op) => {
            _ = try fg.perform(span, &effect_, op, vals[..], tys[..], unit_ty)
        }
    }
}

is_with_label :: fn(fg: ^FnGen, levels: u32, label: u32) -> bool needs sema.Load {
    _, f := fg.frame_up(levels)
    if b := fg.g.prog.func(f).body { return find_with(b, label) }
    return false
}

target_ret :: fn(fg: ^FnGen, levels: u32) -> Ty needs sema.Load {
    _, f := fg.frame_up(levels)
    return fg.g.prog.func(f).ret
}

// --- places ---------------------------------------------------------------------------------

/// The address (`uint8_t *`) of the global variable declared by `decl`.
global_addr :: fn(g: ^Gen, decl: usize, span: source.Span) -> Unsup!string needs Alloc {
    i := g.prog.global_index(decl) else return !unsupported(span, "this variable")
    gl := g.prog.s.globals.items[i]
    t := g.global_tag(i)
    if gl.thread_local and gl.link_name is null { return str.format("gm_ga{}()", t)! }
    return str.format("((uint8_t *)gm_g{})", t)!
}

/// The bounds check of an index `i` against length `len`.
index_check :: fn(fg: ^FnGen, checked: bool, i: string, len: string, at: string) needs sema.Load {
    if checked {
        fg.linef("if ({} >= (uintptr_t)({})) gm_trap_index({}, {}, {});", i, len, i, len, at)
    }
}

/// An index or bound `v` of type `t` that is checked against a length, as a
/// `uintptr_t`: a value too large for one becomes `UINTPTR_MAX`, so the check fails
/// instead of seeing its low bits.
bound :: fn(fg: ^FnGen, t: Ty, v: string) -> string needs Alloc {
    if fg.g.ty.size(t) > fg.g.ty.lay.target.ptr_bytes {
        return str.format("(((unsigned __int128)({}) > (unsigned __int128)UINTPTR_MAX) ? UINTPTR_MAX : (uintptr_t)({}))", v, v)!
    }
    return str.format("(uintptr_t){}", v)!
}

// --- coercions ------------------------------------------------------------------------------

/// The coercion `kind` of `v`, of type `xt`, to type `t`.
coerce_value :: fn(fg: ^FnGen, span: source.Span, t: Ty, kind: tir.Coercion, xt: Ty, v: string) -> Unsup!string needs sema.Load {
    match kind {
        .IntWiden, .FloatWiden => {
            c := fg.g.ty.cty(t)
            return fg.tmp(t, str.format("({}){}", c, v)!)
        }
        .WrapOptional => return fg.make_some(t, v)
        .WrapOk => return fg.make_res(t, false, xt, v)
        .LiftErr(variant) => {
            a := fg.addr_of(xt, v)
            .Result(e1, ok) := fg.g.ty.kind(xt) else return !unsupported(span, "this error lifting")
            .Result(e2, _) := fg.g.ty.kind(t) else return !unsupported(span, "this error lifting")
            res := fg.tmp_uninit(t)
            bad := fg.res_is_err(xt, a)
            off := fg.g.ty.offsets(xt)[1]
            fg.linef("if ({}) {{", bad)
            fg.indent += 1
            ev := fg.load(e1, str.format("({} + {})", a, off)!)
            wrapped := fg.make_variant(e2, usize(variant), ev)
            r := fg.make_res(t, true, e2, wrapped)
            fg.linef("{} = {};", res, r)
            fg.indent -= 1
            fg.line("} else {")
            fg.indent += 1
            ov := fg.load(ok, str.format("({} + {})", a, off)!)
            r2 := fg.make_res(t, false, ok, ov)
            fg.linef("{} = {};", res, r2)
            fg.indent -= 1
            fg.line("}")
            return res
        }
        .FromNever => return fg.zero(t)
        // Widening a plain function pointer to an effectful type marks it (see `call_indirect`).
        .FnPtrWiden if fg.ptr_type_plain(xt) and not fg.ptr_type_plain(t) => return fg.tmp(t, str.format("GM_PTR_TAG({})", v)!)
        .PtrToPtr, .FnPtrWiden, .TupleRename, .InOptional => {
            if fg.g.ty.repr(t) is fg.g.ty.repr(xt) and fg.g.ty.repr(t) is not .Blob { return v }
            a := fg.addr_of(xt, v)
            return fg.load(t, a)
        }
        .ArrayPtrToSlice => {
            .Ptr(_, pointee) := fg.g.ty.kind(xt) else return !unsupported(span, "this array-to-slice coercion")
            .Array(len, _, _) := fg.g.ty.kind(pointee) else return !unsupported(span, "this array-to-slice coercion")
            return fg.make_slice(t, v, str.format("{}", len)!)
        }
        .FnToPtr => {
            if fg.g.ty.repr(xt) is .Ptr and fg.g.ty.repr(t) is .Closure {
                code: string = if fg.ptr_type_plain(xt) { str.format("GM_PTR_TAG({})", v)! } else { v }
                return fg.tmp(t, str.format("((gm_closure){{{}, NULL, {}}})", code, fg.cx)!)
            }
            return v
        }
        .Unresolved => return !unsupported(span, "an unresolved coercion")
    }
}

// --- helpers on expressions -----------------------------------------------------------------

/// True if `e` performs `effect` or calls a function that does.
uses_effect :: fn(prog: ^Prog, e: ^Expr, effect_: ^const EffectRef) -> bool needs Alloc {
    found := false
    if .Call(callee, _) := e.kind {
        match callee {
            .Perform(x, _) => { found = x is effect_^ }
            .Fn(f) => {
                for x in prog.func(f).effects.effects {
                    if x is effect_^ { found = true }
                }
            }
            .Indirect(_) => {}
        }
    }
    return found or tir.any_child(e, fn(c: ^Expr) -> bool => uses_effect(prog, c, effect_))
}

/// True if `e` contains the `with` labeled `label`.
find_with :: fn(e: ^Expr, label: u32) -> bool {
    if .With(w) := e.kind {
        if w.label is label { return true }
    }
    return tir.any_child(e, fn(c: ^Expr) -> bool => find_with(c, label))
}

/// The low and high 64-bit halves of `v` modulo 2^128 (two's complement).
split_u128 :: fn(v: bigint.Int) -> (lo: u128, hi: u128) {
    m := bigint.bits128(v)
    return (m & 0xffff_ffff_ffff_ffff, m >> 64)
}

/// A C literal of float type of `bits` bits with value `x` (exactly representable in it).
float_lit :: fn(bits: u16, x: f64) -> string needs Alloc {
    c := match bits {
        16 => "_Float16"
        32 => "float"
        _ => "double"
    }
    if x.is_nan() { return str.format("(({})__builtin_nan(\"\"))", c)! }
    if x.is_inf() { return str.format("(({}){}__builtin_inf())", c, if x < 0.0 { "-" } else { "" })! }
    // The shortest form that reads back as the same f64.
    return str.format("(({}){:e})", c, x)!
}

/// The mask of the low `w` bits, as an `unsigned __int128` C expression.
mask :: fn(w: u32) -> string needs Alloc {
    if w >= 128 { return "(~(unsigned __int128)0)" }
    return str.format("((((unsigned __int128)1) << {}) - 1)", w)!
}

/// A C compound literal for a format spec (`gm_spec` in the runtime).
spec_literal :: fn(s: tir.FmtSpec) -> string needs Alloc {
    align := match s.align {
        .Auto => 0
        .Left => 1
        .Right => 2
        .Center => 3
    }
    kind := match s.kind {
        .Display => 0
        .Hex => 1
        .HexUpper => 2
        .Oct => 3
        .Bin => 4
        .Exp => 5
        .Quote => 6
    }
    precision: i64 = -1
    if p := s.precision { precision = i64(p) }
    return str.format("(gm_spec){{{}, {}, {}, {}, {}, {}, {}u, {}}}", s.fill, align, if s.plus { 1 } else { 0 }, if s.alt { 1 } else { 0 }, if s.zero { 1 } else { 0 }, kind, s.width, precision)!
}
