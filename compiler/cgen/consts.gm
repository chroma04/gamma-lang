// Compile-time values in static storage. The checker keeps a value's structure, with
// pointers as places in cells (`tir/value.gm`); the generated program gets the value's
// bytes in the target layout, initialized at startup with pointers patched in.

/// A cell whose value the program has in static storage `gm_cN` (N its index), with the
/// type of that value.
pub StaticCell :: struct {
    pub cell: ^tir.Cell
    pub ty: Ty
}

/// A pointer stored at `offset` within a value: the address of `target` (a C expression
/// for static storage) plus `addend` bytes.
Reloc :: struct {
    offset: u64
    target: string
    addend: u64
}

/// The declarations of the static storage of constants and the function that fills it.
pub ConstsText :: struct {
    pub decls: string
    pub init: string
}

/// The storage of the constant declared at `span` with type `t`, named by an expression
/// `Const(name, span)`.
pub const_storage :: fn(g: ^Gen, span: source.Span, t: Ty, at: source.Span) -> Unsup!string needs sema.Load {
    s := g.prog.s
    id := s.const_id(span, t) else return !unsupported(at, "a constant that was not evaluated")
    cell := s.consts.items[(id).trunc(usize)].cell else return !unsupported(at, "a constant without a compile-time value")
    return g.cell_storage(cell, t)
}

/// The storage `gm_cN` of `cell`, holding a value of type `t`.
cell_storage :: fn(g: ^Gen, cell: ^tir.Cell, t: Ty) -> string needs Alloc {
    key := usize(cell.addr())
    if i := g.cell_ids.get(key) { return str.format("gm_c{}", i)! }
    i := g.statics_cells.items.len.trunc(u32)
    g.statics_cells.push(StaticCell(cell: cell, ty: t))!
    g.cell_ids.put(key, i)!
    return str.format("gm_c{}", i)!
}

/// Static storage for every cell used so far, filled by `gm_init_consts`.
gen_consts :: fn(g: ^Gen) -> Unsup!ConstsText needs sema.Load {
    decls := list(u8)
    init := list(u8)
    init.extend("static void gm_init_consts(void) {\n")!
    i: usize = 0
    // Values may point into cells not seen yet, and the functions they reach may use
    // more constants: both add to the list.
    while true {
        while i < g.statics_cells.items.len {
            sc := g.statics_cells.items[i]
            name := str.format("gm_c{}", i)!
            i += 1
            size := g.ty.size(sc.ty)
            al := g.ty.align(sc.ty).max(1)
            decls.write("static uint8_t {}[{}] __attribute__((aligned({})));\n", name, size.max(1), al)!
            bytes := list(u8)
            for _ in 0..size { bytes.push(0)! }
            relocs := list(Reloc)
            try g.value_bytes(sc.cell.v, sc.ty, bytes.items, 0, &relocs)
            if bytes.items.len > 0 {
                sb := g.static_bytes(bytes.items)
                init.write("    memcpy({}, {}, {});\n", name, sb, bytes.items.len)!
            }
            for r in relocs.items {
                init.write("    {{ void *p = (uint8_t *){} + {}; memcpy({} + {}, &p, sizeof p); }}\n", r.target, r.addend, name, r.offset)!
            }
        }
        // Constants may refer to functions not otherwise reached.
        try g.drain()
        if i is g.statics_cells.items.len { break }
    }
    for gi, gl in enumerate(g.prog.s.globals.items) {
        size := g.ty.size(gl.ty)
        al := g.ty.align(gl.ty).max(gl.align else 1).max(1)
        // `errno` is the C library's macro for the calling thread's variable, not a
        // symbol to link with.
        if gl.link_name is "errno" {
            decls.write("#define gm_g{} ((uint8_t *)&errno)\n", gi)!
            continue
        }
        if link := gl.link_name {
            decls.write("extern uint8_t gm_g{}[] __asm__(GM_SYM({}));\n", gi, c_string(link))!
            continue
        }
        tls := if gl.thread_local { "GM_TLS " } else { "" }
        decls.write("static {}uint8_t gm_g{}[{}] __attribute__((aligned({})));\n", tls, gi, size.max(1), al)!
        // A thread-local variable gets its initial value in each thread, on first use,
        // through its accessor `gm_ga{gi}()`.
        tls_init := list(u8)
        target: ^List(u8) = if gl.thread_local { &tls_init } else { &init }
        if cell := gl.value {
            bytes := list(u8)
            for _ in 0..size { bytes.push(0)! }
            relocs := list(Reloc)
            try g.value_bytes(cell.v, gl.ty, bytes.items, 0, &relocs)
            if bytes.items.len > 0 {
                sb := g.static_bytes(bytes.items)
                target.write("    memcpy(gm_g{}, {}, {});\n", gi, sb, bytes.items.len)!
            }
            for r in relocs.items {
                target.write("    {{ void *p = (uint8_t *){} + {}; memcpy(gm_g{} + {}, &p, sizeof p); }}\n", r.target, r.addend, gi, r.offset)!
            }
        }
        if gl.thread_local {
            decls.write("static GM_TLS uint8_t gm_gi{};\nstatic void gm_ginit{}(void);\nstatic inline uint8_t *gm_ga{}(void) {{ if (!gm_gi{}) {{ gm_gi{} = 1; gm_ginit{}(); }} return gm_g{}; }}\n", gi, gi, gi, gi, gi, gi, gi)!
            g.bodies.write("static void gm_ginit{}(void) {{\n{}}}\n", gi, tls_init.items)!
        }
    }
    // Their values may refer to cells and functions not seen yet.
    while i < g.statics_cells.items.len {
        sc := g.statics_cells.items[i]
        name := str.format("gm_c{}", i)!
        i += 1
        size := g.ty.size(sc.ty)
        decls.write("static uint8_t {}[{}] __attribute__((aligned({})));\n", name, size.max(1), g.ty.align(sc.ty).max(1))!
        bytes := list(u8)
        for _ in 0..size { bytes.push(0)! }
        relocs := list(Reloc)
        try g.value_bytes(sc.cell.v, sc.ty, bytes.items, 0, &relocs)
        if bytes.items.len > 0 {
            sb := g.static_bytes(bytes.items)
            init.write("    memcpy({}, {}, {});\n", name, sb, bytes.items.len)!
        }
        for r in relocs.items {
            init.write("    {{ void *p = (uint8_t *){} + {}; memcpy({} + {}, &p, sizeof p); }}\n", r.target, r.addend, name, r.offset)!
        }
    }
    try g.drain()
    if i is not g.statics_cells.items.len { return !unsupported(source.DUMMY, "a variable whose value reaches a function that uses a new constant") }
    // Large constant arguments of calls (see `constarg.gm`).
    for k, sc in enumerate(g.site_consts.items) {
        name := str.format("gm_k{}", k)!
        decls.write("static uint8_t {}[{}] __attribute__((aligned({})));\n", name, g.ty.size(sc.ty).max(1), g.ty.align(sc.ty).max(1))!
        if sc.bytes.items.len > 0 {
            sb := g.static_bytes(sc.bytes.items)
            init.write("    memcpy({}, {}, {});\n", name, sb, sc.bytes.items.len)!
        }
        for r in sc.relocs.items {
            target := g.static_bytes(r.data)
            init.write("    {{ void *p = (uint8_t *){} + 0; memcpy({} + {}, &p, sizeof p); }}\n", target, name, r.offset)!
        }
    }
    init.extend("}\n")!
    return ConstsText(decls: decls.items, init: init.items)
}

/// Writes the bytes of `v`, of type `t`, at `off` in `out`, and records its pointers.
value_bytes :: fn(g: ^Gen, v: tir.Value, t: Ty, out: []u8, off: u64, relocs: ^List(Reloc)) -> Unsup!() needs sema.Load {
    match v {
        .Int(bits) => {
            n := g.ty.size(t)
            for k in 0..n {
                at := if g.ty.lay.target.little_endian { k } else { n - 1 - k }
                out[(off + at).trunc(usize)] = (bits >> u128(8 * k)).trunc(u8)
            }
        }
        .Float(x) => {
            match g.ty.kind(t) {
                .Float(64) => g.store_int(out, off, u128(x.bits(u64)), 8)
                .Float(32) => g.store_int(out, off, u128(x.to(f32).bits(u32)), 4)
                _ => return !unsupported(source.DUMMY, "a compile-time value of this float type")
            }
        }
        .Bool(b) => { out[off.trunc(usize)] = if b { 1 } else { 0 } }
        .Null => {}
        .Some(x) => {
            .Optional(inner) := g.ty.kind(t) else return !unsupported(source.DUMMY, "this compile-time optional")
            try g.value_bytes(x^, inner, out, off, relocs)
            if not nullable_pointer(g.prog.s, inner) { out[(off + g.ty.offsets(t)[1]).trunc(usize)] = 1 }
        }
        .Ok(x) => {
            .Result(_, ok) := g.ty.kind(t) else return !unsupported(source.DUMMY, "this compile-time result")
            offs := g.ty.offsets(t)
            try g.value_bytes(x^, ok, out, off + offs[1], relocs)
        }
        .Err(x) => {
            .Result(err, _) := g.ty.kind(t) else return !unsupported(source.DUMMY, "this compile-time result")
            offs := g.ty.offsets(t)
            out[(off + offs[0]).trunc(usize)] = 1
            try g.value_bytes(x^, err, out, off + offs[1], relocs)
        }
        .Variant(index, ?payload) => {
            .Adt(id, _) := g.ty.kind(t) else return !unsupported(source.DUMMY, "this compile-time union value")
            .Union(tag_ty, variants) := g.prog.adt(id).kind else return !unsupported(source.DUMMY, "this compile-time union value")
            vd := variants[(index).trunc(usize)]
            offs := g.ty.offsets(t)
            tag := bigint.to_i128(vd.tag) else 0
            try g.value_bytes(.Int(u128(tag.trunc(u128))), tag_ty, out, off + offs[0], relocs)
            if x := payload {
                pt := vd.payload else return !unsupported(source.DUMMY, "this compile-time union value")
                try g.value_bytes(x^, pt, out, off + offs[1], relocs)
            }
        }
        .Agg(a) => {
            match g.ty.kind(t) {
                .Array(_, elem, _) => {
                    esz := g.ty.size(elem)
                    for k, x in enumerate(a.elems) { try g.value_bytes(x, elem, out, off + u64(k) * esz, relocs) }
                }
                .Tuple(elems, _) => {
                    offs := g.ty.offsets(t)
                    for k, x in enumerate(a.elems) { try g.value_bytes(x, elems[k], out, off + offs[k], relocs) }
                }
                .Adt(id, _) => match g.prog.adt(id).kind {
                    .Struct(sd) => {
                        if u := sd.bits {
                            raw := try g.bits_of(v, t)
                            return g.value_bytes(.Int(raw), u, out, off, relocs)
                        }
                        offs := g.ty.offsets(t)
                        for k, x in enumerate(a.elems) { try g.value_bytes(x, sd.fields[k].ty, out, off + offs[k], relocs) }
                    }
                    _ => return !unsupported(source.DUMMY, "this compile-time value")
                }
                _ => return !unsupported(source.DUMMY, "this compile-time value")
            }
        }
        .Ptr(pl) => {
            pointee: Ty = match g.ty.kind(t) {
                .Ptr(_, p) => p
                .ManyPtr(_, p) => p
                .Optional(inner) => match g.ty.kind(inner) {
                    .Ptr(_, p) => p
                    .ManyPtr(_, p) => p
                    _ => return !unsupported(source.DUMMY, "a compile-time pointer of this type")
                }
                _ => return !unsupported(source.DUMMY, "a compile-time pointer of this type")
            }
            r := try g.place_reloc(pl, pointee, off)
            relocs.push(r)!
        }
        .Slice(start, len) => {
            .Slice(_, elem) := g.ty.kind(t) else return !unsupported(source.DUMMY, "this compile-time slice")
            p := g.ty.lay.target.ptr_bytes
            if len > 0 or start.path.len > 0 {
                r := try g.place_reloc(start, elem, off)
                relocs.push(r)!
            }
            g.store_int(out, off + p, u128(len), p)
        }
        .Fn(f) => {
            g.queue(f)
            match g.ty.kind(t) {
                .FnPtr(_) => relocs.push(Reloc(offset: off, target: str.format("(void *){}", g.addr_name(f))!, addend: 0))!
                .Optional(_) => relocs.push(Reloc(offset: off, target: str.format("(void *){}", g.addr_name(f))!, addend: 0))!
                _ => return !unsupported(source.DUMMY, "a compile-time function value of this type")
            }
        }
        .Closure(_), .Handler(_) => return !unsupported(source.DUMMY, "a compile-time function literal")
    }
}

/// The relocation for a pointer to `pl`, whose pointee type is `pointee`, stored at `off`.
place_reloc :: fn(g: ^Gen, pl: tir.Place, pointee: Ty, off: u64) -> Unsup!Reloc needs sema.Load {
    // The type of the cell's whole value: a constant's own, or for a literal's cell,
    // what the pointer says it holds.
    root: Ty = if t := g.cell_type(pl.cell) {
        t
    } else if pl.path.len is 0 {
        pointee
    } else if pl.path.len is 1 and .Agg(a) := pl.cell.v {
        g.prog.s.tys.array(u64(a.elems.len), pointee)
    } else {
        return !unsupported(source.DUMMY, "a compile-time pointer into this value")
    }
    addend: u64 = 0
    cur := root
    for i in pl.path {
        match g.ty.kind(cur) {
            .Array(len, elem, _) => {
                addend += i * g.ty.size(elem)
                if i < len { cur = elem }
            }
            .Tuple(elems, _) => {
                addend += g.ty.offsets(cur)[(i).trunc(usize)]
                cur = elems[(i).trunc(usize)]
            }
            .Adt(id, _) => {
                .Struct(sd) := g.prog.adt(id).kind else return !unsupported(source.DUMMY, "a compile-time pointer into this value")
                addend += g.ty.offsets(cur)[(i).trunc(usize)]
                cur = sd.fields[(i).trunc(usize)].ty
            }
            _ => return !unsupported(source.DUMMY, "a compile-time pointer into this value")
        }
    }
    return Reloc(offset: off, target: g.cell_storage(pl.cell, root), addend: addend)
}

/// The type of the value in `cell` if it already has storage.
cell_type :: fn(g: ^Gen, cell: ^tir.Cell) -> ?Ty {
    i := g.cell_ids.get(usize(cell.addr())) else return null
    return g.statics_cells.items[(i).trunc(usize)].ty
}

/// Stores the `n` low bytes of `v` at `off`, in the target's byte order.
store_int :: fn(g: ^const Gen, out: []u8, off: u64, v: u128, n: u64) {
    for k in 0..n {
        at := if g.ty.lay.target.little_endian { k } else { n - 1 - k }
        out[(off + at).trunc(usize)] = (v >> u128(8 * k)).trunc(u8)
    }
}

/// The bits of `v`, a value of a `#bits` field type `t` (§5.10.5): a `bool`, an integer, a
/// union (its tag) or a `#bits` struct, from the least significant bit.
bits_of :: fn(g: ^Gen, v: tir.Value, t: Ty) -> Unsup!u128 needs Alloc {
    match v {
        .Bool(b) => return if b { 1 } else { 0 }
        .Int(bits) => {
            w := g.ty.bit_width(t)
            return if w >= 128 { bits } else { bits & ((u128(1) << u128(w)) - 1) }
        }
        .Variant(index, _) => {
            .Adt(id, _) := g.ty.kind(t) else return !unsupported(source.DUMMY, "this `#bits` field value")
            .Union(tag_ty, variants) := g.prog.adt(id).kind else return !unsupported(source.DUMMY, "this `#bits` field value")
            tag := bigint.to_i128(variants[usize(index)].tag) else 0
            return g.bits_of(.Int(u128(tag.trunc(u128))), tag_ty)
        }
        .Agg(a) => {
            bl := g.ty.bits_layout(t) else return !unsupported(source.DUMMY, "this `#bits` field value")
            raw: u128 = 0
            for k, x in enumerate(a.elems) {
                f := bl.fields[k]
                raw |= (try g.bits_of(x, f.ty)) << u128(f.off)
            }
            return raw
        }
        _ => return !unsupported(source.DUMMY, "this `#bits` field value")
    }
}
