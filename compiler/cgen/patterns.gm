// Conditions, patterns, `match` and `in`: the matching half of the expressions of `expr.gm`.

/// Emits the parts of an `if`/loop condition, jumping to `fail` when one fails.
conds :: fn(fg: ^FnGen, cond: []tir.CondPart, fail: string) -> Unsup!() needs sema.Load {
    for c in cond {
        match c {
            .Bool(b) => {
                v := try fg.expr(b)
                fg.linef("if (!{}) goto {};", v, fail)
            }
            .Match(p, value) => {
                a := try fg.scrutinee_addr(value, true)
                try fg.pat(p, a, fail)
            }
        }
    }
}

match_expr :: fn(fg: ^FnGen, e: ^Expr, scrutinee: ^Expr, arms: []tir.Arm) -> Unsup!string needs sema.Load {
    guarded := false
    for arm in arms {
        if arm.guard is not null { guarded = true }
    }
    a := try fg.scrutinee_addr(scrutinee, not guarded)
    res: ?string = null
    if not fg.g.ty.is_never(e.ty) and not fg.g.ty.is_unit(e.ty) { res = fg.tmp_uninit(e.ty) }
    end := str.format("me{}", fg.fresh())!
    starts := fg.match_switch(scrutinee.ty, a, arms)
    for i, arm in enumerate(arms) {
        if s := starts { fg.label(s.items[i]) }
        next := str.format("mn{}", fg.fresh())!
        try fg.pat(arm.pat, a, next)
        if g := arm.guard {
            gv := try fg.expr(g)
            fg.linef("if (!{}) goto {};", gv, next)
        }
        bv := try fg.expr(arm.body)
        if r := res {
            if not fg.g.ty.is_never(arm.body.ty) { fg.linef("{} = {};", r, bv) }
        }
        fg.linef("goto {};", end)
        fg.label(next)
    }
    loc := fg.loc(e)
    if s := starts { fg.label(s.items[arms.len]) }
    fg.linef("gm_trap(\"no match arm matched the scrutinee\", {});", loc)
    fg.label(end)
    if r := res { return r }
    return fg.zero(e.ty)
}

/// For a `match` of several arms on a union value at `a`: a `switch` on its tag that jumps
/// to the first arm whose pattern can match each variant (where the arms' tests run in
/// order as before). Returns the labels of the arms and, last, of the trap after them.
match_switch :: fn(fg: ^FnGen, t: Ty, a: string, arms: []tir.Arm) -> ?List(string) needs sema.Load {
    if arms.len < 3 or fg.g.ty.kind(t) is not .Adt(_) { return null }
    .Union(tag, variants) := fg.adt_def(t).kind else return null
    if fg.g.ty.size(tag) > 8 { return null }
    labels := list(string)
    for _ in 0..arms.len + 1 { labels.push(str.format("ma{}", fg.fresh())!)! }
    first :: fn(k: ?u32) -> usize {
        for i, arm in enumerate(arms) {
            if pat_admits(arm.pat, k) { return i }
        }
        return arms.len
    }
    offs := fg.g.ty.offsets(t)
    tv := fg.load(tag, str.format("({} + {})", a, offs[0])!)
    out := list(u8)
    out.write("switch ({}) {{ ", tv)!
    for k, v in enumerate(variants) { out.write("case {}: goto {}; ", fg.int_lit(tag, v.tag), labels.items[first(k.trunc(u32))])! }
    out.write("default: goto {}; }}", labels.items[first(null)])!
    fg.line(out.items)
    return labels
}

/// Whether a value of variant `k` (`null`: a tag no variant has) may match `p`.
pat_admits :: fn(p: ^tir.Pat, k: ?u32) -> bool => match p.kind {
    .Variant(v, _) => if x := k { v is x } else { false }
    .Or(alts) => {
        for q in alts {
            if pat_admits(q, k) { return true }
        }
        false
    }
    _ => true
}

/// The address of the value the patterns of a `match` or condition test. A large value
/// (a union, say) that is a place is tested where it is, without a copy, when `in_place`
/// says no code runs between the tests (guards could write the place): the tests only read
/// it, and bindings copy what they bind.
scrutinee_addr :: fn(fg: ^FnGen, value: ^Expr, in_place: bool) -> Unsup!string needs sema.Load {
    if in_place and fg.g.ty.repr(value.ty) is .Blob and fg.reads_place(value) { return fg.place_addr(value) }
    v := try fg.expr(value)
    return fg.addr_of(value.ty, v)
}

/// Tests the value at `addr` against `p`, binding its locals; jumps to `fail` on mismatch.
pat :: fn(fg: ^FnGen, p: ^tir.Pat, addr: string, fail: string) -> Unsup!() needs sema.Load {
    t := p.ty
    match p.kind {
        .Wild => {}
        .Bind(l) => {
            v := fg.load(t, addr)
            lv := fg.local_lv(l)
            fg.linef("{} = {};", lv, v)
        }
        .Const(c) => {
            if .Str(bytes) := c.kind and fg.g.ty.kind(t) is .Slice(_, _) {
                fg.linef("if (!{}) goto {};", fg.str_equal_at(addr, bytes), fail)
                return ()
            }
            cv := try fg.expr(c)
            v := fg.load(t, addr)
            eq := fg.equal(t, v, cv)
            fg.linef("if (!{}) goto {};", eq, fail)
        }
        .Range(lo, hi, inclusive) => {
            v := fg.load(t, addr)
            l := fg.int_lit(t, lo)
            h := fg.int_lit(t, hi)
            op := if inclusive { ">" } else { ">=" }
            below := str.format("({} < {})", v, l)!
            above := str.format("({} {} {})", v, op, h)!
            fg.linef("if ({} || {}) goto {};", below, above, fail)
        }
        .Null => {
            present := fg.opt_present(t, addr)
            fg.linef("if ({}) goto {};", present, fail)
        }
        .Some(q) => {
            present := fg.opt_present(t, addr)
            fg.linef("if (!{}) goto {};", present, fail)
            try fg.pat(q, addr, fail)
        }
        .Ok(q), .Err(q) => {
            bad := fg.res_is_err(t, addr)
            want_err := p.kind is .Err(_)
            fg.linef("if ({}{}) goto {};", if want_err { "!" } else { "" }, bad, fail)
            off := fg.g.ty.offsets(t)[1]
            try fg.pat(q, str.format("({} + {})", addr, off)!, fail)
        }
        .Variant(variant, ?payload) => {
            def := fg.adt_def(t)
            .Union(tag, variants) := def.kind else return !unsupported(p.span, "this variant pattern")
            vtag := variants[usize(variant)].tag
            offs := fg.g.ty.offsets(t)
            tv := fg.load(tag, str.format("({} + {})", addr, offs[0])!)
            want := fg.int_lit(tag, vtag)
            fg.linef("if ({} != {}) goto {};", tv, want, fail)
            if q := payload { try fg.pat(q, str.format("({} + {})", addr, offs[1])!, fail) }
        }
        .Fields(fs) => {
            offs := fg.g.ty.offsets(t)
            for f in fs {
                try fg.pat(f.pat, str.format("({} + {})", addr, offs[usize(f.index)])!, fail)
            }
        }
        .Or(alts) => {
            ok := str.format("po{}", fg.fresh())!
            for alt in alts {
                next := str.format("pa{}", fg.fresh())!
                try fg.pat(alt, addr, next)
                fg.linef("goto {};", ok)
                fg.label(next)
            }
            fg.linef("goto {};", fail)
            fg.label(ok)
        }
    }
}

calls_in_scan :: fn(fg: ^FnGen, et: Ty, n: string, p: string, x: string, r: string) needs sema.Load {
    esz := fg.g.ty.size(et)
    xa := fg.addr_of(et, x)
    eq := fg.g.helpers.eq_fn(&fg.g.ty, et)
    fg.linef("for (uintptr_t i = 0; i < (uintptr_t)({}); i++) if ({}({} + i * {}, {})) {{ {} = 1; break; }}", n, eq, p, esz, xa, r)
}

/// `x in c` for arrays, slices, inline tuples and ranges (§7.7).
in_expr :: fn(fg: ^FnGen, elem: ^Expr, container: ^Expr, negated: bool) -> Unsup!string needs sema.Load {
    x := try fg.expr(elem)
    c := try fg.expr(container)
    ca := fg.addr_of(container.ty, c)
    r := fg.tmp(fg.g.ty.bool_ty(), "0")
    match fg.g.ty.kind(container.ty) {
        .Array(len, et, _) => fg.calls_in_scan(et, str.format("{}", len)!, ca, x, r)
        .Slice(_, et) => {
            p := slice_ptr(ca)
            l := fg.slice_len(ca)
            fg.calls_in_scan(et, l, str.format("((uint8_t *){})", p)!, x, r)
        }
        .Tuple(elems, _) => {
            offs := fg.g.ty.offsets(container.ty)
            et := elem.ty
            xa := fg.addr_of(et, x)
            eq := fg.g.helpers.eq_fn(&fg.g.ty, et)
            for i in 0..elems.len {
                fg.linef("if ({}({} + {}, {})) {} = 1;", eq, ca, offs[i], xa, r)
            }
        }
        .Adt(_, _) => {
            def := fg.adt_def(container.ty)
            incl := false
            if def.name is "Range" {
                incl = false
            } else if def.name is "RangeIncl" {
                incl = true
            } else {
                return !unsupported(container.span, "`in` on this type")
            }
            offs := fg.g.ty.offsets(container.ty)
            lt := elem.ty
            lo := fg.load(lt, str.format("({} + {})", ca, offs[0])!)
            hi := fg.load(lt, str.format("({} + {})", ca, offs[1])!)
            op := if incl { "<=" } else { "<" }
            ge := str.format("({} >= {})", x, lo)!
            below := str.format("({} {} {})", x, op, hi)!
            fg.linef("{} = {} && {};", r, ge, below)
        }
        _ => return !unsupported(container.span, "`in` on this type")
    }
    return fg.tmp(fg.g.ty.bool_ty(), str.format("(uint8_t)({}{})", if negated { "!" } else { "" }, r)!)
}
