// Function bodies from LIR: the lowered form the interpreter compiles from, translated to C.
//
// Each temporary becomes a C temporary (`tN`) or, for a value that needs no variable, the
// C expression itself; each local keeps its C lvalue (`local_lv`), and the locals that
// lowering adds are C locals of their own. A block is a C block followed by its label,
// which `Br` jumps to; a loop is `for (;;)`; `If` is `if`. Values are computed in the
// order of the instructions, so the C compiler sees the order of evaluation written out.

/// The LIR of function `f`, from the lowering context kept on the generator.
lir_of :: fn(g: ^Gen, f: u32) -> lir.Func needs sema.Load {
    // The frame's layout and the body ask for the same function in turn.
    if last := g.lir_last and last.f is f { return last.func }
    if g.lir_cx is null { g.lir_cx = new(lir.context(g.prog.s))! }
    cx := g.lir_cx else @unreachable()
    func := cx.lower(f)
    g.lir_last = (f: f, func: func)
    return func
}

/// Whether function `f` is the parent of a nested function: its loops and `with`s may be
/// the targets of exits from that function (`loop_scope` rungs).
has_nested :: fn(g: ^Gen, f: u32) -> bool needs Alloc {
    if g.lir_parents.items.len is 0 {
        for _ in 0..g.prog.s.defs.items.len { g.lir_parents.push(false)! }
        for d in g.prog.s.defs.items {
            if p := d.parent and usize(p) < g.lir_parents.items.len { g.lir_parents.items[usize(p)] = true }
        }
    }
    return usize(f) < g.lir_parents.items.len and g.lir_parents.items[usize(f)]
}

/// Checks that the body `func` of `def` has only what this file translates: lowering leaves
/// an expression it cannot lower (`Tir`) only in code that generic checking left behind.
lir_check :: fn(g: ^Gen, def: ^const Func, func: ^const lir.Func) -> Unsup!() needs sema.Load {
    why := lir_list_unsupported(g, func, func.body) else return ()
    return !unsupported(def.span, str.format("the C back end cannot translate {} in `{}`", why, def.name)!)
}

lir_list_unsupported :: fn(g: ^Gen, func: ^const lir.Func, insts: []const lir.Inst) -> ?string needs sema.Load {
    for i in insts {
        if why := lir_inst_unsupported(g, func, &i) { return why }
    }
    return null
}

lir_inst_unsupported :: fn(g: ^Gen, func: ^const lir.Func, i: ^const lir.Inst) -> ?string needs sema.Load {
    bad: ?string = null
    lir.for_each_value(&i.op, fn(v: lir.Value) {
        if bad is null { bad = lir_value_unsupported(g, v) }
    })
    if why := bad { return why }
    match i.op {
        .Move(_), .Load(_), .AddrOf(_), .Store(_), .Str(_), .Return(_), .Br(_), .BrIf(_), .NoArm, .Unreachable, .Trap(_), .Assert(_) => return null
        .Un(_), .Eq(_) => return null
        .Bin(_) => return null
        .Call(_) => return null
        .Check(_), .Coerce(_), .Variant(_), .Wrap(_), .MakeSlice(_), .IsPresent(_) => return null
        .Block(_, body), .Loop(_, body), .DebugOnly(body), .Defer(_, body) => return lir_list_unsupported(g, func, body)
        .If(_, a, b) => return lir_list_unsupported(g, func, a) else lir_list_unsupported(g, func, b)
        .Aggregate(d, _), .Fill(d, _) => {
            t := func.temps[usize(d)]
            if g.ty.bits_layout(t) is not null { return null }
            if g.ty.repr(t) is not .Blob and g.ty.size(t) > 0 { return "an aggregate held in a scalar" }
            return null
        }
        .TagIs(_) => return null
        .In(_), .BitsGet(_), .BitsSet(_) => return null
        .Builtin(_, op, _) => return if lir_builtin(op) or is_vector_builtin(op) { null } else { str.format("the builtin {}", op)! }
        .Write(_), .FnRef(_), .Template(_), .Closure(_) => return null
        .HandlerRef(_), .Install(_), .Exit(_), .Resume(_), .Cancel(_) => return null
        .With(_, _, install, ?on, body) => {
            // The body of a `with … on` is a C function of its own: it cannot read the C
            // temporaries of the enclosing one.
            if on is not null and reads_outer_temp(body) { return "a `with … on` body reading an outer temporary" }
            return lir_list_unsupported(g, func, install) else lir_list_unsupported(g, func, body)
        }
        .Tir(_) => return "an expression left over from generic checking"
    }
}

/// Whether builtin `op` is generated from its values (`builtin_values`) here.
lir_builtin :: fn(op: tir.Builtin) -> bool => match op {
    .Convert, .Trunc, .Round, .Floor, .Ceil, .Checked, .Sat, .Bits, .Cast, .Addr, .ToPtr, .PtrAdd, .PtrSub, .PtrDiff => true
    .Tag, .FromTag, .Min, .Max, .Clamp, .Abs, .AbsDiff, .IsNan, .IsInf, .IsFinite, .SignBit, .Sqrt, .Fma => true
    .Rotl, .Rotr, .Clz, .Ctz, .Popcount, .Bswap, .Bitreverse, .Pow(_), .CstrLen, .Fence, .BlackBox, .Hash, .Fiber => true
    .Unreachable, .Cover(_), .HeapAlloc, .HeapFree, .CopyElems, .Sys(_), .AllocTag, .AllocCheck => true
    .AtomicLoad, .AtomicStore, .AtomicSwap, .AtomicCas, .AtomicRmw(_), .VolatileLoad, .VolatileStore => true
    .Fiber, .Asm(_) => true
    _ => false
}

/// For each temporary of `func`: the lvalue in static storage of a large constant argument
/// of a direct call (`constarg.gm`), `""` for a part of one, or `null`.
fold_const_args :: fn(fg: ^FnGen, func: ^const lir.Func) -> []?string needs sema.Load {
    g := fg.g
    out := make_fill(T: ?string, func.temps.len, null)!
    defs := make_fill(T: ?^const lir.Inst, func.temps.len, null)!
    calls := list(^const lir.Inst)
    visit_insts(func.body, fn(i: ^const lir.Inst) {
        if d := lir.dst_of(&i.op) { defs[usize(d)] = i }
        if i.op is .Call(_, .Fn(_), _) { calls.push(i)! }
    })
    uses := temp_uses(func)
    for i in calls.items {
        .Call(_, _, args) := i.op else continue
        for a in args {
            .Temp(t) := a else continue
            ty := func.temps[usize(t)]
            if not g.ty.by_ref(ty) or out[usize(t)] is not null { continue }
            if defs[usize(t)] is null or not (defs[usize(t)]?.op is .Aggregate(_)) { continue }
            sc := new_site_const(g, ty)
            parts := list(u32)
            if not g.lir_const_into(func, defs, uses, a, 0, &sc, &parts) { continue }
            for p in parts.items { out[usize(p)] = "" }
            out[usize(t)] = str.format("(*({} *){})", g.ty.cty(ty), g.site_const_storage(sc))!
        }
    }
    return out
}

/// How many times each temporary of `func` is read.
temp_uses :: fn(func: ^const lir.Func) -> []u32 needs Alloc {
    uses := make_fill(func.temps.len, u32(0))!
    visit_insts(func.body, fn(i: ^const lir.Inst) {
        lir.for_each_value(&i.op, fn(v: lir.Value) {
            if .Temp(t) := v { uses[usize(t)] += 1 }
        })
        lir.for_each_place(&i.op, fn(p: ^const lir.Place) {
            if .Deref(t) := p.base { uses[usize(t)] += 1 }
        })
    })
    return uses
}

/// Whether `body` reads a temporary that it does not write.
reads_outer_temp :: fn(body: []const lir.Inst) -> bool needs Alloc {
    written := hash_map.hash_map(u32, bool)
    collect_dsts(body, &written)
    outer := false
    visit_insts(body, fn(i: ^const lir.Inst) {
        lir.for_each_value(&i.op, fn(v: lir.Value) {
            if .Temp(t) := v and written.get(t) is null { outer = true }
        })
        lir.for_each_place(&i.op, fn(p: ^const lir.Place) {
            if .Deref(t) := p.base and written.get(t) is null { outer = true }
        })
    })
    return outer
}

collect_dsts :: fn(body: []const lir.Inst, out: ^hash_map.HashMap(u32, bool)) needs Alloc {
    visit_insts(body, fn(i: ^const lir.Inst) {
        if d := lir.dst_of(&i.op) { out.put(d, true)! }
    })
}

/// Calls `f` on each instruction of `insts`, at any depth.
visit_insts :: fn(insts: []const lir.Inst, f: fn(i: ^const lir.Inst) needs Alloc) needs Alloc {
    for k in 0..insts.len {
        i := &insts[k]
        f(i)
        match i.op {
            .Block(_, b), .Loop(_, b), .DebugOnly(b), .Defer(_, b) => visit_insts(b, f)
            .If(_, a, b) => {
                visit_insts(a, f)
                visit_insts(b, f)
            }
            .With(_, _, a, _, b) => {
                visit_insts(a, f)
                visit_insts(b, f)
            }
            _ => {}
        }
    }
}

lir_value_unsupported :: fn(g: ^Gen, v: lir.Value) -> ?string needs sema.Load {
    .Word(t, bits) := v else return null
    return match g.ty.repr(t) {
        .Int(_, _, _) => null
        .Float(_) => null
        .Bool, .Ptr => null
        _ => if bits is 0 { null } else { "a constant of this type" }
    }
}

/// The state of translating one body.
#allow("needless-pub")
pub LirC :: struct {
    fg: ^FnGen
    f: ^const lir.Func
    /// The C expression of each temporary.
    temps: []string
    /// The C label of each LIR label.
    labels: []string
    /// The temporaries not computed yet (`Lazy`), each computed where it is first needed
    /// as a value, or before an instruction that may write memory, or before a nested
    /// list: until then it can be read in place.
    lazy: []?Lazy
    pending: List(u32)
    /// Whether the call just emitted wrote its result to `FnGen.dest_call_lir`.
    dest_taken: bool = false
    /// Whether functions are nested in this one.
    nested_fns: bool = false
    /// The blocks being translated, innermost last.
    open: List(OpenBlock)
    /// The `with`s whose handlers are being installed, innermost last: the handler context
    /// so far.
    installing: List(Installing)
    /// How many `with … on` bodies (C functions of their own) enclose the instruction.
    outline_level: u32 = 0
    /// The bytes of each temporary that holds a string literal (`Str`), for `@asm`.
    str_bytes: []?[]const u8
    /// The call that the `with` being translated specializes for its handler (`spec.gm`).
    spec_call: ?LirSpec = null
    /// How many blocks were open when the helper being generated started (`lc_outline`):
    /// a branch to one of those leaves the helper.
    run_open: usize = 0
    /// With `-g`, the last line directive emitted (`lc_line`).
    last_line: string = ""
    /// How many times each temporary is read.
    uses: []u32
    /// The temporaries that are large constant arguments of calls, passed from static
    /// storage (`constarg.gm`): the lvalue there, or `""` for a part of such an argument.
    /// Neither is built.
    folded: []?string
}

/// A call of a `with`'s body that runs a clone specialized for the `with`'s handler.
LirSpec :: struct {
    call: ^const lir.Inst
    spec: u32
}

/// A `with` whose `install` list is being translated.
Installing :: struct {
    /// TIR's label of the `with`, and the handler context outside it and so far.
    label: u32
    outer: string
    cur: string
    /// The driver state of a `with … on` (`&gwN`), or `NULL`.
    fw: string = "NULL"
    /// The clone specialization its handler's clauses are called as (`nested_spec`).
    nested: ?u32 = null
}

/// A temporary not computed yet.
Lazy :: union {
    /// A large value loaded from the address `addr` (an expression of temporaries and
    /// locals, which stays valid until something writes).
    Load: (addr: string, t: Ty)
    /// A union variant, with its payload's value.
    Variant: (variant: u32, payload: ?string, t: Ty)
}

/// Generates the body of the function being generated from its LIR `func` (supported, see
/// `lir_unsupported`). The prologue and the epilogue are `gen_body`'s.
lir_body :: fn(fg: ^FnGen, func: ^const lir.Func) -> Unsup!() needs sema.Load {
    // The locals lowering adds are C locals.
    for i in fg.def.locals.len..func.locals.len {
        if fg.in_frame[i] { continue }
        l := &func.locals[i]
        fg.temp_bytes += l.size
        fg.linef("{} {};", fg.g.ty.cty(l.ty), fg.local_lv(i.trunc(u32)))
    }
    temps := make_fill(func.temps.len, "")!
    labels := list(string)
    for _ in 0..func.labels { labels.push(str.format("gm_lb{}", fg.fresh())!)! }
    folded := fold_const_args(fg, func)
    c := LirC(fg: fg, f: func, folded: folded, temps: temps, labels: labels.items, lazy: make_fill(func.temps.len, ?Lazy(null))!, str_bytes: make_fill(T: ?[]const u8, func.temps.len, null)!, uses: temp_uses(func), pending: list(u32), nested_fns: has_nested(fg.g, fg.fid), open: list(OpenBlock), installing: list(Installing))
    fg.lirc = &c
    // The function's body is a block: its defers run when it returns.
    fg.scopes.push(fg.block_scope())!
    r := c.lc_list(func.body)
    popped := fg.scopes.pop()?
    try r
    fg.end_scope(popped, true)
    fg.lirc = null
}

/// A block being translated: its label and how many scopes enclosed it.
OpenBlock :: struct {
    label: u32
    depth: usize
    /// `LirC.outline_level` where it is.
    level: u32 = 0
}

/// The label in `gm_unw` of an exit to the end of LIR block `l` (`Br` across a `defer`),
/// apart from the labels of TIR's loops and `with`s.
exit_label :: fn(l: u32) -> u32 => 0x4000_0000 + l

/// Whether `insts` (at any depth) has a `Defer` and a `Br` to `l`, or a `Br` to `l` in the
/// body of a `with … on`: a branch to the end of block `l` that may cross a deferred
/// statement or leave a C function, which needs a rung of the ladder.
crosses_defer :: fn(insts: []const lir.Inst, l: u32) -> bool {
    found := (defer_: false, br: false, out: false)
    scan_defer_br(insts, l, false, &found)
    return (found.defer_ and found.br) or found.out
}

scan_defer_br :: fn(xs: []const lir.Inst, l: u32, on: bool, found: ^(defer_: bool, br: bool, out: bool)) {
    for x in xs {
        match x.op {
            .Defer(_) => { found.defer_ = true }
            .Br(t), .BrIf(_, _, t) => if t is l {
                found.br = true
                if on { found.out = true }
            }
            .Block(_, b), .Loop(_, b), .DebugOnly(b) => scan_defer_br(b, l, on, found)
            .If(_, a, b) => {
                scan_defer_br(a, l, on, found)
                scan_defer_br(b, l, on, found)
            }
            .With(_, _, a, ?w, b) => {
                scan_defer_br(a, l, on, found)
                scan_defer_br(b, l, on or w is not null, found)
            }
            _ => {}
        }
    }
}

/// Translates the body of a deferred statement, which is emitted once per way out of its
/// block: the labels it defines get new C names each time.
lc_defer_list :: fn(c: ^LirC, insts: []const lir.Inst) -> Unsup!() needs sema.Load {
    c.lc_relabel(insts)
    try c.lc_list(insts)
}

lc_relabel :: fn(c: ^LirC, xs: []const lir.Inst) needs Alloc {
    for x in xs {
        match x.op {
            .Block(l, b), .Loop(l, b) => {
                c.labels[usize(l)] = str.format("gm_lb{}", c.fg.fresh())!
                c.lc_relabel(b)
            }
            .DebugOnly(b), .Defer(_, b) => c.lc_relabel(b)
            .If(_, a, b) => {
                c.lc_relabel(a)
                c.lc_relabel(b)
            }
            .With(l, _, a, _, b) => {
                c.labels[usize(l)] = str.format("gm_lb{}", c.fg.fresh())!
                c.lc_relabel(a)
                c.lc_relabel(b)
            }
            _ => {}
        }
    }
}

/// A jump to another frame (`lir.Exit`), as `break_expr`, `continue_expr` and
/// `return_expr` make it.
lc_exit :: fn(c: ^LirC, kind: lir.Exit, v: ?lir.Value) -> Unsup!() needs sema.Load {
    fg := c.fg
    match kind {
        .Break(target) => match target {
            .Label(levels, lbl) => {
                if x := v and fg.is_with_label(levels, lbl) {
                    vt := lir.value_type(c.f, x)
                    if not fg.g.ty.is_never(vt) { fg.linef("{} = {};", fg.frame_field(levels, str.format("w{}", lbl)!), c.lc_val(x)) }
                }
                fr, _ := fg.frame_up(levels)
                fg.start_exit(.Break, fr, str.format("{}", lbl)!, "0")
            }
            .InstallingWith => {
                if x := v {
                    vt := lir.value_type(c.f, x)
                    if not fg.g.ty.is_void(vt) { fg.store(vt, "inst->result", c.lc_val(x)) }
                }
                fg.start_exit(.Break, "inst->with_frame", "inst->with_label", "0")
            }
        }
        .Continue(target) => match target {
            .Label(levels, lbl) => {
                fr, _ := fg.frame_up(levels)
                fg.start_exit(.Continue, fr, str.format("{}", lbl)!, "0")
            }
            // In a clause, `continue` ends the clause (the next iteration of a `for`).
            .InstallingWith => {
                fg.linef("F.ret = {};", fg.unit())
                fg.start_exit(.Return, "(&F.h)", "0", "0")
            }
        }
        .Return(levels) => {
            ret := fg.target_ret(levels)
            is_err := "0"
            if x := v {
                vt := lir.value_type(c.f, x)
                xv := c.lc_val(x)
                if fg.g.ty.kind(ret) is .Result(_) and not fg.g.ty.is_never(vt) { is_err = fg.res_is_err(ret, fg.addr_of(vt, xv)) }
                flag := fg.tmp(fg.g.ty.bool_ty(), is_err)
                if not fg.g.ty.is_never(vt) { fg.linef("{} = {};", fg.frame_field(levels, "ret"), xv) }
                is_err = flag
            }
            fr, _ := fg.frame_up(levels)
            fg.start_exit(.Return, fr, "0", is_err)
        }
    }
}

/// Whether `insts` has a `Defer` directly in it.
has_defer :: fn(insts: []const lir.Inst) -> bool {
    for x in insts {
        if x.op is .Defer(_) { return true }
    }
    return false
}

/// A jump to the end of LIR block `l`: through the ladder if it crosses deferred statements.
lc_br :: fn(c: ^LirC, l: u32) needs sema.Load {
    fg := c.fg
    i := c.open.items.len
    while i > 0 {
        i -= 1
        o := c.open.items[i]
        if o.label is not l { continue }
        // Out of the body of a `with … on`, to the rung of the block (`crosses_defer`).
        if o.level < c.outline_level {
            fg.start_exit(.Break, "(&F.h)", str.format("{}", exit_label(l))!, "0")
            return ()
        }
        crossing := false
        for j in o.depth..fg.scopes.items.len {
            s := &fg.scopes.items[j]
            if s.kind is .Block and s.defers.items.len > 0 { crossing = true }
        }
        if crossing {
            fg.start_exit(.Break, "(&F.h)", str.format("{}", exit_label(l))!, "0")
            return ()
        }
        // Out of a helper (`lc_outline`): the caller jumps.
        if i < c.run_open {
            fg.jump(c.labels[usize(l)], null)
            return ()
        }
        break
    }
    fg.linef("goto {};", c.labels[usize(l)])
}

lc_list :: fn(c: ^LirC, insts: []const lir.Inst) -> Unsup!() needs sema.Load {
    mark := c.pending.items.len
    if insts.len > 1 and list_weight(insts, LONG_LIST + 1) > LONG_LIST {
        try c.lc_segments(insts)
    } else {
        try c.lc_range(insts, 0, insts.len, null)
    }
    // What the list did not use is dead past it.
    c.pending.truncate(mark)
}

/// Instructions `a..b` of `insts`. Each temporary in `hoist` (by index) is copied to the
/// C variable named there once it is computed, which is declared outside the C block the
/// range is in.
lc_range :: fn(c: ^LirC, insts: []const lir.Inst, a: usize, b: usize, hoist: ?^hash_map.HashMap(u32, string)) -> Unsup!() needs sema.Load {
    i := a
    while i < b {
        c.lc_line(insts[i].span)
        // A large result goes straight to where the next instruction puts it.
        if i + 1 < insts.len {
            if dest := c.lc_call_dest(&insts[i], &insts[i + 1]) {
                c.lc_flush()
                c.fg.dest_call_lir = dest
                c.dest_taken = false
                try c.lc_inst(&insts[i])
                c.fg.dest_call_lir = null
                // A call that cannot write there (of a foreign function) left it.
                if not c.dest_taken {
                    i += 1
                    continue
                }
                if insts[i + 1].op is .Return(_) { c.fg.jump("gm_fdone", null) }
                if h := hoist { c.lc_hoisted(h, &insts[i + 1]) }
                i += 2
                continue
            }
        }
        try c.lc_inst(&insts[i])
        if h := hoist { c.lc_hoisted(h, &insts[i]) }
        i += 1
    }
}

/// With `-g`, the line of the instruction at `span` if it is not the line already given.
lc_line :: fn(c: ^LirC, span: source.Span) needs sema.Load {
    if not c.fg.g.opts.debug_info { return }
    d := c.fg.g.line_directive(span) else return
    if d is c.last_line { return }
    c.fg.out.write("{}\n", d)!
    c.last_line = d
}

/// Copies the value instruction `i` wrote to the C variable it is hoisted to, if it is.
lc_hoisted :: fn(c: ^LirC, hoist: ^hash_map.HashMap(u32, string), i: ^const lir.Inst) needs sema.Load {
    d := lir.dst_of(&i.op) else return
    v := hoist.get(d) else return
    c.lc_compute(d)
    c.fg.linef("{} = {};", v, c.temps[usize(d)])
    c.temps[usize(d)] = v
}

/// The number of instructions in `insts`, nested ones included, counting up to `cap`.
list_weight :: fn(insts: []const lir.Inst, cap: u32) -> u32 {
    n: u32 = 0
    for k in 0..insts.len {
        if n >= cap { return cap }
        n += inst_weight(&insts[k], cap - n)
    }
    return n.min(cap)
}

/// The number of instructions in `i`, nested ones included, counting up to `cap`.
inst_weight :: fn(i: ^const lir.Inst, cap: u32) -> u32 {
    n: u32 = 1
    match i.op {
        .Block(_, b), .Loop(_, b), .DebugOnly(b), .Defer(_, b) => { n += list_weight(b, cap) }
        .If(_, x, y), .With(_, _, x, _, y) => {
            n += list_weight(x, cap)
            if n < cap { n += list_weight(y, cap - n.min(cap)) }
        }
        _ => {}
    }
    return n.min(cap)
}

/// A list longer than this, in instructions (`list_weight`), is emitted in segments.
LONG_LIST: u32 : 256

/// The weight of a segment of a long list, each a C block of its own: the temporaries
/// live in any C block stay few, which the C compilers' time depends on (Clang tracks the
/// lifetime of each variable of a scope at every branch out of it, so a chain of tens of
/// thousands of operations in one block takes minutes).
SEG_WEIGHT: u32 : 64

/// The weight of a segment moved into a helper in a long function (`outline.gm`), and the
/// least weight worth moving.
LIR_RUN_WEIGHT: u32 : 600
LIR_MIN_RUN: u32 : 60

/// A long list (`LONG_LIST`), in segments: each is a C block whose temporaries read later
/// are copied to variables declared before it, or, in a function whose long runs move to
/// helpers (`FnGen.split_runs`), a helper when no temporary crosses its ends.
lc_segments :: fn(c: ^LirC, insts: []const lir.Inst) -> Unsup!() needs sema.Load {
    fg := c.fg
    n := insts.len
    // The last instruction that reads each temporary written at the top of this list.
    defined := list((t: u32, at: usize))
    last := hash_map.hash_map(u32, usize)
    for k in 0..n {
        visit_insts(insts[k..k + 1], fn(x: ^const lir.Inst) {
            lir.for_each_value(&x.op, fn(v: lir.Value) {
                if .Temp(t) := v { last.put(t, k)! }
            })
            lir.for_each_place(&x.op, fn(p: ^const lir.Place) {
                if .Deref(t) := p.base { last.put(t, k)! }
            })
        })
        if d := lir.dst_of(&insts[k].op) { defined.push((t: d, at: k))! }
    }
    // How many of them are live across the point before each instruction.
    live := make_fill(n + 1, i64(0))!
    for x in defined.items {
        u := last.get(x.t) else continue
        if u <= x.at { continue }
        live[x.at + 1] += 1
        if u + 1 <= n { live[u + 1] -= 1 }
    }
    for k in 1..n + 1 { live[k] += live[k - 1] }
    // A helper reaches the locals through the frame: all of them must live there.
    split := fg.split_runs and fg.runs.items.len is 0 and false not in fg.in_frame
    target := if split { LIR_RUN_WEIGHT } else { SEG_WEIGHT }
    start: usize = 0
    acc: u32 = 0
    for k in 0..n {
        w := inst_weight(&insts[k], target * 4)
        // An instruction too big for a run stays here, alone: its own lists are split.
        if split and w > target {
            if start < k { try c.lc_segment(insts, start, k, &last, live, split, acc) }
            try c.lc_segment(insts, k, k + 1, &last, live, false, w)
            start = k + 1
            acc = 0
            continue
        }
        acc += w
        end := k + 1
        cut := end is n
        if not cut and acc >= target and c.lc_call_dest(&insts[k], &insts[end]) is null {
            cut = live[end] is 0 or acc >= target * 4
        }
        if not cut { continue }
        try c.lc_segment(insts, start, end, &last, live, split, acc)
        start = end
        acc = 0
    }
}

/// Segment `a..b` of a long list (`lc_segments`) of weight `w`: a helper if `split` allows
/// and no temporary crosses its ends, else a C block. `last` is the last instruction that
/// reads each temporary, `live` how many temporaries are live before each instruction.
lc_segment :: fn(c: ^LirC, insts: []const lir.Inst, a: usize, b: usize, last: ^hash_map.HashMap(u32, usize), live: []const i64, split: bool, w: u32) -> Unsup!() needs sema.Load {
    fg := c.fg
    if split and live[a] is 0 and live[b] is 0 and w >= LIR_MIN_RUN and not reads_outer_temp(insts[a..b]) {
        return c.lc_outline(insts, a, b)
    }
    // The temporaries read past the segment, declared before it.
    hoist := hash_map.hash_map(u32, string)
    for j in a..b {
        d := lir.dst_of(&insts[j].op) else continue
        u := last.get(d) else continue
        if u < b { continue }
        t := c.f.temps[usize(d)]
        if fg.g.ty.size(t) is 0 or fg.g.ty.is_never(t) { continue }
        v := str.format("gm_h{}", fg.fresh())!
        fg.temp_bytes += fg.g.ty.size(t)
        fg.linef("{} {};", fg.g.ty.cty(t), v)
        hoist.put(d, v)!
    }
    c.lc_flush()
    fg.line("{")
    fg.indent += 1
    r := c.lc_range(insts, a, b, &hoist)
    c.lc_flush()
    fg.indent -= 1
    fg.line("}")
    try r
}

/// Moves instructions `a..b` of `insts`, which read no temporary from outside them and
/// write none read after them, into a helper (`outline_code`).
lc_outline :: fn(c: ^LirC, insts: []const lir.Inst, a: usize, b: usize) -> Unsup!() needs sema.Load {
    c.lc_flush()
    saved := c.run_open
    c.run_open = c.open.items.len
    c.last_line = ""
    r := c.fg.outline_code(fn() -> Unsup!() needs sema.Load {
        try c.lc_range(insts, a, b, null)
        c.lc_flush()
    })
    c.last_line = ""
    c.run_open = saved
    try r
}

/// Where the large result of the call `a` goes when `b` only returns it or stores it in a
/// local: the caller's destination (`gm_out`) or the local, which the call cannot see.
lc_call_dest :: fn(c: ^LirC, a: ^const lir.Inst, b: ^const lir.Inst) -> ?string needs sema.Load {
    .Call(?dst, callee, _) := a.op else return null
    d := dst else return null
    if callee is not .Fn(_) { return null }
    t := c.f.temps[usize(d)]
    fg := c.fg
    if not fg.g.ty.by_ref(t) { return null }
    match b.op {
        .Return(?v) => {
            x := v else return null
            if x is not .Temp(d) or not fg.g.ty.by_ref(fg.def.ret) or fg.def.ret is not t or not fg.no_defers() or fg.outlined { return null }
            return str.format("(*({} *)gm_out)", fg.g.ty.cty(t))!
        }
        .Store(p, x) => {
            if x is not .Temp(d) { return null }
            .Local(l) := p.base else return null
            if p.proj.len is not 0 or fg.is_borrowed(l) or c.f.locals[usize(l)].ty is not t { return null }
            loc := &c.f.locals[usize(l)]
            if loc.addressed or loc.captured { return null }
            return fg.local_lv(l)
        }
        _ => return null
    }
}

/// A nested list, as a C block.
lc_nested :: fn(c: ^LirC, insts: []const lir.Inst) -> Unsup!() needs sema.Load {
    c.fg.indent += 1
    try c.lc_list(insts)
    c.fg.indent -= 1
}

lc_val :: fn(c: ^LirC, v: lir.Value) -> string needs sema.Load {
    fg := c.fg
    match v {
        .Temp(t) => {
            c.lc_compute(t)
            return c.temps[usize(t)]
        }
        .Word(t, bits) => return word_lit(fg, t, bits)
        .Zero(t) => return fg.zero(t)
        .Uninit(t) => {
            n := fg.tmp_uninit(t)
            if fg.g.opts.debug { fg.linef("memset(&{}, 0xAA, sizeof {});", n, n) }
            return n
        }
        .Big(t, bits) => {
            .Int(signed, _, storage) := fg.g.ty.repr(t) else return fg.zero(t)
            return str.format("(({})(((unsigned __int128){}ULL << 64) | {}ULL))", int_cty(signed, storage), (bits >> 64).trunc(u64), bits.trunc(u64))!
        }
    }
}

/// Computes temporary `t` if it is not computed yet.
lc_compute :: fn(c: ^LirC, t: u32) needs sema.Load {
    x := c.lazy[usize(t)] else return
    c.lazy[usize(t)] = null
    c.temps[usize(t)] = match x {
        .Load(a, ty) => c.fg.load(ty, a)
        .Variant(v, ?p, ty) => c.fg.make_variant(ty, usize(v), p)
    }
}

/// Computes every temporary not computed yet.
lc_flush :: fn(c: ^LirC) needs sema.Load => c.lc_flush_except(null)

/// Computes every temporary not computed yet but `keep`, which stays as it is.
lc_flush_except :: fn(c: ^LirC, keep: ?u32) needs sema.Load {
    ks := list(u32)
    if k := keep { ks.push(k)! }
    c.lc_flush_keeping(ks.items)
}

/// Computes every temporary not computed yet but those in `keep`, which stay as they are.
lc_flush_keeping :: fn(c: ^LirC, keep: []const u32) needs sema.Load {
    for t in c.pending.items {
        if t not in keep { c.lc_compute(t) }
    }
    c.pending.clear()
    for k in keep {
        if c.lazy[usize(k)] is not null and k not in c.pending.items { c.pending.push(k)! }
    }
}

/// The value `v` as an argument of a call or write that reads it before anything is written:
/// a large value not loaded yet is read in place, through an lvalue at its address.
lc_arg :: fn(c: ^LirC, v: lir.Value) -> string needs sema.Load {
    if .Temp(t) := v {
        if x := c.lazy[usize(t)] {
            if .Load(a, ty) := x { return str.format("(*({} *){})", c.fg.g.ty.cty(ty), a)! }
        }
    }
    return c.lc_val(v)
}

/// Whether instruction `op` leaves memory as it is, so the loads not computed yet may
/// wait past it.
reads_only :: fn(op: ^const lir.Op) -> bool => match op^ {
    .Move(_), .Load(_), .AddrOf(_), .Bin(_), .Un(_), .Eq(_), .Coerce(_), .Aggregate(_), .Str(_), .Fill(_) => true
    .MakeSlice(_), .Variant(_), .Wrap(_), .FnRef(_), .Template(_), .IsPresent(_), .TagIs(_), .Check(_), .Br(_), .BrIf(_) => true
    .In(_), .BitsGet(_), .BitsSet(_) => true
    _ => false
}

/// The address the value `v` is at: in place if it is a load not computed yet.
lc_addr_of :: fn(c: ^LirC, v: lir.Value) -> string needs sema.Load {
    if .Temp(t) := v {
        if x := c.lazy[usize(t)] {
            if .Load(a, _) := x { return a }
        }
    }
    return c.fg.addr_of(lir.value_type(c.f, v), c.lc_val(v))
}

/// The variant a value is known to be and its payload, if it is a variant not built yet.
lc_lazy_variant :: fn(c: ^LirC, v: lir.Value) -> ?(variant: u32, payload: ?string) {
    .Temp(t) := v else return null
    x := c.lazy[usize(t)] else return null
    .Variant(variant, ?payload, _) := x else return null
    return (variant: variant, payload: payload)
}

/// The C literal of type `t` with the bits `bits` (`lir.Value.Word`).
word_lit :: fn(fg: ^FnGen, t: Ty, bits: u64) -> string needs sema.Load {
    match fg.g.ty.repr(t) {
        .Int(signed, _, storage) => {
            ct := int_cty(signed, storage)
            if signed {
                x := bits.bits(i64)
                if x is -9223372036854775808 { return str.format("(({})(-9223372036854775807LL - 1))", ct)! }
                return str.format("(({}){}LL)", ct, x)!
            }
            return str.format("(({}){}ULL)", ct, bits)!
        }
        .Float(w) => {
            x: f64 = match w {
                16 => ratio.f16_value(bits.trunc(u16))
                32 => f64(bits.trunc(u32).bits(f32))
                _ => bits.bits(f64)
            }
            return float_lit(w, x)
        }
        .Bool => return if bits is 0 { "((uint8_t)0)" } else { "((uint8_t)1)" }
        .Ptr => return if bits is 0 { "((void *)0)" } else { str.format("((void *)(uintptr_t){}ULL)", bits)! }
        _ => return fg.zero(t)
    }
}

/// Sets temporary `d` to the C expression `v`, in a C temporary of its own.
lc_set :: fn(c: ^LirC, d: u32, v: string) needs sema.Load {
    c.temps[usize(d)] = c.fg.tmp(c.f.temps[usize(d)], v)
}

/// The type of local `l` of the body.
lc_local_ty :: fn(c: ^LirC, l: u32) -> Ty => c.f.locals[usize(l)].ty

/// The C lvalue of place `p` if it is a local of this function as a whole (not read in
/// place from the caller's argument).
lc_whole_local :: fn(c: ^LirC, p: ^const lir.Place) -> ?string needs Alloc {
    .Local(l) := p.base else return null
    if p.proj.len is not 0 or c.fg.is_borrowed(l) { return null }
    return c.fg.local_lv(l)
}

/// The type of the value at place `p`.
lc_place_type :: fn(c: ^LirC, p: ^const lir.Place, span: source.Span) -> Unsup!Ty needs sema.Load {
    return lir.place_type(c.fg.g.prog.s, c.f, p) else !unsupported(span, "a place of unknown type")
}

/// The result type of a function value of type `t`.
fn_ret :: fn(fg: ^FnGen, t: Ty) -> Ty needs Alloc => match fg.g.ty.kind(t) {
    .Fn(sig), .FnPtr(sig) => sig.ret
    _ => fg.g.ty.unit_ty()
}

/// Builtin `op` of type `t` on `args` (`lir_builtin`).
lc_builtin :: fn(c: ^LirC, span: source.Span, t: Ty, op: tir.Builtin, args: []const lir.Value) -> Unsup!string needs sema.Load {
    fg := c.fg
    vals := list(string)
    tys := list(Ty)
    lanes := list(u64)
    for k, a in enumerate(args) {
        if op is .Shuffle and k > 0 {
            lanes.push(if .Word(_, bits) := a { bits } else { 0 })!
            continue
        }
        vals.push(c.lc_val(a))!
        tys.push(lir.value_type(c.f, a))!
    }
    if is_vector_builtin(op) { return try fg.vector_builtin_values(span, t, op, tys.items, vals.items, lanes.items) }
    loc := fg.g.src_loc(span)
    match op {
        .Unreachable => {
            fg.linef("gm_trap(\"reached `@unreachable()`\", {});", loc)
            return fg.zero(t)
        }
        .Cover(id) => {
            fg.linef("GM_COVER({});", id)
            return fg.unit()
        }
        .HeapAlloc => {
            a := vals.items[1]
            fg.linef("if (({}) == 0 || (({}) & (({}) - 1)) != 0) gm_trap(\"allocation alignment is not a power of two\", {});", a, a, a, loc)
            p := fg.tmp(fg.g.ty.s.tys.intern(.Rawptr), str.format("gm_heap_alloc({}, {})", vals.items[0], a)!)
            return fg.tmp(t, p)
        }
        .HeapFree => {
            fg.linef("gm_heap_free({}, {}, {}, {});", vals.items[0], vals.items[1], vals.items[2], loc)
            return fg.unit()
        }
        .CopyElems => {
            .Slice(_, elem) := fg.g.ty.kind(tys.items[0]) else return fg.unit()
            d := fg.addr_of(tys.items[0], vals.items[0])
            s := fg.addr_of(tys.items[1], vals.items[1])
            n := fg.slice_len(d)
            fg.linef("if ({} != 0) memmove({}, {}, {} * {});", n, slice_ptr(d), slice_ptr(s), n, fg.g.ty.size(elem))
            return fg.unit()
        }
        .Sys(sop) => return fg.sys_values(t, sop, tys.items, vals.items)
        .Asm(counts) => {
            // As `arith_asm`: the template, constraints and clobbers are string literals.
            text :: fn(k: usize) -> string {
                .Temp(x) := args[k] else return "\"\""
                return c_string(c.str_bytes[usize(x)] else "")
            }
            no := usize(counts.outputs)
            ni := usize(counts.inputs)
            outs := list(string)
            for i in 0..no {
                .Ptr(_, pointee) := fg.g.ty.kind(tys.items[2 + 2 * i]) else @unreachable()
                outs.push(str.format("{}(*({} *){})", text(1 + 2 * i), fg.g.ty.cty(pointee), vals.items[2 + 2 * i])!)!
            }
            ins := list(string)
            for i in 0..ni { ins.push(str.format("{}({})", text(1 + 2 * (no + i)), vals.items[2 + 2 * (no + i)])!)! }
            clobbers := list(string)
            for k in (1 + 2 * (no + ni))..args.len { clobbers.push(text(k))! }
            fg.linef("__asm__ volatile ({} : {} : {} : {});", text(0), str.join(outs.items, ", ")!, str.join(ins.items, ", ")!, str.join(clobbers.items, ", ")!)
            return fg.unit()
        }
        .Fiber => {
            .FnPtr(sig) := fg.g.ty.kind(tys.items[0]) else return !unsupported(span, "`@fiber` with this function")
            return fg.fiber_values(span, t, &sig, vals.items[0], tys.items[1], vals.items[1], tys.items[2], vals.items[2])
        }
        .AllocTag, .AllocCheck => return fg.alloc_tag_values(span, op, tys.items, vals.items)
        _ => return try fg.builtin_values(span, t, op, tys.items, vals.items)
    }
}

/// The local at the base of place `p` (which is in a local).
local_of :: fn(p: ^const lir.Place) -> u32 => if .Local(l) := p.base { l } else { 0 }

/// The address (`uint8_t *`) of place `p`.
lc_addr :: fn(c: ^LirC, p: ^const lir.Place, span: source.Span) -> Unsup!string needs sema.Load {
    fg := c.fg
    a: string = match p.base {
        .Local(l) => fg.local_addr(l)
        .Upvar(levels, l) => str.format("((uint8_t *)&{})", fg.frame_field(levels, str.format("l{}", l)!))!
        .Global(decl) => try fg.g.global_addr(decl, span)
        .Const(_, cspan, t) => str.format("((uint8_t *){})", try fg.g.const_storage(cspan, t, span))!
        .Deref(t) => str.format("((uint8_t *){})", c.temps[usize(t)])!
    }
    for x in p.proj {
        match x {
            .Field(_, off), .Payload(off, _) => if off is not 0 { a = str.format("({} + {})", a, off)! }
            .Elem(i, size), .Step(i, size) => { a = str.format("({} + (uintptr_t){} * {})", a, c.lc_val(i), size)! }
            .Deref => { a = str.format("((uint8_t *)GM_LD(void *, {}))", a)! }
        }
    }
    return a
}

lc_inst :: fn(c: ^LirC, i: ^const lir.Inst) -> Unsup!() needs sema.Load {
    keep := list(u32)
    if not reads_only(&i.op) {
        // A value stored or returned is read in place as it is written.
        match i.op {
            .Store(_, .Temp(t)), .Return(.Temp(t)) => keep.push(t)!
            // Large arguments are read in place (`lc_arg`).
            .Call(_, _, args), .Write(_, _, _, args, _) => for a in args {
                if .Temp(t) := a and c.uses[usize(t)] is 1 { keep.push(t)! }
            }
            _ => {}
        }
        c.lc_flush_keeping(keep.items)
    }
    r := c.lc_op(i)
    // A value read in place that nothing reads later is never loaded.
    for k in keep.items {
        if c.uses[usize(k)] <= 1 and c.lazy[usize(k)] is not null {
            c.lazy[usize(k)] = null
            if at := c.pending.items.index_of(k) { _ = c.pending.remove(at) }
        }
    }
    try r
}

lc_op :: fn(c: ^LirC, i: ^const lir.Inst) -> Unsup!() needs sema.Load {
    fg := c.fg
    span := i.span
    if d := lir.dst_of(&i.op) {
        if lv := c.folded[usize(d)] {
            c.temps[usize(d)] = lv
            return ()
        }
    }
    match i.op {
        .Move(d, v) => c.lc_set(d, c.lc_val(v))
        .Load(d, p) => {
            t := c.f.temps[usize(d)]
            lv := c.lc_whole_local(&p)
            if x := lv and c.lc_local_ty(local_of(&p)) is t and not fg.g.ty.by_ref(t) {
                c.lc_set(d, x)
            } else {
                a := try c.lc_addr(&p, span)
                if fg.g.ty.by_ref(t) {
                    c.lazy[usize(d)] = .Load(a, t)
                    c.pending.push(d)!
                } else {
                    c.temps[usize(d)] = fg.load(t, a)
                }
            }
        }
        // `x: T = ---` fills the place where it is (Debug: with 0xAA, §4.4), without a copy.
        .Store(p, .Uninit(t)) => if fg.g.opts.debug and fg.g.ty.size(t) > 0 {
            a := try c.lc_addr(&p, span)
            fg.linef("memset({}, 0xAA, {});", a, fg.g.ty.size(t))
        }
        .Store(p, v) => {
            if .Temp(t) := v and c.lazy[usize(t)] is not null and c.lc_lazy_variant(v) is null {
                // A large value copied from one place to another.
                from := c.lc_addr_of(v)
                a := try c.lc_addr(&p, span)
                fg.linef("memmove({}, {}, {});", a, from, fg.g.ty.size(lir.value_type(c.f, v)))
                return ()
            }
            x := c.lc_val(v)
            if lv := c.lc_whole_local(&p) {
                fg.linef("{} = {};", lv, x)
            } else {
                a := try c.lc_addr(&p, span)
                fg.store(lir.value_type(c.f, v), a, x)
            }
        }
        .AddrOf(d, p) => {
            a := try c.lc_addr(&p, span)
            c.lc_set(d, str.format("(void *){}", a)!)
        }
        .Bin(d, op, a, b) => {
            t := c.f.temps[usize(d)]
            lt := lir.value_type(c.f, a)
            x := c.lc_val(a)
            y := c.lc_val(b)
            if fg.g.ty.is_vector(t) {
                c.temps[usize(d)] = try fg.vector_binary_value(span, t, op, x, y)
            } else if op in (.Lt, .Le, .Gt, .Ge) and not (fg.g.ty.repr(lt) in (.Int(_, _, _), .Float(_), .Bool, .Ptr)) {
                // As `binary`: the ordering helper of the type.
                less := fg.g.helpers.less_fn(&fg.g.ty, lt)
                eq := fg.g.helpers.eq_fn(&fg.g.ty, lt)
                pa := fg.addr_of(lt, x)
                pb := fg.addr_of(lt, y)
                cmp: string = match op {
                    .Lt => str.format("{}({}, {})", less, pa, pb)!
                    .Gt => str.format("{}({}, {})", less, pb, pa)!
                    .Le => str.format("({}({}, {}) || {}({}, {}))", less, pa, pb, eq, pa, pb)!
                    _ => str.format("({}({}, {}) || {}({}, {}))", less, pb, pa, eq, pb, pa)!
                }
                c.lc_set(d, str.format("(uint8_t){}", cmp)!)
            } else if op in (.Lt, .Le, .Gt, .Ge) {
                c.lc_set(d, str.format("({} {} {})", x, tir.binop_symbol(op), y)!)
            } else if .Float(_) := fg.g.ty.repr(lt) {
                c.lc_set(d, str.format("({} {} {})", x, tir.binop_symbol(op), y)!)
            } else {
                c.temps[usize(d)] = try fg.int_binary(span, t, op, lt, x, y)
            }
        }
        .Un(d, op, a) => if fg.g.ty.is_vector(c.f.temps[usize(d)]) {
            c.temps[usize(d)] = try fg.vector_unary_value(span, c.f.temps[usize(d)], op, c.lc_val(a))
        } else {
            c.temps[usize(d)] = try fg.unary_value(span, c.f.temps[usize(d)], op, lir.value_type(c.f, a), c.lc_val(a))
        }
        .Eq(d, negated, a, b) => {
            t := lir.value_type(c.f, a)
            // `x is .V` of a variant without a payload compares the tag in place.
            var := c.lc_lazy_variant(b)
            other := a
            if var is null {
                var = c.lc_lazy_variant(a)
                other = b
            }
            if v := var {
                .Union(tag, variants) := fg.adt_def(t).kind else @unreachable()
                at := c.lc_addr_of(other)
                offs := fg.g.ty.offsets(t)
                tv := fg.load(tag, str.format("({} + {})", at, offs[0])!)
                cond: string = str.format("({} == {})", tv, fg.int_lit(tag, variants[usize(v.variant)].tag))!
                if p := v.payload {
                    // The payload is compared only when the tags agree.
                    pt := variants[usize(v.variant)].payload else @unreachable()
                    r := fg.tmp(fg.g.ty.bool_ty(), str.format("(uint8_t){}", cond)!)
                    fg.linef("if ({}) {{", r)
                    fg.indent += 1
                    pv := fg.load(pt, str.format("({} + {})", at, offs[1])!)
                    fg.linef("{} = (uint8_t){};", r, fg.equal(pt, pv, p))
                    fg.indent -= 1
                    fg.line("}")
                    cond = r
                }
                c.lc_set(d, str.format("(uint8_t)({}{})", if negated { "!" } else { "" }, cond)!)
                return ()
            }
            e := fg.equal(t, c.lc_val(a), c.lc_val(b))
            c.lc_set(d, str.format("({}{})", if negated { "!" } else { "" }, e)!)
        }
        .Call(?d, callee, args) => {
            // The callee is computed before the arguments (§7.1).
            cv: ?string = null
            if .Value(v) := callee { cv = c.lc_val(v) }
            vals := list(string)
            tys := list(Ty)
            for a in args {
                vals.push(c.lc_arg(a))!
                tys.push(lir.value_type(c.f, a))!
            }
            rt := fg.g.ty.unit_ty()
            if x := d { rt = c.f.temps[usize(x)] }
            fg.call_site(span)
            r := match callee {
                .Fn(f) => {
                    if d is null { rt = fg.g.prog.func(f).ret }
                    if sc := c.spec_call and sc.call is i {
                        c.spec_call = null
                        fg.spec_next = sc.spec
                    }
                    fg.call_dest = fg.dest_call_lir
                    x := try fg.call_fn(rt, f, vals.items)
                    // `result_var` takes the destination when the call writes there.
                    c.dest_taken = fg.dest_call_lir is not null and fg.call_dest is null
                    fg.call_dest = null
                    x
                }
                .Value(v) => {
                    vt := lir.value_type(c.f, v)
                    if d is null { rt = fn_ret(fg, vt) }
                    match fg.g.ty.kind(vt) {
                        .Fn(_) => try fg.call_closure(cv?, vt, vals.items, tys.items, rt)
                        .FnPtr(sig) => {
                            effectful := not fg.g.within_sys(&sig.effects)
                            x := fg.call_indirect(cv?, "NULL", fg.cx, vals.items, tys.items, rt, effectful, sig.win64)
                            // A second-class argument may leave the callee by a non-local exit.
                            if effectful or fg.g.takes_fn(tys.items) { fg.check_unwind() }
                            x
                        }
                        _ => return !unsupported(span, "calling this value")
                    }
                }
                .Perform(eff, op) => {
                    if d is null { rt = fg.g.prog.s.effects.items[usize(eff.eff)].ops[usize(op)].ret }
                    try fg.perform(span, &eff, op, vals.items, tys.items, rt)
                }
            }
            if x := d { c.temps[usize(x)] = r }
        }
        .Coerce(d, kind, v) => {
            c.temps[usize(d)] = try fg.coerce_value(span, c.f.temps[usize(d)], kind, lir.value_type(c.f, v), c.lc_val(v))
        }
        .Builtin(?d, op, args) => {
            t := fg.g.ty.unit_ty()
            if x := d { t = c.f.temps[usize(x)] }
            r := try c.lc_builtin(span, t, op, args)
            if x := d { c.temps[usize(x)] = r }
        }
        .Aggregate(d, items) => {
            t := c.f.temps[usize(d)]
            if fg.g.ty.bits_layout(t) is not null {
                tys := list(Ty)
                vals := list(string)
                for x in items {
                    tys.push(lir.value_type(c.f, x))!
                    vals.push(c.lc_val(x))!
                }
                c.temps[usize(d)] = fg.bits_pack(t, tys.items, vals.items)
            } else if fg.g.ty.size(t) is 0 {
                c.temps[usize(d)] = fg.zero(t)
            } else {
                offs: []const u64 = empty_slice(u64)
                esz: u64 = 0
                if .Array(_, elem, _) := fg.g.ty.kind(t) { esz = fg.g.ty.size(elem) } else { offs = fg.g.ty.offsets(t) }
                parts := list(BlobPart)
                vals := list(string)
                for k, x in enumerate(items) {
                    off := if offs.len > k { offs[k] } else { u64(k) * esz }
                    parts.push(BlobPart(off: off, len: fg.g.ty.size(lir.value_type(c.f, x))))!
                    vals.push(c.lc_val(x))!
                }
                b := fg.blob_over(t, parts.items)
                for k, x in enumerate(items) {
                    fg.store(lir.value_type(c.f, x), str.format("((uint8_t *)&{} + {})", b, parts.items[k].off)!, vals.items[k])
                }
                c.temps[usize(d)] = b
            }
        }
        .In(d, negated, elem, container) => {
            x := c.lc_val(elem)
            cv := c.lc_val(container)
            c.temps[usize(d)] = try fg.in_values(span, lir.value_type(c.f, elem), lir.value_type(c.f, container), x, cv, negated)
        }
        .BitsGet(d, v, index) => { c.temps[usize(d)] = fg.bits_get(lir.value_type(c.f, v), c.lc_val(v), index) }
        .BitsSet(d, whole, index, v) => {
            w := c.lc_val(whole)
            x := c.lc_val(v)
            c.temps[usize(d)] = fg.bits_set(c.f.temps[usize(d)], w, index, lir.value_type(c.f, v), x)
        }
        .Fill(d, v) => {
            t := c.f.temps[usize(d)]
            .Array(n, elem, _) := fg.g.ty.kind(t) else @unreachable()
            x := c.lc_val(v)
            b := fg.tmp_uninit(t)
            if n > 0 and fg.g.ty.size(elem) > 0 {
                k := fg.fresh()
                fg.linef("for (size_t i{} = 0; i{} < {}; i{}++) GM_ST({}, (uint8_t *)&{} + i{} * {}, {});", k, k, n, k, fg.g.ty.cty(elem), b, k, fg.g.ty.size(elem), x)
            }
            c.temps[usize(d)] = b
        }
        .Variant(d, variant, ?payload) => {
            p: ?string = null
            if x := payload { p = c.lc_val(x) }
            c.lazy[usize(d)] = .Variant(variant, p, c.f.temps[usize(d)])
            c.pending.push(d)!
        }
        .Wrap(d, kind, ?v) => {
            t := c.f.temps[usize(d)]
            c.temps[usize(d)] = match kind {
                .None => fg.make_none(t)
                .Some => fg.make_some(t, c.lc_val(v?))
                .Ok => fg.make_res(t, false, lir.value_type(c.f, v?), c.lc_val(v?))
                .Err => fg.make_res(t, true, lir.value_type(c.f, v?), c.lc_val(v?))
            }
        }
        .MakeSlice(d, ptr, lo, hi, inclusive, size) => {
            l := c.lc_val(lo)
            h := str.format("((uintptr_t){}{})", c.lc_val(hi), if inclusive { " + 1" } else { "" })!
            n := fg.tmp(fg.g.ty.usize_ty(), str.format("{} - (uintptr_t){}", h, l)!)
            c.temps[usize(d)] = fg.make_slice(c.f.temps[usize(d)], str.format("((uint8_t *){} + (uintptr_t){} * {})", c.lc_val(ptr), l, size)!, n)
        }
        .IsPresent(d, p, result) => {
            t := try c.lc_place_type(&p, span)
            a := try c.lc_addr(&p, span)
            cond := if result { str.format("!{}", fg.res_is_err(t, a))! } else { fg.opt_present(t, a) }
            c.lc_set(d, str.format("(uint8_t){}", cond)!)
        }
        .TagIs(d, p, variant) => {
            t := try c.lc_place_type(&p, span)
            .Union(tag, variants) := fg.adt_def(t).kind else @unreachable()
            a := try c.lc_addr(&p, span)
            off := fg.g.ty.offsets(t)[0]
            v := fg.load(tag, str.format("({} + {})", a, off)!)
            c.lc_set(d, str.format("(uint8_t)({} == {})", v, fg.int_lit(tag, variants[usize(variant)].tag))!)
        }
        .Write(sink, pieces, specs, args, ?table) => {
            to: WriteTo = match sink {
                .Perform(effect_, op) => .Perform(effect_, op)
                .Value(v) => .Fn(ValTy(v: c.lc_val(v), ty: lir.value_type(c.f, v)), null)
            }
            tys := list(Ty)
            vals := list(string)
            for a in args {
                t := lir.value_type(c.f, a)
                tys.push(t)!
                vals.push(fg.addr_of(t, c.lc_arg(a)))!
            }
            if x := table {
                _ = try fg.write_table_values(span, to, c.lc_val(x), tys.items, vals.items)
            } else {
                _ = try fg.write_values(span, to, pieces, specs, tys.items, vals.items)
            }
        }
        .FnRef(d, f, _) => {
            t := c.f.temps[usize(d)]
            fg.g.queue(f)
            name := fg.g.addr_name(f)
            // A plain function where hidden-convention code is expected is marked by
            // tagging its address (GM_PTR_TAG, see `call_indirect`).
            code: string = if fg.g.is_plain(f) and not fg.ptr_type_plain(t) { str.format("GM_PTR_TAG({})", name)! } else { str.format("((void *){})", name)! }
            if fg.g.ty.kind(t) is .Fn(_) {
                c.lc_set(d, str.format("((gm_closure){{{}, NULL, {}}})", code, fg.cx)!)
            } else {
                c.temps[usize(d)] = code
            }
        }
        .Closure(d, f) => {
            fg.g.queue(f)
            c.lc_set(d, str.format("((gm_closure){{(void *){}, (void *)&F.h, {}}})", fg.g.fn_name(f), fg.cx)!)
        }
        .Template(d, tb) => { c.temps[usize(d)] = str.format("((void *)&{})", fg.g.template_table(tb))! }
        .Str(d, bytes, cstr) => {
            c.str_bytes[usize(d)] = bytes
            a := fg.g.static_bytes(bytes)
            if cstr {
                c.lc_set(d, str.format("((void *){})", a)!)
            } else {
                c.temps[usize(d)] = fg.make_slice(c.f.temps[usize(d)], a, str.format("{}", bytes.len)!)
            }
        }
        .Check(ch) => if fg.g.opts.checks {
            loc := fg.g.src_loc(span)
            match ch {
                .Bounds(x, n) => {
                    bi := fg.bound(lir.value_type(c.f, x), c.lc_val(x))
                    fg.index_check(true, bi, c.lc_val(n), loc)
                }
                .Range(lo, hi, ?len, inclusive) => if n := len {
                    // As `slice_expr`: an inclusive bound of `UINTPTR_MAX` stays past every length.
                    l := fg.tmp(fg.g.ty.usize_ty(), fg.bound(lir.value_type(c.f, lo), c.lc_val(lo)))
                    h := fg.tmp(fg.g.ty.usize_ty(), fg.bound(lir.value_type(c.f, hi), c.lc_val(hi)))
                    if inclusive { fg.linef("{} += {} != UINTPTR_MAX;", h, h) }
                    nv := c.lc_val(n)
                    fg.linef("if ({} > {} || {} > (uintptr_t){}) gm_trap_slice({}, {}, {}, {});", l, h, h, nv, l, h, nv, loc)
                }
                .Unwrap(present, p, result) => {
                    if result {
                        t := try c.lc_place_type(&p, span)
                        .Result(err, _) := fg.g.ty.kind(t) else @unreachable()
                        a := try c.lc_addr(&p, span)
                        off := fg.g.ty.offsets(t)[1]
                        fg.linef("if (!{}) gm_trap_unwrap({}, {} + {}, {});", c.lc_val(present), fg.g.ty.desc(err), a, off, loc)
                    } else {
                        fg.linef("if (!{}) gm_trap(\"unwrap of null\", {});", c.lc_val(present), loc)
                    }
                }
            }
        }
        .Block(l, body) => {
            // The block a TIR loop's `break` leaves: in a function with nested functions,
            // whose exits may target the loop, it has a rung of the ladder (`end_scope`).
            scoped := false
            if c.nested_fns {
                for x in c.f.loops {
                    if x.brk is l and x.cont is not l {
                        fg.scopes.push(fg.loop_scope(x.label, c.labels[usize(x.brk)], c.labels[usize(x.cont)]))!
                        scoped = true
                    }
                }
            }
            c.open.push(OpenBlock(label: l, depth: fg.scopes.items.len, level: c.outline_level))!
            // A branch to its end across a `defer` exits through the ladder to its rung.
            target := crosses_defer(body, l)
            if target { fg.scopes.push(fg.with_scope(exit_label(l), c.labels[usize(l)]))! }
            defers := has_defer(body)
            if defers { fg.scopes.push(fg.block_scope())! }
            fg.line("{")
            r := c.lc_nested(body)
            fg.line("}")
            if defers {
                popped := fg.scopes.pop()?
                // Leaving normally runs the plain defers (not the errdefers), last first.
                k := popped.defers.items.len
                while k > 0 {
                    k -= 1
                    d := popped.defers.items[k]
                    if not d.is_err { fg.defer_body(null, d, false) }
                }
                fg.end_scope(popped, true)
            }
            if target {
                popped := fg.scopes.pop()?
                fg.end_scope(popped, true)
            }
            _ = c.open.pop()
            try r
            if scoped {
                popped := fg.scopes.pop()?
                fg.end_scope(popped, true)
            }
            fg.label(c.labels[usize(l)])
        }
        .With(l, tl, install, ?on, body) if on is not null => try c.lc_with_on(span, l, tl, install, on?, body)
        .With(l, tl, install, _, body) => {
            // As `with_expr`: the handlers are nodes of the handler context, on the C stack
            // while the body runs; a clause that leaves the `with` with a value writes it to
            // `F.wN` and exits to the rung of the `with`'s scope.
            result: ?u32 = null
            for x in c.f.loops {
                if x.brk is l { result = x.result }
            }
            fg.line("{")
            fg.indent += 1
            hid := single_handler(install)
            nested: ?u32 = null
            if h := hid and lit_install(install) { nested = fg.nested_spec_of(h, false) }
            c.installing.push(Installing(label: tl, outer: fg.cx, cur: fg.cx, nested: nested))!
            r0 := c.lc_list(install)
            ins := c.installing.pop()?
            try r0
            saved := fg.cx
            fg.cx = ins.cur
            saved_spec := c.spec_call
            c.spec_call = null
            if h := hid {
                if call := spec_candidate(body) {
                    .Call(_, .Fn(f), _) := call.op else @unreachable()
                    if s := fg.specialization(h, f, nested) { c.spec_call = LirSpec(call: call, spec: s) }
                }
            }
            end := str.format("we{}", fg.fresh())!
            c.open.push(OpenBlock(label: l, depth: fg.scopes.items.len, level: c.outline_level))!
            // A branch out of the body across a `defer` exits to a rung of its own: the
            // `with`'s rung is for clauses, which leave the value in `F.wN`.
            target := crosses_defer(body, l)
            if target { fg.scopes.push(fg.with_scope(exit_label(l), c.labels[usize(l)]))! }
            fg.scopes.push(fg.with_scope(tl, end))!
            defers := has_defer(body)
            if defers { fg.scopes.push(fg.block_scope())! }
            r := c.lc_list(body)
            c.spec_call = saved_spec
            if defers {
                popped := fg.scopes.pop()?
                k := popped.defers.items.len
                while k > 0 {
                    k -= 1
                    d := popped.defers.items[k]
                    if not d.is_err { fg.defer_body(null, d, false) }
                }
                fg.end_scope(popped, true)
            }
            scope := fg.scopes.pop()?
            _ = c.open.pop()
            fg.cx = saved
            try r
            fg.indent -= 1
            fg.line("}")
            // The rungs, inner first: the `with`'s (for clauses), then the one for branches.
            fg.end_scope(scope, true)
            if target {
                popped := fg.scopes.pop()?
                fg.end_scope(popped, true)
            }
            fg.label(c.labels[usize(l)])
            if x := result { fg.linef("F.w{} = {};", tl, fg.local_lv(x)) }
            fg.label(end)
            if x := result { fg.linef("{} = F.w{};", fg.local_lv(x), tl) }
        }
        .Install(h) => {
            w := &c.installing.items[c.installing.items.len - 1]
            slot := str.format("(void *)&F.w{}", w.label)!
            match h {
                .Lit(hid) => {
                    eref := fg.g.prog.handler_lit(hid).effect_
                    n := str.format("wn{}", fg.fresh())!
                    table := if ns := w.nested { fg.g.spec_handler_table(hid, ns) } else { fg.g.handler_table(hid) }
                    fg.linef("gm_node {} = {{.eff = {}, .kind = GM_LIT, .clauses = {}, .env = (void *)&F.h, .hctx = {}, .with_frame = &F.h, .with_label = {}, .result = {}, .fw = {}, .next = {}}};", n, fg.g.effect_id(&eref), table, w.outer, w.label, slot, w.fw, w.cur)
                    w.cur = str.format("(&{})", n)!
                }
                .Value(hid, v) => {
                    hv := fg.tmp(lir.value_type(c.f, v), c.lc_val(v))
                    eref := fg.g.prog.handler_lit(hid).effect_
                    n := str.format("wn{}", fg.fresh())!
                    fg.linef("gm_node {} = {{.eff = {}, .kind = GM_LIT, .clauses = {}, .env = {}.env, .hctx = {}.cx, .with_frame = &F.h, .with_label = {}, .result = {}, .fw = {}, .next = {}}};", n, fg.g.effect_id(&eref), fg.g.handler_table(hid), hv, hv, w.label, slot, w.fw, w.cur)
                    w.cur = str.format("(&{})", n)!
                }
                .Decl(decls, v) => {
                    hv := fg.tmp(lir.value_type(c.f, v), c.lc_val(v))
                    outer := w.cur
                    for d in decls {
                        table := try fg.g.decl_table(d)
                        eref := fg.g.prog.handler_decl(d).effect_
                        n := str.format("wn{}", fg.fresh())!
                        fg.linef("gm_node {} = {{.eff = {}, .kind = GM_DECL, .clauses = {}, .env = (void *)&{}, .hctx = {}, .with_frame = &F.h, .with_label = {}, .result = {}, .fw = {}, .next = {}}};", n, fg.g.effect_id(&eref), table, hv, outer, w.label, slot, w.fw, w.cur)
                        w.cur = str.format("(&{})", n)!
                    }
                }
            }
        }
        .HandlerRef(d, _) => c.lc_set(d, str.format("((gm_hval){{(void *)&F.h, {}}})", fg.cx)!)
        .Exit(kind, ?v) => try c.lc_exit(kind, v)
        .Resume(k, v) => {
            ka := c.lc_addr_of(k)
            x := c.lc_val(v)
            rp := str.format("rp{}", fg.fresh())!
            fg.linef("void *{} = gm_resume(inst->fw, {}, {});", rp, ka, fg.g.src_loc(span))
            vt := lir.value_type(c.f, v)
            if fg.g.ty.is_void(vt) {
                fg.linef("(void){};", rp)
            } else {
                fg.linef("GM_ST({}, {}, {});", fg.g.ty.cty(vt), rp, x)
            }
            fg.start_exit(.Resume, "(&F.h)", "0", "0")
        }
        .Cancel(k) => {
            fg.linef("gm_cancel_cont(inst->fw, {}, {});", c.lc_addr_of(k), fg.g.src_loc(span))
            fg.check_unwind()
        }
        .Defer(is_err, body) => {
            top := &fg.scopes.items[fg.scopes.items.len - 1]
            top.defers.push(Defer(is_err: is_err, lir: body))!
        }
        .Loop(_, body) => {
            fg.line("for (;;) {")
            try c.lc_nested(body)
            fg.line("}")
        }
        .If(cond, then, else_) => {
            fg.linef("if ({}) {{", c.lc_val(cond))
            try c.lc_nested(then)
            if else_.len > 0 {
                fg.line("} else {")
                try c.lc_nested(else_)
            }
            fg.line("}")
        }
        .Br(l) => c.lc_br(l)
        .BrIf(cond, negated, l) => {
            fg.linef("if ({}{}) {{", if negated { "!" } else { "" }, c.lc_val(cond))
            fg.indent += 1
            c.lc_br(l)
            fg.indent -= 1
            fg.line("}")
        }
        .Return(?v) => {
            if not fg.no_defers() or fg.outlined {
                // Through the ladder, which runs the deferred statements (the errdefers if
                // the result is an error) and then returns `F.ret`.
                if x := v {
                    if fg.g.ty.by_ref(fg.def.ret) {
                        fg.linef("memmove(&F.ret, {}, {});", c.lc_addr_of(x), fg.g.ty.size(fg.def.ret))
                    } else {
                        fg.linef("F.ret = {};", c.lc_val(x))
                    }
                }
                is_err := "0"
                if fg.g.ty.kind(fg.def.ret) is .Result(_) { is_err = fg.res_is_err(fg.def.ret, "((uint8_t *)&F.ret)") }
                fg.start_exit(.Return, "(&F.h)", "0", is_err)
                return ()
            }
            if x := v and fg.g.ty.by_ref(fg.def.ret) {
                // A large result is written to the caller's destination itself.
                from := c.lc_addr_of(x)
                fg.linef("memmove(gm_out, {}, {});", from, fg.g.ty.size(fg.def.ret))
                fg.jump("gm_fdone", null)
                return ()
            }
            if x := v { fg.linef("F.ret = {};", c.lc_val(x)) }
            fg.jump("gm_fret", null)
        }
        .Trap(m) => {
            a := fg.addr_of(lir.value_type(c.f, m), c.lc_val(m))
            fg.linef("gm_trap_bytes({}, {}, {});", slice_ptr(a), fg.slice_len(a), fg.g.src_loc(span))
        }
        .Assert(?m) => {
            loc := fg.g.src_loc(span)
            prefix := "assertion failed"
            if x := m {
                a := fg.addr_of(lir.value_type(c.f, x), c.lc_val(x))
                fg.linef("{{ gm_buf mb = {{0}}; size_t ml = {}; const uint8_t *mp = {}; if (ml == {} && memcmp(mp, \"{}\", {}) == 0) gm_buf_push(&mb, mp, ml); else {{ gm_buf_push(&mb, \"{}: \", {}); gm_buf_push(&mb, mp, ml); }} gm_trap_bytes(mb.data, mb.len, {}); }}", fg.slice_len(a), slice_ptr(a), prefix.len, prefix, prefix.len, prefix, prefix.len + 2, loc)
            } else {
                fg.linef("gm_trap(\"{}\", {});", prefix, loc)
            }
        }
        // Assertions run where the checks do (§21.6).
        .DebugOnly(body) => if fg.g.opts.checks {
            fg.line("{")
            try c.lc_nested(body)
            fg.line("}")
        }
        .NoArm => fg.linef("gm_trap(\"no match arm matched the scrutinee\", {});", fg.g.src_loc(span))
        .Unreachable => fg.line("__builtin_unreachable();")
        _ => return !unsupported(span, "this LIR instruction")
    }
}

/// `With(l, tl, install, on, body)` with a stack `on`, as `with_on`: the body runs on a fiber
/// in a C function of its own (`lc_outline_body`), and the clauses of its `ctl` operations
/// run in the driver loop here.
lc_with_on :: fn(c: ^LirC, span: source.Span, l: u32, tl: u32, install: []const lir.Inst, on: lir.Value, body: []const lir.Inst) -> Unsup!() needs sema.Load {
    fg := c.fg
    result: ?u32 = null
    for x in c.f.loops {
        if x.brk is l { result = x.result }
    }
    st := c.lc_val(on)
    sa := fg.addr_of(lir.value_type(c.f, on), st)
    fg.line("{")
    fg.indent += 1
    w := str.format("gw{}", fg.fresh())!
    fg.linef("gm_with {}; memset(&{}, 0, sizeof {});", w, w, w)
    c.installing.push(Installing(label: tl, outer: fg.cx, cur: fg.cx, fw: str.format("&{}", w)!))!
    r0 := c.lc_list(install)
    ins := c.installing.pop()?
    try r0
    cx := ins.cur
    loc := fg.g.src_loc(span)
    body_fn := try c.lc_outline_body(l, tl, body)
    fb := str.format("fb{}", fg.fresh())!
    end := str.format("we{}", fg.fresh())!
    fg.linef("{}.body_cx = {};", w, cx)
    fg.linef("gm_fiber *{} = gm_fiber_new(&{}, (uint8_t *){}, {}, {}, 0, {});", fb, w, slice_ptr(sa), fg.slice_len(sa), body_fn, loc)
    fg.linef("{}->frame = &F; {}->env = env; {}->inst = inst; {}->cx = {};", fb, fb, fb, fb, cx)
    // The clauses of its `ctl` operations run here, as if called by the `with`.
    fg.call_site(span)
    fg.linef("gm_with_go(&{}, {});", w, fb)
    fg.line("for (;;) {")
    fg.indent += 1
    fg.linef("if ({}.event == GM_EV_PERFORM) {{", w)
    fg.linef("    gm_with_clause(&{});", w)
    fg.linef("    if (gm_unw.kind == GM_RESUME) {{ gm_unw.kind = GM_NONE; gm_with_go(&{}, {}.next); continue; }}", w, w)
    // A clause's exit crosses the `with` unless it is a `break` to the `with` (§14.4).
    fg.linef("    gm_with_end(&{}, !(gm_unw.kind == GM_BREAK && gm_unw.frame == &F.h && gm_unw.label == {}), {});", w, tl, loc)
    fg.linef("}} else if ({}.event_fiber == {} && !gm_unw.kind) {{", w, fb)
    fg.linef("    gm_with_end(&{}, false, {});", w, loc)
    fg.linef("    goto {};", c.labels[usize(l)])
    fg.line("} else {")
    fg.linef("    if (!gm_unw.kind) gm_trap(\"a fiber's function returned\", {});", loc)
    fg.linef("    gm_with_end(&{}, true, {});", w, loc)
    fg.line("}")
    fg.linef("if (!gm_unw.kind) gm_trap(\"internal error: a `ctl` clause finished normally\", {});", loc)
    fg.scopes.push(fg.with_scope(tl, end))!
    fg.ladder()
    popped := fg.scopes.pop()?
    fg.end_scope(popped, false)
    fg.indent -= 1
    fg.line("}")
    fg.indent -= 1
    fg.line("}")
    // A clause's `break` leaves the value in `F.wN`; the body leaves it in the local.
    fg.label(end)
    if x := result { fg.linef("{} = F.w{};", fg.local_lv(x), tl) }
    fg.label(c.labels[usize(l)])
}

/// Moves `body`, the body of the `with … on` `l` (TIR's `tl`), into a C function that runs on
/// its fiber, as `outline_body` does: the enclosing frame is `F` there too. A branch out of
/// it exits through the ladder (`lc_br`); one to its end finishes the fiber.
lc_outline_body :: fn(c: ^LirC, l: u32, tl: u32, body: []const lir.Inst) -> Unsup!string needs sema.Load {
    fg := c.fg
    name := str.format("gm_wb{}_{}", fg.tag, tl)!
    fid := fg.fid
    saved := fg.outlined
    fg.outlined = true
    saved_label := c.labels[usize(l)]
    c.labels[usize(l)] = str.format("gm_lb{}", fg.fresh())!
    c.outline_level += 1
    c.last_line = ""
    emit :: fn() -> Unsup!() needs sema.Load {
        fr := fg.g.frame_name(fid)
        fg.linef("struct {} *gm_Fp = (struct {} *)fb->frame;", fr, fr)
        fg.line("void *env = fb->env; gm_node *cx = fb->cx; gm_node *inst = fb->inst;")
        fg.line("(void)env; (void)cx; (void)inst;")
        // The body belongs to the frame of the enclosing function, whose record the
        // driver's chain ends with: its record stands in for that one.
        if fg.g.opts.debug {
            fname := if n := fg.g.prog.backtrace_name(fg.fid) { c_string(n) } else { "NULL" }
            fg.linef("gm_bt B = {{ gm_bt_top ? gm_bt_top->prev : NULL, {}, NULL, 0, 0 }}; gm_bt_top = &B;", fname)
        }
        fg.out.extend("#define F (*gm_Fp)\n")!
        c.open.push(OpenBlock(label: l, depth: fg.scopes.items.len, level: c.outline_level))!
        target := crosses_defer(body, l)
        if target { fg.scopes.push(fg.with_scope(exit_label(l), c.labels[usize(l)]))! }
        defers := has_defer(body)
        if defers { fg.scopes.push(fg.block_scope())! }
        r := c.lc_list(body)
        if defers {
            popped := fg.scopes.pop()?
            k := popped.defers.items.len
            while k > 0 {
                k -= 1
                d := popped.defers.items[k]
                if not d.is_err { fg.defer_body(null, d, false) }
            }
            fg.end_scope(popped, true)
        }
        if target {
            popped := fg.scopes.pop()?
            fg.end_scope(popped, true)
        }
        _ = c.open.pop()
        try r
        fg.label(c.labels[usize(l)])
        fg.out.extend("gm_fprop:\n    gm_fiber_finish(fb);\n#undef F\n}\n")!
    }
    text := detached(fg, str.format("static void {}(gm_fiber *fb)", name)!, "cx", emit)
    c.outline_level -= 1
    c.last_line = ""
    c.labels[usize(l)] = saved_label
    fg.outlined = saved
    t := try text
    fg.g.protos.write("static void {}(gm_fiber *fb);\n", name)!
    fg.g.bodies.extend(t)!
    return name
}

/// The handler literal that the `install` list of a `with` installs, if it installs only
/// that one.
single_handler :: fn(install: []const lir.Inst) -> ?u32 {
    found: ?u32 = null
    n := 0
    for x in install {
        if .Install(h) := x.op {
            n += 1
            match h {
                .Lit(id), .Value(id, _) => { found = id }
                .Decl(_) => return null
            }
        }
    }
    return if n is 1 { found } else { null }
}

/// Whether the one handler of `install` is a literal written in the `with` (not a value).
lit_install :: fn(install: []const lir.Inst) -> bool {
    for x in install {
        if .Install(.Lit(_)) := x.op { return true }
    }
    return false
}

/// The call of a named function that the body of a `with` ends with, if it does: only the
/// result's store and branches follow it (`specializable`).
spec_candidate :: fn(body: []const lir.Inst) -> ?^const lir.Inst {
    k := body.len
    while k > 0 {
        k -= 1
        x := &body[k]
        match x.op {
            .Call(_, .Fn(_), _) => return x
            .Store(_), .Br(_), .Move(_), .Load(_), .Return(_) => {}
            _ => return null
        }
    }
    return null
}
