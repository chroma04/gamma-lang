// The layouts of types as the back ends use them: `sema/layout.gm` computes them (with
// field offsets); this file adds the target and what the Fil-C build needs to know.

/// The target the generated code is for.
pub Target :: loader.Target

pub ptr_bits :: fn(t: ^const Target) -> u32 => loader.ptr_bits(t)

/// A size, an alignment and the offsets of the fields (`sema.Layout`).
pub Layout :: sema.Layout

/// The layouts of the program's types for a target.
pub Layouts :: struct {
    pub target: Target
    s: ^Sema
}

pub layouts :: fn(s: ^Sema, t: Target) -> Layouts => Layouts(target: t, s: s)

/// True for the pointer kinds whose optional uses address 0 as null (§5.12).
pub nullable_pointer :: fn(s: ^const Sema, t: Ty) -> bool => s.is_nullable_pointer(t)

pub layout_of :: fn(lay: ^Layouts, t: Ty) -> Layout needs Alloc => lay.s.layout(t)

pub size_of :: fn(lay: ^Layouts, t: Ty) -> u64 needs Alloc => lay.s.layout(t).size

pub align_of :: fn(lay: ^Layouts, t: Ty) -> u64 needs Alloc => lay.s.layout(t).align

/// Whether a value of `t` may hold a pointer (only Fil-C builds need to know).
may_hold_pointers :: fn(lay: ^Layouts, t: Ty) -> bool needs Alloc {
    match lay.s.tys.kind(t) {
        .Int(_), .Usize, .Isize, .Float(_), .Bool, .Never => return false
        .Array(_, elem, _) => return lay.may_hold_pointers(elem)
        .Tuple(elems, _) => {
            for e in elems {
                if lay.may_hold_pointers(e) { return true }
            }
            return false
        }
        .Optional(inner) => return lay.may_hold_pointers(inner)
        .Result(err, ok) => return lay.may_hold_pointers(err) or lay.may_hold_pointers(ok)
        .Adt(id, _) => match lay.s.adts.items[usize(id)].kind {
            .Struct(def) => {
                if def.bits is not null { return false }
                for f in def.fields {
                    if lay.may_hold_pointers(f.ty) { return true }
                }
                return false
            }
            .CUnion(fields) => {
                for f in fields {
                    if lay.may_hold_pointers(f.ty) { return true }
                }
                return false
            }
            .Union(_, variants) => {
                for v in variants {
                    if pt := v.payload and lay.may_hold_pointers(pt) { return true }
                }
                return false
            }
        }
        _ => return true
    }
}

/// For a value of `t` whose pointers are always at the same places (no union, optional or
/// result holds one), which of its pointer-sized words hold a pointer; `null` when that
/// depends on the value, or a pointer is not aligned to its size.
pointer_words :: fn(lay: ^Layouts, t: Ty) -> ?[]bool needs Alloc {
    p := lay.target.ptr_bytes
    n := (lay.layout_of(t).size + p - 1) / p
    words := list(bool)
    for _ in 0..n { words.push(false)! }
    if not lay.mark_pointer_words(t, 0, words.items) { return null }
    return words.items
}

mark_pointer_words :: fn(lay: ^Layouts, t: Ty, off: u64, words: []bool) -> bool needs Alloc {
    p := lay.target.ptr_bytes
    match lay.s.tys.kind(t) {
        .Rawptr, .Ptr(_), .ManyPtr(_), .FnPtr(_), .Slice(_) => return pointer_at(words, off, p)
        .Optional(inner) => {
            if nullable_pointer(lay.s, inner) { return pointer_at(words, off, p) }
            return not lay.may_hold_pointers(t)
        }
        // A closure's code, environment and context; a handler value's frame and context.
        .Fn(_) => return pointer_at(words, off, p) and pointer_at(words, off + p, p) and pointer_at(words, off + 2 * p, p)
        .Handler(_) => return pointer_at(words, off, p) and pointer_at(words, off + p, p)
        .Array(len, elem, _) => {
            size := lay.layout_of(elem).size
            for i in 0..u64(len) {
                if not lay.mark_pointer_words(elem, off + i * size, words) { return false }
            }
            return true
        }
        .Tuple(elems, _) => {
            offs := lay.layout_of(t).offsets
            for i, e in enumerate(elems) {
                if not lay.mark_pointer_words(e, off + offs[i], words) { return false }
            }
            return true
        }
        .Adt(id, _) => {
            if .Struct(def) := lay.s.adts.items[usize(id)].kind and def.bits is null {
                offs := lay.layout_of(t).offsets
                for i, f in enumerate(def.fields) {
                    if not lay.mark_pointer_words(f.ty, off + offs[i], words) { return false }
                }
                return true
            }
            return not lay.may_hold_pointers(t)
        }
        _ => return not lay.may_hold_pointers(t)
    }
}

/// Marks the word at `off` as a pointer; false if `off` is not a word's start.
pointer_at :: fn(words: []bool, off: u64, p: u64) -> bool {
    if off % p is not 0 { return false }
    words[(off / p).trunc(usize)] = true
    return true
}
