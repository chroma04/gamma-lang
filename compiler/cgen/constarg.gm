// Large arguments that are compile-time constants (Appendix D.5).
//
// A large argument (`CTypes.by_ref`) crosses a call as an address. When it is built from
// literals only, such as the `SourceLocation` that `@caller_location()` fills in, the
// caller would otherwise build it in a temporary at every call and pass that temporary's
// address: under Fil-C a local whose address escapes is allocated on the
// garbage-collected heap, once per call. Such an argument lives in static storage
// instead, initialized at startup like a top-level constant, and every call passes its
// address. The callee never writes it: it copies a large parameter before anything else
// runs, or reads in place one it never writes.

/// A pointer stored at `offset` within a constant argument: the address of the static
/// bytes `data`.
SiteReloc :: struct {
    offset: u64
    data: []const u8
}

/// A constant argument: the bytes of its value in the target layout and its pointers.
pub SiteConst :: struct {
    ty: Ty
    bytes: List(u8)
    relocs: List(SiteReloc)
    /// Its storage, `gm_k` and a hash of the above.
    name: string = ""
}

/// A zeroed constant of type `t`.
new_site_const :: fn(g: ^Gen, t: Ty) -> SiteConst needs sema.Load {
    size := g.ty.size(t)
    v := SiteConst(ty: t, bytes: list(u8), relocs: list(SiteReloc))
    v.bytes.reserve(size.trunc(usize))!
    for _ in 0..size { v.bytes.push(0)! }
    return v
}

/// The static storage (`gm_kN`, a `uint8_t *` expression) of the constant argument `v`,
/// shared with every other argument of the same value.
site_const_storage :: fn(g: ^Gen, sc: SiteConst) -> string needs sema.Load {
    v := sc
    i := g.site_consts.items.len
    for k in 0..g.site_consts.items.len {
        if same_site_const(&g.site_consts.items[k], &v) {
            i = k
            break
        }
    }
    if i is g.site_consts.items.len {
        key := list(u8)
        key.write("{}|{}|", g.ty.show(v.ty), v.bytes.items.len)!
        key.extend(v.bytes.items)!
        for r in v.relocs.items { key.write("|{}:{}", r.offset, r.data)! }
        v.name = g.names.keyed("gm_k", key.items)
        g.site_consts.push(v)!
    }
    return str.format("((uint8_t *){})", g.site_consts.items[i].name)!
}

same_site_const :: fn(a, b: ^const SiteConst) -> bool {
    if a.ty is not b.ty or a.bytes.items is not b.bytes.items or a.relocs.items.len is not b.relocs.items.len { return false }
    for i in 0..a.relocs.items.len {
        x := a.relocs.items[i]
        y := b.relocs.items[i]
        if x.offset is not y.offset or x.data is not y.data { return false }
    }
    return true
}

/// Writes the value `v` of the LIR body `f` at `off` in `sc`; false if `v` is not built
/// from constants only (`Word`, `Big`, string literals and aggregates of them, each
/// temporary read only here, as `defs` defines it). `parts` collects those temporaries.
lir_const_into :: fn(g: ^Gen, f: ^const lir.Func, defs: []const ?^const lir.Inst, uses: []const u32, v: lir.Value, off: u64, sc: ^SiteConst, parts: ^List(u32)) -> bool needs sema.Load {
    match v {
        .Word(t, bits) => {
            match g.ty.repr(t) {
                .Int(_, _, _), .Bool => {}
                .Float(w) => if w is 16 { return false }
                _ => if bits is not 0 { return false }
            }
            g.store_int(sc.bytes.items, off, u128(bits), g.ty.size(t).min(8))
        }
        .Big(t, bits) => g.store_int(sc.bytes.items, off, bits, g.ty.size(t).min(16))
        .Zero(_) => {}
        .Uninit(_) => return false
        .Temp(t) => {
            if uses[usize(t)] is not 1 { return false }
            i := defs[usize(t)] else return false
            match i.op {
                .Str(_, s, cstr) => {
                    sc.relocs.push(SiteReloc(offset: off, data: s))!
                    if not cstr {
                        p := g.ty.lay.target.ptr_bytes
                        g.store_int(sc.bytes.items, off + p, u128(s.len), p)
                    }
                }
                .Aggregate(_, items) => {
                    ty := f.temps[usize(t)]
                    if g.ty.bits_layout(ty) is not null { return false }
                    esz: u64 = 0
                    offs: []const u64 = empty_slice(u64)
                    if .Array(_, elem, _) := g.ty.kind(ty) { esz = g.ty.size(elem) } else { offs = g.ty.offsets(ty) }
                    for k, x in enumerate(items) {
                        o := if offs.len > k { offs[k] } else { u64(k) * esz }
                        if not g.lir_const_into(f, defs, uses, x, off + o, sc, parts) { return false }
                    }
                }
                _ => return false
            }
            parts.push(t)!
        }
    }
    return true
}

/// Whether `e` is built from literals only, so that a call passes it from static storage.
is_const_arg :: fn(g: ^Gen, e: ^Expr) -> bool needs sema.Load {
    v := new_site_const(g, e.ty)
    return g.const_into(e, 0, &v)
}

/// Writes the value of `e` at `off` in `v`; false if `e` is not built from literals.
const_into :: fn(g: ^Gen, e: ^Expr, off: u64, v: ^SiteConst) -> bool needs sema.Load {
    size := g.ty.size(e.ty)
    match e.kind {
        .Int(n) => {
            lo, hi := split_u128(n)
            g.store_int(v.bytes.items, off, lo | (hi << 64), size.min(16))
        }
        .Bool(b) => { v.bytes.items[off.trunc(usize)] = if b { 1 } else { 0 } }
        .Float(x) => match g.ty.kind(e.ty) {
            .Float(32) => g.store_int(v.bytes.items, off, u128(x.to(f32).bits(u32)), 4)
            .Float(64) => g.store_int(v.bytes.items, off, u128(x.bits(u64)), 8)
            _ => return false
        }
        .Str(s) => {
            p := g.ty.lay.target.ptr_bytes
            v.relocs.push(SiteReloc(offset: off, data: s))!
            g.store_int(v.bytes.items, off + p, u128(s.len), p)
        }
        .CStr(s) => v.relocs.push(SiteReloc(offset: off, data: s))!
        .Aggregate(elems) => {
            if g.ty.bits_layout(e.ty) is not null { return false }
            offs := g.ty.offsets(e.ty)
            for i in 0..elems.len {
                if not g.const_into(&elems[i], off + offs[i], v) { return false }
            }
        }
        .Array(elems) => {
            for i in 0..elems.len {
                esz := g.ty.size(elems[i].ty)
                if not g.const_into(&elems[i], off + u64(i) * esz, v) { return false }
            }
        }
        _ => return false
    }
    return true
}
