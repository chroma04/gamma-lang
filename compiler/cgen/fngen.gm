// The state of generating one C function.

/// Who can observe the destination of `expr_into` while the value is evaluated.
pub Observed :: union {
    /// Nothing: a new variable, or a result slot of this function.
    Fresh
    /// The caller's destination (`gm_out`): only code that reads memory other than this
    /// function's own frame can see it.
    Out
    /// Any code: an assignment to a place, which is part of this local if it is known to
    /// be.
    Any: ?u32
}

/// The C labels of a loop scope.
pub LoopLabels :: struct {
    /// The label of the loop, as `break` and `continue` name it.
    pub label: u32
    /// The C label for leaving the loop.
    pub brk: string
    /// The C label for its `continue` point.
    pub cont: string
}

/// The C labels of a `with` scope.
pub WithLabels :: struct {
    /// The label of the `with`.
    pub label: u32
    /// The C label after it.
    pub end: string
}

/// The kind of a scope of the function being generated.
pub ScopeKind :: union {
    /// A block, with its `defer`s (`Scope.defers`).
    Block
    /// A loop.
    Loop: LoopLabels
    /// A `with`.
    With: WithLabels
}

/// A `defer` (or `errdefer`) registered in a block.
pub Defer :: struct {
    pub is_err: bool
    pub body: ^Expr
}

/// A scope of the function being generated.
pub Scope :: struct {
    pub kind: ScopeKind
    pub id: u32
    /// Block: its `defer`s registered so far (empty for the other kinds).
    pub defers: List(Defer)
    /// Block: how many of the `defer`s the exits so far run (the deepest entry of its
    /// segment in use). Loop and With: 1 once an exit uses the scope's rung.
    pub used: usize = 0
}

/// A call whose large result goes straight into a destination (see `expr_into`).
pub DestCall :: struct {
    pub call: ^const Expr
    /// A C lvalue.
    pub dest: string
    pub obs: Observed
}

pub FnGen :: struct {
    pub g: ^Gen
    pub fid: u32
    /// Distinguishes the C names of this function's helpers.
    pub tag: string
    /// Set when generating a specialized clone: the node of the handler is `cx`.
    pub spec: ?u32 = null
    /// The call that a `with` being generated specializes for its handler.
    pub spec_call: ?SpecCall = null
    /// The link of a long chain being emitted; see `chain.gm`.
    pub spine: ?Spine = null
    /// The call expression whose large result goes straight into a destination, and that
    /// destination; see `expr_into`.
    pub dest_call: ?DestCall = null
    /// The destination of the call being emitted, from `dest_call`.
    pub call_dest: ?string = null
    pub def: ^const Func
    pub out: List(u8)
    pub indent: usize = 1
    pub counter: u32 = 0
    pub scopes: List(Scope)
    /// The C expression for the current handler context.
    pub cx: string = "cx"
    /// Set while generating a `defer` body: it cannot exit non-locally.
    pub no_check: bool = false
    /// Set once an exit jumps to `gm_lad`, the outermost rung of the ladder.
    pub lad_used: bool = false
    /// Set while generating the body of a `with … on`, moved into a function of its own:
    /// its ladder ends at the fiber's base.
    pub outlined: bool = false
    /// The bytes of the temporaries declared so far, for the stack check.
    pub temp_bytes: u64 = 0
    /// For each parameter, by position: whether it is read in place, through its address
    /// `aN` (see `borrowed_params`).
    pub borrowed: []bool
    /// For each local: whether it lives in the frame struct (`frame_locals`).
    pub in_frame: []bool
    /// The temporaries and labels of the C function being generated (`fresh` numbers them
    /// across the helpers of the Gamma function, for unique names).
    pub names: u32 = 0
    /// Set when long runs of statements go into helpers (see `outline.gm`).
    pub split_runs: bool = false
    /// The helpers being generated, innermost last.
    pub runs: List(Run)
}

/// The scopes and the helpers in progress of a function being generated: what a body
/// emitted apart from the code around it (a `defer` body, a detached function) starts
/// without.
ScopeState :: struct {
    scopes: List(Scope)
    runs: List(Run)
}

/// The state of a `FnGen` that a detached C function replaces while it is generated.
Saved :: struct {
    out: List(u8)
    scopes: ScopeState
    cx: string
    indent: usize
    no_check: bool
    lad_used: bool
}

/// Sets the scopes and helpers aside and starts with none; `restore_scopes` undoes it.
set_aside_scopes :: fn(fg: ^FnGen) -> ScopeState needs Alloc {
    saved := ScopeState(scopes: fg.scopes, runs: fg.runs)
    fg.scopes = list(Scope)
    fg.runs = list(Run)
    return saved
}

/// Brings back the scopes and helpers `set_aside_scopes` set aside.
restore_scopes :: fn(fg: ^FnGen, saved: ScopeState) {
    fg.scopes = saved.scopes
    fg.runs = saved.runs
}

/// Sets the state of the code being emitted aside and starts a new C function with the
/// handler context `cx`; `restore` undoes it.
save :: fn(fg: ^FnGen, cx: string) -> Saved needs Alloc {
    saved := Saved(out: fg.out, scopes: fg.set_aside_scopes(), cx: fg.cx, indent: fg.indent, no_check: fg.no_check, lad_used: fg.lad_used)
    fg.out = list(u8)
    fg.cx = cx
    fg.indent = 1
    fg.no_check = false
    fg.lad_used = false
    return saved
}

/// Brings back the state `save` set aside.
restore :: fn(fg: ^FnGen, saved: Saved) {
    fg.out = saved.out
    fg.restore_scopes(saved.scopes)
    fg.cx = saved.cx
    fg.indent = saved.indent
    fg.no_check = saved.no_check
    fg.lad_used = saved.lad_used
}
