// Splitting the generated C into several translation units, compiled in parallel.
//
// A Debug build compiles the runtime on its own and favors turnaround over whole-program
// optimization, and the C compiler's time is almost all spent on the function bodies. Such
// a build, and an optimized build of a very large program, splits the program: every unit
// includes a shared header (types, frames, declarations of every function and every piece
// of static data), unit 0 also defines the data and holds the entry code, and the function
// bodies are dealt out among the units.
//
// The generated code is written with internal linkage (`static`), as one unit needs. A
// split gives the functions and data external linkage instead: their names all start
// with `gm_`, as do the runtime's, so they cannot clash with the C library or the
// program's own C code. Small `static` helpers of the shared header stay `static`, one
// copy per unit. The `#inline` functions go to the shared text as C99 inline definitions,
// so that every unit can inline them, and unit 0 declares them `extern`, which makes its
// copy the one external definition: a function's address is the same in every unit.

arena :: import "std/arena"
hash_map :: import "std/collections/hash_map"
str :: import "std/str"

/// The generated code by role, as `generate` produces it in one unit.
pub Parts :: struct {
    /// Text every unit needs as it is: support code, types, frames.
    pub head: string = ""
    /// Function declarations, one per line.
    pub protos: string = ""
    /// Static data, one definition (or forward declaration) per line, and the `static
    /// inline` accessors, `extern` declarations and macros that go with it.
    pub data: string = ""
    /// Text only unit 0 holds, ahead of the data (the `gm_checks` flag).
    pub once: string = ""
    /// Function definitions.
    pub funcs: string = ""
    /// The entry code, which unit 0 holds after its share of the functions.
    pub tail: string = ""
}

/// The most units a build is split into.
MAX_UNITS :: 8

/// How much function text (in bytes) makes a unit worth its own compiler process.
UNIT_BYTES :: 96 * 1024

/// How much function text makes an optimized build worth splitting into units of about
/// this size. Below it the build is one unit, so the C compiler can inline across the
/// whole program; far above it one unit takes minutes, and the units lose little speed.
OPTIMIZED_UNIT_BYTES :: 4 * 1024 * 1024

/// The number of units to compile `parts` as in an optimized build: `forced` if given,
/// else one per `OPTIMIZED_UNIT_BYTES` of function text, at most one per processor and
/// `MAX_UNITS`.
pub optimized_unit_count :: fn(parts: ^const Parts, cpus: usize, forced: ?usize) -> usize {
    if n := forced { return n.clamp(1, MAX_UNITS) }
    return (parts.funcs.len / OPTIMIZED_UNIT_BYTES).clamp(1, cpus.clamp(1, MAX_UNITS))
}

/// The number of units to compile `parts` as on `cpus` processors: `forced` (from
/// `GAMMA_C_UNITS`, which tests use to split small programs) if given, else one per
/// `UNIT_BYTES` of function text, at most one per processor and `MAX_UNITS`.
pub unit_count :: fn(parts: ^const Parts, cpus: usize, forced: ?usize) -> usize {
    if n := forced { return n.clamp(1, MAX_UNITS) }
    return (parts.funcs.len / UNIT_BYTES).clamp(1, cpus.clamp(1, MAX_UNITS))
}

/// The source of each unit of `parts` split `n` ways, or `null` if the code has a shape
/// the split does not handle (it is then compiled as one unit).
pub split :: fn(parts: ^const Parts, n: usize) -> ?[]string needs Alloc {
    s := split_shared(parts, n) else return null
    out := list(string)
    for u in s.units { out.push(str.format("{}{}", s.shared, u)!)! }
    return out.items
}

/// The units of a split: the text every unit starts with, and what each adds to it.
pub Split :: struct {
    pub shared: string
    pub units: []string
}

/// As `split`, with the text the units share kept apart.
pub split_shared :: fn(parts: ^const Parts, n: usize) -> ?Split needs Alloc {
    all := items_of(parts.funcs) else return null
    // The inline functions, by name: their definitions are shared.
    inline_names := hash_map.hash_map(string, ())
    defer inline_names.deinit()
    inline_defs := list(u8)
    for item in all {
        if d := inline_definition(item) {
            inline_defs.extend(d.def)!
            inline_names.put(d.name, ())!
        }
    }
    decls := list(u8)
    defs := list(u8)
    // Unit 0's `extern` declarations of the inline functions.
    externs := list(u8)
    for line in str.lines(parts.protos) {
        if name := c_fn_name(line) and inline_names.get(name) is not null {
            d := str.strip_prefix(line, "static ") else line
            if not str.contains(d, "inline ") { d = str.format("inline {}", d)! }
            decls.extend(d)!
            decls.push('\n')!
            externs.write("extern {}\n", external(line) else line)!
            continue
        }
        decls.extend(external(line) else line)!
        decls.push('\n')!
    }
    for line in str.lines(parts.data) {
        if line.len is 0 or line.starts_with("#") or line.starts_with("extern ") or line.starts_with("static inline ") {
            decls.extend(line)!
            decls.push('\n')!
            continue
        }
        def := str.strip_prefix(line, "static ") else return null
        head: string = if eq := str.split_once(def, " = ") { eq.before } else { str.strip_suffix(def, ";") else return null }
        decls.write("extern {};\n", head)!
        defs.extend(def)!
        defs.push('\n')!
    }
    items := list(string)
    for item in all {
        if inline_definition(item) is not null { continue }
        f := function(item) else return null
        decls.extend(f.decl)!
        decls.push('\n')!
        items.push(f.def)!
    }
    shared := str.format("{}{}{}", parts.head, decls.items, inline_defs.items)!
    total: usize = 0
    for item in items.items { total += item.len }
    share := ((total + n.max(1) - 1) / n.max(1)).max(1)
    units := list(List(u8))
    first := list(u8)
    first.write("{}{}{}", parts.once, defs.items, externs.items)!
    units.push(first)!
    size: usize = 0
    for item in items.items {
        if size >= share and units.items.len < n {
            units.push(list(u8))!
            size = 0
        }
        size += item.len
        units.items[units.items.len - 1].extend(item)!
    }
    units.items[0].extend(parts.tail)!
    out := list(string)
    for u in units.items { out.push(u.items)! }
    return Split(shared: shared, units: out.items)
}

/// The name of the function a declaration or definition line declares: the first `gm_`
/// identifier followed by its parameters.
c_fn_name :: fn(line: string) -> ?string {
    i: usize = 0
    while i + 3 <= line.len {
        if line[i..i + 3] is "gm_" and (i is 0 or not ident_char(line[i - 1])) {
            j := i
            while j < line.len and ident_char(line[j]) { j += 1 }
            if j < line.len and line[j] is '(' { return line[i..j] }
            i = j
        } else {
            i += 1
        }
    }
    return null
}

ident_char :: fn(c: u8) -> bool => (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c is '_'

/// Whether the first line of a function definition is of an `#inline` function. (The small
/// functions an optimized build marks `inline` are external: sharing their thousands of
/// definitions would multiply the work of every unit.)
is_inline :: fn(line: string) -> bool => line.starts_with("static ") and str.contains(line, "__attribute__((always_inline)) inline ")

/// Function definition `item` as an inline definition (without `static`) and its name, if
/// it is of an inline function.
inline_definition :: fn(item: string) -> ?(def: string, name: string) needs Alloc {
    start: usize = 0
    while start < item.len and item[start] is '#' {
        end := str.find(item[start..item.len], "\n") else break
        start += end + 1
    }
    text := item[start..item.len]
    first_end := str.find(text, "\n") else text.len
    first := text[0..first_end]
    if not is_inline(first) { return null }
    name := c_fn_name(first) else return null
    return (def: str.format("{}{}", item[0..start], text["static ".len..text.len])!, name: name)
}

/// `line` as an external declaration, if it is a `static` one (not `static inline`, except
/// for a generated function that an optimized build marks `inline` because it is small).
/// An `#inline` hint is dropped: a function cannot be inlined into another unit, and an
/// `inline` definition without `static` would define no symbol for the others to call.
external :: fn(line: string) -> ?string needs Alloc {
    if r := str.strip_prefix(line, "static inline __attribute__((aligned(4))) ") { return str.format("__attribute__((aligned(4))) {}", r)! }
    if line.starts_with("static inline ") { return null }
    rest: string = ""
    if r := str.strip_prefix(line, "static ") {
        rest = r
    } else {
        r := str.strip_prefix(line, "GM_NOINLINE static ") else return null
        rest = str.format("GM_NOINLINE {}", r)!
    }
    return str.replace_alloc(rest, "__attribute__((always_inline)) inline ", "")!
}

/// The declaration and the external definition of function definition `item`.
function :: fn(item: string) -> ?(decl: string, def: string) needs Alloc {
    // `#line` directives may come first.
    start: usize = 0
    while start < item.len and item[start] is '#' {
        end := str.find(item[start..item.len], "\n") else break
        start += end + 1
    }
    pre := item[0..start]
    text := item[start..item.len]
    first_end := str.find(text, "\n") else text.len
    first := text[0..first_end]
    def := item
    if ext := external(first) {
        def = str.format("{}{}{}", pre, ext, text[first_end..text.len])!
    } else if first.starts_with("static ") or first.starts_with("GM_NOINLINE static ") {
        return null
    }
    // The header ends at the body's opening brace, outside the parentheses.
    body := def[pre.len..def.len]
    depth: i32 = 0
    open: ?usize = null
    for i, c in enumerate(body) {
        if c is '(' {
            depth += 1
        } else if c is ')' {
            depth -= 1
        } else if c is '{' and depth is 0 {
            open = i
            break
        }
    }
    at := open else return null
    header := str.trim_end(body[0..at])
    for c in header {
        if c in ('\n', '"', '\'') { return null }
    }
    if str.contains(header, "static") { return null }
    return (decl: str.format("{};", header)!, def: def)
}

/// The top-level items of C text that holds only function definitions, each with the
/// preprocessor lines and blank lines before it; `null` if it holds anything else.
items_of :: fn(code: string) -> ?[]string needs Alloc {
    items := list(string)
    start: usize = 0
    depth: i32 = 0
    i: usize = 0
    line_start := true
    while i < code.len {
        c := code[i]
        if c is '#' and line_start {
            while i < code.len and code[i] is not '\n' { i += 1 }
            continue
        }
        if c is '"' or c is '\'' {
            i += 1
            while i < code.len and code[i] is not c {
                i += if code[i] is '\\' { 2 } else { 1 }
            }
        } else if c is '/' and i + 1 < code.len and code[i + 1] is '*' {
            i += 2
            while i + 1 < code.len and not (code[i] is '*' and code[i + 1] is '/') { i += 1 }
            i += 1
        } else if c is '/' and i + 1 < code.len and code[i + 1] is '/' {
            while i + 1 < code.len and code[i + 1] is not '\n' { i += 1 }
        } else if c is '{' {
            depth += 1
        } else if c is '}' {
            depth -= 1
            if depth < 0 { return null }
            if depth is 0 and (i + 1 >= code.len or code[i + 1] is '\n') {
                i = (i + 2).min(code.len)
                items.push(code[start..i])!
                start = i
                line_start = true
                continue
            }
        } else if c is ';' and depth is 0 {
            return null
        }
        line_start = c is '\n'
        i += 1
    }
    // Only blank lines and directives may follow the last item.
    for l in str.lines(code[start..code.len]) {
        if str.trim(l).len > 0 and not l.starts_with("#") { return null }
    }
    return items.items
}

test_parts :: fn() -> Parts => Parts(
    head: "typedef int gm_t0;\n",
    protos: "static int gm_f0(int a);\nGM_NOINLINE static void gm_pf0(void);\nstatic void gm_f1(void);\n",
    data: "static const uint8_t gm_s0[3] = \"a;\";\nstatic uint8_t gm_c0[8] __attribute__((aligned(8)));\nstatic inline int gm_ga0(void) { return 0; }\n",
    once: "int gm_checks = 1;\n",
    funcs: "#line 3 \"a.gm\"\nstatic int gm_f0(int a) {\n    if (a) { return \"}\"[0]; }\n    return 0;\n}\nGM_NOINLINE static void gm_pf0(void) { }\nstatic __attribute__((aligned(4))) void gm_f1(void) {\n    /* } */\n}\n",
    tail: "int main(void) { return gm_f0(1); }\n",
)

test "functions and data get external linkage" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        p := test_parts()
        units := split(&p, 2) else {
            expect(false)
            return
        }
        expect_eq(units.len, 2)
        for u in units {
            expect(str.contains(u, "int gm_f0(int a);\nGM_NOINLINE void gm_pf0(void);\n"))
            expect(str.contains(u, "extern const uint8_t gm_s0[3];\nextern uint8_t gm_c0[8] __attribute__((aligned(8)));\n"))
            expect(str.contains(u, "static inline int gm_ga0(void)"))
            expect(str.contains(u, "__attribute__((aligned(4))) void gm_f1(void);"))
        }
        u0 := units[0]
        expect(str.contains(u0, "int gm_checks = 1;\nconst uint8_t gm_s0[3] = \"a;\";\nuint8_t gm_c0[8]"))
        expect(str.contains(u0, "#line 3 \"a.gm\"\nint gm_f0(int a) {\n"))
        expect(u0.ends_with("int main(void) { return gm_f0(1); }\n"))
        expect(not str.contains(units[1], "gm_checks") and not str.contains(units[1], "main"))
        expect(str.contains(units[1], "\n__attribute__((aligned(4))) void gm_f1(void) {\n"))
    }
}

test "inline functions are inline definitions in every unit, external in unit 0" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        p := test_parts()
        p.protos = str.format("{}static __attribute__((aligned(4))) __attribute__((always_inline)) inline int gm_f5(int a);\nstatic __attribute__((aligned(4))) int gm_f6(void);\n", p.protos)!
        p.funcs = str.format("{}#line 9 \"a.gm\"\nstatic __attribute__((aligned(4))) __attribute__((always_inline)) inline int gm_f5(int a) {{\n    return a;\n}}\nstatic inline __attribute__((aligned(4))) int gm_f6(void) {{ return 6; }}\n", p.funcs)!
        // A small function of an optimized build stays external.
        units := split(&p, 2) else {
            expect(false)
            return
        }
        for u in units {
            expect(str.contains(u, "\n__attribute__((aligned(4))) __attribute__((always_inline)) inline int gm_f5(int a);\n"))
            expect(str.contains(u, "#line 9 \"a.gm\"\n__attribute__((aligned(4))) __attribute__((always_inline)) inline int gm_f5(int a) {\n    return a;\n}\n"))
            expect(str.contains(u, "\n__attribute__((aligned(4))) int gm_f6(void);\n"))
        }
        expect(str.contains(units[0], "extern __attribute__((aligned(4))) int gm_f5(int a);\n"))
        expect(str.contains(units[0], "\n__attribute__((aligned(4))) int gm_f6(void) { return 6; }\n") or str.contains(units[1], "\n__attribute__((aligned(4))) int gm_f6(void) { return 6; }\n"))
        expect(not str.contains(units[1], "extern __attribute__((aligned(4))) int gm_f5"))
    }
}

test "an inline hint is dropped from external declarations" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        expect_eq(external("static __attribute__((aligned(4))) __attribute__((always_inline)) inline int gm_f2(int a);") else "", "__attribute__((aligned(4))) int gm_f2(int a);")
        expect_eq(external("static __attribute__((noinline)) void gm_f3(void);") else "", "__attribute__((noinline)) void gm_f3(void);")
        // A small function of an optimized build.
        expect_eq(external("static inline __attribute__((aligned(4))) int gm_f4(int a) {") else "", "__attribute__((aligned(4))) int gm_f4(int a) {")
        expect(external("static inline int gm_ga0(void) { return 0; }") is null)
    }
}

test "optimized builds are split only when very large" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        p := Parts()
        expect_eq(optimized_unit_count(&p, 4, null), 1)
        expect_eq(optimized_unit_count(&p, 4, 3), 3)
        big := list(u8)
        str.repeat(&big, "x", OPTIMIZED_UNIT_BYTES * 2 + 1)!
        p.funcs = big.items
        expect_eq(optimized_unit_count(&p, 4, null), 2)
        expect_eq(optimized_unit_count(&p, 1, null), 1)
    }
}

test "other shapes are not split" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        p := test_parts()
        p.funcs = str.format("{}static int gm_x;\n", p.funcs)!
        expect(split(&p, 2) is null)
        p = test_parts()
        p.funcs = str.format("{}static inline int gm_y(void) {{ return 1; }}\n", p.funcs)!
        expect(split(&p, 2) is null)
        p = test_parts()
        p.data = str.format("{}int gm_z;\n", p.data)!
        expect(split(&p, 2) is null)
    }
}

test "macros of the data are shared" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        p := test_parts()
        p.data = str.format("{}#define gm_g0 ((uint8_t *)&errno)\n", p.data)!
        units := split(&p, 2) else {
            expect(false)
            return
        }
        for u in units { expect(str.contains(u, "#define gm_g0 ((uint8_t *)&errno)\n")) }
    }
}

test "unit count" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        p := test_parts()
        expect_eq(unit_count(&p, 4, null), 1)
        expect_eq(unit_count(&p, 4, 3), 3)
        expect_eq(unit_count(&p, 4, 20), MAX_UNITS)
        big := list(u8)
        str.repeat(&big, "x", 10 * UNIT_BYTES)!
        p.funcs = big.items
        expect_eq(unit_count(&p, 4, null), 4)
        expect_eq(unit_count(&p, 64, null), MAX_UNITS)
    }
}

test "a split keeps the shared text apart" {
    a := arena.new()
    defer a.deinit()
    with a.allocator() {
        p := test_parts()
        s := split_shared(&p, 2) else {
            expect(false)
            return
        }
        units := split(&p, 2) else {
            expect(false)
            return
        }
        expect_eq(s.units.len, units.len)
        for i, u in enumerate(s.units) {
            expect(not str.contains(u, "int gm_f0(int a);\n"))
            expect_eq(str.format("{}{}", s.shared, u)!, units[i])
        }
    }
}
