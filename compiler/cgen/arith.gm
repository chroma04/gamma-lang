// Operators and builtins on scalars, with the checks of §7.4 and §18.
//
// An integer of `bits` bits is held in a C integer of its storage size. Values are kept
// normalized (zero- or sign-extended from `bits`), so comparisons and bitwise operations
// work directly; arithmetic detects overflow of the Gamma type, which may be narrower
// than its C type.

ast :: import "../ast"
bigint :: import "../bigint"
str :: import "std/str"
tir :: import "../tir"
types :: import "../types"

/// Facts about an integer type.
pub IntInfo :: struct {
    pub signed: bool
    pub bits: u32
    pub storage: u64
}

/// Whether the type fills its C type.
ii_exact :: fn(ii: IntInfo) -> bool => u64(ii.bits) is ii.storage * 8

/// The signed or unsigned C type of the storage.
ii_cty :: fn(ii: IntInfo) -> string => int_cty(ii.signed, ii.storage)

/// The unsigned C type of the storage.
ii_ucty :: fn(ii: IntInfo) -> string => int_cty(false, ii.storage)

pub ii_min :: fn(ii: IntInfo) -> bigint.Int needs Alloc {
    if ii.signed { return bigint.neg(bigint.shl(bigint.one(), u64(ii.bits) - 1)) }
    return bigint.zero()
}

pub ii_max :: fn(ii: IntInfo) -> bigint.Int needs Alloc {
    if ii.signed { return bigint.sub(bigint.shl(bigint.one(), u64(ii.bits) - 1), bigint.one()) }
    return bigint.sub(bigint.shl(bigint.one(), u64(ii.bits)), bigint.one())
}

arith_op_symbol :: fn(op: tir.BinOp) -> string => match op {
    .Add(_) => "+"
    .Sub(_) => "-"
    .Mul(_) => "*"
    .Shl(_) => "<<"
    .Div => "/"
    .Rem => "%"
    .Shr => ">>"
    .BitAnd => "&"
    .BitOr => "|"
    .BitXor => "~"
    .Lt => "<"
    .Le => "<="
    .Gt => ">"
    .Ge => ">="
}

/// The flavor of an operator that has one.
arith_flavor :: fn(op: tir.BinOp) -> ?ast.Flavor => match op {
    .Add(f) => f
    .Sub(f) => f
    .Mul(f) => f
    .Shl(f) => f
    _ => null
}

/// The name of the runtime function behind a system operation (`SysOp::signature().0`).
arith_sys_name :: fn(op: tir.SysOp) -> string => match op {
    .Read => "sys_read"
    .ClockNow => "clock_now"
    .ClockWall => "clock_wall"
    .Sleep => "clock_sleep"
    .RandFill => "rand_fill"
    .FsOpen => "fs_open"
    .FsClose => "fs_close"
    .FsRead => "fs_read"
    .FsWrite => "fs_write"
    .FsSeek => "fs_seek"
    .FsStat => "fs_stat"
    .FsRemove => "fs_remove"
    .FsRename => "fs_rename"
    .FsMakeDir => "fs_make_dir"
    .FsRemoveDir => "fs_remove_dir"
    .FsOpenDir => "fs_open_dir"
    .FsNextEntry => "fs_next_entry"
    .FsCloseDir => "fs_close_dir"
    .FsLstat => "fs_lstat"
    .FsTruncate => "fs_truncate"
    .FsSync => "fs_sync"
    .FsCwd => "fs_cwd"
    .NetConnect => "net_connect"
    .NetListen => "net_listen"
    .NetLocalPort => "net_local_port"
    .NetAccept => "net_accept"
    .NetSend => "net_send"
    .NetRecv => "net_recv"
    .NetClose => "net_close"
    .NetShutdown => "net_shutdown"
    .NetSetTimeouts => "net_set_timeouts"
    .NetPeer => "net_peer"
    .ProcSpawn => "proc_spawn"
    .ProcWriteIn => "proc_write_in"
    .ProcCloseIn => "proc_close_in"
    .ProcReadOut => "proc_read_out"
    .ProcWait => "proc_wait"
    .ProcKill => "proc_kill"
    .ThreadSpawn => "thread_spawn"
    .ThreadJoin => "thread_join"
    .ThreadDetach => "thread_detach"
    .ThreadYield => "thread_yield"
    .FutexWait => "futex_wait"
    .FutexWake => "futex_wake"
    .CpuCount => "cpu_count"
    .SysWrite => "sys_write"
}

pub int_info :: fn(fg: ^FnGen, t: Ty) -> ?IntInfo needs Alloc {
    .Int(signed, bits, storage) := fg.g.ty.repr(t) else return null
    return IntInfo(signed: signed, bits: bits, storage: storage)
}

/// `v` reduced to `bits` bits (two's complement wrap), as a C expression.
pub normalize :: fn(fg: ^FnGen, ii: IntInfo, v: string) -> string needs Alloc {
    if ii_exact(ii) { return v }
    shift := ii.storage * 8 - u64(ii.bits)
    if ii.signed {
        return str.format("(({})((({}){}) << {}) >> {})", ii_cty(ii), ii_ucty(ii), v, shift, shift)!
    }
    return str.format("(({})(({}) & ((({})1 << {}) - 1)))", ii_cty(ii), v, ii_cty(ii), ii.bits)!
}

pub unary :: fn(fg: ^FnGen, e: ^Expr, op: tir.UnOp, x: ^Expr) -> Unsup!string needs sema.Load {
    v := try fg.expr(x)
    t := e.ty
    match op {
        .Not => return fg.tmp(t, str.format("(uint8_t)!{}", v)!)
        .Neg => match fg.g.ty.repr(x.ty) {
            .Float(_) => return fg.tmp(t, str.format("-{}", v)!)
            .Int(_, _, _) => {
                ii := fg.int_info(x.ty)?
                min := fg.int_lit(x.ty, ii_min(ii))
                if fg.g.opts.checks {
                    loc := fg.loc(e)
                    fg.line(str.format("if ({} == {}) gm_trap(\"integer overflow in `-`\", {});", v, min, loc)!)
                }
                r := str.format("({})(({})0 - ({}){})", ii_cty(ii), ii_ucty(ii), ii_ucty(ii), v)!
                r2 := fg.normalize(ii, r)
                return fg.tmp(t, r2)
            }
            _ => return !unsupported(e.span, str.format("negating `{}`", fg.g.ty.show(x.ty))!)
        }
        .BitNot => {
            ii := fg.int_info(x.ty) else return !unsupported(e.span, str.format("`~` on `{}`", fg.g.ty.show(x.ty))!)
            r := fg.normalize(ii, str.format("({})~{}", ii_cty(ii), v)!)
            return fg.tmp(t, r)
        }
    }
}

pub binary :: fn(fg: ^FnGen, e: ^Expr, op: tir.BinOp, l: ^Expr, r: ^Expr) -> Unsup!string needs sema.Load {
    a := try fg.expr(l)
    b := try fg.expr(r)
    t := e.ty
    if op in (.Lt, .Le, .Gt, .Ge) {
        match fg.g.ty.repr(l.ty) {
            .Int(_, _, _), .Float(_), .Bool, .Ptr => {
                return fg.tmp(t, str.format("({} {} {})", a, arith_op_symbol(op), b)!)
            }
            _ => {
                lt := fg.g.helpers.less_fn(&fg.g.ty, l.ty)
                eq := fg.g.helpers.eq_fn(&fg.g.ty, l.ty)
                pa := fg.addr_of(l.ty, a)
                pb := fg.addr_of(l.ty, b)
                c: string = match op {
                    .Lt => str.format("{}({}, {})", lt, pa, pb)!
                    .Gt => str.format("{}({}, {})", lt, pb, pa)!
                    .Le => str.format("({}({}, {}) || {}({}, {}))", lt, pa, pb, eq, pa, pb)!
                    _ => str.format("({}({}, {}) || {}({}, {}))", lt, pb, pa, eq, pb, pa)!
                }
                return fg.tmp(t, str.format("(uint8_t){}", c)!)
            }
        }
    }
    match fg.g.ty.repr(l.ty) {
        .Float(_) => {
            sym: string = match op {
                .Add(_) => "+"
                .Sub(_) => "-"
                .Mul(_) => "*"
                .Div => "/"
                _ => return !unsupported(e.span, str.format("operator `{}` on floats", arith_op_symbol(op))!)
            }
            return fg.tmp(t, str.format("({} {} {})", a, sym, b)!)
        }
        .Int(_, _, _) => return try fg.int_binary(e, op, l.ty, a, b)
        _ => return !unsupported(e.span, str.format("operator `{}` on `{}`", arith_op_symbol(op), fg.g.ty.show(l.ty))!)
    }
}

/// The C expression converting the number `v` (of any C arithmetic type) to the float
/// type `t`. An `f16` result goes through `GM_F16`.
pub float_from :: fn(fg: ^FnGen, t: Ty, v: string) -> string needs Alloc {
    if fg.g.ty.kind(t) is .Float(16) { return str.format("GM_F16({})", v)! }
    return str.format("({})({})", fg.g.ty.cty(t), v)!
}

pub int_binary :: fn(fg: ^FnGen, e: ^Expr, op: tir.BinOp, lt: Ty, a: string, b: string) -> Unsup!string needs sema.Load {
    ii := fg.int_info(lt)?
    c := ii_cty(ii)
    loc := fg.loc(e)
    t := e.ty
    match op {
        .Add(fl), .Sub(fl), .Mul(fl) => {
            name: string = match op {
                .Add(_) => "add"
                .Sub(_) => "sub"
                _ => "mul"
            }
            r := str.format("r{}", fg.fresh())!
            o := str.format("o{}", fg.fresh())!
            fg.line(str.format("{} {}; bool {} = __builtin_{}_overflow({}, {}, &{});", c, r, o, name, a, b, r)!)
            if not ii_exact(ii) {
                min := fg.int_lit(lt, ii_min(ii))
                max := fg.int_lit(lt, ii_max(ii))
                fg.line(str.format("{} = {} || {} < {} || {} > {};", o, o, r, min, r, max)!)
            }
            sat: string = "1"
            if ii.signed {
                match op {
                    .Add(_) => { sat = str.format("({} > 0)", b)! }
                    .Sub(_) => { sat = str.format("({} < 0)", b)! }
                    _ => { sat = str.format("(({} < 0) == ({} < 0))", a, b)! }
                }
            } else if op is .Sub(_) {
                sat = "0"
            }
            return try fg.finish_int(fl, ii, lt, t, r, o, sat, loc, arith_op_symbol(op))
        }
        .Shl(_), .Shr => {
            fl: ast.Flavor = arith_flavor(op) else .Checked
            n := str.format("n{}", fg.fresh())!
            fg.line(str.format("unsigned __int128 {} = (unsigned __int128){};", n, b)!)
            if fg.g.opts.checks {
                fg.line(str.format("if ({} >= {}) {{ char m[128]; snprintf(m, sizeof m, \"shift amount %llu too large for {}\", (unsigned long long){}); gm_trap(m, {}); }}", n, ii.bits, fg.g.ty.show(lt), n, loc)!)
            } else {
                fg.line(str.format("{} %= {};", n, ii.bits)!)
            }
            if op is .Shr { return fg.tmp(t, str.format("({})({} >> (int){})", c, a, n)!) }
            r := str.format("r{}", fg.fresh())!
            raw := str.format("({})(({}){} << (int){})", c, ii_ucty(ii), a, n)!
            norm := fg.normalize(ii, raw)
            fg.line(str.format("{} {} = {};", c, r, norm)!)
            o := str.format("o{}", fg.fresh())!
            fg.line(str.format("bool {} = ({})({} >> (int){}) != {};", o, c, r, n, a)!)
            sat := str.format("({} > 0)", a)!
            return try fg.finish_int(fl, ii, lt, t, r, o, sat, loc, "<<")
        }
        .Div, .Rem => {
            sym := arith_op_symbol(op)
            fg.line(str.format("if ({} == 0) gm_trap(\"division by zero\", {});", b, loc)!)
            if ii.signed {
                min := fg.int_lit(lt, ii_min(ii))
                fg.line(str.format("if ({} == {} && {} == ({})-1) gm_trap(\"integer overflow in `{}`\", {});", a, min, b, c, sym, loc)!)
            }
            r: string = if op is .Div { str.format("({} / {})", a, b)! } else { str.format("({} % {})", a, b)! }
            return fg.tmp(t, str.format("({}){}", c, r)!)
        }
        .BitAnd, .BitOr, .BitXor => {
            s: string = match op {
                .BitAnd => "&"
                .BitOr => "|"
                _ => "^"
            }
            return fg.tmp(t, str.format("({})({} {} {})", c, a, s, b)!)
        }
        _ => @unreachable()
    }
}

/// Completes an integer operation whose wrapped result is `r` and whose overflow flag is
/// `o`, according to the flavor (§7.4.2). `sat_up` says which way a saturating result
/// goes.
finish_int :: fn(fg: ^FnGen, fl: ast.Flavor, ii: IntInfo, lt: Ty, t: Ty, r: string, o: string, sat_up: string, loc: string, sym: string) -> Unsup!string needs sema.Load {
    wrapped := fg.normalize(ii, r)
    match fl {
        .Checked => {
            if fg.g.opts.checks {
                fg.line(str.format("if ({}) gm_trap(\"integer overflow in `{}`\", {});", o, sym, loc)!)
            }
            return fg.tmp(t, wrapped)
        }
        .Wrap => return fg.tmp(t, wrapped)
        .Sat => {
            min := fg.int_lit(lt, ii_min(ii))
            max := fg.int_lit(lt, ii_max(ii))
            return fg.tmp(t, str.format("{} ? ({} ? {} : {}) : {}", o, sat_up, max, min, wrapped)!)
        }
        .Opt => {
            res := fg.tmp_uninit(t)
            fg.line(str.format("if ({}) {{", o)!)
            none := fg.make_none(t)
            fg.line(str.format("    {} = {};", res, none)!)
            fg.line("} else {")
            w := fg.tmp(lt, wrapped)
            some := fg.make_some(t, w)
            fg.line(str.format("    {} = {};", res, some)!)
            fg.line("}")
            return res
        }
    }
}

// --- builtins ---------------------------------------------------------------------------------

/// The bytes of an `@asm` string literal, as a C string.
asm_text :: fn(e: ^Expr) -> string needs Alloc {
    .Str(s) := e.kind else @unreachable()
    return c_string(s)
}

/// `@asm` (§19.5): a volatile GNU C `asm` statement. Outputs are written through their
/// pointers.
arith_asm :: fn(fg: ^FnGen, args: []Expr, outputs: usize, inputs: usize) -> Unsup!string needs sema.Load {
    outs := list(string)
    for i in 0..outputs {
        c := &args[1 + 2 * i]
        p := &args[2 + 2 * i]
        .Ptr(_, pointee) := fg.g.ty.kind(p.ty) else @unreachable()
        ct := fg.g.ty.cty(pointee)
        pv := try fg.expr(p)
        outs.push(str.format("{}(*({} *){})", asm_text(c), ct, pv)!)!
    }
    ins := list(string)
    for i in 0..inputs {
        c := &args[1 + 2 * (outputs + i)]
        v := &args[2 + 2 * (outputs + i)]
        vv := try fg.expr(v)
        ins.push(str.format("{}({})", asm_text(c), vv)!)!
    }
    clobbers := list(string)
    for k in (1 + 2 * (outputs + inputs))..args.len { clobbers.push(asm_text(&args[k]))! }
    fg.line(str.format("__asm__ volatile ({} : {} : {} : {});", asm_text(&args[0]), str.join(outs.items, ", ")!, str.join(ins.items, ", ")!, str.join(clobbers.items, ", ")!)!)
    return fg.unit()
}

pub builtin :: fn(fg: ^FnGen, e: ^Expr, op: tir.Builtin, args: []Expr) -> Unsup!string needs sema.Load {
    if r := try fg.vector_builtin(e, op, args) { return r }
    t := e.ty
    loc := fg.loc(e)
    tys := &fg.g.ty.s.tys
    match op {
        .Assert => {
            // Fast builds remove `assert`, argument and all (§21.6).
            if not fg.g.opts.checks { return fg.unit() }
            c := try fg.expr(&args[0])
            fg.line(str.format("if (!{}) {{", c)!)
            fg.indent += 1
            m := try fg.expr(&args[1])
            a := fg.addr_of(args[1].ty, m)
            p := fg.slice_ptr(a)
            l := fg.slice_len(a)
            prefix := "assertion failed"
            fg.line(str.format("gm_buf mb = {{0}}; size_t ml = {}; const uint8_t *mp = {}; if (ml == {} && memcmp(mp, \"{}\", {}) == 0) gm_buf_push(&mb, mp, ml); else {{ gm_buf_push(&mb, \"{}: \", {}); gm_buf_push(&mb, mp, ml); }} gm_trap_bytes(mb.data, mb.len, {});", l, p, prefix.len, prefix, prefix.len, prefix, prefix.len + 2, loc)!)
            fg.indent -= 1
            fg.line("}")
            return fg.unit()
        }
        .Fiber => return try fg.fiber_builtin(e, args)
        .Asm(counts) => return try fg.arith_asm(args, usize(counts.outputs), usize(counts.inputs))
        // `@name(args)` calls the runtime's `gm_name`, with slices passed as a pointer and
        // a length.
        .Sys(sop) => {
            cargs := list(string)
            for i in 0..args.len {
                a := &args[i]
                v := try fg.expr(a)
                if fg.g.ty.kind(a.ty) is .Slice(_, _) {
                    addr := fg.addr_of(a.ty, v)
                    cargs.push(str.format("(void *){}, {}", fg.slice_ptr(addr), fg.slice_len(addr))!)!
                } else {
                    cargs.push(v)!
                }
            }
            call := str.format("gm_{}({})", arith_sys_name(sop), str.join(cargs.items, ", ")!)!
            if fg.g.ty.is_unit(t) {
                fg.line(str.format("{};", call)!)
                return fg.unit()
            }
            return fg.tmp(t, call)
        }
        .Cover(id) => {
            fg.line(str.format("GM_COVER({});", id)!)
            return fg.unit()
        }
        .Unreachable => {
            fg.line(str.format("gm_trap(\"reached `@unreachable()`\", {});", loc)!)
            return fg.zero(t)
        }
        .Get, .GetPtr, .First, .Last => return try fg.arith_get(e, op, args)
        .HeapAlloc => {
            s := try fg.expr(&args[0])
            a := try fg.expr(&args[1])
            fg.line(str.format("if (({}) == 0 || (({}) & (({}) - 1)) != 0) gm_trap(\"allocation alignment is not a power of two\", {});", a, a, a, loc)!)
            p := fg.tmp(tys.intern(.Rawptr), str.format("gm_heap_alloc({}, {})", s, a)!)
            return fg.tmp(t, p)
        }
        .AllocTag, .AllocCheck => {
            if not fg.g.opts.debug { return fg.unit() }
            v := list(string)
            for k in 0..3 { v.push(try fg.expr(&args[k]))! }
            f := try fg.expr(&args[3])
            fa := fg.addr_of(args[3].ty, f)
            fp := fg.slice_ptr(fa)
            fl := fg.slice_len(fa)
            line := try fg.expr(&args[4])
            col := try fg.expr(&args[5])
            if op is .AllocTag {
                fg.line(str.format("gm_alloc_tag({}, {}, {}, {}, {}, {}, {});", v.items[0], v.items[1], v.items[2], fp, fl, line, col)!)
            } else {
                // The check traps at its own location, like the interpreter.
                fg.line(str.format("gm_alloc_check({}, {}, {}, {}, {}, {}, {}, {});", v.items[0], v.items[1], v.items[2], fp, fl, line, col, loc)!)
            }
            return fg.unit()
        }
        .HeapFree => {
            p := try fg.expr(&args[0])
            s := try fg.expr(&args[1])
            a := try fg.expr(&args[2])
            fg.line(str.format("gm_heap_free({}, {}, {}, {});", p, s, a, loc)!)
            return fg.unit()
        }
        _ => {}
    }
    vals := list(string)
    for i in 0..args.len { vals.push(try fg.expr(&args[i]))! }
    v0 := vals.items[0]
    at := args[0].ty
    match op {
        .Convert, .Trunc, .Round, .Floor, .Ceil, .Checked, .Sat => return try fg.convert(e, op, at, v0)
        .Bits => {
            a := fg.addr_of(at, v0)
            r := fg.tmp_uninit(t)
            sz := fg.g.ty.size(at)
            fg.line(str.format("memset(&{}, 0, sizeof {}); memcpy(&{}, {}, sizeof {} < {} ? sizeof {} : {});", r, r, r, a, r, sz, r, sz)!)
            if ii := fg.int_info(t) {
                if not ii_exact(ii) {
                    nv := fg.normalize(ii, r)
                    fg.line(str.format("{} = {};", r, nv)!)
                }
            }
            return r
        }
        .Cast => {
            al := arith_pointee_align(fg, t)
            if al > 1 and fg.g.opts.checks {
                fg.line(str.format("if ((uintptr_t){} % {} != 0) gm_trap_misaligned((uintptr_t){}, {}, {});", v0, al, v0, al, loc)!)
            }
            return fg.tmp(t, v0)
        }
        .Addr => return fg.tmp(t, str.format("(uintptr_t){}", v0)!)
        .ToPtr => return fg.tmp(t, str.format("GM_INT_TO_PTR({})", v0)!)
        .PtrAdd, .PtrSub, .PtrDiff => {
            .ManyPtr(_, elem) := fg.g.ty.kind(at) else @unreachable()
            stride := fg.g.ty.size(elem)
            p := v0
            x := vals.items[1]
            if op is .PtrDiff {
                if stride is 0 { return fg.tmp(t, "0") }
                return fg.tmp(t, str.format("(intptr_t)((uintptr_t){} - (uintptr_t){}) / (intptr_t){}", p, x, stride)!)
            }
            sign := if op is .PtrAdd { "" } else { "-" }
            return fg.tmp(t, str.format("GM_PTR_ADD({}, {}((uintptr_t){} * {}u))", p, sign, x, stride)!)
        }
        .Tag => {
            a := fg.addr_of(at, v0)
            return fg.load(t, a)
        }
        .FromTag => {
            .Optional(u) := fg.g.ty.kind(t) else return !unsupported(e.span, "from_tag")
            .Union(_, variants) := fg.g.ty.adt_of(u).kind else return !unsupported(e.span, "from_tag")
            res0 := fg.make_none(t)
            res := fg.tmp(t, res0)
            for i in 0..variants.len {
                vd := variants[i]
                if vd.payload is not null { continue }
                lit := fg.int_lit(at, vd.tag)
                fg.line(str.format("if ({} == {}) {{", v0, lit)!)
                x := fg.make_variant(u, i, null)
                s := fg.make_some(t, x)
                fg.line(str.format("    {} = {};", res, s)!)
                fg.line("}")
            }
            return res
        }
        .Min, .Max => {
            gt := if op is .Min { "<" } else { ">" }
            if fg.g.ty.repr(at) is .Float(_) {
                f := if op is .Min { "gm_fmin" } else { "gm_fmax" }
                r := fg.float_from(t, str.format("{}((double){}, (double){})", f, v0, vals.items[1])!)
                return fg.tmp(t, r)
            }
            return fg.tmp(t, str.format("({} {} {} ? {} : {})", v0, gt, vals.items[1], v0, vals.items[1])!)
        }
        .Clamp => {
            x := v0
            lo := vals.items[1]
            hi := vals.items[2]
            if fg.g.ty.repr(at) is .Float(_) {
                r := fg.float_from(t, str.format("gm_fmin(gm_fmax((double){}, (double){}), (double){})", x, lo, hi)!)
                return fg.tmp(t, r)
            }
            return fg.tmp(t, str.format("({} < {} ? {} : ({} > {} ? {} : {}))", x, lo, lo, x, hi, hi, x)!)
        }
        .Abs => {
            if fg.g.ty.repr(at) is .Float(_) {
                return fg.tmp(t, str.format("({} < 0 || (({}) == 0 && __builtin_signbit({}))) ? -{} : {}", v0, v0, v0, v0, v0)!)
            }
            ii := fg.int_info(at)?
            if ii.signed and fg.g.opts.checks {
                min := fg.int_lit(at, ii_min(ii))
                fg.line(str.format("if ({} == {}) gm_trap(\"integer overflow in `abs`\", {});", v0, min, loc)!)
            }
            return fg.tmp(t, str.format("({} < 0 ? -{} : {})", v0, v0, v0)!)
        }
        .AbsDiff => {
            ii := fg.int_info(at)?
            u := ii_ucty(ii)
            a := v0
            b := vals.items[1]
            return fg.tmp(t, str.format("({} > {} ? ({}){} - ({}){} : ({}){} - ({}){})", a, b, u, a, u, b, u, b, u, a)!)
        }
        .IsNan => return fg.tmp(t, str.format("(uint8_t)__builtin_isnan({})", v0)!)
        .IsInf => return fg.tmp(t, str.format("(uint8_t)__builtin_isinf({})", v0)!)
        .IsFinite => return fg.tmp(t, str.format("(uint8_t)__builtin_isfinite({})", v0)!)
        .SignBit => return fg.tmp(t, str.format("(uint8_t)(__builtin_signbit({}) != 0)", v0)!)
        .Sqrt => {
            f := if fg.g.ty.kind(at) is .Float(32) { "__builtin_sqrtf" } else { "__builtin_sqrt" }
            r := fg.float_from(t, str.format("{}({})", f, v0)!)
            return fg.tmp(t, r)
        }
        .Fma => {
            f := if fg.g.ty.kind(at) is .Float(32) { "__builtin_fmaf" } else { "__builtin_fma" }
            r := fg.float_from(t, str.format("{}({}, {}, {})", f, v0, vals.items[1], vals.items[2])!)
            return fg.tmp(t, r)
        }
        .Rotl, .Rotr => {
            ii := fg.int_info(at)?
            x := str.format("(unsigned __int128)({})({})", ii_ucty(ii), v0)!
            k0 := str.format("(uint64_t){}", vals.items[1])!
            // A right rotation by k is a left rotation by bits - k mod bits.
            k: string = if op is .Rotl { k0 } else { str.format("({} - {} % {})", ii.bits, k0, ii.bits)! }
            c := fg.g.ty.cty(t)
            r := fg.tmp(t, str.format("({})gm_rotl({}, {}, {})", c, x, k, ii.bits)!)
            n := fg.normalize(ii, r)
            return fg.tmp(t, n)
        }
        .Clz, .Ctz, .Popcount, .Bswap, .Bitreverse => {
            ii := fg.int_info(at)?
            x0 := str.format("(unsigned __int128)({})({})", ii_ucty(ii), v0)!
            // Keep the low bits only (a shift by 128 would be undefined in C).
            x: string = if ii.bits >= 128 { x0 } else { str.format("({} & (((unsigned __int128)1 << {}) - 1))", x0, ii.bits)! }
            c := fg.g.ty.cty(t)
            call: string = match op {
                .Clz => str.format("gm_clz({}, {})", x, ii.bits)!
                .Ctz => str.format("gm_ctz({}, {})", x, ii.bits)!
                .Popcount => str.format("gm_popcount({})", x)!
                .Bswap => {
                    if ii.bits % 8 is not 0 { return !unsupported(e.span, "bswap of a partial byte") }
                    str.format("gm_bswap({}, {})", x, ii.bits)!
                }
                _ => str.format("gm_bitreverse({}, {})", x, ii.bits)!
            }
            r := fg.tmp(t, str.format("({}){}", c, call)!)
            if op in (.Bswap, .Bitreverse) {
                if ri := fg.int_info(t) {
                    n := fg.normalize(ri, r)
                    return fg.tmp(t, n)
                }
            }
            return r
        }
        .Pow(fl) => {
            ii := fg.int_info(at) else return !unsupported(e.span, "float pow")
            c := ii_cty(ii)
            r := str.format("r{}", fg.fresh())!
            o := str.format("o{}", fg.fresh())!
            f := str.format("gm_pow_{}{}", if ii.signed { "i" } else { "u" }, ii.storage * 8)!
            fg.line(str.format("bool {} = false; {} {} = {}({}, (uint64_t){}, &{});", o, c, r, f, v0, vals.items[1], o)!)
            if not ii_exact(ii) {
                min := fg.int_lit(at, ii_min(ii))
                max := fg.int_lit(at, ii_max(ii))
                fg.line(str.format("{} = {} || {} < {} || {} > {};", o, o, r, min, r, max)!)
            }
            if fl is .Checked and fg.g.opts.checks {
                // The message names the operands, as the interpreter's does.
                b := fg.tmp(at, v0)
                fg.line(str.format("if ({}) gm_trap_pow((const uint8_t *)&{}, {}, {}, (uint32_t){}, {});", o, b, ii.bits, ii.signed, vals.items[1], loc)!)
            }
            sat := str.format("({} > 0 || ({} & 1) == 0)", v0, vals.items[1])!
            return try fg.finish_int(fl, ii, at, t, r, o, sat, loc, "pow")
        }
        .CstrLen => return fg.tmp(t, str.format("(uintptr_t)strlen((const char *){})", v0)!)
        .AtomicLoad, .AtomicStore, .AtomicSwap, .AtomicCas, .AtomicRmw(_), .VolatileLoad, .VolatileStore => {
            .Ptr(_, elem) := fg.g.ty.kind(at) else return !unsupported(e.span, "this atomic")
            c := fg.g.ty.cty(elem)
            p := str.format("(({} *){})", c, v0)!
            ords := list(string)
            for i in 1..args.len {
                x := &args[i]
                if fg.g.ty.kind(x.ty) is not .Adt(_, _) { continue }
                a := fg.addr_of(x.ty, vals.items[i])
                ords.push(str.format("gm_ord[GM_LD(uint8_t, {})]", a)!)!
            }
            match op {
                .VolatileLoad => return fg.tmp(t, str.format("*(volatile {} *){}", c, v0)!)
                .VolatileStore => {
                    fg.line(str.format("*(volatile {} *){} = {};", c, v0, vals.items[1])!)
                    return fg.unit()
                }
                .AtomicLoad => return fg.tmp(t, str.format("__atomic_load_n({}, {})", p, ords.items[0])!)
                .AtomicStore => {
                    fg.line(str.format("__atomic_store_n({}, {}, {});", p, vals.items[1], ords.items[0])!)
                    return fg.unit()
                }
                .AtomicSwap => return fg.tmp(t, str.format("__atomic_exchange_n({}, {}, {})", p, vals.items[1], ords.items[0])!)
                .AtomicCas => {
                    exp := fg.tmp(elem, vals.items[1])
                    ok := fg.tmp(fg.g.ty.bool_ty(), str.format("__atomic_compare_exchange_n({}, &{}, {}, 0, {}, {})", p, exp, vals.items[2], ords.items[0], ords.items[1])!)
                    res := fg.tmp_uninit(t)
                    none := fg.make_none(t)
                    some := fg.make_some(t, exp)
                    fg.line(str.format("{} = {} ? {} : {};", res, ok, none, some)!)
                    return res
                }
                .AtomicRmw(rmw) => {
                    f: ?string = match rmw {
                        .Add => "__atomic_fetch_add"
                        .Sub => "__atomic_fetch_sub"
                        .And => "__atomic_fetch_and"
                        .Or => "__atomic_fetch_or"
                        .Xor => "__atomic_fetch_xor"
                        .Max, .Min => null
                    }
                    if fname := f {
                        return fg.tmp(t, str.format("{}({}, {}, {})", fname, p, vals.items[1], ords.items[0])!)
                    }
                    cmp := if rmw is .Max { ">" } else { "<" }
                    old := fg.tmp(elem, str.format("__atomic_load_n({}, __ATOMIC_RELAXED)", p)!)
                    v := vals.items[1]
                    fg.line(str.format("while (!__atomic_compare_exchange_n({}, &{}, {} {} {} ? {} : {}, 1, {}, __ATOMIC_RELAXED)) {{}}", p, old, v, cmp, old, v, old, ords.items[0])!)
                    return old
                }
                _ => @unreachable()
            }
        }
        .Fence => {
            a := fg.addr_of(at, v0)
            fg.line(str.format("__atomic_thread_fence(gm_ord[GM_LD(uint8_t, {})]);", a)!)
            return fg.unit()
        }
        .BlackBox => {
            if fg.g.ty.is_unit(t) { return v0 }
            // The compiler must assume nothing about the value. An integer or a boolean
            // goes through an empty `asm` that may change it, which needs no stack slot (a
            // program with thousands of sites would give the C compiler thousands of slots
            // to lay out); any other value goes through memory behind a volatile pointer.
            c := fg.g.ty.cty(t)
            in_register: bool = not fg.g.ty.lay.target.filc and match fg.g.ty.repr(t) {
                .Int(_, _, storage) => storage <= 8
                .Bool => true
                _ => false
            }
            if in_register {
                v := fg.tmp(t, v0)
                fg.line(str.format("__asm__ volatile (\"\" : \"+r\"({}));", v)!)
                return v
            }
            slot := fg.tmp(t, v0)
            p := str.format("t{}", fg.fresh())!
            fg.line(str.format("{} *volatile {} = &{};", c, p, slot)!)
            return fg.tmp(t, str.format("*{}", p)!)
        }
        .Hash => {
            f := fg.g.helpers.hash_fn(&fg.g.ty, at)
            a := fg.addr_of(at, v0)
            return fg.tmp(t, str.format("{}({}, 0xcbf29ce484222325ULL ^ (uint64_t){})", f, a, vals.items[1])!)
        }
        _ => return !unsupported(e.span, "this builtin")
    }
}

/// `a.get(i)`, `a.get_ptr(i)`, `a.first()`, `a.last()`: `null` when out of range.
arith_get :: fn(fg: ^FnGen, e: ^Expr, op: tir.Builtin, args: []Expr) -> Unsup!string needs sema.Load {
    t := e.ty
    base := &args[0]
    ptr: string = ""
    len: string = ""
    match fg.g.ty.kind(base.ty) {
        .Slice(_, _) => {
            v := try fg.expr(base)
            a := fg.addr_of(base.ty, v)
            ptr = str.format("((uint8_t *){})", fg.slice_ptr(a))!
            len = fg.slice_len(a)
        }
        .Array(n, _, _) => {
            ptr = try fg.place_addr(base)
            len = str.format("{}", n)!
        }
        .Ptr(_, pointee) => match fg.g.ty.kind(pointee) {
            .Array(n, _, _) => {
                v := try fg.expr(base)
                ptr = str.format("((uint8_t *){})", v)!
                len = str.format("{}", n)!
            }
            _ => return !unsupported(e.span, "get on a pointer")
        }
        _ => return !unsupported(e.span, str.format("get on `{}`", fg.g.ty.show(base.ty))!)
    }
    tys := &fg.g.ty.s.tys
    ptr = fg.tmp(tys.ptr(false, tys.u8_ty()), ptr)
    len = fg.tmp(fg.g.ty.usize_ty(), str.format("(uintptr_t){}", len)!)
    i: string = match op {
        .First => "(uintptr_t)0"
        .Last => str.format("({} - 1)", len)!
        _ => {
            v := try fg.expr(&args[1])
            fg.bound(args[1].ty, v)
        }
    }
    i = fg.tmp(fg.g.ty.usize_ty(), i)
    .Optional(inner) := fg.g.ty.kind(t) else return !unsupported(e.span, "get")
    elem := inner
    if op is .GetPtr {
        if .Ptr(_, pointee) := fg.g.ty.kind(inner) { elem = pointee }
    }
    esz := fg.g.ty.size(elem)
    res := fg.tmp_uninit(t)
    fg.line(str.format("if ({} < {}) {{", i, len)!)
    addr := str.format("((uint8_t *){} + {} * {})", ptr, i, esz)!
    v: string = if op is .GetPtr { str.format("(void *){}", addr)! } else { fg.load(inner, addr) }
    some := fg.make_some(t, v)
    fg.line(str.format("    {} = {};", res, some)!)
    fg.line("} else {")
    none := fg.make_none(t)
    fg.line(str.format("    {} = {};", res, none)!)
    fg.line("}")
    return res
}

/// The numeric conversions `T(x)`, `.trunc`, `.round`, `.floor`, `.ceil`, `.checked`, `.sat`.
pub convert :: fn(fg: ^FnGen, e: ^Expr, op: tir.Builtin, src: Ty, v: string) -> Unsup!string needs sema.Load {
    t := e.ty
    target := t
    if op is .Checked {
        if .Optional(x) := fg.g.ty.kind(t) { target = x }
    }
    loc := fg.loc(e)
    // The source as a number: integers (and bools, enum tags) or a float.
    src_int := false
    src_val := ""
    match fg.g.ty.repr(src) {
        .Int(_, _, _) => {
            src_int = true
            src_val = v
        }
        .Bool => {
            src_int = true
            src_val = str.format("(int64_t){}", v)!
        }
        .Float(_) => { src_val = str.format("(double){}", v)! }
        .Blob if fg.g.ty.kind(src) is .Adt(_, _) => match fg.g.ty.adt_of(src).kind {
            .Union(tag, _) => {
                a := fg.addr_of(src, v)
                src_int = true
                src_val = fg.load(tag, a)
            }
            .Struct(sd) => {
                u := sd.bits else return !unsupported(e.span, str.format("converting from `{}`", fg.g.ty.show(src))!)
                a := fg.addr_of(src, v)
                src_int = true
                src_val = fg.load(u, a)
            }
            _ => return !unsupported(e.span, str.format("converting from `{}`", fg.g.ty.show(src))!)
        }
        _ => return !unsupported(e.span, str.format("converting from `{}`", fg.g.ty.show(src))!)
    }
    match fg.g.ty.repr(target) {
        .Int(_, _, _) => {
            ii := fg.int_info(target)?
            c := ii_cty(ii)
            if src_int {
                si: bool = match fg.g.ty.repr(src) {
                    .Int(signed, _, _) => signed
                    _ => true
                }
                fits := arith_fits(ii, src_val, si)
                wrapped := fg.normalize(ii, str.format("({}){}", c, src_val)!)
                match op {
                    .Checked => {
                        res := fg.tmp_uninit(t)
                        w := fg.tmp(target, wrapped)
                        some := fg.make_some(t, w)
                        none := fg.make_none(t)
                        fg.line(str.format("{} = {} ? {} : {};", res, fits, some, none)!)
                        return res
                    }
                    .Sat => {
                        min := fg.int_lit(target, ii_min(ii))
                        max := fg.int_lit(target, ii_max(ii))
                        neg: string = if si { str.format("({} < 0)", src_val)! } else { "0" }
                        return fg.tmp(t, str.format("{} ? {} : ({} ? {} : {})", fits, wrapped, neg, min, max)!)
                    }
                    _ => return fg.tmp(t, wrapped)
                }
            }
            tys := &fg.g.ty.s.tys
            f64_ty := tys.intern(.Float(64))
            x := fg.tmp(f64_ty, src_val)
            rounded: string = match op {
                .Round => str.format("GM_ROUNDEVEN({})", x)!
                .Floor => str.format("__builtin_floor({})", x)!
                .Ceil => str.format("__builtin_ceil({})", x)!
                _ => str.format("__builtin_trunc({})", x)!
            }
            r := fg.tmp(f64_ty, rounded)
            lo := str.format("{:e}", arith_int_to_f64(ii_min(ii)))!
            hi := str.format("{:e}", arith_int_to_f64(bigint.add(ii_max(ii), bigint.one())))!
            in_range := str.format("(__builtin_isfinite({}) && {} >= {} && {} < {})", r, r, lo, r, hi)!
            match op {
                .Checked => {
                    res := fg.tmp_uninit(t)
                    fg.line(str.format("if ({} && {} == {}) {{", in_range, x, r)!)
                    w := fg.tmp(target, str.format("({}){}", c, r)!)
                    some := fg.make_some(t, w)
                    fg.line(str.format("    {} = {};", res, some)!)
                    fg.line("} else {")
                    none := fg.make_none(t)
                    fg.line(str.format("    {} = {};", res, none)!)
                    fg.line("}")
                    return res
                }
                .Sat => {
                    min := fg.int_lit(target, ii_min(ii))
                    max := fg.int_lit(target, ii_max(ii))
                    return fg.tmp(t, str.format("__builtin_isnan({}) ? ({})0 : ({} < {} ? {} : ({} >= {} ? {} : ({}){}))", x, c, r, lo, min, r, hi, max, c, r)!)
                }
                _ => {
                    if fg.g.opts.checks {
                        fg.line(str.format("if (!{}) gm_trap(\"float to integer conversion out of range\", {});", in_range, loc)!)
                    }
                    return fg.tmp(t, str.format("({}){}", c, r)!)
                }
            }
        }
        .Float(_) => {
            r := fg.float_from(target, src_val)
            return fg.tmp(t, r)
        }
        _ => {}
    }
    // An integer to a `#bits` struct: its bits, wrapped to the underlying type.
    if src_int {
        if bl := fg.g.ty.bits_layout(target) {
            ui := fg.int_info(bl.int_ty)?
            w := fg.normalize(ui, str.format("({}){}", ii_cty(ui), src_val)!)
            b := fg.tmp_uninit(target)
            fg.line(str.format("GM_ST({}, (uint8_t *)&{}, {});", ii_cty(ui), b, w)!)
            return b
        }
    }
    return !unsupported(e.span, str.format("converting to `{}`", fg.g.ty.show(target))!)
}

/// A C condition: the integer `v` (signed if `signed`) fits the type `ii`.
arith_fits :: fn(ii: IntInfo, v: string, signed: bool) -> string needs Alloc {
    max := split_u128(ii_max(ii))
    max_lit := str.format("(((unsigned __int128){}ULL << 64) | {}ULL)", max.1.trunc(u64), max.0.trunc(u64))!
    if signed {
        min := split_u128(ii_min(ii))
        min_lit := str.format("((__int128)(((unsigned __int128){}ULL << 64) | {}ULL))", min.1.trunc(u64), min.0.trunc(u64))!
        return str.format("((__int128)({}) >= {} && ((__int128)({}) < 0 || (unsigned __int128)({}) <= {}))", v, min_lit, v, v, max_lit)!
    }
    return str.format("((unsigned __int128)({}) <= {})", v, max_lit)!
}

arith_pointee_align :: fn(fg: ^FnGen, t: Ty) -> u64 needs Alloc {
    match fg.g.ty.kind(t) {
        .Ptr(_, p), .ManyPtr(_, p) => {
            if fg.g.ty.size(p) is 0 { return 1 }
            return fg.g.ty.align(p)
        }
        .Optional(x) => return arith_pointee_align(fg, x)
        _ => return 1
    }
}

/// The nearest `f64` to the integer `v`.
arith_int_to_f64 :: fn(v: bigint.Int) -> f64 {
    acc: f64 = 0.0
    i := v.mag.items.len
    while i > 0 {
        i -= 1
        acc = acc * 4294967296.0 + f64(v.mag.items[i])
    }
    return if v.negative { -acc } else { acc }
}
