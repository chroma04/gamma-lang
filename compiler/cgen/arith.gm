// Operators on scalars (the builtins are in `builtins.gm`), with the checks of §7.4 and §18.
//
// An integer of `bits` bits is held in a C integer of its storage size. Values are kept
// normalized (zero- or sign-extended from `bits`), so comparisons and bitwise operations
// work directly; arithmetic detects overflow of the Gamma type, which may be narrower
// than its C type.

ast :: import "../ast"
bigint :: import "../bigint"
str :: import "std/str"
tir :: import "../tir"
types :: import "../types"

/// Facts about an integer type.
pub IntInfo :: struct {
    pub signed: bool
    pub bits: u32
    pub storage: u64
}

/// Whether the type fills its C type.
ii_exact :: fn(ii: IntInfo) -> bool => u64(ii.bits) is ii.storage * 8

/// The signed or unsigned C type of the storage.
ii_cty :: fn(ii: IntInfo) -> string => int_cty(ii.signed, ii.storage)

/// The unsigned C type of the storage.
ii_ucty :: fn(ii: IntInfo) -> string => int_cty(false, ii.storage)

ii_min :: fn(ii: IntInfo) -> bigint.Int needs Alloc {
    if ii.signed { return bigint.neg(bigint.shl(bigint.one(), u64(ii.bits) - 1)) }
    return bigint.zero()
}

ii_max :: fn(ii: IntInfo) -> bigint.Int needs Alloc {
    if ii.signed { return bigint.sub(bigint.shl(bigint.one(), u64(ii.bits) - 1), bigint.one()) }
    return bigint.sub(bigint.shl(bigint.one(), u64(ii.bits)), bigint.one())
}

/// The flavor of an operator that has one.
arith_flavor :: fn(op: tir.BinOp) -> ?ast.Flavor => match op {
    .Add(f) => f
    .Sub(f) => f
    .Mul(f) => f
    .Shl(f) => f
    _ => null
}

int_info :: fn(fg: ^FnGen, t: Ty) -> ?IntInfo needs Alloc {
    .Int(signed, bits, storage) := fg.g.ty.repr(t) else return null
    return IntInfo(signed: signed, bits: bits, storage: storage)
}

/// `v` reduced to `bits` bits (two's complement wrap), as a C expression.
pub normalize :: fn(ii: IntInfo, v: string) -> string needs Alloc {
    if ii_exact(ii) { return v }
    shift := ii.storage * 8 - u64(ii.bits)
    if ii.signed {
        return str.format("(({})((({}){}) << {}) >> {})", ii_cty(ii), ii_ucty(ii), v, shift, shift)!
    }
    return str.format("(({})(({}) & ((({})1 << {}) - 1)))", ii_cty(ii), v, ii_cty(ii), ii.bits)!
}

unary :: fn(fg: ^FnGen, e: ^Expr, op: tir.UnOp, x: ^Expr) -> Unsup!string needs sema.Load {
    v := try fg.expr(x)
    t := e.ty
    match op {
        .Not => return fg.tmp(t, str.format("(uint8_t)!{}", v)!)
        .Neg => match fg.g.ty.repr(x.ty) {
            .Float(_) => return fg.tmp(t, str.format("-{}", v)!)
            .Int(_, _, _) => {
                ii := fg.int_info(x.ty)?
                min := fg.int_lit(x.ty, ii_min(ii))
                if fg.g.opts.checks {
                    loc := fg.loc(e)
                    fg.linef("if ({} == {}) gm_trap(\"integer overflow in `-`\", {});", v, min, loc)
                }
                r := str.format("({})(({})0 - ({}){})", ii_cty(ii), ii_ucty(ii), ii_ucty(ii), v)!
                r2 := normalize(ii, r)
                return fg.tmp(t, r2)
            }
            _ => return !unsupported(e.span, str.format("negating `{}`", fg.g.ty.show(x.ty))!)
        }
        .BitNot => {
            ii := fg.int_info(x.ty) else return !unsupported(e.span, str.format("`~` on `{}`", fg.g.ty.show(x.ty))!)
            r := normalize(ii, str.format("({})~{}", ii_cty(ii), v)!)
            return fg.tmp(t, r)
        }
    }
}

binary :: fn(fg: ^FnGen, e: ^Expr, op: tir.BinOp, l: ^Expr, r: ^Expr) -> Unsup!string needs sema.Load {
    a := try fg.expr(l)
    b := try fg.expr(r)
    t := e.ty
    if op in (.Lt, .Le, .Gt, .Ge) {
        match fg.g.ty.repr(l.ty) {
            .Int(_, _, _), .Float(_), .Bool, .Ptr => {
                return fg.tmp(t, str.format("({} {} {})", a, tir.binop_symbol(op), b)!)
            }
            _ => {
                lt := fg.g.helpers.less_fn(&fg.g.ty, l.ty)
                eq := fg.g.helpers.eq_fn(&fg.g.ty, l.ty)
                pa := fg.addr_of(l.ty, a)
                pb := fg.addr_of(l.ty, b)
                c: string = match op {
                    .Lt => str.format("{}({}, {})", lt, pa, pb)!
                    .Gt => str.format("{}({}, {})", lt, pb, pa)!
                    .Le => str.format("({}({}, {}) || {}({}, {}))", lt, pa, pb, eq, pa, pb)!
                    _ => str.format("({}({}, {}) || {}({}, {}))", lt, pb, pa, eq, pb, pa)!
                }
                return fg.tmp(t, str.format("(uint8_t){}", c)!)
            }
        }
    }
    match fg.g.ty.repr(l.ty) {
        .Float(_) => {
            sym: string = match op {
                .Add(_) => "+"
                .Sub(_) => "-"
                .Mul(_) => "*"
                .Div => "/"
                _ => return !unsupported(e.span, str.format("operator `{}` on floats", tir.binop_symbol(op))!)
            }
            return fg.tmp(t, str.format("({} {} {})", a, sym, b)!)
        }
        .Int(_, _, _) => return try fg.int_binary(e, op, l.ty, a, b)
        _ => return !unsupported(e.span, str.format("operator `{}` on `{}`", tir.binop_symbol(op), fg.g.ty.show(l.ty))!)
    }
}

/// The C expression converting the number `v` (of any C arithmetic type) to the float
/// type `t`. An `f16` result goes through `GM_F16`.
float_from :: fn(fg: ^FnGen, t: Ty, v: string) -> string needs Alloc {
    if fg.g.ty.kind(t) is .Float(16) { return str.format("GM_F16({})", v)! }
    return str.format("({})({})", fg.g.ty.cty(t), v)!
}

int_binary :: fn(fg: ^FnGen, e: ^Expr, op: tir.BinOp, lt: Ty, a: string, b: string) -> Unsup!string needs sema.Load {
    ii := fg.int_info(lt)?
    c := ii_cty(ii)
    loc := fg.loc(e)
    t := e.ty
    match op {
        .Add(fl), .Sub(fl), .Mul(fl) => {
            name: string = match op {
                .Add(_) => "add"
                .Sub(_) => "sub"
                _ => "mul"
            }
            r := str.format("r{}", fg.fresh())!
            o := str.format("o{}", fg.fresh())!
            fg.linef("{} {}; bool {} = __builtin_{}_overflow({}, {}, &{});", c, r, o, name, a, b, r)
            if not ii_exact(ii) {
                min := fg.int_lit(lt, ii_min(ii))
                max := fg.int_lit(lt, ii_max(ii))
                fg.linef("{} = {} || {} < {} || {} > {};", o, o, r, min, r, max)
            }
            sat: string = "1"
            if ii.signed {
                match op {
                    .Add(_) => { sat = str.format("({} > 0)", b)! }
                    .Sub(_) => { sat = str.format("({} < 0)", b)! }
                    _ => { sat = str.format("(({} < 0) == ({} < 0))", a, b)! }
                }
            } else if op is .Sub(_) {
                sat = "0"
            }
            return try fg.finish_int(fl, ii, lt, t, r, o, sat, loc, tir.binop_symbol(op))
        }
        .Shl(_), .Shr => {
            fl: ast.Flavor = arith_flavor(op) else .Checked
            n := str.format("n{}", fg.fresh())!
            fg.linef("unsigned __int128 {} = (unsigned __int128){};", n, b)
            if fg.g.opts.checks {
                fg.linef("if ({} >= {}) gm_trap_shift((uint64_t){}, \"{}\", {});", n, ii.bits, n, fg.g.ty.show(lt), loc)
            } else {
                fg.linef("{} %= {};", n, ii.bits)
            }
            if op is .Shr { return fg.tmp(t, str.format("({})({} >> (int){})", c, a, n)!) }
            r := str.format("r{}", fg.fresh())!
            raw := str.format("({})(({}){} << (int){})", c, ii_ucty(ii), a, n)!
            norm := normalize(ii, raw)
            fg.linef("{} {} = {};", c, r, norm)
            o := str.format("o{}", fg.fresh())!
            fg.linef("bool {} = ({})({} >> (int){}) != {};", o, c, r, n, a)
            sat := str.format("({} > 0)", a)!
            return try fg.finish_int(fl, ii, lt, t, r, o, sat, loc, "<<")
        }
        .Div, .Rem => {
            sym := tir.binop_symbol(op)
            fg.linef("if ({} == 0) gm_trap(\"division by zero\", {});", b, loc)
            if ii.signed {
                min := fg.int_lit(lt, ii_min(ii))
                fg.linef("if ({} == {} && {} == ({})-1) gm_trap(\"integer overflow in `{}`\", {});", a, min, b, c, sym, loc)
            }
            r: string = if op is .Div { str.format("({} / {})", a, b)! } else { str.format("({} % {})", a, b)! }
            return fg.tmp(t, str.format("({}){}", c, r)!)
        }
        .BitAnd, .BitOr, .BitXor => {
            s: string = match op {
                .BitAnd => "&"
                .BitOr => "|"
                _ => "^"
            }
            return fg.tmp(t, str.format("({})({} {} {})", c, a, s, b)!)
        }
        _ => @unreachable()
    }
}

/// Completes an integer operation whose wrapped result is `r` and whose overflow flag is
/// `o`, according to the flavor (§7.4.2). `sat_up` says which way a saturating result
/// goes.
finish_int :: fn(fg: ^FnGen, fl: ast.Flavor, ii: IntInfo, lt: Ty, t: Ty, r: string, o: string, sat_up: string, loc: string, sym: string) -> Unsup!string needs sema.Load {
    wrapped := normalize(ii, r)
    match fl {
        .Checked => {
            if fg.g.opts.checks {
                fg.linef("if ({}) gm_trap(\"integer overflow in `{}`\", {});", o, sym, loc)
            }
            return fg.tmp(t, wrapped)
        }
        .Wrap => return fg.tmp(t, wrapped)
        .Sat => {
            min := fg.int_lit(lt, ii_min(ii))
            max := fg.int_lit(lt, ii_max(ii))
            return fg.tmp(t, str.format("{} ? ({} ? {} : {}) : {}", o, sat_up, max, min, wrapped)!)
        }
        .Opt => {
            res := fg.tmp_uninit(t)
            fg.linef("if ({}) {{", o)
            none := fg.make_none(t)
            fg.linef("    {} = {};", res, none)
            fg.line("} else {")
            w := fg.tmp(lt, wrapped)
            some := fg.make_some(t, w)
            fg.linef("    {} = {};", res, some)
            fg.line("}")
            return res
        }
    }
}

/// A C condition: the integer `v` (signed if `signed`) fits the type `ii`.
arith_fits :: fn(ii: IntInfo, v: string, signed: bool) -> string needs Alloc {
    max := split_u128(ii_max(ii))
    max_lit := str.format("(((unsigned __int128){}ULL << 64) | {}ULL)", max.1.trunc(u64), max.0.trunc(u64))!
    if signed {
        min := split_u128(ii_min(ii))
        min_lit := str.format("((__int128)(((unsigned __int128){}ULL << 64) | {}ULL))", min.1.trunc(u64), min.0.trunc(u64))!
        return str.format("((__int128)({}) >= {} && ((__int128)({}) < 0 || (unsigned __int128)({}) <= {}))", v, min_lit, v, v, max_lit)!
    }
    return str.format("((unsigned __int128)({}) <= {})", v, max_lit)!
}

arith_pointee_align :: fn(fg: ^FnGen, t: Ty) -> u64 needs Alloc {
    match fg.g.ty.kind(t) {
        .Ptr(_, p), .ManyPtr(_, p) => {
            if fg.g.ty.size(p) is 0 { return 1 }
            return fg.g.ty.align(p)
        }
        .Optional(x) => return arith_pointee_align(fg, x)
        _ => return 1
    }
}

/// The nearest `f64` to the integer `v`.
arith_int_to_f64 :: fn(v: bigint.Int) -> f64 {
    acc: f64 = 0.0
    i := v.mag.items.len
    while i > 0 {
        i -= 1
        acc = acc * 4294967296.0 + f64(v.mag.items[i])
    }
    return if v.negative { -acc } else { acc }
}
