//! The C back end: translates a checked program to C, which the system C compiler
//! compiles together with the runtime (`runtime/gm_rt.c`). Mirrors `src/cgen/`.
//!
//! The generated code follows the reference implementation's: values have the same
//! bytes, checks trap with the same messages, and formatting goes through the runtime's
//! type descriptors. The optimizations are ported too: functions specialized for the
//! handler that is their context (`spec.gm`), parameters read in place (`borrow.gm`),
//! long runs of statements in helpers (`outline.gm`), shortcuts for long operator chains
//! (`chain.gm`) and constant arguments in static storage (`constarg.gm`). Not ported: the
//! Safe mode and freestanding targets.

ast :: import "../ast"
bigint :: import "../bigint"
hash_map :: import "std/collections/hash_map"
sema :: import "../sema"
source :: import "../source"
str :: import "std/str"
tir :: import "../tir"
types :: import "../types"

Sema :: sema.Sema
Ty :: types.Ty
TyKind :: types.TyKind
EffectRef :: types.EffectRef
EffectSet :: types.EffectSet
Expr :: tir.Expr
ExprKind :: tir.ExprKind

/// A construct the C back end cannot translate.
pub Unsup :: struct {
    pub message: string
    pub span: source.Span
}

/// The error for a construct the C back end cannot translate yet. Call sites write
/// `return !unsupported(span, "...")`.
pub unsupported :: fn(span: source.Span, what: string) -> Unsup needs Alloc {
    return Unsup(message: str.format("not supported by the C back end yet: {}", what)!, span: span)
}

/// Options of a C build.
pub Options :: struct {
    /// Debug, Checked: checked operations trap (§1.4). Fast drops the checks.
    pub checks: bool = true
    /// Debug: heap blocks are tracked so double and invalid frees trap.
    pub debug: bool = true
    /// `-g`: map the C to the Gamma source and name the frame fields after the locals
    /// (see `debug.gm`).
    pub debug_info: bool = false
    /// With `debug_info` on an ELF target: the text of the gdb pretty printers
    /// (`runtime/gdb_printers.py`) to embed in the executable. Empty for none.
    pub gdb_printers: string = ""
}

pub Gen :: struct {
    pub prog: ^Prog
    pub ty: CTypes
    pub opts: Options
    /// The number identifying each effect instance in handler contexts, by its text.
    effect_ids: hash_map.HashMap(string, u32)
    /// The shared functions that perform an ambient output effect, by signature.
    pub stubs: hash_map.HashMap(string, string)
    /// Static byte arrays by content.
    statics: hash_map.HashMap([]const u8, usize)
    static_defs: List(u8)
    pub frames: List(u8)
    pub protos: List(u8)
    pub bodies: List(u8)
    pub helpers: Helpers
    reachable: List(u32)
    queued: List(bool)
    /// Functions whose frame struct has been emitted.
    frames_done: List(bool)
    /// Memo of `is_pure` (`0`: unknown, `1`: being computed, `2`: false, `3`: true).
    pub pure_memo: hash_map.HashMap(u32, u8)
    /// Memo of `read_during_build`, by function.
    pub early_memo: hash_map.HashMap(u32, []bool)
    /// Per function, the parameters whose caller's value no call site lets change (see
    /// `borrow.gm`); computed once for the whole program.
    pub steady: ?List([]bool) = null
    /// Constant large arguments, in static storage `gm_kN` (see `constarg.gm`).
    pub site_consts: List(SiteConst)
    /// The specializations interned so far, by number, and the numbers by key.
    pub spec_keys: List(SpecKey)
    spec_ids: hash_map.HashMap((u32, u32, u32), u32)
    /// Specialized clones requested so far, and those still to generate.
    clones: hash_map.HashMap((u32, u32), bool)
    spec_queue: List((u32, u32))
    /// Handler literals whose table of clause clones for a specialization was emitted.
    spec_tables: hash_map.HashMap((u32, u32), bool)
    /// Memo of `clause_may_exit`, by clause and specialization (see `spec_slot`): `1`
    /// while being computed, `2` false, `3` true.
    exits: hash_map.HashMap((u32, u32), u8)
    /// The locals that function literals or handler clauses reach through their
    /// environment, by function and local (computed on first use, see `frame_locals`).
    pub captured: ?hash_map.HashMap((u32, u32), bool) = null
    pub handler_tables: List(u8)
    /// Libraries to link, from foreign blocks.
    pub libs: List(string)
    handler_done: hash_map.HashMap(u32, bool)
    decl_done: hash_map.HashMap(u32, bool)
    /// The source files trap locations name; each path is one static string `gm_srcN`.
    loc_files: List(u32)
    /// With `-g`: the path each source file's `#line` directives name (`null`: none), by
    /// file.
    line_paths: hash_map.HashMap(u32, ?string)
    /// The storage of compile-time values (`gm_cN`): constants and the static cells
    /// their pointers point into.
    pub statics_cells: List(StaticCell)
    pub cell_ids: hash_map.HashMap(usize, u32)
}

/// What the back end produces.
pub Generated :: struct {
    /// The generated C code, which follows the runtime.
    pub code: string
    /// The same code by role, for a build split into several units (see `split`).
    pub parts: Parts
    /// Libraries to link (from `foreign` blocks), beyond the C library.
    pub libs: []const string
    /// The program is for a freestanding target (§3.7.1): the code is compiled with the
    /// runtime into one object, and has no `main`.
    pub freestanding: bool = false
    /// A freestanding program with a `#trap_hook`.
    pub trap_hook: bool = false
}

/// Translates the program to C source whose `main` runs `entry`.
pub generate :: fn(p: ^Prog, entry: u32, opts: Options) -> Unsup!Generated needs sema.Load {
    entries := [1]u32(entry)
    return generate_entries(p, entries[..], false, opts)
}

/// Translates a program for a freestanding target to C source: no `main`, and the program's
/// exported functions as its entry points (§3.7.1).
pub generate_object :: fn(p: ^Prog, opts: Options) -> Unsup!Generated needs sema.Load {
    return generate_entries(p, empty_slice(u32), false, opts)
}

/// Translates the program to C source whose `main` runs one of `entries`, chosen by the
/// decimal index in its first command-line argument (`gammac test`). Each entry runs
/// exactly as the entry of `generate` does.
pub generate_tests :: fn(p: ^Prog, entries: []const u32, opts: Options) -> Unsup!Generated needs sema.Load {
    return generate_entries(p, entries, true, opts)
}

generate_entries :: fn(p: ^Prog, entries: []const u32, select: bool, opts: Options) -> Unsup!Generated needs sema.Load {
    g := Gen(
        prog: p,
        ty: ctypes(p.s, p.target),
        opts: opts,
        effect_ids: hash_map.hash_map(string, u32),
        stubs: hash_map.hash_map(string, string),
        statics: hash_map.hash_map([]const u8, usize),
        static_defs: list(u8),
        frames: list(u8),
        protos: list(u8),
        bodies: list(u8),
        helpers: new_helpers(),
        reachable: list(u32),
        queued: list(bool),
        frames_done: list(bool),
        pure_memo: hash_map.hash_map(u32, u8),
        early_memo: hash_map.hash_map(u32, []bool),
        site_consts: list(SiteConst),
        spec_keys: list(SpecKey),
        spec_ids: hash_map.hash_map((u32, u32, u32), u32),
        clones: hash_map.hash_map((u32, u32), bool),
        spec_queue: list((u32, u32)),
        spec_tables: hash_map.hash_map((u32, u32), bool),
        exits: hash_map.hash_map((u32, u32), u8),
        handler_tables: list(u8),
        libs: list(string),
        handler_done: hash_map.hash_map(u32, bool),
        decl_done: hash_map.hash_map(u32, bool),
        loc_files: list(u32),
        line_paths: hash_map.hash_map(u32, ?string),
        statics_cells: list(StaticCell),
        cell_ids: hash_map.hash_map(usize, u32),
    )
    g.ty.debug_names = opts.debug_info
    for entry in entries { g.queue(entry) }
    for f in p.s.export_fns.items { g.queue(f) }
    if hook := p.s.trap_hook { g.queue(hook) }
    try g.drain()
    consts := try g.gen_consts()
    exports := try g.gen_exports()
    // A freestanding program has no `main`: its exports start it (§3.7.1).
    freestanding := p.target.os is "Freestanding"
    if freestanding { exports = str.format("{}{}{}", g.gen_start(), exports, try g.gen_trap_hook())! }
    main: string = if freestanding { "" } else { try g.gen_main(entries, select) }
    checks := str.format("GM_API int gm_checks = {};\n", if opts.checks { 1 } else { 0 })!
    head := list(u8)
    head.extend(SUPPORT)!
    head.extend(g.ty.blob_typedefs())!
    // The Gamma names of frame fields and mirror fields (with `-g`) are declared with any
    // macro of the same name suspended.
    names := g.ty.member_names()
    head.extend(guard(names, g.ty.mirror_text()))!
    head.extend(guard(names, g.ty.view_defs()))!
    // The gdb pretty printers are embedded in the executable.
    gdb: string = if opts.debug_info and opts.gdb_printers.len > 0 { gdb_script_section(opts.gdb_printers) } else { "" }
    data := list(u8)
    data.extend(g.ty.descriptors())!
    for id in g.loc_files.items {
        data.write("static const char gm_src{}[] = {};\n", id, c_string(g.prog.s.l.sm.file(id).path))!
    }
    data.extend(g.static_defs.items)!
    frames := guard(names, g.frames.items)
    protos := str.format("{}{}", g.protos.items, g.helpers.protos.items)!
    // One unit has the parts in this order.
    out := list(u8)
    out.extend("/* ---- generated ---- */\n")!
    out.extend(checks)!
    out.extend(head.items)!
    out.extend(gdb)!
    out.extend(data.items)!
    out.extend(frames)!
    out.extend(protos)!
    out.extend(g.handler_tables.items)!
    out.extend(consts.decls)!
    out.extend(consts.init)!
    out.extend(g.helpers.bodies.items)!
    out.extend(g.bodies.items)!
    if not p.target.f16 and str.contains(out.items, "_Float16") {
        return !unsupported(source.DUMMY, "`f16` needs a C compiler with `_Float16`, which this target's compiler lacks")
    }
    if freestanding and str.contains(out.items, "gm_with_go(") and p.target.arch not in ("X86_64", "Aarch64", "S390x") {
        return !Unsup(message: str.format("fibers (`with … on`) need a context switch, which the runtime has only for x86-64, AArch64 and s390x; this freestanding target ({}) has none", p.target.arch)!, span: source.DUMMY)
    }
    // A program that switches fibers runs its entry under the runtime's fiber support.
    run_main := if str.contains(out.items, "gm_with_go(") { "gm_run_main_fibers" } else { "gm_run_main" }
    main_text: string = if main.len is 0 { "" } else { str.format("#define GM_RUN_MAIN {}\n{}", run_main, main)! }
    out.extend(exports)!
    out.extend(main_text)!
    reset := ""
    if opts.debug_info { reset = str.format("{}\n", LINE_RESET)! }
    parts := Parts(
        head: str.format("{}{}", head.items, frames)!,
        protos: protos,
        data: str.format("{}{}{}", data.items, g.handler_tables.items, consts.decls)!,
        once: str.format("{}{}", checks, gdb)!,
        funcs: str.format("{}{}", g.helpers.bodies.items, g.bodies.items)!,
        // The function text before it ends with a marker that a split leaves with the next
        // function (see `split`), so the tail starts with one of its own.
        tail: str.format("{}{}{}{}", reset, consts.init, exports, main_text)!,
    )
    return Generated(code: out.items, parts: parts, libs: g.libs.items, freestanding: freestanding, trap_hook: freestanding and p.s.trap_hook is not null)
}

// ---------------------------------------------------------------------------------
// Functions and their names
// ---------------------------------------------------------------------------------

/// Marks `f` as needed; it is generated later.
pub queue :: fn(g: ^Gen, f: u32) needs Alloc {
    i := usize(f)
    while g.queued.items.len <= i { g.queued.push(false)! }
    if not g.queued.items[i] {
        g.queued.items[i] = true
        g.reachable.push(f)!
    }
}

pub fn_name :: fn(g: ^const Gen, f: u32) -> string needs Alloc => str.format("gm_f{}", f)!

/// The C name of the clone of `f` specialized by `s`.
pub spec_name :: fn(g: ^const Gen, f: u32, s: u32) -> string needs Alloc => str.format("gm_f{}_s{}", f, s)!

/// Marks the clone of `f` specialized by `s` as needed; returns its C name.
pub queue_spec :: fn(g: ^Gen, f: u32, s: u32) -> string needs Alloc {
    if g.clones.get((f, s)) is null {
        g.clones.put((f, s), true)!
        g.spec_queue.push((f, s))!
    }
    return g.spec_name(f, s)
}

/// The number of specialization `key`.
pub spec :: fn(g: ^Gen, key: SpecKey) -> u32 needs Alloc {
    k := (key.hid, key.eff, spec_slot(key.outer))
    if s := g.spec_ids.get(k) { return s }
    s := g.spec_keys.items.len.trunc(u32)
    g.spec_keys.push(key)!
    g.spec_ids.put(k, s)!
    return s
}

pub spec_key :: fn(g: ^const Gen, s: u32) -> SpecKey => g.spec_keys.items[usize(s)]

/// How many specializations `s` is nested in, itself included.
pub spec_depth :: fn(g: ^const Gen, s: u32) -> u32 {
    key := g.spec_key(s)
    if o := key.outer { return 1 + g.spec_depth(o) }
    return 1
}

/// `outer` as part of a hash key: `0` for none, else the specialization's number plus one.
spec_slot :: fn(outer: ?u32) -> u32 {
    if o := outer { return o + 1 }
    return 0
}

/// The C name of clause `c` of a handler whose node is the context `outer` is specialized
/// for (or of the clause itself).
pub clause_name :: fn(g: ^Gen, c: u32, outer: ?u32) -> string needs Alloc {
    if o := outer { return g.queue_spec(c, o) }
    g.queue(c)
    return g.fn_name(c)
}

/// Generates every function and clone queued so far, and those they reach.
drain :: fn(g: ^Gen) -> Unsup!() needs sema.Load {
    while true {
        if f := g.reachable.pop() {
            try gen_fn(g, f, null)
        } else if c := g.spec_queue.pop() {
            try gen_fn(g, c.0, c.1)
        } else {
            return ()
        }
    }
}

/// True if the frame struct of `f` has been emitted; marks it as emitted.
pub frame_done :: fn(g: ^Gen, f: u32) -> bool needs Alloc {
    i := usize(f)
    while g.frames_done.items.len <= i { g.frames_done.push(false)! }
    done := g.frames_done.items[i]
    g.frames_done.items[i] = true
    return done
}

/// The number identifying an effect instance in handler contexts.
pub effect_id :: fn(g: ^Gen, e: ^const EffectRef) -> u32 needs Alloc {
    key := g.prog.s.tys.show_ref(e)
    if id := g.effect_ids.get(key) { return id }
    n := g.effect_ids.len().trunc(u32)
    g.effect_ids.put(key, n)!
    return n
}

/// The name of a static array holding `bytes` followed by a NUL byte.
pub static_bytes :: fn(g: ^Gen, bytes: []const u8) -> string needs Alloc {
    if i := g.statics.get(bytes) { return str.format("gm_s{}", i)! }
    i := g.statics.len()
    g.statics.put(bytes, i)!
    g.static_defs.write("static const uint8_t gm_s{}[{}] = {};\n", i, bytes.len + 1, c_string(bytes))!
    return str.format("gm_s{}", i)!
}

/// `"file", line, col` for a trap at `span` (NULL location for none).
pub src_loc :: fn(g: ^Gen, span: source.Span) -> string needs Alloc {
    if span is source.DUMMY { return "NULL, 0, 0" }
    f := g.prog.s.l.sm.file(span.file)
    lc := f.line_col(span.lo)
    if span.file not in g.loc_files.items { g.loc_files.push(span.file)! }
    return str.format("gm_src{}, {}, {}", span.file, lc.line, lc.col)!
}

/// A `#line` directive for the start of `span`, with debug information on and the span in a
/// file on disk.
pub line_directive :: fn(g: ^Gen, span: source.Span) -> ?string needs Alloc + Fs {
    if not g.opts.debug_info or span is source.DUMMY { return null }
    f := g.prog.s.l.sm.file(span.file)
    path: ?string = null
    if cached := g.line_paths.get(span.file) {
        path = cached
    } else {
        // Named with `/`, as source files are everywhere.
        abs := absolute(f.path)
        stat_failed := Fs.stat(abs) is !_
        if not stat_failed { path = c_string(abs) }
        g.line_paths.put(span.file, path)!
    }
    p := path else return null
    lc := f.line_col(span.lo)
    return str.format("#line {} {}", lc.line, p)!
}

/// The table of the clauses of handler literal `h` as clones specialized for `s`: the
/// handler is installed where `s`'s node is the context, so its clauses run with that node
/// as theirs.
pub spec_handler_table :: fn(g: ^Gen, h: u32, s: u32) -> string needs Alloc {
    name := str.format("gm_hl{}_s{}", h, s)!
    if g.spec_tables.get((h, s)) is null {
        g.spec_tables.put((h, s), true)!
        names := list(string)
        for c in g.prog.handler_lit(h).clauses {
            names.push(str.format("(void *){}", g.queue_spec(c, s))!)!
        }
        g.handler_tables.write("static void *const {}[] = {{{}}};\n", name, str.join(names.items, ", ")!)!
    }
    return name
}

/// The table of clause functions of handler literal `h`, generating it on first use.
pub handler_table :: fn(g: ^Gen, h: u32) -> string needs Alloc {
    if g.handler_done.get(h) is null {
        g.handler_done.put(h, true)!
        names := list(string)
        for c in g.prog.handler_lit(h).clauses {
            g.queue(c)
            names.push(str.format("(void *){}", g.fn_name(c))!)!
        }
        g.handler_tables.write("static void *const gm_hl{}[] = {{{}}};\n", h, str.join(names.items, ", ")!)!
    }
    return str.format("gm_hl{}", h)!
}

/// The table of clause thunks of handler declaration `d`. A thunk has the uniform clause
/// signature and loads `self` from the node's `env` before calling the clause.
pub decl_table :: fn(g: ^Gen, d: u32) -> Unsup!string needs Alloc {
    if g.decl_done.get(d) is null {
        g.decl_done.put(d, true)!
        names := list(string)
        for k, c in enumerate(g.prog.handler_decl(d).clauses) {
            g.queue(c)
            def := g.prog.func(c)
            ret := g.ty.cty(def.ret)
            ptys := list(Ty)
            for p in def.params { ptys.push(def.locals[usize(p)].ty)! }
            self_ty := g.ty.cty(ptys.items[0])
            params := list(string)
            params.extend([3]string("void *env", "gm_node *cx", "gm_node *inst")[..])!
            // `self` is passed by address when large, and `env` is that address.
            self_arg: string = if g.ty.by_ref(ptys.items[0]) { "env" } else { str.format("GM_LD({}, env)", self_ty)! }
            args := list(string)
            args.extend([4]string("NULL", "cx", "inst", self_arg)[..])!
            for i in 1..ptys.items.len {
                params.push(str.format("{} a{}", g.ty.param_cty(ptys.items[i]), i)!)!
                args.push(str.format("a{}", i)!)!
            }
            name := str.format("gm_dt{}_{}", d, k)!
            // A large result goes to `gm_out`, as for every Gamma function.
            ret_kw := "return "
            if g.ty.by_ref(def.ret) {
                params.insert(0, "void *gm_out")!
                args.insert(0, "gm_out")!
                ret = "void"
                ret_kw = ""
            }
            g.protos.write("static {} {}({});\n", ret, name, str.join(params.items, ", ")!)!
            g.bodies.write("static {} {}({}) {{ {}{}({}); }}\n", ret, name, str.join(params.items, ", ")!, ret_kw, g.fn_name(c), str.join(args.items, ", ")!)!
            names.push(str.format("(void *){}", name)!)!
        }
        g.handler_tables.write("static void *const gm_hd{}[] = {{{}}};\n", d, str.join(names.items, ", ")!)!
    }
    return str.format("gm_hd{}", d)!
}

/// Exported functions (§19.4): external C-ABI wrappers under their symbols.
gen_exports :: fn(g: ^Gen) -> Unsup!string needs sema.Load {
    out := list(u8)
    for k, sym in enumerate(g.prog.s.exports.items) {
        f := g.prog.s.export_fns.items[k]
        def := g.prog.func(f)
        // A private C name bound to the symbol, so it cannot clash with declarations of
        // the C headers the runtime includes.
        cname := str.format("gm_xe{}", k)!
        params := list(string)
        args := list(string)
        for i, p in enumerate(def.params) {
            t := def.locals[usize(p)].ty
            params.push(str.format("{} a{}", try g.c_abi_type(t, def.span), i)!)!
            // The function takes mirrors itself (it has the plain convention).
            args.push(if g.ty.mirror(t) is not null { str.format("a{}", i)! } else { str.format("({})a{}", g.ty.cty(t), i)! })!
        }
        call := str.format("{}({})", g.addr_name(f), str.join(args.items, ", ")!)!
        param_text: string = if params.items.len is 0 { "void" } else { str.join(params.items, ", ")! }
        // A freestanding program has no `main`: each export starts it first.
        start := if g.prog.target.os is "Freestanding" { "gm_start(); " } else { "" }
        ret := "void"
        body := str.format("{}{};", start, call)!
        if not g.ty.is_unit(def.ret) {
            ret = try g.c_abi_type(def.ret, def.span)
            value: string = if g.ty.mirror(def.ret) is not null { call } else { str.format("({}){}", ret, call)! }
            body = str.format("{}return {};", start, value)!
        }
        cc := conv_attr(def.win64)
        out.write("{}{} {}({}) __asm__(GM_SYM(\"{}\"));\n", cc, ret, cname, param_text, sym)!
        out.write("{}{} {}({}) {{ {} }}\n", cc, ret, cname, param_text, body)!
    }
    return out.items
}

// ---------------------------------------------------------------------------------
// The entry point
// ---------------------------------------------------------------------------------

/// The C `main`. With `select` it runs the entry whose index is the first argument;
/// otherwise `entries` is the one entry to run.
gen_main :: fn(g: ^Gen, entries: []const u32, select: bool) -> Unsup!string needs sema.Load {
    s := list(u8)
    calls := list(u8)
    for i, entry in enumerate(entries) {
        s.extend(try g.gen_entry(entry, i))!
        calls.write("        case {}: return GM_RUN_MAIN(gm_entry{}, cx);\n", i, i)!
    }
    s.extend("int main(int argc, char **argv) {\n")!
    if select {
        s.extend("    if (argc < 2) { fputs(\"usage: test-binary INDEX\\n\", stderr); return 2; }\n")!
        s.extend("    long which = strtol(argv[1], NULL, 10);\n    gm_set_args(1, argv);\n")!
    } else {
        s.extend("    gm_set_args(argc, argv);\n")!
    }
    s.extend("    gm_thread_stack();\n")!
    s.write("    gm_debug = {};\n", if g.opts.debug { 1 } else { 0 })!
    s.extend("    gm_init_consts();\n    gm_node *cx = NULL;\n")!
    a := g.prog.ambient
    amb := [3]?u32(a.out, a.err, a.env)
    for k, e in enumerate(amb) {
        eff := e else continue
        r := EffectRef(eff: eff, args: empty_slice(types.GenericArg))
        id := g.effect_id(&r)
        s.write("    static gm_node amb{}; amb{} = (gm_node){{.eff = {}, .kind = GM_NATIVE, .next = cx}}; cx = &amb{};\n", k, k, id, k)!
    }
    if select {
        s.write("    switch (which) {{\n{}        default: return 2;\n    }}\n", calls.items)!
    } else {
        s.extend("    return GM_RUN_MAIN(gm_entry0, cx);\n")!
    }
    s.extend("}\n")!
    return s.items
}

/// `static int gm_entry<n>(gm_node *cx)`: runs `entry` under the ambient handlers `cx`
/// and returns the process exit status.
gen_entry :: fn(g: ^Gen, entry: u32, n: usize) -> Unsup!string needs sema.Load {
    ret := g.prog.func(entry).ret
    rc := g.ty.cty(ret)
    s := list(u8)
    s.write("static int gm_entry{}(gm_node *cx) {{\n", n)!
    if g.ty.by_ref(ret) {
        hidden := if g.is_plain(entry) { "" } else { ", NULL, cx, NULL" }
        s.write("    {} r; {}(&r{});\n", rc, g.fn_name(entry), hidden)!
    } else if g.is_plain(entry) {
        if g.ty.is_unit(ret) or g.ty.is_never(ret) {
            s.write("    {}();\n    {} r = GM_ZERO({});\n", g.fn_name(entry), rc, rc)!
        } else {
            s.write("    {} r = {}();\n", rc, g.fn_name(entry))!
        }
    } else {
        s.write("    {} r = {}(NULL, cx, NULL);\n", rc, g.fn_name(entry))!
    }
    s.extend("    (void)cx;\n")!
    s.extend("    if (gm_unw.kind == GM_EXIT) { gm_flush(); return gm_unw.code; }\n")!
    match g.ty.kind(ret) {
        .Result(err, ok) => {
            offs := g.ty.offsets(ret)
            d := g.ty.desc(err)
            s.write("    if (((uint8_t *)&r)[{}]) {{\n", offs[0])!
            s.extend("        gm_buf b = {0};\n        gm_buf_push(&b, \"error: \", 7);\n")!
            // A union's value is named with its type: `E.NotFound` (§3.7).
            if .Adt(id, _) := g.ty.kind(err) and g.prog.adt(id).kind is .Union(_) {
                name := g.ty.show(err)
                s.write("        gm_buf_push(&b, {}, {});\n", c_string(name), name.len)!
            }
            s.write("        gm_format(&b, {}, (uint8_t *)&r + {}, true);\n", d, offs[1])!
            s.extend("        gm_buf_push(&b, \"\\n\", 1);\n        gm_flush();\n")!
            s.extend("        gm_write_err(b.data, b.len);\n        return 1;\n    }\n")!
            if g.ty.is_integer(ok) {
                s.write("    gm_flush();\n    return (uint8_t)GM_LD({}, (uint8_t *)&r + {});\n", g.ty.cty(ok), offs[1])!
            } else {
                s.extend("    gm_flush();\n    return 0;\n")!
            }
        }
        _ => {
            if g.ty.is_integer(ret) {
                s.extend("    gm_flush();\n    return (uint8_t)r;\n")!
            } else {
                s.extend("    (void)r;\n    gm_flush();\n    return 0;\n")!
            }
        }
    }
    s.extend("}\n")!
    return s.items
}

// ---------------------------------------------------------------------------------
// Calling conventions
// ---------------------------------------------------------------------------------

/// Whether a call of clause `c`, as a clone specialized for `outer` when given, may return
/// with an exit in progress. False only when that is certain: its body leaves only
/// locally, and its calls and performs reach only code that does too. The caller then
/// needs no test of `gm_unw` after the call.
pub clause_may_exit :: fn(g: ^Gen, c: u32, outer: ?u32) -> bool needs Alloc {
    key := (c, spec_slot(outer))
    if m := g.exits.get(key) {
        // Recursion: assume the worst.
        return m is not 2
    }
    g.exits.put(key, 1)!
    r := true
    if b := g.prog.func(c).body { r = g.expr_may_exit(b, outer) }
    g.exits.put(key, if r { 3 } else { 2 })!
    return r
}

/// Whether evaluating `e` in a function whose context is the node of `spec` may leave it
/// by a non-local exit, or return from a call with one in progress.
expr_may_exit :: fn(g: ^Gen, e: ^Expr, spec_: ?u32) -> bool needs Alloc {
    match e.kind {
        .Break(b) => match b.target {
            .InstallingWith => return true
            .Label(levels, _) => if levels > 0 { return true }
        }
        .Continue(.Label(levels, _)) => if levels > 0 { return true }
        .Continue(.InstallingWith) => {}
        .Return(levels, _) => if levels > 0 { return true }
        .Try(t) => if t.levels > 0 { return true }
        // Handlers change the context, and fibers and continuations exit through the
        // runtime.
        .With(_), .Resume(_), .Cancel(_) => return true
        .Builtin(.Fiber, _) => return true
        // The sink is a perform or a function value.
        .Write(_) => return true
        .Call(callee, _) => {
            may := false
            match callee {
                .Fn(f) => { may = g.may_unwind(f) }
                .Indirect(_) => { may = true }
                .Perform(eff, op) => {
                    may = true
                    if s := spec_ {
                        if not g.prog.is_ctl(eff.eff, op) {
                            key := g.spec_key(s)
                            clauses := g.prog.handler_lit(key.hid).clauses
                            if usize(op) < clauses.len and g.effect_id(&eff) is key.eff {
                                may = g.clause_may_exit(clauses[usize(op)], key.outer)
                            }
                        }
                    }
                }
            }
            if may { return true }
        }
        _ => {}
    }
    may := false
    tir.for_each_child(e, fn(c: ^Expr) {
        if not may { may = g.expr_may_exit(c, spec_) }
    })
    return may
}

/// True if calls to `f` can leave by a non-local exit (Appendix D.2). A function that
/// performs nothing itself can still leave that way through a second-class function it
/// is passed, which may perform the caller's effects (§11.6).
pub may_unwind :: fn(g: ^Gen, f: u32) -> bool needs Alloc {
    def := g.prog.func(f)
    match def.kind {
        .Foreign(_) => return false
        .Clause, .Literal => return true
        .Named => {
            if not g.within_sys(&def.effects) { return true }
            for p in def.params {
                if g.ty.kind(def.locals[usize(p)].ty) is .Fn(_) { return true }
            }
            return false
        }
    }
}

/// True if every effect of `set` is `Sys`.
pub within_sys :: fn(g: ^const Gen, set: ^const EffectSet) -> bool {
    for e in set.effects {
        if g.prog.ambient.sys is not e.eff { return false }
    }
    return true
}

/// Whether `f` has the plain C calling convention: a function (or non-capturing literal)
/// whose effects are at most `{Sys}`, so it can be a C callback (§19.1).
pub is_plain :: fn(g: ^Gen, f: u32) -> bool needs Alloc {
    def := g.prog.func(f)
    return match def.kind {
        .Foreign(_) => true
        .Named, .Literal => def.parent is null and g.within_sys(&def.effects)
        .Clause => false
    }
}

/// The C name used to call `f`: foreign functions have a private alias.
pub callee_name :: fn(g: ^Gen, f: u32) -> string needs Alloc {
    if g.prog.func(f).kind is .Foreign(_) { return str.format("gm_x{}", f)! }
    return g.fn_name(f)
}

/// Whether plain function `f` needs a separate C-ABI entry point: its own signature
/// passes large values by address or returns a large value through `gm_out`, so C code
/// and plain function pointers call a wrapper.
pub needs_wrapper :: fn(g: ^Gen, f: u32) -> bool needs Alloc {
    def := g.prog.func(f)
    if def.kind is .Foreign(_) or not g.is_plain(f) { return false }
    for p in def.params {
        if g.ty.by_ref(def.locals[usize(p)].ty) { return true }
    }
    return g.ty.by_ref(def.ret)
}

/// The C name of `f` where its address is taken: the C-ABI entry point of a plain
/// function (see `needs_wrapper`), else the name it is called by.
pub addr_name :: fn(g: ^Gen, f: u32) -> string needs Alloc {
    if g.needs_wrapper(f) { return str.format("gm_f{}_c", f)! }
    return g.callee_name(f)
}

/// Declares foreign function `f` under a private name bound to its symbol, so it cannot
/// clash with the declarations of the runtime's C headers.
pub foreign_decl :: fn(g: ^Gen, f: u32) -> Unsup!() needs Alloc {
    def := g.prog.func(f)
    .Foreign(lib, link_name, variadic) := def.kind else @unreachable()
    if lib not in ("c", "m") and lib not in g.libs.items { g.libs.push(lib)! }
    params := list(string)
    for p in def.params { params.push(try g.c_abi_type(def.locals[usize(p)].ty, def.span))! }
    if variadic { params.push("...")! }
    if params.items.len is 0 { params.push("void")! }
    ret: string = if g.ty.is_never(def.ret) {
        "__attribute__((noreturn)) void"
    } else if g.ty.is_unit(def.ret) {
        "void"
    } else {
        try g.c_abi_type(def.ret, def.span)
    }
    g.protos.write("extern {}{} gm_x{}({}) __asm__(GM_SYM({}));\n", conv_attr(def.win64), ret, f, str.join(params.items, ", ")!, c_string(link_name))!
}

/// The C type passed across the C ABI for `t`.
pub c_abi_type :: fn(g: ^Gen, t: Ty, span: source.Span) -> Unsup!string needs Alloc {
    match g.ty.repr(t) {
        .Bool => return "_Bool"
        .Int(_), .Float(_), .Ptr => return g.ty.cty(t)
        _ => {
            if m := g.ty.mirror(t) { return m }
            return !unsupported(span, str.format("passing `{}` by value to or from C", g.ty.show(t))!)
        }
    }
}

/// True if one of `params` is a second-class function (§11.6), through which a callee
/// that performs nothing itself may still leave by a non-local exit.
pub takes_fn :: fn(g: ^const Gen, params: []const Ty) -> bool {
    for t in params {
        if g.ty.kind(t) is .Fn(_) { return true }
    }
    return false
}

/// The C attribute (with a trailing space) selecting the calling convention; the
/// target's C ABI needs none.
pub conv_attr :: fn(win64: bool) -> string => if win64 { "__attribute__((ms_abi)) " } else { "" }
