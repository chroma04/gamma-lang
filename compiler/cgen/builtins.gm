// The builtins (`@name(…)`), system operations, atomics and conversions between scalar types.

/// Builtin `op`, of type `t`, of the values `vals` of types `tys`: the builtins whose
/// arguments are plain values.
builtin_values :: fn(fg: ^FnGen, span: source.Span, t: Ty, op: tir.Builtin, tys: []const Ty, vals: []const string) -> Unsup!string needs sema.Load {
    loc := fg.g.src_loc(span)
    v0 := vals[0]
    at := tys[0]
    match op {
        .Convert, .Trunc, .Round, .Floor, .Ceil, .Checked, .Sat => return try fg.convert(span, t, op, at, v0)
        .Bits => {
            a := fg.addr_of(at, v0)
            r := fg.tmp_uninit(t)
            sz := fg.g.ty.size(at)
            fg.linef("memset(&{}, 0, sizeof {}); memcpy(&{}, {}, sizeof {} < {} ? sizeof {} : {});", r, r, r, a, r, sz, r, sz)
            if ii := fg.int_info(t) {
                if not ii_exact(ii) {
                    nv := normalize(ii, r)
                    fg.linef("{} = {};", r, nv)
                }
            }
            return r
        }
        .Cast => {
            // A pointer to something at least as aligned is aligned already.
            al := arith_pointee_align(fg, t)
            if al > 1 and fg.g.opts.checks and arith_pointee_align(fg, at) < al {
                fg.linef("if ((uintptr_t){} % {} != 0) gm_trap_misaligned((uintptr_t){}, {}, {});", v0, al, v0, al, loc)
            }
            return fg.tmp(t, v0)
        }
        .Addr => return fg.tmp(t, str.format("(uintptr_t){}", v0)!)
        .ToPtr => return fg.tmp(t, str.format("GM_INT_TO_PTR({})", v0)!)
        .PtrAdd, .PtrSub, .PtrDiff => {
            .ManyPtr(_, elem) := fg.g.ty.kind(at) else @unreachable()
            stride := fg.g.ty.size(elem)
            p := v0
            x := vals[1]
            if op is .PtrDiff {
                if stride is 0 { return fg.tmp(t, "0") }
                return fg.tmp(t, str.format("(intptr_t)((uintptr_t){} - (uintptr_t){}) / (intptr_t){}", p, x, stride)!)
            }
            sign := if op is .PtrAdd { "" } else { "-" }
            return fg.tmp(t, str.format("GM_PTR_ADD({}, {}((uintptr_t){} * {}u))", p, sign, x, stride)!)
        }
        .Tag => {
            a := fg.addr_of(at, v0)
            return fg.load(t, a)
        }
        .FromTag => return fg.from_tag(span, t, at, v0)
        .Min, .Max => {
            gt := if op is .Min { "<" } else { ">" }
            if fg.g.ty.repr(at) is .Float(_) {
                f := if op is .Min { "gm_fmin" } else { "gm_fmax" }
                r := fg.float_from(t, str.format("{}((double){}, (double){})", f, v0, vals[1])!)
                return fg.tmp(t, r)
            }
            return fg.tmp(t, str.format("({} {} {} ? {} : {})", v0, gt, vals[1], v0, vals[1])!)
        }
        .Clamp => {
            x := v0
            lo := vals[1]
            hi := vals[2]
            if fg.g.ty.repr(at) is .Float(_) {
                r := fg.float_from(t, str.format("gm_fmin(gm_fmax((double){}, (double){}), (double){})", x, lo, hi)!)
                return fg.tmp(t, r)
            }
            return fg.tmp(t, str.format("({} < {} ? {} : ({} > {} ? {} : {}))", x, lo, lo, x, hi, hi, x)!)
        }
        .Abs => {
            if fg.g.ty.repr(at) is .Float(_) {
                return fg.tmp(t, str.format("({} < 0 || (({}) == 0 && __builtin_signbit({}))) ? -{} : {}", v0, v0, v0, v0, v0)!)
            }
            ii := fg.int_info(at)?
            if ii.signed and fg.g.opts.checks {
                min := fg.int_lit(at, ii_min(ii))
                fg.linef("if ({} == {}) gm_trap(\"integer overflow in `abs`\", {});", v0, min, loc)
            }
            return fg.tmp(t, str.format("({} < 0 ? -{} : {})", v0, v0, v0)!)
        }
        .AbsDiff => {
            ii := fg.int_info(at)?
            u := ii_ucty(ii)
            a := v0
            b := vals[1]
            return fg.tmp(t, str.format("({} > {} ? ({}){} - ({}){} : ({}){} - ({}){})", a, b, u, a, u, b, u, b, u, a)!)
        }
        .IsNan => return fg.tmp(t, str.format("(uint8_t)__builtin_isnan({})", v0)!)
        .IsInf => return fg.tmp(t, str.format("(uint8_t)__builtin_isinf({})", v0)!)
        .IsFinite => return fg.tmp(t, str.format("(uint8_t)__builtin_isfinite({})", v0)!)
        .SignBit => return fg.tmp(t, str.format("(uint8_t)(__builtin_signbit({}) != 0)", v0)!)
        .Sqrt => {
            f := if fg.g.ty.kind(at) is .Float(32) { "__builtin_sqrtf" } else { "__builtin_sqrt" }
            r := fg.float_from(t, str.format("{}({})", f, v0)!)
            return fg.tmp(t, r)
        }
        .Fma => {
            f := if fg.g.ty.kind(at) is .Float(32) { "__builtin_fmaf" } else { "__builtin_fma" }
            r := fg.float_from(t, str.format("{}({}, {}, {})", f, v0, vals[1], vals[2])!)
            return fg.tmp(t, r)
        }
        .AtomicLoad, .AtomicStore, .AtomicSwap, .AtomicCas, .AtomicRmw(_), .VolatileLoad, .VolatileStore => return try fg.atomic(span, t, op, tys, vals)
        .Rotl, .Rotr => return fg.rotate(t, op, at, vals)
        .Clz, .Ctz, .Popcount, .Bswap, .Bitreverse => return fg.bit_count(span, t, op, at, v0)
        .Pow(fl) => return fg.pow(span, t, fl, at, vals)
        .CstrLen => return fg.tmp(t, str.format("(uintptr_t)strlen((const char *){})", v0)!)
        .Fence => {
            a := fg.addr_of(at, v0)
            fg.linef("__atomic_thread_fence(gm_ord[GM_LD(uint8_t, {})]);", a)
            return fg.unit()
        }
        .BlackBox => return fg.black_box(t, v0)
        .Hash => {
            f := fg.g.helpers.hash_fn(&fg.g.ty, at)
            a := fg.addr_of(at, v0)
            return fg.tmp(t, str.format("{}({}, 0xcbf29ce484222325ULL ^ (uint64_t){})", f, a, vals[1])!)
        }
        _ => return !unsupported(span, "this builtin")
    }
}

/// System operation `sop` of type `t` on the values `vals` of types `tys`.
sys_values :: fn(fg: ^FnGen, t: Ty, sop: tir.SysOp, tys: []const Ty, vals: []const string) -> string needs sema.Load {
    // The arguments and variables come from the runtime as slices and strings.
    if sop is .EnvArgs {
        k := fg.fresh()
        fg.linef("size_t argn{}; const void *argp{} = gm_args(&argn{});", k, k, k)
        return fg.make_slice(t, str.format("argp{}", k)!, str.format("argn{}", k)!)
    }
    if sop is .EnvVar {
        k := fg.fresh()
        addr := fg.addr_of(tys[0], vals[0])
        fg.linef("const uint8_t *ev{}; size_t evn{};", k, k)
        fg.linef("bool evok{} = gm_env_var((const uint8_t *){}, {}, &ev{}, &evn{});", k, slice_ptr(addr), fg.slice_len(addr), k, k)
        s := fg.make_slice(fg.g.ty.string_ty(), str.format("ev{}", k)!, str.format("evn{}", k)!)
        some := fg.make_some(t, s)
        none := fg.make_none(t)
        return fg.tmp(t, str.format("evok{} ? {} : {}", k, some, none)!)
    }
    cargs := list(string)
    for i in 0..vals.len {
        v := vals[i]
        if fg.g.ty.kind(tys[i]) is .Slice(_, _) {
            addr := fg.addr_of(tys[i], v)
            cargs.push(str.format("(void *){}, {}", slice_ptr(addr), fg.slice_len(addr))!)!
        } else {
            cargs.push(v)!
        }
    }
    call := str.format("gm_{}({})", tir.sys_name(sop), str.join(cargs.items, ", ")!)!
    if fg.g.ty.is_unit(t) {
        fg.linef("{};", call)
        return fg.unit()
    }
    return fg.tmp(t, call)
}

/// `@alloc_tag` or `@alloc_check` (Debug builds) on the values `vals` of types `tys`.
alloc_tag_values :: fn(fg: ^FnGen, span: source.Span, op: tir.Builtin, tys: []const Ty, vals: []const string) -> string needs sema.Load {
    loc := fg.g.src_loc(span)
    if not fg.g.opts.debug { return fg.unit() }
    v := vals
    fa := fg.addr_of(tys[3], vals[3])
    fp := slice_ptr(fa)
    fl := fg.slice_len(fa)
    line := vals[4]
    col := vals[5]
    if op is .AllocTag {
        fg.linef("gm_alloc_tag({}, {}, {}, {}, {}, {}, {});", v[0], v[1], v[2], fp, fl, line, col)
    } else {
        // The check traps at its own location, like the interpreter.
        fg.linef("gm_alloc_check({}, {}, {}, {}, {}, {}, {}, {});", v[0], v[1], v[2], fp, fl, line, col, loc)
    }
    return fg.unit()
}

/// The unit variant of a union with tag `v0`, or null.
from_tag :: fn(fg: ^FnGen, span: source.Span, t: Ty, at: Ty, v0: string) -> Unsup!string needs sema.Load {
    .Optional(u) := fg.g.ty.kind(t) else return !unsupported(span, "from_tag")
    .Union(_, variants) := fg.g.ty.adt_of(u).kind else return !unsupported(span, "from_tag")
    res0 := fg.make_none(t)
    res := fg.tmp(t, res0)
    for i in 0..variants.len {
        vd := variants[i]
        if vd.payload is not null { continue }
        lit := fg.int_lit(at, vd.tag)
        fg.linef("if ({} == {}) {{", v0, lit)
        x := fg.make_variant(u, i, null)
        s := fg.make_some(t, x)
        fg.linef("    {} = {};", res, s)
        fg.line("}")
    }
    return res
}

/// A bit rotation.
rotate :: fn(fg: ^FnGen, t: Ty, op: tir.Builtin, at: Ty, vals: []const string) -> Unsup!string needs sema.Load {
    v0 := vals[0]
    ii := fg.int_info(at)?
    x := str.format("(unsigned __int128)({})({})", ii_ucty(ii), v0)!
    k0 := str.format("(uint64_t){}", vals[1])!
    // A right rotation by k is a left rotation by bits - k mod bits.
    k: string = if op is .Rotl { k0 } else { str.format("({} - {} % {})", ii.bits, k0, ii.bits)! }
    c := fg.g.ty.cty(t)
    r := fg.tmp(t, str.format("({})gm_rotl({}, {}, {})", c, x, k, ii.bits)!)
    n := normalize(ii, r)
    return fg.tmp(t, n)
}

/// A count, reversal or swap of the bits of an integer.
bit_count :: fn(fg: ^FnGen, span: source.Span, t: Ty, op: tir.Builtin, at: Ty, v0: string) -> Unsup!string needs sema.Load {
    ii := fg.int_info(at)?
    x0 := str.format("(unsigned __int128)({})({})", ii_ucty(ii), v0)!
    // Keep the low bits only (a shift by 128 would be undefined in C).
    x: string = if ii.bits >= 128 { x0 } else { str.format("({} & (((unsigned __int128)1 << {}) - 1))", x0, ii.bits)! }
    c := fg.g.ty.cty(t)
    call: string = match op {
        .Clz => str.format("gm_clz({}, {})", x, ii.bits)!
        .Ctz => str.format("gm_ctz({}, {})", x, ii.bits)!
        .Popcount => str.format("gm_popcount({})", x)!
        .Bswap => {
            if ii.bits % 8 is not 0 { return !unsupported(span, "bswap of a partial byte") }
            str.format("gm_bswap({}, {})", x, ii.bits)!
        }
        _ => str.format("gm_bitreverse({}, {})", x, ii.bits)!
    }
    r := fg.tmp(t, str.format("({}){}", c, call)!)
    if op in (.Bswap, .Bitreverse) {
        if ri := fg.int_info(t) {
            n := normalize(ri, r)
            return fg.tmp(t, n)
        }
    }
    return r
}

/// An integer power.
pow :: fn(fg: ^FnGen, span: source.Span, t: Ty, fl: ast.Flavor, at: Ty, vals: []const string) -> Unsup!string needs sema.Load {
    v0 := vals[0]
    loc := fg.g.src_loc(span)
    ii := fg.int_info(at) else return !unsupported(span, "float pow")
    c := ii_cty(ii)
    r := str.format("r{}", fg.fresh())!
    o := str.format("o{}", fg.fresh())!
    f := str.format("gm_pow_{}{}", if ii.signed { "i" } else { "u" }, ii.storage * 8)!
    fg.linef("bool {} = false; {} {} = {}({}, (uint64_t){}, &{});", o, c, r, f, v0, vals[1], o)
    if not ii_exact(ii) {
        min := fg.int_lit(at, ii_min(ii))
        max := fg.int_lit(at, ii_max(ii))
        fg.linef("{} = {} || {} < {} || {} > {};", o, o, r, min, r, max)
    }
    if fl is .Checked and fg.g.opts.checks {
        // The message names the operands, as the interpreter's does.
        b := fg.tmp(at, v0)
        fg.linef("if ({}) gm_trap_pow((const uint8_t *)&{}, {}, {}, (uint32_t){}, {});", o, b, ii.bits, ii.signed, vals[1], loc)
    }
    sat := str.format("({} > 0 || ({} & 1) == 0)", v0, vals[1])!
    return try fg.finish_int(fl, ii, at, t, r, o, sat, loc, "pow")
}

/// An atomic or volatile access.
atomic :: fn(fg: ^FnGen, span: source.Span, t: Ty, op: tir.Builtin, tys: []const Ty, vals: []const string) -> Unsup!string needs sema.Load {
    v0 := vals[0]
    at := tys[0]
    .Ptr(_, elem) := fg.g.ty.kind(at) else return !unsupported(span, "this atomic")
    c := fg.g.ty.cty(elem)
    p := str.format("(({} *){})", c, v0)!
    ords := list(string)
    for i in 1..tys.len {
        if fg.g.ty.kind(tys[i]) is not .Adt(_, _) { continue }
        a := fg.addr_of(tys[i], vals[i])
        ords.push(str.format("gm_ord[GM_LD(uint8_t, {})]", a)!)!
    }
    match op {
        .VolatileLoad => return fg.tmp(t, str.format("*(volatile {} *){}", c, v0)!)
        .VolatileStore => {
            fg.linef("*(volatile {} *){} = {};", c, v0, vals[1])
            return fg.unit()
        }
        .AtomicLoad => return fg.tmp(t, str.format("__atomic_load_n({}, {})", p, ords.items[0])!)
        .AtomicStore => {
            fg.linef("__atomic_store_n({}, {}, {});", p, vals[1], ords.items[0])
            return fg.unit()
        }
        .AtomicSwap => return fg.tmp(t, str.format("__atomic_exchange_n({}, {}, {})", p, vals[1], ords.items[0])!)
        .AtomicCas => {
            exp := fg.tmp(elem, vals[1])
            ok := fg.tmp(fg.g.ty.bool_ty(), str.format("__atomic_compare_exchange_n({}, &{}, {}, 0, {}, {})", p, exp, vals[2], ords.items[0], ords.items[1])!)
            res := fg.tmp_uninit(t)
            none := fg.make_none(t)
            some := fg.make_some(t, exp)
            fg.linef("{} = {} ? {} : {};", res, ok, none, some)
            return res
        }
        .AtomicRmw(rmw) => {
            f: ?string = match rmw {
                .Add => "__atomic_fetch_add"
                .Sub => "__atomic_fetch_sub"
                .And => "__atomic_fetch_and"
                .Or => "__atomic_fetch_or"
                .Xor => "__atomic_fetch_xor"
                .Max, .Min => null
            }
            if fname := f {
                return fg.tmp(t, str.format("{}({}, {}, {})", fname, p, vals[1], ords.items[0])!)
            }
            cmp := if rmw is .Max { ">" } else { "<" }
            old := fg.tmp(elem, str.format("__atomic_load_n({}, __ATOMIC_RELAXED)", p)!)
            v := vals[1]
            fg.linef("while (!__atomic_compare_exchange_n({}, &{}, {} {} {} ? {} : {}, 1, {}, __ATOMIC_RELAXED)) {{}}", p, old, v, cmp, old, v, old, ords.items[0])
            return old
        }
        _ => @unreachable()
    }
}

/// `@black_box(v)`, a value the C compiler must assume nothing about.
black_box :: fn(fg: ^FnGen, t: Ty, v0: string) -> Unsup!string needs sema.Load {
    if fg.g.ty.is_unit(t) { return v0 }
    // The compiler must assume nothing about the value. An integer or a boolean
    // goes through an empty `asm` that may change it, which needs no stack slot (a
    // program with thousands of sites would give the C compiler thousands of slots
    // to lay out); any other value goes through memory behind a volatile pointer.
    c := fg.g.ty.cty(t)
    in_register: bool = not fg.g.ty.lay.target.filc and match fg.g.ty.repr(t) {
        .Int(_, _, storage) => storage <= 8
        .Bool => true
        _ => false
    }
    if in_register {
        v := fg.tmp(t, v0)
        fg.linef("__asm__ volatile (\"\" : \"+r\"({}));", v)
        return v
    }
    slot := fg.tmp(t, v0)
    p := fg.fresh_tmp()
    fg.linef("{} *volatile {} = &{};", c, p, slot)
    return fg.tmp(t, str.format("*{}", p)!)
}

/// The numeric conversions `T(x)`, `.trunc`, `.round`, `.floor`, `.ceil`, `.checked`, `.sat`.
convert :: fn(fg: ^FnGen, span: source.Span, t: Ty, op: tir.Builtin, src: Ty, v: string) -> Unsup!string needs sema.Load {
    target := t
    if op is .Checked {
        if .Optional(x) := fg.g.ty.kind(t) { target = x }
    }
    loc := fg.g.src_loc(span)
    // The source as a number: integers (and bools, enum tags) or a float.
    src_int := false
    src_val := ""
    match fg.g.ty.repr(src) {
        .Int(_, _, _) => {
            src_int = true
            src_val = v
        }
        .Bool => {
            src_int = true
            src_val = str.format("(int64_t){}", v)!
        }
        .Float(_) => { src_val = str.format("(double){}", v)! }
        .Blob if fg.g.ty.kind(src) is .Adt(_, _) => match fg.g.ty.adt_of(src).kind {
            .Union(tag, _) => {
                a := fg.addr_of(src, v)
                src_int = true
                src_val = fg.load(tag, a)
            }
            .Struct(sd) => {
                u := sd.bits else return !unsupported(span, str.format("converting from `{}`", fg.g.ty.show(src))!)
                a := fg.addr_of(src, v)
                src_int = true
                src_val = fg.load(u, a)
            }
            _ => return !unsupported(span, str.format("converting from `{}`", fg.g.ty.show(src))!)
        }
        _ => return !unsupported(span, str.format("converting from `{}`", fg.g.ty.show(src))!)
    }
    match fg.g.ty.repr(target) {
        .Int(_, _, _) => {
            ii := fg.int_info(target)?
            c := ii_cty(ii)
            if src_int {
                si: bool = match fg.g.ty.repr(src) {
                    .Int(signed, _, _) => signed
                    _ => true
                }
                fits := arith_fits(ii, src_val, si)
                wrapped := normalize(ii, str.format("({}){}", c, src_val)!)
                match op {
                    .Checked => {
                        res := fg.tmp_uninit(t)
                        w := fg.tmp(target, wrapped)
                        some := fg.make_some(t, w)
                        none := fg.make_none(t)
                        fg.linef("{} = {} ? {} : {};", res, fits, some, none)
                        return res
                    }
                    .Sat => {
                        min := fg.int_lit(target, ii_min(ii))
                        max := fg.int_lit(target, ii_max(ii))
                        neg: string = if si { str.format("({} < 0)", src_val)! } else { "0" }
                        return fg.tmp(t, str.format("{} ? {} : ({} ? {} : {})", fits, wrapped, neg, min, max)!)
                    }
                    _ => return fg.tmp(t, wrapped)
                }
            }
            tys := &fg.g.ty.s.tys
            f64_ty := tys.intern(.Float(64))
            x := fg.tmp(f64_ty, src_val)
            rounded: string = match op {
                .Round => str.format("GM_ROUNDEVEN({})", x)!
                .Floor => str.format("__builtin_floor({})", x)!
                .Ceil => str.format("__builtin_ceil({})", x)!
                _ => str.format("__builtin_trunc({})", x)!
            }
            r := fg.tmp(f64_ty, rounded)
            lo := str.format("{:e}", arith_int_to_f64(ii_min(ii)))!
            hi := str.format("{:e}", arith_int_to_f64(bigint.add(ii_max(ii), bigint.one())))!
            in_range := str.format("(__builtin_isfinite({}) && {} >= {} && {} < {})", r, r, lo, r, hi)!
            match op {
                .Checked => {
                    res := fg.tmp_uninit(t)
                    fg.linef("if ({} && {} == {}) {{", in_range, x, r)
                    w := fg.tmp(target, str.format("({}){}", c, r)!)
                    some := fg.make_some(t, w)
                    fg.linef("    {} = {};", res, some)
                    fg.line("} else {")
                    none := fg.make_none(t)
                    fg.linef("    {} = {};", res, none)
                    fg.line("}")
                    return res
                }
                .Sat => {
                    min := fg.int_lit(target, ii_min(ii))
                    max := fg.int_lit(target, ii_max(ii))
                    return fg.tmp(t, str.format("__builtin_isnan({}) ? ({})0 : ({} < {} ? {} : ({} >= {} ? {} : ({}){}))", x, c, r, lo, min, r, hi, max, c, r)!)
                }
                _ => {
                    if fg.g.opts.checks {
                        fg.linef("if (!{}) gm_trap(\"float to integer conversion out of range\", {});", in_range, loc)
                    }
                    return fg.tmp(t, str.format("({}){}", c, r)!)
                }
            }
        }
        .Float(_) => {
            r := fg.float_from(target, src_val)
            return fg.tmp(t, r)
        }
        _ => {}
    }
    // An integer to a `#bits` struct: its bits, wrapped to the underlying type.
    if src_int {
        if bl := fg.g.ty.bits_layout(target) {
            ui := fg.int_info(bl.int_ty)?
            w := normalize(ui, str.format("({}){}", ii_cty(ui), src_val)!)
            b := fg.tmp_uninit(target)
            fg.linef("GM_ST({}, (uint8_t *)&{}, {});", ii_cty(ui), b, w)
            return b
        }
    }
    return !unsupported(span, str.format("converting to `{}`", fg.g.ty.show(target))!)
}
