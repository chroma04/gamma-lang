// Functions: frames, blocks, statements, scopes, and the cleanup code that runs on
// non-local exits.
//
// Every Gamma function becomes `static RET gm_f_<name>_<hash>(void *env, gm_node *cx, gm_node *inst,
// params…)`. The locals that function literals and handler clauses reach through `env`
// live in a frame struct `F`; the others are plain C locals `gm_lN`, which the C
// compiler can keep in registers even when the frame's address escapes (see
// `frame_locals`).
//
// `break`, `continue`, `return`, `try` and `Env.exit` set `gm_unw` and run the *ladder*
// for the current position: the pending `defer`s from the innermost scope outwards, with
// a test at each loop or `with` boundary for whether it is the exit's target. The same
// ladder runs after any call that may exit non-locally, when `gm_unw.kind` is set on
// return.
//
// The ladder is emitted once, not at every exit: each scope ends with its rung (a
// *segment*), reached only by `goto`, that runs its part and jumps to the rung of the
// enclosing scope. A block's segment has one entry per `defer`, so an exit runs only the
// ones registered before it; the outermost rung (`gm_lad`) returns or propagates. An exit
// is then a single `goto`, which keeps the C functions of code with many calls and
// `defer`s small.

/// The number of temporaries and labels (see `fresh`) above which a function is marked
/// `GM_HUGE_FN`.
HUGE_FN_NAMES: u32 : 20000

/// The number of temporaries and labels above which a function is marked `GM_LONG_FN`,
/// which recent versions of Clang compile without optimization (see `runtime/gm_rt.h`).
LONG_FN_NAMES: u32 : 2000

/// The number of temporaries and labels up to which an optimized build declares a
/// function without an `#inline` hint `inline`.
SMALL_FN_NAMES: u32 : 64

/// The largest local, in bytes, that may be a C local of its own (`frame_locals`).
MAX_C_LOCAL: u64 : 32

/// The label and type of a `with` of the function: its result has a slot `wN` in the frame.
WithSlot :: struct {
    label: u32
    ty: Ty
}

/// `text` with the first occurrence of `from` replaced by `to`.
replacen1 :: fn(text: string, from: string, to: string) -> string needs Alloc {
    i := str.find(text, from) else return text
    return str.format("{}{}{}", text[0..i], to, text[i + from.len..])!
}

/// Generates function `f` into `g`, or its clone specialized by `spec`.
gen_fn :: fn(g: ^Gen, f: u32, spec: ?u32) -> Unsup!() needs sema.Load {
    def := g.prog.func(f)
    if def.kind is .Foreign(_) { return g.foreign_decl(f) }
    body := def.body else return !unsupported(def.span, str.format("the function `{}` has no body", def.name)!)
    if g.frame_done(f) { return gen_body(g, f, def, body, spec) }
    in_frame := g.frame_locals(f)
    // The frame struct, shared by the function and its clones.
    frame := list(u8)
    frame.write("struct {} {{\n    gm_frame h;\n", g.frame_name(f))!
    // With `-g`, a field also has its local's name, with the type's debugger view.
    names: []const ?string = empty_slice(?string)
    if g.opts.debug_info {
        local_names := list(string)
        for l in def.locals { local_names.push(l.name)! }
        taken := hash_map.hash_map(string, bool)
        names = unique_members(local_names.items, &taken)
    }
    for i, l in enumerate(def.locals) {
        if not in_frame[i] { continue }
        c := g.ty.cty(l.ty)
        if i < names.len and names[i] is not null {
            n := names[i]?
            alias := c
            dims := ""
            if view := g.ty.debug_view(l.ty) {
                alias = view.cty
                dims = view.dims
            }
            g.ty.add_member_name(n)
            frame.write("    union {{ {} l{}; {} {}{}; }};\n", c, i, alias, n, dims)!
        } else {
            frame.write("    {} l{}; /* {} */\n", c, i, l.name)!
        }
    }
    // The body of a `with … on` from LIR is a C function of its own, which reaches the
    // locals lowering adds through the frame too.
    if lir_framed(g, f, body) {
        lf := g.lir_of(f)
        for i in def.locals.len..lf.locals.len { frame.write("    {} l{};\n", g.ty.cty(lf.locals[i].ty), i)! }
    }
    frame.write("    {} ret;\n", g.ty.cty(def.ret))!
    withs := list(WithSlot)
    collect_withs(body, &withs)
    for w in withs.items {
        frame.write("    {} w{};\n", g.ty.cty(w.ty), w.label)!
    }
    frame.extend("};\n")!
    g.frames.extend(frame.items)!
    return gen_body(g, f, def, body, spec)
}

gen_body :: fn(g: ^Gen, f: u32, def: ^const Func, body: ^Expr, spec: ?u32) -> Unsup!() needs sema.Load {
    // The signature: plain functions have the C calling convention (decisions in
    // docs/architecture.md); the others take the hidden env, cx and inst first.
    plain := g.is_plain(f)
    // Large values cross by address (`CTypes.by_ref`): a large result is written to
    // `gm_out`, and a plain function's C-ABI entry point is then a wrapper
    // (`needs_wrapper`).
    out_ret := g.ty.by_ref(def.ret)
    void_ret := (plain and g.ty.is_unit(def.ret)) or out_ret
    blob_ret := not plain
    ret := ""
    if void_ret {
        ret = "void"
    } else if blob_ret {
        ret = g.ty.cty(def.ret)
    } else {
        ret = g.ty.plain_cty(def.ret)
    }
    params := list(string)
    if out_ret { params.push("void *gm_out")! }
    if not plain {
        params.push("void *env")!
        params.push("gm_node *cx")!
        params.push("gm_node *inst")!
    }
    for i, p in enumerate(def.params) {
        t := def.locals[usize(p)].ty
        c := ""
        if plain and not g.ty.by_ref(t) { c = g.ty.plain_cty(t) } else { c = g.ty.param_cty(t) }
        params.push(str.format("{} a{}", c, i)!)!
    }
    if params.items.len is 0 { params.push("void")! }
    if spec is null and g.needs_wrapper(f) { c_abi_wrapper(g, f, def) }
    borrowed := g.borrowed_params(f)
    in_frame := g.frame_locals(f)
    split_runs := not g.opts.debug_info and long_body(g, f)
    // The body, from its LIR (`lirc.gm`).
    lf := g.lir_of(f)
    try g.lir_check(def, &lf)
    // The locals lowering adds are C locals, or frame fields where the frame holds them all.
    all := list(bool)
    all.extend(in_frame)!
    framed := lir_framed(g, f, body)
    while all.items.len < lf.locals.len { all.push(framed)! }
    in_frame = all.items
    cname := ""
    if sp := spec { cname = g.spec_name(f, sp) } else { cname = g.fn_name(f) }
    sig := str.format("static __attribute__((aligned(4))) {}{}{} {}({})", hint_attrs(def.hints), conv_attr(def.win64), ret, cname, str.join(params.items, ", ")!)!
    g.protos.write("{};\n", sig)!
    // A frame that no stack can hold makes every call a stack overflow: the body is only
    // the trap, which names the function and its frame as the interpreter's does.
    cost := g.prog.s.frame_cost(def.locals, def.body)
    if cost > sema.MAX_FRAME {
        name := c_string(def.name)
        g.bodies.write("{} {{\n    gm_frame_overflow({}, {}ull);\n}}\n", sig, name, cost)!
        return ()
    }
    tag := g.fn_tag(f, spec)
    fg := FnGen(
        g: g,
        fid: f,
        tag: tag,
        spec: spec,
        def: def,
        out: list(u8),
        scopes: list(Scope),
        borrowed: borrowed,
        in_frame: in_frame,
        split_runs: split_runs,
        runs: list(Run),
    )
    fg.out.write("{} {{\n", sig)!
    fg.src_line(def.span)
    if def.hints.fast_math { fg.line("GM_FAST_MATH_BODY") }
    if plain { fg.line("void *env = NULL; gm_node *cx = NULL; gm_node *inst = NULL;") }
    fg.linef("struct {} F;", g.frame_name(f))
    for i, l in enumerate(def.locals) {
        if not fg.in_frame[i] {
            fg.temp_bytes += fg.g.ty.size(l.ty)
            c := fg.g.ty.cty(l.ty)
            fg.linef("{} gm_l{}; /* {} */", c, i, l.name)
        }
    }
    // Running out of stack is checked (§14.1, §18): the thread's or the fiber's.
    if fg.g.opts.checks and not probe_free(fg.g, def) {
        if call_depth(fg.g, f) <= SHALLOW_DEPTH {
            fg.line("GM_STACK_CHECK_SHALLOW(&F, GM_TEMP_BYTES);")
        } else {
            fg.line("GM_STACK_CHECK(&F, GM_TEMP_BYTES);")
        }
        fg.probe_at = fg.out.items.len - "GM_TEMP_BYTES);\n".len
    }
    // Debug builds keep a backtrace chain (see gm_bt in the runtime).
    pop := ""
    if fg.g.opts.debug {
        name := "NULL"
        if n := fg.g.prog.backtrace_name(f) { name = c_string(n) }
        fg.linef("gm_bt B = {{ gm_bt_top, {}, NULL, 0, 0 }}; gm_bt_top = &B;", name)
        pop = "gm_bt_top = B.prev; "
    }
    fg.line("F.h.up = (gm_frame *)env;")
    clause_lit := if def.kind is .Clause { 1 } else { 0 }
    fg.linef("F.h.clause_lit = {} && env != NULL;", clause_lit)
    fg.line("(void)inst;")
    for i, p in enumerate(def.params) {
        t := def.locals[usize(p)].ty
        if fg.borrowed[i] { continue }
        if fg.g.ty.by_ref(t) {
            lv := fg.local_lv(p)
            fg.linef("memcpy(&{}, a{}, sizeof {});", lv, i, lv)
            continue
        }
        an := str.format("a{}", i)!
        a: string = an
        if plain { a = fg.gamma_value(t, an) }
        lv := fg.local_lv(p)
        fg.linef("{} = {};", lv, a)
    }
    try fg.lir_body(&lf)
    if fg.lad_used {
        fg.line("goto gm_fret;")
        fg.label("gm_lad")
        fg.line("if (gm_unw.kind == GM_RETURN && gm_unw.frame == &F.h) { gm_unw.kind = GM_NONE; goto gm_fret; }")
        fg.line("goto gm_fprop;")
    }
    // Debug builds fill a dead frame with 0xDD (§18.3).
    kill := ""
    if fg.g.opts.debug { kill = str.format("{}gm_poison(&F, 0xDD, sizeof F); ", pop)! }
    if out_ret {
        // `gm_fdone`: a `return` that wrote its value to `gm_out` itself.
        fg.out.write("gm_fret:\n    memcpy(gm_out, &F.ret, sizeof F.ret);\ngm_fdone:\n    {}return;\ngm_fprop:\n    {}return;\n}}\n", kill, kill)!
    } else if void_ret {
        fg.out.write("gm_fret:\n    {}return;\ngm_fprop:\n    {}return;\n}}\n", kill, kill)!
    } else if kill.len is 0 {
        r := "F.ret"
        if not blob_ret { r = fg.plain_value(def.ret, "F.ret") }
        fg.out.write("gm_fret:\n    return {};\ngm_fprop:\n    return {};\n}}\n", r, r)!
    } else {
        r := "gm_r"
        if not blob_ret { r = fg.plain_value(def.ret, "gm_r") }
        ct := fg.g.ty.cty(def.ret)
        tail := str.format("{{ {} gm_r = F.ret; {}return {}; }}", ct, kill, r)!
        fg.out.write("gm_fret:\n    {}\ngm_fprop:\n    {}\n}}\n", tail, tail)!
    }
    // The epilogue copies the result (and a plain function converts it).
    if not out_ret { fg.temp_bytes += 2 * fg.g.ty.size(def.ret) }
    fg.end_lines()
    // The text goes to `g.bodies` in pieces: the header line with its attributes, and the
    // body with the size of the temporaries in the stack check.
    text := fg.out.items
    nl := str.find(text, "\n") else text.len
    header: string = text[0..nl]
    if not fg.g.opts.debug and fg.counter <= SMALL_FN_NAMES and def.hints.inline is null {
        header = replacen1(header, "static __attribute__", "static inline __attribute__")
    }
    if fg.names > HUGE_FN_NAMES {
        header = replacen1(header, "static __attribute__", "static GM_HUGE_FN __attribute__")
    }
    // `optnone` conflicts with `always_inline` (an `#inline` hint, which such a function
    // will hardly carry).
    if fg.names > LONG_FN_NAMES and header.starts_with("static ") and not str.contains(header, "always_inline") {
        header = replacen1(header, "static ", "static GM_LONG_FN ")
    }
    g.bodies.extend(header)!
    if at := fg.probe_at {
        g.bodies.extend(text[nl..at])!
        g.bodies.write("{}u", fg.temp_bytes)!
        g.bodies.extend(text[at + "GM_TEMP_BYTES".len..])!
    } else {
        g.bodies.extend(text[nl..])!
    }
}

/// Whether `def` needs no stack probe of its own: an `#inline` function of an optimized
/// build, which becomes part of its callers, that calls nothing but functions that
/// probe. Every chain of calls then still reaches a probe after at most one such
/// function, and a caller's probe is not repeated for each helper inlined into it.
probe_free :: fn(g: ^Gen, def: ^const Func) -> bool needs Alloc {
    if g.opts.debug { return false }
    if x := def.hints.inline and x {
        b := def.body else return false
        return calls_probe(g, b)
    }
    return false
}

/// The deepest nesting of calls (`call_depth`) of a function that needs no stack probe if
/// its frame is small (`GM_STACK_CHECK_SHALLOW` in the runtime's header): such a function
/// and what it calls put at most four small frames below the frame of the function that
/// probed last, which the space kept below the stack's limit has room for. The accessors
/// and predicates that are called everywhere, and inlined into their callers with their
/// probes, are of this kind.
SHALLOW_DEPTH: u32 : 3

/// The mark in `Gen.depth_memo` of a function whose calls have no known depth.
DEPTH_UNKNOWN: u8 : 255

/// How deep the calls of function `f` nest: 0 if it calls no function, one more than the
/// deepest of the functions it calls if all its calls are direct calls of functions of a
/// known depth, and a number above `SHALLOW_DEPTH` otherwise (a recursive function, a
/// foreign one, one that performs an operation, calls a function value, writes to a sink
/// or enters a `with`: what runs then is not known here).
call_depth :: fn(g: ^Gen, f: u32) -> u32 needs Alloc {
    i := usize(f)
    while g.depth_memo.items.len <= i { g.depth_memo.push(0)! }
    known := g.depth_memo.items[i]
    // A function that is being computed calls itself.
    if known is 1 { return u32(DEPTH_UNKNOWN) }
    if known > 1 { return u32(known) - 2 }
    g.depth_memo.items[i] = 1
    depth := u32(DEPTH_UNKNOWN)
    def := g.prog.func(f)
    if b := def.body and def.kind is not .Foreign(_) { depth = expr_call_depth(g, b) }
    g.depth_memo.items[i] = if depth > SHALLOW_DEPTH { DEPTH_UNKNOWN } else { depth.trunc(u8) + 2 }
    return depth
}

/// The depth of the calls in `e` (see `call_depth`).
expr_call_depth :: fn(g: ^Gen, e: ^Expr) -> u32 needs Alloc {
    depth: u32 = 0
    match e.kind {
        .Call(callee, _) => match callee {
            .Fn(c) => { depth = call_depth(g, c) +| 1 }
            _ => return u32(DEPTH_UNKNOWN)
        }
        .Write(_), .WriteDeferred(_), .SoaDeferred(_), .Resume(_), .Cancel(_), .With(_) => return u32(DEPTH_UNKNOWN)
        .Builtin(op, _) => if op in (.Fiber, .Asm(_), .Sys(_)) { return u32(DEPTH_UNKNOWN) }
        _ => {}
    }
    tir.for_each_child(e, fn(x: ^Expr) {
        if depth <= SHALLOW_DEPTH { depth = depth.max(expr_call_depth(g, x)) }
    })
    return depth
}

/// Whether every call in `e` is a direct call of a function that is not `#inline`.
calls_probe :: fn(g: ^Gen, e: ^Expr) -> bool needs Alloc {
    match e.kind {
        .Call(callee, _) => match callee {
            .Fn(f) => {
                if x := g.prog.func(f).hints.inline and x { return false }
            }
            _ => return false
        }
        .Write(_), .Resume(_), .With(_) => return false
        _ => {}
    }
    ok := true
    tir.for_each_child(e, fn(x: ^Expr) {
        if not calls_probe(g, x) { ok = false }
    })
    return ok
}

/// The attributes (each with a trailing space) for a C function with `names` temporaries
/// and labels: `GM_HUGE_FN` and `GM_LONG_FN` for the very long ones.
size_attrs :: fn(names: u32) -> string {
    if names > HUGE_FN_NAMES { return "GM_HUGE_FN GM_LONG_FN " }
    if names > LONG_FN_NAMES { return "GM_LONG_FN " }
    return ""
}

/// Emits `gm_fN_c`, the C-ABI entry point of plain function `f` (see `needs_wrapper`): it
/// takes and returns values as C does and calls `gm_fN`.
c_abi_wrapper :: fn(g: ^Gen, f: u32, def: ^const Func) needs Alloc {
    params := list(string)
    args := list(string)
    for i, p in enumerate(def.params) {
        t := def.locals[usize(p)].ty
        params.push(str.format("{} a{}", g.ty.plain_cty(t), i)!)!
        if g.ty.by_ref(t) { args.push(str.format("&a{}", i)!)! } else { args.push(str.format("a{}", i)!)! }
    }
    if params.items.len is 0 { params.push("void")! }
    call := str.format("{}({})", g.fn_name(f), str.join(args.items, ", ")!)!
    ret := ""
    body := ""
    if g.ty.is_unit(def.ret) {
        ret = "void"
        body = str.format("{};", call)!
    } else if g.ty.by_ref(def.ret) {
        ret = g.ty.plain_cty(def.ret)
        c := g.ty.cty(def.ret)
        with_out := list(string)
        with_out.push("&gm_r")!
        with_out.extend(args.items)!
        out_call := str.format("{}({})", g.fn_name(f), str.join(with_out.items, ", ")!)!
        v := "gm_r"
        if m := g.ty.mirror(def.ret) { v = str.format("GM_CONV({}, gm_r)", m)! }
        body = str.format("{} gm_r; {}; return {};", c, out_call, v)!
    } else {
        ret = g.ty.plain_cty(def.ret)
        v := call
        if m := g.ty.mirror(def.ret) {
            if g.ty.by_ref(def.ret) { v = str.format("GM_CONV({}, {})", m, call)! }
        }
        body = str.format("return {};", v)!
    }
    sig := str.format("static __attribute__((aligned(4))) {}{} {}_c({})", conv_attr(def.win64), ret, g.fn_name(f), str.join(params.items, ", ")!)!
    g.protos.write("{};\n", sig)!
    g.bodies.write("{} {{ {} }}\n", sig, body)!
}

/// The C attributes (each with a trailing space) for a function's hints (§11.10).
hint_attrs :: fn(h: Hints) -> string needs Alloc {
    s := list(u8)
    if x := h.inline {
        if x { s.extend("__attribute__((always_inline)) inline ")! } else { s.extend("__attribute__((noinline)) ")! }
    }
    if h.cold { s.extend("__attribute__((cold)) ")! }
    if h.fast_math { s.extend("GM_FAST_MATH_ATTR ")! }
    return s.items
}

/// The labels and types of the `with`s in `e` (excluding nested functions).
collect_withs :: fn(e: ^Expr, out: ^List(WithSlot)) needs Alloc {
    if .With(w) := e.kind { out.push(WithSlot(label: w.label, ty: e.ty))! }
    tir.for_each_child(e, fn(c: ^Expr) { collect_withs(c, out) })
}

// --- the generator's helpers ------------------------------------------------------------

/// With `-g`, maps the code that follows to the source line where `span` starts.
src_line :: fn(fg: ^FnGen, span: source.Span) needs sema.Load {
    if d := fg.g.line_directive(span) { fg.out.write("{}\n", d)! }
}

/// With `-g`, ends the text of a C function: what follows is mapped to the C file.
end_lines :: fn(fg: ^FnGen) needs Alloc {
    if fg.g.opts.debug_info { fg.out.write("{}\n", LINE_RESET)! }
}

/// Appends the indentation of the current line.
indent_line :: fn(fg: ^FnGen) needs Alloc {
    n := fg.indent * 4
    while n > INDENT.len {
        fg.out.extend(INDENT)!
        n -= INDENT.len
    }
    fg.out.extend(INDENT[0..n])!
}

/// Spaces for `indent_line`, eight levels at a time.
INDENT :: "                                "

/// Emits `s` as a line at the current indentation.
line :: fn(fg: ^FnGen, s: string) needs Alloc {
    fg.indent_line()
    fg.out.extend(s)!
    fg.out.push('\n')!
}

/// Emits the formatted text (as `str.format` builds it) as a line at the current
/// indentation.
linef :: fn(A: type, fg: ^FnGen, template :: string, args: ..A) needs Alloc {
    fg.indent_line()
    // As `List(u8).write`, written out: one function per template instead of two.
    out := &fg.out
    @write(fn(bytes) { out.extend(bytes)! }, template, ..args)
    fg.out.push('\n')!
}

/// A fresh number for temporaries and labels.
fresh :: fn(fg: ^FnGen) -> u32 {
    fg.counter += 1
    fg.names += 1
    return fg.counter
}

/// A fresh name for a temporary: `t` and the next number.
fresh_tmp :: fn(fg: ^FnGen) -> string needs Alloc {
    n := usize(fg.fresh())
    names := &fg.g.tmp_names
    while names.items.len < n { names.push(str.format("t{}", names.items.len + 1)!)! }
    return names.items[n - 1]
}

/// Declares a temporary of type `t` initialized to `init`; returns its name.
tmp :: fn(fg: ^FnGen, t: Ty, init: string) -> string needs Alloc {
    fg.temp_bytes += fg.g.ty.size(t)
    c := fg.g.ty.cty(t)
    n := fg.fresh_tmp()
    fg.linef("{} {} = {};", c, n, init)
    return n
}

/// Declares an uninitialized temporary of type `t`.
tmp_uninit :: fn(fg: ^FnGen, t: Ty) -> string needs Alloc {
    fg.temp_bytes += fg.g.ty.size(t)
    c := fg.g.ty.cty(t)
    n := fg.fresh_tmp()
    fg.linef("{} {};", c, n)
    return n
}

/// A zero value of `t`. Scalars are a cast `0`: an empty initializer of a scalar
/// (`(void *){}`) is C23, which older compilers (GCC 11, Apple clang 15) reject.
zero :: fn(fg: ^FnGen, t: Ty) -> string needs Alloc {
    cty := fg.g.ty.cty(t)
    if fg.g.ty.repr(t) in (.Int(_, _, _), .Float(_), .Bool, .Ptr) { return str.format("(({})0)", cty)! }
    return str.format("GM_ZERO({})", cty)!
}

unit :: fn(fg: ^FnGen) -> string needs Alloc => fg.zero(fg.g.ty.unit_ty())

label :: fn(fg: ^FnGen, name: string) needs Alloc {
    fg.out.write("{}:;\n", name)!
}

// --- frames ------------------------------------------------------------------------------

/// The position of local `l` among the parameters.
param_index :: fn(fg: ^const FnGen, l: u32) -> ?usize {
    for i, p in enumerate(fg.def.params) {
        if p is l { return i }
    }
    return null
}

/// The address (`uint8_t *`) of local `l`: in the frame, or the caller's value for a
/// parameter read in place.
local_addr :: fn(fg: ^const FnGen, l: u32) -> string needs Alloc {
    if i := fg.param_index(l) {
        if fg.borrowed[i] { return str.format("((uint8_t *)a{})", i)! }
    }
    return str.format("((uint8_t *)&{})", fg.local_lv(l))!
}

/// Whether `l` is a parameter read in place from the caller's value (`local_addr`).
is_borrowed :: fn(fg: ^const FnGen, l: u32) -> bool {
    if i := fg.param_index(l) { return fg.borrowed[i] }
    return false
}

/// The C lvalue of local `l`: a frame field, or a C local of its own.
local_lv :: fn(fg: ^const FnGen, l: u32) -> string needs Alloc {
    g := fg.g
    i := usize(l)
    if fg.in_frame[i] {
        while g.frame_names.items.len <= i { g.frame_names.push(str.format("F.l{}", g.frame_names.items.len)!)! }
        return g.frame_names.items[i]
    }
    while g.local_names.items.len <= i { g.local_names.push(str.format("gm_l{}", g.local_names.items.len)!)! }
    return g.local_names.items[i]
}

/// The frame `levels` up the capture chain: a `gm_frame *` expression and its function.
frame_up :: fn(fg: ^FnGen, levels: u32) -> (string, u32) needs Alloc {
    expr := "(&F.h)"
    f := fg.fid
    for _ in 0..levels {
        expr = str.format("({}->up)", expr)!
        if p := fg.g.prog.func(f).parent { f = p }
    }
    return (expr, f)
}

/// The C lvalue of field `field` of the frame `levels` up.
frame_field :: fn(fg: ^FnGen, levels: u32, field: string) -> string needs Alloc {
    if levels is 0 { return str.format("F.{}", field)! }
    p, f := fg.frame_up(levels)
    return str.format("((struct {} *){})->{}", fg.g.frame_name(f), p, field)!
}

// --- non-local exits ---------------------------------------------------------------------

/// After a call that may exit non-locally: run the ladder if an exit is in progress.
check_unwind :: fn(fg: ^FnGen) needs Alloc {
    if fg.no_check { return }
    fg.line("if (gm_unw.kind) {")
    fg.unwind_ladder()
}

/// A call of `call`, a C function that returns whether it started an unwind, and the check
/// of that result.
unwind_call :: fn(fg: ^FnGen, call: string) needs Alloc {
    if fg.no_check {
        fg.linef("{};", call)
    } else {
        fg.linef("if ({}) {{", call)
        fg.unwind_ladder()
    }
}

/// The rest of a `check_unwind` whose `if` line was emitted already: the jump and the
/// closing brace.
unwind_ladder :: fn(fg: ^FnGen) needs Alloc {
    fg.indent += 1
    fg.ladder()
    fg.indent -= 1
    fg.line("}")
}

/// Runs pending defers outwards, stopping at the exit's target (see the file's comment):
/// jumps to the rung of the ladder for the current position.
ladder :: fn(fg: ^FnGen) needs Alloc {
    target, scope := fg.ladder_target()
    fg.jump(target, scope)
}

/// The C label of the rung of the ladder for the current position, marked as used, and the
/// index of its scope (`null` for the function's last rung).
ladder_target :: fn(fg: ^FnGen) -> (string, ?usize) needs Alloc {
    i := fg.scopes.items.len
    while i > 0 {
        i -= 1
        s := &fg.scopes.items[i]
        found: ?usize = i
        match s.kind {
            .Block => {
                if s.defers.items.len is 0 { continue }
                if s.defers.items.len > s.used { s.used = s.defers.items.len }
                return (str.format("gm_ld{}_{}", s.id, s.defers.items.len)!, found)
            }
            .Loop(_), .With(_) => {
                s.used = 1
                return (str.format("gm_ll{}", s.id)!, found)
            }
        }
    }
    none: ?usize = null
    if fg.outlined { return ("gm_fprop", none) }
    fg.lad_used = true
    return ("gm_lad", none)
}

/// A new block scope.
block_scope :: fn(fg: ^FnGen) -> Scope needs Alloc => Scope(kind: .Block, id: fg.fresh(), defers: list(Defer))

/// A new loop scope.
loop_scope :: fn(fg: ^FnGen, label: u32, brk: string, cont_: string) -> Scope needs Alloc => Scope(kind: .Loop(LoopLabels(label: label, brk: brk, cont: cont_)), id: fg.fresh(), defers: list(Defer))

/// A new `with` scope.
with_scope :: fn(fg: ^FnGen, label: u32, end: string) -> Scope needs Alloc => Scope(kind: .With(WithLabels(label: label, end: end)), id: fg.fresh(), defers: list(Defer))

/// Emits the rung of the ladder for scope `s`, just popped, if an exit uses it: it runs the
/// scope's part of the ladder and jumps to the rung of the enclosing scope. `fallthrough`
/// is true when control can reach this point normally, so the rung is jumped over.
end_scope :: fn(fg: ^FnGen, s: Scope, fallthrough: bool) needs sema.Load {
    if s.used is 0 { return }
    skip := ""
    if fallthrough {
        skip = str.format("gm_ls{}", fg.fresh())!
        fg.linef("goto {};", skip)
    }
    match s.kind {
        .Block => {
            k := s.used
            while k >= 1 {
                fg.label(str.format("gm_ld{}_{}", s.id, k)!)
                d := s.defers.items[k - 1]
                guard: ?string = null
                if d.is_err { guard = "gm_errdefer_runs(&F.h)" }
                fg.defer_body(guard, d, true)
                k -= 1
            }
        }
        .Loop(l) => {
            fg.label(str.format("gm_ll{}", s.id)!)
            fg.linef("if (gm_unw.frame == &F.h && gm_unw.label == {}) {{", l.label)
            fg.linef("    if (gm_unw.kind == GM_BREAK) {{ gm_unw.kind = GM_NONE; goto {}; }}", l.brk)
            fg.linef("    if (gm_unw.kind == GM_CONTINUE) {{ gm_unw.kind = GM_NONE; goto {}; }}", l.cont)
            fg.line("}")
        }
        .With(w) => {
            fg.label(str.format("gm_ll{}", s.id)!)
            fg.linef("if (gm_unw.kind == GM_BREAK && gm_unw.frame == &F.h && gm_unw.label == {}) {{ gm_unw.kind = GM_NONE; goto {}; }}", w.label, w.end)
        }
    }
    fg.ladder()
    if fallthrough { fg.label(skip) }
}

/// The code of a deferred statement, run by a ladder or at the end of its block, only if
/// `guard` (a C condition) holds when there is one. `unwinding` is true when it runs during
/// a non-local exit: the exit in progress is set aside while it runs, so the calls it makes
/// return normally.
defer_body :: fn(fg: ^FnGen, guard: ?string, d: Defer, unwinding: bool) needs sema.Load {
    saved := fg.set_aside_scopes()
    fg.defer_body_inner(guard, d, unwinding)
    fg.restore_scopes(saved)
}

defer_body_inner :: fn(fg: ^FnGen, guard: ?string, d: Defer, unwinding: bool) needs sema.Load {
    saved_check := fg.no_check
    fg.no_check = true
    if g := guard {
        fg.linef("if ({}) {{", g)
    } else {
        fg.line("{")
    }
    fg.indent += 1
    if unwinding { fg.line("gm_unwind gm_saved = gm_unw; gm_unw.kind = GM_NONE;") }
    // A defer body cannot fail to translate here if it translated before; errors are
    // reported where the defer statement is first seen.
    if c := fg.lirc { _ = c.lc_defer_list(d.lir) }
    if unwinding { fg.line("gm_unw = gm_saved;") }
    fg.indent -= 1
    fg.line("}")
    fg.no_check = saved_check
}

/// Starts a non-local exit of `kind` to `frame` (a `gm_frame *`) and `label`.
/// How an exit leaves (`gm_unw.kind` in the runtime).
ExitKind :: union { Return, Break, Continue, Exit, Resume }

/// The runtime's name for an exit kind.
exit_c_name :: fn(k: ExitKind) -> string => match k {
    .Return => "GM_RETURN"
    .Break => "GM_BREAK"
    .Continue => "GM_CONTINUE"
    .Exit => "GM_EXIT"
    .Resume => "GM_RESUME"
}

/// Starts an exit of `kind` to the frame `frame` (a C expression) at `label` (a C
/// expression; 0 for none); `is_err` (C) is set for a `return` of an error.
start_exit :: fn(fg: ^FnGen, kind: ExitKind, frame: string, label: string, is_err: string) needs Alloc {
    if frame is "(&F.h)" and not fg.outlined and fg.local_exit(kind, label, is_err) { return }
    fg.linef("gm_unw.kind = {}; gm_unw.frame = {}; gm_unw.label = {}; gm_unw.is_err = {};", exit_c_name(kind), frame, label, is_err)
    saved := fg.no_check
    fg.no_check = false
    fg.ladder()
    fg.no_check = saved
}

/// An exit whose target is in this C function jumps there directly, running the defers it
/// crosses, without going through `gm_unw`: the frame's address need not be taken, so the C
/// compiler can keep its locals in registers. Returns false (emitting nothing) when the
/// target is not statically known.
local_exit :: fn(fg: ^FnGen, kind: ExitKind, label: string, is_err: string) -> bool needs Alloc {
    target: ?usize = null
    if kind is .Return {
    } else if kind in (.Break, .Continue) {
        found: ?usize = null
        i := fg.scopes.items.len
        while i > 0 {
            i -= 1
            s := fg.scopes.items[i]
            hit := false
            match s.kind {
                .Loop(l) => { hit = str.format("{}", l.label)! is label }
                .With(w) => { hit = kind is .Break and str.format("{}", w.label)! is label }
                .Block => {}
            }
            if hit {
                found = i
                break
            }
        }
        if found is null { return false }
        target = found
    } else {
        return false
    }
    start: usize = 0
    if t := target { start = t + 1 }
    // Errdefers run on a `return` of an error only: a `break` or `continue` within the
    // function never runs them. An exit that crosses a `defer` takes the ladder, so that
    // each deferred body is emitted once.
    err := kind is .Return and not (is_err is "0")
    for j in start..fg.scopes.items.len {
        s := fg.scopes.items[j]
        if s.kind is .Block {
            for d in s.defers.items {
                if not d.is_err or err { return false }
            }
        }
    }
    dest := "gm_fret"
    if t := target {
        s := fg.scopes.items[t]
        match s.kind {
            .Loop(l) => if kind is .Break { dest = l.brk } else { dest = l.cont }
            .With(w) => { dest = w.end }
            .Block => @unreachable()
        }
    }
    fg.jump(dest, target)
    return true
}

// --- blocks and statements ------------------------------------------------------------------

/// True if no deferred statement is pending in the function: a `return` runs none.
no_defers :: fn(fg: ^const FnGen) -> bool {
    for s in fg.scopes.items {
        if s.kind is .Block and s.defers.items.len > 0 { return false }
    }
    return true
}

// --- frame layout --------------------------------------------------------------------------

/// For each local of `f`: whether it lives in the frame struct `F` instead of in a C local
/// of its own. A local must be in the frame when a function literal or handler clause
/// reaches it through `env` (an `Upvar`), and every local is when the body of a `with … on`,
/// moved into a function of its own, reaches the frame through a pointer, as does a long
/// body split into helpers (see `outline.gm`). Debug builds and `-g` keep them all in the
/// frame: the dead frame is filled with 0xDD (§18.3) and debuggers show the locals as its
/// fields.
///
/// Locals larger than `MAX_C_LOCAL` stay in the frame too. They gain nothing from
/// registers, and the stack check, which counts the C locals with the temporaries that may
/// lie below the frame, would otherwise also count them when the C compiler places them
/// above it, and could report an overflow on a stack that suffices.
frame_locals :: fn(g: ^Gen, f: u32) -> []bool needs sema.Load {
    at := usize(f)
    while g.frame_memo.items.len <= at { g.frame_memo.push(null)! }
    if known := g.frame_memo.items[at] { return known }
    def := g.prog.func(f)
    out := list(bool)
    all := g.opts.debug or g.opts.debug_info or outlines(g, f)
    if b := def.body { all = all or has_fiber_with(b) }
    if all {
        for _ in def.locals { out.push(true)! }
    } else {
        set := captured_locals(g)
        filc := g.ty.lay.target.filc
        for i, l in enumerate(def.locals) {
            out.push((not filc and g.ty.size(l.ty) > MAX_C_LOCAL) or set.get((f, i.trunc(u32))) is not null)!
        }
    }
    g.frame_memo.items[at] = out.items
    return out.items
}

/// The locals that function literals or handler clauses capture, by owner.
captured_locals :: fn(g: ^Gen) -> hash_map.HashMap((u32, u32), bool) needs Alloc {
    if set := g.captured { return set }
    set := hash_map.hash_map((u32, u32), bool)
    n := g.prog.fn_count()
    for i in 0..n {
        d := g.prog.func(i.trunc(u32))
        if b := d.body { collect_upvars(g.prog, i.trunc(u32), b, &set) }
    }
    g.captured = set
    return set
}

/// Whether the locals that LIR adds to function `f` (of body `body`) live in the frame:
/// with its other locals, when code that reaches them may be a C function of its own (the
/// body of a `with … on`, a run of a long function).
lir_framed :: fn(g: ^Gen, f: u32, body: ^Expr) -> bool needs sema.Load => has_fiber_with(body) or outlines(g, f) or g.opts.debug or g.opts.debug_info

/// Whether `e` contains a `with … on` (excluding nested functions).
has_fiber_with :: fn(e: ^Expr) -> bool {
    if .With(w) := e.kind {
        if w.on is not null { return true }
    }
    return tir.any_child(e, fn(c: ^Expr) -> bool => has_fiber_with(c))
}

/// Adds the locals of enclosing functions that `e`, in the body of `f`, refers to.
collect_upvars :: fn(prog: ^Prog, f: u32, e: ^Expr, out: ^hash_map.HashMap((u32, u32), bool)) needs Alloc {
    if .Upvar(levels, local) := e.kind {
        owner := f
        for _ in 0..levels {
            if p := prog.func(owner).parent { owner = p }
        }
        out.put((owner, local), true)!
    }
    tir.for_each_child(e, fn(c: ^Expr) { collect_upvars(prog, f, c, out) })
}
