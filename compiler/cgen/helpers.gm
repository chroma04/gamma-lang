//! Per-type C functions for structural equality (§7.6), ordering (§7.5) and hashing
//! (§16.8), generated on demand. They take the addresses of the values and agree exactly
//! with the interpreter (the hash too, so that hash maps iterate in the same order).

hash_map :: import "std/collections/hash_map"
str :: import "std/str"

pub Helpers :: struct {
    pub protos: List(u8)
    pub bodies: List(u8)
    eq: hash_map.HashMap(u32, string)
    less: hash_map.HashMap(u32, string)
    hash: hash_map.HashMap(u32, string)
    n: usize = 0
}

pub new_helpers :: fn() -> Helpers needs Alloc => Helpers(
    protos: list(u8),
    bodies: list(u8),
    eq: hash_map.hash_map(u32, string),
    less: hash_map.hash_map(u32, string),
    hash: hash_map.hash_map(u32, string),
)

/// A fresh C name for a helper of this `kind` (`eq`, `lt`, `hash`); `Helpers::name`.
pub helper_name :: fn(h: ^Helpers, kind: string) -> string needs Alloc {
    h.n += 1
    return str.format("gm_{}{}", kind, h.n)!
}

/// `bool f(const uint8_t *a, const uint8_t *b)`: `is` on values of type `t`.
pub eq_fn :: fn(h: ^Helpers, ty: ^CTypes, t: Ty) -> string needs Alloc {
    if n := h.eq.get(t.id) { return n }
    name := h.helper_name("eq")
    h.eq.put(t.id, name)!
    h.protos.write("static bool {}(const uint8_t *a, const uint8_t *b);\n", name)!
    b := list(u8)
    p := ty.lay.target.ptr_bytes
    match ty.repr(t) {
        .Int(_, _, _), .Float(_), .Ptr => {
            c := ty.cty(t)
            b.write("    return GM_LD({}, a) == GM_LD({}, b);\n", c, c)!
        }
        .Bool => b.extend("    return (a[0] != 0) == (b[0] != 0);\n")!
        _ => match ty.kind(t) {
            .Tuple(elems, _) => {
                offs := ty.offsets(t)
                for i, et in enumerate(elems) {
                    f := h.eq_fn(ty, et)
                    b.write("    if (!{}(a + {}, b + {})) return false;\n", f, offs[i], offs[i])!
                }
                b.extend("    return true;\n")!
            }
            .Array(len, elem, _) => {
                f := h.eq_fn(ty, elem)
                esz := ty.size(elem)
                b.write("    for (uint64_t i = 0; i < {}; i++) if (!{}(a + i * {}, b + i * {})) return false;\n", len, f, esz, esz)!
                b.extend("    return true;\n")!
            }
            .Slice(_, elem) => {
                f := h.eq_fn(ty, elem)
                esz := ty.size(elem)
                b.write("    uintptr_t n = GM_LD(uintptr_t, a + {});\n", p)!
                b.write("    if (n != GM_LD(uintptr_t, b + {})) return false;\n", p)!
                b.extend("    const uint8_t *pa = GM_LD(void *, a), *pb = GM_LD(void *, b);\n")!
                b.write("    for (uintptr_t i = 0; i < n; i++) if (!{}(pa + i * {}, pb + i * {})) return false;\n", f, esz, esz)!
                b.extend("    return true;\n")!
            }
            .Optional(inner) => {
                f := h.eq_fn(ty, inner)
                flag := ty.offsets(t)[1]
                b.write("    if (a[{}] != b[{}]) return false;\n", flag, flag)!
                b.write("    return !a[{}] || {}(a, b);\n", flag, f)!
            }
            .Result(err, ok) => {
                fe := h.eq_fn(ty, err)
                fo := h.eq_fn(ty, ok)
                offs := ty.offsets(t)
                tg := offs[0]
                pl := offs[1]
                b.write("    if ((a[{}] != 0) != (b[{}] != 0)) return false;\n", tg, tg)!
                b.write("    return a[{}] ? {}(a + {}, b + {}) : {}(a + {}, b + {});\n", tg, fe, pl, pl, fo, pl, pl)!
            }
            .Adt(_, _) => match ty.adt_of(t).kind {
                .Struct(sd) => {
                    if u := sd.bits {
                        f := h.eq_fn(ty, u)
                        b.write("    return {}(a, b);\n", f)!
                    } else {
                        offs := ty.offsets(t)
                        for i, fd in enumerate(sd.fields) {
                            f := h.eq_fn(ty, fd.ty)
                            b.write("    if (!{}(a + {}, b + {})) return false;\n", f, offs[i], offs[i])!
                        }
                        b.extend("    return true;\n")!
                    }
                }
                .Union(tag, variants) => {
                    offs := ty.offsets(t)
                    tc := ty.cty(tag)
                    b.write("    {} ta = GM_LD({}, a + {}), tb = GM_LD({}, b + {});\n", tc, tc, offs[0], tc, offs[0])!
                    b.extend("    if (ta != tb) return false;\n")!
                    for v in variants {
                        if pt := v.payload {
                            f := h.eq_fn(ty, pt)
                            b.write("    if (ta == ({}){}) return {}(a + {}, b + {});\n", tc, string(v.tag.to_decimal()), f, offs[1], offs[1])!
                        }
                    }
                    b.extend("    return true;\n")!
                }
                .CUnion(_) => b.extend("    return false;\n")!
            }
            _ => b.extend("    return true;\n")!
        }
    }
    h.bodies.write("static bool {}(const uint8_t *a, const uint8_t *b) {{\n", name)!
    h.bodies.extend(b.items)!
    h.bodies.extend("}\n")!
    return name
}

/// `bool f(const uint8_t *a, const uint8_t *b)`: `a < b` for values of type `t`.
pub less_fn :: fn(h: ^Helpers, ty: ^CTypes, t: Ty) -> string needs Alloc {
    if n := h.less.get(t.id) { return n }
    name := h.helper_name("lt")
    h.less.put(t.id, name)!
    h.protos.write("static bool {}(const uint8_t *a, const uint8_t *b);\n", name)!
    b := list(u8)
    p := ty.lay.target.ptr_bytes
    match ty.repr(t) {
        .Int(_, _, _), .Float(_), .Ptr, .Bool => {
            c := ty.cty(t)
            b.write("    return GM_LD({}, a) < GM_LD({}, b);\n", c, c)!
        }
        _ => match ty.kind(t) {
            .Tuple(elems, _) => {
                offs := ty.offsets(t)
                for i, et in enumerate(elems) {
                    fe := h.eq_fn(ty, et)
                    fl := h.less_fn(ty, et)
                    o := offs[i]
                    b.write("    if (!{}(a + {}, b + {})) return {}(a + {}, b + {});\n", fe, o, o, fl, o, o)!
                }
                b.extend("    return false;\n")!
            }
            .Array(_, _, _), .Slice(_, _) => {
                elem := t
                array_len: ?u64 = null
                match ty.kind(t) {
                    .Array(len, el, _) => {
                        elem = el
                        array_len = len
                    }
                    .Slice(_, el) => { elem = el }
                    _ => @unreachable()
                }
                fe := h.eq_fn(ty, elem)
                fl := h.less_fn(ty, elem)
                esz := ty.size(elem)
                if n := array_len {
                    b.write("    uintptr_t na = {}, nb = {};\n    const uint8_t *pa = a, *pb = b;\n", n, n)!
                } else {
                    b.write("    uintptr_t na = GM_LD(uintptr_t, a + {}), nb = GM_LD(uintptr_t, b + {});\n", p, p)!
                    b.extend("    const uint8_t *pa = GM_LD(void *, a), *pb = GM_LD(void *, b);\n")!
                }
                b.write("    for (uintptr_t i = 0; i < na && i < nb; i++) {{ if (!{}(pa + i * {}, pb + i * {})) return {}(pa + i * {}, pb + i * {}); }}\n", fe, esz, esz, fl, esz, esz)!
                b.extend("    return na < nb;\n")!
            }
            .Adt(_, _) => match ty.adt_of(t).kind {
                .Union(tag, _) => {
                    tc := ty.cty(tag)
                    o := ty.offsets(t)[0]
                    b.write("    return GM_LD({}, a + {}) < GM_LD({}, b + {});\n", tc, o, tc, o)!
                }
                .Struct(sd) => {
                    if u := sd.bits {
                        f := h.less_fn(ty, u)
                        b.write("    return {}(a, b);\n", f)!
                    } else {
                        b.extend("    return false;\n")!
                    }
                }
                _ => b.extend("    return false;\n")!
            }
            _ => b.extend("    return false;\n")!
        }
    }
    h.bodies.write("static bool {}(const uint8_t *a, const uint8_t *b) {{\n", name)!
    h.bodies.extend(b.items)!
    h.bodies.extend("}\n")!
    return name
}

/// `uint64_t f(const uint8_t *v, uint64_t h)`: mixes the value into the FNV-1a state `h`.
pub hash_fn :: fn(h: ^Helpers, ty: ^CTypes, t: Ty) -> string needs Alloc {
    if n := h.hash.get(t.id) { return n }
    name := h.helper_name("hash")
    h.hash.put(t.id, name)!
    h.protos.write("static uint64_t {}(const uint8_t *v, uint64_t h);\n", name)!
    b := list(u8)
    p := ty.lay.target.ptr_bytes
    match ty.repr(t) {
        .Int(signed, _, _) => {
            c := ty.cty(t)
            f := if signed { "gm_hash_int" } else { "gm_hash_uint" }
            b.write("    return {}(h, GM_LD({}, v));\n", f, c)!
        }
        .Float(_) => {
            c := ty.cty(t)
            b.write("    double x = (double)GM_LD({}, v); if (x == 0) x = 0; uint64_t bits; memcpy(&bits, &x, 8);\n", c)!
            b.extend("    return gm_mix64(h, bits);\n")!
        }
        .Bool => b.extend("    uint8_t x = v[0] != 0; return gm_mix(h, &x, 1);\n")!
        .Ptr => b.extend("    uint64_t x = (uint64_t)(uintptr_t)GM_LD(void *, v); return gm_mix64(h, x);\n")!
        _ => match ty.kind(t) {
            .Tuple(elems, _) => {
                offs := ty.offsets(t)
                for i, et in enumerate(elems) {
                    f := h.hash_fn(ty, et)
                    b.write("    h = {}(v + {}, h);\n", f, offs[i])!
                }
                b.extend("    return h;\n")!
            }
            .Array(len, elem, _) => {
                f := h.hash_fn(ty, elem)
                esz := ty.size(elem)
                b.write("    for (uint64_t i = 0; i < {}; i++) h = {}(v + i * {}, h);\n    return h;\n", len, f, esz)!
            }
            .Slice(_, elem) => {
                f := h.hash_fn(ty, elem)
                esz := ty.size(elem)
                b.write("    uint64_t n = GM_LD(uintptr_t, v + {}); const uint8_t *d = GM_LD(void *, v);\n", p)!
                b.extend("    h = gm_mix64(h, n);\n")!
                b.write("    for (uint64_t i = 0; i < n; i++) h = {}(d + i * {}, h);\n    return h;\n", f, esz)!
            }
            .Optional(inner) => {
                if nullable_pointer(ty.s, inner) {
                    b.extend("    return h;\n")!
                } else {
                    f := h.hash_fn(ty, inner)
                    flag := ty.offsets(t)[1]
                    b.write("    uint8_t s = v[{}] != 0; h = gm_mix(h, &s, 1);\n", flag)!
                    b.write("    return s ? {}(v, h) : h;\n", f)!
                }
            }
            .Result(err, ok) => {
                fe := h.hash_fn(ty, err)
                fo := h.hash_fn(ty, ok)
                offs := ty.offsets(t)
                b.write("    uint8_t e = v[{}] != 0; h = gm_mix(h, &e, 1);\n", offs[0])!
                b.write("    return e ? {}(v + {}, h) : {}(v + {}, h);\n", fe, offs[1], fo, offs[1])!
            }
            .Adt(_, _) => match ty.adt_of(t).kind {
                .Struct(sd) => {
                    if u := sd.bits {
                        f := h.hash_fn(ty, u)
                        b.write("    return {}(v, h);\n", f)!
                    } else {
                        offs := ty.offsets(t)
                        for i, fd in enumerate(sd.fields) {
                            f := h.hash_fn(ty, fd.ty)
                            b.write("    h = {}(v + {}, h);\n", f, offs[i])!
                        }
                        b.extend("    return h;\n")!
                    }
                }
                .Union(tag, variants) => {
                    offs := ty.offsets(t)
                    tc := ty.cty(tag)
                    b.write("    {} tg = GM_LD({}, v + {});\n", tc, tc, offs[0])!
                    for i, var in enumerate(variants) {
                        b.write("    if (tg == ({}){}) {{\n", tc, string(var.tag.to_decimal()))!
                        b.write("        uint64_t k = {}; h = gm_mix64(h, k);\n", i)!
                        if pt := var.payload {
                            f := h.hash_fn(ty, pt)
                            b.write("        h = {}(v + {}, h);\n", f, offs[1])!
                        }
                        b.extend("        return h;\n    }\n")!
                    }
                    b.extend("    return h;\n")!
                }
                .CUnion(_) => b.extend("    return h;\n")!
            }
            _ => b.extend("    return h;\n")!
        }
    }
    h.bodies.write("static uint64_t {}(const uint8_t *v, uint64_t h) {{\n", name)!
    h.bodies.extend(b.items)!
    h.bodies.extend("}\n")!
    return name
}

/// C support for the helpers and for bit builtins.
pub SUPPORT :: ``

#define GM_NOINLINE __attribute__((noinline))
static uint64_t gm_mix(uint64_t h, const void *p, size_t n) {
    const uint8_t *b = p;
    for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 0x100000001b3ULL; }
    return h;
}
/* Mixes the eight little-endian bytes of x, whatever the byte order of the machine. */
static uint64_t gm_mix64(uint64_t h, uint64_t x) {
    for (int i = 0; i < 8; i++) { h ^= (uint8_t)(x >> (8 * i)); h *= 0x100000001b3ULL; }
    return h;
}
/* Mixes the minimal two's-complement little-endian bytes of v (as BigInt::to_signed_bytes_le). */
static uint64_t gm_hash_int(uint64_t h, __int128 v) {
    for (;;) {
        uint8_t byte = (uint8_t)v; v >>= 8;
        h ^= byte; h *= 0x100000001b3ULL;
        if ((v == 0 && !(byte & 0x80)) || (v == -1 && (byte & 0x80))) break;
    }
    return h;
}
static uint64_t gm_hash_uint(uint64_t h, unsigned __int128 v) {
    for (;;) {
        uint8_t byte = (uint8_t)v; v >>= 8;
        h ^= byte; h *= 0x100000001b3ULL;
        if (v == 0 && !(byte & 0x80)) break;
        if (v == 0) { h *= 0x100000001b3ULL; break; }
    }
    return h;
}
static double gm_fmin(double x, double y) {
    if (x != x) return y;
    if (y != y) return x;
    if (x == 0 && y == 0) return __builtin_signbit(x) ? x : y;
    return x < y ? x : y;
}
static double gm_fmax(double x, double y) {
    if (x != x) return y;
    if (y != y) return x;
    if (x == 0 && y == 0) return __builtin_signbit(x) ? y : x;
    return x > y ? x : y;
}
/* base ^ e by repeated squaring, wrapping at the width of T; *o is set when a product that
 * contributes to the result overflowed T (so the true result does not fit T). */
#define GM_POW_FN(name, T)                                                      \
    static T name(T b, uint64_t e, bool *o) {                                   \
        T r = 1;                                                                \
        for (;;) {                                                              \
            if ((e & 1) && __builtin_mul_overflow(r, b, &r)) *o = true;        \
            e >>= 1;                                                            \
            if (!e) return r;                                                   \
            if (__builtin_mul_overflow(b, b, &b)) *o = true;                    \
        }                                                                       \
    }
GM_POW_FN(gm_pow_u8, uint8_t)
GM_POW_FN(gm_pow_i8, int8_t)
GM_POW_FN(gm_pow_u16, uint16_t)
GM_POW_FN(gm_pow_i16, int16_t)
GM_POW_FN(gm_pow_u32, uint32_t)
GM_POW_FN(gm_pow_i32, int32_t)
GM_POW_FN(gm_pow_u64, uint64_t)
GM_POW_FN(gm_pow_i64, int64_t)
GM_POW_FN(gm_pow_u128, unsigned __int128)
GM_POW_FN(gm_pow_i128, __int128)
/* Bit counts of the low `bits` bits of x (the caller masks the rest). */
static unsigned __int128 gm_clz(unsigned __int128 x, int bits) {
    uint64_t hi = (uint64_t)(x >> 64), lo = (uint64_t)x;
    int n = hi ? __builtin_clzll(hi) : lo ? 64 + __builtin_clzll(lo) : 128;
    return n - (128 - bits);
}
static unsigned __int128 gm_ctz(unsigned __int128 x, int bits) {
    uint64_t hi = (uint64_t)(x >> 64), lo = (uint64_t)x;
    int n = lo ? __builtin_ctzll(lo) : hi ? 64 + __builtin_ctzll(hi) : 128;
    return n < bits ? n : bits;
}
static unsigned __int128 gm_popcount(unsigned __int128 x) {
    return __builtin_popcountll((uint64_t)x) + __builtin_popcountll((uint64_t)(x >> 64));
}
static unsigned __int128 gm_bswap(unsigned __int128 x, int bits) {
    unsigned __int128 r = ((unsigned __int128)__builtin_bswap64((uint64_t)x) << 64) | __builtin_bswap64((uint64_t)(x >> 64));
    return r >> (128 - bits);
}
static unsigned __int128 gm_bitreverse(unsigned __int128 x, int bits) {
    unsigned __int128 r = 0;
    for (int i = 0; i < 4; i++) {
        uint32_t w = (uint32_t)(x >> (32 * i));
        w = ((w >> 1) & 0x55555555u) | ((w & 0x55555555u) << 1);
        w = ((w >> 2) & 0x33333333u) | ((w & 0x33333333u) << 2);
        w = ((w >> 4) & 0x0f0f0f0fu) | ((w & 0x0f0f0f0fu) << 4);
        w = __builtin_bswap32(w);
        r |= (unsigned __int128)w << (32 * (3 - i));
    }
    return r >> (128 - bits);
}
/* Rotates the low `bits` bits of x left by k (taken modulo bits). */
static unsigned __int128 gm_rotl(unsigned __int128 x, uint64_t k, int bits) {
    unsigned __int128 mask = bits == 128 ? ~(unsigned __int128)0 : (((unsigned __int128)1 << bits) - 1);
    x &= mask;
    k %= (uint64_t)bits;
    if (k == 0) return x;
    return ((x << k) | (x >> ((uint64_t)bits - k))) & mask;
}
``
