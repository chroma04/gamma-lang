//! Per-type C functions for structural equality (§7.6), ordering (§7.5) and hashing
//! (§16.8), generated on demand. They take the addresses of the values and agree exactly
//! with the interpreter (the hash too, so that hash maps iterate in the same order).

hash_map :: import "std/collections/hash_map"
str :: import "std/str"

pub Helpers :: struct {
    pub protos: List(u8)
    pub bodies: List(u8)
    eq: hash_map.HashMap(u32, string)
    less: hash_map.HashMap(u32, string)
    hash: hash_map.HashMap(u32, string)
    names: Namer
}

new_helpers :: fn() -> Helpers needs Alloc => Helpers(
    protos: list(u8),
    bodies: list(u8),
    eq: hash_map.hash_map(u32, string),
    less: hash_map.hash_map(u32, string),
    hash: hash_map.hash_map(u32, string),
    names: new_namer(),
)

/// A C name for a helper of this `kind` (`eq`, `lt`, `hash`) for type `t`, made from the
/// type's text.
helper_name :: fn(h: ^Helpers, ty: ^CTypes, kind: string, t: Ty) -> string needs Alloc => h.names.keyed(str.format("gm_{}", kind)!, ty.show(t))

/// Registers a new helper of this `kind` for the type `t` in `memo` and declares it
/// (`static ret name(params);`). Returns its name; the caller generates the body and passes
/// it to `define_helper`.
declare_helper :: fn(h: ^Helpers, ty: ^CTypes, memo: ^hash_map.HashMap(u32, string), kind: string, t: Ty, ret: string, params: string) -> string needs Alloc {
    name := h.helper_name(ty, kind, t)
    memo.put(t.id, name)!
    h.protos.write("static {} {}({});\n", ret, name, params)!
    return name
}

/// Defines the helper `name` declared by `declare_helper`, with the statements `body`.
define_helper :: fn(h: ^Helpers, name: string, ret: string, params: string, body: []const u8) needs Alloc {
    h.bodies.write("static {} {}({}) {{\n", ret, name, params)!
    h.bodies.extend(body)!
    h.bodies.extend("}\n")!
}

/// `bool f(const uint8_t *a, const uint8_t *b)`: `is` on values of type `t`.
eq_fn :: fn(h: ^Helpers, ty: ^CTypes, t: Ty) -> string needs Alloc {
    if n := h.eq.get(t.id) { return n }
    name := h.declare_helper(ty, &h.eq, "eq", t, "bool", "const uint8_t *a, const uint8_t *b")
    b := list(u8)
    p := ty.lay.target.ptr_bytes
    match ty.repr(t) {
        .Int(_, _, _), .Float(_), .Ptr => {
            c := ty.cty(t)
            b.write("    return GM_LD({}, a) == GM_LD({}, b);\n", c, c)!
        }
        .Bool => b.extend("    return (a[0] != 0) == (b[0] != 0);\n")!
        _ => match ty.kind(t) {
            .Tuple(elems, _) => {
                offs := ty.offsets(t)
                for i, et in enumerate(elems) {
                    f := h.eq_fn(ty, et)
                    b.write("    if (!{}(a + {}, b + {})) return false;\n", f, offs[i], offs[i])!
                }
                b.extend("    return true;\n")!
            }
            .Array(len, elem, _) => {
                esz := ty.size(elem)
                if bytewise_eq(ty, elem) {
                    b.write("    return memcmp(a, b, {}) == 0;\n", len * esz)!
                } else {
                    f := h.eq_fn(ty, elem)
                    b.write("    for (uint64_t i = 0; i < {}; i++) if (!{}(a + i * {}, b + i * {})) return false;\n", len, f, esz, esz)!
                    b.extend("    return true;\n")!
                }
            }
            .Slice(_, elem) => {
                esz := ty.size(elem)
                b.write("    uintptr_t n = GM_LD(uintptr_t, a + {});\n", p)!
                b.write("    if (n != GM_LD(uintptr_t, b + {})) return false;\n", p)!
                b.extend("    const uint8_t *pa = GM_LD(void *, a), *pb = GM_LD(void *, b);\n")!
                if bytewise_eq(ty, elem) {
                    b.write("    return n == 0 || memcmp(pa, pb, n * {}) == 0;\n", esz)!
                } else {
                    f := h.eq_fn(ty, elem)
                    b.write("    for (uintptr_t i = 0; i < n; i++) if (!{}(pa + i * {}, pb + i * {})) return false;\n", f, esz, esz)!
                    b.extend("    return true;\n")!
                }
            }
            .Optional(inner) => {
                f := h.eq_fn(ty, inner)
                flag := ty.offsets(t)[1]
                b.write("    if (a[{}] != b[{}]) return false;\n", flag, flag)!
                b.write("    return !a[{}] || {}(a, b);\n", flag, f)!
            }
            .Result(err, ok) => {
                fe := h.eq_fn(ty, err)
                fo := h.eq_fn(ty, ok)
                offs := ty.offsets(t)
                tg := offs[0]
                pl := offs[1]
                b.write("    if ((a[{}] != 0) != (b[{}] != 0)) return false;\n", tg, tg)!
                b.write("    return a[{}] ? {}(a + {}, b + {}) : {}(a + {}, b + {});\n", tg, fe, pl, pl, fo, pl, pl)!
            }
            .Adt(_, _) => match ty.adt_of(t).kind {
                .Struct(sd) => {
                    if u := sd.bits {
                        f := h.eq_fn(ty, u)
                        b.write("    return {}(a, b);\n", f)!
                    } else {
                        offs := ty.offsets(t)
                        for i, fd in enumerate(sd.fields) {
                            f := h.eq_fn(ty, fd.ty)
                            b.write("    if (!{}(a + {}, b + {})) return false;\n", f, offs[i], offs[i])!
                        }
                        b.extend("    return true;\n")!
                    }
                }
                .Union(tag, variants) => {
                    offs := ty.offsets(t)
                    tc := ty.cty(tag)
                    b.write("    {} ta = GM_LD({}, a + {}), tb = GM_LD({}, b + {});\n", tc, tc, offs[0], tc, offs[0])!
                    b.extend("    if (ta != tb) return false;\n")!
                    for v in variants {
                        if pt := v.payload {
                            f := h.eq_fn(ty, pt)
                            b.write("    if (ta == ({}){}) return {}(a + {}, b + {});\n", tc, string(v.tag.to_decimal()), f, offs[1], offs[1])!
                        }
                    }
                    b.extend("    return true;\n")!
                }
                .CUnion(_) => b.extend("    return false;\n")!
            }
            _ => b.extend("    return true;\n")!
        }
    }
    h.define_helper(name, "bool", "const uint8_t *a, const uint8_t *b", b.items)
    return name
}

/// Whether values of type `t` are `is`-equal exactly when their bytes are: integers whose
/// storage has no padding bits. (Floats are not: `-0.0 is 0.0`.)
bytewise_eq :: fn(ty: ^CTypes, t: Ty) -> bool needs Alloc => match ty.repr(t) {
    .Int(_, bits, storage) => u64(bits) is storage * 8
    _ => false
}

/// `bool f(const uint8_t *a, const uint8_t *b)`: `a < b` for values of type `t`.
less_fn :: fn(h: ^Helpers, ty: ^CTypes, t: Ty) -> string needs Alloc {
    if n := h.less.get(t.id) { return n }
    name := h.declare_helper(ty, &h.less, "lt", t, "bool", "const uint8_t *a, const uint8_t *b")
    b := list(u8)
    p := ty.lay.target.ptr_bytes
    match ty.repr(t) {
        .Int(_, _, _), .Float(_), .Ptr, .Bool => {
            c := ty.cty(t)
            b.write("    return GM_LD({}, a) < GM_LD({}, b);\n", c, c)!
        }
        _ => match ty.kind(t) {
            .Tuple(elems, _) => {
                offs := ty.offsets(t)
                for i, et in enumerate(elems) {
                    fe := h.eq_fn(ty, et)
                    fl := h.less_fn(ty, et)
                    o := offs[i]
                    b.write("    if (!{}(a + {}, b + {})) return {}(a + {}, b + {});\n", fe, o, o, fl, o, o)!
                }
                b.extend("    return false;\n")!
            }
            .Array(_, _, _), .Slice(_, _) => {
                elem := t
                array_len: ?u64 = null
                match ty.kind(t) {
                    .Array(len, el, _) => {
                        elem = el
                        array_len = len
                    }
                    .Slice(_, el) => { elem = el }
                    _ => @unreachable()
                }
                esz := ty.size(elem)
                if n := array_len {
                    b.write("    uintptr_t na = {}, nb = {};\n    const uint8_t *pa = a, *pb = b;\n", n, n)!
                } else {
                    b.write("    uintptr_t na = GM_LD(uintptr_t, a + {}), nb = GM_LD(uintptr_t, b + {});\n", p, p)!
                    b.extend("    const uint8_t *pa = GM_LD(void *, a), *pb = GM_LD(void *, b);\n")!
                }
                if ty.repr(elem) is .Int(false, 8, 1) {
                    // Bytes compare as `memcmp` compares them.
                    b.extend("    uintptr_t m = na < nb ? na : nb;\n    int c = m == 0 ? 0 : memcmp(pa, pb, m);\n    return c != 0 ? c < 0 : na < nb;\n")!
                } else {
                    fe := h.eq_fn(ty, elem)
                    fl := h.less_fn(ty, elem)
                    b.write("    for (uintptr_t i = 0; i < na && i < nb; i++) {{ if (!{}(pa + i * {}, pb + i * {})) return {}(pa + i * {}, pb + i * {}); }}\n", fe, esz, esz, fl, esz, esz)!
                    b.extend("    return na < nb;\n")!
                }
            }
            .Adt(_, _) => match ty.adt_of(t).kind {
                .Union(tag, _) => {
                    tc := ty.cty(tag)
                    o := ty.offsets(t)[0]
                    b.write("    return GM_LD({}, a + {}) < GM_LD({}, b + {});\n", tc, o, tc, o)!
                }
                .Struct(sd) => {
                    if u := sd.bits {
                        f := h.less_fn(ty, u)
                        b.write("    return {}(a, b);\n", f)!
                    } else {
                        b.extend("    return false;\n")!
                    }
                }
                _ => b.extend("    return false;\n")!
            }
            _ => b.extend("    return false;\n")!
        }
    }
    h.define_helper(name, "bool", "const uint8_t *a, const uint8_t *b", b.items)
    return name
}

/// The hash state after mixing in the scalar of type `t` at C address `at`, as a C
/// expression of the state `h`; `null` if `t` is not a scalar. The structural hash
/// (§16.8) mixes one 64-bit word at a time (`gm_mix64`): an integer as its value extended
/// to 64 bits (a 128-bit one as two words, low first), a float as the bits of its `f64`
/// value with `-0.0` as `0.0`, a `bool` as 0 or 1, a pointer as its address. The
/// interpreter computes the same (`interp/builtins.gm`).
hash_scalar :: fn(ty: ^CTypes, t: Ty, at: string) -> ?string needs Alloc {
    match ty.repr(t) {
        .Int(signed, _, storage) => {
            c := ty.cty(t)
            if storage > 8 { return str.format("gm_mix128(h, (unsigned __int128)GM_LD({}, {}))", c, at)! }
            wide := if signed { "(uint64_t)(int64_t)" } else { "(uint64_t)" }
            return str.format("gm_mix64(h, {}GM_LD({}, {}))", wide, c, at)!
        }
        .Float(_) => return str.format("gm_mix_float(h, (double)GM_LD({}, {}))", ty.cty(t), at)!
        .Bool => return str.format("gm_mix64(h, ({})[0] != 0)", at)!
        .Ptr => return str.format("gm_mix64(h, (uint64_t)(uintptr_t)GM_LD(void *, {}))", at)!
        _ => return null
    }
}

/// The statement that mixes the value of type `t` at C address `at` into `h`.
hash_step :: fn(h: ^Helpers, ty: ^CTypes, t: Ty, at: string) -> string needs Alloc {
    if e := hash_scalar(ty, t, at) { return str.format("h = {};", e)! }
    return str.format("h = {}({}, h);", h.hash_fn(ty, t), at)!
}

/// The statements that mix the `count` (a C expression) elements of type `elem` at C
/// address `data` into `h`: bytes eight at a time, others one by one.
hash_elems :: fn(h: ^Helpers, ty: ^CTypes, elem: Ty, data: string, count: string) -> string needs Alloc {
    if .Int(signed, bits, _) := ty.repr(elem) and not signed and bits is 8 {
        return str.format("    h = gm_mix_bytes(h, {}, {});\n", data, count)!
    }
    step := h.hash_step(ty, elem, str.format("{} + i * {}", data, ty.size(elem))!)
    return str.format("    for (uint64_t i = 0; i < {}; i++) {}\n", count, step)!
}

/// `uint64_t f(const uint8_t *v, uint64_t h)`: mixes the value into the hash state `h`.
hash_fn :: fn(h: ^Helpers, ty: ^CTypes, t: Ty) -> string needs Alloc {
    if n := h.hash.get(t.id) { return n }
    name := h.declare_helper(ty, &h.hash, "hash", t, "uint64_t", "const uint8_t *v, uint64_t h")
    b := list(u8)
    p := ty.lay.target.ptr_bytes
    if e := hash_scalar(ty, t, "v") {
        b.write("    return {};\n", e)!
        h.define_helper(name, "uint64_t", "const uint8_t *v, uint64_t h", b.items)
        return name
    }
    match ty.kind(t) {
        .Tuple(elems, _) => {
            offs := ty.offsets(t)
            for i, et in enumerate(elems) {
                b.write("    {}\n", h.hash_step(ty, et, str.format("v + {}", offs[i])!))!
            }
        }
        .Array(len, elem, _) => b.extend(h.hash_elems(ty, elem, "v", str.format("{}", len)!))!
        .Slice(_, elem) => {
            b.write("    uint64_t n = GM_LD(uintptr_t, v + {}); const uint8_t *d = GM_LD(void *, v);\n", p)!
            b.extend("    h = gm_mix64(h, n);\n")!
            b.extend(h.hash_elems(ty, elem, "d", "n"))!
        }
        .Optional(inner) => {
            flag := ty.offsets(t)[1]
            b.write("    uint8_t s = v[{}] != 0; h = gm_mix64(h, s);\n", flag)!
            b.write("    if (s) {}\n", h.hash_step(ty, inner, "v"))!
        }
        .Result(err, ok) => {
            offs := ty.offsets(t)
            b.write("    uint8_t e = v[{}] != 0; h = gm_mix64(h, e);\n", offs[0])!
            at := str.format("v + {}", offs[1])!
            b.write("    if (e) {} else {}\n", h.hash_step(ty, err, at), h.hash_step(ty, ok, at))!
        }
        .Adt(_, _) => match ty.adt_of(t).kind {
            .Struct(sd) => {
                if u := sd.bits {
                    b.write("    {}\n", h.hash_step(ty, u, "v"))!
                } else {
                    offs := ty.offsets(t)
                    for i, fd in enumerate(sd.fields) {
                        b.write("    {}\n", h.hash_step(ty, fd.ty, str.format("v + {}", offs[i])!))!
                    }
                }
            }
            .Union(tag, variants) => {
                offs := ty.offsets(t)
                tc := ty.cty(tag)
                b.write("    {} tg = GM_LD({}, v + {});\n", tc, tc, offs[0])!
                for i, var in enumerate(variants) {
                    b.write("    if (tg == ({}){}) {{\n", tc, string(var.tag.to_decimal()))!
                    b.write("        h = gm_mix64(h, {});\n", i)!
                    if pt := var.payload {
                        b.write("        {}\n", h.hash_step(ty, pt, str.format("v + {}", offs[1])!))!
                    }
                    b.extend("        return h;\n    }\n")!
                }
            }
            .CUnion(_) => {}
        }
        _ => {}
    }
    b.extend("    return h;\n")!
    h.define_helper(name, "uint64_t", "const uint8_t *v, uint64_t h", b.items)
    return name
}

/// C support for the helpers and for bit builtins.
SUPPORT :: ``

#define GM_NOINLINE __attribute__((noinline))
/* The step of the structural hash: the state and the word, multiplied by an odd constant
   to 128 bits, whose halves are folded together, so that every bit of the result depends
   on every bit of both. */
static inline uint64_t gm_mix64(uint64_t h, uint64_t x) {
    unsigned __int128 m = (unsigned __int128)(h ^ x) * 0x9E3779B97F4A7C15ULL;
    return (uint64_t)m ^ (uint64_t)(m >> 64);
}
static inline uint64_t gm_mix128(uint64_t h, unsigned __int128 x) {
    return gm_mix64(gm_mix64(h, (uint64_t)x), (uint64_t)(x >> 64));
}
static inline uint64_t gm_mix_float(uint64_t h, double x) {
    uint64_t bits;
    if (x == 0) x = 0;
    memcpy(&bits, &x, 8);
    return gm_mix64(h, bits);
}
/* Mixes n bytes as little-endian words of eight, the last one of the bytes that are left. */
static uint64_t gm_mix_bytes(uint64_t h, const uint8_t *p, uint64_t n) {
    for (; n >= 8; p += 8, n -= 8) {
        uint64_t w;
        memcpy(&w, p, 8);
#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
        w = __builtin_bswap64(w);
#endif
        h = gm_mix64(h, w);
    }
    if (n > 0) {
        uint64_t w = 0;
        for (uint64_t i = 0; i < n; i++) w |= (uint64_t)p[i] << (8 * i);
        h = gm_mix64(h, w);
    }
    return h;
}
static double gm_fmin(double x, double y) {
    if (x != x) return y;
    if (y != y) return x;
    if (x == 0 && y == 0) return __builtin_signbit(x) ? x : y;
    return x < y ? x : y;
}
static double gm_fmax(double x, double y) {
    if (x != x) return y;
    if (y != y) return x;
    if (x == 0 && y == 0) return __builtin_signbit(x) ? y : x;
    return x > y ? x : y;
}
/* base ^ e by repeated squaring, wrapping at the width of T; *o is set when a product that
 * contributes to the result overflowed T (so the true result does not fit T). */
#define GM_POW_FN(name, T)                                                      \
    static T name(T b, uint64_t e, bool *o) {                                   \
        T r = 1;                                                                \
        for (;;) {                                                              \
            if ((e & 1) && __builtin_mul_overflow(r, b, &r)) *o = true;        \
            e >>= 1;                                                            \
            if (!e) return r;                                                   \
            if (__builtin_mul_overflow(b, b, &b)) *o = true;                    \
        }                                                                       \
    }
GM_POW_FN(gm_pow_u8, uint8_t)
GM_POW_FN(gm_pow_i8, int8_t)
GM_POW_FN(gm_pow_u16, uint16_t)
GM_POW_FN(gm_pow_i16, int16_t)
GM_POW_FN(gm_pow_u32, uint32_t)
GM_POW_FN(gm_pow_i32, int32_t)
GM_POW_FN(gm_pow_u64, uint64_t)
GM_POW_FN(gm_pow_i64, int64_t)
GM_POW_FN(gm_pow_u128, unsigned __int128)
GM_POW_FN(gm_pow_i128, __int128)
/* Bit counts of the low `bits` bits of x (the caller masks the rest). */
static unsigned __int128 gm_clz(unsigned __int128 x, int bits) {
    uint64_t hi = (uint64_t)(x >> 64), lo = (uint64_t)x;
    int n = hi ? __builtin_clzll(hi) : lo ? 64 + __builtin_clzll(lo) : 128;
    return n - (128 - bits);
}
static unsigned __int128 gm_ctz(unsigned __int128 x, int bits) {
    uint64_t hi = (uint64_t)(x >> 64), lo = (uint64_t)x;
    int n = lo ? __builtin_ctzll(lo) : hi ? 64 + __builtin_ctzll(hi) : 128;
    return n < bits ? n : bits;
}
static unsigned __int128 gm_popcount(unsigned __int128 x) {
    return __builtin_popcountll((uint64_t)x) + __builtin_popcountll((uint64_t)(x >> 64));
}
static unsigned __int128 gm_bswap(unsigned __int128 x, int bits) {
    unsigned __int128 r = ((unsigned __int128)__builtin_bswap64((uint64_t)x) << 64) | __builtin_bswap64((uint64_t)(x >> 64));
    return r >> (128 - bits);
}
static unsigned __int128 gm_bitreverse(unsigned __int128 x, int bits) {
    unsigned __int128 r = 0;
    for (int i = 0; i < 4; i++) {
        uint32_t w = (uint32_t)(x >> (32 * i));
        w = ((w >> 1) & 0x55555555u) | ((w & 0x55555555u) << 1);
        w = ((w >> 2) & 0x33333333u) | ((w & 0x33333333u) << 2);
        w = ((w >> 4) & 0x0f0f0f0fu) | ((w & 0x0f0f0f0fu) << 4);
        w = __builtin_bswap32(w);
        r |= (unsigned __int128)w << (32 * (3 - i));
    }
    return r >> (128 - bits);
}
/* Rotates the low `bits` bits of x left by k (taken modulo bits). */
static unsigned __int128 gm_rotl(unsigned __int128 x, uint64_t k, int bits) {
    unsigned __int128 mask = bits == 128 ? ~(unsigned __int128)0 : (((unsigned __int128)1 << bits) - 1);
    x &= mask;
    k %= (uint64_t)bits;
    if (k == 0) return x;
    return ((x << k) | (x >> ((uint64_t)bits - k))) & mask;
}
``
