// Sieve of Eratosthenes, run 100 times: array stores and loads behind bounds checks.
N :: 1000000

count_primes :: fn(flags: ^[N]bool) -> i64 {
    for i in 0..N {
        flags[i] = true
    }
    flags[0] = false
    flags[1] = false
    i: usize = 2
    while i * i < N {
        if flags[i] {
            j := i * i
            while j < N {
                flags[j] = false
                j += i
            }
        }
        i += 1
    }
    n: i64 = 0
    for k in 0..N {
        if flags[k] {
            n += 1
        }
    }
    return n
}

main :: fn() needs Out {
    flags := [N]bool(fill: false)
    total: i64 = 0
    for _ in 0..100 {
        total += count_primes(&flags)
    }
    print("{}\n", total)
}
