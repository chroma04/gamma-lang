// 200x200 matrix product, 40 times: nested loops over arrays behind bounds checks.
N :: 200

mul :: fn(a, b, c: ^[N * N]f64) {
    for i in 0..N {
        for j in 0..N {
            s := 0.0
            for k in 0..N {
                s += a[i * N + k] * b[k * N + j]
            }
            c[i * N + j] = s
        }
    }
}

main :: fn() needs Out {
    a: [N * N]f64 = ---
    b: [N * N]f64 = ---
    c: [N * N]f64 = [N * N]f64(fill: 0.0)
    for i in 0..N * N {
        a[i] = (i % 7).to(f64) - 3.0
        b[i] = (i % 5).to(f64) * 0.5
    }
    total := 0.0
    for _ in 0..40 {
        mul(&a, &b, &c)
        for i in 0..N * N {
            total += c[i]
        }
        a[0] = a[0] + 1.0
    }
    print("{}\n", total)
}
