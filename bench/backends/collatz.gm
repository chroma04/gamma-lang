// The longest Collatz chain below 3,000,000: checked integer arithmetic and branches.
steps :: fn(start: u64) -> u32 {
    n := start
    s: u32 = 0
    while n is not 1 {
        if n % 2 is 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        s += 1
    }
    return s
}

main :: fn() needs Out {
    best: u32 = 0
    at: u64 = 1
    for i in 1..3000000 {
        x := u64(i)
        s := steps(x)
        if s > best {
            best = s
            at = x
        }
    }
    print("{} {}\n", at, best)
}
