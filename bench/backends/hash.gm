// 100 million rounds of a 64-bit mixing function: wrapping arithmetic, shifts and xors.
mix :: fn(x: u64) -> u64 {
    z := x +% 0x9E3779B97F4A7C15
    z = (z ~ (z >> 30)) *% 0xBF58476D1CE4E5B9
    z = (z ~ (z >> 27)) *% 0x94D049BB133111EB
    return z ~ (z >> 31)
}

main :: fn() needs Out {
    h: u64 = 0
    for i in 0..100000000 {
        h = mix(h ~ u64(i))
    }
    print("{}\n", h)
}
