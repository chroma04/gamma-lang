// 20000 allocations and frees of a small struct through the ambient allocator.
P :: struct { a: i64, b: i64 }

main :: fn() -> AllocError!() \ {Out, Alloc} {
    s: i64 = 0
    for i in 0..20000 {
        p := try new(P(a: i, b: 1))
        s += p.a + p.b
        destroy(p)
    }
    print("{}\n", s)
    return ()
}
