// 20000 inserts into a HashMap, then lookups.
main :: fn() -> AllocError!() \ {Out, Alloc} {
    m := map(u32, u32)
    defer m.deinit()
    for i in 0..20000 {
        try m.put(i, i * 2)
    }
    total: u64 = 0
    for i in 0..20000 {
        total += u64(m.get(i)?)
    }
    print("{}\n", total)
    return ()
}
