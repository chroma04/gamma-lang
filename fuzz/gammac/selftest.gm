//! A target that fails on purpose, to check that the fuzzer records each kind of failure.
//! It is not built by default (`fuzz/gammac/build.sh selftest`). Run it on a file that
//! holds `BOOM` (a trap), `STKO` (a stack overflow) or `HNG!` (an endless loop):
//!
//!     fuzz/gammac/run.sh selftest -timeout=3 FILE
//!
//! Each must end with an error of libFuzzer's, and fuzzing without a file must find them.

c :: import "std/c"
harness :: import "./harness"

deep :: fn(n: usize) -> usize {
    if n is 0 { return 0 }
    return deep(n - 1) + 1
}

starts_with :: fn(input, prefix: string) -> bool => input.len >= prefix.len and input[0..prefix.len] is prefix

body :: fn(input: string) needs Alloc {
    if starts_with(input, "BOOM") { trap("boom") }
    if starts_with(input, "STKO") { _ = deep(1_000_000_000) }
    if starts_with(input, "HNG!") {
        while true {}
    }
}

entry :: fn(data: [^]const u8, size: usize) -> c.c_int needs Sys => harness.exec(data, size, body)

main :: fn() needs Alloc + Env + Sys { harness.run(entry) }
