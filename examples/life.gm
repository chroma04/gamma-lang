//! Conway's Game of Life on a small toroidal grid.
//!
//! The grid is a fixed-size array of arrays whose dimensions are compile-time constants, the
//! rule (`B3/S23`) is parsed into a lookup table by an ordinary function at compile time, and
//! the grid's operations are struct methods. With no arguments it runs a built-in glider and
//! blinker; otherwise the first argument is the number of generations and the second a
//! pattern file of `#` (alive) and `.` (dead) rows, placed near the top-left corner.
//!
//! Run from the examples/ directory:
//!
//!     gamma run life.gm
//!     gamma run life.gm 6 data/life-pattern.txt

fs :: import "std/fs"
str :: import "std/str"

W :: 20
H :: 10

/// Neighbor offsets. Adding `W - 1` and taking the remainder is "minus one" on a torus
/// without any signed arithmetic.
DX :: [3]usize(W - 1, 0, 1)
DY :: [3]usize(H - 1, 0, 1)

@static_assert(W >= 3 and H >= 3, "the torus needs at least 3 rows and columns")
@static_assert(W % H is 0, "the glider test walks around the torus once")

/// `table[alive][neighbors]` says whether a cell is alive in the next generation. It is
/// built from a rule string such as "B3/S23" while compiling: no effects, so it can run then.
rule_table :: fn(rule: string) -> [2][9]bool {
    table := [2][9]bool(fill: [9]bool(fill: false))
    row: usize = 0
    for c in bytes(rule) {
        if c is 'B' {
            row = 0
        } else if c is 'S' {
            row = 1
        } else if c in '0'..='8' {
            table[row][usize(c - '0')] = true
        } else if c is not '/' {
            trap("bad rule string")
        }
    }
    return table
}

RULE :: rule_table("B3/S23")

GLIDER :: ".#.\n..#\n###"
BLINKER :: "###"

Grid :: struct {
    cells: [H][W]bool
}

empty :: fn() -> Grid => Grid(cells: [H][W]bool(fill: [W]bool(fill: false)))

/// Number of live cells among the eight neighbors of (x, y), wrapping around the edges.
neighbors :: fn(g: ^const Grid, x, y: usize) -> usize {
    n: usize = 0
    for dy in DY {
        for dx in DX {
            if dx is 0 and dy is 0 { continue }
            if g.cells[(y + dy) % H][(x + dx) % W] { n += 1 }
        }
    }
    return n
}

/// The next generation; `g` is not modified.
step :: fn(g: ^const Grid) -> Grid {
    next := empty()
    for y in 0..H {
        for x in 0..W {
            alive := if g.cells[y][x] { 1 } else { 0 }
            next.cells[y][x] = RULE[alive][neighbors(g, x, y)]
        }
    }
    return next
}

population :: fn(g: ^const Grid) -> usize {
    n: usize = 0
    for row in g.cells {
        for cell in row {
            if cell { n += 1 }
        }
    }
    return n
}

/// Draws the pattern text into the grid with its top-left corner at (ox, oy).
stamp :: fn(g: ^Grid, text: string, ox, oy: usize) {
    y: usize = 0
    for line in str.lines(text) {
        if line.len > 0 and line[0] is '#' and line.len > 1 and line[1] is ' ' { continue }
        for x, c in enumerate(line) {
            if c is '#' { g.cells[(oy + y) % H][(ox + x) % W] = true }
        }
        y += 1
    }
}

show :: fn(g: ^const Grid, generation: usize) needs Out {
    print("generation {} ({} alive)\n", generation, g.population())
    for y in 0..H {
        row: [W]u8 = ---
        for x in 0..W { row[x] = if g.cells[y][x] { '#' } else { '.' } }
        text: string = row[..]
        print("{}\n", text)
    }
}

main :: fn() -> u8 needs Out + Err + Fs + Alloc + Env {
    args := Env.args()[1..]
    generations: usize = 4
    if args.len >= 1 {
        generations = str.parse_int(usize, args[0]) else {
            eprint("error: '{}' is not a number of generations\n", args[0])
            return 1
        }
    }
    g := empty()
    if args.len >= 2 {
        text := fs.read_all(args[1]) else {
            eprint("error: cannot read {}\n", args[1])
            return 1
        }
        defer free(text)
        stamp(&g, text, 2, 2)
    } else {
        stamp(&g, GLIDER, 1, 1)
        stamp(&g, BLINKER, 12, 6)
    }
    gen: usize = 0
    while true {
        show(&g, gen)
        if gen is generations { break }
        g = step(&g)
        gen += 1
        print("\n")
    }
    return 0
}

test "rule table is Conway's" {
    expect(RULE[0][3])           // birth with three neighbors
    expect(not RULE[0][2])
    expect(RULE[1][2] and RULE[1][3])
    expect(not RULE[1][1] and not RULE[1][4])
}

test "a blinker has period two" {
    g := empty()
    stamp(&g, BLINKER, 5, 5)
    a := step(&g)
    expect(a.cells[4][6] and a.cells[5][6] and a.cells[6][6])
    expect_eq(a.population(), 3)
    expect(step(&a) is g)
}

test "a glider travels diagonally and wraps around the torus" {
    g := empty()
    stamp(&g, GLIDER, 0, 0)
    h := g
    for _ in 0..4 { h = step(&h) }
    shifted := empty()
    stamp(&shifted, GLIDER, 1, 1)
    expect(h is shifted)
    // It moves one cell diagonally every four generations, so 4 * W generations in all
    // take it around the torus (W is a multiple of H) and back to where it started.
    for _ in 0..(4 * W - 4) { h = step(&h) }
    expect(h is g)
}

test "neighbors wrap at the corners" {
    g := empty()
    g.cells[H - 1][W - 1] = true
    expect_eq(neighbors(&g, 0, 0), 1)
    expect_eq(neighbors(&g, 1, 1), 0)
}
