//! Calling the C standard library from Gamma.
//!
//! Shows: a `foreign "c"` block, `needs not` for functions you trust to be pure, `Sys`
//! for the ones you do not, C-compatible types from `std/c`, passing a Gamma function to
//! C as a callback (`qsort`), a C-layout struct returned by value (`div`), variadic
//! calls (`snprintf`), out-parameters (`strtol`), turning a `cstring` back into a Gamma
//! `string`, and a `#bits` struct that packs flags into one integer.
//!
//! Only functions that exist on every platform are used. Run from the examples/
//! directory:  gamma run c_interop.gm      (or: gamma run --backend=c c_interop.gm)

c :: import "std/c"

/// C's `div_t`: a struct of C-compatible fields has C's layout and can cross the boundary.
DivT :: struct {
    quot: c.c_int
    rem: c.c_int
}

libc :: foreign "c" {
    // Trusted to touch nothing but their arguments, so they need no effects.
    strlen :: fn(s: cstring) -> usize needs not
    abs :: fn(n: c.c_int) -> c.c_int needs not
    div :: fn(n, d: c.c_int) -> DivT needs not
    strcmp :: fn(a, b: cstring) -> c.c_int needs not
    // Writes through pointers it is given, calls back into Gamma, or reads memory by
    // address: leave the default `needs Sys` and say so in the callers.
    strtol :: fn(s: cstring, end: ^cstring, base: c.c_int) -> c.c_long
    snprintf :: fn(buf: [^]u8, size: usize, fmt: cstring, ...) -> c.c_int
    qsort :: fn(base: rawptr, n, size: usize, cmp: ^fn(a, b: rawptr) -> c.c_int)
}

/// Gamma callback for `qsort`: compares two `i32`s. A callback passed to C has an empty
/// effect set (or `Sys`), and its pointers come back as `rawptr`, so it casts them.
compare_i32 :: fn(a, b: rawptr) -> c.c_int {
    x := a.cast(^const i32)^
    y := b.cast(^const i32)^
    if x < y { return -1 }
    if x > y { return 1 }
    return 0
}

/// Gamma permissions as a C-style bit set: one `u16`, with the layout fixed by the language.
Perm :: #bits(u16) struct {
    read, write, exec: bool
    level: u4
    _: u9
}

/// The text of a C string as a Gamma `string`, without copying.
to_string :: fn(s: cstring) -> string => s[0..s.cstr_len()]

main :: fn() needs Out + Sys {
    // Strings: `c"..."` literals are NUL-terminated `cstring`s.
    greeting := c"hello from C land"
    print("strlen: {}\n", libc.strlen(greeting))
    print("to_string: {}\n", to_string(greeting))
    print("strcmp: {} {} {}\n", sign(libc.strcmp(c"apple", c"banana")), sign(libc.strcmp(c"pear", c"pear")), sign(libc.strcmp(c"b", c"a")))

    // Integers and structs by value.
    print("abs: {}\n", libc.abs(-42))
    d := libc.div(17, 5)
    print("div: {} remainder {}\n", d.quot, d.rem)

    // An out-parameter: `strtol` stores where it stopped parsing.
    text := c"1234 apples"
    rest: cstring = text
    value := libc.strtol(text, &rest, 10)
    print("strtol: {}, rest is \"{}\"\n", value, to_string(rest))

    // A callback: C sorts a Gamma array with a Gamma comparison function.
    nums := [_]i32(42, -7, 19, 0, 3, 1000, -250)
    libc.qsort(&nums, nums.len, @size_of(i32), compare_i32)
    print("qsort:")
    for n in nums { print(" {}", n) }
    print("\n")

    // A variadic call writing into a Gamma buffer. Arguments in the `...` position are
    // converted explicitly to the widths C expects (`int`, `double`).
    buf: [64]u8 = ---
    arg: c.c_int = 7
    ratio: c.c_double = 2.5
    n := libc.snprintf(&buf, buf.len, c"%d items at %.2f each", arg, ratio)
    written := n.checked(usize) else trap("snprintf failed")
    print("snprintf wrote {} bytes: {}\n", n, buf[0..written])

    // A bit-field struct is a plain integer for C.
    p := Perm(read: true, write: true, exec: false, level: 3)
    print("perm bits: {}\n", u16(p))
    q := Perm(u16(0b001_1101))
    print("exec: {}, write: {}, level: {}\n", q.exec, q.write, q.level)
}

sign :: fn(n: c.c_int) -> i32 => if n < 0 { -1 } else if n > 0 { 1 } else { 0 }
