//! A three-stage pipeline of cooperative fibers (generate -> square -> sum) that talk
//! through bounded channels, scheduled by `std/fiber`.
//!
//! Shows: `fiber.scheduler(Out + Clock)`, whose effect set says what tasks may perform
//! besides `Sched`; `with &sched on stack { ... }`; `fiber.spawn` and `fiber.join`; a
//! small channel built on `std/collections/deque`; `Clock.sleep` and `Clock.now`; and a
//! `test` that runs the same pipeline on the test runner's fake clock, where `sleep`
//! advances time instead of waiting.
//!
//! Run from the examples/ directory:  gamma run fibers.gm      (or: gamma test fibers.gm)

fiber :: import "std/fiber"
queue :: import "std/collections/deque"

/// What a task may do: yield to the others, and print and sleep through the effects
/// that are handled outside the scheduler.
Task :: fiber.Sched(Out + Clock)

STACK :: 32768

/// A bounded queue between two fibers. `send` and `recv` give way to the other fibers
/// (`yield_now`) while they cannot make progress, so no locking is needed: only one
/// fiber runs at a time and switches happen only at `yield_now`.
Chan :: struct {
    items: queue.Deque(u32)
    capacity: usize
    closed: bool = false
}

channel :: fn(capacity: usize) -> Chan needs Alloc {
    return Chan(items: queue.deque(u32), capacity: capacity)
}

send :: fn(c: ^Chan, x: u32) needs Task {
    while c.items.len() >= c.capacity { fiber.yield_now() }
    c.items.push_back(x) else trap("out of memory")
}

/// The next value, or null once the channel is closed and empty.
recv :: fn(c: ^Chan) -> ?u32 needs Task {
    while c.items.is_empty() {
        if c.closed { return null }
        fiber.yield_now()
    }
    return c.items.pop_front()
}

/// One pipeline stage. Every stage sleeps `delay` per item, as if the work took that long.
Stage :: struct {
    name: string
    input: ?^Chan
    output: ?^Chan
    count: u32
    delay: Duration
    total: u32 = 0
}

generate :: fn(s: ^Stage) needs Task + Out + Clock {
    out := s.output?
    defer out.closed = true
    for i in 1..s.count + 1 {
        Clock.sleep(s.delay)
        print("{}: {}\n", s.name, i)
        send(out, i)
    }
}

square :: fn(s: ^Stage) needs Task + Out + Clock {
    input := s.input?
    out := s.output?
    defer out.closed = true
    while x := recv(input) {
        Clock.sleep(s.delay)
        print("{}: {} -> {}\n", s.name, x, x * x)
        send(out, x * x)
    }
}

sum :: fn(s: ^Stage) needs Task + Out + Clock {
    input := s.input?
    while x := recv(input) {
        Clock.sleep(s.delay)
        s.total += x
        print("{}: +{} = {}\n", s.name, x, s.total)
    }
}

/// Runs the pipeline to completion and returns the sum and the time it took.
pipeline :: fn(count: u32) -> (total: u32, took: Duration) needs Out + Clock + Alloc {
    a := channel(2)
    defer a.items.deinit()
    b := channel(2)
    defer b.items.deinit()
    gen := Stage(name: "generate", input: null, output: &a, count: count, delay: ms(5))
    sq := Stage(name: "square", input: &a, output: &b, count: 0, delay: ms(10))
    acc := Stage(name: "sum", input: &b, output: null, count: 0, delay: ms(2))

    // Every task and the code under `with` needs a stack of its own.
    main_stack: [STACK]u8 = ---
    s1: [STACK]u8 = ---
    s2: [STACK]u8 = ---
    s3: [STACK]u8 = ---

    sched := fiber.scheduler(Out + Clock)
    defer sched.deinit()
    start := Clock.now()
    with &sched on main_stack[..] {
        fiber.spawn(generate, &gen, s1[..])
        fiber.spawn(square, &sq, s2[..])
        fiber.spawn(sum, &acc, s3[..])
        fiber.join()
    }
    return (total: acc.total, took: Clock.now().since(start))
}

main :: fn() needs Out + Clock + Alloc {
    r := pipeline(6)
    print("sum of squares: {}\n", r.total)
    // The sleeps run one after another (one fiber runs at a time), so at least
    // 6 * (5 + 10 + 2) ms went by. The exact figure is not printed: it is real time.
    print("took at least 102 ms: {}\n", r.took.to_ms() >= 102)
}

test "the pipeline sums the squares" {
    r := pipeline(4)
    expect_eq(r.total, 30)
}

test "tests run on a fake clock" {
    // `sleep` advances the fake clock and returns at once, so the elapsed time is
    // exact and the test is instant.
    r := pipeline(5)
    expect_eq(r.took.to_ms(), 5 * (5 + 10 + 2))
}
