//! sha256sum: print or verify SHA-256 digests, like the coreutils tool.
//!
//!     sha256sum [FILE...]        prints "<hex digest>  <name>" per file ("-" is stdin,
//!                                and stdin is also used when there are no files)
//!     sha256sum --check FILE     reads such lines from FILE and checks each digest
//!
//! Input is hashed in 4 KiB pieces with the streaming interface of `std/hash/sha256`, so
//! memory use does not depend on the size of the file. Exit status: 0 if all went well,
//! 1 if a file could not be read or a digest did not match, 2 on a usage error.
//!
//! Shows: reading through a function parameter (`fn` arguments can use the caller's
//! effects), `Fs.open` with `defer` closing the file, `std/encoding/hex`, error unions,
//! and tests with known vectors.
//!
//! Run it from the examples/ directory:
//!
//!     gamma run sha256sum.gm data/sha-hello.txt data/sha-lines.txt
//!     gamma run sha256sum.gm < data/sha-hello.txt
//!     gamma run sha256sum.gm --check data/sha-sums.txt
//!     gamma test sha256sum.gm
fs :: import "std/fs"
hex :: import "std/encoding/hex"
io :: import "std/io"
sha256 :: import "std/hash/sha256"
str :: import "std/str"

Hex :: [sha256.DIGEST_LEN * 2]u8

// Hashes everything `source` produces, until it returns 0 bytes.
digest_of :: fn(source: fn(buf: []u8) -> IoError!usize) -> IoError!sha256.Digest {
    state := sha256.init()
    buf: [4096]u8 = ---
    while true {
        n := try source(buf[..])
        if n is 0 { break }
        state.update(buf[..n])
    }
    return state.final()
}

digest_stdin :: fn() -> IoError!sha256.Digest needs In => digest_of(fn(b) => In.read(b))

digest_file :: fn(name: string) -> IoError!sha256.Digest needs Fs {
    f := try Fs.open(name, fs.OpenOptions())
    defer f.close()
    return digest_of(fn(b) => f.read_from(b))
}

digest_named :: fn(name: string) -> IoError!sha256.Digest needs Fs + In {
    if name is "-" { return digest_stdin() }
    return digest_file(name)
}

to_hex :: fn(d: ^const sha256.Digest, buf: []u8) -> string => hex.encode(d^[..], buf, false)

// `sha256sum FILE...`: returns true if every file could be read.
sum_files :: fn(names: []const string) -> bool needs Fs + In + Out + Err {
    ok := true
    hbuf: Hex = ---
    for name in names {
        d := digest_named(name) else e => {
            eprint("sha256sum: {}: {}\n", name, io.describe(e))
            ok = false
            continue
        }
        print("{}  {}\n", to_hex(&d, hbuf[..]), name)
    }
    return ok
}

// `sha256sum --check LIST`: returns true if every listed file matches.
check_list :: fn(list_name: string) -> bool needs Fs + Alloc + Out + Err {
    text := fs.read_all(list_name) else e => {
        eprint("sha256sum: {}: could not read the list\n", list_name)
        return false
    }
    defer free(text)

    ok := true
    hbuf: Hex = ---
    for line in str.lines(text) {
        // A line is the digest, two spaces, and the file name.
        parts := str.split_once(line, "  ") else {
            eprint("sha256sum: {}: improperly formatted line\n", list_name)
            ok = false
            continue
        }
        d := digest_file(parts.after) else e => {
            print("{}: FAILED open or read\n", parts.after)
            ok = false
            continue
        }
        if str.eq_ignore_case(to_hex(&d, hbuf[..]), parts.before) {
            print("{}: OK\n", parts.after)
        } else {
            print("{}: FAILED\n", parts.after)
            ok = false
        }
    }
    return ok
}

main :: fn() needs Alloc + Env + Err + Fs + In + Out {
    args := Env.args()[1..]
    success := if args.len is 2 and args[0] is "--check" {
        check_list(args[1])
    } else if args.len >= 1 and args[0].starts_with("--") {
        eprint("usage: sha256sum [FILE...] | --check FILE\n")
        Env.exit(2)
    } else if args.len is 0 {
        sum_files([_]string("-")[..])
    } else {
        sum_files(args)
    }
    if not success { Env.exit(1) }
}

test "known vectors" {
    hbuf: Hex = ---
    empty := sha256.sum("")
    expect_eq(to_hex(&empty, hbuf[..]), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    abc := sha256.sum("abc")
    expect_eq(to_hex(&abc, hbuf[..]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

test "a file is hashed in pieces" {
    // More than one 4 KiB buffer, and not a multiple of the block size.
    data := ok(make(u8, 10_000))
    defer free(data)
    for i in 0..data.len { data[i] = (i % 251).trunc(u8) }
    ok(fs.write_all("/big.bin", data))
    got := ok(digest_file("/big.bin"))
    want := sha256.sum(data)
    expect(got is want)
}

test "stdin is read through the In effect" {
    input := io.StringIn(data: "abc")
    with &input {
        d := ok(digest_stdin())
        hbuf: Hex = ---
        expect_eq(to_hex(&d, hbuf[..]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    }
}

test "a missing file is an error" {
    if !_ := digest_file("/nope") {} else { expect(false) }
}
