//! A precedence-climbing parser from tokens to a tree of tagged unions.
//!
//! Nodes are made with `new`, so they come from whatever allocator is current: the caller
//! installs an arena and frees the whole tree at once.

BinOp :: union { Add, Sub, Mul, Div, Pow }

Expr :: union {
    Num: f64
    Var: (name: string, pos: usize)
    Neg: (operand: ^Expr, pos: usize)
    Bin: (op: BinOp, lhs: ^Expr, rhs: ^Expr, pos: usize)
    Call: (name: string, arg: ^Expr, pos: usize)
}

/// One input line: an expression, optionally stored into `target`.
Stmt :: struct {
    target: ?string
    target_pos: usize
    value: ^Expr
}

Parser :: struct {
    toks: []const Spanned
    i: usize = 0
    /// Column just past the last token, where "unexpected end" is reported.
    end_pos: usize
}

/// Binding strength of an operator; `^` is the tightest and associates to the right.
prec :: fn(op: BinOp) -> u32 => match op {
    .Add, .Sub => 1
    .Mul, .Div => 2
    .Pow => 3
}

binop_of :: fn(t: Token) -> ?BinOp => match t {
    .Plus => BinOp.Add
    .Minus => BinOp.Sub
    .Star => BinOp.Mul
    .Slash => BinOp.Div
    .Caret => BinOp.Pow
    _ => null
}

peek :: fn(p: ^Parser) -> ?Spanned => p.toks.get(p.i)

/// The position of the next token, or of the end of the line.
here :: fn(p: ^Parser) -> usize {
    t := p.peek() else return p.end_pos
    return t.pos
}

node :: fn(e: Expr, pos: usize) -> CalcError!^Expr needs Alloc {
    return new(e) else err => !CalcError(kind: .Memory(err), pos: pos)
}

/// Parses a whole line: `expr` or `name = expr`. Anything left over is an error.
parse :: fn(toks: []const Spanned, end_pos: usize) -> CalcError!Stmt needs Alloc {
    p := Parser(toks: toks, end_pos: end_pos)
    target: ?string = null
    target_pos: usize = 0
    if toks.len >= 2 and toks[1].tok is .Assign {
        target = match toks[0].tok {
            .Ident(s) => s
            _ => return !CalcError(kind: .NotAssignable, pos: toks[0].pos)
        }
        target_pos = toks[0].pos
        p.i = 2
    }
    value := try p.parse_binary(1)
    if t := p.peek() {
        return !CalcError(kind: .UnexpectedToken, pos: t.pos)
    }
    return Stmt(target: target, target_pos: target_pos, value: value)
}

/// Precedence climbing: parse a prefix expression, then keep absorbing operators whose
/// precedence is at least `min_prec`.
parse_binary :: fn(p: ^Parser, min_prec: u32) -> CalcError!^Expr needs Alloc {
    lhs := try p.parse_prefix()
    while t := p.peek() {
        op := binop_of(t.tok) else break
        q := prec(op)
        if q < min_prec { break }
        p.i += 1
        // Left-associative operators demand a strictly tighter right side.
        rhs := try p.parse_binary(if op is .Pow { q } else { q + 1 })
        lhs = try node(Expr.Bin(op: op, lhs: lhs, rhs: rhs, pos: t.pos), t.pos)
    }
    return lhs
}

/// Unary minus binds looser than `^` (so `-2^2` is -4) but tighter than `*`.
parse_prefix :: fn(p: ^Parser) -> CalcError!^Expr needs Alloc {
    t := p.peek() else return !CalcError(kind: .UnexpectedEnd, pos: p.end_pos)
    p.i += 1
    return match t.tok {
        .Num(v) => try node(Expr.Num(v), t.pos)
        .Minus => {
            operand := try p.parse_binary(prec(.Pow))
            try node(Expr.Neg(operand: operand, pos: t.pos), t.pos)
        }
        .LParen => {
            inner := try p.parse_binary(1)
            close := p.peek() else return !CalcError(kind: .UnexpectedEnd, pos: p.end_pos)
            if close.tok is not .RParen {
                return !CalcError(kind: .UnexpectedToken, pos: close.pos)
            }
            p.i += 1
            inner
        }
        .Ident(name) => {
            if next := p.peek() {
                if next.tok is .LParen {
                    p.i += 1
                    arg := try p.parse_binary(1)
                    close := p.peek() else return !CalcError(kind: .UnexpectedEnd, pos: p.end_pos)
                    if close.tok is not .RParen {
                        return !CalcError(kind: .UnexpectedToken, pos: close.pos)
                    }
                    p.i += 1
                    return try node(Expr.Call(name: name, arg: arg, pos: t.pos), t.pos)
                }
            }
            try node(Expr.Var(name: name, pos: t.pos), t.pos)
        }
        _ => return !CalcError(kind: .UnexpectedToken, pos: t.pos)
    }
}
