// core/list: the growable list (§21.5). `List` and `list` are re-exported to
// the universe scope; the other functions are reached as methods.

/// A growable array that keeps the allocator it was created with. `items` holds the
/// elements, so `items.len` is the length and `for x in l.items` iterates.
pub List :: struct(T: type) {
    pub items: []T
    cap: usize
    alloc: Allocator
}

/// An empty list using the current allocator.
pub list :: fn(T: type) -> List(T) needs Alloc => List(T)(items: empty_slice(T), cap: 0, alloc: Alloc.current())

/// Makes room for at least `extra` more elements without further allocation.
pub reserve :: fn(T: type, l: ^List(T), extra: usize) -> AllocError!() {
    n := l.items.len
    if l.cap - n >= extra { return () }
    return regrow(l, extra, empty_slice(T))
}

// Moves the list into a larger block with room for `extra` more elements and appends `tail`
// (which may point into the old block) after the existing ones. The work depends on `T`
// only through its size and alignment, so one function, `regrow_raw`, does it for every
// element type.
regrow :: fn(T: type, l: ^List(T), extra: usize, tail: []const T) -> AllocError!() {
    return regrow_raw(l.cast(^RawList), extra, tail.ptr.cast([^]const u8), tail.len, @size_of(T), @align_of(T))
}

// The layout of every `List(T)`, with the elements seen as bytes: `items.len` is still the
// number of elements.
RawList :: struct {
    items: []u8
    cap: usize
    alloc: Allocator
}

// `regrow` for elements of `size` bytes aligned to `align`; `tail` points to `tail_len` of
// them.
regrow_raw :: fn(l: ^RawList, extra: usize, tail: [^]const u8, tail_len: usize, size: usize, align: usize) -> AllocError!() {
    n := l.items.len
    if extra > @max_value(usize) - n { return !.OutOfMemory }
    new_cap := n + extra
    if l.cap <= @max_value(usize) / 2 and l.cap * 2 > new_cap { new_cap = l.cap * 2 }
    if l.cap is 0 and new_cap < 4 { new_cap = 4 }
    if size > 0 and new_cap > @max_value(usize) / size { return !.OutOfMemory }
    raw := l.alloc.vt.alloc(l.alloc.data, size * new_cap, align) else return !.OutOfMemory
    p := raw
    @copy_elems(p[0..n * size], l.items.ptr[0..n * size])
    @copy_elems(p[n * size..(n + tail_len) * size], tail[0..tail_len * size])
    if l.cap > 0 { l.alloc.vt.free(l.alloc.data, l.items.ptr, size * l.cap, align) }
    l.items = p[0..n]
    l.cap = new_cap
    return ()
}

/// Appends `x`.
pub push :: fn(T: type, l: ^List(T), x: T) -> AllocError!() {
    n := l.items.len
    if l.cap is n { try regrow(l, 1, empty_slice(T)) }
    grown := l.items.ptr[0..n + 1]
    grown[n] = x
    l.items = grown
    return ()
}

/// Appends the elements of `xs`.
pub extend :: fn(T: type, l: ^List(T), xs: []const T) -> AllocError!() {
    n := l.items.len
    if l.cap - n < xs.len {
        // `xs` may be part of the list's own storage: it is copied before that is released.
        try regrow(l, xs.len, xs)
    } else {
        @copy_elems(l.items.ptr[n..n + xs.len], xs)
    }
    l.items = l.items.ptr[0..n + xs.len]
    return ()
}

/// Inserts `x` at index `i`, moving the later elements up; traps if `i` is more than the
/// length (`i` equal to the length appends).
pub insert :: fn(T: type, l: ^List(T), i: usize, x: T) -> AllocError!() {
    if i > l.items.len { trap("insert: index out of bounds") }
    try reserve(l, 1)
    n := l.items.len
    grown := l.items.ptr[0..n + 1]
    @copy_elems(grown[i + 1..n + 1], grown[i..n])
    grown[i] = x
    l.items = grown
    return ()
}

/// Removes and returns the element at index `i`, moving the later elements down. `i` must
/// be less than the length.
pub remove :: fn(T: type, l: ^List(T), i: usize) -> T {
    n := l.items.len
    x := l.items[i]
    @copy_elems(l.items[i..n - 1], l.items[i + 1..n])
    l.items = l.items[0..n - 1]
    return x
}

/// Removes and returns the element at index `i`, moving the last element into its place
/// (constant time, but the order changes). `i` must be less than the length.
pub swap_remove :: fn(T: type, l: ^List(T), i: usize) -> T {
    n := l.items.len
    x := l.items[i]
    l.items[i] = l.items[n - 1]
    l.items = l.items[0..n - 1]
    return x
}

/// Keeps the first `n` elements (all of them if there are fewer).
pub truncate :: fn(T: type, l: ^List(T), n: usize) {
    if n < l.items.len { l.items = l.items[0..n] }
}

/// Removes and returns the last element.
#inline
pub pop :: fn(T: type, l: ^List(T)) -> ?T {
    n := l.items.len
    if n is 0 { return null }
    x := l.items[n - 1]
    l.items = l.items[0..n - 1]
    return x
}

/// Removes every element, keeping the storage.
pub clear :: fn(T: type, l: ^List(T)) {
    l.items = l.items[0..0]
}

/// Frees the list's storage through its own allocator.
pub deinit :: fn(T: type, l: ^List(T)) {
    if l.cap > 0 {
        l.alloc.vt.free(l.alloc.data, l.items.ptr.cast([^]u8), @size_of(T) * l.cap, @align_of(T))
    }
    l.items = empty_slice(T)
    l.cap = 0
}

/// Hands the list's elements to the caller as one allocation that `free` releases under
/// the list's allocator, and leaves the list empty.
pub into_slice :: fn(T: type, l: ^List(T)) -> AllocError![]T {
    n := l.items.len
    if l.cap is 0 { return empty_slice(T) }
    if n is 0 {
        l.deinit()
        return empty_slice(T)
    }
    size := @size_of(T)
    if n < l.cap {
        old := l.items.ptr.cast([^]u8)
        if not l.alloc.vt.resize(l.alloc.data, old, size * l.cap, size * n, @align_of(T)) {
            raw := l.alloc.vt.alloc(l.alloc.data, size * n, @align_of(T)) else return !.OutOfMemory
            p := raw.cast([^]T)
            @copy_elems(p[0..n], l.items)
            l.alloc.vt.free(l.alloc.data, old, size * l.cap, @align_of(T))
            l.items = p[0..n]
        }
    }
    s := l.items.ptr[0..n]
    l.items = empty_slice(T)
    l.cap = 0
    return s
}

/// Appends every value the iterator `it` yields (`l.collect(fn() => m.keys())`).
pub collect :: fn(T: type, l: ^List(T), it: fn() needs Yield(T)) -> AllocError!() {
    for x in it() { try l.push(x) }
    return ()
}

/// Appends formatted text (§21.6.1): `out.write("{}: {}\n", name, n)`.
pub write :: fn(A: type, l: ^List(u8), template :: string, args: ..A) -> AllocError!() {
    failed := false
    @write(fn(b) {
        if not failed {
            l.extend(b) else {
                failed = true
            }
        }
    }, template, ..args)
    if failed { return !.OutOfMemory }
    return ()
}
