// core/map: the hash map (§21.5). `HashMap`, `hash_map` and `hash_map_with` are
// re-exported to the universe scope; the other functions are reached as methods.
//
// The table uses open addressing with linear probing over a power-of-two
// number of slots. Removed entries leave a tombstone until the next growth.

/// One slot of the table: empty, full, or a tombstone.
Slot :: struct(K, V: type) {
    state: u8
    key: K
    value: V
}

EMPTY :: 0
FULL :: 1
REMOVED :: 2

/// The seed every map starts with (any fixed odd constant spreads well).
SEED :: 0x9e3779b97f4a7c15

/// A map from `K` to `V`. `hash` and `eq` default to `@hash` and `is`.
pub HashMap :: struct(K, V: type,
                      hash: ?^fn(key: ^const K, seed: u64) -> u64 = null,
                      eq: ?^fn(a, b: ^const K) -> bool = null) {
    slots: []Slot(K, V)
    count: usize
    used: usize
    seed: u64
    alloc: Allocator
}

/// An empty map using `@hash` and `is`, and the current allocator.
pub hash_map :: fn(K, V: type) -> HashMap(K, V) needs Alloc where Eq(K) {
    return HashMap(K, V)(slots: empty_slice(Slot(K, V)), count: 0, used: 0, seed: SEED, alloc: Alloc.current())
}

/// An empty map using the given hash and equality functions, and the current allocator.
pub hash_map_with :: fn(K, V: type,
    hash :: ^fn(key: ^const K, seed: u64) -> u64,
    eq :: ^fn(a, b: ^const K) -> bool) -> HashMap(K, V, hash, eq) needs Alloc {
    return HashMap(K, V, hash, eq)(slots: empty_slice(Slot(K, V)), count: 0, used: 0, seed: SEED, alloc: Alloc.current())
}

key_hash :: fn(K: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, k: ^const K, seed: u64) -> u64 {
    if f := hash { return f(k, seed) }
    return @hash(k^, seed)
}

key_eq :: fn(K: type, eq :: ?^fn(a, b: ^const K) -> bool, a, b: ^const K) -> bool {
    if f := eq { return f(a, b) }
    return a^ is b^
}

/// The index of the slot holding `k`.
find :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
           m: ^const HashMap(K, V, hash, eq), k: ^const K) -> ?usize {
    n := m.slots.len
    if n is 0 { return null }
    i := key_hash(hash, k, m.seed).trunc(usize) & (n - 1)
    while true {
        s := &m.slots[i]
        if s.state is EMPTY { return null }
        if s.state is FULL and key_eq(eq, &s.key, k) { return i }
        i = (i + 1) & (n - 1)
    }
}

/// Stores a key known to be absent; there must be a free slot.
insert_new :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                 m: ^HashMap(K, V, hash, eq), k: ^const K, v: ^const V) {
    n := m.slots.len
    i := key_hash(hash, k, m.seed).trunc(usize) & (n - 1)
    while m.slots[i].state is FULL { i = (i + 1) & (n - 1) }
    if m.slots[i].state is EMPTY { m.used += 1 }
    m.slots[i] = Slot(K, V)(state: FULL, key: k^, value: v^)
    m.count += 1
}

/// Doubles the table (or creates it) and drops tombstones; a table at most half full of live
/// entries is rehashed at the same size instead, so memory follows the live entries.
grow :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
           m: ^HashMap(K, V, hash, eq)) -> AllocError!() {
    old := m.slots
    n := if old.len is 0 { 8 } else if m.count * 2 <= old.len { old.len } else { old.len * 2 }
    size := @size_of(Slot(K, V))
    align := @align_of(Slot(K, V))
    raw := m.alloc.vt.alloc(m.alloc.data, size * n, align) else return !.OutOfMemory
    slots := raw.cast([^]Slot(K, V))[0..n]
    for i in 0..n { slots[i].state = EMPTY }
    m.slots = slots
    m.count = 0
    m.used = 0
    for i in 0..old.len {
        if old[i].state is FULL { m.insert_new(&old[i].key, &old[i].value) }
    }
    if old.len > 0 {
        m.alloc.vt.free(m.alloc.data, old.ptr.cast([^]u8), size * old.len, align)
    }
    return ()
}

/// Sets the value of `k`, adding it if absent.
pub put :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
              m: ^HashMap(K, V, hash, eq), k: K, v: V) -> AllocError!() {
    if i := m.find(&k) {
        m.slots[i].value = v
        return ()
    }
    if (m.used + 1) * 4 > m.slots.len * 3 { try m.grow() }
    m.insert_new(&k, &v)
    return ()
}

/// The value of `k`, if present.
pub get :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
              m: ^const HashMap(K, V, hash, eq), k: K) -> ?V {
    i := m.find(&k) else return null
    return m.slots[i].value
}

/// A pointer to the value stored for `k`, if present, so it can be read or updated in
/// place. It is valid until the next insertion or removal.
pub get_ptr :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                  m: ^HashMap(K, V, hash, eq), k: K) -> ?^V {
    i := m.find(&k) else return null
    return &m.slots[i].value
}

/// Where `entry` found or stored a key: pointers to the stored key and value, valid until
/// the next insertion or removal, and whether the key was already present.
pub Entry :: struct(K, V: type) {
    pub key: ^K
    pub value: ^V
    pub found: bool
}

/// The entry for `k`, first storing `k` and `default` if `k` is absent. When it was absent
/// (`found` is false), the stored key may be replaced by an equal one, such as a copy the
/// map should own: `if not e.found { e.key^ = try dupe(word) }`.
pub entry :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                m: ^HashMap(K, V, hash, eq), k: K, default: V) -> AllocError!Entry(K, V) {
    if i := m.find(&k) { return Entry(K, V)(key: &m.slots[i].key, value: &m.slots[i].value, found: true) }
    if (m.used + 1) * 4 > m.slots.len * 3 { try m.grow() }
    m.insert_new(&k, &default)
    i := m.find(&k) else trap("unreachable: the key was just inserted")
    return Entry(K, V)(key: &m.slots[i].key, value: &m.slots[i].value, found: false)
}

/// Whether `k` is present.
pub contains :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                   m: ^const HashMap(K, V, hash, eq), k: K) -> bool {
    return m.find(&k) is not null
}

/// Removes `k`, returning its value if it was present.
pub remove :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                 m: ^HashMap(K, V, hash, eq), k: K) -> ?V {
    i := m.find(&k) else return null
    m.slots[i].state = REMOVED
    m.count -= 1
    return m.slots[i].value
}

/// Removes `k`, returning the stored key and its value if it was present, so that a key
/// the map owned can be released.
pub remove_entry :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                       m: ^HashMap(K, V, hash, eq), k: K) -> ?(key: K, value: V) {
    i := m.find(&k) else return null
    m.slots[i].state = REMOVED
    m.count -= 1
    return (key: m.slots[i].key, value: m.slots[i].value)
}

/// The number of entries.
pub len :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
              m: ^const HashMap(K, V, hash, eq)) -> usize {
    return m.count
}

/// The entries, in an unspecified order. The map must not change during the iteration.
pub entries :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                  m: ^const HashMap(K, V, hash, eq)) needs Yield((key: K, value: V)) {
    for i in 0..m.slots.len {
        s := m.slots[i]
        if s.state is FULL { yield((key: s.key, value: s.value)) }
    }
}

/// The keys, in the order of `entries`. The map must not change during the iteration.
pub keys :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
               m: ^const HashMap(K, V, hash, eq)) needs Yield(K) {
    for i in 0..m.slots.len {
        if m.slots[i].state is FULL { yield(m.slots[i].key) }
    }
}

/// The values, in the order of `entries`. The map must not change during the iteration.
pub values :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                 m: ^const HashMap(K, V, hash, eq)) needs Yield(V) {
    for i in 0..m.slots.len {
        if m.slots[i].state is FULL { yield(m.slots[i].value) }
    }
}

/// Removes every entry, keeping the storage.
pub clear :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                m: ^HashMap(K, V, hash, eq)) {
    for i in 0..m.slots.len { m.slots[i].state = EMPTY }
    m.count = 0
    m.used = 0
}

/// Frees the map's storage through its own allocator.
pub deinit :: fn(K, V: type, hash :: ?^fn(key: ^const K, seed: u64) -> u64, eq :: ?^fn(a, b: ^const K) -> bool,
                 m: ^HashMap(K, V, hash, eq)) {
    if m.slots.len > 0 {
        size := @size_of(Slot(K, V))
        m.alloc.vt.free(m.alloc.data, m.slots.ptr.cast([^]u8), size * m.slots.len, @align_of(Slot(K, V)))
    }
    m.slots = empty_slice(Slot(K, V))
    m.count = 0
    m.used = 0
}
