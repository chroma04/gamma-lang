// The core prelude: declarations of the core library (spec §21) that are
// written in Gamma. Its public names are visible in every module without an
// import, as part of the universe scope (§21.1).

/// Standard output (§12.9, §21.7).
pub Out :: effect {
    write_out: fn(bytes: []const u8)
}

/// Standard error (§12.9, §21.7).
pub Err :: effect {
    write_err: fn(bytes: []const u8)
}

/// Operations that escape Gamma's model: foreign calls, `#global` storage and
/// the like (§12.10). It has no operations and cannot be handled.
pub Sys :: effect {}

/// The iteration effect (§13.1): an iterator is any function that performs it.
pub Yield :: effect(T: type) {
    yield: esc(x: T)
}

/// Command-line arguments, environment variables and process exit (§12.9, §21.7).
pub Env :: effect {
    args: fn() -> []const string
    var: fn(name: string) -> ?string
    exit: esc(code: u8) -> never
}

/// Why an input or output operation failed (§21.7).
pub IoError :: union {
    NotFound, PermissionDenied, AlreadyExists, WouldBlock, Interrupted,
    BrokenPipe, ConnectionReset, InvalidInput, UnexpectedEof, NoSpace,
    Other: i32                                  // OS error code
}

/// Standard input (§12.9, §21.7): `read` returns 0 at the end of the input.
pub In :: effect {
    read: fn(buf: []u8) -> IoError!usize
}

/// A point in time on a monotonic clock, since an unspecified epoch.
pub Instant :: struct { pub ns: u64 }

/// A length of time.
pub Duration :: struct { pub ns: u64 }

/// Time (§12.9, §21.7): `wall` gives Unix time in nanoseconds.
pub Clock :: effect {
    now: fn() -> Instant
    wall: fn() -> i64
    sleep: fn(d: Duration)
}

/// Random bytes (§12.9, §21.7).
pub Rand :: effect {
    fill: fn(buf: []u8)
}

/// An open file (§21.7).
pub File :: struct { handle: i64 }

/// An open directory, for listing its entries.
pub Dir :: struct { handle: i64 }

/// How `open` opens a file. The default opens an existing file for reading.
pub OpenOptions :: struct {
    pub read: bool = true
    pub write: bool = false
    pub append: bool = false        // every write goes to the end
    pub create: bool = false        // create the file if it does not exist
    pub truncate: bool = false      // empty the file
    pub exclusive: bool = false     // create the file; fail if it exists
}

/// What `stat` reports about a file or directory.
pub FileInfo :: struct {
    pub size: u64
    pub is_dir: bool
    pub modified: i64               // Unix time in nanoseconds
}

/// Where `seek` measures its offset from.
pub SeekFrom :: union { Start, Current, End }

/// The file system (§12.9, §21.7). Paths are byte strings, relative to the working
/// directory unless absolute.
pub Fs :: effect {
    open: fn(path: string, opts: OpenOptions) -> IoError!File
    close: fn(f: File)
    read_from: fn(f: File, buf: []u8) -> IoError!usize          // 0 at the end of the file
    write_to: fn(f: File, bytes: []const u8) -> IoError!usize   // may write fewer bytes
    seek: fn(f: File, offset: i64, from: SeekFrom) -> IoError!u64
    stat: fn(path: string) -> IoError!FileInfo
    remove: fn(path: string) -> IoError!()
    rename: fn(from, to: string) -> IoError!()
    make_dir: fn(path: string) -> IoError!()
    remove_dir: fn(path: string) -> IoError!()                  // the directory must be empty
    open_dir: fn(path: string) -> IoError!Dir
    next_entry: fn(d: Dir, buf: []u8) -> IoError!usize         // a name into buf; 0 after the last
    close_dir: fn(d: Dir)
}

/// `n` nanoseconds.
pub ns :: fn(n: u64) -> Duration => Duration(ns: n)
/// `n` microseconds.
pub us :: fn(n: u64) -> Duration => Duration(ns: n * 1_000)
/// `n` milliseconds.
pub ms :: fn(n: u64) -> Duration => Duration(ns: n * 1_000_000)
/// `n` seconds.
pub secs :: fn(n: u64) -> Duration => Duration(ns: n * 1_000_000_000)

/// The time from `earlier` to `i` (checked: `earlier` must not be later).
pub since :: fn(i: Instant, earlier: Instant) -> Duration => Duration(ns: i.ns - earlier.ns)
/// The instant `d` after `i`.
pub after :: fn(i: Instant, d: Duration) -> Instant => Instant(ns: i.ns + d.ns)
/// The sum of two durations.
pub plus :: fn(d: Duration, e: Duration) -> Duration => Duration(ns: d.ns + e.ns)
/// `d` less `e` (checked: `e` must not be longer).
pub minus :: fn(d: Duration, e: Duration) -> Duration => Duration(ns: d.ns - e.ns)
/// The whole milliseconds in `d`.
pub to_ms :: fn(d: Duration) -> u64 => d.ns / 1_000_000

// The default handlers of `In`, `Clock` and `Rand` (§12.9), installed around `main`.

SystemIo :: struct {}

/// The result of a system read or write: a count, or an error code.
io_result :: fn(n: i64) -> IoError!usize {
    if n >= 0 { return n.trunc(usize) }
    if n <= -1000 { return !.Other((-1000 - n).trunc(i32)) }
    e: IoError = match -1 - n {
        0 => .NotFound
        1 => .PermissionDenied
        2 => .AlreadyExists
        3 => .WouldBlock
        4 => .Interrupted
        5 => .BrokenPipe
        6 => .ConnectionReset
        7 => .InvalidInput
        8 => .UnexpectedEof
        _ => .NoSpace
    }
    return !e
}

handler In for SystemIo {
    read(self, buf) => io_result(@sys_read(buf))
}

handler Clock for SystemIo {
    now(self) => Instant(ns: @clock_now())
    wall(self) => @clock_wall()
    sleep(self, d) => @clock_sleep(d.ns)
}

handler Rand for SystemIo {
    fill(self, buf) => @rand_fill(buf)
}

/// The result of a system call that produces nothing.
io_unit :: fn(n: i64) -> IoError!() {
    _ = try io_result(n)
    return ()
}

handler Fs for SystemIo {
    open(self, path, o) => {
        flags: u32 = 0
        if o.read { flags |= 1 }
        if o.write { flags |= 2 }
        if o.append { flags |= 4 }
        if o.create { flags |= 8 }
        if o.truncate { flags |= 16 }
        if o.exclusive { flags |= 32 }
        h := try io_result(@fs_open(path, flags))
        return File(handle: h.trunc(i64))
    }
    close(self, f) => { _ = @fs_close(f.handle) }
    read_from(self, f, buf) => io_result(@fs_read(f.handle, buf))
    write_to(self, f, bytes) => io_result(@fs_write(f.handle, bytes))
    seek(self, f, offset, from) => {
        n := try io_result(@fs_seek(f.handle, offset, from.tag().trunc(u32)))
        return n.trunc(u64)
    }
    stat(self, path) => {
        out: [3]i64 = ---
        _ = try io_result(@fs_stat(path, out[..]))
        return FileInfo(size: out[0].trunc(u64), is_dir: out[1] is 1, modified: out[2])
    }
    remove(self, path) => io_unit(@fs_remove(path))
    rename(self, from, to) => io_unit(@fs_rename(from, to))
    make_dir(self, path) => io_unit(@fs_make_dir(path))
    remove_dir(self, path) => io_unit(@fs_remove_dir(path))
    open_dir(self, path) => {
        h := try io_result(@fs_open_dir(path))
        return Dir(handle: h.trunc(i64))
    }
    next_entry(self, d, buf) => io_result(@fs_next_entry(d.handle, buf))
    close_dir(self, d) => { _ = @fs_close_dir(d.handle) }
}

system_io :: fn() -> SystemIo => SystemIo()

// Standard iterators (§13.3, §21.4).

/// The integers `lo, lo + 1, …, hi - 1`.
pub range :: fn(T: type, lo, hi: T) \ {Yield(T)} where Int(T) {
    i := lo
    while i < hi {
        yield(i)
        i += 1
    }
}

/// The integers `lo, …, hi`, without overflowing at `hi`; nothing if `lo > hi`.
pub range_incl :: fn(T: type, lo, hi: T) \ {Yield(T)} where Int(T) {
    if lo > hi { return }
    i := lo
    while true {
        yield(i)
        if i is hi { return }
        i += 1
    }
}

/// The elements of `xs`, in order.
pub each :: fn(T: type, xs: []const T) \ {Yield(T)} {
    for x in xs { yield(x) }
}

/// Pointers to the elements of `xs`, for modifying them in place.
pub each_ptr :: fn(T: type, xs: []T) \ {Yield(^T)} {
    i: usize = 0
    while i < xs.len {
        yield(&xs[i])
        i += 1
    }
}

/// Each element with its index.
pub enumerate :: fn(T: type, xs: []const T) \ {Yield((i: usize, x: T))} {
    i: usize = 0
    for x in xs {
        yield((i: i, x: x))
        i += 1
    }
}

/// The elements of `xs`, last to first.
pub reversed :: fn(T: type, xs: []const T) \ {Yield(T)} {
    i := xs.len
    while i > 0 {
        i -= 1
        yield(xs[i])
    }
}

/// The bytes of a string.
pub bytes :: fn(s: string) \ {Yield(u8)} {
    for b in s { yield(b) }
}

/// A Unicode code point.
pub rune :: u32

/// The code points of the UTF-8 text `s`. Each maximal ill-formed subsequence
/// becomes one U+FFFD REPLACEMENT CHARACTER, as in the Unicode Standard (§3.9).
pub runes :: fn(s: string) \ {Yield(rune)} {
    i: usize = 0
    while i < s.len {
        b := s[i]
        if b < 0x80 {
            yield(rune(b))
            i += 1
            continue
        }
        // The number of continuation bytes, and the range of the first of them.
        n: usize = 0
        lo: u8 = 0x80
        hi: u8 = 0xbf
        c: rune = 0
        if b >= 0xc2 and b <= 0xdf {
            n = 1
            c = rune(b & 0x1f)
        } else if b >= 0xe0 and b <= 0xef {
            n = 2
            c = rune(b & 0x0f)
            if b is 0xe0 { lo = 0xa0 }
            if b is 0xed { hi = 0x9f }
        } else if b >= 0xf0 and b <= 0xf4 {
            n = 3
            c = rune(b & 0x07)
            if b is 0xf0 { lo = 0x90 }
            if b is 0xf4 { hi = 0x8f }
        } else {
            yield(0xfffd)
            i += 1
            continue
        }
        k: usize = 1
        while k <= n {
            if i + k >= s.len { break }
            d := s[i + k]
            if d < lo or d > hi { break }
            c = (c << 6) | rune(d & 0x3f)
            lo = 0x80
            hi = 0xbf
            k += 1
        }
        if k > n {
            yield(c)
        } else {
            yield(0xfffd)
        }
        i += k
    }
}

// Allocation (§15.2, §21.2).

/// Allocation failure.
pub AllocError :: union { OutOfMemory }

/// The operations of an allocator.
pub AllocVtable :: struct {
    pub alloc:  ^fn(data: rawptr, size, align: usize) -> ?[^]u8
    pub resize: ^fn(data: rawptr, p: [^]u8, old, new, align: usize) -> bool
    pub free:   ^fn(data: rawptr, p: [^]u8, size, align: usize)
}

/// A first-class handle to an allocator.
pub Allocator :: struct {
    pub data: rawptr
    pub vt:   ^const AllocVtable
}

/// The current allocator.
pub Alloc :: effect {
    current: fn() -> Allocator
}

/// An `Allocator` value is a handler for `Alloc`: `with arena.allocator() { … }`.
handler Alloc for Allocator {
    current(self) => self
}

heap_alloc :: fn(data: rawptr, size, align: usize) -> ?[^]u8 => @heap_alloc(size, align)

heap_resize :: fn(data: rawptr, p: [^]u8, old, new, align: usize) -> bool => false

heap_free :: fn(data: rawptr, p: [^]u8, size, align: usize) {
    @heap_free(p, size, align)
}

HEAP :: AllocVtable(alloc: heap_alloc, resize: heap_resize, free: heap_free)

/// The system heap; the default `Alloc` handler of `main`.
pub heap_allocator :: fn() -> Allocator => Allocator(data: &HEAP, vt: &HEAP)

/// An empty slice: a non-null, suitably aligned pointer that must not be dereferenced (§5.7).
empty_slice :: fn(T: type) -> []T {
    p := @align_of(T).to_ptr([^]T)?
    return p[0..0]
}

/// A new object holding `init`.
pub new :: fn(T: type, init: T) -> AllocError!^T \ {Alloc} {
    a := current()
    raw := a.vt.alloc(a.data, @size_of(T), @align_of(T)) else return !.OutOfMemory
    p := raw.cast(^T)
    p^ = init
    return p
}

/// `n` objects of plain data, uninitialized.
pub make :: fn(T: type, n: usize) -> AllocError![]T \ {Alloc} where Plain(T) {
    if n is 0 { return empty_slice(T) }
    a := current()
    raw := a.vt.alloc(a.data, @size_of(T) * n, @align_of(T)) else return !.OutOfMemory
    return raw.cast([^]T)[0..n]
}

/// `n` objects of plain data, uninitialized, at an address that is a multiple of
/// `align` (a power of two; at least the type's own alignment is used).
pub make_aligned :: fn(T: type, n: usize, align: usize) -> AllocError![]T \ {Alloc} where Plain(T) {
    if n is 0 { return empty_slice(T) }
    a := current()
    raw := a.vt.alloc(a.data, @size_of(T) * n, align.max(@align_of(T))) else return !.OutOfMemory
    return raw.cast([^]T)[0..n]
}

/// `n` copies of `x`.
pub make_fill :: fn(T: type, n: usize, x: T) -> AllocError![]T \ {Alloc} {
    if n is 0 { return empty_slice(T) }
    a := current()
    raw := a.vt.alloc(a.data, @size_of(T) * n, @align_of(T)) else return !.OutOfMemory
    s := raw.cast([^]T)[0..n]
    for i in 0..n { s[i] = x }
    return s
}

/// Releases a slice obtained from `make` or `make_fill` under the current allocator.
pub free :: fn(T: type, s: []T) \ {Alloc} {
    if s.len is 0 { return }
    a := current()
    a.vt.free(a.data, s.ptr.cast([^]u8), @size_of(T) * s.len, @align_of(T))
}

/// Releases an object obtained from `new` under the current allocator.
pub destroy :: fn(T: type, p: ^T) \ {Alloc} {
    a := current()
    a.vt.free(a.data, p.cast([^]u8), @size_of(T), @align_of(T))
}

/// Where a piece of source code is (§21.7): the result of `@location()`.
pub SourceLocation :: struct {
    pub file: string
    pub line, column: u32
    pub function: string
}

// Running tests (§3.8, §12.9): `gamma test` calls `run_test` or `run_test_unit`
// for each test. The test's allocations go through a tracking allocator, and
// memory still allocated when the test ends fails it.

TestTracker :: struct {
    live: usize
    inner: Allocator
}

track_alloc :: fn(data: rawptr, size, align: usize) -> ?[^]u8 {
    t := data.cast(^TestTracker)
    p := t.inner.vt.alloc(t.inner.data, size, align) else return null
    t.live += size
    return p
}

track_resize :: fn(data: rawptr, p: [^]u8, old, new, align: usize) -> bool => false

track_free :: fn(data: rawptr, p: [^]u8, size, align: usize) {
    t := data.cast(^TestTracker)
    t.live -= size
    t.inner.vt.free(t.inner.data, p, size, align)
}

TRACKING :: AllocVtable(alloc: track_alloc, resize: track_resize, free: track_free)

leaked :: fn(t: ^TestTracker) -> u8 \ {Err} {
    if t.live is 0 { return 0 }
    eprint("leaked {} bytes\n", t.live)
    return 1
}

// The test handlers of `In`, `Clock` and `Rand` (§12.9): empty input, a fake clock that
// `sleep` advances, and a generator with a fixed seed.

TestIo :: struct {
    clock: u64
    seed: u64
    fs: MemFs
}

/// The test handler's wall-clock time, in Unix nanoseconds.
test_wall :: fn(io: ^TestIo) -> i64 => 1_700_000_000_000_000_000 + io.clock.trunc(i64)

handler In for ^TestIo {
    read(self, buf) => 0
}

handler Clock for ^TestIo {
    now(self) => Instant(ns: self.clock)
    wall(self) => test_wall(self)
    sleep(self, d) => { self.clock += d.ns }
}

handler Rand for ^TestIo {
    fill(self, buf) => {
        // splitmix64
        for i in 0..buf.len {
            self.seed +%= 0x9e3779b97f4a7c15
            z := self.seed
            z = (z ~ (z >> 30)) *% 0xbf58476d1ce4e5b9
            z = (z ~ (z >> 27)) *% 0x94d049bb133111eb
            buf[i] = (z ~ (z >> 31)).trunc(u8)
        }
    }
}

// The test handler of `Fs` (§12.9): an in-memory file system. Every test starts with
// a fresh, empty one, and it is freed when the test ends.
//
// The file system is a table of nodes (files and directories). A node knows its parent
// and its name, so a directory's children are the linked nodes that name it as their
// parent, and `rename` only changes those two fields. Open files and directories are
// tables of handles that refer to nodes; a handle is its index plus one and is never
// reused, so a closed or unknown handle always fails. A removed node lives on until the
// last handle to it is closed, as on POSIX. All storage comes from the system heap, not
// from the test's tracking allocator, so it does not count as a leak.
//
// Paths are split at `/`; empty components and `.` are ignored (so a leading `/` is
// accepted and means the root, and `a//b/./c` is `a/b/c`) and `..` is rejected with
// `InvalidInput`. Errors other than the portable `IoError` variants are the Linux errno
// values, as with the real file system: 9 (EBADF) for a closed handle or an operation the
// handle's mode does not allow, 16 (EBUSY) for the root directory, 20 (ENOTDIR) for a file
// used as a directory, 21 (EISDIR) for a directory used as a file (also for `remove`,
// which never removes directories), and 39 (ENOTEMPTY) for removing or replacing a
// directory that has entries.

MemNode :: struct {
    used: bool              // the slot holds a node
    linked: bool            // reachable by path
    is_dir: bool
    parent: usize           // the root is its own parent
    opens: usize            // open handles
    modified: i64
    name: List(u8)
    data: List(u8)          // the contents of a file
}

MemOpen :: struct {
    open: bool
    node: usize
    pos: u64
    can_read, can_write, append: bool
}

MemDir :: struct {
    open: bool
    node: usize
    next: usize             // the next node slot to look at
}

MemFs :: struct {
    alloc: Allocator
    nodes: List(MemNode)    // node 0 is the root
    files: List(MemOpen)
    dirs: List(MemDir)
}

/// The largest file, so that a wild `seek` and `write` cannot exhaust the memory.
MEM_FILE_MAX :: 1 << 30

/// An empty file system, holding just the root directory.
mem_fs :: fn() -> MemFs {
    a := heap_allocator()
    m := with a {
        MemFs(alloc: a, nodes: list(MemNode), files: list(MemOpen), dirs: list(MemDir))
    }
    _ = new_node(&m, true, 0, "", 0)
    return m
}

/// Frees everything.
mem_fs_free :: fn(m: ^MemFs) {
    for i in 0..m.nodes.items.len {
        if m.nodes.items[i].used { release(m, i) }
    }
    m.nodes.deinit()
    m.files.deinit()
    m.dirs.deinit()
}

/// Adds a node named `name` in `parent`; its id.
new_node :: fn(m: ^MemFs, is_dir: bool, parent: usize, name: string, now: i64) -> IoError!usize {
    a := m.alloc
    node := with a {
        MemNode(used: true, linked: true, is_dir: is_dir, parent: parent, opens: 0, modified: now,
                name: list(u8), data: list(u8))
    }
    if not fill_name(&node.name, name) { return !.NoSpace }
    i: usize = 0
    while i < m.nodes.items.len {
        if not m.nodes.items[i].used { break }
        i += 1
    }
    if i < m.nodes.items.len {
        m.nodes.items[i] = node
        return i
    }
    if !e := m.nodes.push(node) {
        node.name.deinit()
        node.data.deinit()
        return !.NoSpace
    }
    return i
}

/// Copies `name` into the empty list `l`; on failure frees `l` and returns false.
fill_name :: fn(l: ^List(u8), name: string) -> bool {
    for b in name {
        if !e := l.push(b) {
            l.deinit()
            return false
        }
    }
    return true
}

/// Frees a node's storage and its slot.
release :: fn(m: ^MemFs, id: usize) {
    n := &m.nodes.items[id]
    n.name.deinit()
    n.data.deinit()
    n.used = false
    n.linked = false
}

/// Removes a node from its directory; it is freed once no handle refers to it.
unlink :: fn(m: ^MemFs, id: usize) {
    n := &m.nodes.items[id]
    n.linked = false
    if n.opens is 0 { release(m, id) }
}

same_bytes :: fn(a, b: []const u8) -> bool {
    if a.len is not b.len { return false }
    for i in 0..a.len {
        if a[i] is not b[i] { return false }
    }
    return true
}

/// The linked child of directory `dir` called `name`.
find_child :: fn(m: ^MemFs, dir: usize, name: string) -> ?usize {
    for i in 1..m.nodes.items.len {
        n := &m.nodes.items[i]
        if n.used and n.linked and n.parent is dir and same_bytes(n.name.items, name) { return i }
    }
    return null
}

has_children :: fn(m: ^MemFs, dir: usize) -> bool {
    for i in 1..m.nodes.items.len {
        n := &m.nodes.items[i]
        if n.used and n.linked and n.parent is dir { return true }
    }
    return false
}

/// The next component of `path` at or after `pos`, skipping empty ones and `.`.
next_component :: fn(path: string, pos: ^usize) -> ?string {
    i := pos^
    while i < path.len {
        while i < path.len and path[i] is '/' { i += 1 }
        start := i
        while i < path.len and path[i] is not '/' { i += 1 }
        c := path[start..i]
        if c.len is 0 or (c.len is 1 and c[0] is '.') { continue }
        pos^ = i
        return c
    }
    pos^ = i
    return null
}

is_dot_dot :: fn(c: string) -> bool => c.len is 2 and c[0] is '.' and c[1] is '.'

/// The node a path names.
resolve :: fn(m: ^MemFs, path: string) -> IoError!usize {
    cur: usize = 0
    pos: usize = 0
    while true {
        c := next_component(path, &pos) else break
        if is_dot_dot(c) { return !.InvalidInput }
        if not m.nodes.items[cur].is_dir { return !.Other(20) }
        cur = find_child(m, cur, c) else return !.NotFound
    }
    return cur
}

/// Where a path would be: the directory that holds it and its name there. The root has
/// neither (`root` is true).
MemPath :: struct {
    parent: usize
    name: string
    root: bool
}

resolve_parent :: fn(m: ^MemFs, path: string) -> IoError!MemPath {
    cur: usize = 0
    pos: usize = 0
    pending: ?string = null
    while true {
        c := next_component(path, &pos) else break
        if is_dot_dot(c) { return !.InvalidInput }
        if p := pending {
            if not m.nodes.items[cur].is_dir { return !.Other(20) }
            cur = find_child(m, cur, p) else return !.NotFound
        }
        pending = c
    }
    name := pending else return MemPath(parent: 0, name: "", root: true)
    if not m.nodes.items[cur].is_dir { return !.Other(20) }
    return MemPath(parent: cur, name: name, root: false)
}

touch :: fn(m: ^MemFs, id: usize, now: i64) {
    m.nodes.items[id].modified = now
}

/// `open`. A directory can be opened for reading only; reading it then fails with
/// EISDIR. Like POSIX, an access mode with neither `write` nor `append` is read-only.
mem_open :: fn(m: ^MemFs, path: string, o: OpenOptions, now: i64) -> IoError!File {
    p := try resolve_parent(m, path)
    id: usize = 0
    if not p.root {
        if existing := find_child(m, p.parent, p.name) {
            if o.exclusive { return !.AlreadyExists }
            id = existing
        } else {
            if not (o.create or o.exclusive) { return !.NotFound }
            id = try new_node(m, false, p.parent, p.name, now)
            touch(m, p.parent, now)
        }
    } else if o.exclusive {
        return !.AlreadyExists
    }
    wr := o.write or o.append
    node := &m.nodes.items[id]
    if node.is_dir and (wr or o.truncate) { return !.Other(21) }
    if o.truncate {
        node.data.clear()
        node.modified = now
    }
    h := MemOpen(open: true, node: id, pos: 0, can_read: o.read or not wr, can_write: wr, append: o.append)
    m.files.push(h) else return !.NoSpace
    node.opens += 1
    return File(handle: m.files.items.len.trunc(i64))
}

mem_close :: fn(m: ^MemFs, f: File) {
    p := get_open(m, f) else return
    p.open = false
    n := &m.nodes.items[p.node]
    n.opens -= 1
    if not n.linked and n.opens is 0 { release(m, p.node) }
}

get_open :: fn(m: ^MemFs, f: File) -> IoError!^MemOpen {
    if f.handle < 1 or f.handle > m.files.items.len.trunc(i64) { return !.Other(9) }
    p := &m.files.items[(f.handle - 1).trunc(usize)]
    if not p.open { return !.Other(9) }
    return p
}

mem_read :: fn(m: ^MemFs, f: File, buf: []u8) -> IoError!usize {
    p := try get_open(m, f)
    if not p.can_read { return !.Other(9) }
    n := &m.nodes.items[p.node]
    if n.is_dir { return !.Other(21) }
    size := n.data.items.len
    if p.pos >= size.trunc(u64) { return 0 }
    start := p.pos.trunc(usize)
    count := buf.len.min(size - start)
    buf[0..count].copy_from(n.data.items[start..start + count])
    p.pos += count.trunc(u64)
    return count
}

mem_write :: fn(m: ^MemFs, f: File, bytes: []const u8, now: i64) -> IoError!usize {
    p := try get_open(m, f)
    if not p.can_write { return !.Other(9) }
    n := &m.nodes.items[p.node]
    if p.append { p.pos = n.data.items.len.trunc(u64) }
    if bytes.len is 0 { return 0 }
    if p.pos > MEM_FILE_MAX or bytes.len > MEM_FILE_MAX - p.pos.trunc(usize) { return !.NoSpace }
    start := p.pos.trunc(usize)
    // Seeking past the end and writing leaves a gap of zeros.
    while n.data.items.len < start {
        n.data.push(0) else return !.NoSpace
    }
    written: usize = 0
    while written < bytes.len {
        at := start + written
        if at < n.data.items.len {
            n.data.items[at] = bytes[written]
        } else {
            n.data.push(bytes[written]) else break
        }
        written += 1
    }
    if written is 0 { return !.NoSpace }
    p.pos += written.trunc(u64)
    n.modified = now
    return written
}

mem_seek :: fn(m: ^MemFs, f: File, offset: i64, from: SeekFrom) -> IoError!u64 {
    p := try get_open(m, f)
    base: i64 = match from {
        .Start => 0
        .Current => p.pos.trunc(i64)
        .End => m.nodes.items[p.node].data.items.len.trunc(i64)
    }
    target := base +? offset else return !.InvalidInput
    if target < 0 { return !.InvalidInput }
    p.pos = target.trunc(u64)
    return p.pos
}

mem_stat :: fn(m: ^MemFs, path: string) -> IoError!FileInfo {
    n := &m.nodes.items[try resolve(m, path)]
    return FileInfo(size: n.data.items.len.trunc(u64), is_dir: n.is_dir, modified: n.modified)
}

mem_remove :: fn(m: ^MemFs, path: string, now: i64) -> IoError!() {
    id := try resolve(m, path)
    if m.nodes.items[id].is_dir { return !.Other(21) }
    touch(m, m.nodes.items[id].parent, now)
    unlink(m, id)
    return ()
}

mem_make_dir :: fn(m: ^MemFs, path: string, now: i64) -> IoError!() {
    p := try resolve_parent(m, path)
    if p.root { return !.AlreadyExists }
    if find_child(m, p.parent, p.name) is not null { return !.AlreadyExists }
    _ = try new_node(m, true, p.parent, p.name, now)
    touch(m, p.parent, now)
    return ()
}

mem_remove_dir :: fn(m: ^MemFs, path: string, now: i64) -> IoError!() {
    id := try resolve(m, path)
    if id is 0 { return !.Other(16) }
    if not m.nodes.items[id].is_dir { return !.Other(20) }
    if has_children(m, id) { return !.Other(39) }
    touch(m, m.nodes.items[id].parent, now)
    unlink(m, id)
    return ()
}

mem_rename :: fn(m: ^MemFs, from, to: string, now: i64) -> IoError!() {
    id := try resolve(m, from)
    dest := try resolve_parent(m, to)
    if id is 0 or dest.root { return !.Other(16) }
    is_dir := m.nodes.items[id].is_dir
    // A directory cannot move into itself.
    if is_dir {
        a := dest.parent
        while true {
            if a is id { return !.InvalidInput }
            if a is 0 { break }
            a = m.nodes.items[a].parent
        }
    }
    existing := find_child(m, dest.parent, dest.name)
    if e := existing {
        if e is id { return () }
        if m.nodes.items[e].is_dir {
            if not is_dir { return !.Other(21) }
            if has_children(m, e) { return !.Other(39) }
        } else if is_dir {
            return !.Other(20)
        }
    }
    // Build the new name before changing anything.
    a := m.alloc
    name := with a { list(u8) }
    if not fill_name(&name, dest.name) { return !.NoSpace }
    if e := existing { unlink(m, e) }
    n := &m.nodes.items[id]
    n.name.deinit()
    n.name = name
    touch(m, n.parent, now)
    touch(m, dest.parent, now)
    n.parent = dest.parent
    return ()
}

mem_open_dir :: fn(m: ^MemFs, path: string) -> IoError!Dir {
    id := try resolve(m, path)
    if not m.nodes.items[id].is_dir { return !.Other(20) }
    m.dirs.push(MemDir(open: true, node: id, next: 1)) else return !.NoSpace
    m.nodes.items[id].opens += 1
    return Dir(handle: m.dirs.items.len.trunc(i64))
}

get_dir :: fn(m: ^MemFs, d: Dir) -> IoError!^MemDir {
    if d.handle < 1 or d.handle > m.dirs.items.len.trunc(i64) { return !.Other(9) }
    p := &m.dirs.items[(d.handle - 1).trunc(usize)]
    if not p.open { return !.Other(9) }
    return p
}

/// The next entry's name, in the order of the node table. A name longer than `buf` is
/// `InvalidInput`, and a later call with a larger buffer returns it.
mem_next_entry :: fn(m: ^MemFs, d: Dir, buf: []u8) -> IoError!usize {
    p := try get_dir(m, d)
    while p.next < m.nodes.items.len {
        n := &m.nodes.items[p.next]
        if n.used and n.linked and n.parent is p.node {
            len := n.name.items.len
            if len > buf.len { return !.InvalidInput }
            buf[0..len].copy_from(n.name.items)
            p.next += 1
            return len
        }
        p.next += 1
    }
    return 0
}

mem_close_dir :: fn(m: ^MemFs, d: Dir) {
    p := get_dir(m, d) else return
    p.open = false
    n := &m.nodes.items[p.node]
    n.opens -= 1
    if not n.linked and n.opens is 0 { release(m, p.node) }
}

handler Fs for ^TestIo {
    open(self, path, o) => mem_open(&self.fs, path, o, test_wall(self))
    close(self, f) => { mem_close(&self.fs, f) }
    read_from(self, f, buf) => mem_read(&self.fs, f, buf)
    write_to(self, f, bytes) => mem_write(&self.fs, f, bytes, test_wall(self))
    seek(self, f, offset, from) => mem_seek(&self.fs, f, offset, from)
    stat(self, path) => mem_stat(&self.fs, path)
    remove(self, path) => mem_remove(&self.fs, path, test_wall(self))
    rename(self, from, to) => mem_rename(&self.fs, from, to, test_wall(self))
    make_dir(self, path) => mem_make_dir(&self.fs, path, test_wall(self))
    remove_dir(self, path) => mem_remove_dir(&self.fs, path, test_wall(self))
    open_dir(self, path) => mem_open_dir(&self.fs, path)
    next_entry(self, d, buf) => mem_next_entry(&self.fs, d, buf)
    close_dir(self, d) => { mem_close_dir(&self.fs, d) }
}

/// Runs a test that can fail with an error: 0 if it passed, 1 if it failed.
run_test :: fn(E: type, body: ^fn() -> E!() \ {Out, Err, Alloc, Env, In, Clock, Rand, Fs}) -> u8 \ {Out, Err, Env} {
    t := TestTracker(live: 0, inner: heap_allocator())
    io := TestIo(clock: 0, seed: 0, fs: mem_fs())
    r := with Allocator(data: &t, vt: &TRACKING), &io { body() }
    mem_fs_free(&io.fs)
    if !e := r {
        eprint("error: {}\n", e)
        return 1
    }
    return leaked(&t)
}

/// Runs a test that cannot fail with an error: 0 if it passed, 1 if it failed.
run_test_unit :: fn(body: ^fn() \ {Out, Err, Alloc, Env, In, Clock, Rand, Fs}) -> u8 \ {Out, Err, Env} {
    t := TestTracker(live: 0, inner: heap_allocator())
    io := TestIo(clock: 0, seed: 0, fs: mem_fs())
    with Allocator(data: &t, vt: &TRACKING), &io { body() }
    mem_fs_free(&io.fs)
    return leaked(&t)
}

/// The memory order of an atomic operation (§19.6), as in C11.
pub MemoryOrder :: union { Relaxed, Acquire, Release, AcqRel, SeqCst }
