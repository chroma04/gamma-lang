// The core prelude: declarations of the core library (spec §21) that are
// written in Gamma. Its public names are visible in every module without an
// import, as part of the universe scope (§21.1).

/// Standard output (§12.9, §21.7).
pub Out :: effect {
    write_out: fn(bytes: []const u8)
}

/// Standard error (§12.9, §21.7).
pub Err :: effect {
    write_err: fn(bytes: []const u8)
}

/// Operations that escape Gamma's model: foreign calls, `#global` storage and
/// the like (§12.10). It has no operations and cannot be handled.
pub Sys :: effect {}

/// The iteration effect (§13.1): an iterator is any function that performs it.
pub Yield :: effect(T: type) {
    yield: esc(x: T)
}

/// Command-line arguments, environment variables and process exit (§12.9, §21.7).
pub Env :: effect {
    args: fn() -> []const string
    var: fn(name: string) -> ?string
    exit: esc(code: u8) -> never
}

/// Why an input or output operation failed (§21.7).
pub IoError :: union {
    NotFound, PermissionDenied, AlreadyExists, WouldBlock, Interrupted,
    BrokenPipe, ConnectionReset, InvalidInput, UnexpectedEof, NoSpace,
    Other: i32                                  // OS error code
}

/// Standard input (§12.9, §21.7): `read` returns 0 at the end of the input.
pub In :: effect {
    read: fn(buf: []u8) -> IoError!usize
}

/// A point in time on a monotonic clock, since an unspecified epoch.
pub Instant :: struct { pub ns: u64 }

/// A length of time.
pub Duration :: struct { pub ns: u64 }

/// Time (§12.9, §21.7): `wall` gives Unix time in nanoseconds.
pub Clock :: effect {
    now: fn() -> Instant
    wall: fn() -> i64
    sleep: fn(d: Duration)
}

/// Random bytes (§12.9, §21.7).
pub Rand :: effect {
    fill: fn(buf: []u8)
}

/// `n` nanoseconds.
pub ns :: fn(n: u64) -> Duration => Duration(ns: n)
/// `n` microseconds.
pub us :: fn(n: u64) -> Duration => Duration(ns: n * 1_000)
/// `n` milliseconds.
pub ms :: fn(n: u64) -> Duration => Duration(ns: n * 1_000_000)
/// `n` seconds.
pub secs :: fn(n: u64) -> Duration => Duration(ns: n * 1_000_000_000)

/// The time from `earlier` to `i` (checked: `earlier` must not be later).
pub since :: fn(i: Instant, earlier: Instant) -> Duration => Duration(ns: i.ns - earlier.ns)
/// The instant `d` after `i`.
pub after :: fn(i: Instant, d: Duration) -> Instant => Instant(ns: i.ns + d.ns)
/// The sum of two durations.
pub plus :: fn(d: Duration, e: Duration) -> Duration => Duration(ns: d.ns + e.ns)
/// `d` less `e` (checked: `e` must not be longer).
pub minus :: fn(d: Duration, e: Duration) -> Duration => Duration(ns: d.ns - e.ns)
/// The whole milliseconds in `d`.
pub to_ms :: fn(d: Duration) -> u64 => d.ns / 1_000_000

// The default handlers of `In`, `Clock` and `Rand` (§12.9), installed around `main`.

SystemIo :: struct {}

/// The result of a system read or write: a count, or an error code.
io_result :: fn(n: i64) -> IoError!usize {
    if n >= 0 { return n.trunc(usize) }
    if n <= -1000 { return !.Other((-1000 - n).trunc(i32)) }
    e: IoError = match -1 - n {
        0 => .NotFound
        1 => .PermissionDenied
        2 => .AlreadyExists
        3 => .WouldBlock
        4 => .Interrupted
        5 => .BrokenPipe
        6 => .ConnectionReset
        7 => .InvalidInput
        8 => .UnexpectedEof
        _ => .NoSpace
    }
    return !e
}

handler In for SystemIo {
    read(self, buf) => io_result(@sys_read(buf))
}

handler Clock for SystemIo {
    now(self) => Instant(ns: @clock_now())
    wall(self) => @clock_wall()
    sleep(self, d) => @clock_sleep(d.ns)
}

handler Rand for SystemIo {
    fill(self, buf) => @rand_fill(buf)
}

system_io :: fn() -> SystemIo => SystemIo()

// Standard iterators (§13.3, §21.4).

/// The integers `lo, lo + 1, …, hi - 1`.
pub range :: fn(T: type, lo, hi: T) \ {Yield(T)} where Int(T) {
    i := lo
    while i < hi {
        yield(i)
        i += 1
    }
}

/// The integers `lo, …, hi`, without overflowing at `hi`; nothing if `lo > hi`.
pub range_incl :: fn(T: type, lo, hi: T) \ {Yield(T)} where Int(T) {
    if lo > hi { return }
    i := lo
    while true {
        yield(i)
        if i is hi { return }
        i += 1
    }
}

/// The elements of `xs`, in order.
pub each :: fn(T: type, xs: []const T) \ {Yield(T)} {
    for x in xs { yield(x) }
}

/// Pointers to the elements of `xs`, for modifying them in place.
pub each_ptr :: fn(T: type, xs: []T) \ {Yield(^T)} {
    i: usize = 0
    while i < xs.len {
        yield(&xs[i])
        i += 1
    }
}

/// Each element with its index.
pub enumerate :: fn(T: type, xs: []const T) \ {Yield((i: usize, x: T))} {
    i: usize = 0
    for x in xs {
        yield((i: i, x: x))
        i += 1
    }
}

/// The elements of `xs`, last to first.
pub reversed :: fn(T: type, xs: []const T) \ {Yield(T)} {
    i := xs.len
    while i > 0 {
        i -= 1
        yield(xs[i])
    }
}

/// The bytes of a string.
pub bytes :: fn(s: string) \ {Yield(u8)} {
    for b in s { yield(b) }
}

// Allocation (§15.2, §21.2).

/// Allocation failure.
pub AllocError :: union { OutOfMemory }

/// The operations of an allocator.
pub AllocVtable :: struct {
    pub alloc:  ^fn(data: rawptr, size, align: usize) -> ?[^]u8
    pub resize: ^fn(data: rawptr, p: [^]u8, old, new, align: usize) -> bool
    pub free:   ^fn(data: rawptr, p: [^]u8, size, align: usize)
}

/// A first-class handle to an allocator.
pub Allocator :: struct {
    pub data: rawptr
    pub vt:   ^const AllocVtable
}

/// The current allocator.
pub Alloc :: effect {
    current: fn() -> Allocator
}

/// An `Allocator` value is a handler for `Alloc`: `with arena.allocator() { … }`.
handler Alloc for Allocator {
    current(self) => self
}

heap_alloc :: fn(data: rawptr, size, align: usize) -> ?[^]u8 => @heap_alloc(size, align)

heap_resize :: fn(data: rawptr, p: [^]u8, old, new, align: usize) -> bool => false

heap_free :: fn(data: rawptr, p: [^]u8, size, align: usize) {
    @heap_free(p, size, align)
}

HEAP :: AllocVtable(alloc: heap_alloc, resize: heap_resize, free: heap_free)

/// The system heap; the default `Alloc` handler of `main`.
pub heap_allocator :: fn() -> Allocator => Allocator(data: &HEAP, vt: &HEAP)

/// An empty slice: a non-null, suitably aligned pointer that must not be dereferenced (§5.7).
empty_slice :: fn(T: type) -> []T {
    p := @align_of(T).to_ptr([^]T)?
    return p[0..0]
}

/// A new object holding `init`.
pub new :: fn(T: type, init: T) -> AllocError!^T \ {Alloc} {
    a := current()
    raw := a.vt.alloc(a.data, @size_of(T), @align_of(T)) else return !.OutOfMemory
    p := raw.cast(^T)
    p^ = init
    return p
}

/// `n` objects of plain data, uninitialized.
pub make :: fn(T: type, n: usize) -> AllocError![]T \ {Alloc} where Plain(T) {
    if n is 0 { return empty_slice(T) }
    a := current()
    raw := a.vt.alloc(a.data, @size_of(T) * n, @align_of(T)) else return !.OutOfMemory
    return raw.cast([^]T)[0..n]
}

/// `n` copies of `x`.
pub make_fill :: fn(T: type, n: usize, x: T) -> AllocError![]T \ {Alloc} {
    if n is 0 { return empty_slice(T) }
    a := current()
    raw := a.vt.alloc(a.data, @size_of(T) * n, @align_of(T)) else return !.OutOfMemory
    s := raw.cast([^]T)[0..n]
    for i in 0..n { s[i] = x }
    return s
}

/// Releases a slice obtained from `make` or `make_fill` under the current allocator.
pub free :: fn(T: type, s: []T) \ {Alloc} {
    if s.len is 0 { return }
    a := current()
    a.vt.free(a.data, s.ptr.cast([^]u8), @size_of(T) * s.len, @align_of(T))
}

/// Releases an object obtained from `new` under the current allocator.
pub destroy :: fn(T: type, p: ^T) \ {Alloc} {
    a := current()
    a.vt.free(a.data, p.cast([^]u8), @size_of(T), @align_of(T))
}

/// Where a piece of source code is (§21.7): the result of `@location()`.
pub SourceLocation :: struct {
    pub file: string
    pub line, column: u32
    pub function: string
}

// Running tests (§3.8, §12.9): `gamma test` calls `run_test` or `run_test_unit`
// for each test. The test's allocations go through a tracking allocator, and
// memory still allocated when the test ends fails it.

TestTracker :: struct {
    live: usize
    inner: Allocator
}

track_alloc :: fn(data: rawptr, size, align: usize) -> ?[^]u8 {
    t := data.cast(^TestTracker)
    p := t.inner.vt.alloc(t.inner.data, size, align) else return null
    t.live += size
    return p
}

track_resize :: fn(data: rawptr, p: [^]u8, old, new, align: usize) -> bool => false

track_free :: fn(data: rawptr, p: [^]u8, size, align: usize) {
    t := data.cast(^TestTracker)
    t.live -= size
    t.inner.vt.free(t.inner.data, p, size, align)
}

TRACKING :: AllocVtable(alloc: track_alloc, resize: track_resize, free: track_free)

leaked :: fn(t: ^TestTracker) -> u8 \ {Err} {
    if t.live is 0 { return 0 }
    eprint("leaked {} bytes\n", t.live)
    return 1
}

// The test handlers of `In`, `Clock` and `Rand` (§12.9): empty input, a fake clock that
// `sleep` advances, and a generator with a fixed seed.

TestIo :: struct {
    clock: u64
    seed: u64
}

handler In for ^TestIo {
    read(self, buf) => 0
}

handler Clock for ^TestIo {
    now(self) => Instant(ns: self.clock)
    wall(self) => 1_700_000_000_000_000_000 + self.clock.trunc(i64)
    sleep(self, d) => { self.clock += d.ns }
}

handler Rand for ^TestIo {
    fill(self, buf) => {
        // splitmix64
        for i in 0..buf.len {
            self.seed +%= 0x9e3779b97f4a7c15
            z := self.seed
            z = (z ~ (z >> 30)) *% 0xbf58476d1ce4e5b9
            z = (z ~ (z >> 27)) *% 0x94d049bb133111eb
            buf[i] = (z ~ (z >> 31)).trunc(u8)
        }
    }
}

/// Runs a test that can fail with an error: 0 if it passed, 1 if it failed.
run_test :: fn(E: type, body: ^fn() -> E!() \ {Out, Err, Alloc, Env, In, Clock, Rand}) -> u8 \ {Out, Err, Env} {
    t := TestTracker(live: 0, inner: heap_allocator())
    io := TestIo(clock: 0, seed: 0)
    r := with Allocator(data: &t, vt: &TRACKING), &io { body() }
    if !e := r {
        eprint("error: {}\n", e)
        return 1
    }
    return leaked(&t)
}

/// Runs a test that cannot fail with an error: 0 if it passed, 1 if it failed.
run_test_unit :: fn(body: ^fn() \ {Out, Err, Alloc, Env, In, Clock, Rand}) -> u8 \ {Out, Err, Env} {
    t := TestTracker(live: 0, inner: heap_allocator())
    io := TestIo(clock: 0, seed: 0)
    with Allocator(data: &t, vt: &TRACKING), &io { body() }
    return leaked(&t)
}

/// The memory order of an atomic operation (§19.6), as in C11.
pub MemoryOrder :: union { Relaxed, Acquire, Release, AcqRel, SeqCst }
