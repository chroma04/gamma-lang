// std/hash/sha256: SHA-256 as in FIPS 180-4.
//
//     sha256 :: import "std/hash/sha256"
//     d := sha256.sum("abc")                     // a [32]u8: ba7816bf 8f01cfea ...
//
//     s := sha256.init()                         // the same for data in pieces
//     s.update("a")
//     s.update("bc")
//     d2 := s.final()
//
// The state holds one block of input and never allocates. `final` pads and finishes a
// copy of the state, so the original can take more data.

/// The size of a digest in bytes.
pub DIGEST_LEN :: 32

/// The size of the blocks the algorithm works on, in bytes.
pub BLOCK_LEN :: 64

/// A SHA-256 digest.
pub Digest :: [32]u8

/// The running state of a hash over the bytes given to `update` so far.
pub Sha256 :: struct {
    h: [8]u32
    block: [64]u8
    filled: usize
    total: u64
}

K: [64]u32 : [_]u32(
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2)

/// A state for the empty input.
pub init :: fn() -> Sha256 {
    return Sha256(
        h: [_]u32(
            0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19),
        block: [64]u8(fill: 0), filled: 0, total: 0)
}

// Mixes the 64 bytes of `b` into the state.
compress :: fn(h: ^[8]u32, b: []const u8) {
    w: [64]u32 = ---
    for i in 0..16 {
        hi := (b[4 * i].trunc(u32) << 24) | (b[4 * i + 1].trunc(u32) << 16)
        lo := (b[4 * i + 2].trunc(u32) << 8) | b[4 * i + 3].trunc(u32)
        w[i] = hi | lo
    }
    for i in 16..64 {
        x := w[i - 15]
        y := w[i - 2]
        s0 := @rotr(x, 7) ~ @rotr(x, 18) ~ (x >> 3)
        s1 := @rotr(y, 17) ~ @rotr(y, 19) ~ (y >> 10)
        w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1
    }
    a := h[0]
    bb := h[1]
    c := h[2]
    d := h[3]
    e := h[4]
    f := h[5]
    g := h[6]
    hh := h[7]
    for i in 0..64 {
        s1 := @rotr(e, 6) ~ @rotr(e, 11) ~ @rotr(e, 25)
        ch := (e & f) ~ (~e & g)
        t1 := hh +% s1 +% ch +% K[i] +% w[i]
        s0 := @rotr(a, 2) ~ @rotr(a, 13) ~ @rotr(a, 22)
        maj := (a & bb) ~ (a & c) ~ (bb & c)
        t2 := s0 +% maj
        hh = g
        g = f
        f = e
        e = d +% t1
        d = c
        c = bb
        bb = a
        a = t1 +% t2
    }
    h[0] +%= a
    h[1] +%= bb
    h[2] +%= c
    h[3] +%= d
    h[4] +%= e
    h[5] +%= f
    h[6] +%= g
    h[7] +%= hh
}

/// Adds `data` to the hash. The total input may be up to 2^61 - 1 bytes.
pub update :: fn(s: ^Sha256, data: []const u8) {
    s.total += data.len.trunc(u64)
    i: usize = 0
    if s.filled > 0 {
        take := 64 - s.filled
        if take > data.len { take = data.len }
        s.block[s.filled..s.filled + take].copy_from(data[0..take])
        s.filled += take
        i = take
        if s.filled is 64 {
            compress(&s.h, s.block[..])
            s.filled = 0
        }
    }
    while data.len - i >= 64 {
        compress(&s.h, data[i..i + 64])
        i += 64
    }
    if i < data.len {
        rest := data.len - i
        s.block[0..rest].copy_from(data[i..])
        s.filled = rest
    }
}

/// The digest of everything given to `update`. The state is unchanged, so more data can
/// still be added.
pub final :: fn(s: ^const Sha256) -> Digest {
    t := s^
    bits := t.total << 3
    t.block[t.filled] = 0x80
    t.filled += 1
    if t.filled > 56 {
        for i in t.filled..64 { t.block[i] = 0 }
        compress(&t.h, t.block[..])
        t.filled = 0
    }
    for i in t.filled..56 { t.block[i] = 0 }
    for i in 0..8 { t.block[56 + i] = (bits >> (56 - 8 * i.trunc(u32))).trunc(u8) }
    compress(&t.h, t.block[..])
    out: Digest = ---
    for i in 0..8 {
        out[4 * i] = (t.h[i] >> 24).trunc(u8)
        out[4 * i + 1] = (t.h[i] >> 16).trunc(u8)
        out[4 * i + 2] = (t.h[i] >> 8).trunc(u8)
        out[4 * i + 3] = t.h[i].trunc(u8)
    }
    return out
}

/// The digest of `data`.
pub sum :: fn(data: []const u8) -> Digest {
    s := init()
    s.update(data)
    return s.final()
}
