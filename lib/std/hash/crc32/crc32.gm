//! The CRC-32 of ISO-HDLC (ISO 3309, ITU-T V.42), as used by zlib, gzip,
//! PNG and Ethernet: reflected polynomial 0xEDB88320, initial value 0xFFFFFFFF, final
//! exclusive-or 0xFFFFFFFF. The checksum of "123456789" is 0xCBF43926.
//!
//!     crc32 :: import "std/hash/crc32"
//!     c := crc32.init()
//!     c.update("1234")
//!     c.update("56789")
//!     c.final()                                  // 0xcbf43926
//!     crc32.checksum("123456789")                // the same in one call
//!
//! A checksum detects accidental changes; it says nothing about deliberate ones.

/// The running state of a checksum over the bytes given to `update` so far.
pub Crc32 :: struct {
    state: u32
}

// The checksum of each byte value, computed when the program is compiled.
TABLE: [256]u32 : build_table()

build_table :: fn() -> [256]u32 {
    t: [256]u32 = ---
    for n in 0..256 {
        c: u32 = n.trunc(u32)
        for _ in 0..8 {
            c = if c & 1 is 1 { 0xEDB88320 ~ (c >> 1) } else { c >> 1 }
        }
        t[n] = c
    }
    return t
}

/// A state for the empty input.
pub init :: fn() -> Crc32 => Crc32(state: 0xFFFFFFFF)

/// Adds `data` to the checksum.
pub update :: fn(c: ^Crc32, data: []const u8) {
    s := c.state
    for b in data {
        s = TABLE[((s ~ b.trunc(u32)) & 255).trunc(usize)] ~ (s >> 8)
    }
    c.state = s
}

/// The checksum of everything given to `update`. The state is unchanged, so more data can
/// still be added.
pub final :: fn(c: ^const Crc32) -> u32 => c.state ~ 0xFFFFFFFF

/// The checksum of `data`.
pub checksum :: fn(data: []const u8) -> u32 {
    c := init()
    c.update(data)
    return c.final()
}
