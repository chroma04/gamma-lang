//! Whole-file operations over the `Fs` effect (§21.7).

/// An open file: a handle that the `Fs` effect's operations take (§21.7).
pub File :: core.File

/// An open directory, read with `Fs.next_entry`.
pub Dir :: core.Dir

/// How `Fs.open` opens a file: `OpenOptions(write: true, create: true)`.
pub OpenOptions :: core.OpenOptions

/// What a path names: a file, a directory, a symbolic link, or something else.
pub FileKind :: core.FileKind

/// What `Fs.stat` and `Fs.lstat` report about a path.
pub FileInfo :: core.FileInfo

/// A directory entry from `Fs.next_entry`: the length of its name, and what it is.
pub DirEntry :: core.DirEntry

/// Where `Fs.seek` counts from.
pub SeekFrom :: core.SeekFrom

/// Why reading a whole file failed (`io.ReadError` is the same type).
pub ReadError :: union {
    Io: IoError
    Alloc: AllocError
}

/// The contents of the file at `path`, in memory from the current allocator; release it
/// with `free(data)`.
pub read_all :: fn(path: string) -> ReadError![]u8 needs Fs + Alloc {
    f := try Fs.open(path, OpenOptions())
    defer Fs.close(f)
    size := (try Fs.stat(path)).size.trunc(usize)
    // One byte more than the reported size, so reaching the end needs no second buffer.
    cap := size + 1
    data := try make(u8, cap)
    len: usize = 0
    while true {
        if len is cap {
            bigger := make(u8, cap * 2) else e => {
                free(data)
                return !.Alloc(e)
            }
            bigger[0..len].copy_from(data)
            free(data)
            data = bigger
            cap *= 2
        }
        n := f.read(data[len..cap]) else e => {
            free(data)
            return !.Io(e)
        }
        if n is 0 { break }
        len += n
    }
    if len is cap { return data }
    // Return exactly `len` bytes: copy into storage of the right size.
    exact := make(u8, len) else e => {
        free(data)
        return !.Alloc(e)
    }
    exact.copy_from(data[0..len])
    free(data)
    return exact
}

/// Writes all of `bytes` to `f`, retrying short writes. A write that makes no progress
/// (returns 0) fails with `.Other(0)`.
pub write_all_to :: fn(f: File, bytes: []const u8) -> IoError!() needs Fs {
    done: usize = 0
    while done < bytes.len {
        n := try f.write(bytes[done..bytes.len])
        if n is 0 { return !.Other(0) }
        done += n
    }
    return ()
}

/// Replaces the contents of the file at `path` with `bytes`, creating it if needed.
pub write_all :: fn(path: string, bytes: []const u8) -> IoError!() needs Fs {
    f := try Fs.open(path, OpenOptions(read: false, write: true, create: true, truncate: true))
    defer Fs.close(f)
    return write_all_to(f, bytes)
}

/// Appends `bytes` to the file at `path`, creating it if needed.
pub append :: fn(path: string, bytes: []const u8) -> IoError!() needs Fs {
    f := try Fs.open(path, OpenOptions(read: false, append: true, create: true))
    defer Fs.close(f)
    return write_all_to(f, bytes)
}

/// Whether something exists at `path`. A symbolic link counts only if its target exists.
pub exists :: fn(path: string) -> bool needs Fs {
    _ = Fs.stat(path) else return false
    return true
}

/// Copies the file at `from` to `to`, replacing `to`. Copying a file onto itself leaves it
/// unchanged.
pub copy :: fn(from, to: string) -> IoError!() needs Fs {
    src := try Fs.open(from, OpenOptions())
    defer Fs.close(src)
    // `to` is cut to the copied length at the end rather than emptied first, so that a file
    // given as both `from` and `to` is not lost.
    dst := try Fs.open(to, OpenOptions(read: false, write: true, create: true))
    defer Fs.close(dst)
    buf: [4096]u8 = ---
    total: u64 = 0
    while true {
        n := try src.read(buf[..])
        if n is 0 { break }
        try write_all_to(dst, buf[0..n])
        total += u64(n)
    }
    try Fs.truncate(dst, total)
    return ()
}

// ---------------------------------------------------------------------------------
// Directories
// ---------------------------------------------------------------------------------

/// One entry of a directory: its name (valid until the next entry is produced) and what it
/// is.
pub Entry :: struct {
    pub name: string
    pub kind: FileKind
}

/// The entries of the directory at `path`, in the order the operating system gives them
/// (never `.` or `..`). It opens the directory and closes it again, also when the loop is
/// left early. An error (opening the directory, or reading an entry) is yielded as an
/// error and ends the iteration.
///
///     for r in fs.entries("src") {
///         e := try r
///         print("{}\n", e.name)
///     }
pub entries :: fn(path: string) needs Yield(IoError!Entry) + Fs {
    d := Fs.open_dir(path) else e => {
        yield(!e)
        return
    }
    defer Fs.close_dir(d)
    // NAME_MAX is 255 on POSIX systems.
    buf: [256]u8 = ---
    while true {
        next := d.next_entry(buf[..]) else e => {
            yield(!e)
            return
        }
        ent := next else break
        yield(Entry(name: buf[0..ent.len], kind: ent.kind))
    }
}

/// An entry found by `walk`: its path (the root joined with the names down to it), what it
/// is, and its depth, which is 0 for the entries directly in the root.
pub WalkEntry :: struct {
    pub path: string
    pub kind: FileKind
    pub depth: u32
}

// A directory being walked, and the length of its path.
Frame :: struct {
    dir: Dir
    path_len: usize
}

close_frames :: fn(frames: ^List(Frame)) needs Fs {
    for f in frames.items { Fs.close_dir(f.dir) }
    frames.deinit()
}

/// Every entry below the directory `root` (which is not itself yielded), depth first and
/// in pre-order: a directory comes before what it contains, and the entries of one
/// directory are in the order the operating system gives them. Symbolic links are not
/// followed; they are yielded with the kind `.Symlink`. A `path` is valid until the next
/// entry is produced. A directory that cannot be read yields its error and the walk
/// goes on with the rest; a failure to list `root` itself, or to allocate (`.NoSpace`), yields
/// an error and ends the walk. Everything allocated and every directory opened is released when the
/// walk finishes or the loop is left early.
///
///     for r in fs.walk("src") {
///         e := try r
///         if e.kind is .File { print("{}\n", e.path) }
///     }
pub walk :: fn(root: string) needs Yield(IoError!WalkEntry) + Fs + Alloc {
    path := list(u8)
    defer path.deinit()
    frames := list(Frame)
    defer close_frames(&frames)
    path.extend(root) else {
        yield(!.NoSpace)
        return
    }
    first := Fs.open_dir(path.items) else e => {
        yield(!e)
        return
    }
    frames.push(Frame(dir: first, path_len: root.len)) else {
        Fs.close_dir(first)
        yield(!.NoSpace)
        return
    }
    buf: [256]u8 = ---
    while frames.items.len > 0 {
        top := frames.items[frames.items.len - 1]
        next := top.dir.next_entry(buf[..]) else e => {
            yield(!e)
            return
        }
        ent := next else {
            Fs.close_dir(top.dir)
            _ = frames.pop()
            continue
        }
        path.truncate(top.path_len)
        if path.items.len > 0 and path.items[path.items.len - 1] is not '/' {
            path.push('/') else {
                yield(!.NoSpace)
                return
            }
        }
        path.extend(buf[0..ent.len]) else {
            yield(!.NoSpace)
            return
        }
        yield(WalkEntry(path: path.items, kind: ent.kind, depth: (frames.items.len - 1).trunc(u32)))
        if ent.kind is .Dir {
            sub := Fs.open_dir(path.items) else e => {
                yield(!e)
                continue
            }
            frames.push(Frame(dir: sub, path_len: path.items.len)) else {
                Fs.close_dir(sub)
                yield(!.NoSpace)
                return
            }
        }
    }
}

/// Creates the directory `path` and any missing parents, like `mkdir -p`. Directories that
/// exist already are fine; something else at `path`, or at one of its parents, is an
/// error.
pub make_dir_all :: fn(path: string) -> IoError!() needs Fs {
    i: usize = 0
    while i < path.len {
        // The next prefix ends before a separator, or at the end of the path.
        while i < path.len and path[i] is '/' { i += 1 }
        if i >= path.len { break }
        while i < path.len and path[i] is not '/' { i += 1 }
        prefix := path[0..i]
        Fs.make_dir(prefix) else e => {
            if e is not .AlreadyExists { return !e }
            info := try Fs.stat(prefix)
            if info.kind is not .Dir { return !e }
        }
    }
    return ()
}

/// Removes `path` and everything in it: a file or a symbolic link is removed, a directory
/// is emptied and then removed, like `rm -rf`. Symbolic links are never followed (a link to
/// a directory is removed as a link and its target is left alone). An entry that vanishes
/// while the removal runs is not an error. If `path` itself does not exist the result is
/// `.NotFound`, which a caller that does not mind can ignore. Any other failure ends the
/// removal at once, leaving the rest in place. The directories being emptied are tracked in
/// memory from the current allocator (`.NoSpace` if it runs out), not on the call stack,
/// and all of them are closed again on every exit.
pub remove_all :: fn(path: string) -> IoError!() needs Fs + Alloc {
    info := try Fs.lstat(path)
    if info.kind is not .Dir {
        return Fs.remove(path)
    }
    cur := list(u8)
    defer cur.deinit()
    frames := list(Frame)
    defer close_frames(&frames)
    cur.extend(path) else return !.NoSpace
    first := try Fs.open_dir(path)
    frames.push(Frame(dir: first, path_len: path.len)) else {
        Fs.close_dir(first)
        return !.NoSpace
    }
    buf: [256]u8 = ---
    while frames.items.len > 0 {
        top := frames.items[frames.items.len - 1]
        next := try top.dir.next_entry(buf[..])
        ent := next else {
            // The directory is empty now.
            Fs.close_dir(top.dir)
            _ = frames.pop()
            cur.truncate(top.path_len)
            Fs.remove_dir(cur.items) else e => {
                if e is not .NotFound { return !e }
            }
            continue
        }
        cur.truncate(top.path_len)
        if cur.items.len > 0 and cur.items[cur.items.len - 1] is not '/' {
            cur.push('/') else return !.NoSpace
        }
        cur.extend(buf[0..ent.len]) else return !.NoSpace
        if ent.kind is .Dir {
            sub := Fs.open_dir(cur.items) else e => {
                // Gone already: nothing to empty.
                if e is .NotFound { continue }
                return !e
            }
            frames.push(Frame(dir: sub, path_len: cur.items.len)) else {
                Fs.close_dir(sub)
                return !.NoSpace
            }
        } else {
            Fs.remove(cur.items) else e => {
                if e is not .NotFound { return !e }
            }
        }
    }
    return ()
}

// ---------------------------------------------------------------------------------
// Temporary files
// ---------------------------------------------------------------------------------

/// The bytes `create_temp` and `make_temp_dir` need in their buffer beyond the length of
/// `prefix`: a buffer of `dir.len + prefix.len + TEMP_EXTRA` bytes always suffices (a
/// separator and 16 hex digits).
pub TEMP_EXTRA :: 17

// How often a name that is taken is replaced by a new one before giving up.
TEMP_TRIES :: 16

/// The directory for temporary files. On Windows it is the value of `TEMP`, else `TMP`,
/// else `C:\Windows\Temp`; elsewhere it is `TMPDIR`, else `/tmp`. A variable that is empty
/// counts as unset. The result is not checked to exist.
pub temp_dir :: fn() -> string needs Env {
    when target.os is .Windows {
        for name in [_]string("TEMP", "TMP") {
            v := Env.var(name) else continue
            if v.len > 0 { return v }
        }
        return "C:\\Windows\\Temp"
    } else {
        v := Env.var("TMPDIR") else return "/tmp"
        return if v.len > 0 { v } else { "/tmp" }
    }
}

// Whether `c` separates the parts of a path: `/`, and on Windows also `\`.
is_sep :: fn(c: u8) -> bool {
    when target.os is .Windows {
        return c is '/' or c is '\\'
    } else {
        return c is '/'
    }
}

// Writes `dir`, a separator (unless `dir` is empty or ends with one) and `prefix` to the
// start of `buf`, and returns the length used; null if that and 16 more bytes do not fit,
// or if `prefix` has a separator in it.
temp_stem :: fn(dir, prefix: string, buf: []u8) -> ?usize {
    for c in prefix {
        if is_sep(c) { return null }
    }
    sep: usize = if dir.len > 0 and not is_sep(dir[dir.len - 1]) { 1 } else { 0 }
    n := dir.len + sep + prefix.len
    if n + 16 > buf.len { return null }
    buf[0..dir.len].copy_from(dir)
    if sep is 1 { buf[dir.len] = '/' }
    buf[dir.len + sep..n].copy_from(prefix)
    return n
}

// Fills the 16 bytes of `buf` from `at` with random lowercase hex digits.
temp_random :: fn(buf: []u8, at: usize) needs Rand {
    r: [8]u8 = ---
    Rand.fill(r[..])
    for i in 0..8 {
        buf[at + 2 * i] = hex_digit(r[i] >> 4)
        buf[at + 2 * i + 1] = hex_digit(r[i] & 15)
    }
}

/// Creates a new file in `dir`, opened for reading and writing, and returns it with its
/// path. The name is `prefix` followed by 16 random lowercase hex digits (from `Rand`);
/// the path is `dir`, a `/` (unless `dir` is empty or ends with one) and the name, written
/// to the start of `buf` and returned as the used part. The file is created exclusively, so
/// an existing file is never opened; a name that is taken is replaced by a new random one,
/// up to 16 times, and then the result is `.AlreadyExists`. A `buf` shorter than
/// `dir.len + prefix.len + TEMP_EXTRA` bytes, or a `prefix` with a separator in it (`/`, and
/// on Windows also `\`), gives
/// `.InvalidInput` and creates nothing. The caller closes the file and removes it.
pub create_temp :: fn(dir, prefix: string, buf: []u8) -> IoError!(file: File, path: string) needs Fs + Rand {
    n := temp_stem(dir, prefix, buf) else return !.InvalidInput
    opts := OpenOptions(read: true, write: true, create: true, exclusive: true)
    tries: u32 = 0
    while true {
        temp_random(buf, n)
        path := buf[0..n + 16]
        f := Fs.open(path, opts) else e => {
            if e is .AlreadyExists and tries + 1 < TEMP_TRIES {
                tries += 1
                continue
            }
            return !e
        }
        return (file: f, path: path)
    }
}

/// Creates a new directory in `dir` and returns its path, named as for `create_temp`
/// (`prefix` and 16 random hex digits) and written to `buf` in the same way, with the same
/// retries and errors. The caller removes it, for instance with `remove_all`.
pub make_temp_dir :: fn(dir, prefix: string, buf: []u8) -> IoError!string needs Fs + Rand {
    n := temp_stem(dir, prefix, buf) else return !.InvalidInput
    tries: u32 = 0
    while true {
        temp_random(buf, n)
        path := buf[0..n + 16]
        Fs.make_dir(path) else e => {
            if e is .AlreadyExists and tries + 1 < TEMP_TRIES {
                tries += 1
                continue
            }
            return !e
        }
        return path
    }
}

/// Replaces the contents of the file at `path` with `bytes` so that no reader ever sees a
/// partial file: the bytes go to a new file next to `path` (named after it with a random
/// suffix), which is synced and then renamed over `path`. The new file is removed again
/// if anything fails. The suffix comes from the `Rand` effect. `path` may be at most 4000
/// bytes long (`InvalidInput` otherwise).
pub write_atomic :: fn(path: string, bytes: []const u8) -> IoError!() needs Fs + Rand {
    // `path`, ".tmp-" and eight hex digits.
    SUFFIX :: 13
    name: [4096]u8 = ---
    if path.len > 4000 { return !.InvalidInput }
    name[0..path.len].copy_from(path)
    tmp := name[0..path.len + SUFFIX]
    tmp[path.len..path.len + 5].copy_from(".tmp-")
    opts := OpenOptions(read: false, write: true, create: true, exclusive: true)
    tries: u32 = 0
    f: File = ---
    while true {
        r: [4]u8 = ---
        Rand.fill(r[..])
        for i in 0..4 {
            tmp[path.len + 5 + 2 * i] = hex_digit(r[i] >> 4)
            tmp[path.len + 6 + 2 * i] = hex_digit(r[i] & 15)
        }
        f = Fs.open(tmp, opts) else e => {
            // A name that is taken: try another.
            if e is .AlreadyExists and tries < 8 {
                tries += 1
                continue
            }
            return !e
        }
        break
    }
    fill_temp(f, bytes) else e => {
        Fs.close(f)
        _ = Fs.remove(tmp)
        return !e
    }
    Fs.close(f)
    Fs.rename(tmp, path) else e => {
        _ = Fs.remove(tmp)
        return !e
    }
    return ()
}

fill_temp :: fn(f: File, bytes: []const u8) -> IoError!() needs Fs {
    try write_all_to(f, bytes)
    return f.sync()
}

hex_digit :: fn(v: u8) -> u8 => if v < 10 { '0' + v } else { 'a' + v - 10 }
