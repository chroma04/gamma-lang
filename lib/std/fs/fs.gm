//! Whole-file operations over the `Fs` effect (§21.7).

/// An open file: a handle that the `Fs` effect's operations take (§21.7).
pub File :: core.File

/// An open directory, read with `Fs.next_entry`.
pub Dir :: core.Dir

/// How `Fs.open` opens a file: `OpenOptions(write: true, create: true)`.
pub OpenOptions :: core.OpenOptions

/// What a path names: a file, a directory, a symbolic link, or something else.
pub FileKind :: core.FileKind

/// What `Fs.stat` and `Fs.lstat` report about a path.
pub FileInfo :: core.FileInfo

/// A directory entry from `Fs.next_entry`: the length of its name, and what it is.
pub DirEntry :: core.DirEntry

/// Where `Fs.seek` counts from.
pub SeekFrom :: core.SeekFrom

/// Why reading a whole file failed.
pub ReadError :: union {
    Io: IoError
    Alloc: AllocError
}

/// The contents of the file at `path`, in memory from the current allocator; release it
/// with `free(data)`.
pub read_all :: fn(path: string) -> ReadError![]u8 needs Fs + Alloc {
    f := try Fs.open(path, OpenOptions())
    defer Fs.close(f)
    size := (try Fs.stat(path)).size.trunc(usize)
    // One byte more than the reported size, so reaching the end needs no second buffer.
    cap := size + 1
    data := try make(u8, cap)
    len: usize = 0
    while true {
        if len is cap {
            bigger := make(u8, cap * 2) else e => {
                free(data)
                return !.Alloc(e)
            }
            bigger[0..len].copy_from(data)
            free(data)
            data = bigger
            cap *= 2
        }
        n := f.read_from(data[len..cap]) else e => {
            free(data)
            return !.Io(e)
        }
        if n is 0 { break }
        len += n
    }
    if len is cap { return data }
    // Return exactly `len` bytes: copy into storage of the right size.
    exact := make(u8, len) else e => {
        free(data)
        return !.Alloc(e)
    }
    exact.copy_from(data[0..len])
    free(data)
    return exact
}

/// Writes all of `bytes` to `f`, retrying short writes. A write that makes no progress
/// (returns 0) fails with `.Other(0)`.
pub write_all_to :: fn(f: File, bytes: []const u8) -> IoError!() needs Fs {
    done: usize = 0
    while done < bytes.len {
        n := try f.write_to(bytes[done..bytes.len])
        if n is 0 { return !.Other(0) }
        done += n
    }
    return ()
}

/// Replaces the contents of the file at `path` with `bytes`, creating it if needed.
pub write_all :: fn(path: string, bytes: []const u8) -> IoError!() needs Fs {
    f := try Fs.open(path, OpenOptions(read: false, write: true, create: true, truncate: true))
    defer Fs.close(f)
    return write_all_to(f, bytes)
}

/// Appends `bytes` to the file at `path`, creating it if needed.
pub append :: fn(path: string, bytes: []const u8) -> IoError!() needs Fs {
    f := try Fs.open(path, OpenOptions(read: false, append: true, create: true))
    defer Fs.close(f)
    return write_all_to(f, bytes)
}

/// Whether something exists at `path`. A symbolic link counts only if its target exists.
pub exists :: fn(path: string) -> bool needs Fs {
    _ = Fs.stat(path) else return false
    return true
}

/// Copies the file at `from` to `to`, replacing `to`. Copying a file onto itself leaves it
/// unchanged.
pub copy :: fn(from, to: string) -> IoError!() needs Fs {
    src := try Fs.open(from, OpenOptions())
    defer Fs.close(src)
    // `to` is cut to the copied length at the end rather than emptied first, so that a file
    // given as both `from` and `to` is not lost.
    dst := try Fs.open(to, OpenOptions(read: false, write: true, create: true))
    defer Fs.close(dst)
    buf: [4096]u8 = ---
    total: u64 = 0
    while true {
        n := try src.read_from(buf[..])
        if n is 0 { break }
        try write_all_to(dst, buf[0..n])
        total += u64(n)
    }
    try Fs.truncate(dst, total)
    return ()
}

// ---------------------------------------------------------------------------------
// Directories
// ---------------------------------------------------------------------------------

/// One entry of a directory: its name (valid until the next entry is produced) and what it
/// is.
pub Entry :: struct {
    pub name: string
    pub kind: FileKind
}

/// The entries of the directory at `path`, in the order the operating system gives them
/// (never `.` or `..`). It opens the directory and closes it again, also when the loop is
/// left early. An error (opening the directory, or reading an entry) is yielded as an
/// error and ends the iteration.
///
///     for r in fs.entries("src") {
///         e := try r
///         print("{}\n", e.name)
///     }
pub entries :: fn(path: string) needs Yield(IoError!Entry) + Fs {
    d := Fs.open_dir(path) else e => {
        yield(!e)
        return
    }
    defer Fs.close_dir(d)
    // NAME_MAX is 255 on POSIX systems.
    buf: [256]u8 = ---
    while true {
        next := d.next_entry(buf[..]) else e => {
            yield(!e)
            return
        }
        ent := next else break
        yield(Entry(name: buf[0..ent.len], kind: ent.kind))
    }
}

/// An entry found by `walk`: its path (the root joined with the names down to it), what it
/// is, and its depth, which is 0 for the entries directly in the root.
pub WalkEntry :: struct {
    pub path: string
    pub kind: FileKind
    pub depth: u32
}

// A directory being walked, and the length of its path.
Frame :: struct {
    dir: Dir
    path_len: usize
}

close_frames :: fn(frames: ^List(Frame)) needs Fs {
    for f in frames.items { Fs.close_dir(f.dir) }
    frames.deinit()
}

/// Every entry below the directory `root` (which is not itself yielded), depth first and
/// in pre-order: a directory comes before what it contains, and the entries of one
/// directory are in the order the operating system gives them. Symbolic links are not
/// followed; they are yielded with the kind `.Symlink`. A `path` is valid until the next
/// entry is produced. A directory that cannot be read yields its error and the walk
/// goes on with the rest; a failure to list `root` itself, or to allocate (`.NoSpace`), yields
/// an error and ends the walk. Everything allocated and every directory opened is released when the
/// walk finishes or the loop is left early.
///
///     for r in fs.walk("src") {
///         e := try r
///         if e.kind is .File { print("{}\n", e.path) }
///     }
pub walk :: fn(root: string) needs Yield(IoError!WalkEntry) + Fs + Alloc {
    path := list(u8)
    defer path.deinit()
    frames := list(Frame)
    defer close_frames(&frames)
    path.extend(root) else {
        yield(!.NoSpace)
        return
    }
    first := Fs.open_dir(path.items) else e => {
        yield(!e)
        return
    }
    frames.push(Frame(dir: first, path_len: root.len)) else {
        Fs.close_dir(first)
        yield(!.NoSpace)
        return
    }
    buf: [256]u8 = ---
    while frames.items.len > 0 {
        top := frames.items[frames.items.len - 1]
        next := top.dir.next_entry(buf[..]) else e => {
            yield(!e)
            return
        }
        ent := next else {
            Fs.close_dir(top.dir)
            _ = frames.pop()
            continue
        }
        path.truncate(top.path_len)
        if path.items.len > 0 and path.items[path.items.len - 1] is not '/' {
            path.push('/') else {
                yield(!.NoSpace)
                return
            }
        }
        path.extend(buf[0..ent.len]) else {
            yield(!.NoSpace)
            return
        }
        yield(WalkEntry(path: path.items, kind: ent.kind, depth: (frames.items.len - 1).trunc(u32)))
        if ent.kind is .Dir {
            sub := Fs.open_dir(path.items) else e => {
                yield(!e)
                continue
            }
            frames.push(Frame(dir: sub, path_len: path.items.len)) else {
                Fs.close_dir(sub)
                yield(!.NoSpace)
                return
            }
        }
    }
}

/// Creates the directory `path` and any missing parents, like `mkdir -p`. Directories that
/// exist already are fine; something else at `path`, or at one of its parents, is an
/// error.
pub make_dir_all :: fn(path: string) -> IoError!() needs Fs {
    i: usize = 0
    while i < path.len {
        // The next prefix ends before a separator, or at the end of the path.
        while i < path.len and path[i] is '/' { i += 1 }
        if i >= path.len { break }
        while i < path.len and path[i] is not '/' { i += 1 }
        prefix := path[0..i]
        Fs.make_dir(prefix) else e => {
            if e is not .AlreadyExists { return !e }
            info := try Fs.stat(prefix)
            if info.kind is not .Dir { return !e }
        }
    }
    return ()
}

/// Replaces the contents of the file at `path` with `bytes` so that no reader ever sees a
/// partial file: the bytes go to a new file next to `path` (named after it with a random
/// suffix), which is synced and then renamed over `path`. The new file is removed again
/// if anything fails. The suffix comes from the `Rand` effect. `path` may be at most 4000
/// bytes long (`InvalidInput` otherwise).
pub write_atomic :: fn(path: string, bytes: []const u8) -> IoError!() needs Fs + Rand {
    // `path`, ".tmp-" and eight hex digits.
    SUFFIX :: 13
    name: [4096]u8 = ---
    if path.len > 4000 { return !.InvalidInput }
    name[0..path.len].copy_from(path)
    tmp := name[0..path.len + SUFFIX]
    tmp[path.len..path.len + 5].copy_from(".tmp-")
    opts := OpenOptions(read: false, write: true, create: true, exclusive: true)
    tries: u32 = 0
    f: File = ---
    while true {
        r: [4]u8 = ---
        Rand.fill(r[..])
        for i in 0..4 {
            tmp[path.len + 5 + 2 * i] = hex_digit(r[i] >> 4)
            tmp[path.len + 6 + 2 * i] = hex_digit(r[i] & 15)
        }
        f = Fs.open(tmp, opts) else e => {
            // A name that is taken: try another.
            if e is .AlreadyExists and tries < 8 {
                tries += 1
                continue
            }
            return !e
        }
        break
    }
    fill_temp(f, bytes) else e => {
        Fs.close(f)
        _ = Fs.remove(tmp)
        return !e
    }
    Fs.close(f)
    Fs.rename(tmp, path) else e => {
        _ = Fs.remove(tmp)
        return !e
    }
    return ()
}

fill_temp :: fn(f: File, bytes: []const u8) -> IoError!() needs Fs {
    try write_all_to(f, bytes)
    return f.sync()
}

hex_digit :: fn(v: u8) -> u8 => if v < 10 { '0' + v } else { 'a' + v - 10 }
