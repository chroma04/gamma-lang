//! Time zones: converting between UTC and local civil time with TZif data.
//!
//! A `Zone` is the rules of one place, read from a TZif file (RFC 8536, versions 1 to 4,
//! such as the files of the IANA time zone database) or from a POSIX `TZ` rule like
//! `CET-1CEST,M3.5.0,M10.5.0/3`. `offset_at` gives the offset from UTC in force at an
//! instant, `to_local` turns a UTC `DateTime` into the local one, and `from_local` goes
//! back, reporting a local time that happens twice (the clocks went back) or never (they
//! went forward) rather than guessing.
//!
//!     zone :: import "std/time/zone"
//!     time :: import "std/time"
//!
//!     paris := try zone.load("Europe/Paris")                  // needs Fs + Env + Alloc
//!     defer zone.deinit(&paris)
//!     local := zone.to_local(&paris, time.now())              // needs Clock
//!     buf: [zone.RFC3339_LOCAL_LEN]u8 = ---
//!     print("{}\n", zone.format_rfc3339_local(local, buf[..]))   // 2024-05-17T11:30:00+02:00
//!     match zone.from_local(&paris, local.time) {
//!         .Unique(secs) => print("{}\n", secs)
//!         _ => print("ambiguous or missing\n")
//!     }
//!
//! Instants are Unix seconds (`i64`), so every conversion works over the whole range of
//! `DateTime` and not only the years that `time.to_unix`'s nanoseconds reach;
//! `secs_from_datetime` and `datetime_from_secs` convert a `DateTime` (UTC) to and from
//! them. Nanoseconds are carried along unchanged by `to_local` and ignored by `from_local`.
//!
//! A zone owns its tables, allocated from the allocator that was current when it was
//! created, and `deinit` releases them; nothing else allocates and no operation on an
//! existing zone can fail. `utc` and `fixed` need no allocation and their `deinit` does
//! nothing. Leap seconds, which some TZif files record, are skipped: like `std/time`, a
//! zone counts every day as 86400 seconds, so the "right/" variants of the database
//! give instants up to a few tens of seconds off. The rules apply for the whole range of
//! instants: before the first recorded transition the first local time type is in force,
//! after the last one the footer rule, or the last transition's type if the footer is
//! empty.

time :: import "std/time"
fs :: import "std/fs"

/// Why a zone could not be made.
pub ZoneError :: union {
    /// The file could not be read.
    Io: IoError
    /// The tables could not be allocated.
    Alloc: AllocError
    /// The TZif data (or the rule string) is malformed; the byte offset where it is, or 0
    /// when it is not tied to one place.
    Invalid: usize
}

/// The offset from UTC in force at some instant.
pub Offset :: struct {
    /// Seconds east of UTC.
    pub seconds: i32
    /// Whether this is daylight saving time.
    pub is_dst: bool
    /// The abbreviation in use (`CET`, `CEST`, `+03`). It points into the zone it came
    /// from and is valid until `deinit`. Empty for a zone made by `fixed` (other than
    /// `fixed(0)`, which is `UTC`).
    pub abbreviation: string
}

/// A local date and time together with the offset that was applied to UTC to get it.
pub LocalTime :: struct {
    pub time: time.DateTime
    pub offset: Offset
}

/// What a local time means in a zone, as Unix seconds.
pub Resolved :: union {
    /// The local time happens once.
    Unique: i64
    /// The clocks went back and the local time happens twice: the earlier and the later
    /// instant.
    Ambiguous: (earlier: i64, later: i64)
    /// The clocks went forward and the local time never happens. The values are the
    /// time read with the offset before the gap and with the offset after it (so `before`
    /// is the later instant when the clocks went forward).
    Missing: (before: i64, after: i64)
}

// A local time type: an offset, the DST flag, and the abbreviation as a range of `abbrs`.
LType :: struct {
    off: i32
    dst: u8
    abbr_start: u32
    abbr_len: u32
}

// A day of the year in a POSIX rule: `kind` 0 is `Jn` (1 to 365, February 29 not counted,
// in `day`), 1 is `n` (0 to 365, counted), 2 is `Mm.w.d`.
Spec :: struct {
    kind: u8
    month: u8
    week: u8
    wday: u8
    day: u16
    // Seconds after midnight local time; any sign and size up to 167 hours.
    at: i32
}

// A POSIX TZ rule. `has` is false for "no rule".
Rule :: struct {
    has: bool
    has_dst: bool
    std_abbr: string
    std_off: i32
    dst_abbr: string
    dst_off: i32
    start: Spec
    end: Spec
}

/// The rules of a time zone. Make one with `load`, `local`, `parse`, `from_tz_string`,
/// `utc` or `fixed`; release it with `deinit`.
pub Zone :: struct {
    times: []i64
    idx: []u8
    types: []LType
    abbrs: []u8
    rule: Rule
    alloc: ?Allocator
}

no_spec :: fn() -> Spec {
    return Spec(kind: 0, month: 0, week: 0, wday: 0, day: 0, at: 0)
}

no_rule :: fn() -> Rule {
    return Rule(has: false, has_dst: false, std_abbr: "", std_off: 0, dst_abbr: "", dst_off: 0, start: no_spec(), end: no_spec())
}

empty_zone :: fn() -> Zone {
    return Zone(times: empty_slice(i64), idx: empty_slice(u8), types: empty_slice(LType), abbrs: empty_slice(u8), rule: no_rule(), alloc: null)
}

// ---------------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------------

fdiv :: fn(a, b: i64) -> i64 {
    q := a / b
    if a % b < 0 { q -= 1 }
    return q
}

fmod :: fn(a, b: i64) -> i64 {
    r := a % b
    if r < 0 { r += b }
    return r
}

/// The Unix seconds of `t`, a date and time in UTC; its nanoseconds are ignored.
pub secs_from_datetime :: fn(t: time.DateTime) -> i64 {
    return time.days_from_civil(t.date) * 86400 + i64(t.hour) * 3600 + i64(t.minute) * 60 + i64(t.second)
}

/// The date and time in UTC of Unix seconds `s`, with `nanosecond` carried over. Traps if
/// the year does not fit an `i32`.
pub datetime_from_secs :: fn(s: i64, nanosecond: u32 = 0) -> time.DateTime {
    rem := fmod(s, 86400)
    return time.DateTime(
        date: time.civil_from_days(fdiv(s, 86400)),
        hour: (rem / 3600).trunc(u8),
        minute: (rem / 60 % 60).trunc(u8),
        second: (rem % 60).trunc(u8),
        nanosecond: nanosecond,
    )
}

// ---------------------------------------------------------------------------------
// POSIX TZ rules
// ---------------------------------------------------------------------------------

is_alpha :: fn(c: u8) -> bool => (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

is_digit :: fn(c: u8) -> bool => c >= '0' and c <= '9'

// An abbreviation at `s[p^..]`: three or more letters, or three or more letters, digits,
// `+` and `-` between `<` and `>`. Errors are the byte index.
read_name :: fn(s: string, p: ^usize) -> usize!string {
    start := p^
    if start < s.len and s[start] is '<' {
        i := start + 1
        while i < s.len and s[i] is not '>' {
            c := s[i]
            if not (is_alpha(c) or is_digit(c) or c is '+' or c is '-') { return !i }
            i += 1
        }
        if i >= s.len { return !s.len }
        if i - start - 1 < 3 { return !start }
        p^ = i + 1
        return s[start + 1..i]
    }
    i := start
    while i < s.len and is_alpha(s[i]) { i += 1 }
    if i - start < 3 { return !start }
    p^ = i
    return s[start..i]
}

// Decimal digits at `s[p^..]`, at least one and at most `max_digits` of them, with a
// value of at most `max`.
read_num :: fn(s: string, p: ^usize, max_digits: usize, max: u32) -> usize!u32 {
    start := p^
    v: u32 = 0
    i := start
    while i < s.len and is_digit(s[i]) and i - start < max_digits {
        v = v * 10 + u32(s[i] - '0')
        i += 1
    }
    if i is start { return !start }
    if v > max { return !start }
    p^ = i
    return v
}

// `[+-]hh[:mm[:ss]]` with the hour at most `max_hours`, as signed seconds.
read_hms :: fn(s: string, p: ^usize, max_hours: u32) -> usize!i32 {
    sign: i32 = 1
    if p^ < s.len and (s[p^] is '+' or s[p^] is '-') {
        if s[p^] is '-' { sign = -1 }
        p^ += 1
    }
    h := try read_num(s, p, 3, max_hours)
    m: u32 = 0
    sec: u32 = 0
    if p^ < s.len and s[p^] is ':' {
        p^ += 1
        m = try read_num(s, p, 2, 59)
        if p^ < s.len and s[p^] is ':' {
            p^ += 1
            sec = try read_num(s, p, 2, 59)
        }
    }
    total := (h * 3600 + m * 60 + sec).trunc(i32)
    return sign * total
}

// One `Jn`, `n` or `Mm.w.d` with an optional `/time`.
read_spec :: fn(s: string, p: ^usize) -> usize!Spec {
    sp := no_spec()
    if p^ >= s.len { return !s.len }
    c := s[p^]
    if c is 'M' {
        p^ += 1
        sp.kind = 2
        sp.month = (try read_num(s, p, 2, 12)).trunc(u8)
        if sp.month is 0 { return !(p^ - 1) }
        if p^ >= s.len or s[p^] is not '.' { return !p^ }
        p^ += 1
        sp.week = (try read_num(s, p, 1, 5)).trunc(u8)
        if sp.week is 0 { return !(p^ - 1) }
        if p^ >= s.len or s[p^] is not '.' { return !p^ }
        p^ += 1
        sp.wday = (try read_num(s, p, 1, 6)).trunc(u8)
    } else if c is 'J' {
        p^ += 1
        sp.kind = 0
        sp.day = (try read_num(s, p, 3, 365)).trunc(u16)
        if sp.day is 0 { return !(p^ - 1) }
    } else {
        sp.kind = 1
        sp.day = (try read_num(s, p, 3, 365)).trunc(u16)
    }
    sp.at = 7200
    if p^ < s.len and s[p^] is '/' {
        p^ += 1
        sp.at = try read_hms(s, p, 167)
    }
    return sp
}

// Parses a whole POSIX TZ string. The abbreviations in the result point into `s`.
parse_rule :: fn(s: string) -> usize!Rule {
    r := no_rule()
    p: usize = 0
    r.std_abbr = try read_name(s, &p)
    r.std_off = -(try read_hms(s, &p, 24))
    r.has = true
    if p >= s.len { return r }
    r.has_dst = true
    r.dst_abbr = try read_name(s, &p)
    r.dst_off = r.std_off + 3600
    if p < s.len and s[p] is not ',' { r.dst_off = -(try read_hms(s, &p, 24)) }
    if p >= s.len {
        // No rule given: the United States rule, as the C library does.
        r.start = Spec(kind: 2, month: 3, week: 2, wday: 0, day: 0, at: 7200)
        r.end = Spec(kind: 2, month: 11, week: 1, wday: 0, day: 0, at: 7200)
        return r
    }
    p += 1
    r.start = try read_spec(s, &p)
    if p >= s.len or s[p] is not ',' { return !p }
    p += 1
    r.end = try read_spec(s, &p)
    if p < s.len { return !p }
    return r
}

// The day (since 1970-01-01) that `sp` names in `year`.
spec_day :: fn(sp: Spec, year: i32) -> i64 {
    jan1 := time.days_from_civil(time.Date(year: year, month: 1, day: 1))
    if sp.kind is 0 {
        d := i64(sp.day) - 1
        if time.is_leap_year(year) and sp.day >= 60 { d += 1 }
        return jan1 + d
    }
    if sp.kind is 1 { return jan1 + i64(sp.day) }
    first := time.days_from_civil(time.Date(year: year, month: sp.month, day: 1))
    first_wday := fmod(first + 4, 7)                            // 0 is Sunday; 1970-01-01 was a Thursday
    d := first + fmod(i64(sp.wday) - first_wday, 7) + (i64(sp.week) - 1) * 7
    len := i64(time.days_in_month(year, sp.month))
    while d >= first + len { d -= 7 }
    return d
}

// The offset the rule gives at Unix time `t`.
rule_offset :: fn(r: ^const Rule, t: i64) -> Offset {
    if not r.has_dst { return Offset(seconds: r.std_off, is_dst: false, abbreviation: r.std_abbr) }
    // Keep the year inside an `i32`.
    limit: i64 = 60_000_000_000_000_000
    tc := if t > limit { limit } else if t < -limit { -limit } else { t }
    year := time.civil_from_days(fdiv(tc + i64(r.std_off), 86400)).year
    start := spec_day(r.start, year) * 86400 + i64(r.start.at) - i64(r.std_off)
    end := spec_day(r.end, year) * 86400 + i64(r.end.at) - i64(r.dst_off)
    in_dst := if start < end { t >= start and t < end } else { t >= start or t < end }
    if in_dst { return Offset(seconds: r.dst_off, is_dst: true, abbreviation: r.dst_abbr) }
    return Offset(seconds: r.std_off, is_dst: false, abbreviation: r.std_abbr)
}

// ---------------------------------------------------------------------------------
// Making and releasing zones
// ---------------------------------------------------------------------------------

/// UTC: offset 0, abbreviation `UTC`. No allocation.
pub utc :: fn() -> Zone => fixed(0)

/// A zone with a constant offset from UTC (`seconds` east of it), the abbreviation empty
/// (`UTC` for 0). No allocation.
pub fixed :: fn(seconds: i32) -> Zone {
    z := empty_zone()
    z.rule.has = true
    z.rule.std_off = seconds
    z.rule.std_abbr = if seconds is 0 { "UTC" } else { "" }
    return z
}

alloc_slice :: fn(T: type, n: usize) -> AllocError![]T needs Alloc where Plain(T) {
    if n is 0 { return empty_slice(T) }
    return make(T, n)
}

release :: fn(T: type, a: Allocator, s: []T) {
    if s.len > 0 { a.vt.free(a.data, s.ptr.cast([^]u8), @size_of(T) * s.len, @align_of(T)) }
}

/// Releases the zone's tables through the allocator it was made with; the zone is `utc()`
/// afterwards. Does nothing for the zones of `utc` and `fixed`.
pub deinit :: fn(z: ^Zone) {
    if a := z.alloc {
        release(a, z.times)
        release(a, z.idx)
        release(a, z.types)
        release(a, z.abbrs)
    }
    z^ = utc()
}

/// A zone from a POSIX TZ string such as `CET-1CEST,M3.5.0,M10.5.0/3` or `<+03>-3`: the
/// standard abbreviation and offset (hours west of UTC, so `EST5` is UTC-5), optionally
/// followed by a daylight saving abbreviation, its offset (one hour more than the standard
/// one if left out) and the rule for when it starts and ends, `Mm.w.d` (month, week 1 to 5
/// with 5 the last, weekday from 0 for Sunday), `Jn` (day 1 to 365, February 29 never
/// counted) or `n` (day 0 to 365, February 29 counted), each with `/time` after it
/// (default 02:00; a sign and an hour up to 167 are allowed). With a daylight saving
/// abbreviation and no rule, the United States rule applies (`M3.2.0,M11.1.0`). The rule
/// is evaluated per calendar year, so a start or end time that reaches into another
/// year is not followed there.
///
/// `Invalid(i)` is the byte index of the first thing that does not fit.
pub from_tz_string :: fn(s: string) -> ZoneError!Zone needs Alloc {
    rule := parse_rule(s) else e => { return !.Invalid(e) }
    z := empty_zone()
    z.alloc = Alloc.current()
    try give_rule(&z, rule, 0)
    return z
}

// Stores `rule` in `z`, with its abbreviations copied to the end of `z.abbrs`, which is
// allocated here with `base` bytes in front of them (the caller fills those). Without a
// rule only the `base` bytes are allocated.
give_rule :: fn(z: ^Zone, rule: Rule, base: usize) -> ZoneError!() needs Alloc {
    z.rule = rule
    n1 := rule.std_abbr.len
    n2 := rule.dst_abbr.len
    z.abbrs = alloc_slice(u8, base + n1 + n2) else e => {
        deinit(z)
        return !.Alloc(e)
    }
    if not rule.has { return () }
    z.abbrs[base..base + n1].copy_from(rule.std_abbr)
    z.abbrs[base + n1..base + n1 + n2].copy_from(rule.dst_abbr)
    z.rule.std_abbr = z.abbrs[base..base + n1]
    z.rule.dst_abbr = z.abbrs[base + n1..base + n1 + n2]
    return ()
}

// ---------------------------------------------------------------------------------
// TZif
// ---------------------------------------------------------------------------------

be32 :: fn(d: []const u8, p: usize) -> u32 {
    return (u32(d[p]) << 24) | (u32(d[p + 1]) << 16) | (u32(d[p + 2]) << 8) | u32(d[p + 3])
}

be64 :: fn(d: []const u8, p: usize) -> u64 => (u64(be32(d, p)) << 32) | u64(be32(d, p + 4))

Header :: struct {
    version: u8
    at: usize
    isut: usize
    isstd: usize
    leap: usize
    timecnt: usize
    typecnt: usize
    charcnt: usize
}

read_header :: fn(d: []const u8, at: usize) -> ZoneError!Header {
    if at > d.len or d.len - at < 44 { return !.Invalid(d.len) }
    if d[at] is not 'T' or d[at + 1] is not 'Z' or d[at + 2] is not 'i' or d[at + 3] is not 'f' { return !.Invalid(at) }
    v := d[at + 4]
    if v is not 0 and v is not '2' and v is not '3' and v is not '4' { return !.Invalid(at + 4) }
    h := Header(
        version: v,
        at: at,
        isut: usize(be32(d, at + 20)),
        isstd: usize(be32(d, at + 24)),
        leap: usize(be32(d, at + 28)),
        timecnt: usize(be32(d, at + 32)),
        typecnt: usize(be32(d, at + 36)),
        charcnt: usize(be32(d, at + 40)),
    )
    if h.typecnt is 0 { return !.Invalid(at + 36) }
    if h.charcnt is 0 { return !.Invalid(at + 40) }
    if h.isut is not 0 and h.isut is not h.typecnt { return !.Invalid(at + 20) }
    if h.isstd is not 0 and h.isstd is not h.typecnt { return !.Invalid(at + 24) }
    return h
}

// The size of the data block that follows a header. The counts are below 2^32, so this
// cannot overflow a 64-bit `usize`; on a narrower one the check against the data length
// would see a wrapped value, hence the `end < body` test in `parse`.
block_len :: fn(h: Header, wide: bool) -> usize {
    tw: usize = if wide { 8 } else { 4 }
    lw: usize = if wide { 12 } else { 8 }
    return h.timecnt * tw + h.timecnt + h.typecnt * 6 + h.charcnt + h.leap * lw + h.isstd + h.isut
}

// Fills the tables of `z` (already allocated to the sizes in `h`) from the block at `body`.
fill :: fn(z: ^Zone, d: []const u8, h: Header, body: usize, wide: bool) -> ZoneError!() {
    tw: usize = if wide { 8 } else { 4 }
    for i in 0..h.timecnt {
        p := body + i * tw
        t: i64 = if wide { be64(d, p).trunc(i64) } else { i64(be32(d, p).trunc(i32)) }
        if i > 0 and t <= z.times[i - 1] { return !.Invalid(p) }
        z.times[i] = t
    }
    ipos := body + h.timecnt * tw
    for i in 0..h.timecnt {
        v := d[ipos + i]
        if usize(v) >= h.typecnt { return !.Invalid(ipos + i) }
        z.idx[i] = v
    }
    tpos := ipos + h.timecnt
    cpos := tpos + h.typecnt * 6
    z.abbrs[0..h.charcnt].copy_from(d[cpos..cpos + h.charcnt])
    for i in 0..h.typecnt {
        p := tpos + i * 6
        off := be32(d, p).trunc(i32)
        if off is @min_value(i32) { return !.Invalid(p) }
        if d[p + 4] > 1 { return !.Invalid(p + 4) }
        ai := usize(d[p + 5])
        if ai >= h.charcnt { return !.Invalid(p + 5) }
        e := ai
        while e < h.charcnt and z.abbrs[e] is not 0 { e += 1 }
        if e >= h.charcnt { return !.Invalid(cpos + ai) }
        z.types[i] = LType(off: off, dst: d[p + 4], abbr_start: ai.trunc(u32), abbr_len: (e - ai).trunc(u32))
    }
    return ()
}

/// A zone from the bytes of a TZif file (RFC 8536 versions 1 to 4). The data is copied and
/// may be freed afterwards. Version 2 and later files are read from their 64-bit block
/// and footer, version 1 files from their 32-bit one. The footer, a POSIX TZ string (see
/// `from_tz_string`), gives the rule for instants after the last transition. Leap second
/// records and the standard/wall and UT/local indicators are skipped.
///
/// `Invalid(i)` is the byte offset in `data` of the field that is wrong (the length of
/// `data` if it ends too early): the magic or version, a count that is zero where it must
/// not be, transitions out of order, a type index or abbreviation index out of range, or
/// a footer that is not a rule.
pub parse :: fn(data: []const u8) -> ZoneError!Zone needs Alloc {
    h1 := try read_header(data, 0)
    h := h1
    wide := false
    if h1.version is not 0 {
        h = try read_header(data, 44 + block_len(h1, false))
        wide = true
    }
    body := h.at + 44
    end := body + block_len(h, wide)
    if end > data.len or end < body { return !.Invalid(data.len) }
    rule := no_rule()
    if wide {
        if end >= data.len or data[end] is not '\n' { return !.Invalid(end) }
        j := end + 1
        while j < data.len and data[j] is not '\n' { j += 1 }
        if j >= data.len { return !.Invalid(data.len) }
        footer := data[end + 1..j]
        if footer.len > 0 {
            rule = parse_rule(footer) else e => { return !.Invalid(end + 1 + e) }
        }
    }
    z := empty_zone()
    z.alloc = Alloc.current()
    try give_rule(&z, rule, h.charcnt)
    z.times = alloc_slice(i64, h.timecnt) else e => {
        deinit(&z)
        return !.Alloc(e)
    }
    z.idx = alloc_slice(u8, h.timecnt) else e => {
        deinit(&z)
        return !.Alloc(e)
    }
    z.types = alloc_slice(LType, h.typecnt) else e => {
        deinit(&z)
        return !.Alloc(e)
    }
    fill(&z, data, h, body, wide) else e => {
        deinit(&z)
        return !e
    }
    return z
}

// ---------------------------------------------------------------------------------
// Loading
// ---------------------------------------------------------------------------------

// Whether `name` is a relative path without `..` components.
name_is_safe :: fn(name: string) -> bool {
    if name.len is 0 or name[0] is '/' { return false }
    start: usize = 0
    for i in 0..=name.len {
        if i is name.len or name[i] is '/' {
            if i - start is 2 and name[start] is '.' and name[start + 1] is '.' { return false }
            start = i + 1
        }
    }
    return true
}

// Reads and parses the file at `path`.
load_file :: fn(path: string) -> ZoneError!Zone needs Fs + Alloc {
    data := fs.read_all(path) else e => {
        match e {
            .Io(io) => { return !.Io(io) }
            .Alloc(a) => { return !.Alloc(a) }
        }
    }
    defer free(data)
    return parse(data)
}

/// Loads the zone `name` (such as `Europe/Paris`) from the directory `dir`. A name that is
/// empty, begins with `/` or has a `..` component, or a path longer than 4095 bytes, is
/// `Io(InvalidInput)`.
pub load_from :: fn(dir, name: string) -> ZoneError!Zone needs Fs + Alloc {
    if not name_is_safe(name) { return !.Io(.InvalidInput) }
    buf: [4096]u8 = ---
    sep: usize = if dir.len > 0 and dir[dir.len - 1] is not '/' { 1 } else { 0 }
    n := dir.len + sep + name.len
    if n > buf.len - 1 { return !.Io(.InvalidInput) }
    buf[0..dir.len].copy_from(dir)
    if sep is 1 { buf[dir.len] = '/' }
    buf[dir.len + sep..n].copy_from(name)
    return load_file(buf[0..n])
}

/// Loads the zone `name` from `$TZDIR` if that is set and not empty, otherwise from
/// `/usr/share/zoneinfo`. See `load_from` for the names that are rejected; a missing zone
/// is `Io(NotFound)`.
pub load :: fn(name: string) -> ZoneError!Zone needs Fs + Env + Alloc {
    dir := Env.var("TZDIR") else "/usr/share/zoneinfo"
    return load_from(if dir.len is 0 { "/usr/share/zoneinfo" } else { dir }, name)
}

// A zone that is not there is UTC; other errors stay.
missing_is_utc :: fn(r: ZoneError!Zone) -> ZoneError!Zone {
    z := r else e => {
        match e {
            .Io(.NotFound) => { return utc() }
            .Io(.InvalidInput) => { return utc() }
            _ => { return !e }
        }
    }
    return z
}

/// The zone the environment asks for, as the C library reads it:
///
/// - `$TZ` unset: the file `/etc/localtime`;
/// - `$TZ` empty: UTC;
/// - `$TZ` as `:name`: the zone `name` as `load` finds it;
/// - `$TZ` as anything else: the zone `name` if there is one, otherwise the string as a
///   POSIX TZ rule (see `from_tz_string`).
///
/// A zone that does not exist, and a `$TZ` that is neither a zone nor a rule, give UTC; only
/// data that exists and is malformed, or running out of memory, is an error.
pub local :: fn() -> ZoneError!Zone needs Fs + Env + Alloc {
    tz := Env.var("TZ") else {
        return missing_is_utc(load_file("/etc/localtime"))
    }
    if tz.len is 0 { return utc() }
    if tz[0] is ':' { return missing_is_utc(load(tz[1..tz.len])) }
    return from_name_or_rule(tz)
}

from_name_or_rule :: fn(tz: string) -> ZoneError!Zone needs Fs + Env + Alloc {
    z := load(tz) else e => {
        match e {
            .Io(_) => {
                return from_tz_string(tz) else e2 => {
                    match e2 {
                        .Alloc(a) => { return !.Alloc(a) }
                        _ => { return utc() }
                    }
                }
            }
            _ => { return !e }
        }
    }
    return z
}

// ---------------------------------------------------------------------------------
// Conversions
// ---------------------------------------------------------------------------------

of_type :: fn(z: ^const Zone, i: usize) -> Offset {
    ty := z.types[i]
    return Offset(seconds: ty.off, is_dst: ty.dst is 1, abbreviation: z.abbrs[ty.abbr_start..ty.abbr_start + ty.abbr_len])
}

/// The offset from UTC in force at the instant `unix_seconds`.
///
/// Before the first transition of the table the first local time type is in force; from
/// the last transition on, the footer rule (or the last transition's type if there is
/// none).
pub offset_at :: fn(z: ^const Zone, unix_seconds: i64) -> Offset {
    n := z.times.len
    if n is 0 {
        if z.rule.has { return rule_offset(&z.rule, unix_seconds) }
        if z.types.len > 0 { return of_type(z, 0) }
        return Offset(seconds: 0, is_dst: false, abbreviation: "UTC")
    }
    if unix_seconds < z.times[0] { return of_type(z, 0) }
    if unix_seconds >= z.times[n - 1] and z.rule.has { return rule_offset(&z.rule, unix_seconds) }
    // The last transition at or before the instant.
    lo: usize = 0
    hi := n
    while hi - lo > 1 {
        mid := lo + (hi - lo) / 2
        if z.times[mid] <= unix_seconds { lo = mid } else { hi = mid }
    }
    return of_type(z, usize(z.idx[lo]))
}

/// The local date and time at the UTC instant `t`, with the offset that was applied.
/// Traps if the local year does not fit an `i32`.
pub to_local :: fn(z: ^const Zone, t: time.DateTime) -> LocalTime {
    secs := secs_from_datetime(t)
    off := offset_at(z, secs)
    return LocalTime(time: datetime_from_secs(secs + i64(off.seconds), t.nanosecond), offset: off)
}

/// What the local (wall clock) date and time `local` is in `z`: one instant (`Unique`),
/// two (`Ambiguous`, when the clocks went back over it) or none (`Missing`, when they
/// went forward over it). Only whole seconds count.
///
/// The offsets in force one day before and one day after the local time (read as UTC) are
/// the candidates, so two transitions less than two days apart around `local` are not
/// told apart.
pub from_local :: fn(z: ^const Zone, local: time.DateTime) -> Resolved {
    l := secs_from_datetime(local)
    before := offset_at(z, l - 86400).seconds
    after := offset_at(z, l + 86400).seconds
    ua := l - i64(before)
    ub := l - i64(after)
    ok1 := offset_at(z, ua).seconds is before
    ok2 := offset_at(z, ub).seconds is after
    if before is after {
        if ok1 { return Resolved.Unique(ua) }
        return Resolved.Missing(before: ua, after: ub)
    }
    if ok1 and ok2 {
        if ua < ub { return Resolved.Ambiguous(earlier: ua, later: ub) }
        return Resolved.Ambiguous(earlier: ub, later: ua)
    }
    if ok1 { return Resolved.Unique(ua) }
    if ok2 { return Resolved.Unique(ub) }
    return Resolved.Missing(before: ua, after: ub)
}

// ---------------------------------------------------------------------------------
// Text
// ---------------------------------------------------------------------------------

/// The size of a buffer that always holds the output of `format_rfc3339_local`.
pub RFC3339_LOCAL_LEN :: time.RFC3339_LEN + 5

/// Formats `t` as RFC 3339 with its numeric offset, `2024-05-17T11:30:00+02:00`, into `buf`
/// and returns the bytes written. The fraction follows the rules of `time.format_rfc3339`.
/// `Z` is never used: UTC is `+00:00`. RFC 3339 offsets have only hours and minutes, so an
/// offset with seconds (the "local mean time" of old dates) is rounded to the nearest
/// minute, half away from zero. The offset must be less than 100 hours. Traps if `buf` is
/// too small (`RFC3339_LOCAL_LEN` bytes always suffice).
pub format_rfc3339_local :: fn(t: LocalTime, buf: []u8) -> string {
    s := time.format_rfc3339(t.time, buf)
    p := s.len - 1                                              // the `Z`
    if p + 6 > buf.len { trap("zone: buffer too small for the formatted text") }
    off := i64(t.offset.seconds)
    mag := if off < 0 { -off } else { off }
    mins := (mag + 30) / 60
    assert(mins < 6000, "zone: offset of 100 hours or more")
    buf[p] = if off < 0 and mins > 0 { '-' } else { '+' }
    buf[p + 1] = '0' + (mins / 600).trunc(u8)
    buf[p + 2] = '0' + (mins / 60 % 10).trunc(u8)
    buf[p + 3] = ':'
    buf[p + 4] = '0' + (mins % 60 / 10).trunc(u8)
    buf[p + 5] = '0' + (mins % 10).trunc(u8)
    return buf[0..p + 6]
}
