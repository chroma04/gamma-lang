//! Calendar dates and times, RFC 3339 text, and durations as text.
//!
//! Dates are in the proleptic Gregorian calendar and times are UTC: there are no time
//! zones (they need the tz database), no leap seconds and no daylight saving. `Clock`'s
//! `wall()` is Unix time in nanoseconds, which `from_unix` turns into a `DateTime` and
//! `to_unix` back. Everything is plain arithmetic: nothing allocates, and only `now`
//! performs an effect. Text goes into a buffer the caller supplies and the result is the
//! slice written; each kind of output has a constant giving a size that always suffices.
//!
//!     time :: import "std/time"
//!     t := time.now()                                    // \ {Clock}
//!     buf: [time.RFC3339_LEN]u8 = ---
//!     print("{}\n", time.format_rfc3339(t, buf[..]))     // 2024-05-17T09:30:00Z
//!     d := try time.parse_date("2024-02-29")
//!     next := time.add_months(d, 12)                     // 2025-02-28

// ---------------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------------

/// A day of the week.
pub Weekday :: union { Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday }

/// A calendar date. Functions that take a `Date` expect a valid one (see `is_valid`)
/// unless they say otherwise.
pub Date :: struct {
    pub year: i32
    /// 1 to 12.
    pub month: u8
    /// 1 to 31, and at most the length of the month.
    pub day: u8
}

/// A date with a time of day in UTC.
pub DateTime :: struct {
    pub date: Date
    /// 0 to 23.
    pub hour: u8
    /// 0 to 59.
    pub minute: u8
    /// 0 to 59.
    pub second: u8
    /// 0 to 999_999_999.
    pub nanosecond: u32
}

NS_PER_SEC: i64 : 1_000_000_000
NS_PER_DAY: i64 : 86_400_000_000_000

// Division and remainder that round toward negative infinity (`b` > 0).
floor_div :: fn(a, b: i64) -> i64 {
    q := a / b
    if a % b < 0 { q -= 1 }
    return q
}

floor_mod :: fn(a, b: i64) -> i64 {
    r := a % b
    if r < 0 { r += b }
    return r
}

/// Whether `year` is a leap year: divisible by 4, except centuries not divisible by 400.
pub is_leap_year :: fn(year: i32) -> bool {
    if year % 4 is not 0 { return false }
    if year % 100 is not 0 { return true }
    return year % 400 is 0
}

/// The number of days in `month` (1 to 12) of `year`.
pub days_in_month :: fn(year: i32, month: u8) -> u8 {
    assert(month >= 1 and month <= 12, "time.days_in_month: month out of range")
    if month is 2 { return if is_leap_year(year) { 29 } else { 28 } }
    if month is 4 or month is 6 or month is 9 or month is 11 { return 30 }
    return 31
}

/// Whether `d` names a real day: the month is 1 to 12 and the day is within the month.
pub is_valid :: fn(d: Date) -> bool {
    if d.month < 1 or d.month > 12 { return false }
    return d.day >= 1 and d.day <= days_in_month(d.year, d.month)
}

/// The number of days from 1970-01-01 to `d`, negative before it (Howard Hinnant's
/// `days_from_civil`).
pub days_from_civil :: fn(d: Date) -> i64 {
    m := i64(d.month)
    y := i64(d.year)
    if m <= 2 { y -= 1 }
    era := floor_div(y, 400)
    yoe := y - era * 400                                        // [0, 399]
    mp := if m > 2 { m - 3 } else { m + 9 }                     // March is 0
    doy := (153 * mp + 2) / 5 + i64(d.day) - 1                  // [0, 365]
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy                // [0, 146096]
    return era * 146097 + doe - 719468
}

/// The date `days` days after 1970-01-01 (before it when negative); the inverse of
/// `days_from_civil`.
pub civil_from_days :: fn(days: i64) -> Date {
    z := days + 719468
    era := floor_div(z, 146097)
    doe := z - era * 146097                                     // [0, 146096]
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365    // [0, 399]
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)              // [0, 365]
    mp := (5 * doy + 2) / 153                                   // [0, 11]
    day := doy - (153 * mp + 2) / 5 + 1
    month := if mp < 10 { mp + 3 } else { mp - 9 }
    year := yoe + era * 400 + (if month <= 2 { 1 } else { 0 })
    y := year.checked(i32) else trap("time.civil_from_days: year out of range")
    return Date(year: y, month: month.trunc(u8), day: day.trunc(u8))
}

/// The day of the week of `d`.
pub weekday :: fn(d: Date) -> Weekday {
    names := [_]Weekday(.Monday, .Tuesday, .Wednesday, .Thursday, .Friday, .Saturday, .Sunday)
    // 1970-01-01 was a Thursday, index 3 counting from Monday.
    return names[floor_mod(days_from_civil(d) + 3, 7).trunc(usize)]
}

/// `d` moved by `n` days, which may be negative.
pub add_days :: fn(d: Date, n: i64) -> Date => civil_from_days(days_from_civil(d) + n)

/// `d` moved by `n` months, which may be negative. The day is kept unless the target
/// month is shorter, when it becomes the last day of that month: January 31 plus one
/// month is February 28 or 29.
pub add_months :: fn(d: Date, n: i32) -> Date {
    total := i64(d.year) * 12 + i64(d.month) - 1 + i64(n)
    y := floor_div(total, 12).checked(i32) else trap("time.add_months: year out of range")
    m := (floor_mod(total, 12) + 1).trunc(u8)
    return Date(year: y, month: m, day: d.day.min(days_in_month(y, m)))
}

// ---------------------------------------------------------------------------------
// Unix time
// ---------------------------------------------------------------------------------

/// The date and time `ns` nanoseconds after 1970-01-01T00:00:00Z. Negative values round
/// toward the past: -1 is 1969-12-31T23:59:59.999999999.
pub from_unix :: fn(ns: i64) -> DateTime {
    days := floor_div(ns, NS_PER_DAY)
    rem := floor_mod(ns, NS_PER_DAY)                            // [0, NS_PER_DAY)
    secs := rem / NS_PER_SEC
    return DateTime(
        date: civil_from_days(days),
        hour: (secs / 3600).trunc(u8),
        minute: (secs / 60 % 60).trunc(u8),
        second: (secs % 60).trunc(u8),
        nanosecond: (rem % NS_PER_SEC).trunc(u32),
    )
}

/// The nanoseconds from 1970-01-01T00:00:00Z to `t`; the inverse of `from_unix`. Traps
/// if the result does not fit an `i64` (roughly the years 1678 to 2262).
pub to_unix :: fn(t: DateTime) -> i64 {
    secs := i64(t.hour) * 3600 + i64(t.minute) * 60 + i64(t.second)
    // The days alone can exceed an `i64` of nanoseconds while the sum fits (at the minimum).
    total := i128(days_from_civil(t.date)) * i128(NS_PER_DAY) + i128(secs) * i128(NS_PER_SEC) + i128(t.nanosecond)
    if total < i128(@min_value(i64)) or total > i128(@max_value(i64)) { trap("time: the date and time do not fit an i64 of nanoseconds") }
    return total.trunc(i64)
}

/// The current date and time from the `Clock`'s wall clock.
pub now :: fn() -> DateTime \ {Clock} => from_unix(wall())

// ---------------------------------------------------------------------------------
// Writing text
// ---------------------------------------------------------------------------------

// Writes `v` in decimal at `buf[pos..]` with at least `min` digits (zero padded) and
// returns the position after it.
put_uint :: fn(buf: []u8, pos: usize, v: u64, min: usize) -> usize {
    n: usize = 1
    rest := v / 10
    while rest > 0 {
        n += 1
        rest /= 10
    }
    if n < min { n = min }
    if pos + n > buf.len { trap("time: buffer too small for the formatted text") }
    x := v
    i := n
    while i > 0 {
        i -= 1
        buf[pos + i] = '0' + (x % 10).trunc(u8)
        x /= 10
    }
    return pos + n
}

put_byte :: fn(buf: []u8, pos: usize, c: u8) -> usize {
    if pos >= buf.len { trap("time: buffer too small for the formatted text") }
    buf[pos] = c
    return pos + 1
}

// Writes `YYYY-MM-DD` and returns the position after it.
put_date :: fn(buf: []u8, pos: usize, d: Date) -> usize {
    assert(d.year >= 0 and d.year <= 9999, "time: year outside 0..=9999")
    assert(is_valid(d), "time: invalid date")
    p := put_uint(buf, pos, d.year.trunc(u64), 4)
    p = put_byte(buf, p, '-')
    p = put_uint(buf, p, u64(d.month), 2)
    p = put_byte(buf, p, '-')
    return put_uint(buf, p, u64(d.day), 2)
}

// Writes `.` and `digits` fraction digits of `frac` (a value below 10^digits), or the
// shortest form of it when `trim` is set: trailing zeros are dropped and nothing at all
// is written for zero.
put_fraction :: fn(buf: []u8, pos: usize, frac: u64, digits: usize, trim: bool) -> usize {
    f := frac
    n := digits
    if trim {
        if f is 0 { return pos }
        while f % 10 is 0 {
            f /= 10
            n -= 1
        }
    }
    p := put_byte(buf, pos, '.')
    return put_uint(buf, p, f, n)
}

/// The size of a buffer that always holds the output of `format_rfc3339`:
/// `YYYY-MM-DDTHH:MM:SS.fffffffffZ`.
pub RFC3339_LEN :: 30

/// Formats `t` as RFC 3339 in UTC, `2024-05-17T09:30:00Z`, into `buf` and returns the
/// bytes written. A fraction is added only when `t.nanosecond` is not zero, with 3, 6
/// or 9 digits, the fewest that hold it exactly (`.500`, `.000001`). The year must be
/// in 0 to 9999 and the fields valid. Traps if `buf` is too small (`RFC3339_LEN` bytes
/// always suffice).
pub format_rfc3339 :: fn(t: DateTime, buf: []u8) -> string {
    assert(t.hour < 24 and t.minute < 60 and t.second < 60 and t.nanosecond < 1_000_000_000, "time: invalid time of day")
    p := put_date(buf, 0, t.date)
    p = put_byte(buf, p, 'T')
    p = put_uint(buf, p, u64(t.hour), 2)
    p = put_byte(buf, p, ':')
    p = put_uint(buf, p, u64(t.minute), 2)
    p = put_byte(buf, p, ':')
    p = put_uint(buf, p, u64(t.second), 2)
    ns := u64(t.nanosecond)
    if ns % 1_000_000 is 0 {
        if ns is not 0 { p = put_fraction(buf, p, ns / 1_000_000, 3, false) }
    } else if ns % 1_000 is 0 {
        p = put_fraction(buf, p, ns / 1_000, 6, false)
    } else {
        p = put_fraction(buf, p, ns, 9, false)
    }
    p = put_byte(buf, p, 'Z')
    return buf[0..p]
}

/// Formats `d` as `YYYY-MM-DD` into `buf` (10 bytes suffice) and returns the bytes
/// written. The year must be in 0 to 9999.
pub format_date :: fn(d: Date, buf: []u8) -> string => buf[0..put_date(buf, 0, d)]

// ---------------------------------------------------------------------------------
// Parsing text
// ---------------------------------------------------------------------------------

/// Why parsing a date or time failed.
pub ParseError :: union {
    /// The text does not have the expected shape; the byte index of the first byte that
    /// does not fit, or the length of the text if it ended too early.
    Syntax: usize
    /// The shape is right but a field is out of range (month 13, hour 24, February 30);
    /// the byte index where that field starts. A text with a syntax error reports it
    /// before any range error.
    Range: usize
}

// The value of the `n` decimal digits at `s[at..]`, or the syntax error.
read_digits :: fn(s: string, at, n: usize) -> ParseError!u32 {
    v: u32 = 0
    for i in 0..n {
        if at + i >= s.len { return !.Syntax(s.len) }
        c := s[at + i]
        if c < '0' or c > '9' { return !.Syntax(at + i) }
        v = v * 10 + u32(c - '0')
    }
    return v
}

// Requires the byte `c` at `s[at]`.
want :: fn(s: string, at: usize, c: u8) -> ParseError!() {
    if at >= s.len { return !.Syntax(s.len) }
    if s[at] is not c { return !.Syntax(at) }
    return ()
}

// The numbers of a date, before any range check.
Fields :: struct { year: u32, month: u32, day: u32 }

// Reads `YYYY-MM-DD` at `s[at..]`.
date_fields :: fn(s: string, at: usize) -> ParseError!Fields {
    year := try read_digits(s, at, 4)
    try want(s, at + 4, '-')
    month := try read_digits(s, at + 5, 2)
    try want(s, at + 7, '-')
    day := try read_digits(s, at + 8, 2)
    return Fields(year: year, month: month, day: day)
}

// The `Date` for fields read at `s[at..]`, or the range error.
checked_date :: fn(f: Fields, at: usize) -> ParseError!Date {
    if f.month < 1 or f.month > 12 { return !.Range(at + 5) }
    d := Date(year: f.year.trunc(i32), month: f.month.trunc(u8), day: f.day.trunc(u8))
    if f.day < 1 or f.day > u32(days_in_month(d.year, d.month)) { return !.Range(at + 8) }
    return d
}

/// Parses `YYYY-MM-DD` (four-digit year, years 0000 to 9999).
///
/// A text that is not of that shape is `Syntax` with the position of the first wrong
/// byte; a month outside 1 to 12 is `Range(5)` and a day that the month does not have
/// is `Range(8)`.
pub parse_date :: fn(s: string) -> ParseError!Date {
    f := try date_fields(s, 0)
    if s.len > 10 { return !.Syntax(10) }
    return try checked_date(f, 0)
}

/// Parses an RFC 3339 timestamp and gives it in UTC.
///
/// The form is `YYYY-MM-DDTHH:MM:SS`, optionally followed by `.` and 1 to 9 fraction
/// digits, and then either `Z` or an offset `+HH:MM` / `-HH:MM`; the offset is applied
/// so the result is UTC. The separator may be `T`, `t` or a space, and `Z` may be `z`.
/// A leap second (`:60`) is out of range.
///
/// Errors: `Syntax(i)` for the first byte that does not fit (the length of the text if it
/// ended too early, and the index of the first byte after a complete timestamp if there
/// is more); otherwise `Range(i)` where `i` is the start of the first field that is out of
/// range: month (5), day (8), hour (11), minute (14), second (17), or the offset's hour or
/// minute; `Range(0)` if the offset moves the moment out of the years 0 to 9999.
pub parse_rfc3339 :: fn(s: string) -> ParseError!DateTime {
    f := try date_fields(s, 0)
    if 10 >= s.len { return !.Syntax(s.len) }
    if s[10] is not 'T' and s[10] is not 't' and s[10] is not ' ' { return !.Syntax(10) }
    hour := try read_digits(s, 11, 2)
    try want(s, 13, ':')
    minute := try read_digits(s, 14, 2)
    try want(s, 16, ':')
    second := try read_digits(s, 17, 2)
    pos: usize = 19
    nanos: u32 = 0
    if pos < s.len and s[pos] is '.' {
        pos += 1
        start := pos
        while pos < s.len and s[pos] >= '0' and s[pos] <= '9' {
            if pos - start < 9 { nanos = nanos * 10 + u32(s[pos] - '0') }
            pos += 1
        }
        n := pos - start
        if n is 0 { return !.Syntax(pos) }
        if n > 9 { return !.Syntax(start + 9) }
        for _ in n..9 { nanos *= 10 }
    }
    // The offset, in minutes east of UTC.
    off_minutes: i64 = 0
    off_hour: u32 = 0
    off_min: u32 = 0
    if pos >= s.len { return !.Syntax(s.len) }
    if s[pos] is 'Z' or s[pos] is 'z' {
        pos += 1
    } else if s[pos] is '+' or s[pos] is '-' {
        off_hour = try read_digits(s, pos + 1, 2)
        try want(s, pos + 3, ':')
        off_min = try read_digits(s, pos + 4, 2)
        sign: i64 = if s[pos] is '-' { -1 } else { 1 }
        off_minutes = sign * (i64(off_hour) * 60 + i64(off_min))
        pos += 6
    } else {
        return !.Syntax(pos)
    }
    if pos < s.len { return !.Syntax(pos) }
    date := try checked_date(f, 0)
    if hour > 23 { return !.Range(11) }
    if minute > 59 { return !.Range(14) }
    if second > 59 { return !.Range(17) }
    if off_hour > 23 { return !.Range(s.len - 5) }
    if off_min > 59 { return !.Range(s.len - 2) }
    local := DateTime(date: date, hour: hour.trunc(u8), minute: minute.trunc(u8), second: second.trunc(u8), nanosecond: nanos)
    if off_minutes is 0 { return local }
    // Apply the offset in whole days and seconds, so dates far from 1970 do not overflow.
    secs := i64(hour) * 3600 + i64(minute) * 60 + i64(second) - off_minutes * 60
    shifted := add_days(date, floor_div(secs, 86400))
    // A moment that the offset moves out of the years 0 to 9999 cannot be represented.
    if shifted.year < 0 or shifted.year > 9999 { return !.Range(0) }
    return DateTime(date: shifted, hour: (floor_mod(secs, 86400) / 3600).trunc(u8), minute: (floor_mod(secs, 3600) / 60).trunc(u8), second: floor_mod(secs, 60).trunc(u8), nanosecond: nanos)
}

// ---------------------------------------------------------------------------------
// Durations
// ---------------------------------------------------------------------------------

/// The size of a buffer that always holds the output of `format_duration`.
pub DURATION_LEN :: 32

/// Formats `d` into `buf` and returns the bytes written, in a form like Go's: `0s`,
/// `250ns`, `1.5us`, `1.5ms`, `3.25s`, `1m0s`, `1h2m3.5s`. Below a second it is one number
/// with the largest unit (`ns`, `us` or `ms`) that leaves the integer part non-zero;
/// from a second up it is hours, minutes and seconds, leaving out the hours when they
/// are zero (and the minutes when both are). Fractions have no trailing zeros. Traps if
/// `buf` is too small (`DURATION_LEN` bytes always suffice).
pub format_duration :: fn(d: Duration, buf: []u8) -> string {
    ns := d.ns
    if ns is 0 { return buf[0..put_text(buf, 0, "0s")] }
    p: usize = 0
    if ns < 1_000_000_000 {
        unit: u64 = 1
        name := "ns"
        digits_after: usize = 0
        if ns >= 1_000_000 {
            unit = 1_000_000
            name = "ms"
            digits_after = 6
        } else if ns >= 1_000 {
            unit = 1_000
            name = "us"
            digits_after = 3
        }
        p = put_uint(buf, p, ns / unit, 1)
        if digits_after > 0 { p = put_fraction(buf, p, ns % unit, digits_after, true) }
        p = put_text(buf, p, name)
        return buf[0..p]
    }
    secs := ns / 1_000_000_000
    hours := secs / 3600
    mins := secs / 60 % 60
    if hours > 0 {
        p = put_uint(buf, p, hours, 1)
        p = put_byte(buf, p, 'h')
    }
    if hours > 0 or mins > 0 {
        p = put_uint(buf, p, mins, 1)
        p = put_byte(buf, p, 'm')
    }
    p = put_uint(buf, p, secs % 60, 1)
    p = put_fraction(buf, p, ns % 1_000_000_000, 9, true)
    p = put_byte(buf, p, 's')
    return buf[0..p]
}

put_text :: fn(buf: []u8, pos: usize, text: string) -> usize {
    if pos + text.len > buf.len { trap("time: buffer too small for the formatted text") }
    buf[pos..pos + text.len].copy_from(text)
    return pos + text.len
}
