//! Threads and the synchronization built on futexes (§19.6).
//!
//! A thread runs a plain function `^fn(arg: ^T) \ {Sys}` and starts with no handlers
//! installed; `defaults` installs the usual ones:
//!
//!     work :: fn(arg: ^State) \ {Sys} {
//!         thread.defaults(fn() \ {Out, Alloc} { print("hello from a thread\n") })
//!     }
//!     t := try thread.spawn(State, work, &state)
//!     t.join()
//!
//! A thread is either joined (`join`) or detached (`detach`), once. Threads that are still
//! running when `main` returns are stopped with the process.
//!
//! Only function pointers and data cross threads: handlers, second-class functions and
//! continuations stay on the thread that made them. Shared memory needs atomics
//! (`@atomic_*`) or one of the types below; a data race is undefined behavior.
//!
//! `Mutex`, `Condvar` and `WaitGroup` are plain structs without allocation, usable as
//! fields; `Channel` is a bounded queue between threads.

/// A running thread, to be joined.
pub Thread :: struct { handle: i64 }

/// Starts a thread calling `f(arg)`.
pub spawn :: fn(T: type, f: ^fn(arg: ^T) \ {Sys}, arg: ^T) -> IoError!Thread \ {Sys} {
    h := @thread_spawn(f, arg.cast(rawptr))
    if h < 0 { return !.Other(0) }
    return Thread(handle: h)
}

/// Waits for `t` to finish.
pub join :: fn(t: Thread) \ {Sys} {
    _ = @thread_join(t.handle)
}

/// Lets `t` run on its own: it is never joined, and its resources are released when it
/// ends. A detached thread cannot be waited for, so tell the rest of the program that it
/// is done through shared state (a `WaitGroup`, a `Channel`, an atomic). When `main`
/// returns the process exits at once, stopping detached threads that are still running
/// wherever they are, without running their `defer`s; a trap in a detached thread stops
/// the whole process, as in any thread.
pub detach :: fn(t: Thread) \ {Sys} {
    _ = @thread_detach(t.handle)
}

/// Lets other threads run.
pub yield_now :: fn() \ {Sys} => @thread_yield()

/// The number of processors available to the program (at least 1).
pub cpu_count :: fn() -> u32 \ {Sys} => @cpu_count()

/// Runs `body` under the default handlers of the ambient effects: the system heap,
/// standard output and error, and the real input, clocks, randomness, files and network.
pub defaults :: fn(body: fn() \ {Out, Err, Alloc, In, Clock, Rand, Fs, Net}) \ {Sys} {
    with heap_allocator(), system_io(), system_output() { body() }
}

// ---------------------------------------------------------------------------------
// Mutex
// ---------------------------------------------------------------------------------

/// A lock. `lock` waits, in the kernel when it has to, until the mutex is free. The state
/// is 0 when unlocked, 1 when locked and 2 when locked with threads possibly waiting.
pub Mutex :: struct { state: u32 }

/// An unlocked mutex.
pub mutex :: fn() -> Mutex => Mutex(state: 0)

/// Takes the mutex, waiting for it if another thread holds it.
pub lock :: fn(m: ^Mutex) \ {Sys} {
    if @atomic_cas(&m.state, 0, 1, .Acquire, .Relaxed) is null { return }
    while @atomic_swap(&m.state, 2, .Acquire) is not 0 {
        _ = @futex_wait(&m.state, 2, -1)
    }
}

/// Takes the mutex if it is free; returns whether it did.
pub try_lock :: fn(m: ^Mutex) -> bool => @atomic_cas(&m.state, 0, 1, .Acquire, .Relaxed) is null

/// Releases the mutex, which the calling thread holds.
pub unlock :: fn(m: ^Mutex) {
    if @atomic_swap(&m.state, 0, .Release) is 2 { _ = @futex_wake(&m.state, 1) }
}

// ---------------------------------------------------------------------------------
// Condition variable
// ---------------------------------------------------------------------------------

/// A condition variable: threads wait on it, holding a `Mutex`, until another thread
/// signals that what they wait for may have happened.
pub Condvar :: struct { seq: u32 }

/// A condition variable nobody waits on.
pub condvar :: fn() -> Condvar => Condvar(seq: 0)

/// Unlocks `m`, waits for a signal, and locks `m` again. It may also return without a
/// signal, so call it in a loop that tests the condition: `while not ready { c.wait(&m) }`.
pub wait :: fn(c: ^Condvar, m: ^Mutex) \ {Sys} {
    seen := @atomic_load(&c.seq, .Acquire)
    unlock(m)
    _ = @futex_wait(&c.seq, seen, -1)
    lock(m)
}

/// Like `wait`, but gives up after `d`; returns `false` if it did so without a signal.
/// `m` is locked again either way.
pub wait_timeout :: fn(c: ^Condvar, m: ^Mutex, d: Duration) -> bool \ {Sys} {
    seen := @atomic_load(&c.seq, .Acquire)
    unlock(m)
    deadline := @clock_now() + d.ns
    signaled := false
    while true {
        if @atomic_load(&c.seq, .Acquire) is not seen {
            signaled = true
            break
        }
        now := @clock_now()
        if now >= deadline { break }
        left := deadline - now
        if left > 1_000_000_000_000 { left = 1_000_000_000_000 }
        _ = @futex_wait(&c.seq, seen, left.sat(i64))
    }
    lock(m)
    return signaled
}

/// Wakes one thread waiting on `c`, if there is one.
pub signal :: fn(c: ^Condvar) {
    _ = @atomic_add(&c.seq, 1, .Release)
    _ = @futex_wake(&c.seq, 1)
}

/// Wakes every thread waiting on `c`.
pub broadcast :: fn(c: ^Condvar) {
    _ = @atomic_add(&c.seq, 1, .Release)
    _ = @futex_wake(&c.seq, 4294967295)
}

// ---------------------------------------------------------------------------------
// Wait group
// ---------------------------------------------------------------------------------

// A wait group is declared in its own module because methods resolve in the module that
// declares a type (§7.10) and a module has one function per name: `Condvar` and `WaitGroup`
// both have a `wait`.
wait_group_module :: import "./wait_group"

/// A counter of outstanding work: `add` before starting it, `done` when it finishes, and
/// `wait` returns when the count is back at zero.
pub WaitGroup :: wait_group_module.WaitGroup

/// A wait group with nothing outstanding.
pub wait_group :: wait_group_module.wait_group

// ---------------------------------------------------------------------------------
// Channel
// ---------------------------------------------------------------------------------

/// A bounded blocking queue for any number of sending and receiving threads. It keeps the
/// allocator it was created with. Once closed, sends fail and receives drain what is left.
pub Channel :: struct(T: type) {
    buf: []T
    head: usize
    count: usize
    closed: bool
    m: Mutex
    not_empty: Condvar
    not_full: Condvar
    alloc: Allocator
}

/// A channel holding up to `capacity` (at least 1) values, using the current allocator.
pub channel :: fn(T: type, capacity: usize) -> AllocError!Channel(T) \ {Alloc} {
    assert(capacity >= 1, "a channel needs room for at least one value")
    a := current()
    raw := a.vt.alloc(a.data, @size_of(T) * capacity, @align_of(T)) else return !.OutOfMemory
    return Channel(T)(
        buf: raw.cast([^]T)[0..capacity], head: 0, count: 0, closed: false,
        m: mutex(), not_empty: condvar(), not_full: condvar(), alloc: a)
}

// Appends `x`; the channel is locked and has room.
push :: fn(T: type, c: ^Channel(T), x: T) {
    j := c.head + c.count
    if j >= c.buf.len { j -= c.buf.len }
    c.buf[j] = x
    c.count += 1
    signal(&c.not_empty)
}

// Removes the oldest value; the channel is locked and not empty.
pop :: fn(T: type, c: ^Channel(T)) -> T {
    x := c.buf[c.head]
    c.head += 1
    if c.head is c.buf.len { c.head = 0 }
    c.count -= 1
    signal(&c.not_full)
    return x
}

/// Sends `x`, waiting while the channel is full. Returns `false` if the channel is closed.
pub send :: fn(T: type, c: ^Channel(T), x: T) -> bool \ {Sys} {
    lock(&c.m)
    while c.count is c.buf.len and not c.closed { wait(&c.not_full, &c.m) }
    ok := not c.closed
    if ok { push(c, x) }
    unlock(&c.m)
    return ok
}

/// Receives the oldest value, waiting while the channel is empty. Returns `null` once the
/// channel is closed and drained.
pub recv :: fn(T: type, c: ^Channel(T)) -> ?T \ {Sys} {
    lock(&c.m)
    while c.count is 0 and not c.closed { wait(&c.not_empty, &c.m) }
    r: ?T = null
    if c.count > 0 { r = pop(c) }
    unlock(&c.m)
    return r
}

/// Sends `x` if there is room right now; returns whether it did.
pub try_send :: fn(T: type, c: ^Channel(T), x: T) -> bool \ {Sys} {
    lock(&c.m)
    ok := not c.closed and c.count < c.buf.len
    if ok { push(c, x) }
    unlock(&c.m)
    return ok
}

/// Receives a value if one is waiting right now.
pub try_recv :: fn(T: type, c: ^Channel(T)) -> ?T \ {Sys} {
    lock(&c.m)
    r: ?T = null
    if c.count > 0 { r = pop(c) }
    unlock(&c.m)
    return r
}

/// Closes the channel: later sends fail, and blocked senders and receivers wake up.
pub close :: fn(T: type, c: ^Channel(T)) \ {Sys} {
    lock(&c.m)
    c.closed = true
    unlock(&c.m)
    broadcast(&c.not_full)
    broadcast(&c.not_empty)
}

/// Frees the channel's buffer through its own allocator. No thread may use the channel
/// afterwards.
pub deinit :: fn(T: type, c: ^Channel(T)) {
    c.alloc.vt.free(c.alloc.data, c.buf.ptr.cast([^]u8), @size_of(T) * c.buf.len, @align_of(T))
    c.buf = empty_slice(T)
    c.count = 0
}
