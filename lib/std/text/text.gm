//! Unicode text segmentation, and UTF-8 and UTF-16 encoding of scalar values.
//!
//! A `string` carries no encoding guarantee; these functions read it as UTF-8 and treat
//! each maximal ill-formed subsequence as one U+FFFD, exactly like `runes`. They never
//! allocate, and the strings they return are slices of their argument, so ill-formed
//! bytes come back unchanged.
//!
//!     text :: import "std/text"
//!     for g in text.graphemes("e\u{301}🇫🇷") { … }   // "e\u{301}", then "🇫🇷"
//!
//! Grapheme clusters are the extended grapheme clusters of Unicode Standard Annex #29,
//! "Unicode Text Segmentation", for the Unicode version in `UNICODE_VERSION`.

// The grapheme class of a code point (`CLASS_RUNS`, generated in tables.gm). The rules
// of UAX #29 use the Grapheme_Cluster_Break, Extended_Pictographic and
// Indic_Conjunct_Break properties; each class is one combination of them.
#allow("unused-declaration")
CLASS_OTHER :: 0
CLASS_CR :: 1
CLASS_LF :: 2
CLASS_CONTROL :: 3
CLASS_EXTEND :: 4 // Extend, and not an Indic_Conjunct_Break extender
CLASS_EXTEND_INCB :: 5 // Extend, and Indic_Conjunct_Break=Extend
CLASS_LINKER :: 6 // Extend, and Indic_Conjunct_Break=Linker
CLASS_ZWJ :: 7 // also Indic_Conjunct_Break=Extend
CLASS_RI :: 8 // Regional_Indicator
CLASS_PREPEND :: 9
CLASS_SPACING_MARK :: 10
CLASS_L :: 11
CLASS_V :: 12
CLASS_T :: 13
CLASS_LV :: 14
CLASS_LVT :: 15
CLASS_PICTOGRAPHIC :: 16 // Extended_Pictographic
CLASS_CONSONANT :: 17 // Indic_Conjunct_Break=Consonant

// The grapheme class of `r`.
class_of :: fn(r: rune) -> u8 {
    // The last run that starts at or before `r`.
    key := (r << 8) | 0xff
    lo: usize = 0
    hi := CLASS_RUNS.len
    while hi - lo > 1 {
        mid := lo + (hi - lo) / 2
        if CLASS_RUNS[mid] <= key { lo = mid } else { hi = mid }
    }
    c := CLASS_RUNS[lo].trunc(u8)
    // The table gives every Hangul syllable as LVT; one in 28 is LV.
    if c is CLASS_LVT and (r - 0xac00) % 28 is 0 { return CLASS_LV }
    return c
}

// The code point at byte `i` of `s` (with `i < s.len`) and the number of bytes it
// takes. A maximal ill-formed subsequence is U+FFFD and takes its own length.
decode :: fn(s: string, i: usize) -> (r: rune, len: usize) {
    b := s[i]
    if b < 0x80 { return (r: rune(b), len: 1) }
    // The number of continuation bytes, and the range of the first of them.
    n: usize = 0
    lo: u8 = 0x80
    hi: u8 = 0xbf
    c: rune = 0
    if b >= 0xc2 and b <= 0xdf {
        n = 1
        c = rune(b & 0x1f)
    } else if b >= 0xe0 and b <= 0xef {
        n = 2
        c = rune(b & 0x0f)
        if b is 0xe0 { lo = 0xa0 }
        if b is 0xed { hi = 0x9f }
    } else if b >= 0xf0 and b <= 0xf4 {
        n = 3
        c = rune(b & 0x07)
        if b is 0xf0 { lo = 0x90 }
        if b is 0xf4 { hi = 0x8f }
    } else {
        return (r: 0xfffd, len: 1)
    }
    k: usize = 1
    while k <= n {
        if i + k >= s.len { break }
        d := s[i + k]
        if d < lo or d > hi { break }
        c = (c << 6) | rune(d & 0x3f)
        lo = 0x80
        hi = 0xbf
        k += 1
    }
    if k > n { return (r: c, len: k) }
    return (r: 0xfffd, len: k)
}

is_control :: fn(c: u8) -> bool => c is CLASS_CR or c is CLASS_LF or c is CLASS_CONTROL

is_extend :: fn(c: u8) -> bool => c is CLASS_EXTEND or c is CLASS_EXTEND_INCB or c is CLASS_LINKER

/// The byte length of the first grapheme cluster of `s`: 0 if `s` is empty, and at
/// least 1 otherwise. `s[0..grapheme_len(s)]` is the cluster.
pub grapheme_len :: fn(s: string) -> usize {
    if s.len is 0 { return 0 }
    first := decode(s, 0)
    i := first.len
    prev := class_of(first.r)
    // What the cluster so far ends with, for the rules that look further back than
    // `prev`. `ri`: the number of regional indicators in a row (GB12, GB13).
    // `emoji`: 1 after an Extended_Pictographic and Extends, 2 after those and a ZWJ
    // (GB11). `incb`: 1 after an Indic_Conjunct_Break consonant and extenders, 2 if a
    // linker is among those extenders (GB9c).
    ri: usize = 0
    emoji: u8 = 0
    incb: u8 = 0
    if prev is CLASS_RI { ri = 1 }
    if prev is CLASS_PICTOGRAPHIC { emoji = 1 }
    if prev is CLASS_CONSONANT { incb = 1 }
    while i < s.len {
        d := decode(s, i)
        next := class_of(d.r)
        join := false
        if prev is CLASS_CR and next is CLASS_LF {
            join = true // GB3
        } else if is_control(prev) or is_control(next) {
            join = false // GB4, GB5
        } else if prev is CLASS_L {
            join = next is CLASS_L or next is CLASS_V or next is CLASS_LV or next is CLASS_LVT // GB6
        } else if (prev is CLASS_LV or prev is CLASS_V) and (next is CLASS_V or next is CLASS_T) {
            join = true // GB7
        } else if (prev is CLASS_LVT or prev is CLASS_T) and next is CLASS_T {
            join = true // GB8
        }
        if not join and not is_control(prev) and not is_control(next) {
            if is_extend(next) or next is CLASS_ZWJ or next is CLASS_SPACING_MARK {
                join = true // GB9, GB9a
            } else if prev is CLASS_PREPEND {
                join = true // GB9b
            } else if next is CLASS_CONSONANT and incb is 2 {
                join = true // GB9c
            } else if next is CLASS_PICTOGRAPHIC and emoji is 2 {
                join = true // GB11
            } else if next is CLASS_RI and ri % 2 is 1 {
                join = true // GB12, GB13
            }
        }
        if not join { break } // GB999
        if next is CLASS_RI { ri += 1 } else { ri = 0 }
        if next is CLASS_PICTOGRAPHIC {
            emoji = 1
        } else if emoji is 1 and is_extend(next) {
            emoji = 1
        } else if emoji is 1 and next is CLASS_ZWJ {
            emoji = 2
        } else {
            emoji = 0
        }
        if next is CLASS_CONSONANT {
            incb = 1
        } else if incb > 0 and next is CLASS_LINKER {
            incb = 2
        } else if incb > 0 and (next is CLASS_EXTEND_INCB or next is CLASS_ZWJ) {
            // An extender keeps what came before.
        } else {
            incb = 0
        }
        prev = next
        i += d.len
    }
    return i
}

/// The grapheme clusters of `s`, in order: what a reader sees as one character, such
/// as `e` with a combining accent, a flag, or an emoji sequence joined with ZWJs. `\r\n`
/// is one cluster. Every byte of `s` is in exactly one cluster.
pub graphemes :: fn(s: string) needs Yield(string) {
    rest := s
    while rest.len > 0 {
        n := grapheme_len(rest)
        yield(rest[0..n])
        rest = rest[n..rest.len]
    }
}

// ---------------------------------------------------------------------------------
// Unicode whitespace
// ---------------------------------------------------------------------------------

/// Whether `r` has the Unicode `White_Space` property: U+0009 to U+000D, U+0020, U+0085,
/// U+00A0, U+1680, U+2000 to U+200A, U+2028, U+2029, U+202F, U+205F and U+3000. This is a
/// superset of `ascii.is_space`; U+200B (zero width space) is not whitespace.
pub is_space :: fn(r: rune) -> bool {
    if r < 0x100 { return r is 0x20 or (r >= 0x09 and r <= 0x0d) or r is 0x85 or r is 0xa0 }
    return r is 0x1680 or (r >= 0x2000 and r <= 0x200a) or r is 0x2028 or r is 0x2029
        or r is 0x202f or r is 0x205f or r is 0x3000
}

/// `s` without leading Unicode whitespace (`is_space`). Unlike `str.trim_start`, which
/// removes ASCII whitespace only, this also removes U+00A0, U+3000 and the rest. Ill-formed
/// bytes are not whitespace and stay.
pub trim_start :: fn(s: string) -> string {
    i: usize = 0
    while i < s.len {
        d := decode(s, i)
        if not is_space(d.r) { break }
        i += d.len
    }
    return s[i..s.len]
}

/// `s` without trailing Unicode whitespace; see `trim_start`.
pub trim_end :: fn(s: string) -> string {
    i: usize = 0
    end: usize = 0
    while i < s.len {
        d := decode(s, i)
        i += d.len
        if not is_space(d.r) { end = i }
    }
    return s[0..end]
}

/// `s` without leading and trailing Unicode whitespace; see `trim_start`.
pub trim :: fn(s: string) -> string => trim_end(trim_start(s))

/// The maximal runs of `s` without Unicode whitespace; empty fields are skipped. Unlike
/// `str.fields`, which splits at ASCII whitespace only, this also splits at U+00A0, U+3000
/// and the rest. Ill-formed bytes are not whitespace and belong to the fields.
pub fields :: fn(s: string) needs Yield(string) {
    i: usize = 0
    while true {
        while i < s.len {
            d := decode(s, i)
            if not is_space(d.r) { break }
            i += d.len
        }
        if i >= s.len { return }
        start := i
        while i < s.len {
            d := decode(s, i)
            if is_space(d.r) { break }
            i += d.len
        }
        yield(s[start..i])
    }
}

// ---------------------------------------------------------------------------------
// UTF-8 scalar values
// ---------------------------------------------------------------------------------
//
// Reading text as scalar values is `runes(s)`, and checking it is `s.utf8_valid()`;
// these functions step through a string without an iterator and write scalar values.

/// The first Unicode scalar value of `s` and the number of bytes it takes, or `null` if
/// `s` is empty or does not start with a well-formed UTF-8 sequence (a stray
/// continuation byte, a truncated or overlong sequence, a surrogate, or a value above
/// U+10FFFF). Unlike `runes`, ill-formed input is reported, not replaced.
pub decode_rune :: fn(s: string) -> ?(rune: u32, len: usize) {
    if s.len is 0 { return null }
    d := decode(s, 0)
    // `decode` gives U+FFFD for ill-formed input, always with fewer than 3 bytes unless
    // the sequence is a genuine U+FFFD (EF BF BD).
    if d.r is 0xfffd and not (d.len is 3 and s[0] is 0xef) { return null }
    return (rune: d.r, len: d.len)
}

/// Writes the UTF-8 encoding of `cp` at the start of `buf` and returns the bytes written,
/// a slice of `buf`; `null` if `cp` is a surrogate (U+D800 to U+DFFF) or above U+10FFFF.
/// Traps if `buf` is shorter than 4 bytes.
pub encode_rune :: fn(cp: u32, buf: []u8) -> ?string {
    assert(buf.len >= 4, "text: encode_rune needs a buffer of at least 4 bytes")
    if cp >= 0xd800 and cp <= 0xdfff { return null }
    if cp < 0x80 {
        buf[0] = cp.trunc(u8)
        return buf[0..1]
    }
    if cp < 0x800 {
        buf[0] = (0xc0 | (cp >> 6)).trunc(u8)
        buf[1] = (0x80 | (cp & 0x3f)).trunc(u8)
        return buf[0..2]
    }
    if cp < 0x10000 {
        buf[0] = (0xe0 | (cp >> 12)).trunc(u8)
        buf[1] = (0x80 | ((cp >> 6) & 0x3f)).trunc(u8)
        buf[2] = (0x80 | (cp & 0x3f)).trunc(u8)
        return buf[0..3]
    }
    if cp > 0x10ffff { return null }
    buf[0] = (0xf0 | (cp >> 18)).trunc(u8)
    buf[1] = (0x80 | ((cp >> 12) & 0x3f)).trunc(u8)
    buf[2] = (0x80 | ((cp >> 6) & 0x3f)).trunc(u8)
    buf[3] = (0x80 | (cp & 0x3f)).trunc(u8)
    return buf[0..4]
}

/// Appends the UTF-8 encoding of `cp` to `out`. Traps if `cp` is a surrogate or above
/// U+10FFFF.
pub append_rune :: fn(out: ^List(u8), cp: u32) -> AllocError!() {
    tmp: [4]u8 = ---
    enc := encode_rune(cp, tmp[..]) else trap("text: append_rune of a value that is not a scalar value")
    try out.extend(enc)
}

// ---------------------------------------------------------------------------------
// UTF-16
// ---------------------------------------------------------------------------------
//
// UTF-16 is the string encoding of Windows APIs, JavaScript and JSON `\u` escapes.
// Units are `u16` values in the machine's order; reading or writing them as bytes in
// a particular byte order is `std/bytes`'s job, not this module's.

/// The number of UTF-16 code units that `s` encodes to: 1 for each scalar value below
/// U+10000 and 2 for each above. `s` is read like `runes` reads it, so each ill-formed
/// subsequence counts as U+FFFD, one unit.
pub utf16_len :: fn(s: string) -> usize {
    n: usize = 0
    for r in runes(s) {
        n += if r >= 0x10000 { 2 } else { 1 }
    }
    return n
}

/// Writes the UTF-16 encoding of `s` (read like `runes` reads it, so ill-formed bytes
/// become U+FFFD) at the start of `buf` and returns the code units written, a slice of
/// `buf`. Traps if `buf.len` is less than `utf16_len(s)`.
pub encode_utf16 :: fn(s: string, buf: []u16) -> []u16 {
    assert(buf.len >= utf16_len(s), "text: encode_utf16 needs a buffer of at least utf16_len(s) units")
    n: usize = 0
    for r in runes(s) {
        if r >= 0x10000 {
            v := r - 0x10000
            buf[n] = (0xd800 | (v >> 10)).trunc(u16)
            buf[n + 1] = (0xdc00 | (v & 0x3ff)).trunc(u16)
            n += 2
        } else {
            buf[n] = r.trunc(u16)
            n += 1
        }
    }
    return buf[0..n]
}

/// Appends the UTF-16 encoding of `s` (read like `runes` reads it) to `out`.
pub append_utf16 :: fn(out: ^List(u16), s: string) -> AllocError!() {
    for r in runes(s) {
        if r >= 0x10000 {
            v := r - 0x10000
            try out.push((0xd800 | (v >> 10)).trunc(u16))
            try out.push((0xdc00 | (v & 0x3ff)).trunc(u16))
        } else {
            try out.push(r.trunc(u16))
        }
    }
}

/// The Unicode scalar values of the UTF-16 text `units`, in order. A high surrogate
/// followed by a low one is one value above U+FFFF; every unpaired surrogate (a lone
/// one, or a pair in the wrong order) yields U+FFFD, so the values are always scalar
/// values and `append_rune` accepts them. Building UTF-8 from UTF-16 is that call:
///
///     out := list(u8)
///     defer out.deinit()
///     for r in text.decode_utf16(units) { try text.append_rune(&out, r) }
pub decode_utf16 :: fn(units: []const u16) needs Yield(rune) {
    i: usize = 0
    while i < units.len {
        u := u32(units[i])
        i += 1
        if u < 0xd800 or u > 0xdfff {
            yield(rune(u))
        } else if u < 0xdc00 and i < units.len and units[i] >= 0xdc00 and units[i] <= 0xdfff {
            lo := u32(units[i])
            i += 1
            yield(rune(0x10000 + ((u - 0xd800) << 10) + (lo - 0xdc00)))
        } else {
            yield(0xfffd)
        }
    }
}
