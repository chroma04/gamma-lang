//! Byte-oriented string utilities.
//!
//! A `string` is a `[]const u8`, and every function here works on bytes: an index is a
//! byte index and case rules are ASCII only. Functions that return a `string` return a
//! slice of their argument (or of the buffer the caller supplied), so nothing is copied
//! and nothing allocates. The exceptions are `join`, `format`, `replace_alloc` and the
//! functions that append to a `List(u8)` (`replace`, `repeat`), whose results are new
//! memory or list growth.
//!
//! Strings are slices, so these are free functions (`str.trim(s)`), not methods. The
//! builtin methods of slices cover the rest: `s.starts_with(p)`, `s.ends_with(p)`,
//! `s.index_of(byte)`, `s.utf8_valid()`, `s is t` for equality and `<` for ordering, so
//! this module does not repeat them.
//!
//!     str :: import "std/str"
//!     for line in str.lines(text) { … }
//!     n := try str.parse_int(u32, "0xff")
//!     x := try str.parse_float(f64, "6.02e23")

ascii :: import "std/ascii"

// ---------------------------------------------------------------------------------
// Trimming
// ---------------------------------------------------------------------------------

/// `s` without leading ASCII whitespace (space, `\t`, `\n`, `\r`, `\v`, `\f`). For Unicode
/// whitespace, see `text.trim_start`.
pub trim_start :: fn(s: string) -> string {
    i: usize = 0
    while i < s.len and ascii.is_space(s[i]) { i += 1 }
    return s[i..s.len]
}

/// `s` without trailing ASCII whitespace. For Unicode whitespace, see `text.trim_end`.
pub trim_end :: fn(s: string) -> string {
    n := s.len
    while n > 0 and ascii.is_space(s[n - 1]) { n -= 1 }
    return s[0..n]
}

/// `s` without leading and trailing ASCII whitespace. For Unicode whitespace, see `text.trim`.
pub trim :: fn(s: string) -> string => trim_end(trim_start(s))

// ---------------------------------------------------------------------------------
// Searching
// ---------------------------------------------------------------------------------

// Whether `needle` occurs in `s` at byte `at` (the caller ensures it fits).
matches_at :: fn(s, needle: string, at: usize) -> bool {
    for j in 0..needle.len {
        if s[at + j] is not needle[j] { return false }
    }
    return true
}

/// The byte index of the first occurrence of `needle` in `s`, or `null`. An empty
/// `needle` is found at index 0.
pub find :: fn(s, needle: string) -> ?usize {
    if needle.len > s.len { return null }
    last := s.len - needle.len
    i: usize = 0
    while i <= last {
        if matches_at(s, needle, i) { return i }
        i += 1
    }
    return null
}

/// The byte index of the last occurrence of `needle` in `s`, or `null`. An empty
/// `needle` is found at `s.len`.
pub rfind :: fn(s, needle: string) -> ?usize {
    if needle.len > s.len { return null }
    i := s.len - needle.len + 1
    while i > 0 {
        i -= 1
        if matches_at(s, needle, i) { return i }
    }
    return null
}

/// Whether `needle` occurs in `s`.
pub contains :: fn(s, needle: string) -> bool => find(s, needle) is not null

/// The byte index of the first occurrence of `needle` in `s` when ASCII letters are
/// compared without case, or `null`. An empty `needle` is found at index 0.
pub find_ignore_case :: fn(s, needle: string) -> ?usize {
    if needle.len > s.len { return null }
    last := s.len - needle.len
    i: usize = 0
    while i <= last {
        if eq_ignore_case(s[i..i + needle.len], needle) { return i }
        i += 1
    }
    return null
}

/// The number of non-overlapping occurrences of `needle` in `s`, found from the left
/// (`count("aaa", "aa")` is 1). Traps if `needle` is empty.
pub count :: fn(s, needle: string) -> usize {
    if needle.len is 0 { trap("str: count of an empty needle") }
    n: usize = 0
    rest := s
    while true {
        i := find(rest, needle) else break
        n += 1
        rest = rest[i + needle.len..rest.len]
    }
    return n
}

/// `s` without the leading `prefix`, or `null` if `s` does not start with it.
pub strip_prefix :: fn(s, prefix: string) -> ?string {
    if not s.starts_with(prefix) { return null }
    return s[prefix.len..s.len]
}

/// `s` without the trailing `suffix`, or `null` if `s` does not end with it.
pub strip_suffix :: fn(s, suffix: string) -> ?string {
    if not s.ends_with(suffix) { return null }
    return s[0..s.len - suffix.len]
}

// ---------------------------------------------------------------------------------
// Splitting
// ---------------------------------------------------------------------------------

/// Splits `s` at the first occurrence of `sep`: the text before it and the text after
/// it, or `null` if `sep` does not occur. An empty `sep` splits at the start.
pub split_once :: fn(s, sep: string) -> ?(before: string, after: string) {
    i := find(s, sep) else return null
    return (before: s[0..i], after: s[i + sep.len..s.len])
}

/// The pieces of `s` between occurrences of `sep`, in order. Adjacent separators give
/// empty pieces, and so do separators at either end (`"a,,b,"` gives `a`, ``, `b`, ``).
/// An empty `sep` does not split: `s` is yielded once.
pub split :: fn(s, sep: string) needs Yield(string) {
    if sep.len is 0 {
        yield(s)
        return
    }
    rest := s
    while true {
        if i := find(rest, sep) {
            yield(rest[0..i])
            rest = rest[i + sep.len..rest.len]
        } else {
            yield(rest)
            return
        }
    }
}

/// The pieces of `s` between bytes that occur in `seps`, in order, with the same empty
/// pieces as `split` (`"a, b"` split at `", "` gives `a`, ``, `b`). If `seps` is empty,
/// `s` is yielded once.
pub split_any :: fn(s, seps: string) needs Yield(string) {
    start: usize = 0
    for i in 0..s.len {
        if seps.index_of(s[i]) is not null {
            yield(s[start..i])
            start = i + 1
        }
    }
    yield(s[start..s.len])
}

/// Splits `s` at `sep` into at most `parts.len` pieces, stored in `parts` in order; the
/// last piece takes the rest of `s`, separators included. Returns the number of pieces
/// written, which is fewer than `parts.len` when `s` has fewer separators. An empty `sep`
/// does not split. This is `split` for a known number of fields, without an iterator.
pub split_into :: fn(s, sep: string, parts: []string) -> usize {
    if parts.len is 0 { return 0 }
    n: usize = 0
    rest := s
    while n + 1 < parts.len and sep.len > 0 {
        i := find(rest, sep) else break
        parts[n] = rest[0..i]
        n += 1
        rest = rest[i + sep.len..rest.len]
    }
    parts[n] = rest
    return n + 1
}

/// The piece number `n` (counting from 0) of `s` split at `sep` as `split` does, or
/// `null` if there are not that many pieces.
pub nth_field :: fn(s: string, sep: string, n: usize) -> ?string {
    i: usize = 0
    for p in split(s, sep) {
        if i is n { return p }
        i += 1
    }
    return null
}

/// The lines of `s`, split on `\n` with a `\r` before it dropped. A final line without
/// a terminator is yielded; there is no empty line after a terminating `\n`.
pub lines :: fn(s: string) needs Yield(string) {
    start: usize = 0
    while start < s.len {
        end := start
        while end < s.len and s[end] is not '\n' { end += 1 }
        line_end := end
        if line_end > start and s[line_end - 1] is '\r' { line_end -= 1 }
        yield(s[start..line_end])
        start = end + 1
    }
}

/// The maximal runs of non-whitespace bytes of `s` (ASCII whitespace separates them);
/// empty fields are skipped. For Unicode whitespace, see `text.fields`.
pub fields :: fn(s: string) needs Yield(string) {
    i: usize = 0
    while true {
        while i < s.len and ascii.is_space(s[i]) { i += 1 }
        if i >= s.len { return }
        start := i
        while i < s.len and not ascii.is_space(s[i]) { i += 1 }
        yield(s[start..i])
    }
}

// ---------------------------------------------------------------------------------
// Case
// ---------------------------------------------------------------------------------

/// Whether `a` and `b` are equal when ASCII letters are compared without case.
pub eq_ignore_case :: fn(a, b: string) -> bool {
    if a.len is not b.len { return false }
    for i in 0..a.len {
        if ascii.to_lower(a[i]) is not ascii.to_lower(b[i]) { return false }
    }
    return true
}

/// `s` with ASCII capitals made lowercase, written into `buf`; returns the part of
/// `buf` written. Traps if `buf` is shorter than `s`.
pub to_lower :: fn(s: string, buf: []u8) -> string {
    if buf.len < s.len { trap("str: buffer too small for the converted string") }
    for i in 0..s.len { buf[i] = ascii.to_lower(s[i]) }
    return buf[0..s.len]
}

/// `s` with ASCII lowercase letters made capitals, written into `buf`; see `to_lower`.
pub to_upper :: fn(s: string, buf: []u8) -> string {
    if buf.len < s.len { trap("str: buffer too small for the converted string") }
    for i in 0..s.len { buf[i] = ascii.to_upper(s[i]) }
    return buf[0..s.len]
}

// ---------------------------------------------------------------------------------
// Replacing and repeating
// ---------------------------------------------------------------------------------

/// Appends `s` to `out` with every non-overlapping occurrence of `from` (found from the
/// left) replaced by `to`. Traps if `from` is empty.
pub replace :: fn(out: ^List(u8), s, from, to: string) -> AllocError!() {
    if from.len is 0 { trap("str: replace of an empty string") }
    rest := s
    while true {
        i := find(rest, from) else break
        try out.extend(rest[0..i])
        try out.extend(to)
        rest = rest[i + from.len..rest.len]
    }
    try out.extend(rest)
}

/// `s` with every non-overlapping occurrence of `from` replaced by `to`, in memory from
/// the current allocator (release it with `free`). Traps if `from` is empty.
pub replace_alloc :: fn(s, from, to: string) -> AllocError![]u8 needs Alloc {
    n := count(s, from)
    out := try make(u8, s.len - n * from.len + n * to.len)
    at: usize = 0
    rest := s
    while true {
        i := find(rest, from) else break
        out[at..at + i].copy_from(rest[0..i])
        at += i
        out[at..at + to.len].copy_from(to)
        at += to.len
        rest = rest[i + from.len..rest.len]
    }
    out[at..at + rest.len].copy_from(rest)
    return out
}

/// Appends `n` copies of `s` to `out`.
pub repeat :: fn(out: ^List(u8), s: string, n: usize) -> AllocError!() {
    try out.reserve(s.len * n)
    for _ in 0..n { try out.extend(s) }
}

// ---------------------------------------------------------------------------------
// Parsing numbers
// ---------------------------------------------------------------------------------

/// Why `parse_int`, `parse_radix` or `parse_float` failed.
pub ParseError :: union {
    /// The string is empty.
    Empty
    /// A byte that is not a digit (or a misplaced `_`, or a missing digit, or any other
    /// byte the syntax does not allow there) at this index; `at` is `s.len` when digits
    /// are missing at the end.
    InvalidDigit: (at: usize)
    /// The integer does not fit the type. (A float too large for its type is infinite.)
    Overflow
}

// The sign of the integer in `s` (which is not empty) and the index after it. A `-` is
// an error for unsigned `T`.
sign :: fn(T: type, s: string) -> ParseError!(neg: bool, at: usize) where Int(T) {
    zero: T = 0
    signed := (zero -% 1) < zero
    if s[0] is '-' {
        if not signed { return !.InvalidDigit(at: 0) }
        return (neg: true, at: 1)
    }
    if s[0] is '+' { return (neg: false, at: 1) }
    return (neg: false, at: 0)
}

// The digits of `s` from index `i` to the end, in `base` (2 to 36), as a `T`; negative
// if `neg`. A single `_` may separate two digits.
digits :: fn(T: type, s: string, start: usize, neg: bool, base: u32) -> ParseError!T where Int(T) {
    // The base as a `T`, if `T` holds it: a type too narrow for it can only hold the
    // value of a single digit, which is never multiplied.
    tb := base.checked(T)
    acc: T = 0
    after_digit := false
    i := start
    while i < s.len {
        c := s[i]
        if c is '_' {
            if not after_digit { return !.InvalidDigit(at: i) }
            after_digit = false
            i += 1
            continue
        }
        d := ascii.digit_value(c) else return !.InvalidDigit(at: i)
        if u32(d) >= base { return !.InvalidDigit(at: i) }
        dv := d.checked(T) else return !.Overflow
        // A negative number accumulates downwards, so that the minimum value fits.
        if acc is not 0 {
            m := tb else return !.Overflow
            acc = acc *? m else return !.Overflow
        }
        if neg {
            acc = acc -? dv else return !.Overflow
        } else {
            acc = acc +? dv else return !.Overflow
        }
        after_digit = true
        i += 1
    }
    if not after_digit { return !.InvalidDigit(at: s.len) }
    return acc
}

/// Parses the integer in `s` as a `T`.
///
/// The syntax is an optional sign (`+`, or `-` for signed types only), an optional
/// `0x`, `0o` or `0b` prefix (any case) and one or more digits of that base (decimal
/// without a prefix); a single `_` may separate two digits (`1_000`). Nothing else is
/// allowed, not even whitespace. The most negative value of a signed type parses. The
/// first problem found, scanning from the left, is the error.
pub parse_int :: fn(T: type, s: string) -> ParseError!T where Int(T) {
    if s.len is 0 { return !.Empty }
    sg := try sign(T, s)
    i := sg.at
    base: u32 = 10
    if i + 1 < s.len and s[i] is '0' {
        c := ascii.to_lower(s[i + 1])
        if c is 'x' { base = 16 } else if c is 'o' { base = 8 } else if c is 'b' { base = 2 }
        if base is not 10 { i += 2 }
    }
    return digits(T, s, i, sg.neg, base)
}

/// Parses the integer in `s` as a `T` in the given `base`, from 2 to 36 (a larger or
/// smaller base traps). Digits above 9 are letters of either case. The syntax is
/// `parse_int`'s without the prefix: an optional sign, then one or more digits with
/// single `_` separators between them; `parse_radix(u8, "0xff", 16)` is an
/// `.InvalidDigit(at: 1)` because `x` is not a base 16 digit.
pub parse_radix :: fn(T: type, s: string, base: u32) -> ParseError!T where Int(T) {
    assert(base >= 2 and base <= 36, "str: parse_radix base must be from 2 to 36")
    if s.len is 0 { return !.Empty }
    sg := try sign(T, s)
    return digits(T, s, sg.at, sg.neg, base)
}

// ---------------------------------------------------------------------------------
// Parsing floats
// ---------------------------------------------------------------------------------
//
// A float is converted exactly, so the result is the float nearest to the decimal value
// (ties to even), whatever the number of digits. The digits are held as a decimal
// number of up to 800 significant digits, with a flag that records that nonzero digits
// were dropped beyond them (800 digits decide every case: a tie between two floats has
// at most 767 significant digits). That decimal is halved or doubled, 27 to 60 bits at a
// time, until it lies in the range of the significand, and then rounded.

MAX_DIGITS :: 800

// A decimal number `0.d[0]d[1]…d[nd-1] × 10^dp`, with digits 0 to 9 and no trailing
// zeros; zero has `nd` 0. `trunc` is set if nonzero digits were dropped after the last.
Decimal :: struct {
    d: [MAX_DIGITS]u8
    nd: usize
    dp: i64
    trunc: u8
}

// The decimal shifts that bring a number with `dp` integer digits close to the range
// [0.5, 1): the number of bits to shift by, indexed by `dp`.
POWTAB :: [_]i64(1, 3, 6, 9, 13, 16, 19, 23, 26)

// Removes trailing zeros.
trim_decimal :: fn(a: ^Decimal) {
    while a.nd > 0 and a.d[a.nd - 1] is 0 { a.nd -= 1 }
    if a.nd is 0 { a.dp = 0 }
}

// Divides `a` by 2^k, for k from 1 to 60.
right_shift :: fn(a: ^Decimal, k: u32) {
    r: usize = 0 // read index
    w: usize = 0 // write index
    n: u64 = 0
    // Read digits until `n` holds at least one quotient digit.
    while (n >> k) is 0 {
        if r >= a.nd {
            if n is 0 {
                a.nd = 0
                return
            }
            while (n >> k) is 0 {
                n *= 10
                r += 1
            }
            break
        }
        n = n * 10 + u64(a.d[r])
        r += 1
    }
    a.dp -= r.trunc(i64) - 1
    mask: u64 = (u64(1) << k) - 1
    while r < a.nd {
        dig := n >> k
        n &= mask
        a.d[w] = dig.trunc(u8)
        w += 1
        n = n * 10 + u64(a.d[r])
        r += 1
    }
    while n > 0 {
        dig := n >> k
        n &= mask
        if w < MAX_DIGITS {
            a.d[w] = dig.trunc(u8)
            w += 1
        } else if dig > 0 {
            a.trunc = 1
        }
        n *= 10
    }
    a.nd = w
    trim_decimal(a)
}

// Multiplies `a` by 2^k, for k from 1 to 60.
left_shift :: fn(a: ^Decimal, k: u32) {
    // The product's digits, least significant last; there are at most `nd` + 19.
    scratch: [MAX_DIGITS + 32]u8 = ---
    end := scratch.len
    p: usize = 0 // digits produced
    n: u64 = 0
    r := a.nd
    while r > 0 {
        r -= 1
        n += u64(a.d[r]) << k
        quo := n / 10
        scratch[end - 1 - p] = (n - 10 * quo).trunc(u8)
        p += 1
        n = quo
    }
    while n > 0 {
        quo := n / 10
        scratch[end - 1 - p] = (n - 10 * quo).trunc(u8)
        p += 1
        n = quo
    }
    start := end - p
    keep := if p > MAX_DIGITS { MAX_DIGITS } else { p }
    for i in 0..keep { a.d[i] = scratch[start + i] }
    for i in keep..p {
        if scratch[start + i] is not 0 { a.trunc = 1 }
    }
    a.dp += p.trunc(i64) - a.nd.trunc(i64)
    a.nd = keep
    trim_decimal(a)
}

// Multiplies `a` by 2^k (divides, for negative k).
shift :: fn(a: ^Decimal, k: i64) {
    if a.nd is 0 { return }
    left := k
    while left > 60 {
        left_shift(a, 60)
        left -= 60
    }
    if left > 0 { left_shift(a, left.trunc(u32)) }
    right := -k
    while right > 60 {
        right_shift(a, 60)
        right -= 60
    }
    if right > 0 { right_shift(a, right.trunc(u32)) }
}

// Whether `a` rounded to `nd` digits rounds up (half to even).
should_round_up :: fn(a: ^const Decimal, nd: usize) -> bool {
    if nd >= a.nd { return false }
    if a.d[nd] is 5 and nd + 1 is a.nd {
        // Exactly halfway, unless digits were dropped, which makes it a little more.
        if a.trunc is 1 { return true }
        return nd > 0 and a.d[nd - 1] % 2 is 1
    }
    return a.d[nd] >= 5
}

// The integer part of `a`, rounded half to even. Only used when it is below 2^64.
rounded_integer :: fn(a: ^const Decimal) -> u64 {
    if a.dp < 0 { return 0 }
    dp := a.dp.trunc(usize)
    n: u64 = 0
    i: usize = 0
    while i < dp and i < a.nd {
        n = n * 10 + u64(a.d[i])
        i += 1
    }
    while i < dp {
        n *= 10
        i += 1
    }
    if should_round_up(a, dp) { n += 1 }
    return n
}

// The bits of the nonnegative float nearest to `a`, in a format with `mant_bits` stored
// significand bits, `exp_bits` exponent bits and the (negative) unbiased exponent
// `bias` of the exponent field 0. Too large is infinity.
decimal_bits :: fn(a: ^Decimal, mant_bits, exp_bits: u32, bias: i64) -> u64 {
    emax := (i64(1) << exp_bits) - 1
    inf: u64 = emax.trunc(u64) << mant_bits
    if a.nd is 0 { return 0 }
    if a.dp > 310 { return inf }
    if a.dp < -330 { return 0 }
    // Scale by powers of two until the number is in [0.5, 1).
    exp: i64 = 0
    while a.dp > 0 {
        n: i64 = 27
        if a.dp < 9 { n = POWTAB[a.dp.trunc(usize)] }
        shift(a, -n)
        exp += n
    }
    while a.dp < 0 or (a.dp is 0 and a.d[0] < 5) {
        n: i64 = 27
        if -a.dp < 9 { n = POWTAB[(-a.dp).trunc(usize)] }
        shift(a, n)
        exp -= n
    }
    // The range is [0.5, 1) and the float's is [1, 2).
    exp -= 1
    // The least exponent is bias + 1; below it the number is subnormal.
    if exp < bias + 1 {
        n := bias + 1 - exp
        shift(a, -n)
        exp += n
    }
    if exp - bias >= emax { return inf }
    // The significand: 1 + mant_bits bits, rounded.
    shift(a, 1 + mant_bits.trunc(i64))
    mant := rounded_integer(a)
    if mant is u64(2) << mant_bits {
        // Rounding added a bit.
        mant >>= 1
        exp += 1
        if exp - bias >= emax { return inf }
    }
    // Without the leading bit, the number is subnormal.
    if mant & (u64(1) << mant_bits) is 0 { exp = bias }
    return (mant & ((u64(1) << mant_bits) - 1)) | ((exp - bias).trunc(u64) << mant_bits)
}

// The float of type `T` with the bits `b` (in the low bits).
from_bits :: fn(T: type, b: u64) -> T where Float(T) {
    x: T = ---
    bytes := (&x).cast([^]u8)
    n := @size_of(T)
    for i in 0..n {
        at := if target.endian is .Little { i } else { n - 1 - i }
        bytes[at] = ((b >> (8 * i).trunc(u32)) & 0xff).trunc(u8)
    }
    return x
}

/// Parses the decimal number in `s` as a `T` (`f16`, `f32` or `f64`).
///
/// The syntax is an optional sign, then either `inf`, `infinity` or `nan` in any case,
/// or digits with an optional fraction and an optional exponent: `12`, `1.5`, `.5`,
/// `5.`, `1e-3`, `6.02E+23`. There must be a digit in the mantissa and in the exponent,
/// and a single `_` may separate two digits (`1_000.5`). Nothing else is allowed, not
/// even whitespace; an unexpected byte, a missing digit or a misplaced `_` is
/// `.InvalidDigit` with the index (`s.len` when the string ends early).
///
/// The result is the float nearest to the exact value of the decimal number, with ties
/// to even, for any number of digits: subnormal values are exact and a number too large
/// for `T` is infinite (with its sign). A number too small for `T` is zero.
pub parse_float :: fn(T: type, s: string) -> ParseError!T where Float(T) {
    if s.len is 0 { return !.Empty }
    // The format: stored significand bits, exponent bits and the bias.
    size := @size_of(T)
    mant_bits: u32 = if size is 8 { 52 } else if size is 4 { 23 } else { 10 }
    exp_bits: u32 = if size is 8 { 11 } else if size is 4 { 8 } else { 5 }
    bias: i64 = 1 - (i64(1) << (exp_bits - 1))
    i: usize = 0
    sign_bit: u64 = 0
    if s[0] is '-' {
        sign_bit = u64(1) << (mant_bits + exp_bits)
        i = 1
    } else if s[0] is '+' {
        i = 1
    }
    inf_bits: u64 = ((u64(1) << exp_bits) - 1) << mant_bits
    if i < s.len and (ascii.to_lower(s[i]) is 'i' or ascii.to_lower(s[i]) is 'n') {
        rest := s[i..s.len]
        if eq_ignore_case(rest, "inf") or eq_ignore_case(rest, "infinity") {
            return from_bits(T, sign_bit | inf_bits)
        }
        if eq_ignore_case(rest, "nan") {
            return from_bits(T, sign_bit | inf_bits | (u64(1) << (mant_bits - 1)))
        }
        return !.InvalidDigit(at: i)
    }
    // The mantissa: its digits go into `dec`, without leading zeros.
    dec: Decimal = ---
    dec.nd = 0
    dec.dp = 0
    dec.trunc = 0
    seen: i64 = 0 // significant digits so far, including any dropped
    dp: i64 = 0
    saw_dot := false
    saw_digit := false
    after_digit := false
    after_us := false
    while i < s.len {
        c := s[i]
        if c is '_' {
            if not after_digit { return !.InvalidDigit(at: i) }
            after_digit = false
            after_us = true
        } else if c is '.' {
            if saw_dot or after_us { return !.InvalidDigit(at: i) }
            saw_dot = true
            dp = seen
            after_digit = false
        } else if c >= '0' and c <= '9' {
            saw_digit = true
            after_digit = true
            after_us = false
            v := c - '0'
            if v is 0 and seen is 0 {
                if saw_dot { dp -= 1 }
            } else {
                if dec.nd < MAX_DIGITS {
                    dec.d[dec.nd] = v
                    dec.nd += 1
                } else if v is not 0 {
                    dec.trunc = 1
                }
                seen += 1
            }
        } else {
            break
        }
        i += 1
    }
    if after_us or not saw_digit { return !.InvalidDigit(at: i) }
    if not saw_dot { dp = seen }
    // The exponent.
    e: i64 = 0
    if i < s.len and ascii.to_lower(s[i]) is 'e' {
        i += 1
        eneg := false
        if i < s.len and s[i] is '-' {
            eneg = true
            i += 1
        } else if i < s.len and s[i] is '+' {
            i += 1
        }
        after_digit = false
        while i < s.len {
            c := s[i]
            if c is '_' {
                if not after_digit { return !.InvalidDigit(at: i) }
                after_digit = false
            } else if c >= '0' and c <= '9' {
                after_digit = true
                // Beyond this the value is zero or infinite whatever the mantissa.
                if e < 100_000 { e = e * 10 + i64(c - '0') }
            } else {
                break
            }
            i += 1
        }
        if not after_digit { return !.InvalidDigit(at: i) }
        if eneg { e = -e }
    }
    if i < s.len { return !.InvalidDigit(at: i) }
    dec.dp = dp + e
    trim_decimal(&dec)
    return from_bits(T, sign_bit | decimal_bits(&dec, mant_bits, exp_bits, bias))
}

// ---------------------------------------------------------------------------------
// Building strings in caller memory
// ---------------------------------------------------------------------------------

/// Appends text to a buffer you supply. It allocates nothing; appending beyond the
/// buffer's length is a trap (`"str: builder is full"`). Create one with `builder`.
///
/// To format into a builder, use it as the sink of `@write` (§21.6.1):
/// `@write(fn(bytes) => b.push(bytes), "{} of {}", n, total)`.
pub Builder :: struct {
    buf: []u8
    used: usize
}

/// A builder that appends to `buf`, starting empty.
pub builder :: fn(buf: []u8) -> Builder => Builder(buf: buf, used: 0)

/// Appends the bytes of `s`. Traps if they do not fit.
pub push :: fn(b: ^Builder, s: string) {
    if s.len > b.buf.len - b.used { trap("str: builder is full") }
    b.buf[b.used..b.used + s.len].copy_from(s)
    b.used += s.len
}

/// Appends one byte. Traps if the builder is full.
pub push_byte :: fn(b: ^Builder, c: u8) {
    if b.used >= b.buf.len { trap("str: builder is full") }
    b.buf[b.used] = c
    b.used += 1
}

/// What has been appended so far (valid until the builder is next changed).
pub str :: fn(b: ^const Builder) -> string => b.buf[0..b.used]

/// The number of bytes appended.
pub len :: fn(b: ^const Builder) -> usize => b.used

/// Forgets everything appended, keeping the buffer.
pub reset :: fn(b: ^Builder) {
    b.used = 0
}

/// Appends `args` formatted by `template`, as `print` would write them (§21.6.1):
/// `b.write("{} of {}", n, total)`. Traps like `push` if the result does not fit.
pub write :: fn(A: type, b: ^Builder, template :: string, args: ..A) {
    @write(fn(bytes: []const u8) => push(b, bytes), template, ..args)
}

// ---------------------------------------------------------------------------------
// Joining and copying
// ---------------------------------------------------------------------------------

/// Formatted text (§21.6.1) in memory from the current allocator (release it with
/// `free`): `str.format("{}-{:03}", name, n)`. To append to a list instead, use
/// `List(u8).write`.
pub format :: fn(A: type, template :: string, args: ..A) -> AllocError![]u8 needs Alloc {
    // As `List(u8).write`, written out: this function has an instance per template, and
    // one function per template instead of two keeps programs smaller.
    l := list(u8)
    failed := false
    @write(fn(bytes) {
        if not failed {
            l.extend(bytes) else {
                failed = true
            }
        }
    }, template, ..args)
    if failed {
        l.deinit()
        return !.OutOfMemory
    }
    return l.into_slice()
}

/// The `parts` with `sep` between them, in memory from the current allocator. The result
/// is a `[]u8` (it converts to a `string` where one is wanted) so that it can be given
/// back with `free`.
pub join :: fn(parts: []const string, sep: string) -> AllocError![]u8 needs Alloc {
    n: usize = 0
    for i in 0..parts.len {
        if i > 0 { n += sep.len }
        n += parts[i].len
    }
    out := try make(u8, n)
    at: usize = 0
    for i in 0..parts.len {
        if i > 0 {
            out[at..at + sep.len].copy_from(sep)
            at += sep.len
        }
        out[at..at + parts[i].len].copy_from(parts[i])
        at += parts[i].len
    }
    return out
}
