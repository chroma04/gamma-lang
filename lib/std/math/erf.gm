// The polynomial with coefficients `c` (c[0] first) at the double-double `x`.
poly_dd :: fn(c: []const f64, x: (f64, f64)) -> (f64, f64) {
    i := c.len - 1
    acc := (c[i], 0.0)
    while i > 0 {
        i -= 1
        acc = dd_add(dd_mul(acc, x), (c[i], 0.0))
    }
    return acc
}

// erf(x) for |x| < 0.84375: x + x*P(z)/Q(z) with z = x*x.
erf_small :: fn(x: f64) -> (f64, f64) {
    z := two_prod(x, x)
    y := dd_div(poly_dd(ERF_PP[..], z), poly_dd(ERF_QQ[..], z))
    return dd_add((x, 0.0), dd_mul_d(y, x))
}

// erfc(|x|) for 0.84375 <= |x| < 28 as a double-double, given the high word
// `ix` of |x|.
erfc_tail :: fn(ix: i32, x0: f64) -> (f64, f64) {
    ax := abs(x0)
    if ix < 0x3ff40000 {
        // |x| < 1.25: 1 - erx - P(s)/Q(s) with s = |x| - 1 (exact)
        s := (ax - 1.0, 0.0)
        return dd_sub((1.0 - ERF_ERX, 0.0), dd_div(poly_dd(ERF_PA[..], s), poly_dd(ERF_QA[..], s)))
    }
    z := (1.0 / (ax * ax), 0.0)
    rs := (0.0, 0.0)
    if ix < 0x4006db6d {
        // |x| < 1/0.35
        rs = dd_div(poly_dd(ERF_RA[..], z), poly_dd(ERF_SA[..], z))
    } else {
        rs = dd_div(poly_dd(ERF_RB[..], z), poly_dd(ERF_SB[..], z))
    }
    // exp(-x*x - 0.5625 + R/S) / x, with the argument of the exponential in
    // double-double precision (x*x is exact there): the argument is as large as
    // 745, so a rounding error of its own would spoil the result.
    arg := dd_sub(rs, dd_add(two_prod(ax, ax), (0.5625, 0.0)))
    if arg.0 < -746.0 { return (0.0, 0.0) }
    parts := exp_parts_dd(arg.0)
    f := dd_mul(dd_add((1.0, 0.0), parts.0), dd_add((1.0, 0.0), (arg.1 + 0.5 * arg.1 * arg.1, 0.0)))
    r := dd_div(f, (ax, 0.0))
    return (scalbn(r.0, parts.1), scalbn(r.1, parts.1))
}

/// The error function of `x`, an odd function: `erf(+-inf)` is +-1 and the
/// sign of zero is preserved. The result is +-1 exactly for `|x|` of 6 and
/// more (the difference is below half an ulp).
pub erf :: fn(x: f64) -> f64 {
    hx := high_word(x)
    sign := (hx >> 31) & 1
    ix := hx & 0x7fffffff
    if ix >= 0x7ff00000 {
        // erf(NaN) is NaN
        return 1.0 - 2.0 * f64(sign) + 1.0 / x
    }
    if ix < 0x3feb0000 {
        // |x| < 0.84375
        if ix < 0x3e300000 {
            // |x| < 2**-28: avoid underflow
            return 0.125 * (8.0 * x + ERF_EFX8 * x)
        }
        return erf_small(x).0
    }
    y := 1.0
    if ix < 0x40180000 {
        // 0.84375 <= |x| < 6
        y = dd_sub((1.0, 0.0), erfc_tail(ix, x)).0
    } else {
        tiny := 0x1.0p-1022
        y = 1.0 - tiny
    }
    return if sign is 0 { y } else { -y }
}

/// The complementary error function `1 - erf(x)`, computed without the
/// cancellation of that formula: it is accurate (in relative terms) for large
/// `x`. The result is subnormal from `x` of about 26.55 and underflows to +0
/// above about 27.22; it is 2 for `x` below about -6, `erfc(+inf)` is 0 and
/// `erfc(-inf)` is 2.
pub erfc :: fn(x: f64) -> f64 {
    hx := high_word(x)
    sign := (hx >> 31) & 1
    ix := hx & 0x7fffffff
    if ix >= 0x7ff00000 {
        // erfc(NaN) is NaN
        return 2.0 * f64(sign) + 1.0 / x
    }
    if ix < 0x3feb0000 {
        // |x| < 0.84375
        if ix < 0x3c700000 {
            // |x| < 2**-56
            return 1.0 - x
        }
        return dd_sub((1.0, 0.0), erf_small(x)).0
    }
    if ix < 0x403c0000 {
        // 0.84375 <= |x| < 28
        if sign is not 0 { return dd_sub((2.0, 0.0), erfc_tail(ix, x)).0 }
        return erfc_tail(ix, x).0
    }
    tiny := 0x1.0p-1022
    if sign is not 0 { return 2.0 - tiny }
    return tiny * tiny
}
