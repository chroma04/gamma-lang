// Roots and norms: cbrt and hypot (fdlibm / FreeBSD msun).

CBRT_B1: u32 : 715094163
CBRT_B2: u32 : 696219795
CBRT_P0 :: 1.87595182427177009643
CBRT_P1 :: -1.88497979543377169875
CBRT_P2 :: 1.621429720105354466140
CBRT_P3 :: -0.758397934778766047437
CBRT_P4 :: 0.145996192886612446982

/// The real cube root of `x`, within 0.67 ulp. It is defined for negative `x`
/// (`cbrt(-8)` is -2) and preserves infinities, NaNs and the sign of zero.
pub cbrt :: fn(x: f64) -> f64 {
    hx0 := high_word(x).trunc(u32)
    low := low_word(x)
    sign := hx0 & 0x80000000
    hx := hx0 ~ sign
    if hx >= 0x7ff00000 { return x + x }

    // A rough cube root to 5 bits: divide the biased exponent and mantissa
    // as an integer by 3, after correcting the bias.
    t := 0.0
    if hx < 0x00100000 {
        // Zero or subnormal.
        if (hx | low) is 0 { return x }
        t = from_words(0x43500000, 0) * x
        high := high_word(t).trunc(u32)
        t = from_words((sign | ((high & 0x7fffffff) / 3 + CBRT_B2)).trunc(i32), 0)
    } else {
        t = from_words((sign | (hx / 3 + CBRT_B1)).trunc(i32), 0)
    }

    // Refine to 23 bits with a polynomial in r = t**3 / x.
    r := (t * t) * (t / x)
    t = t * ((CBRT_P0 + r * (CBRT_P1 + r * CBRT_P2)) + ((r * r) * r) * (CBRT_P3 + r * CBRT_P4))

    // Round t away from zero to 23 bits, so that t*t and t*t*t are exact.
    t = ((t.bits(u64) +% 0x80000000) & 0xffff_ffff_c000_0000).bits(f64)

    // One Halley iteration to 53 bits.
    s := t * t
    r = x / s
    w := t + t
    r = (r - t) / (w + r)
    return t + t * r
}

/// The length of the hypotenuse, `sqrt(x*x + y*y)`, without undue overflow or
/// underflow and within 1 ulp. It is +inf if either argument is infinite
/// (even if the other is NaN).
pub hypot :: fn(x: f64, y: f64) -> f64 {
    if x.is_inf() or y.is_inf() { return inf }
    if x.is_nan() or y.is_nan() { return x + y }
    ha := high_word(x) & 0x7fffffff
    hb := high_word(y) & 0x7fffffff
    a := 0.0
    b := 0.0
    if hb > ha {
        a = y
        b = x
        swap := ha
        ha = hb
        hb = swap
    } else {
        a = x
        b = y
    }
    a = abs(a)
    b = abs(b)
    // x/y > 2**60
    if (ha - hb) > 0x3c00000 { return a + b }
    k: i32 = 0
    if ha > 0x5f300000 {
        // a > 2**500: scale a and b by 2**-600.
        ha -= 0x25800000
        hb -= 0x25800000
        k += 600
        a = set_high(a, ha)
        b = set_high(b, hb)
    }
    if hb < 0x20b00000 {
        // b < 2**-500
        if hb <= 0x000fffff {
            // b is zero or subnormal.
            if (hb | low_word(b).trunc(i32)) is 0 { return a }
            scale := from_words(0x7fd00000, 0)
            b *= scale
            a *= scale
            k -= 1022
            ha = high_word(a)
            hb = high_word(b)
        } else {
            // Scale a and b by 2**600.
            ha += 0x25800000
            hb += 0x25800000
            k -= 600
            a = set_high(a, ha)
            b = set_high(b, hb)
        }
    }
    // Medium size a and b: Dekker-style exact squares.
    w := a - b
    if w > b {
        t1 := from_words(ha, 0)
        t2 := a - t1
        w = (t1 * t1 - (b * (-b) - t2 * (a + t1))).sqrt()
    } else {
        a2 := a + a
        y1 := from_words(hb, 0)
        y2 := b - y1
        t1 := from_words(ha + 0x00100000, 0)
        t2 := a2 - t1
        w = (t1 * y1 - (w * (-w) - (t1 * y2 + t2 * b))).sqrt()
    }
    if k is not 0 { return from_words((1023 + k) << 20, 0) * w }
    return w
}
