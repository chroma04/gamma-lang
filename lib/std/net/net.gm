//! Helpers over the `Net` effect (§21.7) for TCP connections.
//!
//!     net :: import "std/net"
//!     s := try Net.connect("localhost", 8080)
//!     defer Net.close_socket(s)
//!     try net.send_all(s, "ping\n")
//!     reply: [5]u8 = ---
//!     try net.recv_exact(s, reply[..])

/// A TCP connection (§21.7).
pub Socket :: core.Socket

/// A TCP socket listening for connections.
pub Listener :: core.Listener

/// Which direction of a connection `Net.shutdown` closes.
pub Shutdown :: core.Shutdown

/// Sends all of `bytes` on `s`, retrying short sends. A send that makes no progress (returns
/// 0) fails with `.Other(0)`.
pub send_all :: fn(s: Socket, bytes: []const u8) -> IoError!() needs Net {
    done: usize = 0
    while done < bytes.len {
        n := try s.send(bytes[done..bytes.len])
        if n is 0 { return !.Other(0) }
        done += n
    }
    return ()
}

/// Fills `buf` completely from `s`. `UnexpectedEof` if the peer closes the connection
/// first.
pub recv_exact :: fn(s: Socket, buf: []u8) -> IoError!() needs Net {
    done: usize = 0
    while done < buf.len {
        n := try s.recv(buf[done..buf.len])
        if n is 0 { return !.UnexpectedEof }
        done += n
    }
    return ()
}
