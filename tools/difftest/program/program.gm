//! Generates a random, well-typed, terminating Gamma program from a seed.
//!
//! Every expression is generated for a requested type and fully parenthesized, so the
//! operator-mixing rules of the language never apply. Termination comes from construction:
//! loops have constant bounds, a function calls only functions generated before it, and
//! recursion is bounded by a depth argument. A running cost estimate keeps nested loops
//! and calls from multiplying into long runs. Checked operations may trap; the point of the
//! test is that every back end traps in the same way.

rng :: import "../rng"
str :: import "std/str"

TRAP_BIAS: [6]usize : [_]usize(0, 0, 1, 3, 10, 40)

/// The program of `seed`, allocated with the ambient allocator.
pub program :: fn(seed: u64) -> string needs Alloc {
    r := rng.new(seed)
    trap_bias := r.pick(TRAP_BIAS)
    p0 := pick_int(&r)
    p1 := pick_int(&r)
    p2 := pick_int(&r)
    sh_circle := pick_int(&r)
    sh0 := pick_int(&r)
    sh1 := pick_int(&r)
    er_bad := pick_int(&r)
    feat := features(&r)
    ev0 := pick_int(&r)
    ev1 := pick_int(&r)
    ev2 := pick_int(&r)
    co0 := pick_int(&r)
    co1 := pick_int(&r)
    fib_it := pick_int(&r)
    g := Gen(
        rng: r,
        funcs: list(Func),
        trap_bias: trap_bias,
        p_fields: [_]It(p0, p1, p2),
        sh_circle: sh_circle,
        sh_rect: [_]It(sh0, sh1),
        er_bad: er_bad,
        vars: list(Var),
        feat: feat,
        ev_t: [_]It(ev0, ev1, ev2),
        co_t: [_]It(co0, co1),
        fib_it: fib_it,
    )
    out := list(u8)
    out.write("// difftest seed {}\n", seed)!
    out.write("P :: struct {{ a: {}, b: {}, c: {} }}\n", p0.it_name(), p1.it_name(), p2.it_name())!
    out.write("Sh :: union {{ Circle: {}, Rect: (w: {}, h: {}), Empty }}\n", sh_circle.it_name(), sh0.it_name(), sh1.it_name())!
    out.write("Er :: union {{ Bad: {}, Worse }}\n", er_bad.it_name())!
    out.extend(g.extra_decls())!
    out.extend("\n")!
    // Constructors of results: the variant follows the first argument.
    for i in 0..10 {
        t := if i < 8 { INTS[i] } else { WIDE[i - 8] }
        bad := g.conv(U8, er_bad, "k")
        n := t.it_name()
        out.write("mk_{} :: fn(k: u8, v: {}) -> Er!{} {{\n    if k % 4 is 0 {{ return !.Worse }}\n    if k % 4 is 1 {{ return !.Bad({}) }}\n    return v\n}}\n", n, n, n, bad)!
    }
    for i in 0..10 {
        t := if i < 8 { INTS[i] } else { WIDE[i - 8] }
        n := t.it_name()
        out.write("sum_{} :: fn(xs: []const {}) -> {} {{\n    total: {} = 0\n    for x in xs {{ total +%= x }}\n    return total\n}}\n", n, n, n, n)!
    }
    out.extend("\n")!
    nfuncs := 2 + g.rng.below(6)
    for i in 0..nfuncs {
        out.extend(g.function(i))!
        out.extend("\n")!
    }
    out.extend(g.fiber_decls())!
    out.extend(g.main_fn())!
    return out.items
}
