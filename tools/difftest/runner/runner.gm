//! Runs a program with the interpreter and with the C back end, and compares what they do.

path :: import "std/path"
process :: import "std/process"
str :: import "std/str"
thread :: import "std/thread"

/// What a run of a program produced.
pub Outcome :: struct {
    pub stdout: string
    pub stderr: string
    /// The exit status (128 plus the signal if a signal ended the program), -1 for a
    /// timeout, -2 if the process could not be run.
    pub code: i32
}

/// What the runs are made with.
pub Config :: struct {
    /// The gamma executable.
    pub gamma: string
    /// The C compilers to compare with the interpreter.
    pub ccs: []const string
    /// The build mode passed to gamma.
    pub mode: string
    /// Where programs are written.
    pub work: string
    /// The limit for one run, in seconds.
    pub timeout_s: u64
}

/// The outcome of one configuration (`interp`, or the name of a C compiler).
pub Result :: struct {
    pub name: string
    pub outcome: Outcome
}

/// Whether two outcomes are the same.
pub same :: fn(a, b: ^const Outcome) -> bool => a.code is b.code and a.stdout is b.stdout and a.stderr is b.stderr

// The watchdog of a running program: kills it once its time is up, unless told it is done.
Watch :: struct {
    child: process.Child
    limit: Duration
    m: thread.Mutex
    cv: thread.Condvar
    done: bool = false
    fired: bool = false
}

watch :: fn(w: ^Watch) needs Sys {
    thread.defaults(fn() needs Clock + Proc {
        start := Clock.now()
        w.m.lock()
        while not w.done {
            spent := Clock.now().since(start)
            if spent.ns >= w.limit.ns {
                w.fired = true
                _ = Proc.kill(w.child)
                break
            }
            _ = w.cv.wait_timeout(&w.m, w.limit.minus(spent))
        }
        w.m.unlock()
    })
}

/// Runs `argv` with the changes `env` (`NAME=value`) to its environment and collects its
/// output. A program that runs longer than `timeout_s` seconds is killed, together with
/// everything it started, which would otherwise keep the pipes open.
pub run_with_timeout :: fn(argv: []const string, env: []const string, timeout_s: u64) -> Outcome needs Alloc + Clock + Proc + Sys {
    opts := process.SpawnOptions(stdin: .Null, stdout: .Pipe, stderr: .Pipe, env: env, group: true)
    child := Proc.spawn(argv, opts) else return Outcome(stdout: "", stderr: "cannot run the process", code: -2)
    w := Watch(child: child, limit: Duration(ns: timeout_s * 1_000_000_000), m: thread.mutex(), cv: thread.condvar())
    watcher := thread.spawn(watch, &w) else {
        _ = Proc.kill(child)
        _ = Proc.wait(child)
        return Outcome(stdout: "", stderr: "cannot start a thread", code: -2)
    }
    out := list(u8)
    err := list(u8)
    buf: [16384]u8 = ---
    read_failed := false
    while true {
        chunk := Proc.read(child, buf[..]) else {
            read_failed = true
            _ = Proc.kill(child)
            break
        }
        got := chunk else break
        dst := if got.from is .Stdout { &out } else { &err }
        dst.extend(buf[0..got.len])!
    }
    w.m.lock()
    w.done = true
    w.m.unlock()
    w.cv.signal()
    thread.join(watcher)
    status := Proc.wait(child)
    code: i32 = -2
    if w.fired {
        code = -1
    } else if not read_failed {
        if s := status {
            code = match s {
                .Exited(c) => c.trunc(i32)
                .Signaled(sig) => 128 + sig
            }
        }
    }
    return Outcome(stdout: string(out.items), stderr: string(err.items), code: code)
}

/// Runs `file` with the interpreter (`cc` is null) or the C back end compiled by `cc`.
pub run_one :: fn(cfg: ^const Config, file: string, cc: ?string) -> Outcome needs Alloc + Clock + Proc + Sys {
    argv := list(string)
    argv.push(cfg.gamma)!
    argv.push("run")!
    argv.push(str.format("--mode={}", cfg.mode)!)!
    argv.push(if cc is null { "--backend=interp" } else { "--backend=c" })!
    argv.push("--diag-format=short")!
    argv.push(file)!
    env := list(string)
    if c := cc { env.push(str.format("CC={}", c)!)! }
    cache := path.join_alloc([_]string(cfg.work, "cache"))!
    env.push(str.format("GAMMA_CACHE_DIR={}", cache)!)!
    o := run_with_timeout(argv.items, env.items, cfg.timeout_s)
    // Diagnostics and trap reports name the file; the directory differs per seed.
    return Outcome(stdout: o.stdout, stderr: str.replace_alloc(o.stderr, file, "FILE")!, code: o.code)
}

/// The outcomes of every configuration: the interpreter first, then each C compiler.
pub run_all :: fn(cfg: ^const Config, file: string) -> List(Result) needs Alloc + Clock + Proc + Sys {
    v := list(Result)
    v.push(Result(name: "interp", outcome: run_one(cfg, file, null)))!
    for cc in cfg.ccs { v.push(Result(name: cc, outcome: run_one(cfg, file, cc)))! }
    return v
}

/// Which configurations disagree with the interpreter, as a signature (`gcc+clang`), or
/// null if they all agree.
pub disagreement :: fn(results: []const Result) -> ?string needs Alloc {
    names := list(string)
    for i in 1..results.len {
        if not same(&results[i].outcome, &results[0].outcome) { names.push(results[i].name)! }
    }
    if names.items.len is 0 { return null }
    return str.join(names.items, "+")!
}

/// Whether the compiler rejected the program, which is a bug of the generator (or of the
/// compiler).
pub rejected :: fn(base: ^const Outcome) -> bool => base.code is 1 and base.stdout.len is 0 and str.contains(base.stderr, "error")

/// All the outcomes, for a report.
pub describe :: fn(results: []const Result) -> string needs Alloc {
    s := list(u8)
    for r in results {
        s.write("--- {}: exit {}\n", r.name, r.outcome.code)!
        s.extend("stdout:\n")!
        s.extend(r.outcome.stdout)!
        s.extend("stderr:\n")!
        s.extend(r.outcome.stderr)!
    }
    return s.items
}
