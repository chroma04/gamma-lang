// A freestanding program: no `main`, no operating system. The host program that links the
// object provides `uart_putc` and `harness_trap`.
fixed_buffer :: import "std/fixed_buffer"

hw :: foreign "c" {
    uart_putc :: fn(c: u8)
    harness_trap :: fn(msg: [^]const u8, len: usize, line: u32, col: u32, file_len: usize) -> never
}

squares :: fn(n: u32) needs Yield(u32) {
    for i in 0..n { Yield.yield(i * i) }
}

#export("gm_entry")
entry :: fn() needs Sys {
    // Every byte of the output goes to the serial port.
    uart :: handler Out {
        write(bytes) => {
            for b in bytes { hw.uart_putc(b) }
        }
    }
    store: [1024]u8 = ---
    fb := fixed_buffer.over(store[..])
    with uart, fb.allocator() {
        print("hello from {} with {:.2} and {:x}\n", "firmware", 3.14159, 255)
        xs := list(u32)
        for i in 0..5 {
            _ = xs.push(i * 3)
        }
        print("list: {}\n", xs.items)
        total: u32 = 0
        for s in squares(5) { total += s }
        print("squares sum: {}\n", total)
        print("used: {}\n", fb.bytes_used() > 0)
    }
}

#trap_hook
on_trap :: fn(msg: string, loc: SourceLocation) -> never needs Sys {
    hw.harness_trap(msg.ptr, msg.len, loc.line, loc.column, loc.file.len)
}

#export("gm_crash")
crash :: fn(i: usize) -> u8 {
    xs := [4]u8(1, 2, 3, 4)
    return xs[i]
}
