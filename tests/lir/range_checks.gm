// Slicing checks that comparisons before them prove are removed (spec D.7); the others
// stay.

sum :: fn(xs: []const u32) -> u32 {
    t: u32 = 0
    for x in xs { t +%= x }
    return t
}

// No checks: `lo <= hi <= len` is proven.
tail :: fn(xs: []const u32, i: usize) -> u32 {
    if i > xs.len { return 0 }
    return sum(xs[i..])
}

head :: fn(xs: []const u32, n: usize) -> u32 {
    if n <= xs.len { return sum(xs[..n]) }
    return 0
}

middle :: fn(xs: []const u32, i, j: usize) -> u32 {
    if i <= j and j <= xs.len { return sum(xs[i..j]) }
    return 0
}

whole :: fn(xs: []const u32) -> u32 => sum(xs[..]) + sum(xs[0..xs.len])

array :: fn() -> u32 {
    a := [4]u32(1, 2, 3, 4)
    return sum(a[1..3]) + sum(a[0..=3])
}

// Each of these keeps its check.

// Nothing is known about `i`.
unknown :: fn(xs: []const u32, i: usize) -> u32 => sum(xs[i..])

// Only `hi <= len` is known, not `lo <= hi`.
unordered :: fn(xs: []const u32, i, j: usize) -> u32 {
    if j <= xs.len { return sum(xs[i..j]) }
    return 0
}

// An inclusive range needs `hi < len`.
inclusive :: fn(xs: []const u32, n: usize) -> u32 {
    if n <= xs.len { return sum(xs[0..=n]) }
    return 0
}

main :: fn() {
    xs := [3]u32(1, 2, 3)
    _ = tail(xs[..], 1) + head(xs[..], 2) + middle(xs[..], 0, 2) + whole(xs[..]) + array() + unknown(xs[..], 1) + unordered(xs[..], 0, 1) + inclusive(xs[..], 1)
}
