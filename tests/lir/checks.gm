// Bounds checks that a comparison before them proves are removed (spec D.7); the others
// stay.

// No checks: the loop's range, the loop's condition, and constants prove the indices.
range :: fn(xs: []const i64) -> i64 {
    t: i64 = 0
    for i in 0..xs.len { t += xs[i] }
    return t
}

array :: fn() -> i64 {
    a: [8]i64 = [8]i64(fill: 3)
    t: i64 = 0
    for i in 0..8 { t += a[i] }
    i: usize = 0
    while i < a.len {
        t += a[i]
        i += 1
    }
    return t + a[7]
}

// Through a bound no greater than the length: i < n <= xs.len.
shorter :: fn(xs: []const i64, n: usize) -> i64 {
    if n > xs.len { return 0 }
    t: i64 = 0
    for i in 0..n { t += xs[i] }
    return t
}

// Each of these keeps its check.

// The bound grows in the loop.
grow :: fn(xs: []const i64) -> i64 {
    t: i64 = 0
    n := xs.len
    i: usize = 0
    while i < n {
        n += 1
        t += xs[i]
        i += 1
    }
    return t
}

// The slice changes in the loop.
reassign :: fn(xs: []const i64, ys: []const i64) -> i64 {
    t: i64 = 0
    s := xs
    for i in 0..s.len {
        s = ys
        t += s[i]
    }
    return t
}

// The index may change after the comparison.
maybe :: fn(xs: []const i64, c: bool) -> i64 {
    i: usize = 0
    if i < xs.len {
        if c { i = 100 }
        return xs[i]
    }
    return 0
}

// The comparison is not against the length.
other :: fn(xs: []const i64, i: u8) -> i64 {
    if i < 3 { return xs[i] }
    return 0
}

// After the loop, the condition is false.
after :: fn(xs: []const i64) -> i64 {
    i: usize = 0
    while i < xs.len { i += 1 }
    return xs[i]
}

// The address of the index is taken.
addressed :: fn(xs: []const i64) -> i64 {
    i: usize = 0
    p := &i
    t: i64 = 0
    while i < xs.len {
        p^ = 9
        t += xs[i]
        i += 1
    }
    return t
}

main :: fn() {
    xs := [3]i64(1, 2, 3)
    _ = range(xs[..]) + array() + shorter(xs[..], 2) + grow(xs[..]) + reassign(xs[..], xs[..]) + maybe(xs[..], false) + other(xs[..], 1) + after(xs[0..0]) + addressed(xs[..])
}
