//! Tests of `gamma build -g`: the executable maps back to the Gamma source.
//!
//! The program is built with debug information and must behave exactly as without it.
//! The generated C (kept next to the executable) must carry `#line` directives naming
//! the source file, and frame fields must also have the names of the Gamma locals. When
//! `gdb` is installed, it must stop at a Gamma line and print a local by its name, and
//! show tuples, tagged unions, slices, optionals and results readably, with and without
//! the embedded pretty printers; when `lldb` is installed, it must show them too.
//! Without a usable C compiler (or debugger) the tests are skipped.

kit :: import "../kit"
fs :: import "std/fs"
process :: import "std/process"
str :: import "std/str"

pub tests :: fn(cfg: ^const kit.Config, out: ^List(kit.Test)) needs Alloc {
    out.push(kit.Test(name: "debug_information_maps_to_the_source", run: debug_information_maps_to_the_source))!
    out.push(kit.Test(name: "gdb_stops_at_gamma_lines", run: gdb_stops_at_gamma_lines))!
    out.push(kit.Test(name: "debug_views_are_declared", run: debug_views_are_declared))!
    out.push(kit.Test(name: "gdb_shows_gamma_values", run: gdb_shows_gamma_values))!
    out.push(kit.Test(name: "gdb_shows_views_without_the_pretty_printers", run: gdb_shows_views_without_the_pretty_printers))!
    out.push(kit.Test(name: "lldb_shows_views", run: lldb_shows_views))!
    out.push(kit.Test(name: "lldb_shows_gamma_values", run: lldb_shows_gamma_values))!
}

PROGRAM :: `
Point :: struct { x, y: i64 }

// Names that are also macros of system headers.
Stat :: struct { st_mtime, linux: i64 }

sum :: fn(n: i64) -> i64 {
    total := 0
    for i in 0..n {
        total += i
    }
    return total
}

main :: fn() needs Out {
    p := Point(x: 3, y: 4)
    stdout := sum(10)
    s := Stat(st_mtime: 1, linux: 2)
    print("{} {} {}\n", p.x + p.y, stdout, s.st_mtime + s.linux)
}
`

/// Values of the kinds whose debugger views are tested. `main` stops at line 33.
VIEWS :: `
Shape :: union {
    Circle: f64,
    Rect: (w: i64, h: i64),
    Empty,
}

Dir :: union { N, E, S, W }

Node :: struct { value: i64, next: ?^Node, tags: []const u8 }

Error :: union { Missing, Bad: i64 }

parse :: fn(x: i64) -> Error!i64 {
    if x < 0 {
        return !.Bad(x)
    }
    return x * 2
}

main :: fn() needs Out {
    pair := (1, true)
    rect := Shape.Rect(w: 2, h: 3)
    circle := Shape.Circle(1.5)
    dir := Dir.S
    xs := [3]i64(10, 20, 30)
    slice := xs[0..3]
    word := "hello"
    some: ?i64 = 5
    none: ?i64 = null
    last := Node(value: 2, next: null, tags: "b")
    first := Node(value: 1, next: &last, tags: "a")
    ok, bad := (parse(4), parse(-1))
    print("{} {} {}\n", pair.0, slice.len, first.value)
}
`

SKIP_NO_CC :: "no C compiler"

/// A program built by `build_program`: the executable and the directory it is in.
Built :: struct {
    exe: string
    dir: string
}

/// Writes the program to a fresh directory and builds it with `args`.
build :: fn(t: ^kit.T, name: string, args: []const string) -> kit.Fail!Built needs kit.Run {
    return build_program(t, name, "points", PROGRAM, args)
}

/// Writes `program` to `<stem>.gm` in a fresh directory and builds it with `args`.
build_program :: fn(t: ^kit.T, name, stem, program: string, args: []const string) -> kit.Fail!Built needs kit.Run {
    dir := try t.scratch(str.format("debug_info-{}", name)!)
    src := kit.join(dir, str.format("{}.gm", stem)!)
    try t.write(src, program)
    exe := kit.join(dir, stem)
    c := t.gamma([_]string("build"))
    c.args(args)
    c.args([_]string("-o", exe, src))
    _ = try t.run_ok(c)
    return Built(exe: exe, dir: dir)
}

/// Runs the executable, which must succeed, and returns its output.
run :: fn(t: ^kit.T, exe: string) -> kit.Fail!string needs kit.Run {
    out := try t.run_ok(kit.command(exe))
    return out.out
}

/// The generated C next to the executable.
c_of :: fn(t: ^kit.T, exe: string) -> kit.Fail!string needs kit.Run => t.read(str.format("{}.c", exe)!)

on_linux :: fn() -> bool {
    when target.os is .Linux {
        return true
    } else {
        return false
    }
}

/// Whether `program --version` runs.
tool_runs :: fn(program: string) -> bool needs Alloc + Proc {
    argv := [_]string(program, "--version")
    out := process.output(argv[..], process.SpawnOptions(stdin: .Null)) else return false
    return process.success(out.status)
}

debug_information_maps_to_the_source :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not t.cfg.c { return !t.skip(SKIP_NO_CC) }
    for mode in ("debug", "fast") {
        flag := str.format("--mode={}", mode)!
        b := try build(t, mode, [_]string("-g", flag))
        try t.expect_text("the output", "7 45 3\n", try run(t, b.exe))
        c := try c_of(t, b.exe)
        src := kit.join(b.dir, "points.gm")
        // `total += i` is line 9; source files are named with `/` on every system.
        directive := str.format("#line 9 \"{}\"", str.replace_alloc(src, "\\", "/")!)!
        try t.check(str.contains(c, directive), "no `{}` in the generated C", directive)
        try t.check(str.contains(c, " total; };"), "the frame field of `total` has no name")
        try t.check(str.contains(c, "#undef linux"), "a Gamma name that is a macro is not suspended")
    }
    // Without `-g` the C has no source mapping.
    b := try build(t, "plain", empty_slice(string))
    try t.expect_text("the output", "7 45 3\n", try run(t, b.exe))
    try t.check(not str.contains(try c_of(t, b.exe), "#line"), "the C of a build without -g has #line directives")
    return ()
}

/// Whether the tests of gdb can run; says why not through `t.skip` otherwise.
need_gdb :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not t.cfg.c or not tool_runs("gdb") or not on_linux() {
        return !t.skip("needs a C compiler and gdb on Linux")
    }
    return ()
}

/// Runs gdb in batch mode on `exe` with the arguments `args` (each `-ex` command and the
/// like); null if gdb cannot trace processes here.
gdb :: fn(t: ^kit.T, exe: string, args: []const string) -> kit.Fail!?string needs kit.Run {
    c := kit.command("gdb")
    c.args([_]string("-batch", "-nx"))
    c.args(args)
    c.arg(exe)
    out := try t.run(c)
    if str.contains(out.out, "ptrace") or str.contains(out.out, "Operation not permitted") {
        return null
    }
    return out.out
}

/// gdb `-ex` arguments that print each expression of `exprs`.
prints :: fn(args: ^List(string), exprs: []const string) needs Alloc {
    for e in exprs {
        args.push("-ex")!
        args.push(str.format("print {}", e)!)!
    }
}

/// Fails the test unless `text` has the lines `$1 = <expected[0]>`, `$2 = …` in order.
assert_printed :: fn(t: ^kit.T, text: string, expected: []const string) -> kit.Fail!() needs Alloc {
    for i, e in enumerate(expected) {
        line := str.format("${} = {}\n", i + 1, e)!
        try t.check(str.contains(text, line), "the debugger did not print `{}`:\n{}", str.trim_end(line), text)
    }
    return ()
}

gdb_stops_at_gamma_lines :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    try need_gdb(t)
    b := try build(t, "gdb", [_]string("-g"))
    r := try gdb(t, b.exe, [_]string("-ex", "break points.gm:17", "-ex", "run", "-ex", "print F.p", "-ex", "print F.p.y"))
    text := r else return !t.skip("gdb cannot trace processes here")
    try t.check(str.contains(text, "points.gm:17"), "gdb did not stop at points.gm:17:\n{}", text)
    try assert_printed(t, text, [_]string("{x = 3, y = 4}", "4"))
    return ()
}

/// The expressions printed at the end of `main` in `VIEWS`.
VIEWED :: [_]string(
    "F.pair",
    "F.rect",
    "F.circle",
    "F.dir",
    "F.slice",
    "F.word",
    "F.some",
    "F.none",
    "*F.first.next",
    "F.ok",
    "F.bad",
    "F.rect.Rect.h",
    "F.slice.ptr[2]",
)

debug_views_are_declared :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not t.cfg.c { return !t.skip(SKIP_NO_CC) }
    b := try build_program(t, "views-c", "views", VIEWS, [_]string("-g"))
    try t.expect_text("the output", "1 3 1\n", try run(t, b.exe))
    c := try c_of(t, b.exe)
    for needle in ("Shape_Rect = 1", "Dir_S = 2", "_union {", "_slice {", "_string {", " pair;", " next;") {
        try t.check(str.contains(c, needle), "no `{}` in the generated C", needle)
    }
    try t.check(str.contains(c, ".debug_gdb_scripts") is on_linux(), "`.debug_gdb_scripts` is {}in the generated C", if on_linux() { "missing " } else { "" })
    // Without `-g` there are no views.
    plain := try build_program(t, "views-plain", "views", VIEWS, empty_slice(string))
    try t.expect_text("the output", "1 3 1\n", try run(t, plain.exe))
    try t.check(not str.contains(try c_of(t, plain.exe), "gm_dv"), "the C of a build without -g has debugger views")
    return ()
}

gdb_shows_gamma_values :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    try need_gdb(t)
    b := try build_program(t, "views-gdb", "views", VIEWS, [_]string("-g"))
    args := list(string)
    args.extend([_]string("-iex", str.format("add-auto-load-safe-path {}", b.dir)!))!
    args.extend([_]string("-ex", "break views.gm:33", "-ex", "run"))!
    prints(&args, VIEWED)
    r := try gdb(t, b.exe, args.items)
    text := r else return !t.skip("gdb cannot trace processes here")
    try t.check(str.contains(text, "views.gm:33"), "gdb did not stop at views.gm:33:\n{}", text)
    try assert_printed(
        t,
        text,
        [_]string(
            "{_0 = 1, _1 = true}",
            "Shape_Rect = {w = 2, h = 3}",
            "Shape_Circle(1.5)",
            "Dir_S",
            "length 3 = {10, 20, 30}",
            "\"hello\"",
            "5",
            "null",
            "{value = 2, next = 0x0, tags = \"b\"}",
            "8",
            "!Error_Bad(-1)",
            "3",
            "30",
        ),
    )
    return ()
}

gdb_shows_views_without_the_pretty_printers :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    try need_gdb(t)
    b := try build_program(t, "views-gdb-raw", "views", VIEWS, [_]string("-g"))
    args := list(string)
    args.extend([_]string("-ex", "break views.gm:33", "-ex", "run"))!
    prints(&args, [_]string("F.pair", "F.rect.tag", "F.rect.Rect", "F.dir", "F.slice.len", "*F.slice.ptr@3", "F.some"))
    r := try gdb(t, b.exe, args.items)
    text := r else return !t.skip("gdb cannot trace processes here")
    try assert_printed(
        t,
        text,
        [_]string(
            "{_0 = 1, _1 = true}",
            "Shape_Rect",
            "{w = 2, h = 3}",
            "Dir_S",
            "3",
            "{10, 20, 30}",
            "{value = 5, present = true}",
        ),
    )
    return ()
}

/// Whether the tests of lldb can run; says why not through `t.skip` otherwise.
need_lldb :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not t.cfg.c or not tool_runs("lldb") { return !t.skip("needs a C compiler and lldb") }
    return ()
}

lldb_shows_views :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    try need_lldb(t)
    b := try build_program(t, "views-lldb", "views", VIEWS, [_]string("-g"))
    c := kit.command("lldb")
    c.args([_]string("--batch", "--no-lldbinit", "-o", "breakpoint set --file views.gm --line 33", "-o", "run"))
    for e in ("F.dir", "F.rect.tag", "F.rect.Rect.h", "F.slice.ptr[1]", "F.first.next->value", "F.pair._1") {
        c.args([_]string("-o", str.format("expression -- {}", e)!))
    }
    c.arg(b.exe)
    out := try t.run(c)
    if not str.contains(out.out, "stop reason = breakpoint") {
        return !t.skip("lldb cannot run the program here:\n{}", out.out)
    }
    for e in ("Dir_S", "Shape_Rect", "= 3\n", "= 20\n", "= 2\n", "= true\n") {
        try t.check(str.contains(out.out, e), "lldb did not print `{}`:\n{}", str.trim_end(e), out.out)
    }
    return ()
}

lldb_shows_gamma_values :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    try need_lldb(t)
    b := try build_program(t, "views-lldb-formatters", "views", VIEWS, [_]string("-g"))
    formatters := kit.join(b.dir, "gamma_lldb.py")
    try t.check(fs.exists(formatters), "no gamma_lldb.py next to the executable")
    // Without `-g` there are no views, so no formatters.
    plain := try build_program(t, "views-lldb-plain", "views", VIEWS, empty_slice(string))
    try t.check(not fs.exists(kit.join(plain.dir, "gamma_lldb.py")), "a build without -g has lldb formatters")
    c := kit.command("lldb")
    c.args([_]string("--batch", "--no-lldbinit", "-o", str.format("command script import {}", formatters)!))
    c.args([_]string("-o", "breakpoint set --file views.gm --line 33", "-o", "run"))
    shown :: [_]string("F.rect", "F.circle", "F.dir", "F.slice", "F.word", "F.some", "F.none", "F.ok", "F.bad", "*F.first.next")
    for e in shown {
        c.args([_]string("-o", str.format("frame variable {}", e)!))
    }
    c.arg(b.exe)
    out := try t.run(c)
    if not str.contains(out.out, "stop reason = breakpoint") {
        return !t.skip("lldb cannot run the program here:\n{}", out.out)
    }
    expected :: [_]string(
        "F.rect = Shape_Rect {",
        "w = 2",
        "h = 3",
        "F.circle = Shape_Circle(1.5)",
        "F.dir = Dir_S\n",
        "F.slice = length 3 {",
        "[0] = 10",
        "[2] = 30",
        "F.word = \"hello\"",
        "F.some = 5\n",
        "F.none = null\n",
        "F.ok = 8\n",
        "F.bad = !Error_Bad(-1)",
        "tags = \"b\"",
    )
    for e in expected {
        try t.check(str.contains(out.out, e), "lldb did not print `{}`:\n{}", str.trim_end(e), out.out)
    }
    return ()
}
