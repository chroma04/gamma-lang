// Tests of git dependencies: adding and fetching them, version requirements, the lock
// file and the options that enforce it, and what a repository may not do.

kit :: import "../kit"
fs :: import "std/fs"
str :: import "std/str"

SKIP_GIT :: "git is not installed"

add_fetch_and_run_a_git_dependency :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "add_run")
    try w.new_lib("http", 7, "v1.0.0")
    try w.put("app/gamma.toml", "# my app\n[package]\nname = \"app\"\n")
    try w.put("app/main.gm", PRINT_HTTP)
    out := try w.ok("app", [_]string("add", "http", "--git", w.url_of("http")))
    try t.expect_contains("stderr", out.err, "Fetching http")
    try t.expect_contains("stderr", out.err, "Locking http v1.0.0")
    manifest := w.get("app/gamma.toml")
    try t.check(starts_with(manifest, "# my app\n[package]"), "{}", kit.quote(manifest))
    try t.expect_contains("the manifest", manifest, str.format("http = {{ git = \"{}\", version = \"^1.0.0\" }}", w.url_of("http"))!)
    lock := w.get("app/gamma.lock")
    try t.check(starts_with(lock, "# This file is generated by `gamma`. Do not edit it by hand.\nversion = 1\n"), "{}", kit.quote(lock))
    try expect_field(t, lock, "http", "reference", "tag=v1.0.0")
    try expect_field(t, lock, "http", "version", "1.0.0")
    try expect_field(t, lock, "http", "rev", try w.git("http", [_]string("rev-parse", "HEAD")))
    checksum := try field(t, lock, "http", "checksum")
    try t.check(starts_with(checksum, "sha256:"), "checksum {}", checksum)
    // Everything that compiles uses the dependency; nothing is fetched again.
    out = try w.ok("app", [_]string("run", "."))
    try t.expect_text("the output", "7\n", out.out)
    try t.check(not str.contains(out.err, "Fetching"), "{}", out.err)
    out = try w.ok("app", [_]string("check", "."))
    try t.expect_text("the stderr of `check`", "", out.err)
    _ = try w.ok("app", [_]string("build", ".", "-o", "app.out"))
    built := try t.run_ok(kit.command(w.at("app/app.out")))
    try t.expect_text("the output of the executable", "7\n", built.out)
    // The lockfile is stable.
    _ = try w.ok("app", [_]string("fetch"))
    try t.expect_text("gamma.lock", lock, w.get("app/gamma.lock"))
    // Diagnostics name the package's module after the dependency, not its directory.
    try w.put("app/main.gm", "http :: import \"http\"\nmain :: fn() needs Out {\n    print(\"{}\\n\", http.nope())\n}\n")
    out = try w.bad("app", [_]string("check", "."))
    try t.expect_contains("stderr", out.err, "the module `http` has no declaration `nope`")
    return ()
}

PRINT_HTTP :: `
http :: import "http"
main :: fn() needs Out {
    print("{}\n", http.value())
}
`

packages_are_found_from_a_subdirectory_and_by_file :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "subdir_root")
    try w.new_lib("http", 3, "v1.0.0")
    try w.sum_app(str.format("http = {{ git = \"{}\", tag = \"v1.0.0\" }}\n", w.url_of("http"))!, [_]string("http"))
    _ = try w.ok("app", [_]string("fetch"))
    out := try w.ok(".", [_]string("fetch", "app"))
    try t.expect_text("stderr", "", out.err)
    out = try w.ok(".", [_]string("fetch", "--dir", "app"))
    try t.expect_text("stderr", "", out.err)
    try w.fails_with(".", [_]string("fetch", "app", "--dir", "app"), "more than one directory given")
    try w.mkdir("app/sub")
    _ = try w.ok("app/sub", [_]string("fetch"))
    try w.fails_with("cache", [_]string("fetch"), "no gamma.toml found")
    return ()
}

version_requirements_and_update :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "versions")
    try w.new_lib("util", 1, "v1.0.0")
    try w.bump("util", 2, "v1.2.0")
    try w.bump("util", 3, "v2.0.0")
    try w.git_run("util", [_]string("tag", "nightly"))
    try w.sum_app(str.format("util = {{ git = \"{}\", version = \"1\" }}\n", w.url_of("util"))!, [_]string("util"))
    _ = try w.ok("app", [_]string("fetch"))
    lock := w.get("app/gamma.lock")
    try expect_field(t, lock, "util", "version", "1.2.0")
    try w.prints("app", [_]string("run", "."), "2\n")

    // A new compatible release does not change the lock...
    try w.bump("util", 4, "v1.3.0")
    out := try w.ok("app", [_]string("run", "."))
    try t.expect_text("the output", "2\n", out.out)
    try t.expect_text("gamma.lock", lock, w.get("app/gamma.lock"))
    try t.check(not str.contains(out.err, "Fetching"), "{}", out.err)
    _ = try w.ok("app", [_]string("fetch"))
    try t.expect_text("gamma.lock", lock, w.get("app/gamma.lock"))

    // ...until `update`.
    out = try w.ok("app", [_]string("update"))
    try t.expect_contains("stderr", out.err, "Updating util v1.2.0 -> v1.3.0")
    try expect_field(t, w.get("app/gamma.lock"), "util", "version", "1.3.0")
    try w.prints("app", [_]string("run", "."), "4\n")

    // Updating by name, and a name that is not a dependency.
    try w.bump("util", 5, "v1.4.0")
    out = try w.ok("app", [_]string("update", "util"))
    try t.expect_contains("stderr", out.err, "v1.3.0 -> v1.4.0")
    try w.fails_with("app", [_]string("update", "nope"), "`nope` is not a git dependency")

    // Changing the requirement re-resolves just that package.
    manifest := str.replace_alloc(w.get("app/gamma.toml"), "version = \"1\"", "version = \"2\"")!
    try w.put("app/gamma.toml", manifest)
    try w.prints("app", [_]string("run", "."), "3\n")
    try expect_field(t, w.get("app/gamma.lock"), "util", "version", "2.0.0")
    // No tag matches.
    manifest = str.replace_alloc(manifest, "version = \"2\"", "version = \"3\"")!
    try w.put("app/gamma.toml", manifest)
    try w.fails_with("app", [_]string("run", "."), "no version tag")
    return ()
}

/// A way to name a revision of the repository `lib` in a dependency, the value of
/// `reference` in the lock it gives, and the output of the program.
Ref :: struct {
    dep: string
    reference: string
    /// Whether `reference` is only the beginning of the value in the lock.
    prefix: bool = false
    output: string
}

tags_branches_revs_and_the_default_branch :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "refs")
    try w.new_lib("lib", 1, "v1.0.0")
    first := try w.git("lib", [_]string("rev-parse", "HEAD"))
    try w.bump("lib", 2, "v1.1.0")
    try w.git_run("lib", [_]string("checkout", "-q", "-b", "dev"))
    try w.put("lib/lib.gm", lib_source(10))
    try w.commit("lib", "dev work", null)
    try w.git_run("lib", [_]string("checkout", "-q", "main"))
    url := w.url_of("lib")
    refs := [_]Ref(
        Ref(dep: "tag = \"v1.0.0\"", reference: "tag=v1.0.0", output: "1"),
        Ref(dep: "branch = \"dev\"", reference: "branch=dev", output: "10"),
        Ref(dep: str.format("rev = \"{}\"", first[0..10])!, reference: "rev=", prefix: true, output: "1"),
        Ref(dep: "", reference: "default", output: "2"),
        Ref(dep: "version = \"~1.0\"", reference: "tag=v1.0.0", output: "1"),
    )
    for r in refs {
        comma := if r.dep.len is 0 { "" } else { ", " }
        try w.sum_app(str.format("lib = {{ git = \"{}\"{}{} }}\n", url, comma, r.dep)!, [_]string("lib"))
        w.rm("app/gamma.lock")
        out := try w.ok("app", [_]string("run", "."))
        try t.expect_text(str.format("the output for {}", kit.quote(r.dep))!, r.output, str.trim(out.out))
        reference := try field(t, w.get("app/gamma.lock"), "lib", "reference")
        if r.prefix {
            try t.check(starts_with(reference, r.reference), "reference {}", reference)
        } else {
            try t.expect_text(str.format("the reference for {}", kit.quote(r.dep))!, r.reference, reference)
        }
    }
    // A branch stays where the lock put it until `update`.
    try w.sum_app(str.format("lib = {{ git = \"{}\", branch = \"dev\" }}\n", url)!, [_]string("lib"))
    w.rm("app/gamma.lock")
    try w.prints("app", [_]string("run", "."), "10\n")
    try w.git_run("lib", [_]string("checkout", "-q", "dev"))
    try w.put("lib/lib.gm", lib_source(11))
    try w.commit("lib", "more dev work", null)
    try w.prints("app", [_]string("run", "."), "10\n")
    _ = try w.ok("app", [_]string("update"))
    try w.prints("app", [_]string("run", "."), "11\n")
    return ()
}

the_lockfile_is_checked_with_locked :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "locked")
    try w.new_lib("a", 1, "v1.0.0")
    try w.new_lib("b", 2, "v1.0.0")
    try w.sum_app(str.format("a = {{ git = \"{}\", version = \"1\" }}\n", w.url_of("a"))!, [_]string("a"))
    out := try w.bad("app", [_]string("fetch", "--locked"))
    try t.expect_contains("stderr", out.err, "gamma.lock is missing")
    try t.check(not str.contains(out.err, "Fetching"), "{}", out.err)
    try t.check(not w.has("app/gamma.lock"), "gamma.lock was written")
    _ = try w.ok("app", [_]string("fetch"))
    _ = try w.ok("app", [_]string("fetch", "--locked"))
    _ = try w.ok("app", [_]string("run", "--locked", "."))
    // A manifest the lock does not cover.
    b_dep := str.format("b = {{ git = \"{}\" }}\n", w.url_of("b"))!
    manifest := str.format("{}{}", w.get("app/gamma.toml"), b_dep)!
    try w.put("app/gamma.toml", manifest)
    before := w.get("app/gamma.lock")
    try w.fails_with("app", [_]string("check", "--locked", "."), "--locked")
    try t.expect_text("gamma.lock", before, w.get("app/gamma.lock"))
    // A lock with a package the manifest no longer wants would change.
    out = try w.ok("app", [_]string("check", "."))
    try t.expect_contains("stderr", out.err, "Locking b")
    try w.put("app/gamma.toml", str.replace_alloc(manifest, b_dep, "")!)
    try w.fails_with("app", [_]string("check", "--locked", "."), "needs to be updated")
    return ()
}

offline_uses_only_what_is_locked_and_fetched :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "offline")
    try w.new_lib("a", 5, "v1.0.0")
    try w.sum_app(str.format("a = {{ git = \"{}\", version = \"1\" }}\n", w.url_of("a"))!, [_]string("a"))
    try w.fails_with("app", [_]string("run", "--offline", "."), "--offline")
    try t.check(not w.has("cache/git"), "something was fetched")
    _ = try w.ok("app", [_]string("fetch"))
    try w.prints("app", [_]string("run", "--offline", "."), "5\n")
    // With the repository gone, a fetched package still builds offline...
    from := w.at("a")
    to := w.at("a-moved")
    Fs.rename(from, to) else e => return !t.fail("cannot move {}: {}", from, e)
    out := try w.ok("app", [_]string("test", "--offline", "."))
    try t.expect_text("the output of `test`", "0 passed, 0 failed", str.trim(out.out))
    // ...and an empty cache needs the network.
    try force_remove(t, w.cache_dir())
    try w.fails_with("app", [_]string("run", "--offline", "."), "not in the cache")
    // Online, the missing repository is reported by git.
    try w.fails_with("app", [_]string("run", "."), "cannot fetch")
    return ()
}

transitive_dependencies_are_locked_in_the_root :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "transitive")
    try w.new_lib("util", 40, "v0.3.0")
    http_manifest := str.format(
        "[package]\nname = \"http\"\n\n[dependencies]\nutil = {{ git = \"{}\", version = \"0.3\" }}\ncommon = {{ path = \"common\" }}\n",
        w.url_of("util"),
    )!
    try w.new_repo(
        "http",
        [_]Item(
            Item(name: "gamma.toml", text: http_manifest),
            Item(
                name: "lib.gm",
                text: "util :: import \"util\"\ncommon :: import \"common\"\npub value :: fn() -> i32 => util.value() + common.one() + 1\n",
            ),
            Item(name: "common/gamma.toml", text: "[package]\nname = \"common\"\n"),
            Item(name: "common/x.gm", text: "pub one :: fn() -> i32 => 1\n"),
        ),
        "v1.0.0",
    )
    try w.sum_app(str.format("http = {{ git = \"{}\", version = \"1\" }}\n", w.url_of("http"))!, [_]string("http"))
    out := try w.ok("app", [_]string("run", "."))
    try t.expect_text("the output", "42\n", out.out)
    try t.expect_contains("stderr", out.err, "Fetching util")
    lock := w.get("app/gamma.lock")
    try expect_field(t, lock, "util", "version", "0.3.0")
    try expect_field(t, lock, "http", "dependencies", "[\"util\"]")
    // The transitive package comes from the lock, offline too.
    try w.prints("app", [_]string("run", "--offline", "--locked", "."), "42\n")
    return ()
}

/// A repository `name` with a library that uses `util` with the requirement `req`.
util_user :: fn(w: ^const World, name, req: string) -> kit.Fail!() needs kit.Run {
    manifest := str.format(
        "[package]\nname = \"{}\"\n[dependencies]\nutil = {{ git = \"{}\", version = \"{}\" }}\n",
        name,
        w.url_of("util"),
        req,
    )!
    return w.new_repo(
        name,
        [_]Item(
            Item(name: "gamma.toml", text: manifest),
            Item(name: "lib.gm", text: "util :: import \"util\"\npub value :: fn() -> i32 => util.value()\n"),
        ),
        "v1.0.0",
    )
}

two_requirements_on_one_repository_share_a_revision :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "shared")
    try w.new_lib("util", 1, "v1.0.0")
    try w.bump("util", 2, "v1.4.0")
    try w.bump("util", 3, "v2.0.0")
    try w.util_user("a", "^1.0")
    try w.util_user("b", ">=1.2, <2")
    deps := str.format("a = {{ git = \"{}\" }}\nb = {{ git = \"{}\" }}\n", w.url_of("a"), w.url_of("b"))!
    try w.sum_app(deps, [_]string("a", "b"))
    try w.prints("app", [_]string("run", "."), "4\n")
    lock := w.get("app/gamma.lock")
    try t.check(packages_in(lock) is 3, "{} packages in gamma.lock", packages_in(lock))
    try expect_field(t, lock, "util", "version", "1.4.0")

    // Requirements that cannot meet fail, naming both requirers.
    try w.git_run("b", [_]string("checkout", "-q", "-b", "next"))
    try w.put(
        "b/gamma.toml",
        str.format("[package]\nname = \"b\"\n[dependencies]\nutil = {{ git = \"{}\", version = \"2\" }}\n", w.url_of("util"))!,
    )
    try w.commit("b", "need util 2", "v2.0.0")
    try w.git_run("b", [_]string("checkout", "-q", "main"))
    w.rm("app/gamma.lock")
    try w.sum_app(
        str.format("a = {{ git = \"{}\" }}\nb = {{ git = \"{}\", tag = \"v2.0.0\" }}\n", w.url_of("a"), w.url_of("b"))!,
        [_]string("a", "b"),
    )
    out := try w.bad("app", [_]string("run", "."))
    try t.expect_contains("stderr", out.err, "no version tag")
    try t.expect_contains("stderr", out.err, "`a` requires version `^1.0`")
    try t.expect_contains("stderr", out.err, "`b` requires version `^2`")
    try t.check(not w.has("app/gamma.lock"), "gamma.lock was written")
    return ()
}

// Names one repository two ways with a symbolic link, which creating on Windows needs a privilege.
different_refs_of_one_repository_conflict :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "conflict")
    try w.new_lib("util", 1, "v1.0.0")
    try w.bump("util", 2, "v1.1.0")
    try w.symlink(w.at("util"), "util.git")
    manifest := str.format("[package]\nname = \"a\"\n[dependencies]\nutil = {{ git = \"{}.git\", tag = \"v1.0.0\" }}\n", w.url_of("util"))!
    try w.new_repo(
        "a",
        [_]Item(
            Item(name: "gamma.toml", text: manifest),
            Item(name: "lib.gm", text: "util :: import \"util\"\npub value :: fn() -> i32 => util.value()\n"),
        ),
        "v1.0.0",
    )
    // `.git` and a trailing slash name the same repository.
    deps := str.format("a = {{ git = \"{}\" }}\nutil = {{ git = \"{}/\", tag = \"v1.1.0\" }}\n", w.url_of("a"), w.url_of("util"))!
    try w.sum_app(deps, [_]string("a", "util"))
    out := try w.bad("app", [_]string("check", "."))
    try t.expect_contains("stderr", out.err, "conflicting requirements")
    try t.expect_contains("stderr", out.err, "`a` requires tag `v1.0.0`")
    try t.expect_contains("stderr", out.err, "`app` requires tag `v1.1.0`")
    return ()
}

/// A repository `name` of a library that depends on the repository `other`, without a tag.
cycle_member :: fn(w: ^const World, name, other: string) -> kit.Fail!() needs kit.Run {
    manifest := str.format("[package]\nname = \"{}\"\n[dependencies]\n{} = {{ git = \"{}\" }}\n", name, other, w.url_of(other))!
    return w.new_repo(
        name,
        [_]Item(Item(name: "gamma.toml", text: manifest), Item(name: "lib.gm", text: "pub value :: fn() -> i32 => 1\n")),
        null,
    )
}

dependency_cycles_are_errors :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "cycle")
    try w.cycle_member("a", "b")
    try w.cycle_member("b", "a")
    try w.sum_app(str.format("a = {{ git = \"{}\" }}\n", w.url_of("a"))!, [_]string("a"))
    try w.fails_with("app", [_]string("check", "."), "dependency cycle: a -> b -> a")
    return ()
}

a_git_package_cannot_reach_outside_its_checkout :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "escape")
    try w.new_repo(
        "evil",
        [_]Item(
            Item(name: "gamma.toml", text: "[package]\nname = \"evil\"\n[dependencies]\nsecret = { path = \"../../../..\" }\n"),
            Item(name: "lib.gm", text: "pub value :: fn() -> i32 => 1\n"),
        ),
        null,
    )
    try w.sum_app(str.format("evil = {{ git = \"{}\" }}\n", w.url_of("evil"))!, [_]string("evil"))
    try w.fails_with("app", [_]string("check", "."), "leaves the repository")
    return ()
}

a_package_in_a_subdirectory :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "subdirs")
    try w.new_repo(
        "mono",
        [_]Item(
            Item(name: "README", text: "a monorepo\n"),
            Item(name: "one/gamma.toml", text: "[package]\nname = \"one\"\n[dependencies]\ntwo = { path = \"../two\" }\n"),
            Item(name: "one/lib.gm", text: "two :: import \"two\"\npub value :: fn() -> i32 => two.value() + 1\n"),
            Item(name: "two/gamma.toml", text: "[package]\nname = \"two\"\n"),
            Item(name: "two/lib.gm", text: "pub value :: fn() -> i32 => 20\n"),
        ),
        "v0.1.0",
    )
    try w.sum_app(str.format("one = {{ git = \"{}\", subdir = \"one\", tag = \"v0.1.0\" }}\n", w.url_of("mono"))!, [_]string("one"))
    try w.prints("app", [_]string("run", "."), "21\n")
    try expect_field(t, w.get("app/gamma.lock"), "one", "subdir", "one")
    // A subdirectory without a package is reported.
    try w.sum_app(str.format("one = {{ git = \"{}\", subdir = \"zero\" }}\n", w.url_of("mono"))!, [_]string("one"))
    try w.fails_with("app", [_]string("check", "."), "no directory `zero`")
    return ()
}

a_changed_checkout_fails_its_checksum :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "checksum")
    try w.new_lib("a", 1, "v1.0.0")
    try w.sum_app(str.format("a = {{ git = \"{}\", version = \"1\" }}\n", w.url_of("a"))!, [_]string("a"))
    _ = try w.ok("app", [_]string("fetch"))
    lock := w.get("app/gamma.lock")
    sum := try field(t, lock, "a", "checksum")

    // A moved tag does not change what the lock names: the same revision comes out.
    try w.put("a/lib.gm", lib_source(99))
    try w.git_run("a", [_]string("add", "-A"))
    try w.git_run("a", [_]string("commit", "-q", "-m", "oops"))
    try w.git_run("a", [_]string("tag", "-f", "v1.0.0"))
    try force_remove(t, w.at("cache/git/checkouts"))
    try w.prints("app", [_]string("run", "."), "1\n")
    try t.expect_text("gamma.lock", lock, w.get("app/gamma.lock"))

    // A lock whose checksum differs from the content is refused.
    try force_remove(t, w.at("cache/git/checkouts"))
    try w.put("app/gamma.lock", str.replace_alloc(lock, sum, str.format("sha256:{}", zeros())!)!)
    out := try w.bad("app", [_]string("run", "."))
    try t.expect_contains("stderr", out.err, "checksum mismatch for package a (expected sha256:000")
    try t.expect_contains("stderr", out.err, str.format("found {}", sum)!)
    try t.check(w.entries_below("cache/git/checkouts") is 0, "the bad checkout is not removed")
    // Restoring the lock fixes it.
    try w.put("app/gamma.lock", lock)
    try w.prints("app", [_]string("run", "."), "1\n")

    // The tag is the only way to a revision: with a fresh cache and the locked
    // revision gone from the repository, the error says so.
    try w.git_run("a", [_]string("checkout", "-q", "--orphan", "fresh"))
    try w.git_run("a", [_]string("commit", "-q", "-m", "fresh start", "--allow-empty"))
    try w.git_run("a", [_]string("branch", "-q", "-D", "main"))
    try w.git_run("a", [_]string("tag", "-f", "v1.0.0"))
    try w.git_run("a", [_]string("reflog", "expire", "--expire=now", "--all"))
    try w.git_run("a", [_]string("gc", "-q", "--prune=now"))
    try force_remove(t, w.cache_dir())
    try w.fails_with("app", [_]string("run", "."), "no longer available")
    return ()
}

remove_drops_the_dependency_and_its_lock_entry :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "remove")
    try w.new_lib("a", 1, "v1.0.0")
    try w.new_lib("b", 2, "v1.0.0")
    try w.put(
        "app/gamma.toml",
        str.format("[package]\nname = \"app\"\n\n[dependencies]\n# the a library\na = {{ git = \"{}\" }}\n", w.url_of("a"))!,
    )
    _ = try w.ok("app", [_]string("add", "b", "--git", w.url_of("b"), "--tag", "v1.0.0"))
    manifest := w.get("app/gamma.toml")
    try t.expect_contains("the manifest", manifest, "# the a library")
    try t.expect_contains("the manifest", manifest, str.format("b = {{ git = \"{}\", tag = \"v1.0.0\" }}", w.url_of("b"))!)
    try t.check(packages_in(w.get("app/gamma.lock")) is 2, "{}", w.get("app/gamma.lock"))
    // Adding an existing name is refused and changes nothing.
    try w.fails_with("app", [_]string("add", "b", "--git", w.url_of("b")), "already exists")
    try t.expect_text("the manifest", manifest, w.get("app/gamma.toml"))
    // A failing add leaves the manifest as it was.
    try w.fails_with("app", [_]string("add", "c", "--git", w.url_of("a"), "--tag", "nope"), "no tag `nope`")
    try t.expect_text("the manifest", manifest, w.get("app/gamma.toml"))

    _ = try w.ok("app", [_]string("remove", "b"))
    try t.expect_contains("the manifest", w.get("app/gamma.toml"), "# the a library")
    try t.check(not str.contains(w.get("app/gamma.toml"), "b ="), "{}", w.get("app/gamma.toml"))
    try t.check(packages_in(w.get("app/gamma.lock")) is 1, "{}", w.get("app/gamma.lock"))
    try w.fails_with("app", [_]string("remove", "b"), "no dependency `b`")
    _ = try w.ok("app", [_]string("remove", "a"))
    try t.check(not w.has("app/gamma.lock"), "no git dependencies, no lockfile")
    return ()
}

add_chooses_a_version_or_the_default_branch_and_accepts_paths :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "add_kinds")
    try w.new_lib("tagged", 1, "v0.2.0")
    try w.bump("tagged", 2, "v0.10.1")
    try w.bump("tagged", 3, "v1.0.0-rc.1")
    try w.new_lib("untagged", 3, null)
    try w.new_lib("local", 4, null)
    try w.put("app/gamma.toml", "[package]\nname = \"app\"\n")
    try w.put("app/main.gm", "main :: fn() needs Out {}\n")
    _ = try w.ok("app", [_]string("add", "tagged", "--git", w.url_of("tagged")))
    _ = try w.ok("app", [_]string("add", "untagged", "--git", w.url_of("untagged")))
    _ = try w.ok("app", [_]string("add", "local", "--path", "../local"))
    _ = try w.ok("app", [_]string("add", "ranged", "--git", w.url_of("tagged"), "--version", "0.10"))
    manifest := w.get("app/gamma.toml")
    try t.expect_contains("the manifest", manifest, str.format("tagged = {{ git = \"{}\", version = \"^0.10.1\" }}", w.url_of("tagged"))!)
    try t.expect_contains("the manifest", manifest, str.format("untagged = {{ git = \"{}\" }}", w.url_of("untagged"))!)
    try t.expect_contains("the manifest", manifest, "local = { path = \"../local\" }")
    lock := w.get("app/gamma.lock")
    try expect_field(t, lock, "untagged", "reference", "default")
    try expect_field(t, lock, "tagged", "version", "0.10.1")
    try t.check(packages_in(lock) is 2, "one repository is one entry: {}", lock)
    // Option errors.
    try w.fails_with("app", [_]string("add", "x"), "needs `--path")
    out := try w.gamma("app", [_]string("add", "x", "--git", "u", "--tag", "t", "--branch", "b"))
    try t.expect_contains("stderr", out.err, "only one")
    out = try w.gamma("app", [_]string("add", "bad-name", "--path", "."))
    try t.expect_contains("stderr", out.err, "invalid dependency name")
    out = try w.gamma("app", [_]string("add", "x", "--bogus"))
    try t.expect_contains("stderr", out.err, "unknown option")
    return ()
}

a_hand_edited_lock_is_noticed :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "edited_lock")
    try w.new_lib("a", 1, "v1.2.3")
    try w.sum_app(str.format("a = {{ git = \"{}\", version = \"1\" }}\n", w.url_of("a"))!, [_]string("a"))
    _ = try w.ok("app", [_]string("fetch"))
    lock := w.get("app/gamma.lock")
    try expect_field(t, lock, "a", "version", "1.2.3")
    sum := try field(t, lock, "a", "checksum")

    // An edited version: --locked refuses, a plain run repairs it.
    try w.put("app/gamma.lock", str.replace_alloc(lock, "version = \"1.2.3\"", "version = \"9.9.9\"")!)
    try w.fails_with("app", [_]string("run", "--locked", "."), "needs to be updated")
    try w.prints("app", [_]string("run", "."), "1\n")
    try t.expect_text("gamma.lock", lock, w.get("app/gamma.lock"))

    // A removed version is restored the same way.
    try w.put("app/gamma.lock", str.replace_alloc(lock, "version = \"1.2.3\"\n", "")!)
    _ = try w.bad("app", [_]string("run", "--locked", "."))
    _ = try w.ok("app", [_]string("run", "."))
    try t.expect_text("gamma.lock", lock, w.get("app/gamma.lock"))

    // An edited checksum is caught against the checkout already in the cache.
    bad := str.replace_alloc(lock, sum, str.format("sha256:{}", zeros())!)!
    try w.put("app/gamma.lock", bad)
    out := try w.bad("app", [_]string("run", "--locked", "."))
    try t.expect_contains("stderr", out.err, "checksum mismatch for package a")
    try t.expect_text("gamma.lock", bad, w.get("app/gamma.lock"))
    try w.put("app/gamma.lock", bad)
    out = try w.bad("app", [_]string("run", "."))
    try t.expect_contains("stderr", out.err, "checksum mismatch for package a")
    try t.expect_text("gamma.lock", bad, w.get("app/gamma.lock"))
    try w.put("app/gamma.lock", lock)
    _ = try w.ok("app", [_]string("run", "--locked", "."))

    // A damaged revision is an error, not a crash or a path outside the store.
    rev := try field(t, lock, "a", "rev")
    for bad_rev in ("aéééééééééééé", "../../../../../../..") {
        try w.put("app/gamma.lock", str.replace_alloc(lock, rev, bad_rev)!)
        try w.fails_with("app", [_]string("run", "."), "`rev` must be a full commit id")
    }
    try w.put("app/gamma.lock", lock)
    return ()
}

a_git_url_cannot_be_an_option :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    w := try world(t, "dash_url")
    try w.sum_app("evil = { git = \"--upload-pack=touch PWNED\" }\n", empty_slice(string))
    try w.fails_with("app", [_]string("fetch"), "starts with `-`")
    try w.fails_with("app", [_]string("add", "evil", "--git=--upload-pack=x"), "starts with `-`")
    try t.check(not w.has("app/PWNED") and not w.has("PWNED"), "the URL was run as an option")
    return ()
}

an_empty_lock_is_a_missing_lock :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "empty_lock")
    try w.new_lib("a", 1, "v1.0.0")
    try w.sum_app(str.format("a = {{ git = \"{}\", version = \"1\" }}\n", w.url_of("a"))!, [_]string("a"))
    _ = try w.ok("app", [_]string("fetch"))
    lock := w.get("app/gamma.lock")
    try w.put("app/gamma.lock", " \n")
    try w.fails_with("app", [_]string("run", "--locked", "."), "gamma.lock is missing")
    try w.put("app/gamma.lock", "")
    try w.prints("app", [_]string("run", "."), "1\n")
    try t.expect_text("gamma.lock", lock, w.get("app/gamma.lock"))
    return ()
}

path_dependencies_are_found_when_the_input_is_a_file :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    w := try world(t, "paths_by_file")
    try w.put("json/gamma.toml", "[package]\nname = \"json\"\n")
    try w.put("json/lib.gm", lib_source(9))
    try w.sum_app("json = { path = \"../json\" }\n", [_]string("json"))
    // `main.gm` alone has no directory part; `../json` is still relative to the app.
    try w.prints("app", [_]string("run", "main.gm"), "9\n")
    try w.prints(".", [_]string("run", "app/main.gm"), "9\n")
    return ()
}

the_tests_of_a_dependency_run_with_package :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    if not kit.runs("git") { return !t.skip(SKIP_GIT) }
    w := try world(t, "dep_tests")
    try w.new_lib("util", 40, "v0.3.0")
    http_manifest := str.format(
        "[package]\nname = \"http\"\n\n[dependencies]\nutil = {{ git = \"{}\", version = \"0.3\" }}\n",
        w.url_of("util"),
    )!
    try w.new_repo(
        "http",
        [_]Item(
            Item(name: "gamma.toml", text: http_manifest),
            Item(
                name: "lib.gm",
                text: "util :: import \"util\"\npub value :: fn() -> i32 => util.value() + 2\ntest \"adds two\" { expect_eq(value(), 42) }\n",
            ),
            Item(name: "parse/parse.gm", text: "test \"nothing imports this\" {}\n"),
        ),
        "v1.0.0",
    )
    try w.put("json/gamma.toml", "[package]\nname = \"json\"\n")
    try w.put("json/lib.gm", "pub value :: fn() -> i32 => 1\ntest \"json one\" { expect_eq(value(), 1) }\n")
    deps := str.format("http = {{ git = \"{}\", version = \"1\" }}\njson = {{ path = \"../json\" }}\n", w.url_of("http"))!
    try w.sum_app(deps, [_]string("http", "json"))
    // The fetched library's own git dependency resolves through the app's lock.
    out := try w.ok("app", [_]string("test", "--package=http", "."))
    try t.expect_contains("the output", out.out, "test \"adds two\" ... ok")
    try t.check(not str.contains(out.out, "nothing imports this"), "{}", out.out)
    out = try w.ok("app", [_]string("test", "--package=http", "--all", "."))
    try t.expect_contains("the output", out.out, "nothing imports this")
    // A path dependency, and a dependency of a dependency.
    out = try w.ok("app", [_]string("test", "--package=json", "main.gm"))
    try t.expect_contains("the output", out.out, "json one")
    out = try w.ok("app", [_]string("test", "--package=util", "."))
    try t.expect_contains("the output", out.out, "0 passed")
    try w.fails_with("app", [_]string("test", "--package=nope", "."), "no dependency `nope`; its dependencies are `http`, `json`")
    try w.fails_with("cache", [_]string("test", "--package=http", "."), "`--package` needs the input to be in a package")
    return ()
}
