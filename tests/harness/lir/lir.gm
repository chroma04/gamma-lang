//! Tests of LIR, the lowered form of function bodies (`gamma lir`).
//!
//! - `tests/lir/<name>.gm` is lowered with `gamma lir` (run in `tests/lir/`, so the dump
//!   names files without a directory) and the output must equal `tests/lir/<name>.lir`.
//!   `BLESS=1` rewrites those files from the output.
//! - Every program of `tests/conformance/run/` and `examples/` is lowered too: the compiler
//!   must not fail, and the LIR verifier must find nothing wrong (no line starting `!`).
//!   A program the checker rejects (a test of a compile error) is skipped. Each program is a
//!   test, named `lowers/<path>`.
//! - Every single-file program of `tests/conformance/run/` (but the `native:` and Safe
//!   ones, those for another architecture or system, and those with foreign code or
//!   assembly, which the interpreter hands to the C back end) runs in the interpreter twice, compiled from LIR where that covers a function
//!   (the default) and only from the lowered tree (`GAMMA_INTERP_LIR=0`), and the two runs
//!   must print the same and exit alike (`interp/<name>`).

fs :: import "std/fs"
kit :: import "../kit"
path :: import "std/path"
str :: import "std/str"

GOLDEN_DIR :: "tests/lir"

pub tests :: fn(cfg: ^const kit.Config, out: ^List(kit.Test)) needs Alloc + Fs {
    golden := list(string)
    for r in fs.entries(kit.join(cfg.root, GOLDEN_DIR)) {
        e := r else break
        if path.extension(e.name) is "gm" { golden.push(str.format("{}", e.name)!)! }
    }
    golden.items.sort()
    for name in golden.items { out.push(kit.Test(name: str.format("golden/{}", name)!, run: golden_one, param: name))! }
    runs := list(string)
    for r in fs.entries(kit.join(cfg.root, "tests/conformance/run")) {
        e := r else break
        if e.kind is not .Dir and path.extension(e.name) is "gm" { runs.push(str.format("{}", e.name)!)! }
    }
    runs.items.sort()
    for name in runs.items { out.push(kit.Test(name: str.format("interp/{}", name)!, run: interp_one, param: name))! }
    programs := list(string)
    programs_in(kit.join(cfg.root, "tests/conformance/run"), &programs)
    programs_in(kit.join(cfg.root, "examples"), &programs)
    programs.items.sort()
    for p in programs.items {
        rel := path.relative_to(p, cfg.root) else p
        out.push(kit.Test(name: str.format("lowers/{}", rel)!, run: lowers_one, param: rel))!
    }
}

/// The programs below `dir`: its `.gm` files, and the `main.gm` of each directory in it.
programs_in :: fn(dir: string, out: ^List(string)) needs Alloc + Fs {
    for r in fs.entries(dir) {
        e := r else return
        p := kit.join(dir, e.name)
        if e.kind is .Dir {
            m := kit.join(p, "main.gm")
            if fs.exists(m) { out.push(m)! }
        } else if path.extension(e.name) is "gm" {
            out.push(p)!
        }
    }
}

golden_one :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    dir := t.repo(GOLDEN_DIR)
    c := t.gamma_in(dir, [_]string("lir", t.param))
    out := try t.run(c)
    try t.check(out.success(), "gamma lir {} failed:\n{}", t.param, out.err)
    stem := t.param[0..t.param.len - 3]
    if d := try t.golden("the LIR", kit.join(dir, str.format("{}.lir", stem)!), out.out) { return !t.fail("{}", d) }
    return ()
}

lowers_one :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    c := t.gamma_in(t.cfg.root, [_]string("lir", t.param))
    out := try t.run(c)
    if not out.success() {
        try t.check(not str.contains(out.err, "internal error") and str.contains(out.err, "error"), "gamma lir {} failed:\n{}", t.param, out.err)
        return !t.skip("the checker rejects it")
    }
    faults := list(string)
    for l in kit.split_lines(out.out) {
        if l.starts_with("!") { faults.push(l)! }
    }
    try t.check(faults.items.len is 0, "the verifier found:\n{}", str.join(faults.items, "\n")!)
    return ()
}

/// The value of the expectation `//! key: value` in `text`, if it has one.
marker :: fn(text: string, key: string) -> ?string needs Alloc {
    head := str.format("//! {}:", key)!
    for l in kit.split_lines(text) {
        if l.starts_with(head) { return str.trim(l[head.len..l.len]) }
    }
    return null
}

interp_one :: fn(t: ^kit.T) -> kit.Fail!() needs kit.Run {
    dir := t.repo("tests/conformance/run")
    text := try t.read(kit.join(dir, t.param))
    if marker(text, "native") is not null { return !t.skip("runs natively only") }
    if arch := marker(text, "arch") {
        if arch is not t.cfg.arch { return !t.skip("for {} only", arch) }
    }
    if os := marker(text, "os") {
        if os is not t.cfg.os_kind { return !t.skip("for {} only", os) }
    }
    // The interpreter hands a program with foreign code or assembly to the C back end.
    if str.contains(text, "foreign") or str.contains(text, "@asm") { return !t.skip("runs through the C back end") }
    mode := marker(text, "mode") else "debug"
    if mode is "safe" { return !t.skip("a Safe build test") }
    flag := str.format("--mode={}", mode)!
    tree := t.gamma_in(dir, [_]string("run", "--backend=interp", flag, t.param))
    tree.set("GAMMA_INTERP_LIR", "0")
    a := try t.run(tree)
    lowered := t.gamma_in(dir, [_]string("run", "--backend=interp", flag, t.param))
    lowered.set("GAMMA_INTERP_LIR", "1")
    b := try t.run(lowered)
    try t.expect_text("the standard output", a.out, b.out)
    try t.expect_text("the standard error", a.err, b.err)
    try t.check(a.code() is b.code(), "exit status {} from the tree, {} from LIR", a.code() else 999, b.code() else 999)
    return ()
}
