//! stage: check
// Format specs (§21.6.1) must be well formed and suit their argument's type.
log :: fn(A: type, template :: string, args: ..A) needs Out { print(template, ..args) }

hexes :: fn(T: type, x: T) needs Out { print("{:x}\n", x) }

main :: fn() needs Out {
    print("{:z}\n", 1)                //~ ERROR unknown format spec `{:z}`
    print("{:5x5}\n", 1)              //~ ERROR invalid format spec
    print("{:<05}\n", 1)              //~ ERROR either `0` padding or an alignment
    print("{:#}\n", 1)                //~ ERROR `#` (the base prefix) goes with
    print("{:.2x}\n", 1)              //~ ERROR a precision goes with floats
    print("{:.}\n", 1.0)              //~ ERROR followed by the precision
    print("{:>5\n", 1)                //~ ERROR has no closing `}`
    print("{:99999}\n", 1)            //~ ERROR at most 65536
    print("{:x}\n", 1.5)              //~ ERROR needs an integer, for a base, not `f64`
    print("{:e}\n", 3u8)              //~ ERROR needs a float, for `e`, not `u8`
    print("{:.3}\n", "abc")           //~ ERROR needs a float, for a precision
    print("{:+}\n", true)             //~ ERROR needs a number, for `+` or `0`
    print("{:>5} {:b}\n", 1, "s")   //~ ERROR needs an integer
    log("{:x}\n", 2.5)                //~ ERROR needs an integer, for a base, not `f64` (in an instantiation used here)
    hexes(1.5)                        //~ ERROR (in an instantiation used here)
    hexes(7)
    print("{:>8} {:.1}\n", "fine", 1)
}
