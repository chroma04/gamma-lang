//! stage: check
// Conditional compilation and static assertions (§3.6, §8.9, §17.7).
when false {
    broken :: fn() -> i32 => no_such_name   // untaken: parsed only
}

@static_assert(1 + 1 is 3, "arithmetic")   //~ ERROR static assertion failed: arithmetic

sized :: fn(T: type, x: T) -> usize {
    when @size_of(T) > 4 {                   //~ ERROR may not depend on a generic parameter
        return 1
    }
    return 0
}

where_ :: fn() -> u32 {
    loc := @caller_location()                //~ ERROR only as a parameter's default value
    return loc.line
}

main :: fn() {
    when target.ptr_bits < 16 {
        @compile_error("too small")          // untaken: not checked
    }
    when true {
        @compile_error("unsupported target") //~ ERROR unsupported target
    }
    when 3 {                                 //~ ERROR expected `bool`
    }
}
