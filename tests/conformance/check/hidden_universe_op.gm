//! stage: check
// An effect operation named like a universe operation hides it (§4.6), and errors at
// its calls say so.
Sched :: effect {
    exit: fn()
}

run :: fn() \ {Sched} {
    exit(1)   //~ ERROR too many arguments //~ NOTE hides the universe operation `Env.exit`
}

stop :: fn() \ {Env} {
    exit()   //~ ERROR which the function does not declare //~ NOTE `exit` here is the operation `Sched.exit`
}

main :: fn() {}
