//! stage: check
// A name in the position of an optional inside a pattern matches only a present value
// (§9.3). When that leaves a `match` not exhaustive, the error points at the name and
// says how to get the optional as it is: `?x`.

Expr :: union {
    Break: (label: ?string, value: ?i32)
    Return: ?i32
    Int: i32
}

describe :: fn(e: Expr) -> string => match e { //~ ERROR `.Break((null, null))` is not covered //~ NOTE write `?` before the name
    .Break(label, _) => label
    .Return(_) => "return"
    .Int(_) => "int"
}

// `?x` binds the optional parts as they are.
describe_whole :: fn(e: Expr) -> string => match e {
    .Break(?label, _) => label else "break"
    .Return(null) => "return"
    .Return(x) => if x > 0 { "return a positive value" } else { "return a value" }
    .Int(_) => "int"
}

main :: fn() {
    _ = describe(.Int(1))
    _ = describe_whole(.Int(1))
}
