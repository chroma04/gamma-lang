//! stage: check
// A private field used in code that is checked more than once (loop bodies, function
// literals passed to generic functions, method chains) is reported once per location.
main :: fn() \ {Alloc} {
    l := list(u8)
    n := 0
    while n < 3 {
        for i in 0..3 {
            n += l.cap + i                   //~ ERROR the field `cap` of `List(u8)` is private
        }
    }
    f := fn(x: List(u8)) -> usize => x.cap   //~ ERROR the field `cap` of `List(u8)` is private
    _ = f(l)
    g :: fn(x: List(u8)) -> usize { return x.cap + x.cap }   //~ ERROR the field `cap` of `List(u8)` is private //~ ERROR the field `cap` of `List(u8)` is private
    _ = g(l)
}
