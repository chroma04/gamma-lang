//! stage: check
// `for` over a tuple needs elements of one type, or a join of them (§8.4).
main :: fn() {
    for x in (1, "a") { }          //~ ERROR must have one type
    t := (1u8, -2i8)
    for x in t { }                 //~ ERROR must have one type
    for x in () { }                //~ ERROR `for` iterates over
    for x in (1, 2) { x = 3 }      //~ ERROR cannot assign
    for (a, b) in (1, 2) { }       //~ ERROR a tuple pattern needs
}
