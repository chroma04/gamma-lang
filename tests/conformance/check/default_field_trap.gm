//! stage: check
// A default value is a required compile-time evaluation (§17.2): one that traps is an
// error at the default, even if no construction uses it.
z :: fn(d: u8) -> u8 { return 1 / d }
A :: struct { a: u8 = 1 / 0 } //~ ERROR compile-time evaluation failed: division by zero
B :: struct { a: u8 = z(0) } //~ ERROR compile-time evaluation failed: division by zero
main :: fn() {
    // The failed default does not also make the field "missing".
    _ = B()
}
