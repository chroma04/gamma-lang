//! stage: check
// A `struct` declared in a function body is rejected once; its uses are silent.
main :: fn() needs Alloc {
    P :: struct { x: i32, y: i32 }    //~ ERROR types are declared at top level
    ps: [3]P = ---
    ps[0] = P(x: 1, y: 2)
    ps[1].x = 4
    s: []P = ps[..]
    for p in s { _ = p.x }
    q := P(x: 1, y: 2)
    q.x += 1
    m := match q { P(x: a, y: b) => a + b }
    _ = m
    v := list(P)
    _ = v
    _ = q.sum()
    _ = P.make(3)
    U :: union { a: i32, b: u8 }      //~ ERROR types are declared at top level
    u := U.a(3)
    _ = u
    f :: fn(a: P) -> i32 { return a.x }
    _ = f(q)
    T :: u8
    w := list(T)                      // a valid alias works as a type argument
    _ = w
}
