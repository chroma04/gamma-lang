//! stage: check
// A handler literal is second-class: no tuple element, no address (§11.6).
Log :: effect { log: fn(m: string) }

main :: fn() needs Out {
    h :: handler Log { log(m) => { print("{}\n", m) } }
    t := (1, h) //~ ERROR cannot be a tuple element
    p := &h //~ ERROR cannot be the target of `&`
    with h { log("ok") }
}
