//! stage: check
// Effect-set parameters (§16.6).
Note :: effect { note: fn(x: i32) }

apply :: fn(E: effects, f: ^fn(x: i32) -> i32 needs E, x: i32) -> i32 needs E {
    return f(x)
}

hidden :: fn(E: effects, f: ^fn() needs E) needs E {
    with (handler Note { note(x) => {} }) {
        f()   //~ ERROR which the effect-set parameter might include
    }
}

as_type :: fn(E: effects, x: E) {}   //~ ERROR is an effect set, not a type

one :: fn(E: effects) needs E + Out {}
single :: fn(E: effects) {
    with (handler E { }) {}   //~ ERROR is an effect set, not a single effect
}

noisy :: fn(x: i32) -> i32 needs Note {
    note(x)
    return x
}

quiet :: fn(x: i32) -> i32 => x + 1

caller :: fn() -> i32 needs Note {
    return apply(noisy, 1) + apply(quiet, 2)
}

leaks :: fn() -> i32 {
    return apply(noisy, 1)   //~ ERROR which the function does not declare
}

main :: fn() {}
