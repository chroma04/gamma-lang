//! stage: check
// Static rules of effects and handlers (§12).
Log :: effect { log: fn(msg: string) }
Stop :: effect { stop: esc() -> never }

needs_log :: fn() \ {Log} { log("x") }

handled :: fn() {
    with (handler Log { log(m) => {} }) {
        needs_log()                       // handled here: no effect escapes
    }
}

unhandled :: fn() {
    needs_log()                           //~ ERROR does not declare
}

missing_clause :: fn() {
    h :: handler Stop { }                 //~ ERROR no clause for the operation `stop`
}

extra_clause :: fn() {
    h :: handler Log {
        log(m) => {}
        nope() => {}                      //~ ERROR has no operation `nope`
    }
}

fn_clause_break :: fn() {
    h :: handler Log { log(m) => break }  //~ ERROR can only produce a value
}

two_for_one :: fn() {
    a :: handler Log { log(m) => {} }
    b :: handler Log { log(m) => {} }
    with a, b { }                         //~ ERROR two handlers for `Log`
}

stored :: fn() {
    h := handler Log { log(m) => {} }     //~ ERROR only be bound with `::`
}

not_iter :: fn() \ {Log} {
    for x in needs_log() { }              //~ ERROR not an iterator
}

yields :: fn() \ {Yield(u8)} {
    yield(1)                              // the instantiation is inferred from the effect set
}

main :: fn() {}

// The clauses of a later handler may use an earlier one, not the reverse (§12.7).
Note :: effect { note: fn(msg: string) }
Job :: effect { job: fn(x: u32) -> u32 }
Noter :: struct { n: u32 = 0 }
handler Note for ^Noter { note(self, msg) => { self.n += 1 } }
Runner :: struct { n: u32 = 0 }
handler Job for ^Runner \ {Note} {
    job(self, x) => {
        note("job")
        x + 1
    }
}

order :: fn() -> u32 {
    a := Noter()
    b := Runner()
    x := with &a, &b { job(1) }
    y := with &b, &a { job(2) }         //~ ERROR performs the effect `Note`
    return x + y
}
