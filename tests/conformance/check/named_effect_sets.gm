Io :: \ {Out, Alloc}

f :: fn(E: effects) {
    Bad :: \ {..E}                          //~ ERROR an effect set is not a value
}

g :: fn() \ {..Missing} {}                  //~ ERROR unknown effect set `Missing`

h :: fn() \ {Io} {}                         //~ ERROR splice it into the set as `..Io`

k :: fn() \ {..Io} {
    x := Io                                 //~ ERROR expected a value, found the effect set `Io`
    _ = x
    Clock.sleep(ms(1))                      //~ ERROR which the function does not declare
}

