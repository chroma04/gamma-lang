//! stage: check
// Named effect sets (§12.3).
time :: import "std/time"

Io :: Out + Alloc

f :: fn(E: effects) {
    x := E                            //~ ERROR expected a value, found the effect set `E`
}

g :: fn() needs Missing {}                  //~ ERROR unknown effect `Missing`

h :: fn() needs Io + Clock {}
k2 :: fn() {
    with (handler Io { }) {}                //~ ERROR is an effect set, not a single effect
}

k :: fn() needs Io {
    x := Io                                 //~ ERROR expected a value, found the effect set `Io`
    _ = x
    Clock.sleep(time.ms(1))                      //~ ERROR which the function does not declare
}

main :: fn() {}
