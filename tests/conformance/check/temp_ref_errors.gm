//! stage: check
// `&` of a temporary is allowed only as an argument for a ^const T parameter (§7.2).
Pt :: struct { x, y: i32 }
bump :: fn(p: ^Pt) { p.x += 1 }
mk :: fn() -> Pt => Pt(x: 1, y: 2)
main :: fn() {
    bump(&mk())                 //~ ERROR `&` needs a place
    q: ^const Pt = &mk()        //~ ERROR `&` needs a place
}
