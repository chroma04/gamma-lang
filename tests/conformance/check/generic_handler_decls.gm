//! stage: check
// Rules for handler declarations of generic types (§12.6).
Box :: struct(T: type) { v: T }
Ping :: effect { ping: fn() }

handler(T: type, U: type) Ping for ^Box(T) { //~ ERROR the parameter `U` must appear in the type
    ping(self) => {}
}

handler(T: type) Ping for ^Box(T) {
    ping(self) => {}
}

handler(X: type) Ping for ^Box(X) { //~ ERROR is already declared
    ping(self) => {}
}

// A declaration for one instance overlaps the generic one: a type may match only one.
handler Ping for ^Box(u8) { //~ ERROR is already declared
    ping(self) => { self.v += 1 }
}

Pair :: struct(A: type, B: type) { a: A, b: B }

handler(T: type) Ping for ^Pair(T, u8) {
    ping(self) => {}
}

handler(T: type) Ping for ^Pair(u8, T) { //~ ERROR is already declared
    ping(self) => {}
}

// Another effect, or a type the generic declaration does not match, is fine.
Pong :: effect { pong: fn() }

handler Pong for ^Box(u8) {
    pong(self) => {}
}

handler Ping for ^Pair(u16, u16) {
    ping(self) => {}
}

main :: fn() {}
