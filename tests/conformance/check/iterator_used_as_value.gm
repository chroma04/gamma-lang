//! stage: check
// A call of an iterator is a loop source or an argument for an iterator parameter, not a
// value: the fix is not to declare `Yield`.
Words :: struct { text: string }

fields :: fn(s: string) needs Yield(string) {
    yield(s)
}

pieces :: fn(w: Words) needs Yield(string) {
    yield(w.text)
}

as_value :: fn(s: string) {
    rest := fields(s)    //~ ERROR `fields` is an iterator, not a value: call it as the source of a `for` loop (`for x in fields(…)`) or pass it to a function that runs it, such as `collect(fields(…))`
}

as_other :: fn(w: Words) {
    rest := pieces(w)    //~ ERROR `pieces` is an iterator
}

// A real `yield` in a body keeps the original advice.
bad_body :: fn(s: string) {
    yield(s)    //~ ERROR add `needs Yield(string)`
}

// Iterators are fine as `for` sources and in functions that declare `Yield`.
ok :: fn(s: string) needs Out {
    for x in fields(s) { print("{}\n", x) }
}

forward :: fn(s: string) needs Yield(string) {
    fields(s)
}

main :: fn() {}
