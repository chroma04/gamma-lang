//! stage: check
// The hash map is `std/collections/hash_map` (§21.5); the universe scope no longer holds
// it, and the module binding `map` that the core library uses for it is not a universe name.
hm :: import "std/collections/hash_map"

old :: fn() -> HashMap(string, u32) needs Alloc {    //~ ERROR unknown type `HashMap` //~ NOTE `HashMap` is declared by `std/collections/hash_map`
    return hash_map(string, u32)                      //~ ERROR unknown name `hash_map` //~ NOTE `hash_map` is declared by `std/collections/hash_map`
}

new_style :: fn() -> hm.HashMap(string, u32) needs Alloc => hm.hash_map(string, u32)

hidden :: fn() needs Alloc {
    m := map.hash_map(u32, u32)                       //~ ERROR unknown name `map`
}

own :: fn() -> u32 {
    map := 3                                          // `map` is free for programs
    return map
}

main :: fn() {}
