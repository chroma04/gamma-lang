//! stage: check
// Arithmetic does not apply to arrays, enum-indexed arrays included; vectors and loops do.

Color :: union { Red, Green }

f :: fn(a: [3]i32, b: [3]bool, c: [2]i32, d: [Color]f64) {
    _ = a + a           //~ ERROR arithmetic does not apply to arrays; use a `#simd [N]T` vector
    _ = a +% a          //~ ERROR arithmetic does not apply to arrays
    _ = a * a           //~ ERROR arithmetic does not apply to arrays
    _ = -a              //~ ERROR arithmetic does not apply to arrays
    _ = b + b           //~ ERROR arithmetic does not apply to arrays
    _ = a + c           //~ ERROR have different types: `[3]i32` and `[2]i32`
    _ = d - d           //~ ERROR arithmetic does not apply to arrays
    _ = -d              //~ ERROR arithmetic does not apply to arrays
}

g :: fn(N :: usize, a: [N]f64) -> [N]f64 {
    return a + a        //~ ERROR arithmetic does not apply to arrays
}

main :: fn() {
    x := [2]u8(1, 2)
    x += x              //~ ERROR arithmetic does not apply to arrays
    x -|= x             //~ ERROR arithmetic does not apply to arrays
}
