//! stage: check
// A template given as a compile-time parameter is checked in each instantiation (§16.1).
log :: fn(A: type, template :: string, args: A) \ {Out} { print(template, args) }

main :: fn() \ {Out} {
    log("{} {}\n", 5)                 //~ ERROR the template has 2 placeholders, so the arguments must be a tuple of 2 values
    log("x{\n", 1)                    //~ ERROR invalid template (in an instantiation used here)
    log("{}\n", "fine")
}
