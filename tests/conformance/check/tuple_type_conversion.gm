//! stage: check
// A tuple type takes one value per element: `T(t)` with a tuple `t` is not a
// conversion (§6.5, §7.11).
P :: (i32, i32)
main :: fn() {
    p := (1i32, 2i32)
    a := (i64, i64)(p)  //~ ERROR `(i64, i64)` takes one value per element, so a tuple is not converted to it; spread it
    b := P(p)           //~ ERROR spread it: `(i32, i32)(..t)`
    c := P(5)           //~ ERROR missing element 1 of `(i32, i32)`
}
