//! stage: check
// Constants whose initializers have errors are not evaluated (no internal errors).
A :: [3]x(3) //~ ERROR unknown type `x`
B :: [16]u8(0) //~ ERROR needs exactly 16 elements
C :: [2]u8(1.5, 2) //~ ERROR found a float literal
Instr :: union { Mul: (a: u8, c: u8u8) } //~ ERROR unknown type `u8u8`
D :: [_]Instr(.Mul(3, 3))

log :: fn(template :: string, args: ..Args) { //~ ERROR unknown type `Args`
    print(template) //~ ERROR performs the effect `Out`
    log(93) //~ ERROR found an integer literal
}

main :: fn() {}
