/// A small but realistic program touching most token classes.
import "std/io"

#packed
Point :: struct { x: f32, y: f32 }

fib :: fn(n: u32) -> u64 {
    if n < 2 { return n }
    a, b := 0u64, 1u64
    for i in 0..n {
        a, b = b, a +% b
    }
    a
}

