// `to_unix` of the earliest and latest representable instants.
time :: import "std/time"

main :: fn() \ {Out} {
    lo: i64 = -9223372036854775807 - 1
    print("{}\n", time.to_unix(time.from_unix(lo)) is lo)
    hi: i64 = 9223372036854775807
    print("{}\n", time.to_unix(time.from_unix(hi)) is hi)
    print("{}\n", time.to_unix(time.from_unix(-1)))
}
