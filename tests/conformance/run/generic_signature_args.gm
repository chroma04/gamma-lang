// A constrained generic type in a signature, and a compile-time value parameter
// passed by name that another parameter's type also determines (§16.2, §16.3).
Num2 :: struct(T: type) where Num(T) { a, b: T }
add2 :: fn(T: type, p: Num2(T)) -> T where Num(T) => p.a + p.b
count :: fn(N :: usize, T: type, a: [N]T) -> usize => N
main :: fn() \ {Out} {
    print("{}\n", add2(Num2(f32)(a: 1.5, b: 2)))
    print("{} {} {}\n", count(N: 3, T: i8, [3]i8(1, 2, 3)), count(N: 3, T: i8, a: [3]i8(1, 2, 3)), count(T: i8, N: 3, a: [3]i8(1, 2, 3)))
}
