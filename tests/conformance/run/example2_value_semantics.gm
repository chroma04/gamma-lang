// Value semantics of arrays and structs: tuple swaps, assignment of aggregates, array-of-struct copies, evaluation order of indexed compound assignment.
Big :: struct { a: [4]i32, n: i32 }

make_big :: fn(s: i32) -> Big {
    r := Big(a: [4]i32(fill: s), n: s)
    r.a[1] = s + 1
    return r
}

twist :: fn(b: Big) -> Big {
    r := b
    r.a[0] = b.a[3]
    r.a[3] = b.a[0]
    r.n = b.n * 2
    return r
}

main :: fn() \ {Out} {
    x := [_]i32(1, 2, 3, 4)
    i := 0
    j := 3
    x[i], x[j] = (x[j], x[i])
    print("{}\n", x)
    i, j = (j, i)
    print("{} {}\n", (i, j))
    a := 1
    b := 2
    a, b = (b, a + b)
    print("{} {}\n", (a, b))

    big := make_big(5)
    big = twist(big)
    print("{}\n", big)
    arr := [_]Big(make_big(1), make_big(2))
    arr[0] = arr[1]
    arr[1].a[0] = 99
    print("{}\n", arr)
    y := arr
    y[0].n = -1
    print("{} {}\n", (arr[0].n, y[0].n))
    p := &arr[1]
    p.n = 77
    print("{}\n", arr[1].n)

    m: [3][3]i32 = ---
    for r in 0..3 { for c in 0..3 { m[r][c] = (r * 3 + c).trunc(i32) } }
    t := m
    for r in 0..3 { for c in 0..3 { m[r][c] = t[c][r] } }
    print("{}\n", m)
    k := 0
    idx :: fn(q: ^i32) -> usize {
        q^ += 1
        return q^.trunc(usize)
    }
    v := [_]i32(10, 20, 30, 40)
    v[idx(&k)] += v[idx(&k)]
    print("{} {}\n", (v, k))
}
