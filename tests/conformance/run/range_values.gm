// Ranges are values (§5.16): stored, passed, iterated, used with `in` and to slice.
Span :: struct { name: string, r: Range(usize) }

total :: fn(r: RangeIncl(u32)) -> u32 {
    t: u32 = 0
    for i in r { t += i }
    return t
}

main :: fn() \ {Out} {
    r := 3..8
    n: u8 = 10
    s := 2..=n
    c: Range(i64) = -1..2
    print("{} {} {} {}\n", (r, r.lo, s, c))
    for i in r { print("{} ", i) }
    print("\n")
    print("{}\n", total(1..=4))
    print("{} {} {}\n", (5 in r, 8 in r, 10 in s))
    print("{}\n", -2 not in c)
    word := "abcdefgh"
    sp := Span(name: "mid", r: 2..5)
    print("{} {}\n", (sp.name, word[sp.r]))
    a := [6]i32(1, 2, 3, 4, 5, 6)
    part := a[1..=3]
    whole := a[RangeIncl(usize)(lo: 0, hi: 5)]
    print("{} {}\n", (part, whole.len))
    e := 4..4
    for i in e { print("never {}\n", i) }
}
