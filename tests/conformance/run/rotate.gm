// `@rotl` and `@rotr` rotate an integer's bits (§20.3), for any width and signedness.
main :: fn() \ {Out} {
    a: u8 = 0b1000_0001
    print("{} {} {} {}\n", (@rotl(a, 1), @rotr(a, 1), @rotl(a, 8), @rotl(a, 9)))
    b: u32 = 0x1234_5678
    print("{} {}\n", (@rotl(b, 8), @rotr(b, 4)))
    c: i16 = -2
    print("{} {}\n", (@rotl(c, 1), @rotr(c, 1)))
    d: u5 = 0b10011
    print("{} {}\n", (@rotl(d, 2), @rotr(d, 2)))
    e: u64 = 1
    print("{}\n", @rotr(e, 1))
    f: u128 = 3
    print("{}\n", @rotr(f, 1))
    g: u200 = 1
    print("{} {}\n", (@rotr(g, 1), @rotl(@rotr(g, 3), 3)))
    h: i130 = -1
    print("{}\n", @rotl(h, 77))
    n: u32 = 13
    print("{}\n", @rotl(b, n) is @rotr(b, 32 - n))
}
