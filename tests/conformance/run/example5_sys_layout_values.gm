// Over-aligned, packed, zero-sized, c_union and #bits values passed and returned by value, including on a fiber stack.
Line :: #align(64) struct { data: [6]u64, tag: u8 }
Page :: #align(4096) struct { bytes: [64]u8 }
Pk :: #packed struct { a: u8, b: u32, c: [5]u16, d: u8 }
Empty :: struct {}
Holder :: struct { e: Empty, z: [0]u64, v: u32 }
Num :: #c_union union { i: [3]i64, f: [3]f64 }
Flags :: #bits(u64) struct {
    a: bool
    b: u7
    c: u24
    _: u32
}

Gen :: effect { give: ctl(l: Line) -> Line }

line :: fn(k: u64) -> Line {
    l := Line(data: [6]u64(fill: k), tag: 1)
    l.data[5] = k * 100
    return l
}

align_of_param :: fn(l: Line) -> u64 => (&l).addr().trunc(u64) % 64

through :: fn(l: Line, p: ^Line) -> u64 {
    p.data[0] = 999
    return l.data[0] + p.addr().trunc(u64) % 64 + align_of_param(l) * 1000
}

page_param :: fn(p: Page) -> u64 => (&p).addr().trunc(u64) % 4096

ret_page :: fn(k: u8) -> Page {
    p := Page(bytes: [64]u8(fill: k))
    return p
}

pk_sum :: fn(p: Pk) -> u32 {
    s: u32 = u32(p.a) + p.b + u32(p.d)
    for c in p.c { s += u32(c) }
    return s
}

pk_make :: fn(k: u8) -> Pk => Pk(a: k, b: u32(k) * 1000, c: [5]u16(fill: u16(k)), d: k + 1)

empty_arg :: fn(e: Empty, h: Holder, k: u32) -> usize => usize(h.v) + usize(k) + @size_of(Empty) * 100 + @size_of(Holder) * 1000

num_sum :: fn(n: Num) -> i64 => n.i[0] + n.i[1] + n.i[2]

num_make :: fn(k: i64) -> Num => Num(i: [3]i64(k, k + 1, k + 2))

flags_roundtrip :: fn(f: Flags) -> Flags {
    g := f
    g.b += 1
    g.c *= 2
    return g
}

fiber_line :: fn() -> u64 needs Gen {
    l := line(3)
    m := give(l)
    return m.data[0] + m.data[5] + align_of_param(m)
}

main :: fn() needs Out {
    l := line(7)
    print("line {} {}\n", align_of_param(l), through(l, &l))
    print("after {}\n", l.data[0])
    print("page {} {}\n", page_param(ret_page(4)), ret_page(9).bytes[63])
    pk := pk_make(3)
    print("packed {} size {}\n", pk_sum(pk), @size_of(Pk))
    print("empty {}\n", empty_arg(Empty(), Holder(e: Empty(), z: [0]u64(), v: 5), 7))
    n := num_make(10)
    print("union {} {}\n", num_sum(n), n.i[2])
    f := Flags(a: true, b: 100, c: 1000, _: 0)
    g := flags_roundtrip(f)
    print("flags {} {} {} / {}\n", g.a, g.b, g.c, u64(g))
    stack: [65536]u8 = ---
    r := with (handler Gen {
        give(ln, k) => {
            m := ln
            m.data[0] += 1
            resume k(m)
        }
    }) on stack[..] {
        fiber_line()
    }
    print("fiber {}\n", r)
}
