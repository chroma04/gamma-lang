//! needs: f16
// IEEE float behaviour in f16, f32 and f64: shortest printing, rounding conversions, NaN and infinity, signed zero, subnormals, bit patterns and compensated summation.
math :: import "std/math"
fmt :: import "std/fmt"

kahan_f32 :: fn(n: u32, x: f32) -> f32 {
    sum: f32 = 0.0
    comp: f32 = 0.0
    for _ in 0..n {
        y := x - comp
        t := sum + y
        comp = (t - sum) - y
        sum = t
    }
    return sum
}

naive_f32 :: fn(n: u32, x: f32) -> f32 {
    sum: f32 = 0.0
    for _ in 0..n { sum += x }
    return sum
}

naive_f64 :: fn(n: u32, x: f64) -> f64 {
    sum := 0.0
    for _ in 0..n { sum += x }
    return sum
}

main :: fn() \ {Out} {
    fb: [400]u8 = ---

    // Shortest round-trip printing at each precision.
    third64: f64 = 1.0 / 3.0
    third32: f32 = 1.0 / 3.0
    print("1/3: f64 {} f32 {}\n", (third64, third32))
    tenth: f32 = 0.1
    print("0.1f32 widened to f64: {}\n", f64(tenth))
    print("0.1 + 0.2 = {}, 0.1f32 + 0.2f32 = {}\n", (0.1 + 0.2, f32(0.1) + f32(0.2)))
    print("big and small: {} {} {} {}\n", (1.0e21, 1.0e20, 1.5e-7, 0.000001))
    print("f32 limits: {} {} {}\n", (f32(16777216.0) + 1.0, f32(3.4028235e38), f32(1.0e-45)))
    print("f64 limits: {} {}\n", (1.7976931348623157e308, 5.0e-324))
    print("pi: {} {}\n", (math.pi, math.pi.to(f32)))

    // Accumulating 0.1 many times: naive summation drifts, Kahan does not.
    print("0.1 x 100000: f32 naive {}, f32 kahan {}, f64 naive {}\n", (naive_f32(100000, 0.1), kahan_f32(100000, 0.1), naive_f64(100000, 0.1)))

    // Signed zero, NaN and infinity.
    pz := 0.0
    nz := -pz
    print("zeros: {} {} equal: {} sign bits: {} {}\n", (pz, nz, pz is nz, pz.sign_bit(), nz.sign_bit()))
    print("1/+0 = {}, 1/-0 = {}\n", (1.0 / pz, 1.0 / nz))
    nan := pz / pz
    print("nan: {} {} {} {}\n", (nan, nan is nan, nan is not nan, -nan))
    print("sqrt(-1) = {}, sqrt(2) = {}\n", ((-1.0).sqrt(), (2.0).sqrt()))
    inf := 1.0 / pz
    print("inf - inf = {}, inf * 0 = {}, inf + 1 = {}\n", (inf - inf, inf * pz, inf + 1.0))
    print("classify: {} {} {} {}\n", (nan.is_nan(), inf.is_inf(), (1.0).is_finite(), inf.is_finite()))
    print("min/max with nan: {} {} {} {}\n", (nan.min(1.0), (1.0).max(nan), (3.0).min(-2.0), (-0.0).max(0.0)))
    print("comparisons with nan: {} {} {} {}\n", (nan < 1.0, nan > 1.0, nan <= nan, nan is nan))

    // Bit patterns.
    print("bits: {} {}\n", ((1.0).bits(u64), f32(-2.0).bits(u32)))
    print("from bits: {} {}\n", ((0x4009_21FB_5444_2D18u64).bits(f64), (0x3FC0_0000u32).bits(f32)))
    print("max subnormal f64: {}\n", (0x000F_FFFF_FFFF_FFFFu64).bits(f64))
    print("min normal f32: {}\n", (0x0080_0000u32).bits(f32))
    print("nan payload kept in f32 bits: {}\n", nan.to(f32).bits(u32) & 0x7FC0_0000)

    // Float to integer conversions.
    vals := [_]f64(2.5, 3.5, -2.5, -0.5, 0.49999999999999994, 1.9999, -1.9999)
    print("round: {} {} {} {} {} {} {}\n", (vals[0].round(i32), vals[1].round(i32), vals[2].round(i32), vals[3].round(i32), vals[4].round(i32), vals[5].round(i32), vals[6].round(i32)))
    print("trunc: {} {} {} {}\n", (vals[0].trunc(i32), vals[2].trunc(i32), vals[5].trunc(i32), vals[6].trunc(i32)))
    print("floor: {} {} {} {}\n", (vals[0].floor(i32), vals[2].floor(i32), vals[3].floor(i32), vals[6].floor(i32)))
    print("ceil:  {} {} {} {}\n", (vals[0].ceil(i32), vals[2].ceil(i32), vals[3].ceil(i32), vals[6].ceil(i32)))
    print("checked: {} {} {}\n", ((3.0e9).checked(i32), (3.0e9).checked(u32), (-1.0).checked(u8)))
    print("sat: {} {} {} {}\n", ((3.0e9).sat(i32), (-3.0e9).sat(i32), (300.7).sat(u8), nan.sat(u8)))

    // Integer to float: rounds to nearest even when the integer is too wide.
    big53: u64 = 9007199254740993
    print("2^53+1 -> {}\n", big53.to(f64))
    imax: i64 = 9223372036854775807
    print("i64 max -> {}\n", imax.to(f64))
    big24: i32 = 16777217
    print("2^24+1 -> f32 {}\n", big24.to(f32))
    wide: u128 = 340282366920938463463374607431768211455
    print("u128 max -> {}\n", wide.to(f64))

    // Narrowing between float types.
    print("narrowing: {} {} {}\n", (f64(1.0e40).to(f32), f64(1.0000000596046448).to(f32), f64(0.1).to(f32)))
    print("f64 -> f32 -> f64: {}\n", f64(f64(0.1).to(f32)))

    // Half precision.
    h1: f16 = 0.1
    h2: f16 = 65504.0
    print("f16: {} {} {}\n", (h1, h2, h2 + 16.0))
    print("f16 sum 0.1 x 10: {}\n", f16_sum())
    print("f16 bits of 1.0 = {}\n", (f16(1.0)).bits(u16))
    print("f16 -> f32: {}\n", f32(h1))
    print("f16 epsilon steps: {} {}\n", (f16(1.0) + f16(0.0009765625), f16(1.0) + f16(0.00048828125)))

    // Library functions to 12 places.
    print("exp(1) = {}\n", fmt.fixed(math.exp(1.0), 12, fb[..]))
    print("sin(1e6) = {}\n", fmt.fixed(math.sin(1.0e6), 12, fb[..]))
    print("atan2(1, -1) = {}\n", fmt.fixed(math.atan2(1.0, -1.0), 12, fb[..]))
    print("pow(2, 0.5) = {}  pow(-8, 1/3) = {}\n", (fmt.fixed(math.pow(2.0, 0.5), 12, fb[0..100]), math.pow(-8.0, 1.0 / 3.0)))
    print("log(0) = {}  log(-1) = {}\n", (math.log(0.0), math.log(-1.0)))
    print("fmod(-7.5, 2) = {}  round(-2.5) = {}  floor(-0.5) = {}\n", (math.fmod(-7.5, 2.0), math.round(-2.5), math.floor(-0.5)))
    print("hypot(3e200, 4e200) = {}\n", math.hypot(3.0e200, 4.0e200))

    // fixed, sci and general formatting of one value.
    v := 1234.5678
    print("{} | {} | {} | {}\n", (fmt.fixed(v, 2, fb[0..100]), fmt.sci(v, 3, fb[100..200]), fmt.general(v, 6, fb[200..300]), fmt.general(0.00001234, 3, fb[300..400])))
    print("rounding ties: {} {} {} {}\n", (fmt.fixed(0.125, 2, fb[0..100]), fmt.fixed(0.375, 2, fb[100..200]), fmt.fixed(2.5, 0, fb[200..300]), fmt.fixed(3.5, 0, fb[300..400])))
}

f16_sum :: fn() -> f16 {
    s: f16 = 0.0
    for _ in 0..10 { s += 0.1 }
    return s
}
