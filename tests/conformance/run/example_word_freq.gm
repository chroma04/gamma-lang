// Word-frequency counter: reads text from stdin, lower-cases words, counts them in a
// HashMap, and prints the most frequent ones. Keys are copied into heap memory because
// the reader reuses its line buffer.
io :: import "std/io"

Entry :: struct {
    word: string
    count: u32
}

Failure :: union { Io: IoError, Mem: AllocError }

is_letter :: fn(c: u8) -> bool => c in 'a'..='z' or c in 'A'..='Z' or c is '\''

lower :: fn(c: u8) -> u8 => if c in 'A'..='Z' { c + 32 } else { c }

// Splits a line into words (maximal runs of letters and apostrophes).
words_of :: fn(line: string) \ {Yield(string)} {
    start: ?usize = null
    for i in 0..line.len {
        if is_letter(line[i]) {
            if start is null { start = i }
        } else if s := start {
            yield(line[s..i])
            start = null
        }
    }
    if s := start { yield(line[s..]) }
}

dup_lower :: fn(w: string) -> AllocError!string \ {Alloc} {
    buf := try make(u8, w.len)
    for i in 0..w.len { buf[i] = lower(w[i]) }
    return buf
}

release :: fn(w: string) \ {Alloc} {
    free(u8, w.ptr.cast([^]u8)[0..w.len])
}

more_frequent :: fn(a, b: ^const Entry) -> bool {
    if a.count is not b.count { return a.count > b.count }
    return a.word < b.word
}

free_keys :: fn(m: ^HashMap(string, u32)) \ {Alloc} {
    for e in m.entries() { release(e.key) }
    m.deinit()
}

main :: fn() -> Failure!() \ {Out, In, Alloc} {
    counts := map(string, u32)
    defer free_keys(&counts)
    lines: u32 = 0
    total: u32 = 0
    r := io.reader()
    while line := try r.next_line() {
        lines += 1
        for w in words_of(line) {
            total += 1
            key := try dup_lower(w)
            if old := counts.get(key) {
                try counts.put(key, old + 1)
                release(key)
            } else {
                try counts.put(key, 1)
            }
        }
    }
    print("{} lines, {} words, {} distinct\n", (lines, total, counts.len()))

    entries := list(Entry)
    defer entries.deinit()
    for e in counts.entries() {
        try entries.push(Entry(word: e.key, count: e.value))
    }
    entries.items.sort_by(more_frequent)

    shown: usize = 0
    for e in entries.items {
        if shown is 8 { break }
        print("{}: {}\n", (e.word, e.count))
        shown += 1
    }

    longest := ""
    singles: u32 = 0
    for e in entries.items {
        if e.word.len > longest.len or (e.word.len is longest.len and e.word < longest) {
            longest = e.word
        }
        if e.count is 1 { singles += 1 }
    }
    print("longest word: {} ({} letters)\n", (longest, longest.len))
    print("words seen once: {}\n", singles)
    return ()
}
