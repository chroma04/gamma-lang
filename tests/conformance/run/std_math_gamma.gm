// std/math: lgamma, lgamma_sign and tgamma on every range of the algorithms, near their zeros and poles,
// at the overflow and underflow limits, and on special values. The results are printed with the shortest
// round-trip representation, so the expected output pins the exact bits.
math :: import "std/math"

NZ: f64 : (0x8000_0000_0000_0000u64).bits(f64)

p1 :: fn(name: string, x: f64, r: f64) needs Out {
    print("{}({}) = {}\n", name, x, r)
}

p2 :: fn(name: string, x: f64, y: f64, r: f64) needs Out {
    print("{}({}, {}) = {}\n", name, x, y, r)
}

test_lgamma :: fn() needs Out {
    p1("lgamma", 0.0, math.lgamma(0.0))
    p1("lgamma", NZ, math.lgamma(NZ))
    p1("lgamma", 5e-324, math.lgamma(5e-324))
    p1("lgamma", 1e-300, math.lgamma(1e-300))
    p1("lgamma", 8.673617379884035e-19, math.lgamma(8.673617379884035e-19))
    p1("lgamma", 1e-05, math.lgamma(1e-05))
    p1("lgamma", 0.1, math.lgamma(0.1))
    p1("lgamma", 0.5, math.lgamma(0.5))
    p1("lgamma", 0.9, math.lgamma(0.9))
    p1("lgamma", 0.99, math.lgamma(0.99))
    p1("lgamma", 0.9999999, math.lgamma(0.9999999))
    p1("lgamma", 1.0, math.lgamma(1.0))
    p1("lgamma", 1.0000001, math.lgamma(1.0000001))
    p1("lgamma", 1.01, math.lgamma(1.01))
    p1("lgamma", 1.25, math.lgamma(1.25))
    p1("lgamma", 1.4616321449683622, math.lgamma(1.4616321449683622))
    p1("lgamma", 1.5, math.lgamma(1.5))
    p1("lgamma", 1.99, math.lgamma(1.99))
    p1("lgamma", 1.9999999, math.lgamma(1.9999999))
    p1("lgamma", 2.0, math.lgamma(2.0))
    p1("lgamma", 2.0000001, math.lgamma(2.0000001))
    p1("lgamma", 2.005, math.lgamma(2.005))
    p1("lgamma", 2.5, math.lgamma(2.5))
    p1("lgamma", 3.0, math.lgamma(3.0))
    p1("lgamma", 4.5, math.lgamma(4.5))
    p1("lgamma", 7.999999999999999, math.lgamma(7.999999999999999))
    p1("lgamma", 8.0, math.lgamma(8.0))
    p1("lgamma", 10.5, math.lgamma(10.5))
    p1("lgamma", 100.0, math.lgamma(100.0))
    p1("lgamma", 171.5, math.lgamma(171.5))
    p1("lgamma", 1000.0, math.lgamma(1000.0))
    p1("lgamma", 1000000000000000.0, math.lgamma(1000000000000000.0))
    p1("lgamma", 2.8823037615171174e+17, math.lgamma(2.8823037615171174e+17))
    p1("lgamma", 1e+100, math.lgamma(1e+100))
    p1("lgamma", 1e+300, math.lgamma(1e+300))
    p1("lgamma", 2.5e+305, math.lgamma(2.5e+305))
    p1("lgamma", 2.6e+305, math.lgamma(2.6e+305))
    p1("lgamma", 1.7976931348623157e+308, math.lgamma(1.7976931348623157e+308))
    p1("lgamma", math.inf, math.lgamma(math.inf))
    p1("lgamma", -1e-300, math.lgamma(-1e-300))
    p1("lgamma", -1e-10, math.lgamma(-1e-10))
    p1("lgamma", -0.25, math.lgamma(-0.25))
    p1("lgamma", -0.5, math.lgamma(-0.5))
    p1("lgamma", -0.9999999999999999, math.lgamma(-0.9999999999999999))
    p1("lgamma", -1.0, math.lgamma(-1.0))
    p1("lgamma", -1.5, math.lgamma(-1.5))
    p1("lgamma", -2.0, math.lgamma(-2.0))
    p1("lgamma", -2.2, math.lgamma(-2.2))
    p1("lgamma", -2.4570247382208006, math.lgamma(-2.4570247382208006))
    p1("lgamma", -2.5, math.lgamma(-2.5))
    p1("lgamma", -2.747682646727412, math.lgamma(-2.747682646727412))
    p1("lgamma", -3.5, math.lgamma(-3.5))
    p1("lgamma", -5.25, math.lgamma(-5.25))
    p1("lgamma", -10.5, math.lgamma(-10.5))
    p1("lgamma", -50.5, math.lgamma(-50.5))
    p1("lgamma", -100.5, math.lgamma(-100.5))
    p1("lgamma", -183.5, math.lgamma(-183.5))
    p1("lgamma", -183.999, math.lgamma(-183.999))
    p1("lgamma", -184.0, math.lgamma(-184.0))
    p1("lgamma", -184.5, math.lgamma(-184.5))
    p1("lgamma", -200.25, math.lgamma(-200.25))
    p1("lgamma", -1000.25, math.lgamma(-1000.25))
    p1("lgamma", -1000000000000000.0, math.lgamma(-1000000000000000.0))
    p1("lgamma", -4503599627370495.5, math.lgamma(-4503599627370495.5))
    p1("lgamma", -math.inf, math.lgamma(-math.inf))
    p1("lgamma", math.nan, math.lgamma(math.nan))
}

pls :: fn(x: f64) needs Out {
    s := math.lgamma_sign(x)
    print("lgamma_sign({}) = {} {}\n", x, s.value, s.sign)
}

test_lgamma_sign :: fn() needs Out {
    pls(0.0)
    pls(NZ)
    pls(0.5)
    pls(1.0)
    pls(2.0)
    pls(-0.5)
    pls(-1.0)
    pls(-1.5)
    pls(-2.5)
    pls(-3.5)
    pls(-4.5)
    pls(-100.5)
    pls(-184.5)
    pls(-185.5)
    pls(math.inf)
    pls(-math.inf)
    pls(math.nan)
}

test_tgamma :: fn() needs Out {
    p1("tgamma", 0.0, math.tgamma(0.0))
    p1("tgamma", NZ, math.tgamma(NZ))
    p1("tgamma", 5e-324, math.tgamma(5e-324))
    p1("tgamma", 1e-300, math.tgamma(1e-300))
    p1("tgamma", 1e-18, math.tgamma(1e-18))
    p1("tgamma", 8.673617379884035e-19, math.tgamma(8.673617379884035e-19))
    p1("tgamma", 1e-10, math.tgamma(1e-10))
    p1("tgamma", 0.1, math.tgamma(0.1))
    p1("tgamma", 0.25, math.tgamma(0.25))
    p1("tgamma", 0.5, math.tgamma(0.5))
    p1("tgamma", 0.75, math.tgamma(0.75))
    p1("tgamma", 0.9999999999999999, math.tgamma(0.9999999999999999))
    p1("tgamma", 1.0, math.tgamma(1.0))
    p1("tgamma", 1.0000000000000002, math.tgamma(1.0000000000000002))
    p1("tgamma", 1.5, math.tgamma(1.5))
    p1("tgamma", 1.9999999999999998, math.tgamma(1.9999999999999998))
    p1("tgamma", 2.0, math.tgamma(2.0))
    p1("tgamma", 2.5, math.tgamma(2.5))
    p1("tgamma", 3.0, math.tgamma(3.0))
    p1("tgamma", 4.0, math.tgamma(4.0))
    p1("tgamma", 5.0, math.tgamma(5.0))
    p1("tgamma", 10.0, math.tgamma(10.0))
    p1("tgamma", 15.0, math.tgamma(15.0))
    p1("tgamma", 20.0, math.tgamma(20.0))
    p1("tgamma", 22.0, math.tgamma(22.0))
    p1("tgamma", 23.0, math.tgamma(23.0))
    p1("tgamma", 24.0, math.tgamma(24.0))
    p1("tgamma", 30.5, math.tgamma(30.5))
    p1("tgamma", 50.0, math.tgamma(50.0))
    p1("tgamma", 100.0, math.tgamma(100.0))
    p1("tgamma", 150.5, math.tgamma(150.5))
    p1("tgamma", 170.0, math.tgamma(170.0))
    p1("tgamma", 171.0, math.tgamma(171.0))
    p1("tgamma", 171.5, math.tgamma(171.5))
    p1("tgamma", 171.62, math.tgamma(171.62))
    p1("tgamma", 171.624, math.tgamma(171.624))
    p1("tgamma", 171.6243769563027, math.tgamma(171.6243769563027))
    p1("tgamma", 171.62437695630274, math.tgamma(171.62437695630274))
    p1("tgamma", 171.7, math.tgamma(171.7))
    p1("tgamma", 172.0, math.tgamma(172.0))
    p1("tgamma", 1000.0, math.tgamma(1000.0))
    p1("tgamma", 1e+300, math.tgamma(1e+300))
    p1("tgamma", math.inf, math.tgamma(math.inf))
    p1("tgamma", -1e-300, math.tgamma(-1e-300))
    p1("tgamma", -1e-10, math.tgamma(-1e-10))
    p1("tgamma", -0.1, math.tgamma(-0.1))
    p1("tgamma", -0.5, math.tgamma(-0.5))
    p1("tgamma", -0.9999999999999999, math.tgamma(-0.9999999999999999))
    p1("tgamma", -1.0, math.tgamma(-1.0))
    p1("tgamma", -1.5, math.tgamma(-1.5))
    p1("tgamma", -2.0, math.tgamma(-2.0))
    p1("tgamma", -2.5, math.tgamma(-2.5))
    p1("tgamma", -3.5, math.tgamma(-3.5))
    p1("tgamma", -4.5, math.tgamma(-4.5))
    p1("tgamma", -10.5, math.tgamma(-10.5))
    p1("tgamma", -20.25, math.tgamma(-20.25))
    p1("tgamma", -50.5, math.tgamma(-50.5))
    p1("tgamma", -100.5, math.tgamma(-100.5))
    p1("tgamma", -150.5, math.tgamma(-150.5))
    p1("tgamma", -170.5, math.tgamma(-170.5))
    p1("tgamma", -171.5, math.tgamma(-171.5))
    p1("tgamma", -172.5, math.tgamma(-172.5))
    p1("tgamma", -175.5, math.tgamma(-175.5))
    p1("tgamma", -180.5, math.tgamma(-180.5))
    p1("tgamma", -183.5, math.tgamma(-183.5))
    p1("tgamma", -183.9, math.tgamma(-183.9))
    p1("tgamma", -184.0, math.tgamma(-184.0))
    p1("tgamma", -184.5, math.tgamma(-184.5))
    p1("tgamma", -185.5, math.tgamma(-185.5))
    p1("tgamma", -200.5, math.tgamma(-200.5))
    p1("tgamma", -1000.5, math.tgamma(-1000.5))
    p1("tgamma", -1000000000000000.0, math.tgamma(-1000000000000000.0))
    p1("tgamma", -math.inf, math.tgamma(-math.inf))
    p1("tgamma", math.nan, math.tgamma(math.nan))
}

main :: fn() needs Out {
    test_lgamma()
    test_lgamma_sign()
    test_tgamma()
}
