// An exit runs only the defers registered before it, whether it leaves through a
// `return`, a `try`, a clause's `break` to a `with` in another function, or a loop
// exit inside a deferred statement.
E :: union { Bad: i32 }

check :: fn(x: i32) -> E!i32 {
    if x < 0 { return !.Bad(x) }
    return x
}

steps :: fn(x: i32) -> E!i32 needs Out {
    defer print("  one\n")
    a := try check(x)
    defer print("  two\n")
    errdefer print("  two failed\n")
    b := try check(x - 5)
    defer print("  three\n")
    if b is 0 { return 100 }
    return a + b
}

Stop :: effect { stop: esc() -> never }

work :: fn(n: i32) needs Out + Stop {
    defer print("  work {} left\n", n)
    for i in 0..n {
        defer print("  step {}\n", i)
        if i is 1 { Stop.stop() }
    }
    defer print("  work {} finished\n", n)
}

nested_cleanup :: fn() needs Out {
    defer {
        for i in 0..4 {
            defer print("  cleanup {}\n", i)
            if i is 2 { break }
        }
        print("  cleanup done\n")
    }
    print("  body\n")
}

main :: fn() needs Out {
    for x in [4]i32(-1, 2, 5, 7) {
        print("steps({}):\n", x)
        print("= {}\n", steps(x))
    }
    for n in 0..3 {
        print("work({}):\n", n)
        with (handler Stop { stop() => break }) { work(n) }
    }
    print("nested:\n")
    nested_cleanup()
}
