main :: fn() \ {Out} {
    a: i128 = 170141183460469231731687303715884105727
    b := -a
    c: u256 = 5
    d := ~c
    e: i24 = 100
    f := -e
    g: u3 = 5
    h := ~g
    i: i65 = -18446744073709551616
    j := i +% i
    k: f16 = 2.5
    l := -k
    print("{} {} {} {} {} {}\n", (b, d, f, h, j, l))
    m: u1 = 1
    print("{} {}\n", (m, ~m))
    n: i128 = -7
    print("{} {} {} {}\n", (n / 2, n % 2, n >> 1, n << 3))
    o: u256 = 0xFFFF_0000_0000_0000_0000_0000_0000_0000_FFFF
    print("{} {}\n", (o >> 100, o & 0xFF00_FF))
    p: u512 = 1
    p = p << 500
    print("{}\n", p)
    q: u65535 = 3
    q = q * q
    print("{}\n", q)
    r: i256 = -5
    print("{} {}\n", (r.abs(), r.pow(3)))
    s: u128 = 12345678901234567890123456789
    print("{} {} {}\n", (s.trunc(u64), s.checked(u64), s.sat(u64)))
    t: f64 = 1e30
    print("{} {}\n", (t.sat(i64), t.checked(i64)))
    print("{} {}\n", (u128(1) << 127, (u128(1) << 127).bits(i128)))
}
