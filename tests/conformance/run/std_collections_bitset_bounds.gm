//! exit: 134
// Inserting at the capacity traps; the last valid index does not.
bs :: import "std/collections/bitset"

main :: fn() -> AllocError!() needs Out + Alloc {
    s := try bs.bitset(65)
    defer s.deinit()
    s.insert(64)
    print("inserted 64: {}\n", s.contains(64))
    s.insert(65)
    print("unreachable\n")
    return ()
}
