// A clause's `break` value converts to the type expected of the `with`, as the
// arms of an `if` do (§12.7).
Fail :: effect { fail: esc(why: string) }
maybe :: fn(n: i32) -> i32 needs Fail {
    if n < 0 { Fail.fail("neg") }
    return n * 2
}
main :: fn() needs Out {
    o: ?i32 = with (handler Fail { fail(w) => break null }) { maybe(-1) }
    print("{}\n", o)
    o2: ?i32 = with (handler Fail { fail(w) => break null }) { maybe(5) }
    print("{}\n", o2)
    w: u8 = with (handler Fail { fail(_) => break 200 }) { 7 }
    print("{}\n", w)
}
