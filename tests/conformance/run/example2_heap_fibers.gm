// Cooperative tasks on heap-allocated fiber stacks, with the scheduler written as a handler declaration that allocates; tasks use Alloc themselves.
Task :: effect {
    yield_now: ctl()
    spawn: ctl(entry: ^fn(arg: ^Job) -> never needs Task + Alloc + Out, arg: ^Job)
    exit: ctl() -> never
}

Job :: struct { id: u32, result: u64 = 0, n: u32 }

Sched :: struct {
    ready: List(cont(()))
    stacks: List([]u8)
    live: u32 = 1
}

pop_front :: fn(s: ^Sched) -> cont(()) {
    k := s.ready.items[0]
    for i in 1..s.ready.items.len { s.ready.items[i - 1] = s.ready.items[i] }
    _ = s.ready.pop()
    return k
}

handler Task for ^Sched needs Alloc + Out {
    yield_now(self, k) => {
        self.ready.push(k) else trap("oom")
        r := pop_front(self)
        resume r()
    }
    spawn(self, entry, arg, k) => {
        mem := make(u8, 32768) else trap("oom")
        self.stacks.push(mem) else trap("oom")
        self.live += 1
        self.ready.push(@fiber(entry, arg, mem)) else trap("oom")
        resume k()
    }
    exit(self, k) => {
        cancel k
        self.live -= 1
        if self.live is 0 { break }
        r := pop_front(self)
        resume r()
    }
}

fib_task :: fn(j: ^Job) -> never needs Task + Alloc + Out {
    scratch := make(u64, 3) else trap("oom")
    defer free(scratch)
    scratch[0] = 0
    scratch[1] = 1
    for i in 0..j.n {
        scratch[2] = scratch[0] + scratch[1]
        scratch[0] = scratch[1]
        scratch[1] = scratch[2]
        if i % 5 is 4 { Task.yield_now() }
    }
    j.result = scratch[0]
    print("job {} -> {}\n", j.id, j.result)
    Task.exit()
}

main :: fn() needs Out + Alloc {
    jobs := [_]Job(Job(id: 1, n: 10), Job(id: 2, n: 50), Job(id: 3, n: 20))
    s := Sched(ready: list(cont(())), stacks: list([]u8))
    defer s.ready.deinit()
    defer s.stacks.deinit()
    main_stack := make(u8, 32768) else trap("oom")
    defer free(main_stack)
    with &s on main_stack {
        for p in each_ptr(jobs[..]) { Task.spawn(fib_task, p) }
        Task.exit()
    }
    for m in s.stacks.items { free(m) }
    total: u64 = 0
    for j in jobs { total += j.result }
    print("total {}\n", total)
}
