    ("622e-6", 0x3f4461b6d43d0397, 0x3a230db7, 0x1118),
    ("3905e5", 0x41b7468ea0000000, 0x4dba3475, 0x7c00),
    ("3e-5", 0x3eff75104d551d69, 0x37fba882, 0x1f7),
)

// The bits of the float that `s` parses to, as a number of the format's width.
bits64 :: fn(s: string) -> u64 {
    x := str.parse_float(f64, s) else return 0xdead_beef_dead_beef
    return x.bits(u64)
}

bits32 :: fn(s: string) -> u32 {
    x := str.parse_float(f32, s) else return 0xdead_beef
    return x.bits(u32)
}

bits16 :: fn(s: string) -> u16 {
    x := str.parse_float(f16, s) else return 0xdead
    return x.bits(u16)
}

main :: fn() needs Out {
    bad: usize = 0
    for row in CASES {
        s := row.0
        // Negative rows are the same without the sign: check both.
        a := bits64(s)
        b := bits32(s)
        c := bits16(s)
        if a is not row.1 or b is not row.2 or c is not row.3 {
            bad += 1
            print("MISMATCH {} f64 {} want {} | f32 {} want {} | f16 {} want {}\n", s, a, row.1, b, row.2, c, row.3)
        }
    }
    print("{} rows, {} mismatches\n", CASES.len, bad)
}
