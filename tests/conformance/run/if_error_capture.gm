// Error captures: `if v := r { … } else e => …` binds a result's error (§8.2).
Bad :: union { Empty, TooBig: u32 }
parse :: fn(n: u32) -> Bad!u32 {
    if n is 0 { return !.Empty }
    if n > 100 { return !.TooBig(n) }
    return n * 2
}
show :: fn(n: u32) -> string \ {Out} {
    if v := parse(n) {
        print("ok {}\n", v)
    } else e => {
        print("error {}\n", e)
    }
    return if n > 50 { "big" } else if v := parse(n) { if v > 10 { "mid" } else { "small" } } else e => match e { .Empty => "empty"; .TooBig(_) => "?" }
}
main :: fn() \ {Out} {
    ns := [3]u32(0, 7, 30)
    for n in ns { print("{}\n", show(n)) }
    print("{}\n", show(500))
    x := if v := parse(9) { v } else e => 0
    print("{}\n", x)
    y := if v := parse(0) { v } else e => return
    print("{}\n", y)
}
