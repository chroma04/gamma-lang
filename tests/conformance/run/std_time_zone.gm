// std/time/zone with real zones from the IANA database: offsets just before, at and after
// transitions (in the file and from the footer rule, up to the year 2100), local time and
// back, in a zone with a 30 minute DST, one that skipped a day, one that abolished DST.
// The fixtures come from tools/gen_tzif_fixtures.py; Paris, New York and Lord Howe keep
// only the transitions up to 2000 or 2010 and rely on the footer after that.
zone :: import "std/time/zone"
time :: import "std/time"
hex :: import "std/encoding/hex"

PARIS :: ""
NEW_YORK :: ""
LORD_HOWE :: ""
KOLKATA :: ""
APIA :: ""
SAO_PAULO :: ""

load :: fn(text: string) -> zone.Zone needs Alloc {
    raw: [2048]u8 = ---
    bytes := hex.decode(text, raw[..]) else trap("bad hex")
    return zone.parse(bytes) else trap("fixture does not parse")
}

fmt_offset :: fn(o: zone.Offset, buf: []u8) -> string {
    t := zone.LocalTime(time: time.from_unix(0), offset: o)
    return zone.format_rfc3339_local(t, buf)
}

// The offset at each instant, as `+HH:MM` taken from the end of a formatted time.
show :: fn(label: string, z: ^const zone.Zone, ts: []const i64) needs Out {
    for t in ts {
        o := zone.offset_at(z, t)
        buf: [zone.RFC3339_LOCAL_LEN]u8 = ---
        s := fmt_offset(o, buf[..])
        print("{} {}: {} dst={} {}\n", label, t, s[s.len - 6..s.len], o.is_dst, o.abbreviation)
    }
}

// The local time of each UTC instant, and what that local time resolves to.
roundtrip :: fn(label: string, z: ^const zone.Zone, ts: []const i64) needs Out {
    for t in ts {
        l := zone.to_local(z, zone.datetime_from_secs(t))
        buf: [zone.RFC3339_LOCAL_LEN]u8 = ---
        print("{} {} -> {} -> {}\n", label, t, zone.format_rfc3339_local(l, buf[..]), zone.from_local(z, l.time))
    }
}

// The instants of a local time in `z`.
resolve :: fn(label: string, z: ^const zone.Zone, text: string) needs Out {
    t := time.parse_rfc3339(text) else trap("bad time")
    print("{} {} -> {}\n", label, text, zone.from_local(z, t))
}

main :: fn() needs Out + Alloc {
    paris := load(PARIS)
    defer zone.deinit(&paris)
    // 2024-03-31T01:00Z and 2024-10-27T01:00Z, the same in 2100, a time before the first
    // transition (1880), and the day Paris stopped using Paris mean time.
    show("paris", &paris, [_]i64(1711846799, 1711846800, 1711846801, 1729990799, 1729990800, 1729990801))
    show("paris", &paris, [_]i64(4109878799, 4109878800, 4128627599, 4128627600))
    show("paris", &paris, [_]i64(-2840140800, -1855958961, 0, 946684800))
    roundtrip("paris", &paris, [_]i64(1711846799, 1711846800, 1729990799, 1729990800, 1700000000))
    resolve("paris", &paris, "2024-03-31T02:30:00Z")       // in the gap
    resolve("paris", &paris, "2024-03-31T01:59:59Z")
    resolve("paris", &paris, "2024-03-31T03:00:00Z")
    resolve("paris", &paris, "2024-10-27T02:30:00Z")       // twice
    resolve("paris", &paris, "2024-10-27T03:00:00Z")
    resolve("paris", &paris, "2100-03-28T02:00:00Z")       // from the footer rule
    resolve("paris", &paris, "2100-10-31T02:59:59Z")

    ny := load(NEW_YORK)
    defer zone.deinit(&ny)
    show("ny", &ny, [_]i64(1710053999, 1710054000, 1730613599, 1730613600, 4108690799, 4108690800, 4129250399, 4129250400))
    resolve("ny", &ny, "2024-03-10T02:30:00Z")
    resolve("ny", &ny, "2024-11-03T01:30:00Z")

    // Lord Howe: DST is 30 minutes.
    lh := load(LORD_HOWE)
    defer zone.deinit(&lh)
    show("lord_howe", &lh, [_]i64(1712415599, 1712415600, 1728142199, 1728142200, 4110447599, 4110447600, 4126174199, 4126174200))
    resolve("lord_howe", &lh, "2024-04-07T01:45:00Z")      // twice, 30 minutes apart
    resolve("lord_howe", &lh, "2024-10-06T02:15:00Z")      // missing, 30 minutes
    resolve("lord_howe", &lh, "2024-10-06T02:30:00Z")

    // India: no DST, and a version 2 file that still has its 32-bit block.
    kolkata := load(KOLKATA)
    defer zone.deinit(&kolkata)
    show("kolkata", &kolkata, [_]i64(-3000000000, 0, 1700000000, 4102444800))

    // Samoa skipped 2011-12-30 altogether.
    apia := load(APIA)
    defer zone.deinit(&apia)
    show("apia", &apia, [_]i64(1325239199, 1325239200, 1609459200))
    resolve("apia", &apia, "2011-12-29T23:59:59Z")
    resolve("apia", &apia, "2011-12-30T00:00:00Z")
    resolve("apia", &apia, "2011-12-30T12:00:00Z")
    resolve("apia", &apia, "2011-12-30T23:59:59Z")
    resolve("apia", &apia, "2011-12-31T00:00:00Z")

    // Brazil abolished DST in 2019: -03 for good, also in 2100.
    sp := load(SAO_PAULO)
    defer zone.deinit(&sp)
    show("sao_paulo", &sp, [_]i64(1541300399, 1541300400, 1550368799, 1550368800, 1700000000, 4102444800))
    resolve("sao_paulo", &sp, "2018-11-04T00:30:00Z")

    // Formatting the local time with a sub-minute offset (local mean time of Paris, +00:09:21).
    l := zone.to_local(&paris, time.parse_rfc3339("1880-01-01T00:00:00Z") else trap("t"))
    buf: [zone.RFC3339_LOCAL_LEN]u8 = ---
    print("{} {}\n", zone.format_rfc3339_local(l, buf[..]), l.offset.abbreviation)
}
