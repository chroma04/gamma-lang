// 128-bit comparisons, shifts, signed division and remainder, widening from every word
// width and truncation back to it (§5.2, §6.3), on values near the edges of each type.
main :: fn() needs Out {
    xs := [_]u128(0, 1, u128(0xffff_ffff_ffff_ffff), u128(1) << 64, (u128(1) << 127) + 3, ~u128(0))
    ys := [_]i128(0, 1, -1, i128(-0x8000_0000_0000_0000) - 1, i128(1) << 100, -(i128(1) << 126), i128(-170141183460469231731687303715884105727) - 1)
    lt: u32 = 0
    for a in xs {
        for b in xs {
            lt = lt *% 3 +% (if a < b { 1 } else { 0 }) +% (if a <= b { 2 } else { 0 })
            lt = lt *% 5 +% (if a > b { 1 } else { 0 }) +% (if a >= b { 4 } else { 0 })
        }
    }
    slt: u32 = 0
    for a in ys {
        for b in ys {
            slt = slt *% 7 +% (if a < b { 1 } else { 0 }) +% (if a >= b { 2 } else { 0 })
            if b is not 0 and not (b is -1 and a < -(i128(1) << 126)) {
                print("{} {} ", a / b, a % b)
            }
        }
    }
    print("\n{} {}\n", lt, slt)
    shifts := [_]u32(0, 1, 7, 63, 64, 65, 100, 127)
    for k in shifts {
        x := (u128(0xdead_beef) << 64) | 0x1234_5678
        y := i128(-0x5555) << 90
        print("{} {} {} {} {}\n", x >> k, x <<% k, y >> k, (u128(1) << k) >> k.trunc(u8), y >> u64(k))
    }
    // Checked shifts that keep every bit.
    print("{} {}\n", u128(3) << 120, i128(-3) << 120)
    // Widening from each word type, and truncation back.
    print("{} {} {} {}\n", i128(i8(-128)), i128(i16(-2)), i128(i32(-70000)), i128(i64(-1) << 63))
    print("{} {} {} {}\n", u128(u8(255)), u128(u16(65535)), u128(u32(0xffff_ffff)), i128(u64(0xffff_ffff_ffff_ffff)))
    big := (u128(0x0123_4567_89ab_cdef) << 64) | 0xfedc_ba98_7654_3210
    print("{} {} {} {}\n", big.trunc(u8), big.trunc(u16), big.trunc(u32), big.trunc(u64))
    neg := -(i128(1) << 80) - 12345
    print("{} {} {} {}\n", neg.trunc(i8), neg.trunc(i16), neg.trunc(i32), neg.trunc(i64))
}
