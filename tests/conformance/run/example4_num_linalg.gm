// Dense linear algebra on comptime-sized matrices: LU with partial pivoting, solve, determinant, inverse.
fmt :: import "std/fmt"

Mat :: struct(N, M: usize) {
    a: [N][M]f64
}

zeros :: fn(N, M :: usize) -> Mat(N, M) {
    return Mat(N, M)(a: [N][M]f64(fill: [M]f64(fill: 0.0)))
}

identity :: fn(N :: usize) -> Mat(N, N) {
    m := zeros(N, N)
    for i in 0..N { m.a[i][i] = 1.0 }
    return m
}

transpose :: fn(N, M :: usize, x: ^const Mat(N, M)) -> Mat(M, N) {
    t := zeros(M, N)
    for i in 0..N {
        for j in 0..M { t.a[j][i] = x.a[i][j] }
    }
    return t
}

matmul :: fn(N, K, M :: usize, x: ^const Mat(N, K), y: ^const Mat(K, M)) -> Mat(N, M) {
    r := zeros(N, M)
    for i in 0..N {
        for j in 0..M {
            s := 0.0
            for k in 0..K { s += x.a[i][k] * y.a[k][j] }
            r.a[i][j] = s
        }
    }
    return r
}

// Result of an LU factorisation done in place: `lu` holds L (unit diagonal, below) and U.
LU :: struct(N: usize) {
    lu: Mat(N, N)
    perm: [N]usize
    sign: i32
}

Singular :: union { Singular }

abs_f :: fn(x: f64) -> f64 => if x < 0.0 { -x } else { x }

lu_decompose :: fn(N :: usize, m: ^const Mat(N, N)) -> Singular!LU(N) {
    f := LU(N)(lu: m^, perm: [N]usize(fill: 0), sign: 1)
    for i in 0..N { f.perm[i] = i }
    for col in 0..N {
        // choose the pivot row
        best := col
        bestv := abs_f(f.lu.a[col][col])
        for r in (col + 1)..N {
            v := abs_f(f.lu.a[r][col])
            if v > bestv {
                best = r
                bestv = v
            }
        }
        if bestv is 0.0 { return !.Singular }
        if best is not col {
            tmp := f.lu.a[col]
            f.lu.a[col] = f.lu.a[best]
            f.lu.a[best] = tmp
            f.perm.swap(col, best)
            f.sign = -f.sign
        }
        piv := f.lu.a[col][col]
        for r in (col + 1)..N {
            factor := f.lu.a[r][col] / piv
            f.lu.a[r][col] = factor
            for c in (col + 1)..N {
                f.lu.a[r][c] -= factor * f.lu.a[col][c]
            }
        }
    }
    return f
}

lu_solve :: fn(N :: usize, f: ^const LU(N), b: [N]f64) -> [N]f64 {
    y: [N]f64 = ---
    // forward substitution with the permuted right-hand side
    for i in 0..N {
        s := b[f.perm[i]]
        for j in 0..i { s -= f.lu.a[i][j] * y[j] }
        y[i] = s
    }
    x: [N]f64 = ---
    i := N
    while i > 0 {
        i -= 1
        s := y[i]
        for j in (i + 1)..N { s -= f.lu.a[i][j] * x[j] }
        x[i] = s / f.lu.a[i][i]
    }
    return x
}

determinant :: fn(N :: usize, m: ^const Mat(N, N)) -> f64 {
    f := lu_decompose(N, m) else return 0.0
    d := f64(f.sign)
    for i in 0..N { d *= f.lu.a[i][i] }
    return d
}

inverse :: fn(N :: usize, m: ^const Mat(N, N)) -> Singular!Mat(N, N) {
    f := try lu_decompose(N, m)
    inv := zeros(N, N)
    for c in 0..N {
        e := [N]f64(fill: 0.0)
        e[c] = 1.0
        col := lu_solve(N, &f, e)
        for r in 0..N { inv.a[r][c] = col[r] }
    }
    return inv
}

max_abs_diff :: fn(N, M :: usize, x, y: ^const Mat(N, M)) -> f64 {
    d := 0.0
    for i in 0..N {
        for j in 0..M {
            v := abs_f(x.a[i][j] - y.a[i][j])
            if v > d { d = v }
        }
    }
    return d
}

show :: fn(N, M :: usize, x: ^const Mat(N, M)) \ {Out} {
    fb: [400]u8 = ---
    pb: [64]u8 = ---
    for i in 0..N {
        for j in 0..M {
            s := fmt.fixed(x.a[i][j], 4, fb[..])
            print(" {}", fmt.pad_left(s, 9, ' ', pb[..]))
        }
        print("\n")
    }
}

fixed4 :: fn(x: f64, buf: []u8) -> string => fmt.fixed(x, 4, buf)

main :: fn() \ {Out} {
    fb: [400]u8 = ---

    // A well-conditioned 3x3 system with a known solution (1, -2, 3).
    a := zeros(3, 3)
    a.a = [3][3]f64(
        [3]f64(2.0, 1.0, -1.0),
        [3]f64(-3.0, -1.0, 2.0),
        [3]f64(-2.0, 1.0, 2.0),
    )
    print("A =\n")
    show(&a)
    f := lu_decompose(3, &a) else { print("singular?\n")
        return }
    print("permutation: {}, sign: {}\n", (f.perm, f.sign))
    print("LU =\n")
    show(&f.lu)
    x := lu_solve(3, &f, [3]f64(8.0, -11.0, -3.0))
    b0: [64]u8 = ---
    b1: [64]u8 = ---
    b2: [64]u8 = ---
    print("x = ({}, {}, {})\n", (fixed4(x[0], b0[..]), fixed4(x[1], b1[..]), fixed4(x[2], b2[..])))

    print("det(A) = {}\n", fmt.fixed(determinant(3, &a), 4, fb[..]))

    // Inverse and the round trip A * A^-1 = I.
    inv := inverse(3, &a) else { print("no inverse\n")
        return }
    print("A^-1 =\n")
    show(&inv)
    prod := matmul(3, 3, 3, &a, &inv)
    id := identity(3)
    print("max |A*inv - I| < 1e-12: {}\n", max_abs_diff(3, 3, &prod, &id) < 1e-12)

    // A singular matrix is reported, not divided by zero.
    s := zeros(3, 3)
    s.a = [3][3]f64(
        [3]f64(1.0, 2.0, 3.0),
        [3]f64(2.0, 4.0, 6.0),
        [3]f64(1.0, 1.0, 1.0),
    )
    print("det(S) = {}\n", fmt.fixed(determinant(3, &s), 4, fb[..]))
    match inverse(3, &s) {
        !.Singular => print("S is singular\n")
        _          => print("S inverted?\n")
    }

    // Hilbert matrices get ill-conditioned quickly.
    h := zeros(4, 4)
    for i in 0..4 {
        for j in 0..4 { h.a[i][j] = 1.0 / (i + j + 1).round(f64) }
    }
    dh := determinant(4, &h)
    print("det(H4) = {}\n", fmt.sci(dh, 6, fb[..]))
    hinv := inverse(4, &h) else { return }
    print("H4^-1[0][0] = {}  H4^-1[3][3] = {}\n", (fmt.fixed(hinv.a[0][0], 2, fb[0..40]), fmt.fixed(hinv.a[3][3], 2, fb[100..140])))

    // Rectangular products and transposes.
    r := zeros(2, 3)
    r.a = [2][3]f64([3]f64(1.0, 2.0, 3.0), [3]f64(4.0, 5.0, 6.0))
    rt := transpose(2, 3, &r)
    g := matmul(2, 3, 2, &r, &rt)
    print("R * R^T =\n")
    show(&g)
    gt := transpose(2, 2, &g)
    print("symmetric: {}\n", g.a is gt.a)
}
