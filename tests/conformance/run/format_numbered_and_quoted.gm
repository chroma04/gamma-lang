// Numbered placeholders (`{1}`) write a value by position, any number of times and in
// any order, and `{:q}` writes a string quoted with escapes (§21.6.1).
str :: import "std/str"

next :: fn(c: ^i32) -> i32 needs Out {
    c^ += 1
    print("[eval {}]", c^)
    return c^
}

forward :: fn(A: type, template :: string, args: ..A) needs Out + Alloc {
    s := str.format(template, ..args)!
    print("<{}>\n", s)
}

main :: fn() needs Out + Alloc {
    c := 0
    // Each value is evaluated once, left to right, before anything is written.
    print("{1} {0} {1:>4} {0:x}|\n", next(&c), next(&c) + 253)
    print("{0} {0} {0:x} {0:#b}\n", 255)
    print("{0:q}|{0:>13q}|{0:^14q}|{0}\n", "a\n\"b\"")
    print("{1}{0}{1}\n", "x", "y")
    t := (7, "z")
    print("{1}{0}{1}\n", ..t)
    print("{:q}|{:<5q}|\n", "x", "y")
    bytes: []const u8 = "tab\there\x01"
    print("{:q}\n", bytes)
    print("{0}={0:q}\n", "")
    s := str.format("{0}-{0}-{1:q}", 1, "z")!
    print("{}\n", s)
    forward("{1} {0} {0:q}", "a b", "c")
    forward("{0:q}", "\n")
    print("{{0}} {0} {{\n", 1)
}
