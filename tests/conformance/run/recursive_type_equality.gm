// `is` and hashing work on self-recursive types: the comparison recurses only as deep as the data.
Value :: union { Null, Num: i32, Arr: []Value }

Node :: union { Leaf, Branch: List(Node) }

main :: fn() \ {Out, Alloc} {
    a: Value = .Null
    b: Value = .Null
    print("{} {} {}\n", (a is b, a is .Null, a is .Num(1)))

    // Nested three deep: [[[1]]] against [[[1]]] and [[[2]]].
    one1 := [1]Value(.Num(1))
    one2 := [1]Value(.Num(1))
    two := [1]Value(.Num(2))
    mid1 := [1]Value(.Arr(one1[..]))
    mid2 := [1]Value(.Arr(one2[..]))
    mid3 := [1]Value(.Arr(two[..]))
    top1 := [1]Value(.Arr(mid1[..]))
    top2 := [1]Value(.Arr(mid2[..]))
    top3 := [1]Value(.Arr(mid3[..]))
    x: Value = .Arr(top1[..])
    y: Value = .Arr(top2[..])
    z: Value = .Arr(top3[..])
    print("{} {} {}\n", (x is y, x is z, x is .Null))

    m := map(Value, i32)
    defer m.deinit()
    m.put(x, 10) else return
    m.put(z, 20) else return
    print("{} {}\n", (m.get(y), m.get(z)))

    l1 := list(Node)
    defer l1.deinit()
    l2 := list(Node)
    defer l2.deinit()
    n1: Node = .Branch(l1)
    n2: Node = .Branch(l2)
    print("{} {}\n", (n1 is n2, n1 is .Leaf))
}
