// std/math: every function on ordinary arguments and on special values (NaN, infinities,
// signed zeros, huge, tiny and subnormal numbers). The results are printed with the shortest
// round-trip representation, so the expected output pins the exact bits.
math :: import "std/math"

NZ: f64 : (0x8000_0000_0000_0000u64).bits(f64)

p1 :: fn(name: string, x: f64, r: f64) \ {Out} {
    print("{}({}) = {}\n", name, x, r)
}

p2 :: fn(name: string, x: f64, y: f64, r: f64) \ {Out} {
    print("{}({}, {}) = {}\n", name, x, y, r)
}

constants :: fn() \ {Out} {
    print("pi = {}\n", math.pi)
    print("e = {}\n", math.e)
    print("tau = {}\n", math.tau)
    print("ln2 = {}\n", math.ln2)
    print("ln10 = {}\n", math.ln10)
    print("sqrt2 = {}\n", math.sqrt2)
    print("inf = {}\n", math.inf)
    print("nan = {}\n", math.nan)
}

test_sqrt :: fn() \ {Out} {
    p1("sqrt", 0.0, math.sqrt(0.0))
    p1("sqrt", NZ, math.sqrt(NZ))
    p1("sqrt", 1.0, math.sqrt(1.0))
    p1("sqrt", 2.0, math.sqrt(2.0))
    p1("sqrt", 0.25, math.sqrt(0.25))
    p1("sqrt", 10.0, math.sqrt(10.0))
    p1("sqrt", 1e300, math.sqrt(1e300))
    p1("sqrt", 5e-324, math.sqrt(5e-324))
    p1("sqrt", 1e-310, math.sqrt(1e-310))
    p1("sqrt", math.inf, math.sqrt(math.inf))
    p1("sqrt", -1.0, math.sqrt(-1.0))
    p1("sqrt", -math.inf, math.sqrt(-math.inf))
    p1("sqrt", math.nan, math.sqrt(math.nan))
}

