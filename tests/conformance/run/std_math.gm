    p2("atan2", 0.0, NZ, math.atan2(0.0, NZ))
    p2("atan2", NZ, NZ, math.atan2(NZ, NZ))
    p2("atan2", 3.0, 4.0, math.atan2(3.0, 4.0))
    p2("atan2", 1e300, 1e-300, math.atan2(1e300, 1e-300))
    p2("atan2", 1e-300, 1e300, math.atan2(1e-300, 1e300))
    p2("atan2", -1e-300, -1e300, math.atan2(-1e-300, -1e300))
