    p2("atan2", 0.5, -0.25, math.atan2(0.5, -0.25))
    p2("atan2", 1.7498186601944967, -0.4106165806540556, math.atan2(1.7498186601944967, -0.4106165806540556))
    p2("atan2", math.inf, math.inf, math.atan2(math.inf, math.inf))
    p2("atan2", -math.inf, math.inf, math.atan2(-math.inf, math.inf))
    p2("atan2", math.inf, -math.inf, math.atan2(math.inf, -math.inf))
    p2("atan2", -math.inf, -math.inf, math.atan2(-math.inf, -math.inf))
    p2("atan2", math.inf, 1.0, math.atan2(math.inf, 1.0))
    p2("atan2", -math.inf, 1.0, math.atan2(-math.inf, 1.0))
    p2("atan2", 1.0, math.inf, math.atan2(1.0, math.inf))
    p2("atan2", -1.0, math.inf, math.atan2(-1.0, math.inf))
    p2("atan2", 1.0, -math.inf, math.atan2(1.0, -math.inf))
    p2("atan2", -1.0, -math.inf, math.atan2(-1.0, -math.inf))
    p2("atan2", 0.0, math.inf, math.atan2(0.0, math.inf))
    p2("atan2", 0.0, -math.inf, math.atan2(0.0, -math.inf))
    p2("atan2", math.nan, 1.0, math.atan2(math.nan, 1.0))
    p2("atan2", 1.0, math.nan, math.atan2(1.0, math.nan))
}

