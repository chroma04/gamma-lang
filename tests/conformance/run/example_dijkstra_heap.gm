// A generic binary min-heap used as a priority queue for Dijkstra's algorithm.
Heap :: struct(T: type) {
    data: List(T)
}

heap :: fn(T: type) -> Heap(T) \ {Alloc} {
    return Heap(T)(data: list(T))
}

heap_free :: fn(T: type, h: ^Heap(T)) {
    h.data.deinit()
}

heap_len :: fn(T: type, h: ^const Heap(T)) -> usize => h.data.items.len

heap_push :: fn(T: type, h: ^Heap(T), x: T) -> AllocError!() where Ord(T) {
    try h.data.push(x)
    items := h.data.items
    i := items.len - 1
    while i > 0 {
        parent := (i - 1) / 2
        if items[parent] <= items[i] { break }
        items.swap(parent, i)
        i = parent
    }
    return ()
}

heap_pop :: fn(T: type, h: ^Heap(T)) -> ?T where Ord(T) {
    n := h.data.items.len
    if n is 0 { return null }
    items := h.data.items
    top := items[0]
    items.swap(0, n - 1)
    _ = h.data.pop()
    items = h.data.items
    m := items.len
    i: usize = 0
    while true {
        l := 2 * i + 1
        r := l + 1
        smallest := i
        if l < m and items[l] < items[smallest] { smallest = l }
        if r < m and items[r] < items[smallest] { smallest = r }
        if smallest is i { break }
        items.swap(i, smallest)
        i = smallest
    }
    return top
}

Edge :: struct {
    to: u32
    w: u32
}

Graph :: struct {
    adj: List(List(Edge))
}

graph :: fn(n: usize) -> AllocError!Graph \ {Alloc} {
    g := Graph(adj: list(List(Edge)))
    errdefer graph_free(&g)
    for _ in 0..n {
        try g.adj.push(list(Edge))
    }
    return g
}

graph_free :: fn(g: ^Graph) {
    for l in each_ptr(g.adj.items) { l.deinit() }
    g.adj.deinit()
}

add_edge :: fn(g: ^Graph, a, b, w: u32) -> AllocError!() {
    try g.adj.items[a].push(Edge(to: b, w: w))
    try g.adj.items[b].push(Edge(to: a, w: w))
    return ()
}

INF :: 4_000_000_000u32

// Returns distances from `src`; entries are INF when unreachable.
dijkstra :: fn(g: ^Graph, src: u32, dist: []u32, prev: []?u32) -> AllocError!u32 \ {Alloc} {
    dist.fill(INF)
    prev.fill(null)
    dist[src] = 0
    pq := heap((u32, u32))
    defer heap_free(&pq)
    try pq.heap_push((0, src))
    pops: u32 = 0
    while top := pq.heap_pop() {
        d, u := top
        pops += 1
        if d > dist[u] { continue }
        for e in g.adj.items[u].items {
            nd := d + e.w
            if nd < dist[e.to] {
                dist[e.to] = nd
                prev[e.to] = u
                try pq.heap_push((nd, e.to))
            }
        }
    }
    return pops
}

print_path :: fn(prev: []const ?u32, target: u32) \ {Out} {
    path: [16]u32 = ---
    n: usize = 0
    cur: ?u32 = target
    while c := cur {
        path[n] = c
        n += 1
        cur = prev[c]
    }
    i := n
    while i > 0 {
        i -= 1
        print("{}", path[i])
        if i > 0 { print(" -> ") }
    }
    print("\n")
}

main :: fn() -> AllocError!() \ {Out, Alloc} {
    // heap sort check
    h := heap(i32)
    defer heap_free(&h)
    xs := [_]i32(5, -3, 9, 0, 12, 7, -8, 5, 1)
    for x in xs {
        try h.heap_push(x)
    }
    print("heap size {}\n", h.heap_len())
    while v := h.heap_pop() {
        print("{} ", v)
    }
    print("\n")

    g := try graph(8)
    defer graph_free(&g)
    edges := [_](u32, u32, u32)(
        (0, 1, 7), (0, 2, 9), (0, 5, 14), (1, 2, 10), (1, 3, 15),
        (2, 3, 11), (2, 5, 2), (3, 4, 6), (4, 5, 9),
    )
    for e in edges {
        try add_edge(&g, e.0, e.1, e.2)
    }
    dist: [8]u32 = ---
    prev := [8]?u32(fill: null)
    pops := try dijkstra(&g, 0, dist[..], prev[..])
    print("pops: {}\n", pops)
    for i, d in enumerate(dist[..]) {
        if d is INF {
            print("node {}: unreachable\n", i)
        } else {
            print("node {}: dist {} via ", i, d)
            print_path(prev[..], i.trunc(u32))
        }
    }
    return ()
}
