Reader :: effect(T: type) {
    ask: fn() -> T
}

Counter :: struct(T: type) {
    value: T
    reads: u32 = 0
}

handler Reader(u32) for ^Counter(u32) {
    ask(self) => {
        self.reads += 1
        self.value
    }
}

double_ask :: fn() -> u32 \ {Reader(u32)} {
    return ask() + ask()
}

sum_asks :: fn(n: u32) -> u32 \ {Reader(u32)} {
    total: u32 = 0
    for _ in 0..n { total += ask() }
    return total
}

generic_user :: fn(T: type, n: u32) -> T \ {Reader(T)} where Num(T) {
    t: T = 0
    for _ in 0..n { t += ask() }
    return t
}

main :: fn() \ {Out} {
    c := Counter(u32)(value: 21)
    with &c {
        print("{} {}\n", double_ask(), sum_asks(4))
    }
    print("reads {}\n", c.reads)

    k := Counter(u32)(value: 5)
    r := with &k { generic_user(u32, 3) }
    print("{} {}\n", r, k.reads)

    h :: handler Reader(f64) {
        ask() => 0.25
    }
    f := with h { generic_user(f64, 6) }
    print("{}\n", f)
}
