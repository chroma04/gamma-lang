//! os: unix
// `lstat` does not follow a final symbolic link and `stat` does, on the real file system
// (the links are made with the C library's `symlink`, which Windows does not have).
c :: import "std/c"
fs :: import "std/fs"

libc :: foreign "c" {
    symlink :: fn(target: cstring, link: cstring) -> c.c_int
    unlink :: fn(path: cstring) -> c.c_int
}

// `path` followed by a NUL, in `buf`, as a C string.
cpath :: fn(buf: []u8, path: string) -> cstring {
    buf[0..path.len].copy_from(path)
    buf[path.len] = 0
    return buf.ptr.cast(cstring)
}

// `root/rel` in `buf`.
at :: fn(buf: []u8, root, rel: string) -> string {
    buf[0..root.len].copy_from(root)
    buf[root.len] = '/'
    buf[root.len + 1..root.len + 1 + rel.len].copy_from(rel)
    return buf[0..root.len + 1 + rel.len]
}

hex :: fn(b: u8) -> u8 => if b < 10 { '0' + b } else { 'a' + b - 10 }

scenario :: fn(root: string) -> IoError!() needs Out + Fs + Sys {
    p: [600]u8 = ---
    lb: [600]u8 = ---
    cb: [600]u8 = ---
    try Fs.make_dir(at(p[..], root, "a"))
    f := try Fs.open(at(p[..], root, "a/two.txt"), fs.OpenOptions(write: true, create: true))
    _ = try f.write_to("22")
    Fs.close(f)

    link := at(lb[..], root, "link")
    made := libc.symlink(cpath(cb[..], at(p[..], root, "a/two.txt")), cpath(lb[..], link)) is 0
    print("symlink made: {}\n", made)
    ln := try Fs.lstat(link)
    print("lstat link: {} {}\n", ln.kind is .Symlink, ln.size is not 2)
    sf := try Fs.stat(link)
    print("stat link: {} {}\n", sf.kind is .File, sf.size)
    dl := at(cb[..], root, "dirlink")
    _ = libc.symlink(cpath(p[..], at(lb[..], root, "a")), cpath(cb[..], dl))
    print("lstat dir link: {} stat dir link: {}\n", (try Fs.lstat(dl)).kind is .Symlink, (try Fs.stat(dl)).kind is .Dir)
    _ = libc.symlink(cpath(p[..], "no/such/target"), cpath(lb[..], at(cb[..], root, "dangling")))
    print("lstat dangling: {} stat dangling: {}\n", (try Fs.lstat(at(cb[..], root, "dangling"))).kind is .Symlink, Fs.stat(at(cb[..], root, "dangling")) is !.NotFound)
}

cleanup :: fn(root: string) needs Fs + Sys {
    p: [600]u8 = ---
    lb: [600]u8 = ---
    for rel in [_]string("link", "dirlink", "dangling") {
        _ = libc.unlink(cpath(p[..], at(lb[..], root, rel)))
    }
    _ = Fs.remove(at(p[..], root, "a/two.txt"))
    _ = Fs.remove_dir(at(p[..], root, "a"))
    _ = Fs.remove_dir(root)
}

main :: fn() -> IoError!() needs Out + Fs + Rand + Alloc + Env + Sys {
    tmp := Env.var("TMPDIR") else "/tmp"
    r: [6]u8 = ---
    Rand.fill(r[..])
    name: [24]u8 = ---
    name[0..12].copy_from("gamma-links-")
    for i in 0..6 {
        name[12 + 2 * i] = hex(r[i] >> 4)
        name[12 + 2 * i + 1] = hex(r[i] & 15)
    }
    root_buf: [600]u8 = ---
    root := at(root_buf[..], tmp, name[..])
    try Fs.make_dir(root)
    result := scenario(root)
    cleanup(root)
    print("cleaned up: {}\n", Fs.stat(root) is !.NotFound)
    return result
}
