// Bit intrinsics on odd integer widths (u3, u24, i24, u48, u100, u128): rotates, counts, bit reversal and wrapping arithmetic.
main :: fn() needs Out {
    a: u24 = 0xABCDEF
    print("{} {}\n", a, @rotl(a, 4))
    print("{} {} {}\n", @clz(a), @ctz(a), @popcount(a))
    b: u3 = 5
    print("{} {}\n", b +% 4, b *% 3)
    print("{}\n", @rotl(b, 1))
    print("{}\n", @bitreverse(b))
    c: i24 = -8_000_000
    print("{} {}\n", c -% 1_000_000, c >> 4)
    d: u100 = 1
    d = (d << 99) +% (d << 99)
    print("{}\n", d)
    e: u100 = (u100(1) << 50) | 0xFF
    print("{} {}\n", @popcount(e), @clz(e))
    f: u48 = 0x1234_5678_9ABC
    print("{} {}\n", f, @rotr(f, 8))
    g: i7 = -64
    print("{} {}\n", g -% 1, g.trunc(i4))
    h: u128 = 0x0123_4567_89AB_CDEF_0123_4567_89AB_CDEF
    print("{} {}\n", @bswap(h), @rotl(h, 100))
    print("{}\n", @bitreverse(u16(0x0001)))
    sh: u8 = 3
    print("{}\n", u32(1) << sh)
    print("{}\n", @rotl(u8(0x81), 9))
    print("{}\n", @rotl(i8(-127), 1))
}
