//! ptr_bits: 64
// Compile-time evaluation of numeric code: a Mandelbrot picture, Pascal's triangle, a prime sieve and float tables, all checked against the same functions at run time.
math :: import "std/math"

// ---- Mandelbrot ----
W :: 36
H :: 14

escape_time :: fn(cr, ci: f64) -> u32 {
    zr := 0.0
    zi := 0.0
    for i in 0..30 {
        zr2 := zr * zr
        zi2 := zi * zi
        if zr2 + zi2 > 4.0 { return i }
        zi = 2.0 * zr * zi + ci
        zr = zr2 - zi2 + cr
    }
    return 30
}

picture :: fn() -> [H][W]u8 {
    shades :: " .:-=+*#%@"
    img: [H][W]u8 = ---
    for row in 0..H {
        for col in 0..W {
            cr := -2.2 + 3.2 * col.to(f64) / (W - 1).to(f64)
            ci := -1.2 + 2.4 * row.to(f64) / (H - 1).to(f64)
            t := escape_time(cr, ci)
            img[row][col] = shades[usize(t * 9 / 30)]
        }
    }
    return img
}

#fuel(100_000_000)
IMAGE :: picture()

// ---- Pascal's triangle with u64 entries ----
ROWS :: 20
pascal :: fn() -> [ROWS][ROWS]u64 {
    t := [ROWS][ROWS]u64(fill: [ROWS]u64(fill: 0))
    for n in 0..ROWS {
        t[n][0] = 1
        for k in 1..=n {
            t[n][k] = t[n - 1][k - 1] + (if k < n { t[n - 1][k] } else { 0 })
        }
    }
    return t
}
PASCAL :: pascal()
@static_assert(PASCAL[10][5] is 252)
@static_assert(PASCAL[19][9] is 92378)

// ---- Prime sieve as an array of bool, and a count derived from it ----
SIEVE_N :: 2000
sieve :: fn() -> [SIEVE_N]bool {
    is_p := [SIEVE_N]bool(fill: true)
    is_p[0] = false
    is_p[1] = false
    for i in 2..SIEVE_N {
        if is_p[i] {
            j := i * i
            while j < SIEVE_N {
                is_p[j] = false
                j += i
            }
        }
    }
    return is_p
}
PRIMES_FLAGS :: sieve()
count_flags :: fn(flags: []const bool) -> usize {
    n: usize = 0
    for f in flags { if f { n += 1 } }
    return n
}
PRIME_COUNT :: count_flags(PRIMES_FLAGS[..])
@static_assert(PRIME_COUNT is 303, "pi(2000) = 303")

// The primes themselves, in an array sized by the count.
prime_list :: fn() -> [PRIME_COUNT]u16 {
    out: [PRIME_COUNT]u16 = ---
    k: usize = 0
    for i in 0..SIEVE_N {
        if PRIMES_FLAGS[i] {
            out[k] = i.trunc(u16)
            k += 1
        }
    }
    return out
}
PRIME_LIST :: prime_list()

// ---- floating-point tables: evaluated by the compile-time evaluator and again at run time ----
sqrt_table :: fn() -> [16]f64 {
    t: [16]f64 = ---
    for i in 0..16 { t[i] = math.sqrt(i.to(f64)) }
    return t
}
SQRTS :: sqrt_table()

harmonic :: fn(n: u32) -> f64 {
    h := 0.0
    for i in 1..=n { h += 1.0 / i.to(f64) }
    return h
}
H1000 :: harmonic(1000)

// Gauss-Legendre style quadrature of exp over [0, 1] by composite Simpson, to compile time.
simpson_exp :: fn(n: u32) -> f64 {
    h := 1.0 / n.to(f64)
    s := math.exp(0.0) + math.exp(1.0)
    for i in 1..n {
        x := i.to(f64) * h
        s += (if i % 2 is 1 { 4.0 } else { 2.0 }) * math.exp(x)
    }
    return s * h / 3.0
}
E_MINUS_1 :: simpson_exp(200)

// ---- a compile-time-selected implementation ----
when target.ptr_bits is 64 {
    word_name :: fn() -> string => "64-bit words"
} else {
    word_name :: fn() -> string => "narrow words"
}

main :: fn() needs Out {
    for row in 0..H { print("{}\n", IMAGE[row][..]) }

    // The run-time evaluation of the same function agrees byte for byte.
    now := picture()
    print("run time picture equals compile-time picture: {}\n", now is IMAGE)

    print("pascal row 12: {}\n", PASCAL[12][0..13])
    sum: u64 = 0
    for k in 0..ROWS { sum += PASCAL[ROWS - 1][k] }
    print("row 19 sums to 2^19: {}\n", sum is u64(1) << 19)

    print("primes below 2000: {}, last five: {}\n", PRIME_COUNT, PRIME_LIST[PRIME_COUNT - 5..])
    print("sieve at run time agrees: {}\n", sieve() is PRIMES_FLAGS)

    print("sqrt table agrees: {}\n", sqrt_table() is SQRTS)
    print("sqrt(15) = {}\n", SQRTS[15])
    print("H(1000) = {}, at run time {}\n", H1000, harmonic(1000))
    print("simpson e-1 error below 1e-9: {}\n", (E_MINUS_1 - (math.e - 1.0)).abs() < 1e-9)
    print("{}\n", word_name())
}
