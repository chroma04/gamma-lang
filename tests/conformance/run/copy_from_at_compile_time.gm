// `copy_from` in compile-time evaluation (§17, §21.3): overlapping copies in both
// directions, and elements that are structs, give the same values as at run time.

P :: struct { x: i32, y: i32 }

shifted :: fn(left: bool) -> [6]u8 {
    a: [6]u8 = [6]u8(1, 2, 3, 4, 5, 6)
    if left {
        a[0..4].copy_from(a[2..6])
    } else {
        a[2..6].copy_from(a[0..4])
    }
    return a
}

points :: fn() -> [3]P {
    a: [3]P = [3]P(P(x: 1, y: 2), P(x: 3, y: 4), P(x: 5, y: 6))
    a[1..3].copy_from(a[0..2])
    return a
}

LEFT :: shifted(true)
RIGHT :: shifted(false)
POINTS :: points()

main :: fn() needs Out {
    print("{} {}\n", LEFT, shifted(true))
    print("{} {}\n", RIGHT, shifted(false))
    print("{} {} {}\n", POINTS[0].x, POINTS[1].y, POINTS[2].x)
    r := points()
    print("{} {} {}\n", r[0].x, r[1].y, r[2].x)
}
