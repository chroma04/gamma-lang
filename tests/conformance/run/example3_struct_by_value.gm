// Structs passed and returned by value across the C ABI: libc ldiv and exported Gamma functions called back through a foreign declaration.
c :: import "std/c"

Big :: struct { a: i64, b: f64, c: i32, d: u8 }
Pair :: struct { x: f32, y: f32 }
LDiv :: struct { quot: c.c_long, rem: c.c_long }

libc :: foreign "c" {
    ldiv :: fn(n, d: c.c_long) -> LDiv \ {}
    dog_big :: fn(b: Big, k: c.c_int) -> Big \ {}
    dog_pair :: fn(p: Pair) -> Pair \ {}
}

#export("dog_big")
big :: fn(b: Big, k: c.c_int) -> Big => Big(a: b.a * i64(k), b: b.b + 0.5, c: b.c - k, d: b.d + 1)

#export("dog_pair")
pair :: fn(p: Pair) -> Pair => Pair(x: p.y, y: p.x)

main :: fn() \ {Out, Sys} {
    r := libc.ldiv(-17, 5)
    print("{} {}\n", (r.quot, r.rem))
    b := libc.dog_big(Big(a: 7, b: 1.0, c: 10, d: 200), 3)
    print("{} {} {} {}\n", (b.a, b.b, b.c, b.d))
    p := libc.dog_pair(Pair(x: 1.0, y: 2.0))
    print("{} {}\n", (p.x, p.y))
    print("sizes {} {}\n", (@size_of(Big), @size_of(Pair)))
}
