// Generic fixed-point numbers Fx(F) with saturating, wrapping and checked flavors, an integer square root and a compile-time sine table built with std/math.
math :: import "std/math"
fmt :: import "std/fmt"

// A signed fixed-point number with F fractional bits stored in an i32.
Fx :: struct(F: u32) {
    raw: i32
}

from_int :: fn(F :: u32, n: i32) -> Fx(F) => Fx(F)(raw: n << F)

from_f64 :: fn(F :: u32, x: f64) -> Fx(F) {
    scaled := x * (i64(1) << F).to(f64)
    return Fx(F)(raw: scaled.round(i64).sat(i32))
}

to_f64 :: fn(F :: u32, x: Fx(F)) -> f64 => x.raw.to(f64) / (i64(1) << F).to(f64)

// Saturating arithmetic.
add_sat :: fn(F :: u32, a, b: Fx(F)) -> Fx(F) => Fx(F)(raw: a.raw +| b.raw)
sub_sat :: fn(F :: u32, a, b: Fx(F)) -> Fx(F) => Fx(F)(raw: a.raw -| b.raw)

// Wrapping arithmetic.
add_wrap :: fn(F :: u32, a, b: Fx(F)) -> Fx(F) => Fx(F)(raw: a.raw +% b.raw)

// Checked arithmetic: null on overflow.
add_checked :: fn(F :: u32, a, b: Fx(F)) -> ?Fx(F) {
    r := a.raw +? b.raw else return null
    return Fx(F)(raw: r)
}

mul_checked :: fn(F :: u32, a, b: Fx(F)) -> ?Fx(F) {
    wide := i64(a.raw) * i64(b.raw)
    half: i64 = if F > 0 { i64(1) << (F - 1) } else { 0 }
    r := ((wide + half) >> F).checked(i32) else return null
    return Fx(F)(raw: r)
}

mul_sat :: fn(F :: u32, a, b: Fx(F)) -> Fx(F) {
    wide := i64(a.raw) * i64(b.raw)
    half: i64 = if F > 0 { i64(1) << (F - 1) } else { 0 }
    return Fx(F)(raw: ((wide + half) >> F).sat(i32))
}

div_sat :: fn(F :: u32, a, b: Fx(F)) -> Fx(F) {
    num := i64(a.raw) << F
    return Fx(F)(raw: (num / i64(b.raw)).sat(i32))
}

// floor(sqrt(n)) by Newton's method
isqrt :: fn(n: u64) -> u64 {
    if n < 2 { return n }
    x := n
    y := (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

sqrt_fx :: fn(F :: u32, a: Fx(F)) -> Fx(F) {
    if a.raw <= 0 { return Fx(F)(raw: 0) }
    wide := a.raw.trunc(u64) << F
    return Fx(F)(raw: isqrt(wide).trunc(i32))
}

// Quarter-wave sine table in Q16.16, built at compile time from std/math.
TABLE_N :: 65
sin_table :: fn() -> [TABLE_N]i32 {
    t: [TABLE_N]i32 = ---
    for i in 0..TABLE_N {
        angle := math.pi / 2.0 * i.to(f64) / 64.0
        t[i] = (math.sin(angle) * 65536.0).round(i32)
    }
    return t
}
SIN_TABLE :: sin_table()

// sin of an angle in Q16.16 radians within [0, pi/2], with linear interpolation.
sin_quarter :: fn(angle: Fx(16)) -> Fx(16) {
    // index = angle / (pi/2/64) in Q16.16; pi/2/64 = 0.0245436... = 1608.5 raw
    step: i64 = 1608
    pos := i64(angle.raw) * 65536 / step
    idx := (pos >> 16).trunc(usize)
    frac := pos & 0xFFFF
    if idx >= TABLE_N - 1 { return Fx(16)(raw: SIN_TABLE[TABLE_N - 1]) }
    lo := i64(SIN_TABLE[idx])
    hi := i64(SIN_TABLE[idx + 1])
    return Fx(16)(raw: (lo + (((hi - lo) * frac) >> 16)).trunc(i32))
}

Q16 :: Fx(16)
Q8 :: Fx(8)

show :: fn(F :: u32, x: Fx(F), digits: u32, buf: []u8) -> string => fmt.fixed(to_f64(F: F, x), digits, buf)

main :: fn() \ {Out} {
    b1: [400]u8 = ---
    b2: [400]u8 = ---
    b3: [400]u8 = ---

    a := from_f64(16, 3.25)
    b := from_f64(16, -1.5)
    print("a={} b={} raw(a)={}\n", (show(F: 16, a, 4, b1[..]), show(F: 16, b, 4, b2[..]), a.raw))
    print("a*b = {}   a/b = {}\n", (show(F: 16, mul_sat(F: 16, a, b), 6, b1[..]), show(F: 16, div_sat(F: 16, a, b), 6, b2[..])))

    // Q16.16 covers -32768..32767.99998; going past that is where the flavors differ.
    c := from_f64(16, 20000.5)
    d := from_f64(16, 15000.25)
    print("c+d saturates to {} (raw {})\n", (show(F: 16, add_sat(F: 16, c, d), 4, b1[..]), add_sat(F: 16, c, d).raw))
    print("c+d wraps to {}\n", show(F: 16, add_wrap(F: 16, c, d), 4, b1[..]))
    print("c+d checked is null: {}\n", add_checked(F: 16, c, d) is null)
    if s := add_checked(F: 16, c, from_f64(16, -20.5)) {
        print("c-20.5 checked = {}\n", show(F: 16, s, 4, b1[..]))
    }
    print("c*d checked is null: {}\n", mul_checked(F: 16, c, d) is null)
    print("c*d saturates to raw {}\n", mul_sat(F: 16, c, d).raw)
    neg := from_f64(16, -20000.5)
    print("-c-d saturates to raw {}\n", sub_sat(F: 16, neg, d).raw)
    print("3/0.5 = {}\n", show(F: 16, div_sat(F: 16, from_int(16, 3), from_f64(16, 0.5)), 3, b1[..]))
    print("1000/0.001 saturates: {}\n", div_sat(F: 16, from_int(16, 1000), from_f64(16, 0.001)).raw)

    // The same code at a different precision: Q24.8 trades fraction bits for range.
    e := from_f64(8, 100000.125)
    f := from_f64(8, 0.1)
    print("Q24.8: {} * {} = {} (raw {}, 0.1 is not representable)\n", (show(F: 8, e, 3, b1[..]), show(F: 8, f, 4, b2[..]), show(F: 8, mul_sat(F: 8, e, f), 4, b3[..]), mul_sat(F: 8, e, f).raw))

    // from_f64 clamps out-of-range inputs and keeps the exact value when representable.
    big := from_f64(16, 1.0e9)
    print("clamped: {} {}\n", (big.raw, from_f64(16, -1.0e9).raw))
    print("exact: {}\n", show(F: 16, from_f64(16, 0.0001), 8, b1[..]))

    // Square roots.
    print("sqrt:")
    xs := [_]f64(2.0, 9.0, 0.25, 1000.0)
    for x in xs {
        r := sqrt_fx(F: 16, from_f64(16, x))
        print(" {}", show(F: 16, r, 5, b1[..]))
    }
    print("\n")

    // Table-driven sine against the exact function.
    worst := 0.0
    for i in 0..=100 {
        ang := from_f64(16, math.pi / 2.0 * i.to(f64) / 100.0)
        approx := to_f64(F: 16, sin_quarter(ang))
        err := (approx - math.sin(to_f64(F: 16, ang))).abs()
        if err > worst { worst = err }
    }
    print("sine table error below 5e-4: {}\n", worst < 5e-4)
    half_pi := from_f64(16, 1.5707963)
    print("sin(pi/2) = {}  sin(0) = {}\n", (show(F: 16, sin_quarter(half_pi), 4, b1[..]), show(F: 16, sin_quarter(from_int(16, 0)), 4, b2[..])))
    print("sin(0.5236) = {} (expect 0.5)\n", show(F: 16, sin_quarter(from_f64(16, 0.5235988)), 3, b1[..]))
    print("table[32] = {}\n", SIN_TABLE[32])

    // Accumulating 0.1 ten times in Q16.16 does not give exactly 1.
    tenth := from_f64(16, 0.1)
    acc := from_int(16, 0)
    for _ in 0..10 { acc = add_sat(F: 16, acc, tenth) }
    print("0.1 * 10 in Q16.16: raw {} (65536 would be exact), {}\n", (acc.raw, show(F: 16, acc, 6, b1[..])))
    print("sizes: {} {}\n", (@size_of(Q16), @size_of(Q8)))
}
