// std/fiber sleeping with the real clock: tasks that sleep until 100, 20 and 60 ms after a
// common start wake in the order of their deadlines, and the sleeps overlap: the quick task
// falls asleep after the slow one and wakes before it. Only deterministic facts are printed.
fiber :: import "std/fiber"

Nap :: struct {
    name: string
    start: Instant
    for_ms: u64
}

nap :: fn(j: ^Nap) needs fiber.Sched(Out + Clock) + Out + Clock {
    print("{} falls asleep\n", j.name)
    fiber.sleep_until(j.start.after(ms(j.for_ms)))
    print("{} wakes\n", j.name)
}

// Never sleeps and never blocks: yields until the napper is up, so the scheduler has a ready
// task to run while the napper waits for its deadline.
Shared :: struct {
    napper_up: bool
    rounds: u64
}

spin :: fn(s: ^Shared) needs fiber.Sched(Out + Clock) + Out + Clock {
    while not s.napper_up {
        s.rounds += 1
        fiber.Sched.yield_now()
    }
    print("spinner done\n")
}

napper :: fn(s: ^Shared) needs fiber.Sched(Out + Clock) + Out + Clock {
    print("napper falls asleep\n")
    fiber.sleep(ms(20))
    s.napper_up = true
    print("napper wakes\n")
}

main :: fn() -> AllocError!() needs Out + Alloc + Clock {
    s := fiber.scheduler(Out + Clock)
    defer s.deinit()
    main_stack: [32768]u8 = ---
    sa: [32768]u8 = ---
    sb: [32768]u8 = ---
    sc: [32768]u8 = ---
    t0 := Clock.now()
    a := Nap(name: "slow", start: t0, for_ms: 100)
    b := Nap(name: "quick", start: t0, for_ms: 20)
    c := Nap(name: "middle", start: t0, for_ms: 60)
    with &s on main_stack[..] {
        fiber.spawn(nap, &a, sa[..])
        fiber.spawn(nap, &b, sb[..])
        fiber.spawn(nap, &c, sc[..])
        fiber.Sched.join()
    }
    elapsed := Clock.now().since(t0).to_ms()
    print("at least the longest sleep: {}\n", elapsed >= 100)

    // The same with a task that never sleeps and keeps the scheduler busy meanwhile.
    shared := Shared(napper_up: false, rounds: 0)
    with &s on main_stack[..] {
        fiber.spawn(spin, &shared, sa[..])
        fiber.spawn(napper, &shared, sb[..])
        fiber.Sched.join()
    }
    print("the spinner ran while the napper slept: {}\n", shared.rounds > 0)
}
