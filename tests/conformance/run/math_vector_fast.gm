//! mode: fast
// Fast builds remove the overflow and index checks of math vectors (§18.2); in range, the
// results are those of the checked build, and the wrapping and saturating flavors are
// unchanged (§5.6.3, §7.4.7).
Vec3 :: #vec [3]f32
IV4 :: #vec [4]i32
UV4 :: #vec [4]u8

main :: fn() needs Out {
    a := IV4(1, -2, 3, -4)
    b := IV4(10, 20, 30, 40)
    print("{} {} {}\n", a + b, a - b, a * b)
    print("{} {} {}\n", b / a, b % a, -a)
    print("{} {} {}\n", a & b, a | b, a ~ b)
    print("{} {} {}\n", a << 3, b >> 2, ~a)
    print("{} {}\n", a * 5, 2 * b)
    print("{} {} {}\n", a.dot(b), a.min(b), a.max(b))
    print("{}\n", a.abs())

    w := UV4(250, 5, 255, 0)
    print("{} {}\n", w +% UV4(fill: 10), w -% UV4(fill: 10))
    print("{} {}\n", w +| UV4(fill: 10), w -| UV4(fill: 10))
    print("{} {}\n", w *% UV4(fill: 2), w *| UV4(fill: 2))
    print("{}\n", IV4(2147483647, -2147483648, 0, 1) +% IV4(fill: 1))

    f := Vec3(1, 2, 3)
    g := Vec3(0.5, 0.25, 4)
    print("{} {} {}\n", f * g, f / g, f - g)
    print("{} {}\n", f.cross(g), Vec3(3, 4, 12).norm())
    print("{}\n", f.dot(g))

    c := a
    c += b
    c *= 2
    c <<= 1
    c %= IV4(7, 7, 7, 7)
    print("{}\n", c)
    i: usize = 3
    c[i] = 99
    print("{} {}\n", c, c[i])
}
