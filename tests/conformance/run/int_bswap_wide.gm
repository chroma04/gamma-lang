// @bswap on widths that are a multiple of 8 but not of 64.
main :: fn() \ {Out} {
    a: u136 = @black_box(1)
    b: i136 = @black_box(1)
    c: u200 = @black_box(1)
    d: i200 = @black_box(1)
    print("{} {} {} {}\n", (@bswap(a) is 1 << 128, @bswap(b) is 1 << 128, @bswap(c) is 1 << 192, @bswap(d) is 1 << 192))
    print("{} {}\n", (@bswap(@bswap(a)) is a, @bswap(@bswap(d)) is d))
    e: i200 = @black_box(-2)
    print("{} {}\n", (@bswap(e) is (-2i200 << 192) + (1i200 << 192) - 1, @bswap(@bswap(e)) is e))
    f: i136 = @black_box(0x0102)
    print("{}\n", @bswap(f) is (0x0201i136 << 120))
    g: u256 = @black_box(1)
    h: u192 = @black_box(1)
    print("{} {}\n", (@bswap(g) is 1 << 248, @bswap(h) is 1 << 184))
}
