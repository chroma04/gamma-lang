// C stdio and Gamma output interleave in order; atexit with a Gamma callback, bsearch returning a pointer, an exported function installing its own Out handler.
c :: import "std/c"
libc :: foreign "c" {
    puts :: fn(s: cstring) -> c.c_int
    printf :: fn(fmt: cstring, ...) -> c.c_int
    atexit :: fn(cb: ^fn() \ {Sys}) -> c.c_int
    bsearch :: fn(key: rawptr, base: rawptr, n, size: usize, cmp: ^fn(a, b: rawptr) -> c.c_int) -> ?rawptr \ {}
    fflush :: fn(f: rawptr) -> c.c_int
}

bye :: fn() \ {Sys} {
    _ = libc.puts(c"atexit callback")
}

cmp :: fn(a, b: rawptr) -> c.c_int {
    x := a.cast(^const i32)^
    y := b.cast(^const i32)^
    return if x < y { -1 } else if x > y { 1 } else { 0 }
}

#export("dog_greet")
greet :: fn(n: c.c_int) -> c.c_int \ {Sys} {
    out := system_output()
    with out {
        print("greet {}\n", n)
    }
    return n * 2
}

main :: fn() \ {Out, Sys} {
    print("gamma 1\n")
    _ = libc.puts(c"c 1")
    print("gamma 2\n")
    _ = libc.printf(c"c %d\n", c.c_int(2))
    print("gamma 3\n")
    _ = libc.atexit(bye)
    sorted := [_]i32(1, 3, 5, 7, 9)
    key: i32 = 7
    if p := libc.bsearch(&key, &sorted, 5, 4, cmp) {
        idx := (p.addr() - (&sorted).addr()) / 4
        print("found at {}\n", idx)
    }
    r := greet(21)
    print("r {}\n", r)
}
