pub Audit :: effect {
    charge: fn(id: u32, amount: u32)
    flag: fn(why: string)
}

pub Ledger :: struct {
    pub total: u64 = 0
    pub flags: u32 = 0
    pub entries: u32 = 0
}

handler Audit for ^Ledger {
    charge(self, id, amount) => {
        self.total += u64(amount)
        self.entries += 1
    }
    flag(self, why) => { self.flags += 1 }
}
