// Inline assembly (§19.5). Programs using it run natively.

when target.arch is .X86_64 {
    add :: fn(a, b: u32) -> u32 \ {Sys} {
        r := a
        @asm("addl %1, %0", ("+r", &r), ("r", b), "cc")
        return r
    }

    mul_add :: fn(a, b, c: u64) -> u64 \ {Sys} {
        r := a
        @asm("imulq %1, %0\n\taddq %2, %0", ("+r", &r), (("r", b), ("r", c)), ("cc",))
        return r
    }

    // Two outputs, one of them a float: the constraints tie each output to an
    // input's register, so the empty template copies them.
    split :: fn(x: f64) -> (bits: u64, copy: f64) \ {Sys} {
        bits: u64 = 0
        copy: f64 = 0.0
        @asm("", (("=r", &bits), ("=x", &copy)), (("0", x.bits(u64)), ("1", x)), ())
        return (bits: bits, copy: copy)
    }
} else when target.arch is .Aarch64 {
    add :: fn(a, b: u32) -> u32 \ {Sys} {
        r: u32 = 0
        @asm("add %w0, %w1, %w2", ("=r", &r), (("r", a), ("r", b)), ())
        return r
    }

    mul_add :: fn(a, b, c: u64) -> u64 \ {Sys} {
        r: u64 = 0
        @asm("madd %0, %1, %2, %3", ("=r", &r), (("r", a), ("r", b), ("r", c)), ())
        return r
    }

    // Two outputs, one of them a float: the constraints tie each output to an
    // input's register, so the empty template copies them.
    split :: fn(x: f64) -> (bits: u64, copy: f64) \ {Sys} {
        bits: u64 = 0
        copy: f64 = 0.0
        @asm("", (("=r", &bits), ("=w", &copy)), (("0", x.bits(u64)), ("1", x)), ())
        return (bits: bits, copy: copy)
    }
} else {
    add :: fn(a, b: u32) -> u32 \ {Sys} => a + b
    mul_add :: fn(a, b, c: u64) -> u64 \ {Sys} => a * b + c
    split :: fn(x: f64) -> (bits: u64, copy: f64) \ {Sys} => (bits: x.bits(u64), copy: x)
}

main :: fn() \ {Out, Sys} {
    print("{}\n", add(40, 2))
    print("{}\n", mul_add(6, 7, 100))
    // A compiler barrier: an empty template that clobbers memory.
    @asm("", (), (), "memory")
    s := split(1.5)
    print("{} {}\n", (s.bits, s.copy))
}
