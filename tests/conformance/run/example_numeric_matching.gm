math :: import "std/math"

Shape :: union {
    Circle: f64
    Rect: (w: f64, h: f64)
    Tri: (a: f64, b: f64, c: f64)
}

area :: fn(s: Shape) -> f64 => match s {
    .Circle(r) => math.pi * r * r
    .Rect(w, h) => w * h
    .Tri(a, b, c) => {
        p := (a + b + c) / 2.0
        math.sqrt(p * (p - a) * (p - b) * (p - c))
    }
}

Pair :: struct { a: i32, b: i32 }

classify :: fn(p: Pair) -> string => match p {
    Pair(a: 0, b: 0) => "origin"
    Pair(a: x, b: y) if x is y => "diagonal"
    Pair(a: x) if x < 0 => "left"
    Pair(b: 0) => "x-axis"
    _ => "other"
}

seq :: fn(xs: []const i32) -> string => match xs.len {
    0 => "empty"
    1 => "one"
    2..=3 => "few"
    _ => "many"
}

main :: fn() needs Out {
    a := u128(0xFFFF_FFFF_FFFF_FFFF) * u128(0xFFFF_FFFF_FFFF_FFFF)
    print("{} {} {}\n", a, a / 12345678901234567, a % 1000000007)
    b := i128(-170141183460469231731687303715884105728) / i128(-3)
    print("{}\n", b)
    c := -7 / 2
    d := -7 % 2
    print("{} {}\n", c, d)
    sh: u32 = 70
    big: u128 = 1
    print("{}\n", big << sh)
    print("{} {} {}\n", math.sqrt(2.0), math.sin(1.0), math.pow(2.0, 0.5))
    print("{} {} {} {}\n", area(Shape.Circle(2)), area(Shape.Rect(w: 3, h: 4)), area(Shape.Tri(3, 4, 5)), math.floor(-2.5))
    nan := math.nan
    print("{} {} {} {}\n", nan, math.inf, -math.inf, nan is nan)
    z: f64 = 0.0
    nz := -z
    print("{} {} {}\n", z, nz, z is nz)
    print("{} {} {}\n", f32(1) / f32(3), f64(1) / f64(3), 1e300 * 1e10)
    print("{} {} {} {} {}\n", classify(Pair(a: 0, b: 0)), classify(Pair(a: 3, b: 3)), classify(Pair(a: -2, b: 5)), classify(Pair(a: 4, b: 0)), classify(Pair(a: 4, b: 1)))
    e0 := [0]i32()
    e1 := [_]i32(1)
    e3 := [_]i32(1, 2, 3)
    e5 := [_]i32(1, 2, 3, 4, 5)
    print("{} {} {} {}\n", seq(e0[..]), seq(e1[..]), seq(e3[..]), seq(e5[..]))
    grid := [3][3]i32(fill: [3]i32(fill: 0))
    copy := grid
    copy[1][1] = 5
    grid[0] = [3]i32(1, 2, 3)
    print("{} {}\n", grid, copy)
    p := Pair(a: 1, b: 2)
    q := p
    q.a = 10
    print("{} {}\n", p, q)
    words := [_]string("pear", "Apple", "apple", "fig", "")
    words[..].sort()
    print("{}\n", words)
    print("{} {}\n", "abc" < "abd", "abc" < "ab")
    s := "héllo, wörld ✓"
    n: u32 = 0
    nr: u32 = 0
    for r in runes(s) {
        nr += 1
        if r > 127 { n += 1 }
    }
    print("{} bytes, {} runes, {} non-ascii, valid={}\n", s.len, nr, n, s.utf8_valid())
    print("{} {}\n", @type_name(Pair), @type_name(?[]const u8))
}
