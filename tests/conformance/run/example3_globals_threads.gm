// #global and #thread_local storage: atomics on globals from threads, per-thread copies, thread.defaults, mutex try_lock.
thread :: import "std/thread"

#global hits: u64 = 0
#global flag: bool = false
#global table: [4]u32 = [4]u32(1, 2, 3, 4)
#thread_local #global tl: u32 = 100
#global msg: cstring = c"hi"
#global ptr: ?^u32 = null

worker :: fn(arg: rawptr) \ {Sys} {
    id := arg.cast(^u32)^
    for _ in 0..1000 { _ = @atomic_add(&hits, 1, .Relaxed) }
    tl += id
    thread.defaults(fn() {
        print("worker {} tl {}\n", (id, tl))
    })
    _ = @atomic_swap(&flag, true, .SeqCst)
}

main :: fn() -> IoError!() \ {Out, Sys} {
    ids := [_]u32(1, 2, 3)
    ts: [3]thread.Thread = ---
    for i in 0..3 { ts[i] = try thread.spawn(worker, (&ids[i]).cast(rawptr)); ts[i].join() }
    print("hits {} flag {} tl {}\n", (@atomic_load(&hits, .SeqCst), @atomic_load(&flag, .SeqCst), tl))
    table[2] = 30
    print("{} {}\n", (table[2], msg.cstr_len()))
    x: u32 = 9
    ptr = &x
    if p := ptr { print("{}\n", p^) }
    m := thread.mutex()
    print("try {} {}\n", (m.try_lock(), m.try_lock()))
    m.unlock()
}
