// Multi-module INI reader: a pub effect and handler declaration across modules, private fields behind accessors, qualified union patterns.
ini :: import "../ini"

CONFIG :: `
; global settings
name = "demo app"
verbose = yes

[server]
host = localhost
port = 8080
port = 9090
timeout 30
= nokey
workers = 4

[limits ]
max_size = -1
ratio = 0.75
[broken
debug = no
`

Counts :: struct {
    warnings: u32 = 0
    last_line: usize = 0
}

handler ini.Warn for ^Counts \ {Out} {
    warn(self, line, msg) => {
        self.warnings += 1
        self.last_line = line
        print("  warning (line {}): {}\n", line, msg)
    }
}

show :: fn(label: string, v: ?ini.Value) \ {Out} {
    match v {
        null => print("{}: (unset)\n", label)
        .Int(n) => print("{}: int {}\n", label, n)
        .Bool(b) => print("{}: bool {}\n", label, b)
        .Text(t) => print("{}: text {}\n", label, t)
    }
}

int_or :: fn(v: ?ini.Value, fallback: i64) -> i64 {
    if .Int(n) := v { return n }
    return fallback
}

main :: fn() -> AllocError!() \ {Out, Alloc} {
    counts := Counts()
    doc := with &counts { try ini.parse(CONFIG) }
    defer ini.free_doc(&doc)
    print("{} warnings, last on line {}\n", counts.warnings, counts.last_line)
    for s in doc.sections.items {
        print("[{}] {} entries\n", s.name, s.entries.items.len)
        for e in s.entries.items {
            print("  {} = {} (line {})\n", e.key, e.value, ini.line_of(e))
        }
    }
    root := ini.section(&doc, "")?
    srv := ini.section(&doc, "server")?
    show("name", ini.lookup(root, "name"))
    show("verbose", ini.lookup(root, "verbose"))
    show("host", ini.lookup(srv, "host"))
    show("port", ini.lookup(srv, "port"))
    show("missing", ini.lookup(srv, "nothing"))
    print("{}\n", ini.section(&doc, "nope") is null)
    port := int_or(ini.lookup(srv, "port"), 80)
    workers := int_or(ini.lookup(srv, "workers"), 1)
    print("{} workers on port {}\n", workers, port)
    return ()
}
