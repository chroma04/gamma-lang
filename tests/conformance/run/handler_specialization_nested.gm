// Iterator adapters and recursive iterators: a loop body may be called directly by
// the iterator that feeds it, through several adapters (Appendix D.3). Whatever the
// back end does, every exit must still leave the right loop and run the right defers.
Stop :: effect { stop: esc(code: i32) -> never }

nums :: fn(n: i32) \ {Yield(i32), Out} {
    defer print("nums({}) done\n", n)
    for i in range(0, n) { yield(i) }
}

squares :: fn(n: i32) \ {Yield(i32), Out} {
    defer print("squares done\n")
    for v in nums(n) { yield(v * v) }
}

evens :: fn(n: i32) \ {Yield(i32), Out} {
    for v in squares(n) {
        if v % 2 is 1 { continue }
        yield(v)
    }
}

// Five levels of adapters, deeper than any limit on nesting.
add1 :: fn(n: i32) \ {Yield(i32), Out} { for v in evens(n) { yield(v + 1) } }
add2 :: fn(n: i32) \ {Yield(i32), Out} { for v in add1(n) { yield(v + 1) } }
add3 :: fn(n: i32) \ {Yield(i32), Out} { for v in add2(n) { yield(v + 1) } }

// An adapter whose loop body leaves its own loop.
first_over :: fn(n: i32, limit: i32) -> i32 \ {Out} {
    for v in add3(n) {
        if v > limit { return v }
    }
    return -1
}

// An adapter that stops early, and one that performs another effect in its loop body.
take :: fn(n: i32, k: i32) \ {Yield(i32), Out} {
    seen := 0
    for v in squares(n) {
        if seen is k { break }
        yield(v)
        seen += 1
    }
}

checked :: fn(n: i32) \ {Yield(i32), Stop, Out} {
    for v in nums(n) {
        if v is 3 { stop(v) }
        yield(v)
    }
}

Tree :: struct { val: i32, kids: []const Tree }

walk :: fn(t: ^const Tree) \ {Yield(i32)} {
    yield(t.val)
    for k in t.kids { for v in walk(&k) { yield(v) } }
}

// A recursive iterator calling itself directly, with the same handler.
countdown :: fn(n: i32) \ {Yield(i32)} {
    if n is 0 { return }
    yield(n)
    countdown(n - 1)
}

chain :: fn(depth: i32) -> Tree {
    leaf :: fn(v: i32) -> Tree => Tree(val: v, kids: empty_slice(Tree))
    return leaf(depth)
}

main :: fn() \ {Out} {
    total := 0
    for v in evens(6) { total += v }
    print("evens total {}\n", total)
    for v in add3(5) { print("add3 {}\n", v) }
    print("first over {}\n", first_over(10, 40))
    for v in take(10, 3) { print("take {}\n", v) }
    outer: for v in add3(10) {
        for w in add1(4) {
            if w > 4 { continue outer }
            if v > 60 { break outer }
            print("pair {} {}\n", v, w)
        }
    }
    r := with (handler Stop { stop(c) => break c * 10 }) {
        s := 0
        for v in checked(10) { s += v }
        s
    }
    print("stopped {}\n", r)

    // Depth 6: past any limit on nesting, the inner levels still work.
    l5 := [1]Tree(Tree(val: 6, kids: empty_slice(Tree)))
    l4 := [1]Tree(Tree(val: 5, kids: l5[..]))
    l3 := [2]Tree(Tree(val: 4, kids: l4[..]), Tree(val: 40, kids: empty_slice(Tree)))
    l2 := [1]Tree(Tree(val: 3, kids: l3[..]))
    l1 := [1]Tree(Tree(val: 2, kids: l2[..]))
    root := Tree(val: 1, kids: l1[..])
    for v in walk(&root) { print("node {}\n", v) }
    for v in walk(&root) {
        if v is 5 { break }
        print("before 5: {}\n", v)
    }
    deep := 0
    for v in walk(&root) {
        if v < 4 { continue }
        deep += v
    }
    print("deep {}\n", deep)
    n := 0
    for v in countdown(5) { n = n * 10 + v }
    print("countdown {}\n", n)
    print("chain {}\n", chain(3).val)
}
