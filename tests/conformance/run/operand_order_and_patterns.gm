// The operands of an operator and the arguments of a call are evaluated left to right: a
// local read before a call that assigns it keeps the value it had (§7.1).
Shape :: union {
    Circle: i32
    Rect: (w: i32, h: i32)
    Empty
}

Pair :: struct { a: i64, b: bool }

Counter :: effect {
    bump: fn(n: i64) -> i64
}

Acc :: struct { total: i64 }

handler Counter for ^Acc {
    bump(self, n) => {
        self.total += n
        self.total
    }
}

add3 :: fn(a: i64, b: i64, c: i64) -> i64 => a * 100 + b * 10 + c

describe :: fn(s: Shape) -> i32 => match s {
    .Circle(r) => r
    .Rect(w, h) => w * h
    .Empty => -1
}

classify :: fn(x: ?i64) -> i64 => match x {
    null => -1
    0 => 0
    v => v * 2
}

pair_kind :: fn(p: Pair) -> i64 => match p {
    Pair(a: 0, b: _) => 0
    Pair(a: n, b: true) => n
    Pair(a: n, b: false) => -n
}

parse :: fn(n: i64) -> string!i64 {
    if n < 0 { return !"negative" }
    return n
}

main :: fn() needs Out {
    x: i64 = 1
    set :: fn(v: i64) -> i64 {
        x = v
        return v
    }
    a := x + set(5)
    print("{} {}\n", a, x)
    b := add3(x, set(7), x)
    print("{} {}\n", b, x)
    c := (x < set(2)) and x is 2
    print("{} {}\n", c, x)

    // Small integers stay in range through locals.
    s: i8 = -100
    s = s - 20
    u: u8 = 250
    u = u +% 10
    w: u32 = 0xffff_ffff
    w = w +% 2
    print("{} {} {}\n", s, u, w)

    for shape in (Shape.Circle(3), Shape.Rect(2, 5), Shape.Empty) { print("{} ", describe(shape)) }
    print("\n")
    print("{} {} {}\n", classify(null), classify(0), classify(21))
    print("{} {} {}\n", pair_kind(Pair(a: 0, b: true)), pair_kind(Pair(a: 4, b: true)), pair_kind(Pair(a: 4, b: false)))
    for n in (-1, 3) {
        match parse(n) {
            !e => print("error {}\n", e)
            v => print("ok {}\n", v)
        }
    }

    acc := Acc(total: 0)
    t := with &acc {
        Counter.bump(2) + Counter.bump(3)
    }
    print("{} {}\n", t, acc.total)
}
