//! os: unix
c :: import "std/c"

LDiv :: struct { quot: c.c_long, rem: c.c_long }

Tm :: struct {
    sec, min, hour, mday, mon, year, wday, yday, isdst: c.c_int
    gmtoff: c.c_long
    zone: ?cstring
}

libc :: foreign "c" {
    ldiv :: fn(n, d: c.c_long) -> LDiv \ {}
    strtod :: fn(s: cstring, end: ?^cstring) -> f64 \ {Sys}
    atoi :: fn(s: cstring) -> c.c_int \ {}
    getenv :: fn(name: cstring) -> ?cstring \ {Sys}
    memcpy :: fn(dst: rawptr, src: rawptr, n: c.c_size_t) -> rawptr
    gmtime_r :: fn(t: ^const c.c_long, out: ^Tm) -> ?^Tm
    strchr :: fn(s: cstring, ch: c.c_int) -> ?cstring \ {}
    bsearch :: fn(key: rawptr, base: rawptr, n, size: c.c_size_t, cmp: ^fn(a, b: rawptr) -> c.c_int) -> ?rawptr
}

libm :: foreign "m" {
    cbrt :: fn(x: f64) -> f64 \ {}
    hypot :: fn(x, y: f64) -> f64 \ {}
    fmodf :: fn(x, y: f32) -> f32 \ {}
}

cmp_u32 :: fn(a, b: rawptr) -> c.c_int {
    x := a.cast(^const u32)^
    y := b.cast(^const u32)^
    return if x < y { -1 } else if x > y { 1 } else { 0 }
}

main :: fn() \ {Out, Sys} {
    d := libc.ldiv(1_000_000_000_007, 1000)
    print("{} {}\n", (d.quot, d.rem))
    print("{} {}\n", (libc.strtod(c"3.25e2xyz", null), libc.atoi(c"  -42abc")))
    print("{}\n", libc.getenv(c"GAMMA_SURELY_NOT_SET_12345") is null)
    src := [4]u8(1, 2, 3, 4)
    dst := [4]u8(fill: 0)
    _ = libc.memcpy(&dst, &src, 4)
    print("{}\n", dst)
    t: c.c_long = 86400 * 365
    tm := Tm(sec: 0, min: 0, hour: 0, mday: 0, mon: 0, year: 0, wday: 0, yday: 0, isdst: 0, gmtoff: 0, zone: null)
    if p := libc.gmtime_r(&t, &tm) {
        print("{}-{}-{} wday {} yday {}\n", (1900 + p.year, p.mon + 1, p.mday, p.wday, p.yday))
    }
    hay := c"hello world"
    if hit := libc.strchr(hay, 119) {
        print("found at offset {}\n", hit.addr() - hay.addr())
    }
    print("{} {}\n", (libm.hypot(3.0, 4.0), libm.fmodf(7.5, 2.0)))
    sorted := [_]u32(2, 4, 8, 16, 32)
    key: u32 = 16
    if p := libc.bsearch(&key, &sorted, sorted.len, @size_of(u32), cmp_u32) {
        print("bsearch hit {}\n", p.cast(^u32)^)
    }
    key = 5
    print("bsearch miss {}\n", libc.bsearch(&key, &sorted, sorted.len, @size_of(u32), cmp_u32) is null)
}
