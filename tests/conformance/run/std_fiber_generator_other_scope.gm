//! exit: 134
// A generator belongs to the `pull` that started it: asking for its next value from a `pull`
// nested inside that one traps.
gen :: import "std/fiber/generator"

count :: fn(n: ^u32) needs Yield(u32) + Out {
    for i in 0..n^ { yield(i) }
}

main :: fn() needs Out {
    n := u32(5)
    st: [32768]u8 = ---
    main_stack: [32768]u8 = ---
    inner_stack: [32768]u8 = ---
    g := gen.generator(count, &n, st[..])
    gen.pull(main_stack[..], fn() {
        print("outer: {}\n", g.next())
        gen.pull(inner_stack[..], fn() => print("inner: {}\n", g.next()))
    })
    print("never printed\n")
}
