// Generic structs and unions (§16.4) and methods on them (§7.10).
Pair :: struct(T: type) { a, b: T }

Tree :: union(T: type) {
    Leaf: T
    Node: (left: ^const Tree(T), right: ^const Tree(T))
}

Stack :: struct(T: type) {
    items: [8]T
    len: usize
}

swap :: fn(T: type, p: Pair(T)) -> Pair(T) => Pair(T)(a: p.b, b: p.a)

larger :: fn(T: type, p: ^const Pair(T)) -> T where Ord(T) => if p.a > p.b { p.a } else { p.b }

push :: fn(T: type, s: ^Stack(T), x: T) -> bool {
    if s.len is s.items.len { return false }
    s.items[s.len] = x
    s.len += 1
    return true
}

pop :: fn(T: type, s: ^Stack(T)) -> ?T {
    if s.len is 0 { return null }
    s.len -= 1
    return s.items[s.len]
}

sum :: fn(T: type, t: ^const Tree(T)) -> T where Num(T) => match t^ {
    .Leaf(v)           => v
    .Node(left, right) => sum(left) + sum(right)
}

main :: fn() needs Out {
    p := Pair(i32)(a: 1, b: 2)
    print("{} {}\n", swap(p), p.larger())
    q := Pair(string)(a: "x", b: "y")
    print("{}\n", swap(q))
    s := Stack(u8)(items: [8]u8(fill: 0), len: 0)
    _ = s.push(7)
    _ = s.push(9)
    print("{} {} {}\n", s.pop(), s.pop(), s.pop())
    l1 := Tree(f64).Leaf(1.5)
    l2 := Tree(f64).Leaf(2)
    n := Tree(f64).Node(left: &l1, right: &l2)
    print("{}\n", sum(&n))
}
