// Named effect sets (§12.3): spliced into effect sets with `..`, aliased, imported, and
// given as the argument of an effect-set parameter (§16.6).
fx :: import "../fx"
fiber :: import "std/fiber"

Io :: fx.Console
Wider :: fx.Timed + Rand

greet :: fn(name: string) needs Io {
    l := list(u8)
    defer l.deinit()
    l.write("hi {}", name) else return
    print("{}\n", string(l.items))
}

later :: fn() needs Wider {
    _ = Clock.now()
    greet("later")
}

apply :: fn(E: effects, f: ^fn(s: string) needs E, s: string) needs E => f(s)

main :: fn() needs Io + Clock + Rand {
    greet("ada")
    later()
    apply(greet, "a pointer")
    s := fiber.scheduler(Io)
    s.deinit()
}
