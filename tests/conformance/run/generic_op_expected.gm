// A perform of a generic effect checks its arguments against the one available
// instantiation (§12.1), so shorthand variants and literals take their types from it.
Events :: effect(E: type) { emit: fn(e: E) }
Event :: union { Opened: (id: u32, owner: string), Closed: u32 }
open_account :: fn(id: u32) needs Events(Event) {
    Events.emit(.Opened(id: id, owner: "ada"))
    Events.emit(.Closed(id))
}
Nums :: effect(T: type) { put: fn(x: T) }
nums :: fn() needs Nums(u8) {
    Nums.put(200)
}
main :: fn() needs Out {
    n: u32 = 0
    with (handler Events(Event) {
        emit(e) => {
            n += 1
            print("{}\n", e)
        }
    }) {
        open_account(7)
    }
    with (handler Nums(u8) { put(x) => print("{}\n", x) }) { nums() }
    print("{}\n", n)
}
