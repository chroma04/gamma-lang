// The right side of `is` is a value unless it is a pattern form (§7.6): a method call on
// a value is a value, while `T.V(_)` on a union type is a pattern test.
main :: fn() \ {Out} {
    x: u8 = 3
    t: u32 = 259
    print("{} {} {}\n", (x is t.trunc(u8), x is (t + 0).trunc(u8), x is u8(3)))
    s: Shape = .Circle(2.0)
    print("{} {}\n", (s is Shape.Circle(_), s is .Rect(_, _)))
}

Shape :: union { Circle: f64, Rect: (w: f64, h: f64) }
