// Control flow inside the body of a `with … on`, which runs on a fiber: a `return`,
// a `break` or `continue` to a loop outside the `with`, `try`, deferred statements on
// both sides, a value of the body, and a nested `with … on`. Also `get`, `first` and
// `last` of array values.
Gen :: effect { emit: ctl(n: i32) }
E :: union { Bad: i32 }

check :: fn(n: i32) -> E!i32 {
    if n > 2 { return !.Bad(n) }
    return n
}

// Runs a body that emits values, printing each; the body's own flow decides how it ends.
from_body :: fn(limit: i32) -> E!i32 needs Out {
    stack: [65536]u8 = ---
    defer print("from_body {} done\n", limit)
    errdefer print("from_body {} failed\n", limit)
    seen := 0
    r := with (handler Gen {
        emit(n, k) => {
            seen += 1
            print("  emit {}\n", n)
            resume k()
        }
    }) on stack[..] {
        defer print("  body left\n")
        i := 0
        while true {
            Gen.emit(i)
            if i is limit { return i * 100 }
            v := try check(i)
            i += v + 1
            if i > 5 { break }
        }
        i
    }
    print("  seen {}, value {}\n", seen, r)
    return r
}

// `break` and `continue` from a fiber body to a loop of the driver.
loops :: fn() needs Out {
    stack: [65536]u8 = ---
    total := 0
    outer: for round in 0..4 {
        with (handler Gen {
            emit(n, k) => {
                total += n
                resume k()
            }
        }) on stack[..] {
            defer print("  round {} body left\n", round)
            Gen.emit(round)
            if round is 1 { continue outer }
            if round is 3 { break outer }
            Gen.emit(10)
        }
        print("round {} completed, total {}\n", round, total)
    }
    print("total {}\n", total)
}

// A `with … on` inside the body of another.
nested :: fn() -> i32 needs Out {
    a: [65536]u8 = ---
    b: [65536]u8 = ---
    sum := 0
    with (handler Gen {
        emit(n, k) => {
            sum += n
            resume k()
        }
    }) on a[..] {
        x := 5
        with (handler Gen {
            emit(n, k) => {
                Gen.emit(n * x)
                resume k()
            }
        }) on b[..] {
            Gen.emit(1)
            Gen.emit(2)
        }
        Gen.emit(100)
    }
    return sum
}

arr :: fn(k: i32) -> [4]i32 {
    return [_]i32(k, k + 1, k + 2, k + 3)
}

main :: fn() needs Out {
    print("{}\n", from_body(1))
    print("{}\n", from_body(10))
    loops()
    print("nested {}\n", nested())
    a := arr(7).get(2) else -1
    b := arr(7).get(9) else -1
    c := arr(1).first() else -1
    d := arr(1).last() else -1
    print("{} {} {} {}\n", a, b, c, d)
}
