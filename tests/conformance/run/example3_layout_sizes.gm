// Layout guarantees: sizes, alignments and offsets of nested, packed, aligned, empty and wide-integer types, tuples, optionals and bit structs.
Inner :: struct { a: u8, b: u16 }
Outer :: struct { x: u8, in_: Inner, y: u64, z: [3]u16 }
PInner :: #packed struct { a: u8, b: u16 }
POuter :: #packed struct { x: u8, in_: PInner, y: u64, z: [3]u16 }
AP :: #packed #align(4) struct { a: u8, b: u32 }
Color :: union(u8) { Red = 1, Green = 5, Blue = 200 }
Tagged :: union { A: u8, B: u64, C }
Empty :: struct {}
Z :: struct { a: u8, e: Empty, b: [0]u32, c: u8 }
Flags :: #bits(u32) struct { a: u7, b: u25 }
WithBits :: struct { f: Flags, g: u8 }
Tup :: (u8, u32, u8)
NamedTup :: (a: u8, b: u64)
Big :: struct { x: u128, y: u8 }
Mixed :: struct { a: u8, b: i128, c: u256 }

main :: fn() \ {Out} {
    print("Outer {} {} offsets {} {} {} {}\n", (@size_of(Outer), @align_of(Outer), @offset_of(Outer, x), @offset_of(Outer, in_), @offset_of(Outer, y), @offset_of(Outer, z)))
    print("POuter {} {} offsets {} {} {} {}\n", (@size_of(POuter), @align_of(POuter), @offset_of(POuter, x), @offset_of(POuter, in_), @offset_of(POuter, y), @offset_of(POuter, z)))
    print("AP {} {}\n", (@size_of(AP), @align_of(AP)))
    print("Color {} {}\n", (@size_of(Color), @align_of(Color)))
    print("Tagged {} {}\n", (@size_of(Tagged), @align_of(Tagged)))
    print("Empty {} Z {} {} offs {}\n", (@size_of(Empty), @size_of(Z), @align_of(Z), @offset_of(Z, c)))
    print("Flags {} WithBits {} {}\n", (@size_of(Flags), @size_of(WithBits), @offset_of(WithBits, g)))
    print("Tup {} {} Named {} {}\n", (@size_of(Tup), @align_of(Tup), @size_of(NamedTup), @align_of(NamedTup)))
    print("Big {} {} Mixed {} {} offs {}\n", (@size_of(Big), @align_of(Big), @size_of(Mixed), @align_of(Mixed), @offset_of(Mixed, c)))
    print("{} {} {} {}\n", (@size_of(?u32), @size_of(?^u8), @size_of(string), @size_of([]u8)))
    print("{} {} {}\n", (@size_of(u3), @size_of(u24), @size_of(u200)))
    print("{} {} {}\n", (@size_of(rawptr), @size_of(cstring), @size_of([^]u8)))
    print("{}\n", @size_of([5]Inner))
    print("{} {}\n", (@size_of(bool), @size_of(f32)))
    print("{} {}\n", (@size_of(Allocator), @size_of(AllocVtable)))
}
