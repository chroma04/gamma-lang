// A named collection: values get small integer ids and can be found by name.
pub Registry :: struct(T: type) {
    items: List(T)
    names: HashMap(string, u16)
}

pub registry :: fn(T: type) -> Registry(T) \ {Alloc} {
    return Registry(T)(items: list(T), names: map(string, u16))
}

pub deinit :: fn(T: type, r: ^Registry(T)) {
    r.items.deinit()
    r.names.deinit()
}

/// Adds `v` under `name` and returns its id; adding a name twice traps.
pub add :: fn(T: type, r: ^Registry(T), name: string, v: T) -> AllocError!u16 {
    if r.names.contains(name) { trap("duplicate registry name") }
    id := r.items.items.len.trunc(u16)
    try r.items.push(v)
    try r.names.put(name, id)
    return id
}

pub find :: fn(T: type, r: ^const Registry(T), name: string) -> ?u16 => r.names.get(name)

pub get :: fn(T: type, r: ^Registry(T), id: u16) -> ?^T {
    if usize(id) >= r.items.items.len { return null }
    return &r.items.items[id]
}

pub view :: fn(T: type, r: ^const Registry(T), id: u16) -> ?^const T {
    if usize(id) >= r.items.items.len { return null }
    return &r.items.items[id]
}

pub len :: fn(T: type, r: ^const Registry(T)) -> usize => r.items.items.len
