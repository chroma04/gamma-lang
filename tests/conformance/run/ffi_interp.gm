// Foreign calls the interpreter makes itself: integers of every width, floats, pointers into Gamma buffers, out-pointers, a variadic function, struct results, and callbacks.
c :: import "std/c"

DivT :: struct {
    quot: c.c_int
    rem: c.c_int
}

libc :: foreign "c" {
    strlen :: fn(s: cstring) -> usize \ {}
    abs :: fn(x: c.c_int) -> c.c_int \ {}
    labs :: fn(x: c.c_long) -> c.c_long \ {}
    memcpy :: fn(dst: rawptr, src: rawptr, n: usize) -> rawptr \ {}
    memset :: fn(p: rawptr, v: c.c_int, n: usize) -> rawptr \ {}
    memcmp :: fn(a: rawptr, b: rawptr, n: usize) -> c.c_int \ {}
    snprintf :: fn(buf: [^]u8, n: usize, fmt: cstring, ...) -> c.c_int
    strtol :: fn(s: cstring, end: ?^cstring, base: c.c_int) -> c.c_long \ {}
    strchr :: fn(s: cstring, ch: c.c_int) -> ?cstring \ {}
    toupper :: fn(ch: c.c_int) -> c.c_int \ {}
    div :: fn(n, d: c.c_int) -> DivT \ {}
    qsort :: fn(base: rawptr, n, size: usize, cmp: ^fn(a, b: rawptr) -> c.c_int \ {Sys}) \ {Sys}
    bsearch :: fn(key: rawptr, base: rawptr, n, size: usize, cmp: ^fn(a, b: rawptr) -> c.c_int \ {Sys}) -> ?rawptr \ {Sys}
}

libm :: foreign "m" {
    sqrt :: fn(x: f64) -> f64 \ {}
    pow :: fn(x, y: f64) -> f64 \ {}
    sqrtf :: fn(x: f32) -> f32 \ {}
    floor :: fn(x: f64) -> f64 \ {}
}

#global calls: u32 = 0

cmp_i32 :: fn(a, b: rawptr) -> c.c_int \ {Sys} {
    calls += 1
    x := a.cast(^const i32)^
    y := b.cast(^const i32)^
    return if x < y { -1 } else if x > y { 1 } else { 0 }
}

Rec :: struct { key: i32, weight: f64 }

cmp_rec :: fn(a, b: rawptr) -> c.c_int \ {Sys} {
    x := a.cast(^const Rec)
    y := b.cast(^const Rec)
    return if x.weight < y.weight { 1 } else if x.weight > y.weight { -1 } else { 0 }
}

main :: fn() \ {Out, Sys} {
    // Scalars and strings.
    print("{} {} {}\n", (libc.strlen(c"hello"), libc.abs(-12), libc.labs(-5_000_000_000)))
    print("{} {} {} {}\n", (libm.sqrt(2.0), libm.pow(2.0, 10.0), libm.sqrtf(2.25), libm.floor(-1.5)))
    print("{}\n", libc.toupper(c.c_int('q')))

    // Memory: C reads and writes Gamma's buffers.
    src := [8]u8(1, 2, 3, 4, 5, 6, 7, 8)
    dst := [8]u8(fill: 0)
    _ = libc.memcpy(&dst, &src, 8)
    print("{} {}\n", (dst, libc.memcmp(&dst, &src, 8)))
    _ = libc.memset(&dst, 7, 3)
    print("{}\n", dst)
    halves: [8]u8 = ---
    _ = libc.memcpy(&halves, &dst, 4)
    _ = libc.memcpy(halves[4..].ptr, &src, 4)
    print("{}\n", halves)

    // A variadic function with integers, a double and a string.
    buf: [64]u8 = ---
    n: c.c_int = 77
    w := libc.snprintf(buf[..].ptr, buf.len, c"n=%d x=%.2f s=%s l=%ld", n, 3.5, c"str", c.c_long(-9))
    wn := w.checked(usize) else trap("negative")
    print("{} {}\n", (w, buf[0..wn]))

    // An out-pointer to a pointer into a Gamma string; a returned pointer into it.
    text := c"1234xyz"
    end: cstring = c""
    v := libc.strtol(text, &end, 10)
    print("{} rest {} at {}\n", (v, libc.strlen(end), end.addr() - text.addr()))
    if hit := libc.strchr(text, 'x') {
        print("x at {}\n", hit.addr() - text.addr())
    }
    print("{}\n", libc.strchr(text, 'q') is null)

    // A struct result.
    d := libc.div(17, 5)
    print("{} {}\n", (d.quot, d.rem))

    // Callbacks: C calls Gamma comparators on Gamma's arrays.
    nums := [_]i32(42, -7, 19, 0, 100, 3, -50, 8)
    libc.qsort(&nums, nums.len, @size_of(i32), cmp_i32)
    print("{}\n", nums)
    print("callbacks ran: {}\n", calls > 0)
    key: i32 = 19
    if p := libc.bsearch(&key, &nums, nums.len, @size_of(i32), cmp_i32) {
        print("found {} at {}\n", (p.cast(^i32)^, (p.addr() - (&nums).addr()) / 4))
    }
    recs := [_]Rec(Rec(key: 1, weight: 2.5), Rec(key: 2, weight: 9.0), Rec(key: 3, weight: 0.5))
    libc.qsort(&recs, recs.len, @size_of(Rec), cmp_rec)
    for r in recs { print("{} {}\n", (r.key, r.weight)) }
}
