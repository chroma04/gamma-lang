// process.output_within and process.watch: a time limit on a program, input fed on a thread,
// the whole process group killed.
//! os: unix
//! native: the interpreter hangs when one thread reads a child's output while another writes its input
process :: import "std/process"

sh :: fn(script: string) -> [3]string => [_]string("sh", "-c", script)

/// The next chunk of output, or null at the end (or on an error).
next :: fn(c: process.Child, buf: []u8) -> ?process.Chunk needs Proc {
    r := Proc.read(c, buf) else e => return null
    return r
}

main :: fn() needs Out + Proc + Alloc + Clock + Sys {
    limit := Duration(ns: 10_000_000_000)

    // A program that finishes in time.
    o := process.output_within(sh("echo out; echo err >&2; exit 3"), limit) else e => {
        print("failed: {}\n", e)
        return
    }
    print("{} timed out {} [{}] [{}]\n", o.status, o.timed_out, string(o.out.items), string(o.err.items))
    o.deinit()

    // Input is fed and closed; much of it, and much output, at once.
    big := make_fill(400000, u8('x')) else return
    c := process.output_within([_]string("cat"), limit, input: big) else e => {
        print("cat failed: {}\n", e)
        return
    }
    print("cat: {} {} {}\n", c.status, c.out.items.len, c.timed_out)
    c.deinit()

    // A program that outlives the limit is killed, with what it started: the grandchild holds
    // the pipes open, so the call returns only once it is gone.
    short := Duration(ns: 200_000_000)
    k := process.output_within(sh("echo started; sleep 30 & sleep 30; wait"), short, process.SpawnOptions(group: true)) else e => {
        print("sleep failed: {}\n", e)
        return
    }
    print("{} timed out {} [{}]\n", k.status, k.timed_out, string(k.out.items))
    k.deinit()

    // A program that cannot be started.
    _ = process.output_within([_]string("no-such-program-for-gamma-tests"), limit) else e => {
        print("missing program: {}\n", e)
        process.Output(status: .Exited(0), out: list(u8), err: list(u8))
    }

    // A watchdog on a child that is driven by hand.
    child := Proc.spawn([_]string("sleep", "30"), process.SpawnOptions(stdout: .Pipe)) else e => {
        print("spawn failed: {}\n", e)
        return
    }
    w := process.watch(child, short) else e => {
        print("watch failed: {}\n", e)
        return
    }
    buf: [8]u8 = ---
    print("watchdog read ends: {}\n", next(child, buf[..]) is null)
    fired := w.disarm()
    print("killed {}: {}\n", fired, child.wait() else e => process.ExitStatus.Exited(99))

    // Disarmed in time: nothing is killed.
    quick := Proc.spawn([_]string("true"), process.SpawnOptions()) else e => return
    w2 := process.watch(quick, limit) else e => return
    print("ended: {}\n", quick.wait() else e => process.ExitStatus.Exited(99))
    print("fired: {}\n", w2.disarm())
}
