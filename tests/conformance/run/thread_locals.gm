//! needs: threads
// `#global #thread_local` storage is per thread (§19.3, §19.6); a plain `#global` is
// shared.
thread :: import "std/thread"

#global #thread_local mine: u32 = 10
#global shared: u32 = 0

bump :: fn(arg: ^u32) needs Sys {
    for i in 0..5 { mine += 1 }
    _ = @atomic_add(&shared, mine, .Relaxed)
}

main :: fn() -> IoError!() needs Out + Sys {
    mine = 100
    a := try thread.spawn(T: u32, bump, &shared)
    b := try thread.spawn(T: u32, bump, &shared)
    a.join()
    b.join()
    print("main's copy {}, shared {}\n", mine, shared)
}
