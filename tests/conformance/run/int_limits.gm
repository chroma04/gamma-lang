// @min_value(T) and @max_value(T) give the range of an integer type (§20.3), also for a
// type parameter with Int(T), where each instantiation decides them.
span_of :: fn(T: type) -> (T, T) where Int(T) => (@min_value(T), @max_value(T))
clamp_add :: fn(T: type, a, b: T) -> T where Int(T) => a +? b else @max_value(T)
main :: fn() \ {Out} {
    print("{} {}\n", (@min_value(i8), @max_value(i8)))
    print("{} {}\n", (@max_value(u64), @min_value(i128)))
    print("{} {}\n", (@max_value(u3), @min_value(i5)))
    print("{} {}\n", (span_of(u16), span_of(i32)))
    print("{}\n", clamp_add(T: u8, 200, 100))
    x: usize = @max_value(usize)
    print("{}\n", x)
    LIM :: @max_value(u16)
    print("{}\n", LIM)
}
