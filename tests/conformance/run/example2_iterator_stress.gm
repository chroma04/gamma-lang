// Iterator specialization stress: recursive iterators, iterators of iterators, break values, defers in iterators, second-class iterator arguments, nested labeled loops.
count :: fn(n: u32) \ {Yield(u32)} {
    for i in 0..n { yield(i) }
}

pairs :: fn(n: u32) \ {Yield((u32, u32))} {
    for i in count(n) {
        for j in count(i) { yield((i, j)) }
    }
}

tri :: fn(d: u32) \ {Yield(u32)} {
    if d is 0 { yield(0); return }
    yield(d)
    tri(d - 1)
    yield(d)
}

search :: fn(n: u32, target: u32) -> ?u32 \ {Yield(u32), Out} {
    defer print("(search done)\n")
    for x in count(n) {
        yield(x)
        if x is target { return x }
    }
    return null
}

run_with :: fn(body: fn(u32)) {
    for i in count(3) { body(i) }
}

twice :: fn(f: fn() \ {Yield(u32)}) \ {Yield(u32)} {
    for x in f() { yield(x) }
    for x in f() { yield(x + 100) }
}

main :: fn() \ {Out} {
    acc := 0
    for i in count(4) { acc = acc * 10 + i.trunc(i32) }
    print("{}\n", acc)
    for a, b in pairs(4) { print("({},{}) ", (a, b)) }
    print("\n")
    for x in tri(3) { print("{} ", x) }
    print("\n")
    r := for x in search(10, 3) { if x is 2 { print("two\n") } }
    print("{}\n", r)
    seen := 0
    r2 := for x in search(10, 3) { seen += 1; if x > 100 { break 99 } }
    print("{} {}\n", (r2, seen))
    r3 := for x in search(2, 7) { _ = x }
    print("{}\n", r3)
    total := 0
    run_with(fn(i) { total += i.trunc(i32) * 2 })
    print("{}\n", total)
    cc :: fn() \ {Yield(u32)} { count(2) }
    for x in twice(cc) { print("{} ", x) }
    print("\n")
    // same iterator, two different loop bodies in one function
    s1 := 0
    s2 := 0
    for x in count(5) { s1 += x.trunc(i32) }
    for x in count(5) { s2 += x.trunc(i32) * x.trunc(i32) }
    print("{} {}\n", (s1, s2))
    // nested loops over same iterator and labeled continue/break
    out: for x in count(5) {
        for y in count(5) {
            if y > x { continue out }
            if x + y > 6 { break out }
            print("{}{} ", (x, y))
        }
    }
    print("\n")
    // loop in a loop condition
    k := 0
    while k < 3 {
        for x in count(3) { if x is k { print("[{}]", x) } }
        k += 1
    }
    print("\n")
}
