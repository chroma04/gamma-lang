// std/text: grapheme clusters, with the byte length of each.
text :: import "std/text"

show :: fn(s: string) \ {Out} {
    for g in text.graphemes(s) { print("[{} {}]", (g, g.len)) }
    print("\n")
}

lens :: fn(s: string) \ {Out} {
    for g in text.graphemes(s) { print("{} ", g.len) }
    print("\n")
}

main :: fn() \ {Out} {
    print("Unicode {}\n", text.UNICODE_VERSION)
    show("ae\u{301}o") // a combining accent joins its base
    show("🇫🇷🇩🇪🇮") // regional indicators pair up; a lone one is its own cluster
    show("👨\u{200d}👩\u{200d}👧!") // a ZWJ emoji sequence
    show("👍🏽x") // an emoji modifier
    lens("a\r\nb\n\r") // \r\n is one cluster; \n\r is two
    show("\u{1100}\u{1161}\u{11a8}\u{ac00}\u{11a8}") // Hangul jamo and a syllable
    show("\u{915}\u{94d}\u{937}\u{93f}") // a Devanagari conjunct (GB9c)
    show("\u{600}1") // a prepended concatenation mark
    lens("a\xffb\xe2\x82\u{301}") // ill-formed bytes come back as they are
    show("")
    print("{} {} {}\n", (text.grapheme_len(""), text.grapheme_len("e\u{301}x"), text.grapheme_len("\r\n")))
    n: usize = 0
    for _ in text.graphemes("नमस्ते") { n += 1 }
    print("{}\n", n)
}
