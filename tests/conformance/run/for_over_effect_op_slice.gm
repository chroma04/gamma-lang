// `for` iterates over the slice or array returned by a call of an effect operation, as it
// does over one returned by an ordinary function.
Names :: effect {
    all: fn() -> []const string
    pair: fn() -> [2]u32
}

NAMES :: [_]string("ann", "bob", "cy")

Fixed :: struct { calls: u32 = 0 }

handler Names for ^Fixed {
    all(self) => {
        self.calls += 1
        NAMES[..]
    }
    pair(self) => {
        self.calls += 1
        [_]u32(10, 20)
    }
}

main :: fn() needs Out + Env {
    n: usize = 0
    for _ in Env.args() { n += 1 }
    print("args {}\n", (n is Env.args().len))

    f := Fixed()
    with &f {
        for name in all() { print("[{}]\n", name) }
        total: u32 = 0
        for v in pair() { total += v }
        print("{} calls {}\n", total, f.calls)
    }
}
