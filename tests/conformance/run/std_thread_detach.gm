// A detached thread is never joined. Its work is observed through shared state, and one
// that is still running when `main` returns is stopped with the process.
thread :: import "std/thread"

Job :: struct {
    wg: thread.WaitGroup
    sum: u64
}

work :: fn(j: ^Job) \ {Sys} {
    for i in 1..11 { _ = @atomic_add(&j.sum, i, .Relaxed) }
    j.wg.done()
}

// Never finishes on its own.
forever :: fn(j: ^Job) \ {Sys} {
    while true { thread.yield_now() }
}

main :: fn() -> IoError!() \ {Out, Sys} {
    j := Job(wg: thread.wait_group(), sum: 0)
    j.wg.add(8)
    for i in 0..8 {
        t := try thread.spawn(work, &j)
        thread.detach(t)
    }
    j.wg.wait()
    print("detached threads added up to {}\n", j.sum)

    // Detach right after spawning, as often as a table slot gets reused.
    k := Job(wg: thread.wait_group(), sum: 0)
    for round in 0..50 {
        k.wg.add(1)
        thread.detach(try thread.spawn(work, &k))
        k.wg.wait()
    }
    print("after 50 rounds: {}\n", k.sum)

    // Joined and detached threads together.
    m := Job(wg: thread.wait_group(), sum: 0)
    m.wg.add(2)
    a := try thread.spawn(work, &m)
    b := try thread.spawn(work, &m)
    thread.detach(a)
    b.join()
    m.wg.wait()
    print("mixed: {}\n", m.sum)

    // This one is still running when main returns.
    thread.detach(try thread.spawn(forever, &m))
    print("main returns\n")
}
