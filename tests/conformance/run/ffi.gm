// Foreign functions, variadics, callbacks, #link_name and #global (§19).
c :: import "std/c"
libc :: foreign "c" {
    puts :: fn(s: cstring) -> c.c_int
    strlen :: fn(s: cstring) -> usize \ {}
    printf :: fn(fmt: cstring, ...) -> c.c_int
    qsort :: fn(base: rawptr, n, size: usize, cmp: ^fn(a, b: rawptr) -> c.c_int)
    #link_name("abs") absolute :: fn(x: c.c_int) -> c.c_int
}

#global counter: u32 = 10

by_value :: fn(a, b: rawptr) -> c.c_int {
    x := a.cast(^i32)^
    y := b.cast(^i32)^
    return if x < y { -1 } else if x > y { 1 } else { 0 }
}

bump :: fn() -> u32 \ {Sys} {
    counter += 1
    return counter
}

main :: fn() \ {Out, Sys} {
    _ = libc.puts(c"hello from C")
    print("{}\n", libc.strlen(c"four"))
    _ = libc.printf(c"%d %s %.2f\n", c.c_int(42), c"str", 2.5)
    xs := [5]i32(5, 3, 9, 1, 4)
    libc.qsort(&xs, 5, @size_of(i32), by_value)
    print("{}\n", xs)
    print("{} {}\n", bump(), bump())
    print("{}\n", libc.absolute(-7))
}
