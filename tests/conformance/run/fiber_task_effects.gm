// Fiber tasks that perform effects besides `Sched`: the scheduler's effect-set parameter
// (§16.6) lists them, and they are handled where the scheduler is installed.
fiber :: import "std/fiber"

Tick :: effect {
    tick: fn(name: string)
}

Job :: struct {
    name: string
    rounds: u32
}

// Prints as it goes: `Out` is handled outside the scheduler's `with`.
talker :: fn(j: ^Job) \ {fiber.Sched(Out), Out} {
    defer print("{} done\n", j.name)
    for i in 0..j.rounds {
        print("{} {}\n", j.name, i)
        fiber.yield_now()
    }
}

// Uses only part of what the scheduler allows.
silent :: fn(j: ^Job) \ {fiber.Sched(Out)} {
    for _ in 0..j.rounds {
        fiber.yield_now()
    }
}

// A user effect, with a handler outside the scheduler.
ticker :: fn(j: ^Job) \ {fiber.Sched(\ {Tick, Out}), Tick} {
    for _ in 0..j.rounds {
        tick(j.name)
        fiber.yield_now()
    }
}

talky :: fn(j: ^Job) \ {fiber.Sched(\ {Tick, Out}), Out} {
    print("{} says hi\n", j.name)
}

main :: fn() \ {Out, Alloc} {
    main_stack: [65536]u8 = ---
    sa: [32768]u8 = ---
    sb: [32768]u8 = ---
    sc: [32768]u8 = ---

    s := fiber.scheduler(Out)
    defer s.deinit()
    a := Job(name: "a", rounds: 3)
    b := Job(name: "b", rounds: 2)
    c := Job(name: "c", rounds: 5)
    with &s on main_stack[..] {
        fiber.spawn(talker, &a, sa[..])
        fiber.spawn(talker, &b, sb[..])
        fiber.spawn(silent, &c, sc[..])
        fiber.join()
    }

    ticks: u32 = 0
    t := fiber.scheduler(\ {Tick, Out})
    defer t.deinit()
    x := Job(name: "x", rounds: 2)
    y := Job(name: "y", rounds: 3)
    with (handler Tick { tick(name) => { ticks += 1 } }) {
        with &t on main_stack[..] {
            fiber.spawn(ticker, &x, sa[..])
            fiber.spawn(ticker, &y, sb[..])
            fiber.spawn(talky, &a, sc[..])
            fiber.join()
        }
    }
    print("ticks {}\n", ticks)
}
