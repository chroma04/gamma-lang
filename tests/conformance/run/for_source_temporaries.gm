// Temporaries passed to the iterator of a `for` live for the call, which includes the
// loop (§7.2, §13.2).
M :: struct { a: [4]i32, n: u8 }
mk :: fn(k: i32) -> M { return M(a: [4]i32(k, k + 1, k + 2, k + 3), n: 3) }
walk :: fn(m: ^const M) needs Yield(i32) {
    for i in 0..m.n { yield(m.a[i]) }
}
items :: fn(m: ^const M) needs Yield(i32) { for i in 0..m.n { yield(m.a[i]) } }
mkarr :: fn() -> [3]i32 { return [3]i32(7, 8, 9) }
it :: fn(s: []const i32) needs Yield(i32) { for x in s { yield(x) } }
main :: fn() needs Out {
    for x in each([3]i32(1, 2, 3)) { print("e{} ", x) }
    print("\n")
    for x in reversed(mkarr()) { print("r{} ", x) }
    print("\n")
    for x in walk(&mk(10)) { print("w{} ", x) }
    print("\n")
    for x in it(mkarr()) { print("i{} ", x) }
    print("\n")
    for x in it([3]i32(4, 5, 6)[..]) { print("s{} ", x) }
    print("\n")
    for x in mk(20).items() { print("m{} ", x) }
    print("\n")
}
