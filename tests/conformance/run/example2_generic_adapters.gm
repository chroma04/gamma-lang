// Generic iterator adapters (map, filter, fold) written over second-class iterator parameters, composed with captured locals.
map_it :: fn(T: type, src: fn() needs Yield(T), f: fn(T) -> T) needs Yield(T) {
    for a in src() { yield(f(a)) }
}

filter_it :: fn(T: type, src: fn() needs Yield(T), pred: fn(T) -> bool) needs Yield(T) {
    for x in src() { if pred(x) { yield(x) } }
}

fold :: fn(T, Acc: type, src: fn() needs Yield(T), init: Acc, f: fn(Acc, T) -> Acc) -> Acc {
    acc := init
    for x in src() { acc = f(acc, x) }
    return acc
}

range_it :: fn(lo, hi: i32) needs Yield(i32) {
    for i in lo..hi { yield(i) }
}

main :: fn() needs Out {
    k := 3
    evens :: fn() needs Yield(i32) { filter_it(T: i32, fn() needs Yield(i32) { range_it(0, 20) }, fn(x) => x % 2 is 0) }
    scaled :: fn() needs Yield(i32) { map_it(T: i32, evens, fn(x) => x * k) }
    total := fold(Acc: i32, scaled, 0, fn(a, x) => a + x)
    print("{}\n", total)
    for x in scaled() { print("{} ", x) }
    print("\n")
}
