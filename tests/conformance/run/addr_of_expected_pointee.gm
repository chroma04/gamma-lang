// The operand of `&` is checked with the expected pointee type, so a variant takes its
// union from it (§7.2).
Shape :: union { Circle: f64, Square: f64 }

area :: fn(s: ^const Shape) -> f64 => match s^ {
    .Circle(r) => 3.0 * r * r
    .Square(a) => a * a
}

main :: fn() needs Out {
    print("{} {}\n", area(&.Circle(1.0)), area(&.Square(2.0)))
}
