// A `ctl` clause runs as if called by its `with` (§18.3).
Ask :: effect { ask: fn(n: i32) -> i32 }
Gen :: effect { emit: ctl(n: i32) }

check :: fn(n: i32) -> i32 {
    if n > 2 { trap("too big") }
    return n
}

produce :: fn() needs Ask + Gen {
    for i in 0..10 { Gen.emit(Ask.ask(i)) }
}

main :: fn() needs Out {
    stack: [32768]u8 = ---
    with (handler Ask { ask(n) => check(n) }) {
        with (handler Gen {
            emit(n, k) => {
                print("got {}\n", check(n + 1))
                resume k()
            }
        }) on stack[..] {
            produce()
        }
    }
}
