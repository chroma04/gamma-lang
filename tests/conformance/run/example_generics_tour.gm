Either :: union(L, R: type) {
    Left: L
    Right: R
}

Stack :: struct(T: type, N: usize) {
    items: [N]T
    len: usize = 0
}

stack :: fn(T: type, N :: usize) -> Stack(T, N) where Plain(T) {
    return Stack(T, N)(items: ---)
}

push :: fn(T: type, N :: usize, s: ^Stack(T, N), x: T) -> bool {
    if s.len is N { return false }
    s.items[s.len] = x
    s.len += 1
    return true
}

pop :: fn(T: type, N :: usize, s: ^Stack(T, N)) -> ?T {
    if s.len is 0 { return null }
    s.len -= 1
    return s.items[s.len]
}

partition :: fn(T, L, R: type, xs: []const T, f: fn(T) -> Either(L, R), lefts: []L, rights: []R) -> (usize, usize) {
    nl: usize = 0
    nr: usize = 0
    for x in xs {
        match f(x) {
            .Left(l) => { lefts[nl] = l; nl += 1 }
            .Right(r) => { rights[nr] = r; nr += 1 }
        }
    }
    return (nl, nr)
}

compose :: fn(A, B, C: type, f: fn(A) -> B, g: fn(B) -> C, x: A) -> C => g(f(x))

twice :: fn(T: type, f: fn(T) -> T, x: T) -> T => f(f(x))

apply_n :: fn(T: type, f: fn(T) -> T, n: u32, x: T) -> T {
    r := x
    for _ in 0..n { r = f(r) }
    return r
}

nested :: fn(base: i32) -> i32 {
    add := base
    return twice(T: i32, fn(v) => apply_n(fn(w) => w + add, 3, v), 1)
}

Wrapper :: struct(T: type) {
    value: T
    tag: u8 = 7
}

wrap :: fn(T: type, v: T) -> Wrapper(T) => Wrapper(T)(value: v)

main :: fn() needs Out {
    s := stack(i32, 3)
    print("{} {} {} {}\n", push(&s, 1), push(&s, 2), push(&s, 3), push(&s, 4))
    while v := pop(&s) { print("{} ", v) }
    print("\n")
    s2 := stack(u8, 2)
    _ = push(&s2, 200)
    print("{} {}\n", s2.len, @size_of(Stack(u8, 2)))

    xs := [_]i32(1, -2, 3, -4, 5, 6)
    ls: [6]i32 = ---
    rs: [6]string = [6]string(fill: "")
    n := partition(xs[..], fn(x) => if x > 0 { Either(i32, string).Left(x * 10) } else { Either(i32, string).Right("neg") }, ls[..], rs[..])
    print("{} {} {} {}\n", n, ls[0..n.0], rs[0..n.1], @type_name(Either(i32, string)))

    r := compose(A: i32, B: i64, C: string, fn(x) => i64(x) * 1000000, fn(y) => if y > 5000000 { "big" } else { "small" }, 7)
    print("{} {}\n", r, nested(10))
    w := wrap(wrap(i32(3)))
    print("{} {}\n", w, w.value.value)
    e: Either(u8, ?string) = .Right(null)
    print("{}\n", e)
}
