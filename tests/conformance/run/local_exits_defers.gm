// Exits whose target is in the same function (break, continue, return, try, a
// break out of a `with`) run exactly the defers they cross; errdefers run only
// when an error is returned.
E :: union { Bad: i32 }

loops :: fn() needs Out {
    outer: for i in 0..3 {
        defer print("end outer {}\n", i)
        for j in 0..3 {
            defer print("  end inner {} {}\n", i, j)
            errdefer print("  never\n")
            if j is 1 { continue }
            if i is 1 { continue outer }
            if i is 2 and j is 2 { break outer }
            print("  body {} {}\n", i, j)
        }
    }
    n := 0
    while true {
        defer n += 1
        if n is 2 { break }
    }
    print("n = {}\n", n)
}

check :: fn(x: i32) -> E!i32 needs Out {
    defer print("check {} done\n", x)
    errdefer print("check {} failed\n", x)
    if x < 0 { return !.Bad(x) }
    return x * 2
}

twice :: fn(x: i32) -> E!i32 needs Out {
    defer print("twice {} done\n", x)
    errdefer print("twice {} failed\n", x)
    {
        defer print("inner block\n")
        a := try check(x)
        return a + 1
    }
}

first_even :: fn(xs: []const i32) -> ?i32 needs Out {
    defer print("search over\n")
    for x in xs {
        defer print("saw {}\n", x)
        if x % 2 is 0 { return x }
    }
    return null
}

E2 :: effect { stop: esc(code: i32) -> never }

with_break :: fn() -> i32 needs Out {
    r := label: with (handler E2 { stop(code) => break code * 10 }) {
        defer print("with body left\n")
        for i in 0..10 {
            defer print("iteration {} left\n", i)
            if i is 1 { break label 7 }
        }
        0
    }
    return r
}

main :: fn() needs Out {
    loops()
    print("{}\n", twice(4))
    print("{}\n", twice(-3))
    xs := [4]i32(1, 3, 6, 8)
    print("{}\n", first_even(xs[..]))
    print("{}\n", with_break())
}
