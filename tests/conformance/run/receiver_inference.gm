// A method's receiver fixes its type parameters, and the other arguments coerce to
// them (§16.2); `T(x)` is a coercion when `x` coerces to `T` (§6.5).
main :: fn() -> AllocError!() \ {Out, Alloc} {
    buf := [5]u8('h', 'e', 'l', 'l', 'o')
    words := list(string)
    defer words.deinit()
    try words.push(buf[..])
    try words.push(buf[1..3])
    counts := map(string, u32)
    defer counts.deinit()
    try counts.put(buf[..2], 7)
    s := string(buf[2..])
    small: u8 = 200
    wide := list(u32)
    defer wide.deinit()
    try wide.push(small)
    print("{} {} {} {} {}\n", words.items[0], words.items[1], counts.get("he"), s, wide.items[0])
    return ()
}
