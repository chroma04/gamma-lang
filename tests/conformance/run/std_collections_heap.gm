// std/collections/heap: ordering, duplicates, custom orderings, bulk construction,
// and a randomized comparison with sorting.
hp :: import "std/collections/heap"

// Prints and removes everything in the order the heap yields it.
drain_i32 :: fn(label: string, pop: fn() -> ?i32) \ {Out} {
    print("{}:", label)
    while x := pop() { print(" {}", x) }
    print("\n")
}

Job :: struct {
    priority: u32
    name: string
}

by_priority :: fn(a, b: ^const Job) -> bool => a.priority > b.priority

greater :: fn(a, b: ^const i32) -> bool => a^ > b^

next_random :: fn(state: ^u64) -> u64 {
    state^ = state^ *% 6364136223846793005 +% 1442695040888963407
    return state^ >> 33
}

main :: fn() -> AllocError!() \ {Out, Alloc} {
    // Empty.
    h := hp.heap(i32)
    defer h.deinit()
    print("empty: len {} is_empty {} peek {} pop {}\n", (h.len(), h.is_empty(), h.peek(), h.pop()))

    // Smallest first, with duplicates.
    for x in [_]i32(5, 3, 9, 1, 3, 7, 1, 1, -4, 3) { try h.push(x) }
    print("len {} peek {} is_empty {}\n", (h.len(), h.peek(), h.is_empty()))
    drain_i32("min-first", fn() -> ?i32 => h.pop())
    print("after drain: len {} peek {}\n", (h.len(), h.peek()))

    // One element, and clear keeps the heap usable.
    try h.push(42)
    print("single: peek {} pop {} pop {}\n", (h.peek(), h.pop(), h.pop()))
    try h.push(2)
    try h.push(1)
    h.clear()
    print("cleared: len {} pop {}\n", (h.len(), h.pop()))
    try h.push(8)
    try h.push(6)
    print("reused: {} {}\n", (h.pop(), h.pop()))

    // Ordering by a function: a max-heap from a named function, and from a literal.
    mx := hp.heap_by(T: i32, greater)
    defer mx.deinit()
    for x in [_]i32(5, 3, 9, 1, 3, 7) { try mx.push(x) }
    drain_i32("max-first", fn() -> ?i32 => mx.pop())
    mx2 := hp.heap_by(T: i32, fn(a, b: ^const i32) -> bool => a^ > b^)
    defer mx2.deinit()
    for x in [_]i32(2, 8, 4) { try mx2.push(x) }
    drain_i32("max-first literal", fn() -> ?i32 => mx2.pop())

    // Structs ordered by a field; equal priorities are all returned.
    jobs := hp.heap_by(T: Job, by_priority)
    defer jobs.deinit()
    try jobs.push(Job(priority: 2, name: "write"))
    try jobs.push(Job(priority: 9, name: "deploy"))
    try jobs.push(Job(priority: 5, name: "test"))
    try jobs.push(Job(priority: 9, name: "hotfix"))
    try jobs.push(Job(priority: 1, name: "relax"))
    if top := jobs.peek() { print("top priority {}\n", top.priority) }
    n9: u32 = 0
    last: u32 = 100
    ordered := true
    while j := jobs.pop() {
        if j.priority is 9 { n9 += 1 }
        if j.priority > last { ordered = false }
        last = j.priority
    }
    print("priority 9 jobs: {}, in order: {}\n", (n9, ordered))

    // Ord on tuples orders lexicographically; floats and unsigned work too.
    pairs := hp.heap((u8, u8))
    defer pairs.deinit()
    for p in [_]((u8, u8))((2, 1), (1, 9), (2, 0), (1, 2)) { try pairs.push(p) }
    print("pairs:")
    while p := pairs.pop() { print(" ({}, {})", (p.0, p.1)) }
    print("\n")
    fs := hp.heap(f64)
    defer fs.deinit()
    for x in [_]f64(2.5, -1.0, 0.5) { try fs.push(x) }
    print("floats: {} {} {}\n", (fs.pop(), fs.pop(), fs.pop()))

    // Bulk construction.
    src := [_]i32(9, 8, 7, 6, 5, 4, 3, 2, 1, 0, 5, 5)
    bulk := try hp.heap_from(src[..])
    defer bulk.deinit()
    print("heap_from: len {} peek {}\n", (bulk.len(), bulk.peek()))
    drain_i32("heap_from", fn() -> ?i32 => bulk.pop())
    bulk_max := try hp.heap_from_by(greater, src[..])
    defer bulk_max.deinit()
    drain_i32("heap_from_by", fn() -> ?i32 => bulk_max.pop())
    none := try hp.heap_from(src[0..0])
    defer none.deinit()
    one := try hp.heap_from(src[0..1])
    defer one.deinit()
    print("bulk of 0: {}, of 1: {}\n", (none.pop(), one.pop()))
    print("source untouched: {}\n", src[0] is 9 and src[11] is 5)

    // Many elements, popped in order, agree with sorting.
    seed: u64 = 99
    values := list(i32)
    defer values.deinit()
    big := hp.heap(i32)
    defer big.deinit()
    for _ in 0..2000 {
        v: i32 = (next_random(&seed) % 1000).trunc(i32) - 500
        try values.push(v)
        try big.push(v)
    }
    values.items.sort()
    bad: u32 = 0
    for v in values.items {
        if big.pop() is not v { bad += 1 }
    }
    print("random: {} out of order, {} left\n", (bad, big.len()))

    // Interleaved pushes and pops.
    mix := hp.heap(i32)
    defer mix.deinit()
    sum: i64 = 0
    for i in 0..300 {
        try mix.push(((i * 37) % 101).trunc(i32))
        if i % 3 is 2 { sum += i64(mix.pop() else 0) }
    }
    print("interleaved: len {} sum {}\n", (mix.len(), sum))
    return ()
}
