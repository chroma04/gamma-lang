// Effects tour: a generic State effect, an escaping Fail effect with unwinding, a Reader
// (environment) effect, handler composition, a stack-machine interpreter written against
// effects, and a resumable "warning" operation implemented with ctl and a fiber.
State :: effect(T: type) {
    get: fn() -> T
    put: esc(x: T)
}

Fail :: effect {
    fail: esc(code: u32, msg: string) -> never
}

Config :: struct {
    scale: i32
    verbose: bool
}

Reader :: effect {
    config: fn() -> Config
}

Trace :: effect {
    say: fn(msg: string)
}

// ---- a stack machine whose memory, errors and tracing are all effects ----------------------

Instr :: union {
    Push: i32
    Add
    Mul
    Neg
    Dup
    Swap
    Pop
    Div
    Jz: usize
    Jmp: usize
    Halt
}

Stack :: struct {
    items: [16]i32 = [16]i32(fill: 0)
    top: usize = 0
}

push :: fn(v: i32) needs State(Stack) + Fail {
    s := get()
    if s.top is s.items.len { fail(1, "stack overflow") }
    s.items[s.top] = v
    s.top += 1
    put(s)
}

pop :: fn() -> i32 needs State(Stack) + Fail {
    s := get()
    if s.top is 0 { fail(2, "stack underflow") }
    s.top -= 1
    put(s)
    return s.items[s.top]
}

run_program :: fn(code: []const Instr) -> i32 needs State(Stack) + Fail + Reader + Trace {
    pc: usize = 0
    steps: u32 = 0
    while pc < code.len {
        steps += 1
        if steps > 100 { fail(3, "step limit exceeded") }
        instr := code[pc]
        pc += 1
        if config().verbose { say("exec") }
        match instr {
            .Push(v) => push(v * config().scale)
            .Add => { b := pop(); a := pop(); push(a + b) }
            .Mul => { b := pop(); a := pop(); push(a * b) }
            .Neg => push(-pop())
            .Dup => { a := pop(); push(a); push(a) }
            .Swap => { b := pop(); a := pop(); push(b); push(a) }
            .Pop => { _ = pop() }
            .Div => {
                b := pop()
                a := pop()
                if b is 0 { fail(4, "division by zero") }
                push(a / b)
            }
            .Jz(t) => { if pop() is 0 { pc = t } }
            .Jmp(t) => { pc = t }
            .Halt => { return pop() }
        }
    }
    return pop()
}

// Handler declarations for concrete types.
Cell :: struct { stack: Stack = Stack() }

handler State(Stack) for ^Cell {
    get(self) => self.stack
    put(self, x) => { self.stack = x }
}

Outcome :: union { Ok: i32, Failed: (code: u32, msg: string) }

execute :: fn(code: []const Instr, cfg: Config, log_steps: ^u32) -> Outcome {
    cell := Cell()
    counter :: handler Trace {
        say(msg) => { log_steps^ += 1 }
    }
    reader :: handler Reader {
        config() => cfg
    }
    failure: ?(code: u32, msg: string) = null
    catcher :: handler Fail {
        fail(c, m) => {
            failure = (code: c, msg: m)
            break -1
        }
    }
    r := with &cell, reader, counter, catcher {
        run_program(code)
    }
    if f := failure { return Outcome.Failed(code: f.code, msg: f.msg) }
    return Outcome.Ok(r)
}

// ---- resumable warnings (ctl): the handler decides to continue or stop ---------------------------

Warn :: effect {
    warn: ctl(msg: string) -> bool      // true: keep going
}

checked_sum :: fn(xs: []const i32, limit: i32) -> i32 needs Warn + Out {
    defer print("  checked_sum finished\n")
    total: i32 = 0
    for x in xs {
        if x > limit {
            if not warn("value over the limit") { return total }
            continue
        }
        total += x
    }
    return total
}

with_warnings :: fn(xs: []const i32, limit: i32, max_warnings: u32) -> i32 needs Out {
    stack: [32768]u8 = ---
    seen: u32 = 0
    r := with (handler Warn {
        warn(msg, k) => {
            seen += 1
            print("  warning #{}: {}\n", seen, msg)
            resume k(seen < max_warnings)
        }
    }) on stack[..] {
        checked_sum(xs, limit)
    }
    return r
}

main :: fn() needs Out {
    cfg := Config(scale: 1, verbose: false)
    steps: u32 = 0

    // (2 + 3) * 4 = 20
    p1 := [_]Instr(.Push(2), .Push(3), .Add, .Push(4), .Mul, .Halt)
    print("{}\n", execute(p1[..], cfg, &steps))

    // scale = 10 multiplies every pushed literal; also counts trace events
    big := Config(scale: 10, verbose: true)
    print("{} (trace events {})\n", execute(p1[..], big, &steps), steps)

    // countdown loop: push 3; loop: dup, jz end, push -1, add, jmp loop; end: halt
    p2 := [_]Instr(.Push(3), .Dup, .Jz(7), .Push(-1), .Add, .Jmp(1), .Halt, .Halt)
    print("{}\n", execute(p2[..], cfg, &steps))

    p3 := [_]Instr(.Push(1), .Push(0), .Div, .Halt)
    print("{}\n", execute(p3[..], cfg, &steps))
    p4 := [_]Instr(.Add)
    print("{}\n", execute(p4[..], cfg, &steps))
    p5 := [_]Instr(.Push(1), .Jmp(0))
    print("{}\n", execute(p5[..], cfg, &steps))
    p6 := [_]Instr(.Push(7), .Neg, .Dup, .Mul, .Push(2), .Swap, .Pop, .Halt)
    print("{}\n", execute(p6[..], cfg, &steps))

    nums := [_]i32(5, 100, 7, 200, 9, 300)
    print("lenient: {}\n", with_warnings(nums[..], 50, 10))
    print("strict:  {}\n", with_warnings(nums[..], 50, 2))
    print("none over limit: {}\n", with_warnings(nums[0..1], 50, 1))
}
