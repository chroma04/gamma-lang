// `with &x` chooses the handler declaration by `x`'s type, also when `x` was
// initialized with an untyped literal and so has its default type (§6.1, §12.6).
Add :: effect { add: fn(n: i32) }
handler Add for ^i32 { add(self, n) => { self^ += n } }
bump :: fn() needs Add {
    Add.add(2)
    Add.add(3)
}
main :: fn() needs Out {
    x := 0
    with &x { bump() }
    print("{}\n", x)
}
