// Wide integers (u256, i256, u128) as arguments, results, struct fields and through function pointers, effects and fibers.
Acc :: struct { v: u256, step: u256, n: u32 }

Meter :: effect { observe: fn(x: u256) -> u256 }
Feed :: effect { feed: ctl(x: u256) -> u256 }

fact :: fn(n: u32) -> u256 {
    if n <= 1 { return 1 }
    return u256(n) * fact(n - 1)
}

fib_pair :: fn(a: u256, b: u256, n: u32) -> u256 {
    if n is 0 { return a }
    return fib_pair(b, a + b, n - 1)
}

powmod :: fn(b: u256, e: u256, m: u256) -> u256 {
    result: u256 = 1
    base := b % m
    ex := e
    while ex > 0 {
        if ex & 1 is 1 { result = result * base % m }
        base = base * base % m
        ex = ex >> 1
    }
    return result
}

step_acc :: fn(a: Acc, k: u256) -> Acc {
    r := a
    r.v = r.v * k + r.step
    r.step += 1
    r.n += 1
    return r
}

apply :: fn(f: ^fn(a: Acc, k: u256) -> Acc, a: Acc, k: u256) -> Acc => f(a, k)

mix :: fn(x: i256, y: u128, z: i128) -> i256 => x * 3 + i256(y) - i256(z)

measured :: fn(x: u256) -> u256 \ {Meter} => observe(x) + observe(x + 1)

pulled :: fn(x: u256) -> u256 \ {Feed} {
    a := feed(x)
    b := feed(a + 1)
    return a * b
}

STACK :: @stack_size(pulled)

main :: fn() \ {Out} {
    print("fact(30) = {}\n", fact(30))
    print("fact(50) = {}\n", fact(50))
    print("fib(150) = {}\n", fib_pair(0, 1, 150))
    p: u256 = 2
    print("2^255 = {}\n", p << 254)
    big_prime: u256 = 1_000_000_007
    print("powmod {}\n", powmod(3, 1_000_000, big_prime))
    print("powmod2 {}\n", powmod(u256(2) << 200, 12345, (u256(1) << 120) + 3))
    // the struct with wide fields travels by address and is copied by the callee
    acc := Acc(v: 1, step: 7, n: 0)
    for i in 0..5 { acc = step_acc(acc, u256(i) + 100) }
    print("acc {} {} {}\n", (acc.v, acc.step, acc.n))
    alt := apply(step_acc, acc, 3)
    print("alt {} {} orig {}\n", (alt.v, alt.n, acc.n))
    // mixed widths and signs
    print("mix {}\n", mix(-5, 1 << 100, -(1 << 90)))
    // checked overflow: the largest u256 plus one does not fit
    zero: u256 = 0
    top := zero -% 1
    print("top {}\n", top)
    print("wrap {} sat {}\n", (top +% 2, top.sat(u128)))
    print("checked {}\n", top +? 1 is null)
    // effects with wide operands
    seen: u256 = 0
    total := with (handler Meter { observe(x) => { seen += x; x * 2 } }) {
        measured(1 << 128)
    }
    print("meter {} {}\n", (total, seen))
    stack: [STACK]u8 = ---
    got: u256 = 0
    r := with (handler Feed { feed(x, k) => { got += x; resume k(x * 10) } }) on stack[..] {
        pulled(7)
    }
    print("feed {} {}\n", (r, got))
    i: i256 = -(1 << 200)
    print("neg {} abs-shift {}\n", (i, (i >> 190)))
}
