// std/math: erf and erfc on every range of the algorithm, at its boundaries, and on special values.
// The results are printed with the shortest round-trip representation, so the expected output pins the exact bits.
math :: import "std/math"

NZ: f64 : (0x8000_0000_0000_0000u64).bits(f64)

p1 :: fn(name: string, x: f64, r: f64) needs Out {
    print("{}({}) = {}\n", name, x, r)
}

p2 :: fn(name: string, x: f64, y: f64, r: f64) needs Out {
    print("{}({}, {}) = {}\n", name, x, y, r)
}

test_erf :: fn() needs Out {
    p1("erf", 0.0, math.erf(0.0))
    p1("erf", NZ, math.erf(NZ))
    p1("erf", 5e-324, math.erf(5e-324))
    p1("erf", 1e-300, math.erf(1e-300))
    p1("erf", 1e-20, math.erf(1e-20))
    p1("erf", 3.7252902984619136e-09, math.erf(3.7252902984619136e-09))
    p1("erf", 1e-05, math.erf(1e-05))
    p1("erf", 0.1, math.erf(0.1))
    p1("erf", 0.25, math.erf(0.25))
    p1("erf", 0.5, math.erf(0.5))
    p1("erf", 0.8437499999999999, math.erf(0.8437499999999999))
    p1("erf", 0.84375, math.erf(0.84375))
    p1("erf", 0.9, math.erf(0.9))
    p1("erf", 1.0, math.erf(1.0))
    p1("erf", -1.0, math.erf(-1.0))
    p1("erf", 1.1, math.erf(1.1))
    p1("erf", 1.25, math.erf(1.25))
    p1("erf", 1.2500000000000002, math.erf(1.2500000000000002))
    p1("erf", 1.5, math.erf(1.5))
    p1("erf", 2.0, math.erf(2.0))
    p1("erf", 2.857142857142857, math.erf(2.857142857142857))
    p1("erf", 2.8571428571428577, math.erf(2.8571428571428577))
    p1("erf", 3.0, math.erf(3.0))
    p1("erf", -3.0, math.erf(-3.0))
    p1("erf", 4.0, math.erf(4.0))
    p1("erf", 5.0, math.erf(5.0))
    p1("erf", 5.999999999999999, math.erf(5.999999999999999))
    p1("erf", 6.0, math.erf(6.0))
    p1("erf", 10.0, math.erf(10.0))
    p1("erf", 30.0, math.erf(30.0))
    p1("erf", -0.5, math.erf(-0.5))
    p1("erf", -0.84375, math.erf(-0.84375))
    p1("erf", -2.0, math.erf(-2.0))
    p1("erf", -6.0, math.erf(-6.0))
    p1("erf", 1e+300, math.erf(1e+300))
    p1("erf", math.inf, math.erf(math.inf))
    p1("erf", -math.inf, math.erf(-math.inf))
    p1("erf", math.nan, math.erf(math.nan))
}

test_erfc :: fn() needs Out {
    p1("erfc", 0.0, math.erfc(0.0))
    p1("erfc", NZ, math.erfc(NZ))
    p1("erfc", 5e-324, math.erfc(5e-324))
    p1("erfc", 1e-300, math.erfc(1e-300))
    p1("erfc", 1e-20, math.erfc(1e-20))
    p1("erfc", 5.551115123125783e-17, math.erfc(5.551115123125783e-17))
    p1("erfc", 1e-10, math.erfc(1e-10))
    p1("erfc", 1e-05, math.erfc(1e-05))
    p1("erfc", 0.1, math.erfc(0.1))
    p1("erfc", 0.25, math.erfc(0.25))
    p1("erfc", 0.2499999999999999, math.erfc(0.2499999999999999))
    p1("erfc", 0.5, math.erfc(0.5))
    p1("erfc", 0.84375, math.erfc(0.84375))
    p1("erfc", 0.9, math.erfc(0.9))
    p1("erfc", 1.0, math.erfc(1.0))
    p1("erfc", 1.1, math.erfc(1.1))
    p1("erfc", 1.25, math.erfc(1.25))
    p1("erfc", 1.2500000000000002, math.erfc(1.2500000000000002))
    p1("erfc", 1.5, math.erfc(1.5))
    p1("erfc", 2.0, math.erfc(2.0))
    p1("erfc", 2.857142857142857, math.erfc(2.857142857142857))
    p1("erfc", 2.8571428571428577, math.erfc(2.8571428571428577))
    p1("erfc", 3.0, math.erfc(3.0))
    p1("erfc", 4.0, math.erfc(4.0))
    p1("erfc", 5.0, math.erfc(5.0))
    p1("erfc", 6.0, math.erfc(6.0))
    p1("erfc", 10.0, math.erfc(10.0))
    p1("erfc", 20.0, math.erfc(20.0))
    p1("erfc", 26.0, math.erfc(26.0))
    p1("erfc", 26.5, math.erfc(26.5))
    p1("erfc", 26.55, math.erfc(26.55))
    p1("erfc", 26.9, math.erfc(26.9))
    p1("erfc", 27.0, math.erfc(27.0))
    p1("erfc", 27.2, math.erfc(27.2))
    p1("erfc", 27.3, math.erfc(27.3))
    p1("erfc", 27.9, math.erfc(27.9))
    p1("erfc", 28.0, math.erfc(28.0))
    p1("erfc", 30.0, math.erfc(30.0))
    p1("erfc", 1e+300, math.erfc(1e+300))
    p1("erfc", -1e-20, math.erfc(-1e-20))
    p1("erfc", -0.1, math.erfc(-0.1))
    p1("erfc", -0.5, math.erfc(-0.5))
    p1("erfc", -0.84375, math.erfc(-0.84375))
    p1("erfc", -1.0, math.erfc(-1.0))
    p1("erfc", -1.25, math.erfc(-1.25))
    p1("erfc", -2.0, math.erfc(-2.0))
    p1("erfc", -3.0, math.erfc(-3.0))
    p1("erfc", -5.9, math.erfc(-5.9))
    p1("erfc", -6.0, math.erfc(-6.0))
    p1("erfc", -10.0, math.erfc(-10.0))
    p1("erfc", -27.0, math.erfc(-27.0))
    p1("erfc", -28.0, math.erfc(-28.0))
    p1("erfc", -1e+300, math.erfc(-1e+300))
    p1("erfc", math.inf, math.erfc(math.inf))
    p1("erfc", -math.inf, math.erfc(-math.inf))
    p1("erfc", math.nan, math.erfc(math.nan))
}

main :: fn() needs Out {
    test_erf()
    test_erfc()
}
