// Serializers written against a Sink effect, with two handler types: stdout and a growable buffer.
value :: import "../value"
fmt :: import "std/fmt"

Value :: value.Value

/// Where serialized text goes.
pub Sink :: effect {
    put: fn(text: string)
}

/// A sink that collects text in memory.
pub Buffer :: struct {
    bytes: List(u8)
    pub puts: u32 = 0
}

pub buffer :: fn() -> Buffer needs Alloc => Buffer(bytes: list(u8))

pub text :: fn(b: ^const Buffer) -> string => b.bytes.items

pub deinit :: fn(b: ^Buffer) { b.bytes.deinit() }

handler Sink for ^Buffer needs Alloc {
    put(self, t) => {
        self.puts += 1
        self.bytes.extend(t) else trap("out of memory")
    }
}

/// A sink that writes through the Out effect.
pub Stdout :: struct {}

handler Sink for ^Stdout needs Out {
    put(self, t) => print("{}", t)
}

hex_digit :: fn(n: u8) -> u8 => if n < 10 { '0' + n } else { 'a' + (n - 10) }

quote :: fn(s: string) needs Sink {
    Sink.put("\"")
    start: usize = 0
    for i in 0..s.len {
        c := s[i]
        escaped: string = match c {
            '"' => "\\\""
            '\\' => "\\\\"
            '\n' => "\\n"
            '\t' => "\\t"
            '\r' => "\\r"
            _ => ""
        }
        if escaped.len > 0 or c < 0x20 {
            Sink.put(s[start..i])
            if escaped.len > 0 {
                Sink.put(escaped)
            } else {
                uni: [6]u8 = [_]u8('\\', 'u', '0', '0', hex_digit(c >> 4), hex_digit(c & 15))
                Sink.put(uni[..])
            }
            start = i + 1
        }
    }
    Sink.put(s[start..])
    Sink.put("\"")
}

number :: fn(x: f64) needs Sink {
    buf: [400]u8 = ---
    Sink.put(fmt.general(x, 12, buf[..]))
}

int :: fn(x: i64) needs Sink {
    buf: [fmt.INT_BUF]u8 = ---
    Sink.put(fmt.dec(x, buf[..]))
}

/// Compact output: no whitespace at all.
pub compact :: fn(v: ^const Value) needs Sink {
    match v^ {
        .Null => Sink.put("null")
        .Bool(b) => Sink.put(if b { "true" } else { "false" })
        .Int(n) => int(n)
        .Num(x) => number(x)
        .Str(s) => quote(s)
        .Arr(xs) => {
            Sink.put("[")
            for i in 0..xs.items.len {
                if i > 0 { Sink.put(",") }
                compact(&xs.items[i])
            }
            Sink.put("]")
        }
        .Obj(ms) => {
            Sink.put("{")
            for i in 0..ms.items.len {
                if i > 0 { Sink.put(",") }
                quote(ms.items[i].key)
                Sink.put(":")
                compact(&ms.items[i].val)
            }
            Sink.put("}")
        }
    }
}

indent :: fn(level: u32, width: u32) needs Sink {
    for _ in 0..level * width { Sink.put(" ") }
}

/// Indented output; empty containers stay on one line.
pub pretty :: fn(v: ^const Value, width: u32 = 2) needs Sink {
    pretty_at(v, 0, width)
}

pretty_at :: fn(v: ^const Value, level: u32, width: u32) needs Sink {
    match v^ {
        .Arr(xs) => {
            if xs.items.len is 0 {
                Sink.put("[]")
                return
            }
            Sink.put("[\n")
            for i in 0..xs.items.len {
                indent(level + 1, width)
                pretty_at(&xs.items[i], level + 1, width)
                Sink.put(if i + 1 < xs.items.len { ",\n" } else { "\n" })
            }
            indent(level, width)
            Sink.put("]")
        }
        .Obj(ms) => {
            if ms.items.len is 0 {
                Sink.put("{}")
                return
            }
            Sink.put("{\n")
            for i in 0..ms.items.len {
                indent(level + 1, width)
                quote(ms.items[i].key)
                Sink.put(": ")
                pretty_at(&ms.items[i].val, level + 1, width)
                Sink.put(if i + 1 < ms.items.len { ",\n" } else { "\n" })
            }
            indent(level, width)
            Sink.put("}")
        }
        _ => compact(v)
    }
}
