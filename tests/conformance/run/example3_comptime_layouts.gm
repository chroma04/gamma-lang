// Compile time: CRC32 and Q15 sine tables, a Ring(T, N) generic with a value parameter, packed layouts pinned by static asserts, when on target.
math :: import "std/math"

crc_table :: fn(poly: u32) -> [256]u32 {
    table: [256]u32 = ---
    for n in 0..256 {
        c := n.trunc(u32)
        for _ in 0..8 {
            c = if c & 1 is 1 { (c >> 1) ~ poly } else { c >> 1 }
        }
        table[n] = c
    }
    return table
}

CRC_TABLE :: crc_table(0xEDB88320)

crc32 :: fn(data: []const u8) -> u32 {
    crc: u32 = 0xFFFFFFFF
    for b in data {
        crc = (crc >> 8) ~ CRC_TABLE[((crc ~ u32(b)) & 0xFF).trunc(usize)]
    }
    return crc ~ 0xFFFFFFFF
}

@static_assert(CRC_TABLE[1] is 0x77073096, "standard first entries")
@static_assert(CRC_TABLE[255] is 0x2D02EF8D)

// A quarter-wave sine table in Q15 fixed point, computed by the library's own sin at compile time.
QUARTER :: 32
sine_quarter :: fn() -> [QUARTER + 1]i32 {
    t: [QUARTER + 1]i32 = ---
    for i in 0..QUARTER + 1 {
        angle := math.pi / 2.0 * i.round(f64) / QUARTER.round(f64)
        t[i] = math.round(math.sin(angle) * 32767.0).trunc(i32)
    }
    return t
}
SINE_Q :: sine_quarter()

// Full-circle sine of `idx` out of 4 * QUARTER steps.
isin :: fn(idx: i32) -> i32 {
    n := (idx % (4 * QUARTER) + 4 * QUARTER) % (4 * QUARTER)
    half := n % (2 * QUARTER)
    q := if half > QUARTER { 2 * QUARTER - half } else { half }
    v := SINE_Q[q.trunc(usize)]
    return if n >= 2 * QUARTER { -v } else { v }
}

Ring :: struct(T: type, N: usize) {
    items: [N]T
    head: usize
    count: usize
}

// Appends `x`; when the ring is full the oldest element is overwritten and returned.
push :: fn(T: type, N :: usize, r: ^Ring(T, N), x: T) -> ?T {
    evicted: ?T = null
    if r.count is N {
        evicted = r.items[r.head]
        r.items[r.head] = x
        r.head = (r.head + 1) % N
    } else {
        r.items[(r.head + r.count) % N] = x
        r.count += 1
    }
    return evicted
}

Header :: #packed struct {
    magic: u16
    kind: u8
    len: u32
    crc: u32
}

Padded :: struct {
    magic: u16
    kind: u8
    len: u32
    crc: u32
}

Wide :: #align(32) struct { x: u8 }

@static_assert(@size_of(Header) is 11, "packed header has no padding")
@static_assert(@align_of(Header) is 1)
@static_assert(@offset_of(Header, crc) is 7)
@static_assert(@size_of(Padded) is 12)
@static_assert(@offset_of(Padded, len) is 4)
@static_assert(@size_of(Ring(u16, 4)) is 24, "4 u16 + head + count")
@static_assert(@size_of(Wide) is 32 and @align_of(Wide) is 32)

when target.endian is .Little {
    ENDIAN :: "little"
} else {
    ENDIAN :: "big"
}

when target.ptr_bits is 64 {
    WORD_BYTES :: 8
} else {
    WORD_BYTES :: 4
}
@static_assert(WORD_BYTES is @size_of(usize))

main :: fn() \ {Out} {
    print("crc32(\"123456789\") = {}\n", crc32("123456789"))
    print("crc32 empty = {}\n", crc32(""))
    print("endian {} word {}\n", (ENDIAN, WORD_BYTES))
    print("sine: {} {} {} {} {}\n", (isin(0), isin(16), isin(32), isin(64), isin(96)))
    print("negative index: {} {}\n", (isin(-32), isin(-1)))
    print("table ends: {} {} {}\n", (SINE_Q[0], SINE_Q[1], SINE_Q[QUARTER]))

    r := Ring(u16, 4)(items: [4]u16(fill: 0), head: 0, count: 0)
    for i in 1..8 {
        if old := r.push(u16(i * 10)) {
            print("evicted {}\n", old)
        }
    }
    print("ring {} head {} count {}\n", (r.items, r.head, r.count))
    print("sizes {} {} {}\n", (@size_of(Header), @size_of(Padded), @size_of(Ring(u16, 4))))
    h := Header(magic: 0xCAFE, kind: 3, len: 0x01020304, crc: crc32("hdr"))
    print("packed field reads {} {} {} {}\n", (h.magic, h.kind, h.len, h.crc))
}
