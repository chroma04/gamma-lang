// The address of a local kept where it may outlive the local (§15.1): a loop variable or
// a pattern binding is a copy whose storage is reused or gone after its scope. Where it
// certainly outlives it, it is a compile error (see check/dangling_address.gm).
//! stage: lint

Node :: struct { v: i32 }
Holder :: struct { p: ?^const Node }

keep :: fn(h: ^Holder, n: Node) {
    h.p = &n //~ WARNING [dangling-address] this address of `n` is stored where it outlives `n`
}

Walk :: struct { cur: ?^const Node = null, seen: i32 = 0 }

visit :: fn(w: ^Walk) {
    if c := w.cur { w.seen += c.v }
}

// An address stored for the work that follows and replaced before the block ends does
// not outlive the local.
scoped :: fn(w: ^Walk, n: Node) {
    saved := w.cur
    w.cur = &n
    visit(w)
    w.cur = saved
}

main :: fn() needs Alloc + Out {
    nodes := [_]Node(Node(v: 1), Node(v: 2))
    ptrs := list(^const Node)
    for n in nodes {
        ptrs.push(&n)! //~ WARNING [dangling-address] this address of `n` is passed to a call that may keep it
    }
    // Pointers into the original, and pointers used only within the scope, are fine.
    ok := list(^const Node)
    for i in 0..nodes.len { ok.push(&nodes[i])! }
    h := Holder(p: null)
    keep(&h, nodes[0])
    w := Walk()
    scoped(&w, nodes[1])
    print("{} {}\n", ptrs.items.len, ok.items.len)
}
