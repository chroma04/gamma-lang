// `else { if … }` can be written `else if …`.
//! stage: lint

main :: fn() needs Out {
    n := 3
    if n > 5 {
        print("big\n")
    } else { //~ WARNING [collapsible-else-if]
        if n > 2 {
            print("medium\n")
        }
    }
    if n > 5 {
        print("big\n")
    } else if n > 2 {
        print("medium\n")
    } else {
        print("small\n")
    }
    if n > 5 {
        print("big\n")
    } else {
        print("not big\n")
        if n > 2 { print("medium\n") }
    }
}
