// A leak report lists the leaked blocks with the sites that allocated them (§3.8).
test "leaks" {
    a := ok(make(u8, 10))
    b := ok(new(T: u32, 7))
    l := list(i32)
    ok(l.push(1))
    c := ok(dupe("xyz"))
    free(c)
}
test "clean" {
    a := ok(make(u8, 10))
    free(a)
}
