//! stage: test
//! exit: 1
//! safe: skip Debug builds name the test in failure locations
// `ok(x)` takes a result of any error type (§3.8): an error fails the test where it occurs,
// reporting the error. A function that declares `Test` can call it too.

ParseError :: union { Empty, Bad: u8 }
OtherError :: union { Nope }

parse :: fn(s: string) -> ParseError!u32 {
    if s.len is 0 { return !.Empty }
    return 7
}
other :: fn(ok: bool) -> OtherError!u32 {
    if ok { return 1 }
    return !.Nope
}

test "mixed error types" {
    a := ok(parse("x"))
    b := ok(other(true))
    c := ok(fs_read())
    expect(a + b + c is 8)
}

fs_read :: fn() -> IoError!u32 => 0

test "a later error fails in place" {
    a := ok(parse("x"))
    print("got {}\n", a)
    b := ok(other(false))
    print("not reached {}\n", b)
}

test "the first error still returns" {
    _ = ok(parse(""))
}

check_positive :: fn(n: i32) -> u32 \ {Test} {
    expect(n > 0, "not positive")
    return ok(other(true))
}

test "a helper fails the test" {
    _ = check_positive(1)
    _ = check_positive(-1)
}

test "inside a loop" {
    for i in range(0u32, 3) {
        _ = ok(other(i < 2))
    }
}
