        Case(name: "n_structure_whitespace_formfeed", text: "[\u{c}]"),
        Case(name: "n_structure_vertical_tab", text: "[\u{b}1]"),
        Case(name: "n_structure_non_breaking_space", text: "\u{a0}[1]"),
        Case(name: "i_string_1st_surrogate_but_2nd_missing", text: "[\"\\uDADA\"]"),
        Case(name: "i_string_1st_valid_surrogate_2nd_invalid", text: "[\"\\uD888\\u1234\"]"),
        Case(name: "i_string_incomplete_surrogate_and_escape_valid", text: "[\"\\uD800\\n\"]"),
        Case(name: "i_string_incomplete_surrogate_pair", text: "[\"\\uDd1ea\"]"),
        Case(name: "i_string_incomplete_surrogates_escape_valid", text: "[\"\\uD800\\uD800\\n\"]"),
        Case(name: "i_string_invalid_lonely_surrogate", text: "[\"\\ud800\"]"),
        Case(name: "i_string_invalid_surrogate", text: "[\"\\ud800abc\"]"),
        Case(name: "i_string_inverted_surrogates_U+1D11E", text: "[\"\\uDd1e\\uD834\"]"),
        Case(name: "i_string_lone_second_surrogate", text: "[\"\\uDFAA\"]"),
        Case(name: "i_string_not_in_unicode_range", text: "[\"\xf4\xbf\xbf\xbf\"]"),
        Case(name: "i_string_overlong_sequence_2_bytes", text: "[\"\xc0\xaf\"]"),
        Case(name: "i_string_UTF-8_invalid_sequence", text: "[\"\xe6\x97\xa5\xd1\x88\xfa\"]"),
    )
    for c in cases {
        if parses(c.text) { expect(false, c.name) }
    }
}

test "error offsets and kinds" {
    expect(fails("") is .UnexpectedEnd(0))
    expect(fails("[1,]") is .UnexpectedByte(3))
    expect(fails("[1 2]") is .UnexpectedByte(3))
    expect(fails("  tru") is .UnexpectedEnd(5))
    expect(fails("trux") is .UnexpectedByte(3))
    expect(fails("[01]") is .InvalidNumber(2))
    expect(fails("-") is .UnexpectedEnd(1))
    expect(fails("-x") is .InvalidNumber(1))
    expect(fails("[1.]") is .InvalidNumber(3))
    expect(fails("[1e+]") is .InvalidNumber(4))
    expect(fails("{\"a\":1,}") is .UnexpectedByte(7))
    expect(fails("{1:2}") is .UnexpectedByte(1))
    expect(fails("{\"a\" 1}") is .UnexpectedByte(5))
    expect(fails("[1] x") is .TrailingData(4))
    expect(fails("\"a\tb\"") is .ControlCharacter(2))
    expect(fails("\"\\q\"") is .InvalidEscape(2))
    expect(fails("\"\\u12G4\"") is .InvalidEscape(5))
    expect(fails("\"\\ud800\"") is .InvalidSurrogate(1))
    expect(fails("\"ab\\udc00\"") is .InvalidSurrogate(3))
    expect(fails("\"\\ud800\\u0041\"") is .InvalidSurrogate(1))
    expect(fails("\"ab\xe5\"") is .InvalidUtf8(3))
    expect(fails("\"abc") is .UnexpectedEnd(4))
    expect(fails("[1,2") is .UnexpectedEnd(4))
    expect(fails("\u{feff}[]") is .UnexpectedByte(0))
}

test "the nesting limit" {
    deep: [600]u8 = ---
    for i in 0..600 { deep[i] = '[' }
    expect(fails(deep[0..600]) is .TooDeep(512))
    // Exactly at the limit, closed again.
    at_limit: [1024]u8 = ---
    for i in 0..512 {
        at_limit[i] = '['
        at_limit[1023 - i] = ']'
    }
    expect(parses(at_limit[..]))
    expect(fails(at_limit[..]) is null)
    doc := ok(json.parse("[[[]]]", 3))
    doc.deinit()
    expect(json.parse("[[[[]]]]", 3) is !.TooDeep(3))
}

test "positions" {
    text := "{\n  \"a\": 1,\n  \"b\": ?\n}"
    p := json.position(text, 19)
    expect_eq(p.line, 3)
    expect_eq(p.column, 8)
    expect_eq(json.position(text, 0).line, 1)
    expect_eq(json.position(text, 0).column, 1)
    expect_eq(json.position(text, 1000).line, 4)
}

test "the tree" {
    doc := ok(json.parse(" {\"a\": [1, true, null, \"x\\ny\"], \"b\": {\"c\": -2.5e1}, \"a\": 7} "))
    defer doc.deinit()
    // Duplicate keys are kept; `get` finds the last.
    obj := doc.root
    match obj {
        .Object(ms) => {
            expect_eq(ms.len, 3)
            expect(ms[0].key is "a" and ms[1].key is "b" and ms[2].key is "a")
        }
        _ => expect(false, "an object")
    }
    last := obj.get("a") else return ()
    match last {
        .Number(n) => expect(n.text is "7")
        _ => expect(false, "the last duplicate")
    }
    expect(obj.get("zzz") is null)
    first := json.at(doc.root, 0)
    expect(first is null)
    b := obj.get("b") else return ()
    c := b.get("c") else return ()
    match c {
        .Number(n) => {
            expect(n.text is "-2.5e1")
            expect(n.to_i64() is -25)
            r := n.to_f64()
            expect(r.value is -25.0 and r.exact)
        }
        _ => expect(false, "a number")
    }
}

test "arrays and strings" {
    doc := ok(json.parse("[1, true, null, \"x\\ny\", \"\\u00e9\\ud83d\\ude00\\\"\", \"\", []]"))
    defer doc.deinit()
    expect(doc.root.at(1) is .Bool(true))
    expect(doc.root.at(2) is .Null)
    expect(doc.root.at(7) is null)
    s := doc.root.at(3) else return ()
    match s {
        .String(t) => expect(t is "x\ny")
        _ => expect(false, "a string")
    }
    s2 := doc.root.at(4) else return ()
    match s2 {
        .String(t) => {
            expect(t is "\u{e9}\u{1f600}\"")
            expect(t.len is 7)
        }
        _ => expect(false, "a string")
    }
    s3 := doc.root.at(5) else return ()
    match s3 {
        .String(t) => expect(t.len is 0)
        _ => expect(false, "a string")
    }
    // The text may be freed or changed once parsed: the document has its own copy.
    expect(doc.root.at(6) is .Array(_))
}

num :: fn(text: string) -> json.Number => json.Number(text: text)

test "integer conversion" {
    expect(num("0").to_i64() is 0)
    expect(num("-0").to_i64() is 0)
    expect(num("0.0").to_i64() is 0)
    expect(num("0e500").to_i64() is 0)
    expect(num("12").to_i64() is 12)
    expect(num("-12").to_i64() is -12)
    expect(num("1e3").to_i64() is 1000)
    expect(num("1E+3").to_i64() is 1000)
    expect(num("5.0").to_i64() is 5)
    expect(num("12.50e1").to_i64() is 125)
    expect(num("125e-1").to_i64() is null)
    expect(num("1.5").to_i64() is null)
    expect(num("1e-1").to_i64() is null)
    expect(num("100e-2").to_i64() is 1)
    expect(num("9223372036854775807").to_i64() is 9223372036854775807)
    expect(num("9223372036854775808").to_i64() is null)
    expect(num("-9223372036854775808").to_i64() is -9223372036854775807 - 1)
    expect(num("-9223372036854775809").to_i64() is null)
    expect(num("922337203685477580.7e1").to_i64() is 9223372036854775807)
    expect(num("1e19").to_i64() is null)
    expect(num("1e18").to_i64() is 1000000000000000000)
    expect(num("1e99999999999").to_i64() is null)
    expect(num("10000000000000000000000").to_i64() is null)
}

test "float conversion and exactness" {
    a := num("0.1").to_f64()
    expect(a.value is 0.1 and a.exact)
    b := num("1e3").to_f64()
    expect(b.value is 1000.0 and b.exact)
    c := num("9007199254740993").to_f64()
    expect(c.value is 9007199254740992.0 and not c.exact)
    d := num("9007199254740992").to_f64()
    expect(d.value is 9007199254740992.0 and d.exact)
    e := num("1e400").to_f64()
    expect(e.value.is_inf() and not e.exact)
    f := num("0.1000000000000000000001").to_f64()
    expect(f.value is 0.1 and not f.exact)
    g := num("-0").to_f64()
    expect(g.value is 0.0 and g.value.sign_bit() and g.exact)
    h := num("1.5e300").to_f64()
    expect(h.value is 1.5e300 and h.exact)
    i := num("12.340").to_f64()
    expect(i.value is 12.34 and i.exact)
    j := num("0.00012").to_f64()
    expect(j.value is 0.00012 and j.exact)
    k := num("1e-400").to_f64()
    expect(k.value is 0.0 and not k.exact)
    l := num("123456789012345678").to_f64()
    expect(not l.exact)
    m := num("5e-324").to_f64()
    expect(m.value > 0.0 and m.exact)
}

dump :: fn(v: json.Value, indent: usize) -> []u8 needs Alloc {
    out := list(u8)
    json.write(&out, v, indent) else return empty_slice(u8)
    return out.into_slice() else empty_slice(u8)
}

test "writing a tree" {
    doc := ok(json.parse("{\"a\":[1,2.50,{\"b\":null}],\"c\":\"\\u0001\\\"\\\\\\/\",\"d\":[],\"e\":{}}"))
    defer doc.deinit()
    compact := dump(doc.root, 0)
    defer free(compact)
    expect(compact is "{\"a\":[1,2.50,{\"b\":null}],\"c\":\"\\u0001\\\"\\\\/\",\"d\":[],\"e\":{}}")
    pretty := dump(doc.root, 2)
    defer free(pretty)
    expect(pretty is "{\n  \"a\": [\n    1,\n    2.50,\n    {\n      \"b\": null\n    }\n  ],\n  \"c\": \"\\u0001\\\"\\\\/\",\n  \"d\": [],\n  \"e\": {}\n}")
    // Round trip: parsing the output gives the same output.
    again := ok(json.parse(compact))
    defer again.deinit()
    compact2 := dump(again.root, 0)
    defer free(compact2)
    expect(compact2 is compact)
}

test "the writer" {
    out := list(u8)
    defer out.deinit()
    w := json.writer(&out, 0)
    ok(w.begin_object())
    ok(w.key("name"))
    ok(w.write_string("tab\there \u{e9}\u{7}"))
    ok(w.key("n"))
    ok(w.write_int(-12))
    ok(w.key("big"))
    ok(w.write_int(u64(18446744073709551615)))
    ok(w.key("f"))
    ok(w.write_float(0.1))
    ok(w.key("g"))
    ok(w.write_float(1.0e21))
    ok(w.key("h"))
    ok(w.write_float(f32(0.5)))
    ok(w.key("ok"))
    ok(w.write_bool(true))
    ok(w.key("nothing"))
    ok(w.write_null())
    ok(w.key("list"))
    ok(w.begin_array())
    ok(w.write_int(1))
    ok(w.begin_array())
    ok(w.end_array())
    ok(w.write_string(""))
    ok(w.end_array())
    ok(w.end_object())
    expect(out.items is "{\"name\":\"tab\\there \u{e9}\\u0007\",\"n\":-12,\"big\":18446744073709551615,\"f\":0.1,\"g\":1e21,\"h\":0.5,\"ok\":true,\"nothing\":null,\"list\":[1,[],\"\"]}")
    // Written text parses back.
    doc := ok(json.parse(out.items))
    doc.deinit()
}

test "writer errors" {
    out := list(u8)
    defer out.deinit()
    w := json.writer(&out, 0)
    expect(w.write_float(f64(0.0) / 0.0) is !.NonFinite)
    inf: f64 = 1.0e308 * 10.0
    expect(w.write_float(inf) is !.NonFinite)
    bad := [_]u8(0x61, 0xff)
    expect(w.write_string(bad[..]) is !.InvalidUtf8)
    // A failed call writes nothing before the failure is known.
    expect_eq(out.items.len, 0)
}

test "indented writer output" {
    out := list(u8)
    defer out.deinit()
    w := json.writer(&out, 4)
    ok(w.begin_array())
    ok(w.write_int(1))
    ok(w.begin_object())
    ok(w.key("k"))
    ok(w.write_string("v"))
    ok(w.end_object())
    ok(w.end_array())
    expect(out.items is "[\n    1,\n    {\n        \"k\": \"v\"\n    }\n]")
}

test "running out of memory is an error" {
    // A text of a few thousand bytes, parsed in buffers of every size: the parse either
    // succeeds or reports `Memory`, never anything else.
    text := list(u8)
    defer text.deinit()
    ok(text.extend("["))
    for i in 0..100 {
        if i > 0 { ok(text.extend(",")) }
        ok(text.write("{{\"id\":{},\"name\":\"item {}\",\"tags\":[\"a\",\"b\"]}}", i, i))
    }
    ok(text.extend("]"))
    store: [100000]u8 = ---
    failed: u32 = 0
    worked: u32 = 0
    size: usize = 0
    while size <= 100000 {
        fb := fixed_buffer.over(store[0..size])
        with fb.allocator() {
            r := json.parse(text.items)
            match r {
                !.Memory(_) => { failed += 1 }
                !_ => expect(false, "only Memory can fail")
                doc => {
                    worked += 1
                    expect(doc.root.at(99) is not null)
                }
            }
        }
        size += 4999
    }
    expect(failed > 0 and worked > 0)
}

next :: fn(seed: ^u64) -> u32 {
    seed^ = seed^ *% 6364136223846793005 +% 1442695040888963407
    return (seed^ >> 33).trunc(u32)
}

// Writes a pseudo-random value of at most `depth` more levels.
generate :: fn(w: ^json.Writer, seed: ^u64, depth: u32) -> json.WriteError!() needs Alloc {
    kinds: u32 = if depth is 0 { 6 } else { 8 }
    match next(seed) % kinds {
        0 => try w.write_null()
        1 => try w.write_bool(next(seed) % 2 is 0)
        2 => try w.write_int(i64(next(seed)) - 2147483648)
        3 => try w.write_float((f64(next(seed)) - 2147483648.0) / 1024.0)
        4 => try w.write_float(f64(next(seed)) * 1.0e250)
        5 => {
            // A string with escapes, control characters and non-ASCII text.
            pieces := [_]string("a", "\"", "\\", "\n", "\t", "\u{1}", "\u{e9}", "\u{20ac}", "\u{1f600}", "/", " ")
            s := list(u8)
            defer s.deinit()
            n := next(seed) % 8
            for _ in 0..n { try s.extend(pieces[(next(seed) % 11).trunc(usize)]) }
            try w.write_string(s.items)
        }
        6 => {
            try w.begin_array()
            n := next(seed) % 4
            for _ in 0..n { try generate(w, seed, depth - 1) }
            try w.end_array()
        }
        _ => {
            try w.begin_object()
            n := next(seed) % 4
            for i in 0..n {
                try w.key(if i % 2 is 0 { "k" } else { "key\n" })
                try generate(w, seed, depth - 1)
            }
            try w.end_object()
        }
    }
    return ()
}

test "random documents survive writing and parsing" {
    seed: u64 = 12345
    for round in 0..300 {
        compact := list(u8)
        defer compact.deinit()
        w := json.writer(&compact, 0)
        ok(generate(&w, &seed, 4))
        doc := ok(json.parse(compact.items))
        defer doc.deinit()
        // Writing the parsed tree gives the same text, indented or not.
        again := list(u8)
        defer again.deinit()
        ok(json.write(&again, doc.root, 0))
        expect(again.items is compact.items)
        pretty := list(u8)
        defer pretty.deinit()
        ok(json.write(&pretty, doc.root, 1 + round % 4))
        doc2 := ok(json.parse(pretty.items))
        defer doc2.deinit()
        back := list(u8)
        defer back.deinit()
        ok(json.write(&back, doc2.root, 0))
        expect(back.items is compact.items)
    }
}
