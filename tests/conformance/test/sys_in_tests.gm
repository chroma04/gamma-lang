//! stage: test
// Tests may perform `Sys`, like `main` (§3.8, §12.9).
#global counter: u32 = 0

bump :: fn() \ {Sys} { counter += 1 }

test "globals and volatile access" {
    x: u32 = 5
    @volatile_store(&x, 6)
    bump()
    bump()
    expect(@volatile_load(&x) is 6)
    expect(counter is 2)
}
