//! stage: test
// A test's `try` decides its error type also inside the body of a `for` over an iterator.
words :: fn(text: string) \ {Yield(string)} {
    yield(text)
}

test "try in a loop over an iterator" {
    got := list(string)
    defer got.deinit()
    for w in words("x y") { try got.push(w) }
    expect(got.items.len is 1)
}

test "try in a loop over an array" {
    got := list(string)
    defer got.deinit()
    for w in [2]string("x", "y") { try got.push(w) }
    expect(got.items.len is 2)
}
