//! stage: test
// Tests run with an in-memory loopback network as the handler of `Net` (§12.9): every
// test starts with an empty one, connections never leave the process, and nothing can
// block, so `accept` and `recv` with nothing to deliver fail with `WouldBlock`.
net :: import "std/net"

// Sends all of `text`, which the fake always accepts whole.
say :: fn(s: net.Socket, text: string) -> IoError!() needs Net {
    n := try s.send(text)
    if n is not text.len { return !.NoSpace }
}

// True if the next `recv` on `s` yields exactly `text`.
hears :: fn(s: net.Socket, text: string) -> IoError!bool needs Net {
    buf: [64]u8 = ---
    n := try s.recv(buf[..])
    return buf[0..n] is text
}

test "localhost, 127.0.0.1 and ::1 are one host" {
    l := ok(Net.listen("127.0.0.1", 4000))
    expect(ok(l.local_port()) is 4000)
    a := ok(Net.connect("localhost", 4000))
    b := ok(Net.connect("::1", 4000))
    c := ok(Net.connect("127.0.0.1", 4000))
    s1 := ok(l.accept())
    s2 := ok(l.accept())
    s3 := ok(l.accept())
    ok(say(a, "a"))
    ok(say(b, "b"))
    ok(say(c, "c"))
    expect(ok(hears(s1, "a")))
    expect(ok(hears(s2, "b")))
    expect(ok(hears(s3, "c")))
    l2 := ok(Net.listen("::1", 4001))
    l3 := ok(Net.listen("localhost", 4002))
    expect(ok(l2.local_port()) is 4001)
    expect(ok(l3.local_port()) is 4002)
    // The same port on any spelling of the host is taken.
    expect(Net.listen("localhost", 4001) is !.Other(98))
}

test "other hosts fail like a failed name lookup" {
    l := ok(Net.listen("localhost", 4100))
    expect(Net.connect("example.com", 4100) is !.Other(0))
    expect(Net.connect("10.0.0.1", 4100) is !.Other(0))
    expect(Net.connect("", 4100) is !.Other(0))
    expect(Net.listen("0.0.0.0", 4101) is !.Other(0))
    expect(Net.listen("example.com", 0) is !.Other(0))
    // Nothing was queued or bound by the failures.
    expect(l.accept() is !.WouldBlock)
    m := ok(Net.listen("localhost", 4101))
    expect(ok(m.local_port()) is 4101)
}

test "port 0 picks free ports counting up from 49152" {
    a := ok(Net.listen("localhost", 0))
    b := ok(Net.listen("localhost", 0))
    c := ok(Net.listen("localhost", 0))
    expect(ok(a.local_port()) is 49152)
    expect(ok(b.local_port()) is 49153)
    expect(ok(c.local_port()) is 49154)
    // Closing frees a port for explicit use, and a taken port is skipped.
    b.close_listener()
    d := ok(Net.listen("localhost", 49153))
    expect(ok(d.local_port()) is 49153)
    e := ok(Net.listen("localhost", 49156))
    f := ok(Net.listen("localhost", 0))
    g := ok(Net.listen("localhost", 0))
    expect(ok(f.local_port()) is 49155)
    expect(ok(g.local_port()) is 49157)
    expect(ok(e.local_port()) is 49156)
}

test "a port in use cannot be listened on again" {
    l := ok(Net.listen("localhost", 5000))
    expect(Net.listen("localhost", 5000) is !.Other(98))
    expect(Net.listen("127.0.0.1", 5000) is !.Other(98))
    l.close_listener()
    again := ok(Net.listen("localhost", 5000))
    expect(ok(again.local_port()) is 5000)
}

test "connecting to a port nobody listens on is refused" {
    expect(Net.connect("localhost", 6000) is !.ConnectionRefused)
    l := ok(Net.listen("localhost", 6001))
    expect(Net.connect("localhost", 6000) is !.ConnectionRefused)
    expect(Net.connect("localhost", 0) is !.ConnectionRefused)
    c := ok(Net.connect("localhost", 6001))
    c.close_socket()
    l.close_listener()
    expect(Net.connect("localhost", 6001) is !.ConnectionRefused)
}

test "accept does not block" {
    l := ok(Net.listen("localhost", 0))
    expect(l.accept() is !.WouldBlock)
    expect(l.accept() is !.WouldBlock)
    c := ok(Net.connect("localhost", ok(l.local_port())))
    s := ok(l.accept())
    expect(l.accept() is !.WouldBlock)
    ok(say(c, "x"))
    expect(ok(hears(s, "x")))
}

test "recv does not block" {
    l := ok(Net.listen("localhost", 0))
    c := ok(Net.connect("localhost", ok(l.local_port())))
    s := ok(l.accept())
    buf: [8]u8 = ---
    expect(s.recv(buf[..]) is !.WouldBlock)
    expect(c.recv(buf[..]) is !.WouldBlock)
    ok(say(c, "hi"))
    expect(c.recv(buf[..]) is !.WouldBlock)
    expect(ok(s.recv(buf[..])) is 2)
    expect(s.recv(buf[..]) is !.WouldBlock)
}

test "an echo exchange in both directions" {
    l := ok(Net.listen("localhost", 0))
    port := ok(l.local_port())
    c := ok(Net.connect("localhost", port))
    s := ok(l.accept())
    buf: [64]u8 = ---
    msgs := [_]string("one", "two two", "three three three")
    for msg in msgs {
        expect(ok(c.send(msg)) is msg.len)
        n := ok(s.recv(buf[..]))
        expect(buf[0..n] is msg)
        expect(ok(s.send(buf[0..n])) is n)
        m := ok(c.recv(buf[..]))
        expect(buf[0..m] is msg)
    }
    // Several sends are one stream; one recv takes what is queued.
    ok(say(c, "ab"))
    ok(say(c, "cd"))
    ok(say(c, "ef"))
    ok(say(s, "XY"))
    expect(ok(hears(s, "abcdef")))
    expect(ok(hears(c, "XY")))
    // An empty send changes nothing.
    expect(ok(c.send("")) is 0)
    expect(s.recv(buf[..]) is !.WouldBlock)
}

test "partial receives into small buffers" {
    l := ok(Net.listen("localhost", 0))
    c := ok(Net.connect("localhost", ok(l.local_port())))
    s := ok(l.accept())
    ok(say(c, "hello, world"))
    small: [5]u8 = ---
    expect(ok(s.recv(small[..])) is 5)
    expect(small[..] is "hello")
    expect(ok(s.recv(small[..])) is 5)
    expect(small[..] is ", wor")
    n := ok(s.recv(small[..]))
    expect(n is 2)
    expect(small[0..n] is "ld")
    expect(s.recv(small[..]) is !.WouldBlock)
    // The queue is usable again after it drained.
    ok(say(c, "again"))
    expect(ok(s.recv(small[..])) is 5)
    expect(small[..] is "again")
    // A zero-length buffer receives nothing.
    ok(say(c, "z"))
    expect(ok(s.recv(small[0..0])) is 0)
    expect(ok(hears(s, "z")))
}

test "two connections on one listener are accepted in order" {
    l := ok(Net.listen("localhost", 0))
    port := ok(l.local_port())
    first := ok(Net.connect("localhost", port))
    second := ok(Net.connect("localhost", port))
    ok(say(second, "from second"))
    ok(say(first, "from first"))
    a := ok(l.accept())
    b := ok(l.accept())
    expect(l.accept() is !.WouldBlock)
    expect(ok(hears(a, "from first")))
    expect(ok(hears(b, "from second")))
    // Each connection has its own queues.
    ok(say(a, "to first"))
    ok(say(b, "to second"))
    expect(ok(hears(first, "to first")))
    expect(ok(hears(second, "to second")))
}

test "data sent before the connection is accepted is kept" {
    l := ok(Net.listen("localhost", 0))
    c := ok(Net.connect("localhost", ok(l.local_port())))
    ok(say(c, "early"))
    s := ok(l.accept())
    expect(ok(hears(s, "early")))
}

test "a closed peer reads as the end after the queued data" {
    l := ok(Net.listen("localhost", 0))
    c := ok(Net.connect("localhost", ok(l.local_port())))
    s := ok(l.accept())
    ok(say(c, "bye"))
    c.close_socket()
    buf: [8]u8 = ---
    expect(ok(s.recv(buf[0..2])) is 2)
    expect(ok(s.recv(buf[..])) is 1)
    expect(ok(s.recv(buf[..])) is 0)
    expect(ok(s.recv(buf[..])) is 0)
    // Sending to a closed peer is a broken pipe.
    expect(s.send("anyone?") is !.BrokenPipe)
    s.close_socket()
}

test "closing a socket invalidates its handle" {
    l := ok(Net.listen("localhost", 0))
    c := ok(Net.connect("localhost", ok(l.local_port())))
    s := ok(l.accept())
    c.close_socket()
    buf: [4]u8 = ---
    expect(c.send("x") is !.Other(9))
    expect(c.recv(buf[..]) is !.Other(9))
    // Closing again is harmless, and the other end is unaffected.
    c.close_socket()
    expect(ok(s.recv(buf[..])) is 0)
    // A peer that closes while data is unread in its own queue loses it.
    l2 := ok(Net.listen("localhost", 0))
    c2 := ok(Net.connect("localhost", ok(l2.local_port())))
    s2 := ok(l2.accept())
    ok(say(c2, "lost"))
    s2.close_socket()
    expect(c2.recv(buf[..]) is 0)
    expect(c2.send("x") is !.BrokenPipe)
}

test "closing a listener drops unaccepted connections" {
    l := ok(Net.listen("localhost", 0))
    port := ok(l.local_port())
    kept := ok(Net.connect("localhost", port))
    dropped := ok(Net.connect("localhost", port))
    accepted := ok(l.accept())
    ok(say(dropped, "unheard"))
    l.close_listener()
    buf: [8]u8 = ---
    // The client end of the dropped connection sees a closed peer.
    expect(dropped.recv(buf[..]) is 0)
    expect(dropped.send("x") is !.BrokenPipe)
    // The accepted one is unaffected.
    ok(say(kept, "still"))
    expect(ok(hears(accepted, "still")))
    // The listener is gone.
    expect(l.accept() is !.Other(9))
    expect(l.local_port() is !.Other(9))
    expect(Net.connect("localhost", port) is !.ConnectionRefused)
    l.close_listener()
}

test "closed handles fail and closing twice is harmless" {
    l := ok(Net.listen("localhost", 7000))
    c := ok(Net.connect("localhost", 7000))
    s := ok(l.accept())
    buf: [4]u8 = ---
    c.close_socket()
    c.close_socket()
    expect(c.send("x") is !.Other(9))
    expect(c.recv(buf[..]) is !.Other(9))
    l.close_listener()
    l.close_listener()
    expect(l.accept() is !.Other(9))
    expect(l.local_port() is !.Other(9))
    // A closed handle is never reused for a new socket or listener.
    l2 := ok(Net.listen("localhost", 7000))
    c2 := ok(Net.connect("localhost", 7000))
    s2 := ok(l2.accept())
    expect(l.accept() is !.Other(9))
    expect(c.send("x") is !.Other(9))
    ok(say(c2, "new"))
    expect(ok(hears(s2, "new")))
    expect(ok(s.recv(buf[..])) is 0)
}

test "closing the listener leaves accepted connections open" {
    l := ok(Net.listen("localhost", 7100))
    c := ok(Net.connect("localhost", 7100))
    s := ok(l.accept())
    l.close_listener()
    ok(say(c, "ok"))
    expect(ok(hears(s, "ok")))
}

test "each test starts with an empty network" {
    // The earlier tests used these ports and left connections open.
    expect(Net.connect("localhost", 4000) is !.ConnectionRefused)
    expect(Net.connect("localhost", 6001) is !.ConnectionRefused)
    expect(Net.connect("localhost", 7100) is !.ConnectionRefused)
    expect(Net.connect("localhost", 49152) is !.ConnectionRefused)
    l := ok(Net.listen("localhost", 0))
    expect(ok(l.local_port()) is 49152)
    expect(l.accept() is !.WouldBlock)
    _ = ok(Net.listen("localhost", 4000))
}

test "many small messages keep their order" {
    l := ok(Net.listen("localhost", 0))
    c := ok(Net.connect("localhost", ok(l.local_port())))
    s := ok(l.accept())
    buf: [4]u8 = ---
    total: usize = 0
    for i in 0..200 {
        b: [1]u8 = ---
        b[0] = (i % 251).trunc(u8)
        expect(ok(c.send(b[..])) is 1)
    }
    while total < 200 {
        n := ok(s.recv(buf[..]))
        for j in 0..n {
            want := ((total + j) % 251).trunc(u8)
            expect(buf[j] is want)
        }
        total += n
    }
    expect(s.recv(buf[..]) is !.WouldBlock)
}
