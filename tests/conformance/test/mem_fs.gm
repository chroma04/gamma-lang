//! stage: test
// Tests run with an in-memory file system as the handler of `Fs` (§12.9): every test
// starts with an empty one, and nothing it creates is visible to the next test.
time :: import "std/time"
fs :: import "std/fs"

WRITE :: fs.OpenOptions(read: false, write: true, create: true, truncate: true)

put :: fn(path: string, text: string) -> IoError!() needs Fs {
    f := try Fs.open(path, WRITE)
    defer f.close()
    n := try f.write(text)
    if n is not text.len { return !.NoSpace }
}

// Reads a whole file into `buf` and returns its length.
slurp :: fn(path: string, buf: []u8) -> IoError!usize needs Fs {
    f := try Fs.open(path, fs.OpenOptions())
    defer f.close()
    total: usize = 0
    while true {
        n := try f.read(buf[total..])
        if n is 0 { break }
        total += n
    }
    return total
}

// True if the file at `path` holds exactly `text`.
holds :: fn(path: string, text: string) -> IoError!bool needs Fs {
    buf: [256]u8 = ---
    n := try slurp(path, buf[..])
    return buf[0..n] is text
}

// The number of entries of a directory, and whether `name` is one of them.
Listing :: struct { count: usize, found: bool }

list_dir :: fn(path: string, name: string) -> IoError!Listing needs Fs {
    d := try Fs.open_dir(path)
    defer d.close_dir()
    buf: [32]u8 = ---
    out := Listing(count: 0, found: false)
    while true {
        e := (try d.next_entry(buf[..])) else break
        n := e.len
        out.count += 1
        if buf[0..n] is name { out.found = true }
    }
    return out
}

test "a written file reads back" {
    ok(put("greeting.txt", "hello, world"))
    expect(ok(holds("greeting.txt", "hello, world")))
    expect(not ok(holds("greeting.txt", "hello")))
    info := ok(Fs.stat("greeting.txt"))
    expect(info.size is 12)
    expect(info.kind is .File)
    print("size {}\n", info.size)
}

test "the root is an empty directory" {
    info := ok(Fs.stat("/"))
    expect(info.kind is .Dir)
    expect(info.size is 0)
    expect((ok(Fs.stat(""))).kind is .Dir)
    l := ok(list_dir("/", ""))
    expect(l.count is 0)
}

test "modified is the fake clock at the last write" {
    Clock.sleep(time.secs(5))
    ok(put("a", "x"))
    t0 := Clock.wall()
    expect((ok(Fs.stat("a"))).modified is t0)
    Clock.sleep(time.secs(2))
    expect((ok(Fs.stat("a"))).modified is t0)
    f := ok(Fs.open("a", fs.OpenOptions(read: false, write: true)))
    _ = ok(f.write("y"))
    f.close()
    expect((ok(Fs.stat("a"))).modified is t0 + 2_000_000_000)
    expect((ok(Fs.stat("a"))).modified is Clock.wall())
}

test "paths are normalized" {
    ok(Fs.make_dir("a"))
    ok(Fs.make_dir("/a/b"))
    ok(put("a//b/./c", "deep"))
    expect(ok(holds("a/b/c", "deep")))
    expect(ok(holds("/a/b/c", "deep")))
    expect(ok(holds("./a/./b//c/", "deep")))
    expect((ok(Fs.stat("a/b"))).kind is .Dir)
    expect(Fs.open("a/../a/b/c", fs.OpenOptions()) is !.InvalidInput)
    expect(Fs.stat("..") is !.InvalidInput)
}

test "opening a missing file" {
    expect(Fs.open("nothing", fs.OpenOptions()) is !.NotFound)
    expect(Fs.open("no/dir/file", fs.OpenOptions(write: true, create: true)) is !.NotFound)
    expect(Fs.open("nothing", fs.OpenOptions(read: false, write: true)) is !.NotFound)
    expect(Fs.stat("nothing") is !.NotFound)
    // Nothing was created by the failed attempts.
    expect(Fs.stat("nothing") is !.NotFound)
    expect(Fs.stat("no") is !.NotFound)
}

test "create, exclusive and truncate" {
    f := ok(Fs.open("f", fs.OpenOptions(read: false, write: true, create: true)))
    _ = ok(f.write("abcdef"))
    f.close()
    // `create` on an existing file keeps its contents.
    g := ok(Fs.open("f", fs.OpenOptions(read: false, write: true, create: true)))
    g.close()
    expect(ok(holds("f", "abcdef")))
    expect(Fs.open("f", fs.OpenOptions(write: true, exclusive: true)) is !.AlreadyExists)
    expect(Fs.open("f", fs.OpenOptions(write: true, create: true, exclusive: true)) is !.AlreadyExists)
    h := ok(Fs.open("fresh", fs.OpenOptions(write: true, exclusive: true)))
    h.close()
    expect((ok(Fs.stat("fresh"))).size is 0)
    expect(Fs.open("fresh", fs.OpenOptions(write: true, exclusive: true)) is !.AlreadyExists)
    t := ok(Fs.open("f", fs.OpenOptions(write: true, truncate: true)))
    t.close()
    expect((ok(Fs.stat("f"))).size is 0)
}

test "append writes go to the end" {
    ok(put("log", "one"))
    f := ok(Fs.open("log", fs.OpenOptions(read: false, append: true)))
    defer f.close()
    _ = ok(f.seek(0, .Start))
    _ = ok(f.write(",two"))
    _ = ok(f.seek(0, .Start))
    _ = ok(f.write(",three"))
    expect(ok(holds("log", "one,two,three")))
}

test "access modes are enforced" {
    ok(put("f", "data"))
    buf: [4]u8 = ---
    w := ok(Fs.open("f", fs.OpenOptions(read: false, write: true)))
    expect(w.read(buf[..]) is !.Other(9))
    w.close()
    r := ok(Fs.open("f", fs.OpenOptions()))
    expect(r.write("x") is !.Other(9))
    expect(r.read(buf[..]) is 4)
    r.close()
    a := ok(Fs.open("f", fs.OpenOptions(read: false, append: true)))
    expect(a.read(buf[..]) is !.Other(9))
    a.close()
    rw := ok(Fs.open("f", fs.OpenOptions(write: true)))
    expect(rw.read(buf[..]) is 4)
    expect(rw.write("x") is 1)
    rw.close()
    expect(ok(holds("f", "datax")))
}

test "each handle has its own position" {
    ok(put("f", "0123456789"))
    a := ok(Fs.open("f", fs.OpenOptions()))
    b := ok(Fs.open("f", fs.OpenOptions()))
    buf: [4]u8 = ---
    expect(a.read(buf[..]) is 4)
    expect(buf[0] is '0')
    expect(a.read(buf[..]) is 4)
    expect(buf[0] is '4')
    expect(b.read(buf[..]) is 4)
    expect(buf[0] is '0')
    expect(a.read(buf[..]) is 2)
    expect(buf[1] is '9')
    expect(a.read(buf[..]) is 0)
    expect(b.read(buf[..]) is 4)
    expect(buf[0] is '4')
    a.close()
    b.close()
}

test "seek from the start, the current position and the end" {
    ok(put("f", "0123456789"))
    f := ok(Fs.open("f", fs.OpenOptions(write: true)))
    defer f.close()
    buf: [3]u8 = ---
    expect(f.seek(4, .Start) is 4)
    expect(f.read(buf[..]) is 3)
    expect(buf[0] is '4')
    expect(f.seek(-2, .Current) is 5)
    expect(f.read(buf[..]) is 3)
    expect(buf[0] is '5')
    expect(f.seek(0, .Current) is 8)
    expect(f.seek(-1, .End) is 9)
    expect(f.read(buf[..]) is 1)
    expect(buf[0] is '9')
    expect(f.seek(0, .End) is 10)
    expect(f.read(buf[..]) is 0)
    expect(f.seek(100, .Start) is 100)
    expect(f.read(buf[..]) is 0)
    expect(f.seek(-1, .Start) is !.InvalidInput)
    expect(f.seek(-11, .End) is !.InvalidInput)
    expect(f.seek(-101, .Current) is !.InvalidInput)
    // A failed seek leaves the position alone.
    expect(f.seek(0, .Current) is 100)
}

test "writing past the end fills the gap with zeros" {
    ok(put("f", "ab"))
    f := ok(Fs.open("f", fs.OpenOptions(write: true)))
    _ = ok(f.seek(5, .Start))
    _ = ok(f.write("cd"))
    f.close()
    buf: [16]u8 = ---
    n := ok(slurp("f", buf[..]))
    expect(n is 7)
    expect(buf[0..n] is "ab\0\0\0cd")
    expect((ok(Fs.stat("f"))).size is 7)
    // Overwriting in the middle does not change the size.
    g := ok(Fs.open("f", fs.OpenOptions(write: true)))
    _ = ok(g.seek(1, .Start))
    _ = ok(g.write("XY"))
    g.close()
    n = ok(slurp("f", buf[..]))
    expect(buf[0..n] is "aXY\0\0cd")
}

test "making directories" {
    ok(Fs.make_dir("d"))
    expect(Fs.make_dir("d") is !.AlreadyExists)
    expect(Fs.make_dir("/") is !.AlreadyExists)
    expect(Fs.make_dir("x/y") is !.NotFound)
    ok(put("file", "x"))
    expect(Fs.make_dir("file") is !.AlreadyExists)
    expect(Fs.make_dir("file/sub") is !.Other(20))
    expect(Fs.open("file/sub", fs.OpenOptions(write: true, create: true)) is !.Other(20))
    expect(Fs.stat("file/sub") is !.Other(20))
    ok(Fs.make_dir("d/e"))
    expect((ok(Fs.stat("d/e"))).kind is .Dir)
    // A file cannot be created over a directory, nor a directory written.
    expect(Fs.open("d", fs.OpenOptions(read: false, write: true)) is !.Other(21))
    expect(Fs.open("d", fs.OpenOptions(write: true, create: true)) is !.Other(21))
    expect(Fs.open("d", fs.OpenOptions(write: true, truncate: true)) is !.Other(21))
    expect(Fs.open("d", fs.OpenOptions(write: true, exclusive: true)) is !.AlreadyExists)
    // It can be opened for reading, but not read.
    f := ok(Fs.open("d", fs.OpenOptions()))
    buf: [4]u8 = ---
    expect(f.read(buf[..]) is !.Other(21))
    f.close()
}

test "removing files" {
    ok(put("f", "x"))
    ok(Fs.make_dir("d"))
    expect(Fs.remove("nothing") is !.NotFound)
    expect(Fs.remove("d") is !.Other(21))
    expect(Fs.remove("/") is !.Other(21))
    expect(Fs.remove("f/g") is !.Other(20))
    ok(Fs.remove("f"))
    expect(Fs.stat("f") is !.NotFound)
    expect(Fs.remove("f") is !.NotFound)
    expect((ok(Fs.stat("d"))).kind is .Dir)
}

test "an open file survives its removal" {
    ok(put("f", "still here"))
    f := ok(Fs.open("f", fs.OpenOptions()))
    ok(Fs.remove("f"))
    expect(Fs.stat("f") is !.NotFound)
    buf: [16]u8 = ---
    expect(f.read(buf[..]) is 10)
    f.close()
    // The name can be used again.
    ok(put("f", "new"))
    expect(ok(holds("f", "new")))
}

test "removing directories" {
    ok(Fs.make_dir("d"))
    ok(Fs.make_dir("d/e"))
    ok(put("d/e/f", "x"))
    expect(Fs.remove_dir("nothing") is !.NotFound)
    expect(Fs.remove_dir("d") is !.Other(39))
    expect(Fs.remove_dir("d/e") is !.Other(39))
    expect(Fs.remove_dir("d/e/f") is !.Other(20))
    expect(Fs.remove_dir("/") is !.Other(16))
    ok(Fs.remove("d/e/f"))
    ok(Fs.remove_dir("d/e"))
    expect(Fs.stat("d/e") is !.NotFound)
    ok(Fs.remove_dir("d"))
    expect(Fs.stat("d") is !.NotFound)
    // Removing the entries one by one empties the root again.
    expect((ok(list_dir("/", ""))).count is 0)
}

test "renaming files" {
    ok(put("a", "aaa"))
    ok(put("b", "bbbb"))
    ok(Fs.make_dir("d"))
    ok(Fs.rename("a", "c"))
    expect(Fs.stat("a") is !.NotFound)
    expect(ok(holds("c", "aaa")))
    // An existing file at the destination is replaced.
    ok(Fs.rename("c", "b"))
    expect(Fs.stat("c") is !.NotFound)
    expect(ok(holds("b", "aaa")))
    expect((ok(Fs.stat("b"))).size is 3)
    // Into a directory, and onto itself.
    ok(Fs.rename("b", "d/moved"))
    expect(ok(holds("d/moved", "aaa")))
    ok(Fs.rename("d/moved", "d/./moved"))
    expect(ok(holds("d/moved", "aaa")))
    expect(Fs.rename("nothing", "x") is !.NotFound)
    expect(Fs.rename("d/moved", "nodir/x") is !.NotFound)
    expect(Fs.rename("d/moved", "d") is !.Other(21))
    expect(Fs.rename("d", "d/moved") is !.InvalidInput)
    expect(Fs.rename("d/moved", "d/moved/x") is !.Other(20))
    ok(Fs.make_dir("e"))
    expect(Fs.rename("e", "d") is !.Other(39))
    expect(Fs.rename("/", "x") is !.Other(16))
    expect(ok(holds("d/moved", "aaa")))
}

test "renaming directories moves their contents" {
    ok(Fs.make_dir("src"))
    ok(Fs.make_dir("src/sub"))
    ok(put("src/one", "1"))
    ok(put("src/sub/two", "22"))
    ok(Fs.rename("src", "dst"))
    expect(Fs.stat("src") is !.NotFound)
    expect(Fs.stat("src/one") is !.NotFound)
    expect(ok(holds("dst/one", "1")))
    expect(ok(holds("dst/sub/two", "22")))
    expect((ok(list_dir("dst", "one"))).count is 2)
    // A directory replaces an empty directory but not a file or a full one.
    ok(Fs.make_dir("empty"))
    ok(Fs.rename("dst", "empty"))
    expect(ok(holds("empty/sub/two", "22")))
    ok(put("file", "f"))
    ok(Fs.make_dir("other"))
    ok(put("other/x", "x"))
    expect(Fs.rename("empty", "file") is !.Other(20))
    expect(Fs.rename("empty", "other") is !.Other(39))
    // Not into itself.
    expect(Fs.rename("empty", "empty/sub/inside") is !.InvalidInput)
    expect(Fs.rename("empty", "empty/inside") is !.InvalidInput)
    expect(ok(holds("empty/sub/two", "22")))
}

test "listing a directory" {
    ok(Fs.make_dir("d"))
    ok(Fs.make_dir("d/sub"))
    ok(put("d/a.txt", "a"))
    ok(put("d/b.txt", "b"))
    ok(put("d/sub/deep", "x"))
    seen: u8 = 0
    d := ok(Fs.open_dir("d"))
    buf: [16]u8 = ---
    count: usize = 0
    while true {
        e := (ok(d.next_entry(buf[..]))) else break
        n := e.len
        count += 1
        which: usize = 3
        if buf[0..n] is "a.txt" { which = 0 }
        if buf[0..n] is "b.txt" { which = 1 }
        if buf[0..n] is "sub" { which = 2 }
        expect(which < 3, "an unexpected entry")
        expect(seen & (1 << which) is 0, "an entry was listed twice")
        seen |= 1 << which
    }
    // After the last entry it keeps returning null.
    expect(d.next_entry(buf[..]) is null)
    d.close_dir()
    expect(count is 3)
    expect(seen is 7)
    print("{} entries\n", count)
    expect(Fs.open_dir("nothing") is !.NotFound)
    expect(Fs.open_dir("d/a.txt") is !.Other(20))
    expect((ok(list_dir("d/sub", "deep"))).found)
}

test "a name longer than the buffer" {
    ok(put("a-rather-long-name", "x"))
    d := ok(Fs.open_dir("/"))
    defer d.close_dir()
    small: [4]u8 = ---
    expect(d.next_entry(small[..]) is !.InvalidInput)
    big: [32]u8 = ---
    if e := ok(d.next_entry(big[..])) {
        expect(e.len is 18)
        expect(e.kind is .File)
    } else {
        expect(false, "the entry is there")
    }
    expect(d.next_entry(big[..]) is null)
}

test "closed and unknown handles" {
    ok(put("f", "x"))
    buf: [4]u8 = ---
    f := ok(Fs.open("f", fs.OpenOptions(write: true)))
    f.close()
    expect(f.read(buf[..]) is !.Other(9))
    expect(f.write("y") is !.Other(9))
    expect(f.seek(0, .Start) is !.Other(9))
    f.close()
    // A new handle is a different one.
    g := ok(Fs.open("f", fs.OpenOptions()))
    expect(f.read(buf[..]) is !.Other(9))
    expect(g.read(buf[..]) is 1)
    g.close()
    d := ok(Fs.open_dir("/"))
    d.close_dir()
    expect(d.next_entry(buf[..]) is !.Other(9))
    d.close_dir()
}

test "the file system is fresh in every test: write" {
    ok(put("leftover.txt", "from the previous test"))
    ok(Fs.make_dir("leftover-dir"))
    expect(ok(holds("leftover.txt", "from the previous test")))
}

test "the file system is fresh in every test: read" {
    expect(Fs.stat("leftover.txt") is !.NotFound)
    expect(Fs.stat("leftover-dir") is !.NotFound)
    expect((ok(list_dir("/", ""))).count is 0)
}

test "many files" {
    ok(Fs.make_dir("many"))
    name: [16]u8 = ---
    for i in 0..200 {
        s := format_name(name[..], i)
        f := ok(Fs.open(s, fs.OpenOptions(read: false, write: true, create: true, exclusive: true)))
        _ = ok(f.write(s[5..]))
        f.close()
    }
    expect((ok(list_dir("many", ""))).count is 200)
    for i in 0..200 {
        s := format_name(name[..], i)
        expect(ok(holds(s, s[5..])))
    }
    expect((ok(list_dir("many", "f0042"))).found)
    expect((ok(list_dir("many", "f0199"))).found)
    expect(not (ok(list_dir("many", "f0200"))).found)
    // Remove half of them, then add some more that reuse the space.
    for i in 0..100 {
        ok(Fs.remove(format_name(name[..], i * 2)))
    }
    expect((ok(list_dir("many", ""))).count is 100)
    for i in 200..250 {
        ok(put(format_name(name[..], i), "new"))
    }
    expect((ok(list_dir("many", ""))).count is 150)
    expect(Fs.stat(format_name(name[..], 42)) is !.NotFound)
    expect(ok(holds(format_name(name[..], 43), "f0043")))
    expect(ok(holds(format_name(name[..], 249), "new")))
    print("many ok\n")
}

// "many/fNNNN" in `buf`.
format_name :: fn(buf: []u8, i: usize) -> string {
    prefix := "many/f"
    buf[0..prefix.len].copy_from(prefix)
    buf[6] = '0' + (i / 1000).trunc(u8)
    buf[7] = '0' + (i / 100 % 10).trunc(u8)
    buf[8] = '0' + (i / 10 % 10).trunc(u8)
    buf[9] = '0' + (i % 10).trunc(u8)
    return buf[0..10]
}

test "large writes and reads" {
    f := ok(Fs.open("big", WRITE))
    chunk: [100]u8 = ---
    chunk[..].fill('z')
    for i in 0..50 {
        _ = ok(f.write(chunk[..]))
    }
    f.close()
    expect((ok(Fs.stat("big"))).size is 5000)
    r := ok(Fs.open("big", fs.OpenOptions()))
    defer r.close()
    total: usize = 0
    while true {
        n := ok(r.read(chunk[..]))
        if n is 0 { break }
        total += n
    }
    expect(total is 5000)
}

test "other effects still work next to the file system" {
    ok(put("f", "x"))
    Clock.sleep(time.ms(1))
    expect(Clock.now().ns is 1_000_000)
    l := list(u8)
    defer l.deinit()
    ok(l.push(7))
    expect(l.items.len is 1)
}
