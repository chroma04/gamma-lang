//! stage: test
// Growable text: `List(u8).write`, `into_slice`, `collect`, `dupe` and `str.format`
// (§21.2, §21.5), with the test allocator checking that nothing leaks.
str :: import "std/str"

test "write appends formatted text" {
    l := list(u8)
    defer l.deinit()
    ok(l.write("{}={:>3};", ("a", 1)))
    ok(l.write("{:.2}", 0.5))
    ok(l.write("!"))
    expect(l.items is "a=  1;0.50!")
}

test "into_slice hands over the storage" {
    l := list(u8)
    ok(l.write("hello, {}", "world"))
    s := ok(l.into_slice())
    expect(s is "hello, world")
    expect(l.items.len is 0)
    free(s)
    empty := list(i32)
    z := ok(empty.into_slice())
    expect(z.len is 0)
}

test "collect gathers an iterator" {
    m := map(u32, u32)
    defer m.deinit()
    for i in 0u32..5 { ok(m.put(i, i * i)) }
    vs := list(u32)
    defer vs.deinit()
    ok(vs.collect(fn() => m.values()))
    vs.items.sort()
    want := [_]u32(0, 1, 4, 9, 16)
    expect(vs.items is want[..])
}

test "dupe copies" {
    a := ok(dupe("text"))
    defer free(a)
    b := ok(dupe([_]u16(7, 8)))
    defer free(b)
    expect(a is "text" and b[1] is 8)
}

test "format allocates" {
    s := ok(str.format("{:x}/{}", (255, true)))
    defer free(s)
    expect(s is "ff/true")
}
