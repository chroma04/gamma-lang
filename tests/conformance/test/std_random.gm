//! stage: test
// std/random under the test handlers: the fixed-seed `Rand` makes the helpers repeatable,
// and a seeded generator installed with `with` overrides it.
random :: import "std/random"

test "ambient draws differ from each other" {
    a := random.next_u64()
    b := random.next_u64()
    assert(a is not b, "consecutive draws differ")
    r := random.from_rand()
    s := random.from_rand()
    assert(random.next(&r) is not random.next(&s), "seeds differ")
}

test "an installed generator overrides the ambient one" {
    r := random.seeded(5)
    s := random.seeded(5)
    x := with &r { random.next_u64() }
    assert(x is random.next(&s), "same as drawing directly")
}

test "helpers are reproducible under a seed" {
    r := random.seeded(11)
    s := random.seeded(11)
    xs: [16]u32 = ---
    ys: [16]u32 = ---
    with &r { for i in 0..16 { xs[i] = random.below(T: u32, 1000) } }
    with &s { for i in 0..16 { ys[i] = random.below(T: u32, 1000) } }
    assert(xs is ys, "same draws")
}

test "wide integer ranges use every bit" {
    r := random.seeded(7)
    with &r {
        big: u128 = 1 << 100
        upper := 0
        for _ in 0..1000 {
            x := random.below(big)
            assert(x < big, "below n")
            if x >= big / 2 { upper += 1 }
        }
        assert(upper > 400 and upper < 600, "the upper half is drawn too")
        negative := 0
        for _ in 0..1000 {
            y := random.range(T: i128, -(1 << 120), 1 << 120)
            assert(y >= -(1 << 120) and y < 1 << 120, "in range")
            if y < 0 { negative += 1 }
        }
        assert(negative > 400 and negative < 600, "both signs are drawn")
        assert(random.range(T: i128, @min_value(i128), @max_value(i128)) < @max_value(i128), "full span")
        assert(random.below(T: u128, 1) is 0, "one value")
    }
}
