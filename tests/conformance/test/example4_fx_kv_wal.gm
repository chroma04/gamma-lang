//! stage: test
// A key-value store behind a Kv effect with an in-memory and a file-backed handler: write-ahead log, crash recovery, torn and corrupt records, snapshot compaction on the in-memory file system.
fs :: import "std/fs"
str :: import "std/str"

KEY_MAX :: 16
WAL :: "kv.wal"
SNAP :: "kv.snap"
SNAP_TMP :: "kv.snap.tmp"

KvError :: union { Io: IoError, Mem: AllocError, KeyTooLong }

Key :: struct {
    bytes: [KEY_MAX]u8
    len: usize
}

key_of :: fn(s: string) -> KvError!Key {
    if s.len > KEY_MAX { return !.KeyTooLong }
    k := Key(bytes: [KEY_MAX]u8(fill: 0), len: s.len)
    for i in 0..s.len { k.bytes[i] = s[i] }
    return k
}

Entry :: struct {
    key: Key
    val: i64
}

Kv :: effect {
    put: fn(key: string, val: i64) -> KvError!()
    get: fn(key: string) -> ?i64
    del: fn(key: string) -> KvError!bool
    size: fn() -> usize
}

// ---- The in-memory handler ------------------------------------------------------

MemKv :: struct {
    m: HashMap(Key, i64)
}

mem_new :: fn() -> MemKv \ {Alloc} => MemKv(m: hash_map(Key, i64))

mem_put :: fn(s: ^MemKv, key: string, val: i64) -> KvError!() {
    k := try key_of(key)
    try s.m.put(k, val)
}

mem_get :: fn(s: ^MemKv, key: string) -> ?i64 {
    k := key_of(key) else return null
    return s.m.get(k)
}

mem_del :: fn(s: ^MemKv, key: string) -> KvError!bool {
    k := try key_of(key)
    if s.m.remove(k) is null { return false }
    return true
}

handler Kv for ^MemKv {
    put(self, key, val) => mem_put(self, key, val)
    get(self, key) => mem_get(self, key)
    del(self, key) => mem_del(self, key)
    size(self) => self.m.len()
}

// Live entries sorted by key.
sorted_entries :: fn(s: ^MemKv) -> KvError!List(Entry) \ {Alloc} {
    l := list(Entry)
    errdefer l.deinit()
    for e in s.m.entries() {
        try l.push(Entry(key: e.key, val: e.value))
    }
    l.items.sort_by(fn(a, b: ^const Entry) -> bool {
        n := a.key.len.min(b.key.len)
        for i in 0..n {
            if a.key.bytes[i] is not b.key.bytes[i] { return a.key.bytes[i] < b.key.bytes[i] }
        }
        return a.key.len < b.key.len
    })
    return l
}

// "a=1 b=2" for the whole store, in key order.
describe :: fn(s: ^MemKv, out: []u8) -> string \ {Alloc} {
    b := str.builder(out)
    l := sorted_entries(s) else return "?"
    defer l.deinit()
    for e in l.items {
        if b.len() > 0 { b.push(" ") }
        b.write("{}={}", e.key.bytes[0..e.key.len], e.val)
    }
    return b.str()
}

// ---- The file-backed handler ----------------------------------------------------

checksum :: fn(s: string) -> u32 {
    h: u32 = 2166136261
    for c in bytes(s) { h = (h ~ u32(c)) *% 16777619 }
    return h
}

// Appends "<body> #<checksum>\n" to `path`.
append_record :: fn(path: string, body: string) -> KvError!() \ {Fs} {
    buf: [128]u8 = ---
    b := str.builder(buf[..])
    b.write("{} #{}\n", body, checksum(body))
    try fs.append(path, b.str())
}

DiskKv :: struct {
    mem: MemKv
    records: u32 = 0           // records in the log since the last compaction
}

handler Kv for ^DiskKv \ {Fs} {
    put(self, key, val) => {
        _ = try key_of(key)          // reject bad keys before they reach the log
        buf: [96]u8 = ---
        b := str.builder(buf[..])
        b.write("SET {} {}", key, val)
        // Log first, then apply: a crash in between loses nothing that was acknowledged.
        try append_record(WAL, b.str())
        self.records += 1
        try mem_put(&self.mem, key, val)
    }
    get(self, key) => mem_get(&self.mem, key)
    del(self, key) => {
        buf: [96]u8 = ---
        b := str.builder(buf[..])
        b.write("DEL {}", key)
        try append_record(WAL, b.str())
        self.records += 1
        return try mem_del(&self.mem, key)
    }
    size(self) => self.mem.m.len()
}

Report :: struct {
    applied: u32 = 0
    torn: bool = false         // the log ended in a partial record
    bad: bool = false          // a record failed its checksum or did not parse
    valid_len: usize = 0       // bytes of the log that are good
}

// Applies the records in `data` to `mem` until the first bad one.
replay :: fn(mem: ^MemKv, data: string, rep: ^Report) -> KvError!() {
    rest := data
    while rest.len > 0 {
        nl := str.find(rest, "\n") else {
            rep.torn = true
            break
        }
        line := rest[0..nl]
        parts := str.split_once(line, " #") else {
            rep.bad = true
            break
        }
        crc := str.parse_int(u32, parts.after) else {
            rep.bad = true
            break
        }
        if crc is not checksum(parts.before) {
            rep.bad = true
            break
        }
        f: [3]string = [3]string(fill: "")
        n: usize = 0
        for w in str.fields(parts.before) {
            if n < 3 { f[n] = w }
            n += 1
        }
        if f[0] is "SET" and n is 3 {
            v := str.parse_int(i64, f[2]) else {
                rep.bad = true
                break
            }
            try mem_put(mem, f[1], v)
        } else if f[0] is "DEL" and n is 2 {
            _ = try mem_del(mem, f[1])
        } else {
            rep.bad = true
            break
        }
        rep.applied += 1
        rep.valid_len += nl + 1
        rest = rest[nl + 1..rest.len]
    }
}

// The contents of a file, which the caller frees.
read_whole :: fn(path: string) -> KvError![]u8 \ {Fs, Alloc} {
    data := fs.read_all(path) else e => {
        match e {
            .Io(io) => return !.Io(io)
            .Alloc(a) => return !.Mem(a)
        }
    }
    return data
}

// Like read_whole, but a missing file is `null`.
slurp :: fn(path: string) -> KvError!?[]u8 \ {Fs, Alloc} {
    if not fs.exists(path) { return null }
    return try read_whole(path)
}

// Opens the database: snapshot first, then the log; a damaged log tail is cut off.
recover :: fn(rep: ^Report) -> KvError!DiskKv \ {Fs, Alloc} {
    db := DiskKv(mem: mem_new())
    snap_rep := Report()
    if data := try slurp(SNAP) {
        defer free(data)
        try replay(&db.mem, data, &snap_rep)
    }
    if data := try slurp(WAL) {
        defer free(data)
        try replay(&db.mem, data, rep)
        if rep.torn or rep.bad {
            try fs.write_all(WAL, data[0..rep.valid_len])
        }
    }
    rep.applied += snap_rep.applied
    db.records = rep.applied - snap_rep.applied
    return db
}

CrashPoint :: union { Never, AfterTmp, AfterRename }

// Writes a snapshot of the live entries, atomically replaces the old one, then empties the log.
compact :: fn(db: ^DiskKv, crash: CrashPoint) -> KvError!bool \ {Fs, Alloc} {
    l := try sorted_entries(&db.mem)
    defer l.deinit()
    try fs.write_all(SNAP_TMP, "")
    for e in l.items {
        buf: [96]u8 = ---
        b := str.builder(buf[..])
        b.write("SET {} {}", e.key.bytes[0..e.key.len], e.val)
        try append_record(SNAP_TMP, b.str())
    }
    if crash is .AfterTmp { return false }
    try Fs.rename(SNAP_TMP, SNAP)
    if crash is .AfterRename { return false }
    try fs.write_all(WAL, "")
    db.records = 0
    return true
}

// ---- A workload that works with any Kv handler -----------------------------------

workload :: fn() -> KvError!u32 \ {Kv} {
    try put("apple", 3)
    try put("pear", 10)
    try put("fig", 7)
    try put("apple", 4)
    if try del("pear") { /* removed */ }
    try put("kiwi", -2)
    _ = try del("nothing")
    sum: u32 = 0
    if v := get("apple") { sum += v.trunc(u32) }
    if v := get("fig") { sum += v.trunc(u32) }
    return sum + size().trunc(u32)
}

fresh :: fn() -> DiskKv \ {Alloc} => DiskKv(mem: mem_new())

test "the same workload runs against both handlers" {
    mem := mem_new()
    defer mem.m.deinit()
    a := ok(with &mem { workload() })
    disk := fresh()
    defer disk.mem.m.deinit()
    b := ok(with &disk { workload() })
    expect(a is 14)           // apple 4 + fig 7 + three live keys
    expect(b is 14)
    buf: [64]u8 = ---
    expect(describe(&mem, buf[..]) is "apple=4 fig=7 kiwi=-2")
    expect(describe(&disk.mem, buf[..]) is "apple=4 fig=7 kiwi=-2")
    expect(disk.records is 7)
    // The log is plain text with a checksum on every line.
    data := ok(read_whole(WAL))
    defer free(data)
    expect(data.starts_with("SET apple 3 #"))
}

test "recovery replays the log after a crash" {
    db := fresh()
    _ = ok(with &db { workload() })
    buf: [64]u8 = ---
    expect(describe(&db.mem, buf[..]) is "apple=4 fig=7 kiwi=-2")
    // The process dies: the in-memory state is gone, the files stay.
    db.mem.m.deinit()
    rep := Report()
    db2 := ok(recover(&rep))
    defer db2.mem.m.deinit()
    expect(rep.applied is 7)
    expect(not rep.torn and not rep.bad)
    expect(describe(&db2.mem, buf[..]) is "apple=4 fig=7 kiwi=-2")
    // The recovered store keeps logging to the same file.
    with &db2 { ok(put("plum", 1)) }
    expect(db2.records is 8)
}

test "a torn last record is dropped and the log repaired" {
    db := fresh()
    with &db {
        ok(put("a", 1))
        ok(put("b", 2))
        ok(put("c", 3))
    }
    db.mem.m.deinit()
    // Tear the last record in half, as a power cut would.
    data := ok(read_whole(WAL))
    cut := data.len - 6
    ok(fs.write_all(WAL, data[0..cut]))
    free(data)
    rep := Report()
    db2 := ok(recover(&rep))
    defer db2.mem.m.deinit()
    expect(rep.applied is 2)
    expect(rep.torn)
    expect(not rep.bad)
    buf: [64]u8 = ---
    expect(describe(&db2.mem, buf[..]) is "a=1 b=2")
    // The repair cut the log back to the last good record.
    info := ok(Fs.stat(WAL))
    expect(info.size.trunc(usize) is rep.valid_len)
    rep2 := Report()
    db3 := ok(recover(&rep2))
    defer db3.mem.m.deinit()
    expect(rep2.applied is 2 and not rep2.torn)
}

test "a corrupt record stops the replay" {
    db := fresh()
    with &db {
        ok(put("x", 10))
        ok(put("y", 20))
        ok(put("z", 30))
    }
    db.mem.m.deinit()
    data := ok(read_whole(WAL))
    // Flip one digit of the second record's value: the checksum no longer matches.
    at := str.find(data, "SET y 20") else trap("record not found")
    data[at + 6] = '9'
    ok(fs.write_all(WAL, data))
    free(data)
    rep := Report()
    db2 := ok(recover(&rep))
    defer db2.mem.m.deinit()
    expect(rep.applied is 1)
    expect(rep.bad)
    buf: [64]u8 = ---
    expect(describe(&db2.mem, buf[..]) is "x=10")
}

test "compaction shrinks the log and survives crashes at every step" {
    db := fresh()
    with &db {
        for i in 0..40 {
            kbuf: [8]u8 = ---
            b := str.builder(kbuf[..])
            b.write("k{}", i % 5)
            ok(put(b.str(), i.trunc(i64)))
        }
        _ = ok(del("k3"))
    }
    expect(db.records is 41)
    buf: [96]u8 = ---
    want := "k0=35 k1=36 k2=37 k4=39"
    expect(describe(&db.mem, buf[..]) is want)
    before := (ok(Fs.stat(WAL))).size

    // Crash 1: the temporary snapshot is written but never renamed.
    expect(not ok(compact(&db, .AfterTmp)))
    rep := Report()
    r1 := ok(recover(&rep))
    expect(describe(&r1.mem, buf[..]) is want)
    expect(rep.applied is 41)
    r1.mem.m.deinit()

    // Crash 2: the snapshot is in place but the log still holds every record.
    expect(not ok(compact(&db, .AfterRename)))
    rep = Report()
    r2 := ok(recover(&rep))
    expect(describe(&r2.mem, buf[..]) is want)
    expect(rep.applied is 45)         // four snapshot records, then the log replayed over them
    r2.mem.m.deinit()

    // A clean compaction.
    expect(ok(compact(&db, .Never)))
    expect(db.records is 0)
    after := (ok(Fs.stat(WAL))).size
    expect(before > 500 and after is 0)
    rep = Report()
    r3 := ok(recover(&rep))
    defer r3.mem.m.deinit()
    expect(rep.applied is 4)
    expect(describe(&r3.mem, buf[..]) is want)
    with &r3 { ok(put("k9", 99)) }
    expect(r3.records is 1)
    db.mem.m.deinit()
}

test "keys longer than the limit are rejected before they are logged" {
    db := fresh()
    defer db.mem.m.deinit()
    r := with &db { put("this key is much too long", 1) }
    expect(r is !.KeyTooLong)
    expect(not fs.exists(WAL))
    expect(db.records is 0)
}
