//! stage: test
// std/time/zone: loading zones through the in-memory file system, the names `load` rejects,
// `local` under a scripted environment, and allocation: the test allocator reports a zone
// that is not released, and a full fixed buffer is reported as an error without a leak.
// The fixtures come from tools/gen_tzif_fixtures.py.
zone :: import "std/time/zone"
time :: import "std/time"
fs :: import "std/fs"
hex :: import "std/encoding/hex"
fixed_buffer :: import "std/fixed_buffer"

PARIS :: ""
NEW_YORK :: ""
KOLKATA :: ""
APIA :: ""
NO_FOOTER :: ""

// A scripted process environment.
Vars :: struct {
    tz: ?string = null
    tzdir: ?string = null
}

handler Env for ^Vars {
    args(self) => empty_slice(string)
    var(self, name) => {
        found: ?string = null
        if name is "TZ" { found = self.tz }
        if name is "TZDIR" { found = self.tzdir }
        found
    }
    exit(self, code) => break
}

// Writes the fixture `text` to `path`, making the directories above it.
install :: fn(path: string, text: string) needs Fs + Test {
    raw: [2048]u8 = ---
    bytes := ok(hex.decode(text, raw[..]))
    cut: usize = 0
    for i in 0..path.len {
        if path[i] is '/' { cut = i }
    }
    if cut > 0 { ok(fs.make_dir_all(path[0..cut])) }
    ok(fs.write_all(path, bytes))
}

at :: fn(text: string) -> i64 needs Test {
    return zone.secs_from_datetime(ok(time.parse_rfc3339(text)))
}

offset :: fn(z: ^const zone.Zone, text: string) -> i32 needs Test {
    return zone.offset_at(z, at(text)).seconds
}

test "load_from reads a zone from a directory" {
    install("/db/Europe/Paris", PARIS)
    p := ok(zone.load_from("/db", "Europe/Paris"))
    defer zone.deinit(&p)
    expect_eq(offset(&p, "2024-07-01T00:00:00Z"), 7200)
    expect_eq(offset(&p, "2024-01-01T00:00:00Z"), 3600)
    expect_eq(zone.offset_at(&p, at("2024-07-01T00:00:00Z")).abbreviation, "CEST")
    // A trailing slash on the directory makes no difference.
    q := ok(zone.load_from("/db/", "Europe/Paris"))
    defer zone.deinit(&q)
    expect_eq(offset(&q, "2024-07-01T00:00:00Z"), 7200)
}

test "load_from reports a missing zone and malformed data" {
    install("/db/Broken", NO_FOOTER)
    r := zone.load_from("/db", "Nowhere/City")
    expect(r is !.Io(.NotFound))
    // A directory is not a zone file.
    ok(fs.make_dir_all("/db/Dir"))
    d := zone.load_from("/db", "Dir")
    expect(d is !.Io(_))
    // Data cut short is Invalid, at the end of the data.
    raw: [2048]u8 = ---
    bytes := ok(hex.decode(PARIS, raw[..]))
    ok(fs.write_all("/db/Cut", bytes[0..300]))
    c := zone.load_from("/db", "Cut")
    expect(c is !.Invalid(300))
    ok(fs.write_all("/db/Empty", bytes[0..0]))
    e := zone.load_from("/db", "Empty")
    expect(e is !.Invalid(0))
}

test "load_from rejects names that leave the directory" {
    install("/db/Europe/Paris", PARIS)
    for name in [_]string("", "/etc/passwd", "/db/Europe/Paris", "..", "../db/Europe/Paris", "Europe/../Europe/Paris", "Europe/..", "Europe/Paris/../..") {
        r := zone.load_from("/db", name)
        expect(r is !.Io(.InvalidInput), name)
    }
    // Dots that are not a whole component are fine; the zone just is not there.
    for name in [_]string("..a", "a..", "a..b", ".hidden", "Europe/...") {
        r := zone.load_from("/db", name)
        expect(r is !.Io(.NotFound), name)
    }
    // A path that does not fit the buffer.
    long: [5000]u8 = ---
    for i in 0..long.len { long[i] = 'a' }
    expect(zone.load_from("/db", long[..]) is !.Io(.InvalidInput))
}

test "load uses TZDIR" {
    install("/custom/Europe/Paris", PARIS)
    env := Vars(tzdir: "/custom")
    with &env {
        p := ok(zone.load("Europe/Paris"))
        defer zone.deinit(&p)
        expect_eq(offset(&p, "2024-07-01T00:00:00Z"), 7200)
        expect(zone.load("../Europe/Paris") is !.Io(.InvalidInput))
    }
    // An empty TZDIR is the same as none: /usr/share/zoneinfo, which this file system lacks.
    empty := Vars(tzdir: "")
    with &empty {
        expect(zone.load("Europe/Paris") is !.Io(.NotFound))
    }
    install("/usr/share/zoneinfo/Europe/Paris", PARIS)
    with &empty {
        p := ok(zone.load("Europe/Paris"))
        defer zone.deinit(&p)
        expect_eq(offset(&p, "2024-07-01T00:00:00Z"), 7200)
    }
    unset := Vars()
    with &unset {
        p := ok(zone.load("Europe/Paris"))
        defer zone.deinit(&p)
        expect_eq(offset(&p, "2024-01-01T00:00:00Z"), 3600)
    }
}

test "local without TZ reads /etc/localtime, or is UTC" {
    unset := Vars()
    with &unset {
        a := ok(zone.local())
        defer zone.deinit(&a)
        expect_eq(offset(&a, "2024-07-01T00:00:00Z"), 0)
        expect_eq(zone.offset_at(&a, 0).abbreviation, "UTC")
        install("/etc/localtime", APIA)
        b := ok(zone.local())
        defer zone.deinit(&b)
        expect_eq(offset(&b, "2024-07-01T00:00:00Z"), 46800)
    }
}

test "local reads TZ as a file name or a rule" {
    install("/usr/share/zoneinfo/Pacific/Apia", APIA)
    install("/zones/Asia/Kolkata", KOLKATA)
    // An empty TZ is UTC.
    empty := Vars(tz: "")
    with &empty {
        a := ok(zone.local())
        defer zone.deinit(&a)
        expect_eq(offset(&a, "2024-07-01T00:00:00Z"), 0)
    }
    // With a colon it is a file name only; without, a name if there is such a file.
    for tz in [_]string(":Pacific/Apia", "Pacific/Apia") {
        env := Vars(tz: tz)
        with &env {
            b := ok(zone.local())
            defer zone.deinit(&b)
            expect(offset(&b, "2024-07-01T00:00:00Z") is 46800, tz)
        }
    }
    custom := Vars(tz: "Asia/Kolkata", tzdir: "/zones")
    with &custom {
        k := ok(zone.local())
        defer zone.deinit(&k)
        expect_eq(offset(&k, "2024-07-01T00:00:00Z"), 19800)
    }
    // Otherwise the string is a rule.
    rule := Vars(tz: "CET-1CEST,M3.5.0,M10.5.0/3")
    with &rule {
        c := ok(zone.local())
        defer zone.deinit(&c)
        expect_eq(offset(&c, "2024-07-01T00:00:00Z"), 7200)
        expect_eq(offset(&c, "2024-12-01T00:00:00Z"), 3600)
        expect_eq(zone.offset_at(&c, at("2024-12-01T00:00:00Z")).abbreviation, "CET")
    }
    plain := Vars(tz: "<+03>-3")
    with &plain {
        d := ok(zone.local())
        defer zone.deinit(&d)
        expect_eq(offset(&d, "2024-12-01T00:00:00Z"), 10800)
    }
    // Neither a zone nor a rule: UTC. So is a missing zone given with a colon.
    for tz in [_]string("Nowhere/City", ":Nowhere/City", "??", ":../x", "../x", ":") {
        env := Vars(tz: tz)
        with &env {
            u := ok(zone.local())
            defer zone.deinit(&u)
            expect(offset(&u, "2024-07-01T00:00:00Z") is 0, tz)
        }
    }
}

test "local reports a zone file that is malformed" {
    install("/usr/share/zoneinfo/Broken", PARIS)
    ok(fs.write_all("/usr/share/zoneinfo/Broken", "TZif2 but not really, and much too short for a header at all"))
    env := Vars(tz: "Broken")
    with &env {
        expect(zone.local() is !.Invalid(_))
    }
    colon := Vars(tz: ":Broken")
    with &colon {
        expect(zone.local() is !.Invalid(_))
    }
}

test "a zone releases everything it allocated" {
    // The test allocator fails the test if any of these leak.
    for text in [_]string(PARIS, NEW_YORK, APIA, KOLKATA) {
        raw: [2048]u8 = ---
        z := ok(zone.parse(ok(hex.decode(text, raw[..]))))
        zone.deinit(&z)
        // Releasing twice is harmless: the zone is UTC afterwards.
        zone.deinit(&z)
        expect_eq(zone.offset_at(&z, 1_700_000_000).seconds, 0)
    }
    r := ok(zone.from_tz_string("CET-1CEST,M3.5.0,M10.5.0/3"))
    zone.deinit(&r)
    for z in [_]zone.Zone(zone.utc(), zone.fixed(3600)) {
        var_z := z
        zone.deinit(&var_z)
    }
}

test "the data may be freed after parsing" {
    raw: [2048]u8 = ---
    data := ok(hex.decode(PARIS, raw[..]))
    z := ok(zone.parse(data))
    defer zone.deinit(&z)
    for i in 0..data.len { data[i] = 0xFF }
    expect_eq(offset(&z, "2024-07-01T00:00:00Z"), 7200)
    expect_eq(zone.offset_at(&z, at("2024-07-01T00:00:00Z")).abbreviation, "CEST")
}

test "a full allocator is an error, not a trap" {
    raw: [512]u8 = ---
    data := ok(hex.decode(NO_FOOTER, raw[..]))
    store: [4096]u8 = ---
    failed: u32 = 0
    succeeded: u32 = 0
    size: usize = 0
    while size <= 512 {
        fb := fixed_buffer.over(store[0..size])
        with fixed_buffer.allocator(&fb) {
            if z := zone.parse(data) {
                succeeded += 1
                var_z := z
                zone.deinit(&var_z)
            } else e => {
                expect(e is .Alloc(_))
                failed += 1
            }
            if t := zone.from_tz_string("CET-1CEST,M3.5.0,M10.5.0/3") {
                var_t := t
                zone.deinit(&var_t)
            } else e => {
                expect(e is .Alloc(_))
            }
        }
        size += 8
    }
    expect(failed > 0 and succeeded > 0)
}
