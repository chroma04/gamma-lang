//! stage: test
// std/net and the new `Net` operations (shutdown, set_timeouts, peer) under the in-memory
// network.
net :: import "std/net"

// A connected pair: the client end and the accepted server end.
Pair :: struct { client: Socket, server: Socket, port: u16 }

connected :: fn() -> IoError!Pair \ {Net} {
    l := try listen("127.0.0.1", 0)
    port := try l.local_port()
    c := try connect("127.0.0.1", port)
    s := try l.accept()
    return Pair(client: c, server: s, port: port)
}

test "send_all and recv_exact" {
    p := ok(connected())
    ok(net.send_all(p.client, "hello, network"))
    first: [5]u8 = ---
    ok(net.recv_exact(p.server, first[..]))
    expect(first[..] is "hello")
    rest: [9]u8 = ---
    ok(net.recv_exact(p.server, rest[..]))
    expect(rest[..] is ", network")
    // Nothing more to read, but the peer is open: it would block.
    one: [1]u8 = ---
    expect(net.recv_exact(p.server, one[..]) is !.WouldBlock)
    // An empty buffer or an empty message needs nothing.
    ok(net.recv_exact(p.server, empty_slice(u8)))
    ok(net.send_all(p.client, ""))
}

test "recv_exact reports a peer that closed early" {
    p := ok(connected())
    ok(net.send_all(p.client, "abc"))
    close_socket(p.client)
    buf: [5]u8 = ---
    expect(net.recv_exact(p.server, buf[..]) is !.UnexpectedEof)
    // A closed peer: sending fails.
    expect(net.send_all(p.server, "x") is !.BrokenPipe)
}

test "shutdown of the write side ends the peer's stream" {
    p := ok(connected())
    ok(net.send_all(p.client, "request"))
    ok(p.client.shutdown(.Write))
    buf: [16]u8 = ---
    n := ok(p.server.recv(buf[..]))
    expect(buf[0..n] is "request")
    expect(ok(p.server.recv(buf[..])) is 0)
    // The other direction still works.
    ok(net.send_all(p.server, "reply"))
    n = ok(p.client.recv(buf[..]))
    expect(buf[0..n] is "reply")
    // Sending after shutting down the write side fails.
    expect(p.client.send("more") is !.BrokenPipe)
}

test "shutdown of the read side" {
    p := ok(connected())
    ok(net.send_all(p.server, "ignored"))
    ok(p.client.shutdown(.Read))
    buf: [16]u8 = ---
    expect(ok(p.client.recv(buf[..])) is 0)
    // Writing still works.
    ok(net.send_all(p.client, "ok"))
    n := ok(p.server.recv(buf[..]))
    expect(buf[0..n] is "ok")
}

test "shutdown of both sides" {
    p := ok(connected())
    ok(p.server.shutdown(.Both))
    buf: [4]u8 = ---
    expect(ok(p.server.recv(buf[..])) is 0)
    expect(ok(p.client.recv(buf[..])) is 0)
    expect(p.server.send("x") is !.BrokenPipe)
    close_socket(p.server)
    expect(p.server.shutdown(.Both) is !.Other(9))
}

test "set_timeouts is accepted and nothing blocks" {
    p := ok(connected())
    ok(p.client.set_timeouts(ms(50), null))
    ok(p.client.set_timeouts(null, secs(1)))
    ok(p.client.set_timeouts(null, null))
    buf: [4]u8 = ---
    expect(p.client.recv(buf[..]) is !.WouldBlock)
    close_socket(p.client)
    expect(p.client.set_timeouts(null, null) is !.Other(9))
}

test "peer reports the address of the other end" {
    p := ok(connected())
    buf: [32]u8 = ---
    n := ok(p.client.peer(buf[..]))
    // The client's peer is the listener's port.
    expect(buf[0..4] is "127.")
    expect(n > 10)
    expect(buf[0..n].ends_with(":49152"))
    expect(p.port is 49152)
    m := ok(p.server.peer(buf[..]))
    expect(buf[0..10] is "127.0.0.1:")
    expect(m > 10)
    small: [4]u8 = ---
    expect(p.client.peer(small[..]) is !.InvalidInput)
    close_socket(p.server)
    expect(p.server.peer(buf[..]) is !.Other(9))
}
