//! stage: test
//! exit: 1
// A container that is not deinitialized is reported as a leak, so the passing tests
// of std_collections_leaks are meaningful.
dq :: import "std/collections/deque"
hp :: import "std/collections/heap"
bs :: import "std/collections/bitset"

test "a deque without deinit leaks" {
    d := dq.deque(u32)
    ok(d.push_back(1))
}

test "a heap without deinit leaks" {
    h := hp.heap(u32)
    ok(h.push(1))
}

test "a bit set without deinit leaks" {
    s := ok(bs.bitset(10))
    s.insert(1)
}

test "an empty bit set and an unused deque leak nothing" {
    s := ok(bs.bitset(0))
    _ = s
    d := dq.deque(u32)
    _ = d
}
