//! stage: test
// Tests run with the test handlers of `In`, `Clock` and `Rand` (§12.9): empty input,
// a fake clock that `sleep` advances, and random bytes from a fixed seed.

time :: import "std/time"

wait_and_measure :: fn() -> Duration needs Clock {
    t0 := Clock.now()
    Clock.sleep(time.secs(3))
    Clock.sleep(time.ms(250))
    return Clock.now().since(t0)
}

test "input is empty" {
    buf: [8]u8 = ---
    n := ok(In.read(buf[..]))
    expect(n is 0)
}

test "sleeping advances the fake clock without waiting" {
    expect(Clock.now().ns is 0)
    expect(wait_and_measure().to_ms() is 3250)
    expect(Clock.wall() is 1_700_000_003_250_000_000)
}

test "random bytes are reproducible" {
    a: [4]u8 = ---
    Rand.fill(a[..])
    print("{}\n", a)
    b: [4]u8 = ---
    Rand.fill(b[..])
    expect(a is not b)
}
