//! stage: test
// std/fs directory helpers and the new `Fs` operations, under the in-memory file system.
// The test allocator also checks that `walk` frees everything, also when left early.
fs :: import "std/fs"

put :: fn(path: string, text: string) -> IoError!() \ {Fs} {
    try fs.write_all(path, text)
}

// Builds:  t/a.txt  t/sub/b.txt  t/sub/deep/c.txt  t/sub/deep/d.txt  t/other/  t/z.txt
tree :: fn() -> IoError!() \ {Fs} {
    try fs.make_dir_all("t/sub/deep")
    try fs.make_dir_all("t/other")
    try put("t/a.txt", "a")
    try put("t/sub/b.txt", "b")
    try put("t/sub/deep/c.txt", "c")
    try put("t/sub/deep/d.txt", "d")
    try put("t/z.txt", "z")
}

test "entries lists a directory with kinds" {
    ok(tree())
    files: u32 = 0
    dirs: u32 = 0
    for r in fs.entries("t") {
        e := ok(r)
        match e.kind {
            .File => { files += 1 }
            .Dir => { dirs += 1 }
            _ => expect(false, "unexpected kind")
        }
    }
    print("{} files, {} directories\n", files, dirs)
    expect(files is 2 and dirs is 2)
}

test "entries yields an open error once" {
    n: u32 = 0
    for r in fs.entries("nothing") {
        n += 1
        expect(r is !.NotFound)
    }
    expect(n is 1)
    ok(put("plain", "x"))
    for r in fs.entries("plain") { expect(r is !.Other(20)) }
}

test "entries closes the directory when left early" {
    ok(tree())
    for r in fs.entries("t") {
        _ = ok(r)
        break
    }
    // The directory handle was closed: removing and recreating things still works.
    n: u32 = 0
    for r in fs.entries("t") {
        _ = ok(r)
        n += 1
    }
    expect(n is 4)
}

test "walk visits every entry in pre-order" {
    ok(tree())
    order := [_]string("t/a.txt", "t/sub", "t/sub/b.txt", "t/sub/deep", "t/sub/deep/c.txt",
                       "t/sub/deep/d.txt", "t/other", "t/z.txt")
    depths := [_]u32(0, 0, 1, 1, 2, 2, 0, 0)
    at: [8]i32 = [8]i32(fill: -1)
    count: i32 = 0
    for r in fs.walk("t") {
        e := ok(r)
        found: i32 = -1
        for i in 0..order.len {
            if e.path is order[i] { found = i.trunc(i32) }
        }
        expect(found >= 0, "an unexpected path")
        at[found.trunc(usize)] = count
        count += 1
        expect(e.depth is depths[found.trunc(usize)])
        if found is 1 or found is 3 or found is 6 {
            expect(e.kind is .Dir)
        } else {
            expect(e.kind is .File)
        }
    }
    expect(count is 8, "every entry once")
    // A directory comes before what it contains.
    expect(at[1] < at[2] and at[1] < at[3] and at[3] < at[4] and at[3] < at[5])
    print("walked {}\n", count)
}

test "walk with a trailing slash and an empty tree" {
    ok(fs.make_dir_all("e"))
    for r in fs.walk("e/") { _ = ok(r); expect(false, "nothing to visit") }
    ok(put("e/x", "1"))
    for r in fs.walk("e/") {
        e := ok(r)
        expect(e.path is "e/x")
        expect(e.depth is 0)
    }
}

test "walk reports a missing root once" {
    n: u32 = 0
    for r in fs.walk("missing") {
        n += 1
        expect(r is !.NotFound)
    }
    expect(n is 1)
}

test "walk frees everything when left early" {
    ok(tree())
    for r in fs.walk("t") {
        e := ok(r)
        if e.depth is 2 { break }
    }
    n: u32 = 0
    for r in fs.walk("t") {
        _ = ok(r)
        n += 1
    }
    expect(n is 8)
}

test "make_dir_all" {
    ok(fs.make_dir_all("a/b/c"))
    ok(fs.make_dir_all("a/b/c"))
    ok(fs.make_dir_all("/a//b/./c/"))
    expect((ok(Fs.stat("a/b/c"))).kind is .Dir)
    ok(fs.make_dir_all(""))
    ok(fs.make_dir_all("/"))
    ok(put("a/file", "x"))
    expect(fs.make_dir_all("a/file") is !.AlreadyExists)
    expect(fs.make_dir_all("a/file/inner") is !.AlreadyExists)
}

test "write_atomic replaces the file and leaves no temporary" {
    ok(put("cfg", "old contents, longer"))
    ok(fs.write_atomic("cfg", "new"))
    data := ok(fs.read_all("cfg"))
    expect(data is "new")
    free(data)
    ok(fs.write_atomic("fresh", "created"))
    n: u32 = 0
    for r in fs.entries("/") {
        _ = ok(r)
        n += 1
    }
    expect(n is 2, "only the two files")
    expect(fs.write_atomic("missing/dir/file", "x") is !.NotFound)
    n = 0
    for r in fs.entries("/") {
        _ = ok(r)
        n += 1
    }
    expect(n is 2, "a failure leaves nothing behind")
    // Replacing a directory fails and removes the temporary.
    ok(Fs.make_dir("d"))
    expect(fs.write_atomic("d", "x") is !.Other(21))
    n = 0
    for r in fs.entries("/") {
        _ = ok(r)
        n += 1
    }
    expect(n is 3)
}

test "truncate and sync" {
    f := ok(Fs.open("f", fs.OpenOptions(read: true, write: true, create: true)))
    _ = ok(f.write_to("hello world"))
    ok(f.sync())
    ok(f.truncate(5))
    expect((ok(Fs.stat("f"))).size is 5)
    ok(f.truncate(8))
    expect((ok(Fs.stat("f"))).size is 8)
    _ = ok(f.seek(0, .Start))
    buf: [16]u8 = ---
    n := ok(f.read_from(buf[..]))
    expect(n is 8)
    expect(buf[0..8] is "hello\0\0\0")
    ok(f.truncate(0))
    expect((ok(Fs.stat("f"))).size is 0)
    ro := ok(Fs.open("f", fs.OpenOptions()))
    expect(ro.truncate(1) is !.Other(9))
    ro.close()
    expect(f.truncate(MEM_TOO_BIG) is !.NoSpace)
    f.close()
    expect(f.sync() is !.Other(9))
    expect(f.truncate(1) is !.Other(9))
}

MEM_TOO_BIG :: 1 << 40

test "lstat is stat, and cwd is the root" {
    ok(put("f", "abc"))
    ok(Fs.make_dir("d"))
    a := ok(Fs.lstat("f"))
    expect(a.kind is .File and a.size is 3)
    expect((ok(Fs.lstat("d"))).kind is .Dir)
    expect(Fs.lstat("nothing") is !.NotFound)
    buf: [8]u8 = ---
    n := ok(Fs.cwd(buf[..]))
    expect(buf[0..n] is "/")
    empty := empty_slice(u8)
    expect(Fs.cwd(empty) is !.InvalidInput)
}

test "next_entry reports kinds" {
    ok(tree())
    d := ok(Fs.open_dir("t"))
    defer d.close_dir()
    buf: [16]u8 = ---
    dirs: u32 = 0
    while true {
        e := (ok(d.next_entry(buf[..]))) else break
        if e.kind is .Dir { dirs += 1 }
    }
    expect(dirs is 2)
}

test "copying a file onto itself keeps it" {
    ok(fs.write_all("self.txt", "precious data"))
    ok(fs.copy("self.txt", "self.txt"))
    d := ok(fs.read_all("self.txt"))
    defer free(d)
    expect(string(d) is "precious data", "content")
}

test "copy replaces a longer file" {
    ok(fs.write_all("long.txt", "a much longer old content"))
    ok(fs.write_all("short.txt", "new"))
    ok(fs.copy("short.txt", "long.txt"))
    d := ok(fs.read_all("long.txt"))
    defer free(d)
    expect(string(d) is "new", "content")
}
