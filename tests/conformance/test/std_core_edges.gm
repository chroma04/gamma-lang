//! stage: test
// Edge cases of the core containers and allocation helpers: sources that alias the
// container's own storage, size computations that overflow, table growth after many
// removals, and the length of a range.
deque :: import "std/collections/deque"
arena :: import "std/arena"

test "extend with the list's own items after growth" {
    l := list(u32)
    defer l.deinit()
    for i in 1..5 { ok(l.push(i)) }
    ok(l.extend(l.items))
    expect_eq(l.items.len, 8)
    expect_eq(l.items[0], 1)
    expect_eq(l.items[3], 4)
    expect_eq(l.items[4], 1)
    expect_eq(l.items[7], 4)
}

test "extend with a part of the list's own bytes" {
    s := list(u8)
    defer s.deinit()
    ok(s.extend("abcd"))
    ok(s.extend(s.items[1..3]))
    ok(s.extend(s.items))
    expect(string(s.items) is "abcdbcabcdbc", "bytes")
}

test "allocation sizes that overflow are out of memory" {
    n: usize = 1 << 62
    if s := make(u64, n) {
        free(s)
        expect(false, "make")
    }
    if s := make_fill(u64, n, 0) {
        free(s)
        expect(false, "make_fill")
    }
    if s := make_aligned(u64, n, 16) {
        free_aligned(s, 16)
        expect(false, "make_aligned")
    }
    l := list(u64)
    defer l.deinit()
    failed := false
    l.reserve(n) else { failed = true }
    expect(failed, "reserve")
    failed = false
    l.reserve(@max_value(usize)) else { failed = true }
    expect(failed, "reserve max")
    expect_eq(l.items.len, 0)
    d := deque.deque(u64)
    defer d.deinit()
    failed = false
    d.reserve(n) else { failed = true }
    expect(failed, "deque reserve")
    // Zero-sized elements never overflow.
    z := list(())
    defer z.deinit()
    ok(z.reserve(n))
}

test "a range has a length" {
    expect_eq((3..10).len(), 7)
    expect_eq((5..5).len(), 0)
    expect_eq((9..2).len(), 0)
    expect_eq((i32(-5)..5).len(), 10)
    expect_eq((2..=5).len(), 4)
    expect_eq((3..=3).len(), 1)
    expect_eq((4..=3).len(), 0)
    expect_eq((i8(-128)..127).len(), 255)
    expect_eq((i8(-128)..=127).len(), 256)
}

test "a map full of tombstones is rehashed without growing" {
    m := map(u32, u32)
    defer m.deinit()
    for i in 0..1000 {
        ok(m.put(i, i))
        if i >= 1 { _ = m.remove(i - 1) }
    }
    expect_eq(m.len(), 1)
    expect(m.get(999) is 999, "live entry")
    // 8 slots hold a handful of live entries: the table did not double a hundred times.
    for i in 0..4 { ok(m.put(2000 + i, i)) }
    expect_eq(m.len(), 5)
    for i in 0..4 { expect(m.get(2000 + i) is i, "entry kept") }
}

test "resizing a block of an older arena chunk" {
    a := arena.new()
    defer a.deinit()
    al := a.allocator()
    first := al.vt.alloc(al.data, 100, 8) else return
    big := al.vt.alloc(al.data, 100000, 8) else return
    expect(al.vt.resize(al.data, first, 100, 50, 8), "shrinking is allowed")
    expect(not al.vt.resize(al.data, first, 100, 200, 8), "growing is refused")
    _ = big
}
