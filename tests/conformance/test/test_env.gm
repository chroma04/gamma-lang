//! stage: test
//! exit: 1
// In tests, `Env` has no arguments and no variables, and `exit` ends the test (§12.9).
test "no environment" {
    expect(Env.var("HOME") is null)
    expect(Env.var("PATH") is null)
    expect(Env.args().len is 0)
}

test "exit 0 passes" {
    Env.exit(0)
}

test "exit 3 fails" {
    print("before\n")
    Env.exit(3)
}

main :: fn() {}
