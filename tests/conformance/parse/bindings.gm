//! stage: parse
// Spec 4.1-4.7: binding forms, uninitialized storage, destructuring, assignment.

f :: fn() {
    a :: 1
    b: u8 : 2
    c := 3
    d: u8 = 4
    e: [16]u8 = ---
    q, r := divmod(17, 5)
    s, t :: pair
    _, u := pair
    v, w: (u32, u32) = divmod(17, 5)
    buf := Buf(len: 0, data: ---)
    page := try new(Page, ---)

    c = 10
    c += 1
    c -= 1
    c *= 2
    c /= 2
    c %= 7
    c <<= 1
    c >>= 1
    c &= 0xF
    c |= 0x10
    c ~= 0xFF
    c +%= 1
    c -%= 1
    c *%= 3
    c <<%= 2
    c +|= 1
    c -|= 1
    c *|= 3
    c <<|= 2
    _ = f()
    a, b = (b, a)
    arr[i], arr[j] = (arr[j], arr[i])
    p^ = p^ +| 10
    node.next.value = 5
    t.0 = 1
}

divmod :: fn(n, d: u32) -> (q: u32, r: u32) => (n / d, n % d)
