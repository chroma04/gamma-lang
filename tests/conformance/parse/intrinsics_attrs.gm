    @volatile_store(p, 5)
    @asm("nop", (), (), ())
    a := @atomic_load(p, .SeqCst)
    @atomic_store(p, 1, .Release)
    old := @atomic_swap(p, 2, .AcqRel)
    r := @atomic_cas(p, 1, 2, .SeqCst, .Relaxed)
    @atomic_add(p, 1, .Relaxed)
    @fence(.SeqCst)
    t := @type_of(x)
    n := @type_name(u32)
    loc := @location()
    h := @hash(x, 0)
    off := @offset_of(Header, length)
    if @expect_true(a is 0) { }
    @prefetch(q)
    c := @clz(x) + @ctz(x) + @popcount(x) + @bswap(x) + @bitreverse(x)
    s := @sqrt(2.0) + @fma(1.0, 2.0, 3.0)
    @compile_error("nope")
    @unreachable()
    @write(sink, "{} at {}", name, pos)
    y: @type_of(x) = 0
}

