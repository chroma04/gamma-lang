//! stage: parse
// Spec 8.2-8.4: if, while, for.

f :: fn() {
    if x { a() }
    if x { a() } else { b() }
    if x { a() } else if y { b() } else { c() }
    if x < y and y < z { a() }
    if user := find(id) { use(user) }
    if .Circle(r) := shape { area(r) }
    if f := open(path) { read(f) } else e => { report(e) }
    if f := open(path) { read(f) } else e => report(e)
    if a := first() and b := second() and ok(a, b) { go(a, b) }
    if t := next() or other { }
    if v := m.get(k) else null { }
    if x is .A { }
    if x is not null and y in 0..10 { }
    if (struct { a: i32 }) is T { }
    if (fn(x: i32) => x)(1) is 1 { }
    if f(fn() { return 1 }) is 1 { }

    y := if a { 1 } else { 2 }
    z := if a { 1 } else if b { 2 } else { 3 }
    w := (if a { 1 } else { 2 }) + 1

    while true { work() }
    while i < xs.len { i += 1 }
    while line := reader.next() { handle(line) }
    while x := a.next() and y := b.next() { combine(x, y) }
    while not done() { step() }

    for i in 0..n { }
    for i in 0..=n { }
    for x in xs { }
    for i, x in enumerate(xs) { }
    for _ in 1..times { }
    for (a, b) in pairs() { }
    for p in each_ptr(scores) { p^ = p^ +| 10 }
    for t in tokenize(src) { push_token(t) }
    for x in evens(data) {
        if x > 100 { break }
        print("{}\n", x)
    }
    for x in xs[1..] { }
    for x in (if a { xs } else { ys }) { }
}
